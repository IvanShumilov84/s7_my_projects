//Altersys
//PCPDriver Specification File
PCPDriver
  //global parameters for IO manager
     GLOBAL
        //"Name"                            "Value"
        //QNX priority level for iomanager
          "Priority"                        "26"
        //Trace level for trace log
          "Trace Level"                     "NONE"
        //Trace log QNX registered name
          "Trace Log"                       "ErrLog"
        //Period in which same trace log messages are sent only once (in seconds)
          "Repeated Message Delay"          "60"
        //Timer resolution for iomanager
          "Tick Size"                       "1.0ms"
     END_GLOBAL
//List of all the FBP drivers
    DRIVER_LIST
         DRIVER
              GLOBAL
                 //"Name"                          "Value"
                 "Number"                          "1"
                 "Protocol"                        "modbus"
                 "Priority"                        "28"
                 "Trace"                           "FALSE"
                 "Timeout"                         "TRUE"
                 "Mode"                            "MASTER"
                 "Baud Rate"                       "38400"
                 "Bits"                            "8"
                 "Echo"                            "OFF"
                 "Framing"                         "RTU"
                 "Handshake"                       "OFF"
                 "Local Node"                      "1"
                 "Parity"                          "NONE"
                 "Port"                            "/dev/ser4"
                 "Signal"                          "OFF"
                 "Stop Bit"                        "1"
                 "Response Timeout"                "150"
                 "Turn Around Delay"               "0"
              END_GLOBAL
                 //specific to device number 1's properties
                 DEVICE
                 //"Name"                          "Value"
                 "Number"                          "1"
                 "Remote Node"                     "1"
                 "Phone"                           ""
                 "Retry"                           "3"
                 "Delay"                           "1"
                 "Word Order"                      "LH"
                 END_DEVICE
         END_DRIVER
         DRIVER
              GLOBAL
                 //"Name"                          "Value"
                 "Number"                          "2"
                 "Protocol"                        "modbus"
                 "Priority"                        "28"
                 "Trace"                           "FALSE"
                 "Timeout"                         "TRUE"
                 "Mode"                            "MASTER"
                 "Baud Rate"                       "9600"
                 "Bits"                            "8"
                 "Echo"                            "OFF"
                 "Framing"                         "ASCII"
                 "Handshake"                       "OFF"
                 "Local Node"                      "1"
                 "Parity"                          "NONE"
                 "Port"                            "/dev/ser5"
                 "Signal"                          "OFF"
                 "Stop Bit"                        "1"
                 "Response Timeout"                "150"
                 "Turn Around Delay"               "0"
              END_GLOBAL
                 //specific to device number 1's properties
                 DEVICE
                 //"Name"                          "Value"
                 "Number"                          "1"
                 "Remote Node"                     "1"
                 "Phone"                           ""
                 "Retry"                           "3"
                 "Delay"                           "1"
                 "Word Order"                      "LH"
                 END_DEVICE
         END_DRIVER
         DRIVER
              GLOBAL
                 //"Name"                          "Value"
                 "Number"                          "3"
                 "Protocol"                        "modbus"
                 "Priority"                        "28"
                 "Trace"                           "FALSE"
                 "Timeout"                         "TRUE"
                 "Mode"                            "MASTER"
                 "Baud Rate"                       "9600"
                 "Bits"                            "8"
                 "Echo"                            "OFF"
                 "Framing"                         "RTU"
                 "Handshake"                       "OFF"
                 "Local Node"                      "1"
                 "Parity"                          "NONE"
                 "Port"                            "/dev/ser3"
                 "Signal"                          "OFF"
                 "Stop Bit"                        "1"
                 "Response Timeout"                "150"
                 "Turn Around Delay"               "10"
              END_GLOBAL
                 //specific to device number 1's properties
                 DEVICE
                 //"Name"                          "Value"
                 "Number"                          "1"
                 "Remote Node"                     "2"
                 "Phone"                           ""
                 "Retry"                           "3"
                 "Delay"                           "1"
                 "Word Order"                      "LH"
                 END_DEVICE
                 //specific to device number 2's properties
                 DEVICE
                 //"Name"                          "Value"
                 "Number"                          "2"
                 "Remote Node"                     "3"
                 "Phone"                           ""
                 "Retry"                           "3"
                 "Delay"                           "1"
                 "Word Order"                      "LH"
                 END_DEVICE
         END_DRIVER
    END_DRIVER_LIST
