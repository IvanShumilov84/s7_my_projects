            AddHandler TFC_OVERRIDE_BTN.ValueChanged, AddressOf OnTFCOverrideButton
            AddHandler Cancel_TFC_Password.ValueChanged, AddressOf OnCancel_TFC_Password
            AddHandler OK_TFC_Password.ValueChanged, AddressOf OnOK_TFC_Password
            AddHandler VG_BTN.ValueChanged, AddressOf OnVG
            AddHandler UPS_ON_BATTERY_MAX_TIME_REACHED.ValueChanged, AddressOf OnUPS_ON_BATTERY_MAX_TIME_REACHED

            AddHandler PERF_PERFORMANCE_REPORT_BTN.ValueChanged, AddressOf OnBTN_PERFORMANCE_REPORT
            AddHandler PERF_PERFORMANCE_REPORT_VIEW_BTN.ValueChanged, AddressOf OnPERF_PERFORMANCE_REPORT_VIEW_BTN
            AddHandler PERF_PERFORMANCE_RUN_BTN.ValueChanged, AddressOf OnBTN_PERFORMANCE_RUN
            AddHandler PERF_PERFORMANCE_SAVE_BTN.ValueChanged, AddressOf OnBTN_PERFORMANCE_SAVE
            AddHandler PERF_PERFORMANCE_VIEW_BTN.ValueChanged, AddressOf OnBTN_PERFORMANCE_VIEW
            AddHandler PwrSetting_List.SelectedIndexChanged, AddressOf OnPwrSetting_List_SelectedIndexChanged

        End Sub
        Protected Overrides Sub RemoveHandlers()

            If Not (ANTI_ICE_OPEN_IND Is Nothing) Then
                RemoveHandler ANTI_ICE_OPEN_IND.ValueChanged, AddressOf OnAntiIceOpen
            End If
            If Not (CLOSE_TEST_BTN_OPC Is Nothing) Then
                RemoveHandler CLOSE_TEST_BTN_OPC.ValueChanged, AddressOf OnCLOSE_TEST_BTN
