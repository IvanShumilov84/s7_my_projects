        'Testing : 4-118 Anti-Icing Bleed and Start Valve Check : Record Ng and T0 at the exact moment the anti-ice light goes out.
        Private Sub OnAntiIceOpen(sender As KineticaRT.Channels.IChannel, newVal As KineticaRT.Values.Value)
            If (CELProject.IsFalse(newVal)) Then
                If ENGINE_AT_REST.Value = Values.True Then
                    Log_NG_RPM.Value = New KineticaRT.Values.Double(NG_RPM.Value.ToDouble)
                    Log_T_INLET_AVG_DEGF.Value = New KineticaRT.Values.Double(T_INLET_AVG_DEGF.Value.ToDouble)
                End If
            End If
        End Sub

        '*******************
        '* OnStopEngine() *
        '*******************
        Private Sub OnStopEngine(sender As KineticaRT.Channels.IChannel, newVal As KineticaRT.Values.Value)
            Try
                If (CELProject.IsTrue(newVal)) Then
                    AIR_STARTER_BTN.Value = Values.False
                    MAIN_FUEL_VALVE_BTN.Value = Values.False
                    IGNITION_BTN.Value = Values.False
                End If
            Catch ex As Exception
                MessageBox.Show("OnStopEngine: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub


        '**************************
        '* OnDECDiagCodeSignal()  *
        '**************************
        Private Sub OnDECDiagCodeSignal()
            Dim Code_Text As String = ""
            Dim Signal As Double = 0

            Try
                Signal = DEC_DIAG_CODE_SIGNAL.Value.ToDouble()
                Select Case CELProject.EngineModel

                    Case "T700-401", "T700-401C"

                        If NG_RPM.Value.ToDouble < 50.0 Then

                            If Signal < 0.43 And Signal > -0.3 Then
                                Code_Text = "No Fault"
                            ElseIf Signal < 0.63 And Signal > 0.43 Then
                                Code_Text = "DEC Failure - Bit Checks"
                            ElseIf Signal < 0.98 And Signal > 0.78 Then
                                Code_Text = "Np Demand Signal Failure"
                            ElseIf Signal < 1.34 And Signal > 1.14 Then
                                Code_Text = "Load Share Input Torque"
                            ElseIf Signal < 1.69 And Signal > 1.49 Then
                                Code_Text = "T4.5 Signal Failure"
                            ElseIf Signal < 2.05 And Signal > 1.85 Then
                                Code_Text = "Alternator Power Failure"
                            ElseIf Signal < 2.4 And Signal > 2.2 Then
                                Code_Text = "Ng Signal Failure"
                            ElseIf Signal < 2.75 And Signal > 2.55 Then
                                Code_Text = "Np Signal Failure"
                            ElseIf Signal < 3.1 And Signal > 2.9 Then
                                Code_Text = "Torque/Overspeed"
                            ElseIf Signal < 3.46 And Signal > 3.26 Then
                                Code_Text = "Hot Start Preventer"
                            ElseIf Signal < 3.81 And Signal > 3.61 Then
                                Code_Text = "400 Hz Power"
                            ElseIf Signal < 4.15 And Signal > 3.95 Then
                                Code_Text = "Collective"
                            ElseIf Signal < 4.51 And Signal > 4.31 Then
                                Code_Text = "Nr"
                            Else
                                Code_Text = "N/A"
                            End If
                        Else
                            Code_Text = "N/A"
                        End If


                    Case "T700-701C", "T700-701D"

                        If NG_RPM.Value.ToDouble < 50.0 Then

                            If Signal < 0.43 And Signal > -0.3 Then
                                Code_Text = "No Fault"
                            ElseIf Signal < 0.63 And Signal > 0.43 Then
                                Code_Text = "DEC Failure - Bit Checks"
                            ElseIf Signal < 0.98 And Signal > 0.78 Then
                                Code_Text = "Np Demand Signal Failure"
                            ElseIf Signal < 1.34 And Signal > 1.14 Then
                                Code_Text = "Load Share Input Torque"
                            ElseIf Signal < 1.69 And Signal > 1.49 Then
                                Code_Text = "T4.5 Signal Failure"
                            ElseIf Signal < 2.05 And Signal > 1.85 Then
                                Code_Text = "Alternator Power Failure"
                            ElseIf Signal < 2.4 And Signal > 2.2 Then
                                Code_Text = "Ng Signal Failure"
                            ElseIf Signal < 2.75 And Signal > 2.55 Then
                                Code_Text = "Np Signal Failure"
                            ElseIf Signal < 3.1 And Signal > 2.9 Then
                                Code_Text = "Torque/Overspeed"
                            ElseIf Signal < 3.46 And Signal > 3.26 Then
                                Code_Text = "Hot Start Preventer"
                            ElseIf Signal < 3.81 And Signal > 3.61 Then
                                Code_Text = "400 Hz Power"
                            ElseIf Signal < 4.16 And Signal > 3.96 Then
                                Code_Text = "Collective"
                            ElseIf Signal < 4.51 And Signal > 4.31 Then
                                Code_Text = "Nr"
                            Else
                                Code_Text = "N/A"
                            End If
                        Else
                            Code_Text = "N/A"
                        End If

                    Case Else
                        Code_Text = "N/A"
                End Select

                DEC_DIAG_CODE.Value = New KineticaRT.Values.Text(Code_Text)

            Catch Ex As Exception
                MessageBox.Show("OnDECDiagCodeSignal: " & Ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            Finally
            End Try

        End Sub

        '****************
        '* OnOsTestAB() *
        '****************
        Private Sub OnOsTestAB(sender As KineticaRT.Channels.IChannel, newVal As KineticaRT.Values.Value)
            Try
                If (newVal Is KineticaRT.Values.Values.True) Then
                    OS_TEST_A_BTN.Value = Values.True
                    OS_TEST_B_BTN.Value = Values.True
                Else
                    OS_TEST_A_BTN.Value = Values.False
                    OS_TEST_B_BTN.Value = Values.False
                End If
            Catch ex As Exception
                MessageBox.Show("OnOsTestAB: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        '****************
        '* OnPAS()      *
        '****************
        Private Sub OnPASBtn(sender As KineticaRT.Channels.IChannel, newVal As KineticaRT.Values.Value)
            Try
                If (newVal Is KineticaRT.Values.Values.True) Then
