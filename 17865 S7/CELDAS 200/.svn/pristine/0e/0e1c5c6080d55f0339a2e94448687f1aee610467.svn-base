                Return_Value.Add(MyBase.InitializeChannel(PERF_PERFORMANCE_RUN_BTN, "PERF_PERFORMANCE_RUN_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(PERF_PERFORMANCE_SAVE_BTN, "PERF_PERFORMANCE_SAVE_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(PERF_PERFORMANCE_VIEW_BTN, "PERF_PERFORMANCE_VIEW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(PWR_STEP_CODE, "PWR_STEP_CODE"))

                Return_Value.Add(MyBase.InitializeObject(Entry_Frame, CELProject.EngineFamily + "_Slave_Screen.T700_DRP_PLOT.Manual_Entry_Frame"))
                'Manual_Entry_Frame = Entry_Frame.FindObject("Manual_Entry_Frame")
                'T700_DRP_PLOT
                PwrSetting_List = Entry_Frame.FindObject("PwrSetting_List")
                If PwrSetting_List Is Nothing Then
                    MessageBox.Show("Initialize_Object - PwrSetting_List Is Nothing")
                    Return_Value.Add(False)
                Else
                    Return_Value.Add(True)
                End If


            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.Message)
                Return_Value.Add(False)
            Finally

            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If

            PreviousOverspeedRelightInd = CELProject.IsTrue(OVERSPEED_RELIGHT_IND.Value)

            '           TFC_TIME_BEF_SHUTDOWN_DISPLAY2 = Alarm_Frame.FindObject("TFC_TIME_BEFORE_SHUTDOWN")
            TFC_TIME_BEF_SHUTDOWN_DISPLAY = Emission_Frame.FindObject("strTFC_TIME_BEFORE_SHUTDOWN")

            If Return_Value.Contains(False) Then
                Return False
            Else
                Return True
            End If
        End Function

        '*********************
        '* ProcessDRPInputs  *
        '*********************
        Private Sub ProcessDRPInputs()
            'Dim Cmd 						As OleDbCommand
            'Dim ConnectionString 			As String
            Dim i As Integer
            '            Dim j As Integer
            Dim Now_Day As String
            Dim Now_Hour As String
            Dim Now_Minute As String
            Dim Now_Month As String
            Dim Now_Second As String
            Dim Now_Year As String
            'Dim Reader 						As OleDbDataReader
            'Dim SelectString 				As String
            Dim TestNumber As String
            'Dim TestSession_Connection 		As OleDbConnection
            Dim Var1 As String
            Dim Var2 As KineticaRT.Channels.Channel

            Try

                If Now.Day < 10 Then
                    Now_Day = "0" + Now.Day.ToString
                Else
                    Now_Day = Now.Day.ToString
                End If
                If Now.Hour < 10 Then
                    Now_Hour = "0" + Now.Hour.ToString
                Else
                    Now_Hour = Now.Hour.ToString
                End If
                If Now.Minute < 10 Then
                    Now_Minute = "0" + Now.Minute.ToString
                Else
                    Now_Minute = Now.Minute.ToString
                End If
                If Now.Month < 10 Then
                    Now_Month = "0" + Now.Month.ToString
                Else
                    Now_Month = Now.Month.ToString
                End If
                If Now.Second < 10 Then
                    Now_Second = "0" + Now.Second.ToString
                Else
                    Now_Second = Now.Second.ToString
                End If
                Now_Year = Now.Year.ToString.Substring(2)

                TestNumber = CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
                TestNumber = TestNumber.Substring(3) + "000"

                'Header
                DRPInputs(0) = "LOCATE   TEI"
                DRPInputs(1) = "CELL     002"
                DRPInputs(2) = "ESN      " + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
                DRPInputs(3) = "RDG      " + CONDITION_NUMBER.Value.ToString
                DRPInputs(4) = "TDATE    " + Now_Month + Now_Day + Now_Year
                DRPInputs(5) = "TESTNO   " + TestNumber
                DRPInputs(6) = "TTIME    " + Now_Hour + Now_Minute + Now_Second

                i = 7

                For Each Parameter As String In Custom_Parameters.Keys
                    'Remove 3 first characters that are the index and pad right for a total of 9 characters.
                    Var1 = Parameter.Substring(3).PadRight(9, " ")
                    'For j = Var1.Length To 9
                    '    Var1 = Var1 + " "
                    'Next
                    Var2 = GetChannel(Custom_Parameters(Parameter))
                    If Var2 Is Nothing Then
                        clsTopMostMessageBox.Show("Performance_Sequence : ProcessDRPInputs()" & " Can't retrieve channel Value used for performance parameter = " & Parameter, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    End If
                    If Var2.Value.ToString = "NaN" Then
                        DRPInputs(i) = Var1 + "-99999"
                    Else
                        DRPInputs(i) = Var1 + Var2.Value.ToString
                    End If
                    i = i + 1
                Next

                ''Connect to the TestSession Database
                'ConnectionString = "Provider=Microsoft.Jet.OLEDB.4.0; Data Source=" + TestSession_DatabaseName + ";Jet OLEDB:System database=" + TestSession_DatabaseWorkgroup + "; User ID=" + TestSession_DatabaseUserID + "; Password=" + TestSession_DatabasePassword

                'If OpenConnection(ConnectionString, TestSession_Connection) Then

                '    SelectString = "SELECT * FROM DRPInputList WHERE [Engine_Model] = " + Chr(39) + Test_Mgr_UUT_Model.ToString() + Chr(39)
                '    Cmd = New OleDbCommand(SelectString, TestSession_Connection)
                '    Reader = Cmd.ExecuteReader()

                '    While (Reader.Read())
                '        Var1 = Reader.Item("Parameter").ToString()
                '        For j = Var1.Length To 9
                '            Var1 = Var1 + " "
                '        Next
                '        Var2 = GetChannel(Reader.Item("Variable").ToString())
                '        If Var2 Is Nothing Then
                '            MessageBox.Show("ERROR: Log Variable creation is Nothing")
                '        End If
                '        DRPInputs(i) = Var1 + Var2.Value.ToString
                '        i = i + 1
                '    End While
                '    Reader.Close()

                '    CloseConnection(TestSession_Connection)
                'End If

            Catch ex As Exception
                clsTopMostMessageBox.Show("Performance_Sequence : ProcessDRPInputs()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        '******************
        '* WriteDRPFile() *
        '******************
        Private Sub WriteDRPFile(path As String, CondNb As String)
            Dim index As Integer
            Dim filename As String

            filename = CELProject.Project.Number.ToString + CELProject.EngineModel.Substring(5) + "_reading_" + CondNb + "_" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString + ".txt"
            Dim w As StreamWriter = New StreamWriter(path + filename)

            For index = 0 To DRPInputs.GetUpperBound(0)
                If (Not (DRPInputs(index) Is Nothing)) Then
                    w.WriteLine(DRPInputs(index))
                End If
            Next index


            w.Flush()
            w.Close()
        End Sub

        '********************************************************************
        '* Handlers *********************************************************
        '********************************************************************

        '****************************
        '* OnBTN_PERFORMANCE_RUN()  *
        '****************************
        Private Sub OnBTN_PERFORMANCE_RUN(sender As KineticaRT.Channels.IChannel, newVal As KineticaRT.Values.Value)
            Dim Result As DialogResult
            Dim CondNb As String = CONDITION_NUMBER.Value.ToString

            Try
                If (newVal Is KineticaRT.Values.Values.True) Then
                    Dim Perf_FolderName As String = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(1).Value.ToString() + "\Perf\"
                    Result = MessageBox.Show("Take Performance Point " + CondNb + "?", "Performance Point", MessageBoxButtons.YesNo)
                    If (Result = DialogResult.Yes) Then
                        Dim pleaseWait As New PleaseWaitForm("Please wait while performance point...")
                        pleaseWait.Show()
                        CELProject.LogPerfSynch.UpdateValues()
                        FlowmeterCtrl.ComputeFlow(True)
                        CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, True, CELProject.EngineModel, True)

                        If Process.GetProcessesByName("proc_incoming").Length = 0 Then
                            Shell("C:\drp\scripts\proc_incoming.exe", AppWinStyle.MinimizedNoFocus)
                        End If
                        ProcessDRPInputs()
                        WriteDRPFile(drpDataPath, CondNb)
                        WriteDRPFile(Perf_FolderName, CondNb)
                        CONDITION_NUMBER.Value = New KineticaRT.Values.Double(CONDITION_NUMBER.Value.ToDouble + 1)
                        pleaseWait.Hide()
                    End If

                PERF_PERFORMANCE_RUN_BTN.Value = KineticaRT.Values.Values.False
                End If
            Catch ex As Exception
                clsTopMostMessageBox.Show("Performance_Sequence : ProcessDRPInputs()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub


        '*****************************
        '* OnBTN_PERFORMANCE_SAVE()  *
        '*****************************
        Private Sub OnBTN_PERFORMANCE_SAVE(sender As KineticaRT.Channels.IChannel, newVal As KineticaRT.Values.Value)
            Dim DestinationPath As String
            Dim DirDest As String
            Dim Dirs As String()
            Dim FileDest As String
            Dim FileList As String()
            Dim i As Integer
            Dim j As Integer
            Dim SearchPath As String

            Try
                If (newVal Is KineticaRT.Values.Values.True) Then
                    DestinationPath = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(1).Value.ToString() + "\Perf\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
                    SearchPath = "C:\drp\engines\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()

                    If Directory.Exists(SearchPath) Then
                        Directory.CreateDirectory(DestinationPath)
                        Dirs = Directory.GetDirectories(SearchPath)
                        For i = 0 To Dirs.GetUpperBound(0)
                            DirDest = DestinationPath + Dirs(i).Substring(SearchPath.Length)
                            Directory.CreateDirectory(DirDest)
                            FileList = Directory.GetFiles(Dirs(i))
                            For j = 0 To FileList.GetUpperBound(0)
                                FileDest = DirDest + FileList(j).Substring(Dirs(i).Length)
                                If File.Exists(FileDest) Then
                                    File.Delete(FileDest)
                                End If
                                File.Copy(FileList(j), FileDest)
                            Next
                        Next
                        clsTopMostMessageBox.Show("Test results saved in " + DestinationPath, "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Information)

                    Else
                        clsTopMostMessageBox.Show("No test results to save", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    End If

                    PERF_PERFORMANCE_SAVE_BTN.Value = KineticaRT.Values.Values.False
                End If
            Catch ex As Exception
                clsTopMostMessageBox.Show("Performance_Sequence : OnBTN_PERFORMANCE_SAVE()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub ParseDRPDataFiles(ByRef sortedDictionary As SortedDictionary(Of Integer, SortedList), ByRef lastReadingNumber As String, ByRef cellNumber As Integer, ByRef testDate As String, ByRef productionOverhaul As String, ByRef locate As String)

            Dim drpPath As String = "C:\drp\engines\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\reports"
            Dim listOfFiles As String() = Directory.GetFiles(drpPath, "*.csv")
            Array.Reverse(listOfFiles)
            Dim fields As String()

            lastReadingNumber = listOfFiles(0).Substring(listOfFiles(0).Length() - 8, 4)
            Dim testDateNum As Integer = 999999

            For i As Integer = 0 To listOfFiles.Length() - 1

                Dim cvsParser As New Microsoft.VisualBasic.FileIO.TextFieldParser(listOfFiles(i))
                cvsParser.Delimiters = New String() {","}

                Dim sortedList As New SortedList
                While Not cvsParser.EndOfData
                    fields = cvsParser.ReadFields()

                    If Not sortedList.ContainsKey(fields(0)) And fields.Length() = 2 Then
                        If fields(0) = "LOCATE" Then
                            locate = fields(1)
                        ElseIf fields(0) <> "RDGTYP" Then
                            sortedList.Add(fields(0), Double.Parse(fields(1)))
                        End If
                    End If
                End While
                Dim powerLevel As Integer = sortedList.Item("APWR")
                cellNumber = sortedList.Item("CELL")
                testDateNum = sortedList.Item("TDATE")

                If testDateNum = 999999 Or testDateNum = sortedList.Item("TDATE") Then
                    testDateNum = sortedList.Item("TDATE")

                    If sortedList.Item("SWLAPS") = 1 Then
                        productionOverhaul = "OVERHAUL"
                    Else
                        productionOverhaul = "PRODUCTION"
                    End If
                    If Not sortedDictionary.ContainsKey(powerLevel) Then
                        sortedDictionary.Add(powerLevel, sortedList)
                    End If
                Else
                    Exit For
                End If
            Next
            testDate = testDateNum.ToString("00/00/00")
        End Sub

        Private Sub PrintOneLineOfRating(reportFile As System.IO.StreamWriter, sortedList As SortedList, ByRef nbFailed As Integer, powerLevel As Integer,
                                         T45HLimitName As String, SHPName As String, WFName As String, NGLimitName As String)

            Dim lineFailed As Boolean = False

            reportFile.Write("{0,3:D}", CInt(sortedList.Item("RDG"))) ' Reading number
            reportFile.Write(" {0,-24}", PwrSetting_List.Items(powerLevel - 1))     ' Rating name
            If CInt(sortedList.Item(SHPName)) <> -99999 Then
                reportFile.Write(" {0,4:D}", CInt(sortedList.Item(SHPName))) ' Power
            Else
                reportFile.Write("  - ") ' Power
            End If

            If T45HLimitName <> "NA" And
                sortedList.ContainsKey("T45HA") And
                sortedList.ContainsKey("T45HMG") And
                sortedList.ContainsKey(T45HLimitName) And
                CInt(sortedList.Item("T45HA")) <> -99999 And CInt(sortedList.Item("T45HA")) <> -88888 And
                T45HLimitName <> "NA" Then
                reportFile.Write("   {0,4:D}", CInt(sortedList.Item("T45HA")))   ' T45H
                reportFile.Write("   {0,3:D}", CInt(sortedList.Item("T45HMG"))) ' MGN
                If CInt(sortedList.Item("T45HMG")) < 0 Then
                    lineFailed = True
                End If
            Else
                reportFile.Write("     -     - ")
            End If

            '"SFCA" = adjusted SFC = WFAD/SHP***, where *** is replaced for each power code
            '"SFCG" = guaranteed SFC = WF**/ SHP***, where ** & *** are replaced for each power code
            '% SFC Margin = (SFCG - SFCA)/SFCG*100, for each powercode

            If sortedList.ContainsKey("WFAD") And
                sortedList.ContainsKey(SHPName) And
                sortedList.ContainsKey(WFName) And
                CInt(sortedList.Item("WFAD")) <> -99999 And CInt(sortedList.Item("WFAD")) <> -88888 And
                CInt(sortedList.Item(SHPName)) <> -99999 And CInt(sortedList.Item(SHPName)) <> -88888 And
                CInt(sortedList.Item(WFName)) <> -99999 And CInt(sortedList.Item(WFName)) <> -88888 Then
                Dim sfca As Double = sortedList.Item("WFAD") / sortedList.Item(SHPName)
                Dim sfcg As Double = sortedList.Item(WFName) / sortedList.Item(SHPName)
                Dim PCTsfcMargin = (sfcg - sfca) / sfcg * 100
                reportFile.Write("   {0,6:F4}", sfca) ' SFC
                reportFile.Write("   {0,4:F2}", PCTsfcMargin)                    ' %MGN
                If PCTsfcMargin < 0 Then
                    lineFailed = True
                End If
            Else
                reportFile.Write("     -        - ")

            End If

            If sortedList.ContainsKey("ADNG") And
                sortedList.ContainsKey("PNGMG") And
                sortedList.ContainsKey(NGLimitName) And
                CInt(sortedList.Item("ADNG")) <> -99999 And CInt(sortedList.Item("ADNG")) <> -88888 And
                CInt(sortedList.Item("PNGMG")) <> -99999 And CInt(sortedList.Item("PNGMG")) <> -88888 And
                CInt(sortedList.Item(NGLimitName)) <> -99999 And CInt(sortedList.Item(NGLimitName)) <> -88888 Then
                reportFile.Write("   {0,7:F1}", sortedList.Item("ADNG"))   ' XNG
                reportFile.Write("   {0,4:F2}", sortedList.Item("PNGMG"))                    ' %MGN
                If sortedList.Item("PNGMG") < 0 Then
                    lineFailed = True
                End If
            Else
                reportFile.Write("      -        - ")
            End If

            If lineFailed Then
                reportFile.WriteLine("   failed")
                nbFailed += 1
            Else
                reportFile.WriteLine("    pass")
            End If

        End Sub

        Private Sub GenerateProductionRatingReport(sortedDictionary As SortedDictionary(Of Integer, SortedList), lastReadingNumber As String, cellNumber As Integer, testDate As String, productionOverhaul As String, locate As String)

            Dim nbFailed As Integer = 0
            Dim reportFile As System.IO.StreamWriter
            Dim reportFilePath As String = "C:\drp\engines\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\reports\T700_PROD_" + lastReadingNumber + ".RPT"


            reportFile = My.Computer.FileSystem.OpenTextFileWriter(reportFilePath, False)
            reportFile.WriteLine("                          " + CELProject.EngineModel + " " + productionOverhaul + " RATING")
            reportFile.WriteLine()
            reportFile.WriteLine(" ENGINE " + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "  " + locate + " CELL " + cellNumber.ToString("000") + " TEST DATE " + testDate + " RATING DATE " + System.DateTime.Now.ToString("dd/MM/yyyy"))
            reportFile.WriteLine()
            reportFile.WriteLine("----------------------------------------------------------------------------------------")
            reportFile.WriteLine("                             Rated --------------- At Rated Conditions -----------------")
            reportFile.WriteLine("RDG RATING                   SHP    T45H   MGN    SFC     %MGN    XNG      %MGN   STATUS")

            For i As Integer = 7 To 2 Step -1
                If PwrSetting_List.Items.Count >= i And sortedDictionary.ContainsKey(i) Then

                    Dim sortedList As SortedList = sortedDictionary(i)

                    Select Case (PwrSetting_List.Items(i - 1))

                        Case "CONTINGENCY"
                            PrintOneLineOfRating(reportFile, sortedList, nbFailed, i, "T45HCN", "SHPCN", "NA", "NGCN")

                        Case "MAXIMUM"
                            PrintOneLineOfRating(reportFile, sortedList, nbFailed, i, "T45HMX", "SHPMX", "WFMX", "NGMX")

                        Case "INTERMEDIATE RATED POWER"
                            PrintOneLineOfRating(reportFile, sortedList, nbFailed, i, "T45HIP", "SHPIP", "WFIP", "NGIP")

                        Case "MAXIMUM CONTINUOUS"
                            PrintOneLineOfRating(reportFile, sortedList, nbFailed, i, "T45HMC", "SHPMC", "WFMC", "NGMC")

                        Case "90% MAXIMUM CONTINUOUS"
                            PrintOneLineOfRating(reportFile, sortedList, nbFailed, i, "NA", "SHP90", "WF90", "NA")

                        Case "75% MAXIMUM CONTINUOUS"
                            PrintOneLineOfRating(reportFile, sortedList, nbFailed, i, "NA", "SHP75", "WF75", "NA")

                        Case "60% MAXIMUM CONTINUOUS"
                            PrintOneLineOfRating(reportFile, sortedList, nbFailed, i, "NA", "SHP60", "WF60", "NA")

                        Case "50% MAXIMUM CONTINUOUS"
                            PrintOneLineOfRating(reportFile, sortedList, nbFailed, i, "NA", "SHP50", "WF50", "NA")

                    End Select

                End If
            Next
            reportFile.WriteLine()

            If sortedDictionary.ContainsKey(1) Then
                Dim sortedList As SortedList = sortedDictionary(1)

                reportFile.WriteLine(" RDG RATING                  SHPR0 (Max) TRQR0 (Max)  WFR0 (Max) XNGR0  (Min)     STATUS")
                reportFile.Write(" {0,3:D} {1,-24}{2,4:F1}  (71)  {3,5:F1} (37)  {4,5:F1} (165) {5,5:D} (30029)",
                                     CInt(sortedList.Item("RDG")),
                                     PwrSetting_List.Items(0),
                                     If(CInt(sortedList.Item("SHPR0")) <> -88888 And CInt(sortedList.Item("SHPR0")) <> -99999, sortedList.Item("SHPR0"), 999),
                                     If(CInt(sortedList.Item("TRQR0F")) <> -88888 And CInt(sortedList.Item("TRQR0F")) <> -99999, sortedList.Item("TRQR0F"), 999),
                                     If(CInt(sortedList.Item("WFR0")) <> -88888 And CInt(sortedList.Item("WFR0")) <> -99999, sortedList.Item("WFR0"), 999),
                                     If(CInt(sortedList.Item("XNGR0")) <> -88888 And CInt(sortedList.Item("XNGR0")) <> -99999, CInt(sortedList.Item("XNGR0")), 999)
                                     )
                If CInt(sortedList.Item("SHPR0")) > 71 Or
                   CInt(sortedList.Item("TRQR0F")) > 37 Or
                   CInt(sortedList.Item("WFR0")) > 165 Or
                   CInt(sortedList.Item("XNGR0")) < 30029 Then
                    reportFile.WriteLine("    failed")
                    nbFailed += 1
                Else
                    reportFile.WriteLine("     pass")
                End If
            End If

            reportFile.WriteLine()
            reportFile.WriteLine()

            reportFile.WriteLine("                                        As Tested Torque Error")
            reportFile.WriteLine("                                        ----------------------")

            reportFile.WriteLine(" RDG RATING                    ENGINE   FACILITY        ERROR    STATUS")
            For i As Integer = 7 To 1 Step -1
                If PwrSetting_List.Items.Count >= i And sortedDictionary.ContainsKey(i) Then
                    Dim sortedList As SortedList = sortedDictionary(i)

                    reportFile.Write(" {0,3:D} {1,-24}  {2,6:F2}    {3,6:F2}        {4,6:F2}",
                                         CInt(sortedList.Item("RDG")),
                                         PwrSetting_List.Items(i - 1),
                                         sortedList.Item("TRQPE"),
                                         sortedList.Item("TRQPE") - sortedList.Item("TRQEDL"),
                                         sortedList.Item("TRQEDL")
                                         )
                    If sortedList.Item("TRQEDL") > sortedList.Item("QHER") Or
                       sortedList.Item("TRQEDL") < sortedList.Item("QLER") Then
                        reportFile.WriteLine("    failed")
                        nbFailed += 1
                    Else
                        reportFile.WriteLine("     pass")
                    End If
                End If
            Next
            reportFile.WriteLine()

            reportFile.WriteLine("----------------------------------------------------------------------------------------")
            reportFile.WriteLine("                          -------- Test Limits --------")
            reportFile.WriteLine("                          RATED   MAX    MAX      MAX")
            reportFile.WriteLine("RATING                    SHP     T45H   SFC      NG")
            For i As Integer = 7 To 2 Step -1
                If PwrSetting_List.Items.Count >= i And sortedDictionary.ContainsKey(i) Then
                    Dim sortedList As SortedList = sortedDictionary(i)

                    reportFile.Write("{0,-24}", PwrSetting_List.Items(i - 1))     ' Rating name


                    Dim ratedSHPName As String = "NA"
                    Dim maxT45HName As String = "NA"
                    Dim MaxXNG As String = "NA"
                    Dim WFName As String = "NA"

                    Select Case (PwrSetting_List.Items(i - 1))
                        Case "CONTINGENCY"
                            ratedSHPName = "SHPCN"
                            MaxXNG = "NGCN"
                            maxT45HName = "T45HCN"
                            WFName = "NA"

                        Case "MAXIMUM"
                            ratedSHPName = "SHPMX"
                            MaxXNG = "NGMX"
                            maxT45HName = "T45HMX"
                            WFName = "WFMX"

                        Case "INTERMEDIATE RATED POWER"
                            ratedSHPName = "SHPIP"
                            maxT45HName = "T45HIP"
                            MaxXNG = "NGIP"
                            WFName = "WFIP"

                        Case "MAXIMUM CONTINUOUS"
                            ratedSHPName = "SHPMC"
                            maxT45HName = "T45HMC"
                            MaxXNG = "NGMC"
                            WFName = "WFMC"

                        Case "90% MAXIMUM CONTINUOUS"
                            ratedSHPName = "SHP90"
                            maxT45HName = "NA"
                            MaxXNG = "NA"
                            WFName = "WF90"

                        Case "75% MAXIMUM CONTINUOUS"
                            ratedSHPName = "SHP75"
                            maxT45HName = "NA"
                            MaxXNG = "NA"
                            WFName = "WF75"

                        Case "60% MAXIMUM CONTINUOUS"
                            ratedSHPName = "SHP60"
                            maxT45HName = "NA"
                            MaxXNG = "WF60"
                            WFName = "NA"

                        Case "50% MAXIMUM CONTINUOUS"
                            ratedSHPName = "SHP50"
                            maxT45HName = "NA"
                            MaxXNG = "NA"
                            WFName = "WF50"
                    End Select

                    If sortedList.ContainsKey(ratedSHPName) And CInt(sortedList.Item(ratedSHPName)) <> -99999 Then
                        reportFile.Write("  {0,4:D}", CInt(sortedList.Item(ratedSHPName))) ' Power
                    Else
                        reportFile.Write("   -  ")
                    End If

                    If sortedList.ContainsKey(maxT45HName) And CInt(sortedList.Item(maxT45HName)) <> -99999 Then
                        reportFile.Write("    {0,4:D}", CInt(sortedList.Item(maxT45HName))) ' T45H
                    Else
                        reportFile.Write("     -  ")
                    End If

                    If sortedList.ContainsKey("WFAD") And
                        sortedList.ContainsKey(ratedSHPName) And
                        sortedList.ContainsKey(WFName) And
                        CInt(sortedList.Item("WFAD")) <> -99999 And CInt(sortedList.Item("WFAD")) <> -88888 And
                        CInt(sortedList.Item(ratedSHPName)) <> -99999 And CInt(sortedList.Item(ratedSHPName)) <> -88888 And
                        CInt(sortedList.Item(WFName)) <> -99999 And CInt(sortedList.Item(WFName)) <> -88888 Then
                        Dim sfca As Double = sortedList.Item("WFAD") / sortedList.Item(ratedSHPName)
                        Dim sfcg As Double = sortedList.Item(WFName) / sortedList.Item(ratedSHPName)
                        reportFile.Write("   {0,6:F4}", sfcg) ' SFC
                    Else
                        reportFile.Write("    -    ")
                    End If

                    If MaxXNG <> "NA" And sortedList.ContainsKey(MaxXNG) And CInt(sortedList.Item(MaxXNG)) <> -99999 And CInt(sortedList.Item(MaxXNG)) <> -88888 Then
                        reportFile.Write("   {0,5:D}", CInt(sortedList.Item(MaxXNG)))   ' XNG
                    Else
                        reportFile.Write("      -")
                    End If

                    reportFile.WriteLine()
                End If
            Next
            reportFile.WriteLine()


            reportFile.WriteLine("POWER TRANSIENTS:")
            reportFile.WriteLine()
            reportFile.WriteLine("GROUND IDLE TO MAX __________________")
            reportFile.WriteLine()
            reportFile.WriteLine("FLIGHT IDLE TO MAX __________________")
            reportFile.WriteLine()
            reportFile.WriteLine("OIL CONSUMPTION    __________________")
            reportFile.WriteLine()
            reportFile.WriteLine("RUN TIME           __________________")
            reportFile.WriteLine()
            reportFile.WriteLine("STARTS             __________________")
            reportFile.WriteLine()
            reportFile.WriteLine("T700 QUALITY       __________________      DATE: _____________________")

            reportFile.WriteLine()
            reportFile.WriteLine("----------------------------------------------------------------------------------------")
            reportFile.Write("OVERALL STATUS FOR ENGINE " + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + " based on GE DRP data: ")
            If nbFailed = 0 Then
                reportFile.WriteLine("PASSES all checks")
            Else
                reportFile.WriteLine("FAILED one or more checks")
            End If
            reportFile.WriteLine("----------------------------------------------------------------------------------------")
            reportFile.WriteLine("NOTES:")
            reportFile.WriteLine("1) T45H, SFC and NG margins are evaluated based on FACILITY torque.")
            reportFile.WriteLine("2) All T45H are in degrees F.")


            reportFile.Close()
        End Sub

        '****************************
        '* OnBTN_PERFORMANCE_REPORT()  *
        '****************************
        Private Sub OnBTN_PERFORMANCE_REPORT(sender As IChannel, newVal As KineticaRT.Values.Value)

            If (newVal Is KineticaRT.Values.Values.True) Then
                Try
                    Dim sortedDictionary As New SortedDictionary(Of Integer, SortedList)
                    Dim lastReadingNumber As String = ""
                    Dim cellNumber As Integer = 0
                    Dim testDate As String = ""
                    Dim productionOverhaul As String = ""
                    Dim locate As String = ""

                    ParseDRPDataFiles(sortedDictionary, lastReadingNumber, cellNumber, testDate, productionOverhaul, locate)
                    If PwrSetting_List.Items.Count() <> sortedDictionary.Count() Then
                        MessageBox.Show("Production rating report: missing one or more power level rating.")
                    Else
                        Dim pleaseWait As New PleaseWaitForm("Please wait while saving data...")
                        pleaseWait.Show()
                        GenerateProductionRatingReport(sortedDictionary, lastReadingNumber, cellNumber, testDate, productionOverhaul, locate)
                        pleaseWait.Hide()
                    End If

                Catch ex As Exception
                    clsTopMostMessageBox.Show("Performance_Sequence : OnBTN_PERFORMANCE_REPORT_BTN()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Finally
                    PERF_PERFORMANCE_REPORT_BTN.Value = KineticaRT.Values.Values.False
                End Try
            End If
        End Sub

        '*****************************************
        '* OnPERF_PERFORMANCE_REPORT_VIEW_BTN()  *
        '*****************************************
        Protected Sub OnPERF_PERFORMANCE_REPORT_VIEW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If (CELProject.IsTrue(newVal)) Then

                    TestProgress_Save(False)

                    Dim fileName As String
                    Dim File_Dialog As New OpenFileDialog()

                    File_Dialog.Reset()
                    File_Dialog.Filter = "Production Reports|T700_PROD_*.RPT"
                    File_Dialog.FilterIndex = 1

                    File_Dialog.Title = "View Production Reports"
                    File_Dialog.InitialDirectory = "C:\drp\engines\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\reports"

                    If File_Dialog.ShowDialog() = DialogResult.OK Then
                        fileName = File_Dialog.FileName
                    Else
                        fileName = ""
                    End If

                    If fileName <> "" Then
                        If File.Exists(fileName) Then

                            Try
                                Process.Start(fileName)
                            Catch ex As Exception
                                MessageBox.Show("T700_Sequence: OnPERF_PERFORMANCE_REPORT_VIEW_BTN Process.Start: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            End Try

                        End If
                    End If

                End If
            Catch ex As Exception
                MessageBox.Show("T700_Sequence: OnPERF_PERFORMANCE_REPORT_VIEW_BTN: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
            PERF_PERFORMANCE_REPORT_VIEW_BTN.Value = Values.False
        End Sub

