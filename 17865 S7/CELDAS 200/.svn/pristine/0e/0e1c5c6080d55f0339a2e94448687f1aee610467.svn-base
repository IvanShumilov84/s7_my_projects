        Protected Overrides Sub Init_Engine_Controllers()

            Dim PersistentValuesChannels() As String = {"OPERATING_TIME_SEC", "NB_ENGINE_START", "CONDITION_NUMBER", "FUEL_USED_TOTAL_LITERS", "FUEL_USED_TOTAL_KG"}
            Dim PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputs.EngineSerialNumber & "\PersistentValues.xml"

            If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then
                PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)
                FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())
                FUEL_USED_INITIAL_KG.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_KG.Value.ToDouble())
                NB_ENGINE_START_OPC.Value = NB_ENGINE_START.Value
                OperatingTimeSec = CInt(OPERATING_TIME_SEC.Value.ToDouble())
                OPERATING_TIME_HHMMSS_OPC.Value = New Global.KineticaRT.Values.Text(Format(DateAdd("s", OPERATING_TIME_SEC.Value.ToDouble(), "00:00:00"), "HH:mm:ss"))

            End If

            FlowmeterCtrl = New FlowmeterController(Me)

            VX100WatchDogCtrl = New WatchdogController(Me, "VX100_WATCHDOG_STATUS", "VX100_WATCHDOG_TIME_LIMIT", "VX100_WATCHDOG_LINK")

            DeletableTInletChCtrl = New DeletableChannelController(Me, NumberOfT1Probe, 32, 16, "T_INLET_", "_DEGF", "_DELETE_BTN", "T_INLET_AVG_DEGF", "T_INLET_MIN_DEGF", "T_INLET_MAX_DEGF", "T_INLET_SPREAD_DEGF")
            DeletableP1SChCtrl = New DeletableChannelController(Me, NumberOfPS1Probe, 8, 4, "P_S_INLET_", "_PSIA", "_DELETE_BTN", "P_S_INLET_AVG_PSIA", "P_S_INLET_MIN_PSIA", "P_S_INLET_MAX_PSIA", "P_S_INLET_SPREAD_PSIA")
            DeletableP1TChCtrl = New DeletableChannelController(Me, NumberOfPT1Probe, 4, 2, "P_T_INLET_", "_PSIA", "_DELETE_BTN", "P_T_INLET_AVG_PSIA", "P_T_INLET_MIN_PSIA", "P_T_INLET_MAX_PSIA", "P_T_INLET_SPREAD_PSIA")
            DeletablePThroatStaticChCtrl = New DeletableChannelController(Me, NumberOfThroatProbe, 4, 2, "P_THROAT_", "_PSIA", "_DELETE_BTN", "P_THROAT_AVG_PSIA", "P_THROAT_MIN_PSIA", "P_THROAT_MAX_PSIA", "P_THROAT_SPREAD_PSIA")
            DeletablePUpstreamStaticChCtrl = New DeletableChannelController(Me, NumberOfUpstreamProbe, 4, 2, "P_UPSTREAM_", "_PSIA", "_DELETE_BTN", "P_UPSTREAM_AVG_PSIA", "P_UPSTREAM_MIN_PSIA", "P_UPSTREAM_MAX_PSIA", "P_UPSTREAM_SPREAD_PSIA")

            IgnitionMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "IGNITION_CURRENT_AMP", "IGNITION_CURRENT_AMP_MAX", "AIR_STARTER_DEMAND_OPC")
            IgnitionMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "IGNITION_VOLTAGE_VAC", "IGNITION_VOLTAGE_VAC_MAX", "AIR_STARTER_DEMAND_OPC")
            T45HMaxTemperatureRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_T45H_DEGF", "T_T45H_DEGF_MAX", "AIR_STARTER_DEMAND_OPC")
            Thread.Sleep(500) 'besoins d'un delais sinon WF_MAX affiche NaN
            WFMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "WF_PPH", "WF_MAX", "WF_MAX_RESET")

            OilDischargeMaxPressureRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "P_ENGINE_LUBE_PSIG", "P_ENGINE_LUBE_PSIG_PEAK", "P_ENGINE_LUBE_PSIG_PEAK_RESET")
            NGMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "NG_RPM", "NG_RPM_PEAK", "NG_RPM_PEAK_RESET")
            NPMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "NP_RPM", "NP_RPM_PEAK", "NP_RPM_PEAK_RESET")
            VibAGBMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_AGB_IPS", "VIB_AGB_IPS_PEAK", "VIB_AGB_IPS_PEAK_RESET")
            VibExhaust1MaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_EXHAUST_1_IPS", "VIB_EXHAUST_1_IPS_PEAK", "VIB_EXHAUST_1_IPS_PEAK_RESET")
            VibExhaust4MaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_EXHAUST_4_IPS", "VIB_EXHAUST_4_IPS_PEAK", "VIB_EXHAUST_4_IPS_PEAK_RESET")
            VibFlywheelMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_FLYWHEEL_IPS", "VIB_FLYWHEEL_IPS_PEAK", "VIB_FLYWHEEL_IPS_PEAK_RESET")
            VibDynoMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_DYNO_IPS", "VIB_DYNO_IPS_PEAK", "VIB_DYNO_IPS_PEAK_RESET")

            TimeToLightOffTimerCtrl = New TimerController(Me, "TIME_TO_LIGHT_OFF_START_CONDITION_LATCH", "TIME_TO_LIGHT_OFF_STOP_CONDITION_LATCH", "TIME_TO_LIGHT_OFF_CONDITION_RESET", "TIME_TO_LIGHT_OFF_SEC", Nothing, 0, "NONE")
            TimeToGITimerCtrl = New TimerController(Me, "TIME_TO_GI_START_CONDITION_LATCH", "TIME_TO_GI_STOP_CONDITION_LATCH", "TIME_TO_GI_CONDITION_RESET", "TIME_TO_GI_SEC", Nothing, 0, "NONE")
            TimeToCDTimerCtrl = New TimerController(Me, "TIME_TO_COAST_DOWN_START_CONDITION", "TIME_TO_COAST_DOWN_STOP_CONDITION", "TIME_TO_COAST_DOWN_CONDITION_RESET", "TIME_TO_COAST_DOWN_SEC", Nothing, 0, "NONE")
            If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then
                OperatingTimerCtrl = New TimerController(Me, "OPERATING_TIME_START_CONDITION", "OPERATING_TIME_STOP_CONDITION", "OPERATING_TIME_CONDITION_RESET", "OPERATING_TIME_SEC", "OPERATING_TIME_HHMMSS", 0, "NONE", True)
            End If
            OverspeedRelightTimerCtrl = New TimerController(Me, "OVERSPEED_RELIGHT_DELAY_START_CONDITION", "OVERSPEED_RELIGHT_DELAY_STOP_CONDITION", "OVERSPEED_RELIGHT_DELAY_RESET_CONDITION", "OVERSPEED_RELIGHT_TIME_SEC", Nothing, 8, "OVERSPEED_RELIGHT_DELAY_MAX_TIME_REACHED")
            StopWatchTimerCtrl = New TimerController(Me, "STOPWATCH_START_CONDITION", "STOPWATCH_STOP_CONDITION", "STOPWATCH_RESET_CONDITION", "STOPWATCH_TIME_SEC", "STOPWATCH_TIME", 0, Nothing, False)

            AirStarterRampUpCtrl = New RampUpController(Me, "AIR_STARTER_RAMPUP_CURRENT_LOW_LIMIT", "AIR_STARTER_RAMPUP_CURRENT_HIGH_LIMIT", "AIR_STARTUP_RAMPUP_TIME", "AIR_STARTER_BTN", "AIR_STARTER_CURRENT_CMD")
            NRFrequenceRampUpCtrl = New RampUpDownController(Me, "NR_FREQUENCY_LOW", "NR_FREQUENCY_HIGH", "NR_FREQUENCY_TIME", "NR_FREQUENCY_REVERSE_BTN", "NR_FREQUENCY_SELECTED")

            DynoPumpDriveCtrl = New AutomaticPumpDriveCurrentController(Me, "DYNO_WATER_PUMP_DRIVE_CURRENT_LOW_RANGE", "DYNO_WATER_PUMP_DRIVE_CURRENT_HIGH_RANGE",
                                                                        "DYNO_WATER_PUMP_DRIVE_CURRENT_FOR_LOW_SPEED", "DYNO_WATER_PUMP_DRIVE_CURRENT_FOR_HIGH_SPEED",
                                                                        "DYNO_WATER_PUMP_DRIVE_ENGINE_LOW_SPEED_TRIGGER", "DYNO_WATER_PUMP_DRIVE_ENGINE_HIGH_SPEED_TRIGGER",
                                                                        "DYNO_WATER_SUPPLY_PUMP_BTN", "NG_RPM", "DYNO_WATER_PUMP_DRIVE_CURRENT_CMD")

        End Sub
