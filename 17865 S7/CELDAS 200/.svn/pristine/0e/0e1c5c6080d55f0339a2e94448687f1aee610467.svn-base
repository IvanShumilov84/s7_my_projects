        '*****************************
        '* OnTFCOverrideButton       *
        '*****************************
        Private Sub OnTFCOverrideButton(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            If (CELProject.IsFalse(newVal) And TFC_Password_OK = True) Then
                TFC_Password_OK = False
            End If

            If (CELProject.IsTrue(newVal) And TFC_Password_OK = False) Then

                TFC_OVERRIDE_BTN.Value = KineticaRT.Values.Values.False
                TFC_Password_TextBox.Text = ""
                CELProject.ActivateForm("TFC_Password", "T700_Master_Screen", True, False)
            End If
        End Sub
        '****************************
        '* OnCancel_TFC_Password()  *
        '****************************
        Private Sub OnCancel_TFC_Password(sender As KineticaRT.Channels.IChannel, newVal As KineticaRT.Values.Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    CELProject.ActivateForm("TFC_Password", "T700_Master_Screen", False, False)
                    TFC_OVERRIDE_BTN.Value = KineticaRT.Values.Values.False
                End If
            Catch ex As Exception
                MessageBox.Show("T700_Sequence: OnCancel_TFC_Password: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub
        '***********************
        '* OnOK_TFC_Password() *
        '***********************
        Private Sub OnOK_TFC_Password(sender As KineticaRT.Channels.IChannel, newVal As KineticaRT.Values.Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    If PasswordTestManager() Then
                        CELProject.ActivateForm("TFC_Password", "T700_Master_Screen", False, False)
                        TFC_Password_OK = True
                        TFC_OVERRIDE_BTN.Value = KineticaRT.Values.Values.True
                    Else
                        MessageBox.Show("Error: Wrong Password", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                    End If

                    'Re-Initialize OK Password Button Value
                    OK_TFC_Password.Value = KineticaRT.Values.Values.False
                    TFC_Password_TextBox.Text = ""

                End If
            Catch ex As Exception
                MessageBox.Show("T700_Sequence: OnOK_TFC_Password: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Function PasswordTestManager() As Boolean

            Dim ConnectionString As String = "Provider=Microsoft.Jet.OLEDB.4.0; Data Source=" + TESTSESSION_DATABASENAME + ";Jet OLEDB:System database=" + TESTSESSION_DATABASEWORKGROUP + "; User ID=" + TESTSESSION_DATABASEUSERID + "; Password=" + TESTSESSION_DATABASEPASSWORD
            Dim SelectString As String = "SELECT * FROM Users"
            Dim RecordSet As New ADODB.Recordset
            Dim Connection As New ADODB.Connection

            Try
                If DatabaseHelper.OpenConnection(CELProject.Database.OleDbConnectionString, Connection, True) Then
                    'Get the user and password from TestSession Database
                    If DatabaseHelper.OpenRecordset(RecordSet, SelectString, Connection, True) Then
                        While Not RecordSet.EOF
                            If RecordSet.Fields("Password").Value.ToString = TFC_Password_TextBox.Text Then

                                Dim str As String = RecordSet.Fields("SecurityLevelID").Value.ToString()

                                PasswordTestManager = (RecordSet.Fields("SecurityLevelID").Value = 3) ' Test Manager
                                Exit While
                            End If
                            RecordSet.MoveNext()
                        End While
                    End If
                    DatabaseHelper.CloseConnection(Connection)
                End If

                PasswordTestManager = True

            Catch ex As Exception
                MessageBox.Show("T700_Sequence: PasswordTestManager: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                PasswordTestManager = False
            End Try
        End Function

