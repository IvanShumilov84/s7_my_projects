        '********************
        '* OnCloseTest()    *
        '********************
        Protected Overrides Sub OnCLOSE_TEST_BTN(sender As IChannel, newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    TFC_Password_OK = False

                    'force a last calculation of fuel emission before closing
                    If TFC_END_SESSION = 0 Then
                        TFC_END_SESSION = 1
                        '                        TFC_Emission_Calculation()
                    End If
                    If CELProject.EngineFamily = "T700" Then

                        CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.OnCLOSE_TEST_BTN_DISPOSE))

                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("OnClose_Test: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        '************************
        '* OnCloseTestDispose() *
        '************************
        Private Sub OnCLOSE_TEST_BTN_DISPOSE()
            Try

                If CELProject.EngineFamily = "T700" Then

                    MyBase.StopWorkingThread()

                    'Persistent Values Force Save
                    If Not (PersistentValuesCtrl Is Nothing) Then
                        PersistentValuesCtrl.SavePersistentValues(True)
                    End If

                    RemoveHandlers()

                    Dispose_Engine_Controllers()

                End If

            Catch ex As Exception
                MessageBox.Show("OnClose_Test_Dispose: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionInitialized(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionInitialized(newStatus)

                If CELProject.EngineFamily = "T700" Then

                    UserInputs.MapUserInputsParameters(CELProject)

                    CELProject.EngineSession.WorkingFolder = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + UserInputs.EngineSerialNumber + "\" + UserInputs.WorkOrder
                    CELProject.CreateLogFile(AddressOf CreateCustomHeaderLogFile, CELProject.EngineModel, CELProject.EngineModel)

                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionInitialized: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)

            Catch ex As Exception

                MessageBox.Show("PW150_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            End Try
        End Sub

        Protected Overrides Sub OnTestSessionRunning(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionRunning(newStatus)

                If CELProject.EngineFamily = "T700" Then

                    Init_Channels()

                    Init_Engine_Controls()

                    Init_Engine_Channels()

                    Init_Engine_Channels_Value()

                    Init_Engine_Controllers()

                    AddHandlers()

                    If CELProject.HierarchyType = CELDAS.eHierarchyType.Master Then
                        HIERACHYTYPE_MASTER.Value = New KineticaRT.Values.Boolean(True)
                    Else
                        HIERACHYTYPE_MASTER.Value = New KineticaRT.Values.Boolean(False)
                    End If
                    TFC_Read_Config()

                    TestProgress_Initialize()

                    MyBase.StartWorkingThread()

                    Select Case CELProject.EngineModel
                        Case "T700-401"
                            CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.Initialize_Engine_Controls_401))

                        Case "T700-401C"
                            CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.Initialize_Engine_Controls_401C))

                        Case "T700-700"
                            CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.Initialize_Engine_Controls_700))

                        Case "T700-701C"
                            CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.Initialize_Engine_Controls_701C))

                        Case "T700-701D"
                            CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.Initialize_Engine_Controls_701D))
                    End Select
                    CELProject.LoadSave_Custom_Parameters(Custom_Parameters, False)

                End If
            Catch ex As Exception
                MessageBox.Show("OnTestSessionRunning: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub
