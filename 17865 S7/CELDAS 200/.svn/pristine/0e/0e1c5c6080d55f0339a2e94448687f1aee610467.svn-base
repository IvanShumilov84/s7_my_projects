        Protected Overrides Sub OnLOG_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            If CELProject.IsTrue(newVal) Then

                Dim pleaseWait As New PleaseWaitForm("Please wait while saving log data...")
                pleaseWait.Show()

                'Update the Log/Perf channel set
                CELProject.LogPerfSynch.UpdateValues()
                FlowmeterCtrl.ComputeFlow(True)
                CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, False, CELProject.EngineModel, True)
                CELProject.LOG_TAKE_POINT_BTN.Value = Values.False

                pleaseWait.Hide()
            End If
        End Sub

        Protected Overrides Sub OnNEW_TEST_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If (CELProject.IsTrue(newVal)) Then

                    If DialogResult.Yes = MessageBox.Show("Do you want to reset the fuel used, the operating time, the DRP Reading Number and the number of starts?", "CELDAS200", MessageBoxButtons.YesNo, MessageBoxIcon.Question) Then

                        NEW_TEST_TRIGGER_OPC.Value = Values.True

                    End If

                End If
            Catch ex As Exception
                MessageBox.Show("T700_Sequence: OnNEW_TEST_BTN: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Sub OnNEW_TEST_PROGRESS_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If (CELProject.IsTrue(newVal)) Then

                    TestProgress_Save(True)

                    Dim dataInfo As CEL.TestProgress.TestProgressMgr.TestProgress_DataInfo = TestProgressMgr.DataInfo

                    Dim testProgressSheet As CEL.TestProgress.TestProgressSheet = Nothing
                    testProgressSheet = New CEL.TestProgress.TestProgressSheet(dataInfo.UUTModel, _
                                                                           dataInfo.UUTSerialNumber, _
                                                                           dataInfo.UUTWorkOrder)
                    TestProgressMgr.InitTestProgressSheet(testProgressSheet)

                    Dim newFileName = CELProject.EngineSession.LogFolder + "TestProgress " + Format(Now, "yyyy-MM-dd HH'h'mm'm'ss's'")
                    dataInfo.TestProgressSheetFileName = newFileName + ".xml"
                    dataInfo.TestProgressTextFileName = newFileName + ".txt"
                    TestProgressMgr.DataInfo = dataInfo
                    TestProgressMgr.TestProgressText = System.Environment.NewLine + "Engine model         : " + TestProgressMgr.DataInfo.UUTModel + System.Environment.NewLine
                    TestProgressMgr.TestProgressText += "Engine serial number : " + TestProgressMgr.DataInfo.UUTSerialNumber + System.Environment.NewLine
                    TestProgressMgr.TestProgressText += "Test Cell            : 002" + System.Environment.NewLine + System.Environment.NewLine
                End If
            Catch ex As Exception
                MessageBox.Show("T700_Sequence: OnNEW_TEST_PROGRESS_BTN: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
            NEW_TEST_PROGRESS_BTN.Value = Values.False
        End Sub

        Protected Sub OnNEW_TEST_PROGRESS_VIEW_REPORT_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If (CELProject.IsTrue(newVal)) Then

                    TestProgress_Save(False)

                    Dim fileName As String
                    Dim File_Dialog As New OpenFileDialog()

                    File_Dialog.Reset()
                    File_Dialog.Filter = "TestProgress (*.xlsx)|*.txt"
                    File_Dialog.FilterIndex = 1

                    File_Dialog.Title = "View Test Progress Report"
                    File_Dialog.InitialDirectory = CELProject.EngineSession.LogFolder 'EngineFolder + "\Log\"

                    If File_Dialog.ShowDialog() = DialogResult.OK Then
                        fileName = File_Dialog.FileName
                    Else
                        fileName = ""
                    End If

                    If fileName <> "" Then
                        If File.Exists(fileName) Then

                            Try
                                Process.Start(fileName)
                            Catch ex As Exception
                                MessageBox.Show("T700_Sequence: OnNEW_TEST_PROGRESS_VIEW_REPORT_BTN Process.Start: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            End Try

                        End If
                    End If

                End If
            Catch ex As Exception
                MessageBox.Show("T700_Sequence: OnNEW_TEST_PROGRESS_VIEW_REPORT_BTN: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
            NEW_TEST_PROGRESS_VIEW_REPORT_BTN.Value = Values.False
        End Sub

        Protected Sub OnNEW_TEST_TRIGGER_OPC(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If (CELProject.IsTrue(newVal)) Then

                    OPERATING_TIME_CONDITION_RESET.Value = Values.True

                    FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                    FUEL_USED_INITIAL_KG.Value = Values.Zero
                    WF_TOT1.Value = Values.Zero
                    WF_TOT2.Value = Values.Zero
                    WF_TOT_WEIGHT1.Value = Values.Zero
                    WF_TOT_WEIGHT2.Value = Values.Zero

                    NB_ENGINE_START.Value = Values.Zero
                    NB_ENGINE_START_OPC.Value = NB_ENGINE_START.Value

                    OPERATING_TIME_CONDITION_RESET.Value = Values.False
                    OPERATING_TIME_HHMMSS_OPC.Value = New Global.KineticaRT.Values.Text(Format(DateAdd("s", OPERATING_TIME_SEC.Value.ToDouble(), "00:00:00"), "HH:mm:ss"))

                    NEW_TEST_TRIGGER_OPC.Value = Values.False

                End If
            Catch ex As Exception
                MessageBox.Show("T700_Sequence: OnNewTest: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Private Sub TFC_Emission_Calculation()

            If TFC_END_SESSION = 2 Then
                Exit Sub 'already processed the last one, no more processing required the close can be done
            ElseIf TFC_END_SESSION = 1 Then
                TFC_END_SESSION = 2 'we will execute the function a last time
            End If

            If NG_PCT Is Nothing Or WF_PPH Is Nothing Or FUEL_USED_TOTAL_LITERS Is Nothing Or FUEL_USED_TOTAL_KG Is Nothing Then
                Exit Sub
            End If

            Dim EngineSpeed As Double = NG_PCT.Value.ToDouble
            Dim BleedFlow As Double = WF_PPH.Value.ToDouble / 60.0
            Dim LoadTorque As Double = TORQUE_METER_TORQUE_LBSFT.Value.ToDouble
            Dim FuelValue As Double = (FUEL_USED_TOTAL_KG.Value.ToDouble + TFC_DB_OFFSET_Fuel_Mass)
            Dim FuelVolumeGal As Double = FUEL_USED_TOTAL_LITERS.Value.ToDouble * 0.2641721 + TFC_DB_OFFSET_Fuel_Volume  'convert L to gallons

            If Double.IsNaN(EngineSpeed) Or Double.IsNaN(BleedFlow) Or Double.IsNaN(LoadTorque) Or Double.IsNaN(FuelValue) Or Double.IsNaN(FuelVolumeGal) Then
                If TFC_END_SESSION = 2 Then
                    TFC_SendFileToSQLServer()
                End If

                Exit Sub
            End If

            ' refresh the corrected sensor value
            TFC_CORR_FUEL_KG.Value = New KineticaRT.Values.Double(FuelValue)
            TFC_CORR_FUEL_GALLONS.Value = New KineticaRT.Values.Double(FuelVolumeGal)
            TFC_TIME_LOSS_FUEL_SENSOR = Now.AddSeconds(TFC_FUEL_LOSS_TIMEOUT) 'sensor is good just postponed the time to shutdown

            'Check if the 5 second since last calculation is expired Or TFC end session flag is 2
            If Date.Compare(Now, TFC_NextTimeToCalc) >= 0 Or TFC_END_SESSION = 2 Then

                TFC_NextTimeToCalc = Now.AddSeconds(TFC_CALC_PERIOD)

                Dim CO_Constant As Double
                Dim HC_Constant As Double
                Dim NOX_Constant As Double

                ' Engine Speed unit is %,  BleedFlow unit is ppm, and Power unit is in kW
                Dim FL_mode As Boolean = (EngineSpeed > 95.0) And (BleedFlow > 4.0) And (LoadTorque > 600.0)
                Dim NL_mode As Boolean = (EngineSpeed > 95.0) And (BleedFlow < 0.5) And (LoadTorque < 50.0)

                If FL_mode Then
                    TFC_DISPLAY_MODE.Value = New KineticaRT.Values.Text("FL")
                    CO_Constant = TFC_DB_Constant_FL_CO
                    HC_Constant = TFC_DB_Constant_FL_HC
                    NOX_Constant = TFC_DB_Constant_FL_Nox

                ElseIf NL_mode Then
                    TFC_DISPLAY_MODE.Value = New KineticaRT.Values.Text("NL")
                    CO_Constant = TFC_DB_Constant_NL_CO
                    HC_Constant = TFC_DB_Constant_NL_HC
                    NOX_Constant = TFC_DB_Constant_NL_Nox
                Else
                    TFC_DISPLAY_MODE.Value = New KineticaRT.Values.Text("Worst Case")
                    CO_Constant = TFC_DB_Constant_WC_CO
                    HC_Constant = TFC_DB_Constant_WC_HC
                    NOX_Constant = TFC_DB_Constant_WC_Nox
                End If

                'transfer the value to the channel for display
                TFC_DISPLAY_CO_CONSTANT.Value = New KineticaRT.Values.Double(CO_Constant)
                TFC_DISPLAY_HC_CONSTANT.Value = New KineticaRT.Values.Double(HC_Constant)
                TFC_DISPLAY_NOX_CONSTANT.Value = New KineticaRT.Values.Double(NOX_Constant)

                '                If FuelStatus Then
                Dim FuelDiff As Double = FuelValue - TFC_FILE_FUEL_KG

                'since the fuel mass sensor give us erratic number sometime we have to ignore some value to protect our calculation
                If FuelDiff < 0 Then 'invalid negative difference
                    If Abs(FuelDiff) > 0.01 Then 'ignore little error
                        TFC_Log_Error("The calculated fuel difference is negative, previous value: " + TFC_FILE_FUEL_KG.ToString + " and actual value: " + FuelValue.ToString)
                    End If
                    Exit Sub
                End If

                If FuelDiff > 30 Then 'arbitrary 30 Kg in the last 5 seconds (or more depending on how many value we discard
                    TFC_Log_Error("The calculated fuel difference is too high, previous value: " + TFC_FILE_FUEL_KG.ToString + " and actual value: " + FuelValue.ToString)
                    Exit Sub
                End If

                TFC_FILE_PERIOD_CO = TFC_FILE_PERIOD_CO + (FuelDiff * CO_Constant / 1000.0)
                TFC_FILE_PERIOD_HC = TFC_FILE_PERIOD_HC + (FuelDiff * HC_Constant / 1000.0)
                TFC_FILE_PERIOD_NOX = TFC_FILE_PERIOD_NOX + (FuelDiff * NOX_Constant / 1000.0)

                TFC_FILE_TOT_CO = TFC_FILE_TOT_CO + (FuelDiff * CO_Constant / 1000.0)
                TFC_FILE_TOT_HC = TFC_FILE_TOT_HC + (FuelDiff * HC_Constant / 1000.0)
                TFC_FILE_TOT_NOX = TFC_FILE_TOT_NOX + (FuelDiff * NOX_Constant / 1000.0)

                TFC_FILE_FUEL_KG = FuelValue
                TFC_FILE_FUEL_GALLONS = FuelVolumeGal

                'transfer the value to the channel for display
                TFC_TOT_CO_PERIOD.Value = New KineticaRT.Values.Double(TFC_FILE_PERIOD_CO)
                TFC_TOT_HC_PERIOD.Value = New KineticaRT.Values.Double(TFC_FILE_PERIOD_HC)
                TFC_TOT_NOX_PERIOD.Value = New KineticaRT.Values.Double(TFC_FILE_PERIOD_NOX)
                TFC_LAST_FM_SENSOR.Value = New KineticaRT.Values.Double(TFC_FILE_FUEL_KG)
                'End If
            End If ' end of calculation done every 5 seconds

            Dim FuelSensorLoss As Boolean = Date.Compare(Now, TFC_TIME_LOSS_FUEL_SENSOR) >= 0
            Dim ExpireDate As Boolean = Date.Compare(Now, TFC_DB_PermitExpirationDate.ToString()) >= 0
            Dim OverStopping As Boolean = (TFC_FILE_PERIOD_NOX >= TFC_DB_NOX_STOP_LIMIT) Or (TFC_FILE_PERIOD_CO >= TFC_DB_CO_STOP_LIMIT) Or (TFC_FILE_PERIOD_HC >= TFC_DB_HC_STOP_LIMIT)
            Dim OverStarting As Boolean = (TFC_FILE_PERIOD_NOX >= TFC_DB_NOX_START_LIMIT) Or (TFC_FILE_PERIOD_CO >= TFC_DB_CO_START_LIMIT) Or (TFC_FILE_PERIOD_HC >= TFC_DB_HC_START_LIMIT)
            Dim ColorDisplay As System.Drawing.Color

            If ExpireDate Or OverStopping Then
                FUEL_CONSUMPTION_STATUS.Value = New KineticaRT.Values.Double(2.0)
            ElseIf OverStarting Then
                FUEL_CONSUMPTION_STATUS.Value = New KineticaRT.Values.Double(1.0)
            Else
                FUEL_CONSUMPTION_STATUS.Value = New KineticaRT.Values.Double(0.0)
            End If

            If ExpireDate Or OverStopping Or FuelSensorLoss Then
                If EngineSpeed < 1.0 Then 'engine is not running
                    TFC_TIME_BEFORE_SHUTDOWN.Value = New KineticaRT.Values.Text("not scheduled") 'no shutdown planned
                    TFC_TIME_TO_SHUTDOWN = Now.AddDays(-1.0) 'old date 
                    ColorDisplay = System.Drawing.Color.White
                Else
                    Dim DiffTime As System.TimeSpan = TFC_TIME_TO_SHUTDOWN.Subtract(Now)
                    TFC_TIME_BEFORE_SHUTDOWN.Value = New KineticaRT.Values.Text(DiffTime.Minutes.ToString() + ":" + DiffTime.Seconds.ToString())
                    ColorDisplay = System.Drawing.Color.Red
                End If
            Else
                TFC_TIME_BEFORE_SHUTDOWN.Value = New KineticaRT.Values.Text("not scheduled") ' old date so no shutdown planned
                TFC_TIME_TO_SHUTDOWN = Now.AddMinutes(TFC_SHUTDOWN_TIMEOUT)
                ColorDisplay = System.Drawing.Color.White
            End If

            If Date.Compare(Now, TFC_TIME_TO_SHUTDOWN) >= 0 And EngineSpeed > 1.0 Then
                TFC_TIME_BEFORE_SHUTDOWN.Value = New KineticaRT.Values.Text("cmd shutdown")
                ColorDisplay = System.Drawing.Color.Red
                AIR_STARTER_BTN.Value = Values.False
                MAIN_FUEL_VALVE_BTN.Value = Values.False
                IGNITION_BTN.Value = Values.False
            End If

            'update the display color
            TFC_TIME_BEF_SHUTDOWN_DISPLAY.ForeColor = ColorDisplay
            TFC_TIME_BEF_SHUTDOWN_DISPLAY.ValueBackColor = ColorDisplay
            '            TFC_TIME_BEF_SHUTDOWN_DISPLAY2.ForeColor = ColorDisplay
            '            TFC_TIME_BEF_SHUTDOWN_DISPLAY2.ValueBackColor = ColorDisplay

            ' is it time to send the data to the SQL Server?
            If Date.Compare(Now, TFC_NextTimeToSend) >= 0 Or TFC_END_SESSION = 2 Then

                TFC_NextTimeToSend = Now.AddSeconds(TFC_SEND_FILE_PERIOD_SEC)

                TFC_SendFileToSQLServer()

            End If
        End Sub
        Private Sub TFC_Read_Config()

            'Connect to the TestSession Database
            Dim ConnectionString As String = "Provider=Microsoft.Jet.OLEDB.4.0; Data Source=" + TESTSESSION_DATABASENAME + ";Jet OLEDB:System database=" + TESTSESSION_DATABASEWORKGROUP + "; User ID=" + TESTSESSION_DATABASEUSERID + "; Password=" + TESTSESSION_DATABASEPASSWORD
            Dim SelectString As String = "SELECT * FROM TestCell14105FuelEmissionsData"
            Dim RecordSet As New ADODB.Recordset
            Dim Connection As New ADODB.Connection

            TFC_NextTimeToSend = Now.AddSeconds(TFC_SEND_FILE_PERIOD_SEC)
            TFC_NextTimeToCalc = Now.AddSeconds(TFC_CALC_PERIOD)
            TFC_TIME_TO_SHUTDOWN = Now.AddDays(-1.0) 'old date
            TFC_TIME_LOSS_FUEL_SENSOR = Now.AddSeconds(TFC_FUEL_LOSS_TIMEOUT)
            TFC_END_SESSION = 0
            TFC_TIME_BEFORE_SHUTDOWN.Value = New KineticaRT.Values.Text("not scheduled")
            FUEL_CONSUMPTION_STATUS.Value = New KineticaRT.Values.Double(0.0)

            Try
                If DatabaseHelper.OpenConnection(CELProject.Database.OleDbConnectionString, Connection, True) Then
                    If DatabaseHelper.OpenRecordset(RecordSet, SelectString, Connection, False) Then

                        'Read the value for the database
                        TFC_DB_CO_LIMIT = RecordSet.Fields("CO Permit Limit (kg)").Value.ToString
                        TFC_DB_CO_START_MARGIN = RecordSet.Fields("CO Starting Margin (kg)").Value.ToString
                        TFC_DB_CO_STOP_MARGIN = RecordSet.Fields("CO Stopping Margin (kg)").Value.ToString
                        TFC_DB_HC_LIMIT = RecordSet.Fields("HC Permit Limit (kg)").Value.ToString
                        TFC_DB_HC_START_MARGIN = RecordSet.Fields("HC Starting Margin (kg)").Value.ToString()
                        TFC_DB_HC_STOP_MARGIN = RecordSet.Fields("HC Stopping Margin (kg)").Value.ToString()
                        TFC_DB_NOX_LIMIT = RecordSet.Fields("Nox Permit Limit (kg)").Value.ToString
                        TFC_DB_NOX_START_MARGIN = RecordSet.Fields("Nox Starting Margin (kg)").Value.ToString
                        TFC_DB_NOX_STOP_MARGIN = RecordSet.Fields("Nox Stopping Margin (kg)").Value.ToString
                        TFC_DB_PermitExpirationDate = RecordSet.Fields("Permit Expiration Date").Value.ToString

                        'transfer the value to the channel for display
                        TFC_CO_Limit.Value = New KineticaRT.Values.Double(TFC_DB_CO_LIMIT)
                        TFC_CO_Start_Margin.Value = New KineticaRT.Values.Double(TFC_DB_CO_START_MARGIN)
                        TFC_CO_Stop_Margin.Value = New KineticaRT.Values.Double(TFC_DB_CO_STOP_MARGIN)
                        TFC_HC_Limit.Value = New KineticaRT.Values.Double(TFC_DB_HC_LIMIT)
                        TFC_HC_Start_Margin.Value = New KineticaRT.Values.Double(TFC_DB_HC_START_MARGIN)
                        TFC_HC_Stop_Margin.Value = New KineticaRT.Values.Double(TFC_DB_HC_STOP_MARGIN)
                        TFC_NOX_Limit.Value = New KineticaRT.Values.Double(TFC_DB_NOX_LIMIT)
                        TFC_NOX_Start_Margin.Value = New KineticaRT.Values.Double(TFC_DB_NOX_START_MARGIN)
                        TFC_NOX_Stop_Margin.Value = New KineticaRT.Values.Double(TFC_DB_NOX_STOP_MARGIN)
                        TFC_PermitExpirationDate.Value = New KineticaRT.Values.Text(TFC_DB_PermitExpirationDate.ToString)

                        'calculate the real limit based on the margin
                        TFC_DB_CO_STOP_LIMIT = TFC_DB_CO_LIMIT - TFC_DB_CO_STOP_MARGIN
                        TFC_DB_CO_START_LIMIT = TFC_DB_CO_STOP_LIMIT - TFC_DB_CO_START_MARGIN
                        TFC_DB_HC_STOP_LIMIT = TFC_DB_HC_LIMIT - TFC_DB_HC_STOP_MARGIN
                        TFC_DB_HC_START_LIMIT = TFC_DB_HC_STOP_LIMIT - TFC_DB_HC_START_MARGIN
                        TFC_DB_NOX_STOP_LIMIT = TFC_DB_NOX_LIMIT - TFC_DB_NOX_STOP_MARGIN
                        TFC_DB_NOX_START_LIMIT = TFC_DB_NOX_STOP_LIMIT - TFC_DB_NOX_START_MARGIN

                        'transfer the value to the channel for display
                        TFC_DISPLAY_CO_STOP_LIMIT.Value = New KineticaRT.Values.Double(TFC_DB_CO_STOP_LIMIT)
                        TFC_DISPLAY_CO_START_LIMIT.Value = New KineticaRT.Values.Double(TFC_DB_CO_START_LIMIT)
                        TFC_DISPLAY_HC_STOP_LIMIT.Value = New KineticaRT.Values.Double(TFC_DB_HC_STOP_LIMIT)
                        TFC_DISPLAY_HC_START_LIMIT.Value = New KineticaRT.Values.Double(TFC_DB_HC_START_LIMIT)
                        TFC_DISPLAY_NOX_STOP_LIMIT.Value = New KineticaRT.Values.Double(TFC_DB_NOX_STOP_LIMIT)
                        TFC_DISPLAY_NOX_START_LIMIT.Value = New KineticaRT.Values.Double(TFC_DB_NOX_START_LIMIT)

                        ' Set the bargraph limit
                        TFC_TOT_CO_PERIOD.Maximum = TFC_DB_CO_LIMIT
                        TFC_TOT_HC_PERIOD.Maximum = TFC_DB_HC_LIMIT
                        TFC_TOT_NOX_PERIOD.Maximum = TFC_DB_NOX_LIMIT



                        TFC_DB_Constant_FL_CO = RecordSet.Fields(CELProject.EngineModel + "_FL_CO (gr/kg)").Value.ToString()
                        TFC_DB_Constant_FL_HC = RecordSet.Fields(CELProject.EngineModel + "_FL_HC (gr/kg)").Value.ToString()
                        TFC_DB_Constant_FL_Nox = RecordSet.Fields(CELProject.EngineModel + "_FL_Nox (gr/kg)").Value.ToString()
                        TFC_DB_Constant_NL_CO = RecordSet.Fields(CELProject.EngineModel + "_NL_CO (gr/kg)").Value.ToString()
                        TFC_DB_Constant_NL_HC = RecordSet.Fields(CELProject.EngineModel + "_NL_HC (gr/kg)").Value.ToString()
                        TFC_DB_Constant_NL_Nox = RecordSet.Fields(CELProject.EngineModel + "_NL_Nox (gr/kg)").Value.ToString()
                        TFC_DB_Constant_WC_CO = RecordSet.Fields(CELProject.EngineModel + "_WC_CO (gr/kg)").Value.ToString()
                        TFC_DB_Constant_WC_HC = RecordSet.Fields(CELProject.EngineModel + "_WC_HC (gr/kg)").Value.ToString()
                        TFC_DB_Constant_WC_Nox = RecordSet.Fields(CELProject.EngineModel + "_WC_Nox (gr/kg)").Value.ToString()
                        TFC_DB_HS_TC_Fuel_Name = RecordSet.Fields("HS Test Identifier").Value.ToString()
                        TFC_DB_OFFSET_Fuel_Mass = RecordSet.Fields("Fuel Mass Offset (kg)").Value.ToString()
                        TFC_DB_OFFSET_Fuel_Volume = RecordSet.Fields("Fuel Volume Offset (gallons)").Value.ToString()

                        'Read last file sent and init the variable
                        Dim LogPath As String = "C:\CELDAS DATA\Fuel Emission\"
                        If Not My.Computer.FileSystem.DirectoryExists(LogPath) Then
                            My.Computer.FileSystem.CreateDirectory(LogPath)
                        End If
                        TFC_LastMassFileName = LogPath + "Last_Mass_Fuel_Processed.txt"

                        If My.Computer.FileSystem.FileExists(TFC_LastMassFileName) Then

                            Using sr As New StreamReader(TFC_LastMassFileName)

                                Dim line As String

                                line = sr.ReadLine() ' skip the first line, date
                                line = sr.ReadLine() ' skip the second line time

                                line = sr.ReadLine()

                                If Not line.Contains("Total Fuel Consumed from sensor in kg =") Then
                                    MessageBox.Show("Error/Blad: Last_Mass_Fuel_Process.txt file: item in wrong order")
                                    Exit Sub
                                End If

                                TFC_FILE_FUEL_KG = line.Remove(0, 1 + line.IndexOf("="))

                                line = sr.ReadLine()

                                If Not line.Contains("Total Fuel Consumed from sensor in gallons =") Then
                                    MessageBox.Show("Error/Blad: Last_Mass_Fuel_Process.txt file: item in wrong order")
                                    Exit Sub
                                End If

                                TFC_FILE_FUEL_GALLONS = line.Remove(0, 1 + line.IndexOf("="))

                                line = sr.ReadLine()

                                If Not line.Contains("Total Nox emissions for the period in kg =") Then
                                    MessageBox.Show("Error/Blad: Last_Mass_Fuel_Process.txt file: item in wrong order")
                                    Exit Sub
                                End If

                                TFC_FILE_PERIOD_NOX = line.Remove(0, 1 + line.IndexOf("="))

                                line = sr.ReadLine()

                                If Not line.Contains("Total CO emissions for the period in kg =") Then
                                    MessageBox.Show("Error/Blad: Last_Mass_Fuel_Process.txt file: item in wrong order")
                                    Exit Sub
                                End If

                                TFC_FILE_PERIOD_CO = line.Remove(0, 1 + line.IndexOf("="))

                                line = sr.ReadLine()

                                If Not line.Contains("Total HC emissions for the period in kg =") Then
                                    MessageBox.Show("Error/Blad: Last_Mass_Fuel_Process.txt file: item in wrong order")
                                    Exit Sub
                                End If

                                TFC_FILE_PERIOD_HC = line.Remove(0, 1 + line.IndexOf("="))

                                line = sr.ReadLine()

                                If Not line.Contains("Total Nox emissions in kg =") Then
                                    MessageBox.Show("Error/Blad: Last_Mass_Fuel_Process.txt file: item in wrong order")
                                    Exit Sub
                                End If

                                TFC_FILE_TOT_NOX = line.Remove(0, 1 + line.IndexOf("="))

                                line = sr.ReadLine()

                                If Not line.Contains("Total CO emissions in kg =") Then
                                    MessageBox.Show("Error/Blad: Last_Mass_Fuel_Process.txt file: item in wrong order")
                                    Exit Sub
                                End If

                                TFC_FILE_TOT_CO = line.Remove(0, 1 + line.IndexOf("="))

                                line = sr.ReadLine()

                                If Not line.Contains("Total HC emissions in kg") Then
                                    MessageBox.Show("Error/Blad: Last_Mass_Fuel_Process.txt file: item in wrong order")
                                    Exit Sub
                                End If

                                TFC_FILE_TOT_HC = line.Remove(0, 1 + line.IndexOf("="))

                                line = sr.ReadLine()

                                If Not line.Contains("Expiration Date =") Then
                                    MessageBox.Show("Error/Blad: Last_Mass_Fuel_Process.txt file: item in wrong order")
                                    Exit Sub
                                End If

                                TFC_FILE_EXP_DATE = System.DateTime.ParseExact(line.Remove(0, 1 + line.IndexOf("=")).Trim(), "MM/dd/yyyy", Nothing)

                            End Using
                        Else
                            TFC_FILE_FUEL_KG = 0.0
                            TFC_FILE_FUEL_GALLONS = 0.0
                            TFC_FILE_PERIOD_NOX = 0.0
                            TFC_FILE_PERIOD_CO = 0.0
                            TFC_FILE_PERIOD_HC = 0.0
                            TFC_FILE_TOT_NOX = 0.0
                            TFC_FILE_TOT_CO = 0.0
                            TFC_FILE_TOT_HC = 0.0
                            TFC_FILE_EXP_DATE = New System.DateTime(1, 1, 1)

                        End If

                        'transfer the value to the channel for display
                        TFC_DISPLAY_LAST_FUEL_KG.Value = New KineticaRT.Values.Double(TFC_FILE_FUEL_KG)
                        TFC_DISPLAY_LAST_FUEL_GALLONS.Value = New KineticaRT.Values.Double(TFC_FILE_FUEL_GALLONS)
                        TFC_DISPLAY_LAST_TOT_NOX.Value = New KineticaRT.Values.Double(TFC_FILE_TOT_NOX)
                        TFC_DISPLAY_LAST_TOT_CO.Value = New KineticaRT.Values.Double(TFC_FILE_TOT_CO)
                        TFC_DISPLAY_LAST_TOT_HC.Value = New KineticaRT.Values.Double(TFC_FILE_TOT_HC)
                        TFC_DISPLAY_LAST_PERIOD_NOX.Value = New KineticaRT.Values.Double(TFC_FILE_PERIOD_NOX)
                        TFC_DISPLAY_LAST_PERIOD_CO.Value = New KineticaRT.Values.Double(TFC_FILE_PERIOD_CO)
                        TFC_DISPLAY_LAST_PERIOD_HC.Value = New KineticaRT.Values.Double(TFC_FILE_PERIOD_HC)
                        TFC_DISPLAY_LAST_EXP_DATE.Value = New KineticaRT.Values.Text(TFC_FILE_EXP_DATE.ToString)
                        TFC_TOT_CO_PERIOD.Value = New KineticaRT.Values.Double(TFC_FILE_PERIOD_CO)
                        TFC_TOT_HC_PERIOD.Value = New KineticaRT.Values.Double(TFC_FILE_PERIOD_HC)
                        TFC_TOT_NOX_PERIOD.Value = New KineticaRT.Values.Double(TFC_FILE_PERIOD_NOX)
                        TFC_LAST_FM_SENSOR.Value = New KineticaRT.Values.Double(TFC_FILE_FUEL_KG)

                        'Compare the expiration date from the file and from the database
                        'If the date are different reset the total for the period
                        If TFC_FILE_EXP_DATE <> TFC_DB_PermitExpirationDate Then
                            TFC_FILE_PERIOD_CO = 0.0
                            TFC_FILE_PERIOD_HC = 0.0
                            TFC_FILE_PERIOD_NOX = 0.0
                            TFC_FILE_EXP_DATE = TFC_DB_PermitExpirationDate

                            TFC_SendFileToSQLServer()
                        End If

                        'transfer the value to the channel for display (bargraph)
                        TFC_TOT_CO_PERIOD.Value = New KineticaRT.Values.Double(TFC_FILE_PERIOD_CO)
                        TFC_TOT_HC_PERIOD.Value = New KineticaRT.Values.Double(TFC_FILE_PERIOD_HC)
                        TFC_TOT_NOX_PERIOD.Value = New KineticaRT.Values.Double(TFC_FILE_PERIOD_NOX)
                        TFC_LAST_FM_SENSOR.Value = New KineticaRT.Values.Double(TFC_FILE_FUEL_KG)


                        RecordSet.Close()
                    End If

                    DatabaseHelper.CloseConnection(Connection)
                End If

            Catch Ex As Exception
                MessageBox.Show(Me.GetType().ToString() + " " + Ex.ToString())
            End Try

        End Sub

        Private Sub TFC_SendFileToSQLServer()

            'transfer the value to the channel for display
            TFC_DISPLAY_LAST_FUEL_KG.Value = New KineticaRT.Values.Double(TFC_FILE_FUEL_KG)
            TFC_DISPLAY_LAST_FUEL_GALLONS.Value = New KineticaRT.Values.Double(TFC_FILE_FUEL_GALLONS)
            TFC_DISPLAY_LAST_PERIOD_NOX.Value = New KineticaRT.Values.Double(TFC_FILE_PERIOD_NOX)
            TFC_DISPLAY_LAST_PERIOD_CO.Value = New KineticaRT.Values.Double(TFC_FILE_PERIOD_CO)
            TFC_DISPLAY_LAST_PERIOD_HC.Value = New KineticaRT.Values.Double(TFC_FILE_PERIOD_HC)
            TFC_DISPLAY_LAST_TOT_NOX.Value = New KineticaRT.Values.Double(TFC_FILE_TOT_NOX)
            TFC_DISPLAY_LAST_TOT_CO.Value = New KineticaRT.Values.Double(TFC_FILE_TOT_CO)
            TFC_DISPLAY_LAST_TOT_HC.Value = New KineticaRT.Values.Double(TFC_FILE_TOT_HC)
            TFC_DISPLAY_LAST_EXP_DATE.Value = New KineticaRT.Values.Text(TFC_FILE_EXP_DATE.ToString)

            'Creating the content of the file
            Dim FileContent As String
            Dim NowDate As Date = Now

            FileContent = "Date = " + NowDate.ToString("MM/dd/yyyy") + vbCrLf
            FileContent += "Time = " + NowDate.ToString("HH:mm:ss") + vbCrLf
            FileContent += "Total Fuel Consumed from sensor in kg = " + TFC_FILE_FUEL_KG.ToString() + vbCrLf
            FileContent += "Total Fuel Consumed from sensor in gallons = " + TFC_FILE_FUEL_GALLONS.ToString() + vbCrLf
            FileContent += "Total Nox emissions for the period in kg = " + TFC_FILE_PERIOD_NOX.ToString() + vbCrLf
            FileContent += "Total CO emissions for the period in kg = " + TFC_FILE_PERIOD_CO.ToString() + vbCrLf
            FileContent += "Total HC emissions for the period in kg = " + TFC_FILE_PERIOD_HC.ToString() + vbCrLf
            FileContent += "Total Nox emissions in kg = " + TFC_FILE_TOT_NOX.ToString() + vbCrLf
            FileContent += "Total CO emissions in kg = " + TFC_FILE_TOT_CO.ToString() + vbCrLf
            FileContent += "Total HC emissions in kg = " + TFC_FILE_TOT_HC.ToString() + vbCrLf
            FileContent += "Expiration Date = " + TFC_FILE_EXP_DATE.ToString("MM/dd/yyyy") + vbCrLf

            'Transfer the data to the internal file
            Try
                File.WriteAllText(TFC_LastMassFileName, FileContent)
            Catch ex As Exception
                MessageBox.Show(Me.GetType().ToString() + " " + ex.ToString())
            End Try

            'Generate the file name and copy the file to the send folder
            Dim FileNameDestination As String = TFC_DB_HS_TC_Fuel_Name + NowDate.ToString("_yyyy_MM_dd_HH_mm_ss") + ".txt"
            Dim SendPath As String = "C:\CELDAS DATA\Emissions\"

            Try
                If Not My.Computer.FileSystem.DirectoryExists(SendPath) Then
                    My.Computer.FileSystem.CreateDirectory(SendPath)
                End If

                File.Copy(TFC_LastMassFileName, SendPath + FileNameDestination)
            Catch ex As Exception
                MessageBox.Show(Me.GetType().ToString() + " " + ex.ToString())
            End Try

        End Sub

        Private Sub TFC_Log_Error(ByVal TextMessage As String)
            Dim LogFileName As String = "Fuel_Emission.Log"
            Dim LogPath As String = "C:\My Projects\KineticaRT\Prj" + PROJECT_NUMBER + "_HMI\Fuel Emission\"

            Try
                If Not My.Computer.FileSystem.DirectoryExists(LogPath) Then
                    My.Computer.FileSystem.CreateDirectory(LogPath)
                End If

                If Not My.Computer.FileSystem.FileExists(LogPath + LogFileName) Then
                    My.Computer.FileSystem.WriteAllText(LogPath + LogFileName, "Log File for the Fuel Emission" + vbCrLf, False)
                End If

                Dim ErrorMessage As String = Now.ToString() + " : " + TextMessage + vbCrLf

                My.Computer.FileSystem.WriteAllText(LogPath + LogFileName, ErrorMessage, True)

            Catch ex As Exception
                MessageBox.Show(Me.GetType().ToString() + " " + ex.ToString())
            End Try


        End Sub

