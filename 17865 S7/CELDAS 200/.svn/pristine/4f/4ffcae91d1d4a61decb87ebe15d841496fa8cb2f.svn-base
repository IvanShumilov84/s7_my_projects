                        excelWorksheet.Cells(36, 7).Value = LOG_PERF_BLEED_PRESSURE_DP_MODE_LO_LIMIT.Value.ToString(LOG_PERF_BLEED_PRESSURE_DP_MODE_LO_LIMIT.Format, Nothing) + " PSIA Min"
                        excelWorksheet.Cells(36, 9).Value = LOG_PERF_BLEED_PRESSURE_DP_MODE.Value.ToString(LOG_PERF_BLEED_PRESSURE_DP_MODE.Format, Nothing)
                        excelWorksheet.Cells(37, 9).Value = LOG_PERF_LC_PHYSICAL_SURGE_POINT.Value.ToString(LOG_PERF_LC_PHYSICAL_SURGE_POINT.Format, Nothing)
                        excelWorksheet.Cells(38, 9).Value = LOG_PERF_MID_BEARING_VENT_TUBE.Value.ToString(LOG_PERF_MID_BEARING_VENT_TUBE.Format, Nothing)
                        excelWorksheet.Cells(39, 9).Value = LOG_PERF_LOAD_COMPRESSOR_TUBE.Value.ToString(LOG_PERF_LOAD_COMPRESSOR_TUBE.Format, Nothing)
                        excelWorksheet.Cells(40, 9).Value = LOG_PERF_LOAD_COMPRESSOR_MID_BEARING_VENT_TUBE.Value.ToString(LOG_PERF_LOAD_COMPRESSOR_MID_BEARING_VENT_TUBE.Format, Nothing)
                        excelWorksheet.Cells(41, 9).Value = IIf(LOG_PERF_BUFFER_PRES_AND_ALT_SIM_CHECK.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(42, 9).Value = LOG_PERF_GEARBOX_PRESSURE_CHECK_200.Value.ToString(LOG_PERF_GEARBOX_PRESSURE_CHECK_200.Format, Nothing)
                        excelWorksheet.Cells(43, 9).Value = LOG_PERF_EXHAUST_GAS_TEMPERATURE_SPREAD.Value.ToString(LOG_PERF_EXHAUST_GAS_TEMPERATURE_SPREAD.Format, Nothing)
                        excelWorksheet.Cells(44, 9).Value = LOG_PERF_APU_FAULT_DURING_TEST.Value.ToString(LOG_PERF_APU_FAULT_DURING_TEST.Format, Nothing)
                        excelWorksheet.Cells(45, 9).Value = NUMBER_OF_STARTS.Value.ToString(NUMBER_OF_STARTS.Format, Nothing)

                        excelWorksheet = excelSheets.Item("ACCEPTANCE")

                        'Test Result
                        excelWorksheet.CheckBoxes("chkTestResultAccepted ").value = CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value)
                        excelWorksheet.CheckBoxes("chkTestResultRejected ").value = CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value)

                End Select

                TestProgress_RecordPerfStep(TestStepNumber)
                TestProgress_Save()

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("Create11825PerformanceFile200: " + ex.Message)
                MessageBox.Show(ex.ToString)
                Create11825PerformanceFile200 = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)

            End Try
        End Function

        Private Function CreatePerformanceFile250(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreatePerformanceFile250 = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            Try
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    excelWorksheet = excelSheets.Item("SUMMARY")
                    'HEADER

                    'Serial Number
                    excelWorksheet.Cells(5, 3).NumberFormat = "@"
                    excelWorksheet.Cells(5, 3).Value = UserInputs.EngineSerialNumber

                    'Word Order
                    excelWorksheet.Cells(6, 3).NumberFormat = "@"
                    excelWorksheet.Cells(6, 3).Value = UserInputs.WorkOrder

                    'ECB Serial Number
                    excelWorksheet.Cells(7, 3).NumberFormat = "@"
                    excelWorksheet.Cells(7, 3).Value = UserInputs.ECBSerialNumber

                    'Exhaust Duct Serial Number
                    excelWorksheet.Cells(8, 3).NumberFormat = "@"
                    excelWorksheet.Cells(8, 3).Value = UserInputs.ExhaustDuctSerialNumber

                    'Bellmouth Serial Number
                    excelWorksheet.Cells(9, 3).NumberFormat = "@"
                    excelWorksheet.Cells(9, 3).Value = UserInputs.BellmouthSerialNumber

                    'Bleed Duct Serial Number
                    excelWorksheet.Cells(10, 3).NumberFormat = "@"
                    excelWorksheet.Cells(10, 3).Value = UserInputs.BleedDuctSerialNumber

                    'Starter Serial Number
                    excelWorksheet.Cells(11, 3).NumberFormat = "@"
                    excelWorksheet.Cells(11, 3).Value = UserInputs.StarterSerialNumber

                    'Engine Vibration Pickup Serial Number
                    excelWorksheet.Cells(12, 3).NumberFormat = "@"
                    excelWorksheet.Cells(12, 3).Value = UserInputs.EngineVibrationPickupSerialNumber

                    'Gearbox Vibration Pickup Serial Number
                    excelWorksheet.Cells(13, 3).NumberFormat = "@"
                    excelWorksheet.Cells(13, 3).Value = UserInputs.GearboxVibrationPickupSerialNumber

                    'Cooling Fan Vibration Pickup Serial Number
                    excelWorksheet.Cells(5, 8).NumberFormat = "@"
                    excelWorksheet.Cells(5, 8).Value = UserInputs.CoolingFanVibrationPickupSerialNumber

                    'Oil Type
                    excelWorksheet.Cells(6, 8).NumberFormat = "@"
                    excelWorksheet.Cells(6, 8).Value = UserInputs.OilType

                    'TSN
                    excelWorksheet.Cells(7, 8).NumberFormat = "@"
                    excelWorksheet.Cells(7, 8).Value = UserInputs.TSN

                    'CSN
                    excelWorksheet.Cells(8, 8).NumberFormat = "@"
                    excelWorksheet.Cells(8, 8).Value = UserInputs.CSN

                    'Reason
                    excelWorksheet.Cells(9, 8).NumberFormat = "@"
                    excelWorksheet.Cells(9, 8).Value = UserInputs.Reason

                    'Test Type
                    excelWorksheet.Cells(10, 8).NumberFormat = "@"
                    excelWorksheet.Cells(10, 8).Value = UserInputs.TestType

                    'Repair Type
                    excelWorksheet.Cells(11, 8).NumberFormat = "@"
                    excelWorksheet.Cells(11, 8).Value = UserInputs.RepairType

                    'Date
                    excelWorksheet.Cells(12, 8).NumberFormat = "@"
                    excelWorksheet.Cells(12, 8).Value = Format(Now, "d MMMM yyyy")

                    excelWorksheet = excelSheets.Item("ACCEPTANCE")

                    'Document Number
                    excelWorksheet.Cells(43, 4).NumberFormat = "@"
                    excelWorksheet.Cells(43, 4).Value = Custom_Parameters("APUTestedAccordingTo").ToString()

                End If

                Select Case TestStepNumber

                    Case eTestStepGTCP331_200.NO_LOAD

                        excelWorksheet = excelSheets.Item("DETAILS")

                        excelWorksheet.Cells(17, 7).Value = LOG_PERF_P_BARO_PSIA.Value.ToString(LOG_PERF_P_BARO_PSIA.Format, Nothing)
                        excelWorksheet.Cells(18, 7).Value = LOG_PERF_T_INLET_AVG_DEGF.Value.ToString(LOG_PERF_T_INLET_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(19, 7).Value = LOG_PERF_P_OIL_PSIG.Value.ToString(LOG_PERF_P_OIL_PSIG.Format, Nothing)
                        excelWorksheet.Cells(20, 7).Value = LOG_PERF_T_OIL_DEGF.Value.ToString(LOG_PERF_T_OIL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(21, 7).Value = LOG_PERF_T_EGT_P1_DEGF.Value.ToString(LOG_PERF_T_EGT_P1_DEGF.Format, Nothing)
                        excelWorksheet.Cells(22, 7).Value = LOG_PERF_T_EGT_P2_DEGF.Value.ToString(LOG_PERF_T_EGT_P2_DEGF.Format, Nothing)
                        excelWorksheet.Cells(23, 7).Value = LOG_PERF_T_EGT_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_AVG_DEGF.Format, Nothing)
                        'N/A de 24 a 31 inclusivement
                        excelWorksheet.Cells(32, 7).Value = LOG_PERF_P_GEARBOX_INH20G.Value.ToString(LOG_PERF_P_GEARBOX_INH20G.Format, Nothing)
                        '33 est la required value pour la pression de la gearbox
                        excelWorksheet.Cells(34, 7).Value = LOG_PERF_VIB_GEARBOX_IPS.Value.ToString(LOG_PERF_VIB_GEARBOX_IPS.Format, Nothing)
                        '35 est la required value pour la vibration de la gearbox
                        excelWorksheet.Cells(36, 7).Value = LOG_PERF_VIB_TURBINE_IPS.Value.ToString(LOG_PERF_VIB_TURBINE_IPS.Format, Nothing)
                        '37 est la required value pour la vibration de la turbine
                        excelWorksheet.Cells(38, 7).Value = LOG_PERF_VIB_COOLING_FAN_IPS.Value.ToString(LOG_PERF_VIB_COOLING_FAN_IPS.Format, Nothing)
                        excelWorksheet.Cells(39, 7).Value = VIB_COOLING_FAN_NOLOAD_MAX_IPS.Value.ToString(VIB_COOLING_FAN_NOLOAD_MAX_IPS.Format, Nothing)
                        '40 est la required value pour la vibration de la cooling fan
                        excelWorksheet.Cells(41, 7).Value = LOG_PERF_N1_RPM.Value.ToString(LOG_PERF_N1_RPM.Format, Nothing)
                        'excelWorksheet.Cells(42, 7).Value = LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing)
                        '43 est la required value pour la vitesse du moteur
                        excelWorksheet.Cells(44, 7).Value = LOG_PERF_TQ_MOTOR_CURRENT.Value.ToString(LOG_PERF_TQ_MOTOR_CURRENT.Format, Nothing)
                        excelWorksheet.Cells(45, 7).Value = LOG_PERF_T_FUEL_DEGF.Value.ToString(LOG_PERF_T_FUEL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(46, 7).Value = LOG_PERF_P_FUEL_PSIG.Value.ToString(LOG_PERF_P_FUEL_PSIG.Format, Nothing)
                        excelWorksheet.Cells(47, 7).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)

                    Case eTestStepGTCP331_200.ECS

                        excelWorksheet = excelSheets.Item("DETAILS")

                        'N/A de 17 a 33 inclusivement
                        excelWorksheet.Cells(34, 8).Value = LOG_PERF_VIB_GEARBOX_IPS.Value.ToString(LOG_PERF_VIB_GEARBOX_IPS.Format, Nothing)
                        '35 est la required value pour la vibration de la gearbox
                        excelWorksheet.Cells(36, 8).Value = LOG_PERF_VIB_TURBINE_IPS.Value.ToString(LOG_PERF_VIB_TURBINE_IPS.Format, Nothing)
                        '37 est la required value pour la vibration de la turbine
                        excelWorksheet.Cells(38, 8).Value = LOG_PERF_VIB_COOLING_FAN_IPS.Value.ToString(LOG_PERF_VIB_COOLING_FAN_IPS.Format, Nothing)
                        excelWorksheet.Cells(39, 8).Value = VIB_COOLING_FAN_ECS_MAX_IPS.Value.ToString(VIB_COOLING_FAN_ECS_MAX_IPS.Format, Nothing)
                        '40 est la required value pour la vibration de la cooling fan
                        excelWorksheet.Cells(41, 8).Value = LOG_PERF_N1_RPM.Value.ToString(LOG_PERF_N1_RPM.Format, Nothing)
                        'excelWorksheet.Cells(42, 8).Value = LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing)
                        '43 est la required value pour la vitesse du moteur
                        excelWorksheet.Cells(44, 8).Value = LOG_PERF_TQ_MOTOR_CURRENT.Value.ToString(LOG_PERF_TQ_MOTOR_CURRENT.Format, Nothing)
                        excelWorksheet.Cells(45, 8).Value = LOG_PERF_T_FUEL_DEGF.Value.ToString(LOG_PERF_T_FUEL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(46, 8).Value = LOG_PERF_P_FUEL_PSIG.Value.ToString(LOG_PERF_P_FUEL_PSIG.Format, Nothing)
                        excelWorksheet.Cells(47, 8).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)

                    Case eTestStepGTCP331_200.MES

                        excelWorksheet = excelSheets.Item("SUMMARY")

                        excelWorksheet.Cells(19, 9).Value = LOG_PERF_PB_COR_MIN_PSIA.Value.ToString(LOG_PERF_PB_COR_MIN_PSIA.Format, Nothing)
                        excelWorksheet.Cells(19, 10).Value = LOG_PERF_PB_COR_PSIA.Value.ToString(LOG_PERF_PB_COR_PSIA.Format, Nothing)
                        excelWorksheet.Cells(20, 9).Value = LOG_PERF_WB_COR_MIN_PPM.Value.ToString(LOG_PERF_WB_COR_MIN_PPM.Format, Nothing)
                        excelWorksheet.Cells(20, 10).Value = LOG_PERF_WB_COR_PPM.Value.ToString(LOG_PERF_WB_COR_PPM.Format, Nothing)
                        excelWorksheet.Cells(21, 9).Value = LOG_PERF_T_EGT_COR_MAX_DEGF.Value.ToString(LOG_PERF_T_EGT_COR_MAX_DEGF.Format, Nothing)
                        excelWorksheet.Cells(21, 10).Value = LOG_PERF_T_EGT_COR_DEGF.Value.ToString(LOG_PERF_T_EGT_COR_DEGF.Format, Nothing)

                        excelWorksheet = excelSheets.Item("DETAILS")

                        excelWorksheet.Cells(17, 9).Value = LOG_PERF_P_BARO_PSIA.Value.ToString(LOG_PERF_P_BARO_PSIA.Format, Nothing)
                        excelWorksheet.Cells(18, 9).Value = LOG_PERF_T_INLET_AVG_DEGF.Value.ToString(LOG_PERF_T_INLET_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(19, 9).Value = LOG_PERF_P_OIL_PSIG.Value.ToString(LOG_PERF_P_OIL_PSIG.Format, Nothing)
                        excelWorksheet.Cells(20, 9).Value = LOG_PERF_T_OIL_DEGF.Value.ToString(LOG_PERF_T_OIL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(21, 9).Value = LOG_PERF_T_EGT_P1_DEGF.Value.ToString(LOG_PERF_T_EGT_P1_DEGF.Format, Nothing)
                        excelWorksheet.Cells(22, 9).Value = LOG_PERF_T_EGT_P2_DEGF.Value.ToString(LOG_PERF_T_EGT_P2_DEGF.Format, Nothing)
                        excelWorksheet.Cells(23, 9).Value = LOG_PERF_T_EGT_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(24, 9).Value = LOG_PERF_P_ORIFICE_PSIA.Value.ToString(LOG_PERF_P_ORIFICE_PSIA.Format, Nothing)
                        excelWorksheet.Cells(25, 9).Value = LOG_PERF_T_ORIFICE_DEGF.Value.ToString(LOG_PERF_T_ORIFICE_DEGF.Format, Nothing)
                        excelWorksheet.Cells(26, 9).Value = LOG_PERF_P_ORIFICE_DELTA_INH20D.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_INH20D.Format, Nothing)
                        excelWorksheet.Cells(27, 9).Value = LOG_PERF_WB_CALC_PPM.Value.ToString(LOG_PERF_WB_CALC_PPM.Format, Nothing)
                        excelWorksheet.Cells(28, 9).Value = LOG_PERF_P_BLEED_PSIA.Value.ToString(LOG_PERF_P_BLEED_PSIA.Format, Nothing)
                        excelWorksheet.Cells(29, 9).Value = LOG_PERF_T_BLEED_AVG_DEGF.Value.ToString(LOG_PERF_T_BLEED_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(30, 9).Value = LOG_PERF_DCF_PPM.Value.ToString(LOG_PERF_DCF_PPM.Format, Nothing)
                        '31 est la required value du DCF
                        '32 est la gearbox pressure qui est N/A
                        '33 est la gearbox pressure required qui est N/A
                        excelWorksheet.Cells(34, 9).Value = LOG_PERF_VIB_GEARBOX_IPS.Value.ToString(LOG_PERF_VIB_GEARBOX_IPS.Format, Nothing)
                        '35 est la required value pour la vibration de la gearbox
                        excelWorksheet.Cells(36, 9).Value = LOG_PERF_VIB_TURBINE_IPS.Value.ToString(LOG_PERF_VIB_TURBINE_IPS.Format, Nothing)
                        '37 est la required value pour la vibration de la turbine
                        excelWorksheet.Cells(38, 9).Value = LOG_PERF_VIB_COOLING_FAN_IPS.Value.ToString(LOG_PERF_VIB_COOLING_FAN_IPS.Format, Nothing)
                        excelWorksheet.Cells(39, 9).Value = VIB_COOLING_FAN_MES_MAX_IPS.Value.ToString(VIB_COOLING_FAN_MES_MAX_IPS.Format, Nothing)
                        '40 est la required value pour la vibration de la cooling fan
                        excelWorksheet.Cells(41, 9).Value = LOG_PERF_N1_RPM.Value.ToString(LOG_PERF_N1_RPM.Format, Nothing)
                        'excelWorksheet.Cells(42, 9).Value = LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing)
                        '43 est la required value pour la vitesse du moteur
                        excelWorksheet.Cells(44, 9).Value = LOG_PERF_TQ_MOTOR_CURRENT.Value.ToString(LOG_PERF_TQ_MOTOR_CURRENT.Format, Nothing)
                        excelWorksheet.Cells(45, 9).Value = LOG_PERF_T_FUEL_DEGF.Value.ToString(LOG_PERF_T_FUEL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(46, 9).Value = LOG_PERF_P_FUEL_PSIG.Value.ToString(LOG_PERF_P_FUEL_PSIG.Format, Nothing)
                        excelWorksheet.Cells(47, 9).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)

                    Case eTestStepGTCP331_200.FINAL_DATA

                        excelWorksheet = excelSheets.Item("SUMMARY")

                        excelWorksheet.Cells(27, 9).Value = IIf(LOG_PERF_PRELIMINARY_PROCEDURE_INSTRUCTIONS.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(28, 9).Value = IIf(LOG_PERF_RUN_IN.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(29, 9).Value = IIf(LOG_PERF_SURGE_SYSTEM_CHECK.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(30, 9).Value = IIf(LOG_PERF_TC_FAULT_CHECK.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(31, 9).Value = IIf(LOG_PERF_LOSS_OF_SPEED_PROTECTING_DEMO.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(32, 9).Value = IIf(LOG_PERF_LOP_CHECK.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(33, 9).Value = IIf(LOG_PERF_HOT_CHECK.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(34, 9).Value = IIf(LOG_PERF_REVERSE_FLOW_CHECK.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(35, 9).Value = IIf(LOG_PERF_INLET_DOOR_CHECK.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(36, 9).Value = IIf(LOG_PERF_STATIC_OVERSPEED_CHECK.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(37, 9).Value = IIf(LOG_PERF_GENERATOR_HOT_CHECK.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(38, 9).Value = IIf(LOG_PERF_OPTIONAL_FLOW_SENSOR_CALIBRATION.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(39, 9).Value = IIf(LOG_PERF_GEARBOX_PRESSURE_CHECK_250.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(40, 9).Value = IIf(LOG_PERF_LOAD_COMPRESSOR_SURGE_MARGIN_CHECK.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(41, 9).Value = IIf(LOG_PERF_EGT_SPREAD_CHECK.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(42, 9).Value = IIf(LOG_PERF_OIL_LEVEL_CHECK.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(43, 9).Value = IIf(LOG_PERF_FINAL_ON_TG_CHECKS.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(44, 9).Value = IIf(LOG_PERF_FILTER_CHECKS.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(45, 9).Value = IIf(LOG_PERF_CHIP_DETECTOR_CHECK.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(46, 9).Value = IIf(LOG_PERF_LEAK_CHECK.Value.Equals(Values.True), "OK", "NO")
                        excelWorksheet.Cells(47, 9).Value = LOG_PERF_APU_FAULT_DURING_TEST.Value.ToString(LOG_PERF_APU_FAULT_DURING_TEST.Format, Nothing)
                        excelWorksheet.Cells(48, 9).Value = LOG_PERF_STARTING_TIME_SEC.Value.ToString(LOG_PERF_STARTING_TIME_SEC.Format, Nothing)
                        excelWorksheet.Cells(49, 9).Value = LOG_PERF_LIGHT_OFF_TIME_SEC.Value.ToString(LOG_PERF_LIGHT_OFF_TIME_SEC.Format, Nothing)
                        excelWorksheet.Cells(50, 9).Value = LOG_PERF_RUNDOWN_TIME_SEC.Value.ToString(LOG_PERF_RUNDOWN_TIME_SEC.Format, Nothing)
                        excelWorksheet.Cells(51, 9).Value = LOG_PERF_T_EGT_P1_MAX_START_DEGF.Value.ToString(LOG_PERF_T_EGT_P1_MAX_START_DEGF.Format, Nothing)
                        excelWorksheet.Cells(52, 9).Value = LOG_PERF_T_EGT_P2_MAX_START_DEGF.Value.ToString(LOG_PERF_T_EGT_P2_MAX_START_DEGF.Format, Nothing)
                        excelWorksheet.Cells(53, 9).Value = LOG_PERF_P_OIL_AT_50_PCT_SPEED_PSIG.Value.ToString(LOG_PERF_P_OIL_AT_50_PCT_SPEED_PSIG.Format, Nothing)
                        excelWorksheet.Cells(54, 9).Value = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format, Nothing)
                        excelWorksheet.Cells(55, 9).Value = NUMBER_OF_STARTS.Value.ToString(NUMBER_OF_STARTS.Format, Nothing)
                        excelWorksheet.Cells(56, 9).Value = LOG_PERF_FUEL_USED_TOTAL_LITERS.Value.ToString(LOG_PERF_FUEL_USED_TOTAL_LITERS.Format, Nothing)

                        excelWorksheet = excelSheets.Item("ACCEPTANCE")

                        'Test Result
                        If CELProject.IsTrue(PERF_TEST_RESULT_ACCEPTED.Value) Then
                            excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                        Else
                            excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                        End If

                        If CELProject.IsTrue(PERF_TEST_RESULT_REJECTED.Value) Then
                            excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                        Else
                            excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                        End If

                End Select

                TestProgress_RecordPerfStep(TestStepNumber)

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile250: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreatePerformanceFile250 = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)

            End Try
        End Function

        Protected Overrides Sub Init_Engine_Channels_Value()

            If Not (CELProject.PERF_TEST_STEP_NB Is Nothing) Then
                CELProject.PERF_TEST_STEP_NB.Value = Values.Zero
            End If

        End Sub

        Private Sub Init_Arrays()

            Dim SelectString As String
            Dim RepairType As String
            Dim rs As ADODB.Recordset = Nothing

            Try

                If CELProject.EngineModel = "GTCP331-200" Then

                    'Read Table GTCP331-200
                    'be careful to Repair Category for that table
                    Select Case CELProject.Project.Number
                        Case 11825
                            If UserInputEthiopie.ChoiceRepairType = "Light" Or UserInputEthiopie.ChoiceRepairType = "Medium" Then
                                RepairType = "Light/Medium"
                            Else
                                RepairType = "Heavy"
                            End If
                            SelectString = "SELECT GTCP331_200_ACER.* FROM Repair_Category INNER JOIN GTCP331_200_ACER ON Repair_Category.ID = GTCP331_200_ACER.Repair_Category WHERE Repair_Category.Description = '" & RepairType & "' ORDER BY [TT1_DegF]"
                        Case Else
                            SelectString = "SELECT GTCP331_200_ACER.* FROM Repair_Category INNER JOIN GTCP331_200_ACER ON Repair_Category.ID = GTCP331_200_ACER.Repair_Category WHERE Repair_Category.Description = '" & UserInputs.RepairType & "' ORDER BY [TT1_DegF]"
                    End Select

                ElseIf CELProject.EngineModel = "GTCP331-250" Then

                    'Read Table GTCP331-250H
                    'be careful to Repair Category for that table
                    SelectString = "SELECT GTCP331_250.* FROM Repair_Category INNER JOIN GTCP331_250 ON Repair_Category.ID = GTCP331_250.Repair_Category WHERE Repair_Category.Description = '" & UserInputs.RepairType & "' ORDER BY [TT1_DegF]"

                Else

                    SelectString = ""

                End If

                If DatabaseHelper.OpenRecordset(rs, SelectString, cnMain, True) Then
                    ReDim GTCP331_200(DatabaseHelper.RecordCount(rs) - 1, 3)
                    For i As Integer = 0 To GTCP331_200.GetLength(0) - 1
                        GTCP331_200(i, 0) = rs.Fields("TT1_DegF").Value
                        GTCP331_200(i, 1) = rs.Fields("WB_COR_MIN").Value
                        GTCP331_200(i, 2) = rs.Fields("PB_COR_MIN").Value
                        GTCP331_200(i, 3) = rs.Fields("EGT_COR_MAX_DegF").Value
                        rs.MoveNext()
                    Next i
                    DatabaseHelper.CloseRecordset(rs)
                End If

            Catch Ex As Exception
                MessageBox.Show("InitArrays: " & Ex.ToString())
            Finally
            End Try
        End Sub

        Protected Overrides Sub Init_Engine_Controls()

            Try
                SetTestStepList(0)
            Catch ex As Exception
                MessageBox.Show("Init_Engine_Controls: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try

        End Sub

        'Use Delegate for Cross Thread Operation
        Private Delegate Sub SetTestStepListDelegate(ByVal value As Integer)
        Protected Overrides Sub SetTestStepList(ByVal value As Integer)

            If (Me.cmbTestStepList.InvokeRequired) Then
                Me.cmbTestStepList.BeginInvoke(New SetTestStepListDelegate(AddressOf Me.SetTestStepList), value)
            Else
                cmbTestStepList.Items.Clear()
                cmbTestStepList.Items.Add("NO LOAD      2.C Step 13c")
                cmbTestStepList.Items.Add("ECS              2.C Step 16c.5")
                cmbTestStepList.Items.Add("MES              2.C Step 13j")
                cmbTestStepList.Items.Add("FINAL DATA")
                cmbTestStepList.SelectedIndex = value
            End If
        End Sub


        Protected Overrides Sub OnEngineWorkingThread()

            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                'WB_CALC_PPM Update
                Compute(False)

                'Make sure FM_INITIAL_VOLUME_LITERS is different than 0
                ValidateFMInitialValue()

                'Timers Update
                LightOffTimerCtrl.Timer()
                RundownTimerCtrl.Timer()
                StartTimerCtrl.Timer()

                'Persistent Values Save Check
                PersistentValuesCtrl.SavePersistentValues(False)

            End If

        End Sub

        Private Function Compute_BleedAirFlow(ByVal TOrifice_DEGF As Double, _
                                              ByVal POrifice_PSIA As Double, _
                                              ByVal POrificeDelta_PSID As Double) As Double
            Try

                If CELProject.IsTrue(BLEED_BTN.Value) Then

                    Dim BleedAirFLow As Double = CELProject.GetBleedAirFlow( _
                                                                            EngineConfiguration.DuctDiameter, _
                                                                            EngineConfiguration.DuctDiameterUnit, _
                                                                            EngineConfiguration.OrificeDiameter, _
                                                                            EngineConfiguration.OrificeDiameterUnit, _
                                                                            TOrifice_DEGF, _
                                                                            CELDAS.eTemperature.Fahrenheit, _
                                                                            POrifice_PSIA, _
                                                                            CELDAS.ePressure.PSI, _
                                                                            POrificeDelta_PSID, _
                                                                            CELDAS.ePressure.PSI, _
                                                                            EngineConfiguration.OrificeThinkness, _
                                                                            EngineConfiguration.OrificeThinknessUnit, _
                                                                            EngineConfiguration.TapArrangement, _
                                                                            CELDAS.eFlowMass.LbByMin)

                    Return BleedAirFLow

                Else
                    Return 0.0
                End If

            Catch Ex As Exception
                'Log error
                MessageBox.Show("Error in Engine_Sequence.Compute_BleedAirFlow: " & Ex.ToString)
				Return 0.0
            End Try

        End Function

        Protected Overrides Sub OnCLOSE_TEST_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then
                    If CELProject.IsTrue(newVal) Then

                        MyBase.StopWorkingThread()

                        'Persistent Values Force Save
                        PersistentValuesCtrl.SavePersistentValues(True)

                        RemoveHandlers()

                        Dispose_Engine_Controllers()

                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("OnClose_Test: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

