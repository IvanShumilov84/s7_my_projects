                If CELProject.IsTrue(newVal) Then

                    If CELProject.EngineModel = "GTCP331-200" Then
                        CELProject.ActivateForm("GTCP331_200_Performance_Screen", "GTCP331_200_Screen", True, False)
                    ElseIf CELProject.EngineModel = "GTCP331-250" Then
                        CELProject.ActivateForm("GTCP331_250_Performance_Screen", "GTCP331_200_Screen", True, False)
                    End If

                    CELProject.PERF_OPEN_WINDOW_BTN.Value = Values.False

