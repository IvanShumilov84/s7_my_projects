        Private Sub OnLOG_PERF_CAPTURE(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then
                    If CELProject.IsTrue(newVal) Then

                        If sender.Name = "CAPTURE_LOAD_COMPRESSOR_SURGE_POINT" Then
                            LOG_PERF_LOAD_COMPRESSOR_SURGE_POINT.Value = DCF_PPM_MEAN.Value
                        End If
                        If sender.Name = "CAPTURE_FLOW_SENSOR_ADJUSTMENT" Then
                            LOG_PERF_FLOW_SENSOR_ADJUSTMENT.Value = DCF_PPM_MEAN.Value
                        End If
                        If sender.Name = "CAPTURE_GEARBOX_PRESSURE_CHECK" Then
                            LOG_PERF_GEARBOX_PRESSURE_CHECK_200.Value = P_GEARBOX_INH20G_MEAN.Value
                        End If
                        If sender.Name = "CAPTURE_SCV_CRACK_POINT_DP_MODE" Then
                            LOG_PERF_SCV_CRACK_POINT_DP_MODE.Value = DCF_PPM_MEAN.Value
                        End If
                        If sender.Name = "CAPTURE_SCV_CRACK_POINT_MES" Then
                            LOG_PERF_SCV_CRACK_POINT_MES.Value = DCF_PPM_MEAN.Value
                        End If
                        If sender.Name = "CAPTURE_MID_BEARING" Then
                            LOG_PERF_MID_BEARING_VENT_TUBE.Value = P_MID_BEARING.Value
                        End If
                        If sender.Name = "CAPTURE_LOAD_COMPRESSOR" Then
                            LOG_PERF_LOAD_COMPRESSOR_TUBE.Value = P_LOAD_COMPRESSOR.Value
                        End If
                        If sender.Name = "CAPTURE_LOAD_COMPRESSOR_MID_BEARING" Then
                            LOG_PERF_LOAD_COMPRESSOR_MID_BEARING_VENT_TUBE.Value = P_LOAD_COMPRESSOR_MID_BEARING.Value
                        End If
                        If sender.Name = "CAPTURE_BLEED_PRESSURE_DP_MODE" Then
                            LOG_PERF_BLEED_PRESSURE_DP_MODE.Value = P_DP_PB_PSIA_MEAN.Value
                        End If
                        If sender.Name = "CAPTURE_LC_PHYSICAL_SURGE_POINT" Then
                            LOG_PERF_LC_PHYSICAL_SURGE_POINT.Value = DCF_PPM_MEAN.Value
                        End If
                        If sender.Name = "CAPTURE_EXHAUST_GAS_TEMPERATURE_SPREAD" Then
                            LOG_PERF_EXHAUST_GAS_TEMPERATURE_SPREAD.Value = T_EGT_P_SPREAD_MAX_DEGF_MEAN.Value
                        End If

                        If sender.Name = "CAPTURE_TQ_MOTOR_CURRENT_MES" Then
                            LOG_PERF_SCV_STABILITY_CHECK_MES.Value = TQ_MOTOR_CURRENT_DEVIATION_MAX.Value
                        End If

                        If sender.Name = "CAPTURE_TQ_MOTOR_CURRENT_9V_ECS" Then
                            LOG_PERF_SCV_STABILITY_CHECK_9V_ECS.Value = TQ_MOTOR_CURRENT_DEVIATION_MAX.Value
                        End If

                        If sender.Name = "CAPTURE_TQ_MOTOR_CURRENT_2V_ECS" Then
                            LOG_PERF_SCV_STABILITY_CHECK_2V_ECS.Value = TQ_MOTOR_CURRENT_DEVIATION_MAX.Value
                        End If

                        If sender.Name = "CAPTURE_TQ_MOTOR_CURRENT_DP" Then
                            LOG_PERF_SCV_STABILITY_CHECK_DP_MODE.Value = TQ_MOTOR_CURRENT_DEVIATION_MAX.Value
                        End If

                    End If
                End If

            Catch ex As System.Exception
                MessageBox.Show("OnLOG_PERF_CAPTURE: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try

        End Sub

