                        'Test Result
                        excelWorksheet.CheckBoxes("chkTestResultAccepted ").value = CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value)
                        excelWorksheet.CheckBoxes("chkTestResultRejected ").value = CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value)

                End Select

                TestProgress_RecordPerfStep(TestStepNumber)

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile200: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreatePerformanceFile200 = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)

            End Try
        End Function

        Private Function Create11825PerformanceFile200(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            Create11825PerformanceFile200 = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            Try
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    excelWorksheet = excelSheets.Item("SUMMARY")
                    'HEADER

                    'Serial Number
                    excelWorksheet.Cells(5, 3).NumberFormat = "@"
                    excelWorksheet.Cells(5, 3).Value = UserInputEthiopie.EngineSerialNumber

                    'Word Order
                    excelWorksheet.Cells(6, 3).NumberFormat = "@"
                    excelWorksheet.Cells(6, 3).Value = UserInputEthiopie.WorkOrder

                    'ECB Serial Number
                    excelWorksheet.Cells(7, 3).NumberFormat = "@"
                    excelWorksheet.Cells(7, 3).Value = UserInputEthiopie.ECBSerialNumber

                    'Engine Vibration Pickup Serial Number
                    excelWorksheet.Cells(8, 3).NumberFormat = "@"
                    excelWorksheet.Cells(8, 3).Value = UserInputEthiopie.EngineVibrationPickupSerialNumber

                    'Gearbox Vibration Pickup Serial Number
                    excelWorksheet.Cells(9, 3).NumberFormat = "@"
                    excelWorksheet.Cells(9, 3).Value = UserInputEthiopie.GearboxVibrationPickupSerialNumber

                    'Cooling Fan Vibration Pickup Serial Number
                    excelWorksheet.Cells(10, 3).NumberFormat = "@"
                    excelWorksheet.Cells(10, 3).Value = UserInputEthiopie.CoolingFanVibrationPickupSerialNumber

                    'Fuel SG
                    excelWorksheet.Cells(11, 3).NumberFormat = "@"
                    excelWorksheet.Cells(11, 3).Value = UserInputEthiopie.FuelSG

                    'T Fuel
                    excelWorksheet.Cells(5, 8).NumberFormat = "@"
                    excelWorksheet.Cells(5, 8).Value = UserInputEthiopie.TFuelDegF

                    'Fuel Type
                    excelWorksheet.Cells(6, 8).NumberFormat = "@"
                    excelWorksheet.Cells(6, 8).Value = UserInputEthiopie.FuelType

                    'Oil Type
                    excelWorksheet.Cells(7, 8).NumberFormat = "@"
                    excelWorksheet.Cells(7, 8).Value = UserInputEthiopie.OilType

                    'LHV
                    excelWorksheet.Cells(8, 8).NumberFormat = "@"
                    excelWorksheet.Cells(8, 8).Value = UserInputEthiopie.LHV

                    'Test Type
                    excelWorksheet.Cells(9, 8).NumberFormat = "@"
                    excelWorksheet.Cells(9, 8).Value = UserInputEthiopie.ChoiceTestType

                    'Repair Type
                    excelWorksheet.Cells(10, 8).NumberFormat = "@"
                    excelWorksheet.Cells(10, 8).Value = UserInputEthiopie.ChoiceRepairType

                    'Date
                    excelWorksheet.Cells(11, 8).NumberFormat = "@"
                    excelWorksheet.Cells(11, 8).Value = Format(Now, "d MMMM yyyy")

                    excelWorksheet = excelSheets.Item("ACCEPTANCE")

                    'Document Number
                    excelWorksheet.Cells(43, 4).NumberFormat = "@"
                    excelWorksheet.Cells(43, 4).Value = Custom_Parameters("APUTestedAccordingTo").ToString()

                End If

                Select Case TestStepNumber

                    Case eTestStepGTCP331_200.NO_LOAD

                        excelWorksheet = excelSheets.Item("DETAILS")

                        excelWorksheet.Cells(17, 7).Value = LOG_PERF_P_BARO_PSIA.Value.ToString(LOG_PERF_P_BARO_PSIA.Format, Nothing)
                        excelWorksheet.Cells(18, 7).Value = LOG_PERF_T_INLET_AVG_DEGF.Value.ToString(LOG_PERF_T_INLET_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(19, 7).Value = LOG_PERF_P_OIL_PSIG.Value.ToString(LOG_PERF_P_OIL_PSIG.Format, Nothing)
