            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                If CELProject.IsTrue(newVal) Then

                    If CELProject.EngineModel = "GTCP331-200" Then
                        CELProject.ActivateForm("GTCP331_200_Performance_Screen", "GTCP331_200_Screen", False, False)
                    ElseIf CELProject.EngineModel = "GTCP331-250" Then
                        CELProject.ActivateForm("GTCP331_250_Performance_Screen", "GTCP331_200_Screen", False, False)
                    End If

                    CELProject.PERF_CLOSE_WINDOW_BTN.Value = Values.False

