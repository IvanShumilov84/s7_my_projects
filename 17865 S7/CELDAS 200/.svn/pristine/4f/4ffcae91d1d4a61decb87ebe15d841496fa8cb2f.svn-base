                AddHandler CAPTURE_LOAD_COMPRESSOR.ValueChanged, AddressOf OnLOG_PERF_CAPTURE
                AddHandler CAPTURE_LOAD_COMPRESSOR_MID_BEARING.ValueChanged, AddressOf OnLOG_PERF_CAPTURE
                AddHandler CAPTURE_TQ_MOTOR_CURRENT.ValueChanged, AddressOf OnTQ_Motor_Current_Capture
                AddHandler CAPTURE_TQ_MOTOR_CURRENT_MES.ValueChanged, AddressOf OnLOG_PERF_CAPTURE
                AddHandler CAPTURE_TQ_MOTOR_CURRENT_9V_ECS.ValueChanged, AddressOf OnLOG_PERF_CAPTURE
                AddHandler CAPTURE_TQ_MOTOR_CURRENT_2V_ECS.ValueChanged, AddressOf OnLOG_PERF_CAPTURE
                AddHandler CAPTURE_TQ_MOTOR_CURRENT_DP.ValueChanged, AddressOf OnLOG_PERF_CAPTURE
                AddHandler POST_SB_7711.ValueChanged, AddressOf OnPostSB7711CheckBox
                AddHandler PRE_SB_7711.ValueChanged, AddressOf OnPreSB7711CheckBox
                AddHandler STOP_START_BTN.ValueChanged, AddressOf OnENGINE_START
                AddHandler STOP_START_BTN.ValueChanged, AddressOf OnP_OIL_AT_50PCT_SPEED

            ElseIf CELProject.EngineModel = "GTCP331-250" Then
                AddHandler START_BTN.ValueChanged, AddressOf OnENGINE_START
                AddHandler START_BTN.ValueChanged, AddressOf OnP_OIL_AT_50PCT_SPEED
            End If

            AddHandler cmbTestStepList.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged
        End Sub
