        Private Sub ValidateFMInitialValue()

            Try

                Select Case CELProject.Project.Number

                    Case 11825
                        FM_INITIAL_VOLUME_LITERS.Value = Values.Zero

                    Case Else
                        Debug.Assert(False, "ValidateFMInitialValue: Code Missign for this project")

                End Select

            Catch Ex As Exception
                MessageBox.Show("ValidateFMInitialValue: " & Ex.ToString())
            End Try

        End Sub

        Protected Overrides Function CreateCustomHeaderLogFile(ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Try

                Select Case CELProject.Project.Number
                    '* FOR Ethiopia project, customer required a dedicated space to sign the log report. 

                    Case 11825
                        ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Operator Signature:"
                        ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                        ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                        RowIndex += 1
                        ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Inspector Signature:"
                        ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                        ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                        RowIndex += 2

                End Select

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Date Time:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Cond#:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Comment:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                ExcelWorksheet.Rows(RowIndex).RowHeight = 65.25
                ExcelWorksheet.Rows(RowIndex).VerticalAlignment = Excel.XlVAlign.xlVAlignTop
                ExcelWorksheet.Rows(RowIndex).WrapText = True

                Return True

            Catch ex As Exception
                MessageBox.Show("CreateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
				Return False
            End Try
        End Function

        Protected Overrides Function UpdateCustomHeaderLogFile(ByVal AppendOption As Boolean, ByVal IsPerfEntry As Boolean, ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Try

                Select Case CELProject.Project.Number

                    Case 11825  '* FOR Ethiopia project, customer required a dedicated space to sign the log report. It is an offset requiring 3 spaces. 
                        RowIndex = RowIndex + 3
                End Select

                Dim Log_Condition As Integer

                If AppendOption = False Then
                    Log_Condition = 1
                Else
                    Log_Condition = ExcelWorksheet.Cells(RowIndex + 1, ExcelWorksheet.Columns.Count).End(Excel.XlDirection.xlToLeft).Column - 1
                    Log_Condition = Log_Condition + 1

                End If

                If ((Log_Condition > 1) And ((Log_Condition Mod 5) = 1)) Then

                    'Repeat The Test Spec For this new sets of condition

                    With ExcelWorksheet
                        .Range(.Cells(2, 2), .Cells(RowIndex - 2, 6)).Copy(.Cells(2, Log_Condition + 1))
                    End With
                End If

                ColumnIndex = 1 + Log_Condition

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Format(Now, "yyyy/MM/dd HH:mm:ss")
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Log_Condition.ToString()
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                If IsPerfEntry = False Then
                    Dim CommentText As String = ""
                    Dim InputObject As New InputCommentForm
                    InputObject.ShowDialog("Log Report", "Comment:", "", CommentText)

                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = CommentText
                Else
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "STEP: " & cmbTestStepList.SelectedItem
                End If

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 2
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Values"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignCenter

            Catch ex As Exception
                MessageBox.Show("UpdateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
				Return False
            End Try
			Return True
        End Function

        Private Function CreatePerformanceFile200(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreatePerformanceFile200 = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            Try
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    excelWorksheet = excelSheets.Item("SUMMARY")
                    'HEADER

                    'Serial Number
                    excelWorksheet.Cells(5, 3).NumberFormat = "@"
                    excelWorksheet.Cells(5, 3).Value = UserInputs.EngineSerialNumber

                    'Word Order
                    excelWorksheet.Cells(6, 3).NumberFormat = "@"
                    excelWorksheet.Cells(6, 3).Value = UserInputs.WorkOrder

                    'ECB Serial Number
                    excelWorksheet.Cells(7, 3).NumberFormat = "@"
                    excelWorksheet.Cells(7, 3).Value = UserInputs.ECBSerialNumber

                    'Exhaust Duct Serial Number
                    excelWorksheet.Cells(8, 3).NumberFormat = "@"
                    excelWorksheet.Cells(8, 3).Value = UserInputs.ExhaustDuctSerialNumber

                    'Bellmouth Serial Number
                    excelWorksheet.Cells(9, 3).NumberFormat = "@"
                    excelWorksheet.Cells(9, 3).Value = UserInputs.BellmouthSerialNumber

                    'Bleed Duct Serial Number
                    excelWorksheet.Cells(10, 3).NumberFormat = "@"
                    excelWorksheet.Cells(10, 3).Value = UserInputs.BleedDuctSerialNumber

                    'Starter Serial Number
                    excelWorksheet.Cells(11, 3).NumberFormat = "@"
                    excelWorksheet.Cells(11, 3).Value = UserInputs.StarterSerialNumber

                    'Engine Vibration Pickup Serial Number
                    excelWorksheet.Cells(12, 3).NumberFormat = "@"
                    excelWorksheet.Cells(12, 3).Value = UserInputs.EngineVibrationPickupSerialNumber

                    'Gearbox Vibration Pickup Serial Number
                    excelWorksheet.Cells(13, 3).NumberFormat = "@"
                    excelWorksheet.Cells(13, 3).Value = UserInputs.GearboxVibrationPickupSerialNumber

                    'Cooling Fan Vibration Pickup Serial Number
                    excelWorksheet.Cells(5, 8).NumberFormat = "@"
                    excelWorksheet.Cells(5, 8).Value = UserInputs.CoolingFanVibrationPickupSerialNumber

                    'Oil Type
                    excelWorksheet.Cells(6, 8).NumberFormat = "@"
                    excelWorksheet.Cells(6, 8).Value = UserInputs.OilType

                    'TSN
                    excelWorksheet.Cells(7, 8).NumberFormat = "@"
                    excelWorksheet.Cells(7, 8).Value = UserInputs.TSN

                    'CSN
                    excelWorksheet.Cells(8, 8).NumberFormat = "@"
                    excelWorksheet.Cells(8, 8).Value = UserInputs.CSN

                    'Reason
                    excelWorksheet.Cells(9, 8).NumberFormat = "@"
                    excelWorksheet.Cells(9, 8).Value = UserInputs.Reason

                    'Test Type
                    excelWorksheet.Cells(10, 8).NumberFormat = "@"
                    excelWorksheet.Cells(10, 8).Value = UserInputs.TestType

                    'Repair Type
                    excelWorksheet.Cells(11, 8).NumberFormat = "@"
                    excelWorksheet.Cells(11, 8).Value = UserInputs.RepairType

                    'Date
                    excelWorksheet.Cells(12, 8).NumberFormat = "@"
                    excelWorksheet.Cells(12, 8).Value = Format(Now, "d MMMM yyyy")

                    excelWorksheet = excelSheets.Item("ACCEPTANCE")

                    'Document Number
                    excelWorksheet.Cells(43, 4).NumberFormat = "@"
                    excelWorksheet.Cells(43, 4).Value = Custom_Parameters("APUTestedAccordingTo").ToString()

                End If

                Select Case TestStepNumber

                    Case eTestStepGTCP331_200.NO_LOAD

                        excelWorksheet = excelSheets.Item("DETAILS")

                        excelWorksheet.Cells(17, 7).Value = LOG_PERF_P_BARO_PSIA.Value.ToString(LOG_PERF_P_BARO_PSIA.Format, Nothing)
                        excelWorksheet.Cells(18, 7).Value = LOG_PERF_T_INLET_AVG_DEGF.Value.ToString(LOG_PERF_T_INLET_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(19, 7).Value = LOG_PERF_P_OIL_PSIG.Value.ToString(LOG_PERF_P_OIL_PSIG.Format, Nothing)
                        excelWorksheet.Cells(20, 7).Value = LOG_PERF_T_OIL_DEGF.Value.ToString(LOG_PERF_T_OIL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(21, 7).Value = LOG_PERF_T_EGT_P1_DEGF.Value.ToString(LOG_PERF_T_EGT_P1_DEGF.Format, Nothing)
                        excelWorksheet.Cells(22, 7).Value = LOG_PERF_T_EGT_P2_DEGF.Value.ToString(LOG_PERF_T_EGT_P2_DEGF.Format, Nothing)
                        excelWorksheet.Cells(23, 7).Value = LOG_PERF_T_EGT_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_AVG_DEGF.Format, Nothing)
                        'N/A de 24 a 31 inclusivement
                        excelWorksheet.Cells(32, 7).Value = LOG_PERF_P_GEARBOX_INH20G.Value.ToString(LOG_PERF_P_GEARBOX_INH20G.Format, Nothing)
                        '33 est la required value pour la pression de la gearbox
                        excelWorksheet.Cells(34, 7).Value = LOG_PERF_VIB_GEARBOX_IPS.Value.ToString(LOG_PERF_VIB_GEARBOX_IPS.Format, Nothing)
                        '35 est la required value pour la vibration de la gearbox
                        excelWorksheet.Cells(36, 7).Value = LOG_PERF_VIB_TURBINE_IPS.Value.ToString(LOG_PERF_VIB_TURBINE_IPS.Format, Nothing)
                        '37 est la required value pour la vibration de la turbine
                        excelWorksheet.Cells(38, 7).Value = LOG_PERF_VIB_COOLING_FAN_IPS.Value.ToString(LOG_PERF_VIB_COOLING_FAN_IPS.Format, Nothing)
                        excelWorksheet.Cells(39, 7).Value = VIB_COOLING_FAN_NOLOAD_MAX_IPS.Value.ToString(VIB_COOLING_FAN_NOLOAD_MAX_IPS.Format, Nothing)
                        '40 est la required value pour la vibration de la cooling fan
                        excelWorksheet.Cells(41, 7).Value = LOG_PERF_N1_RPM.Value.ToString(LOG_PERF_N1_RPM.Format, Nothing)
                        'excelWorksheet.Cells(42, 7).Value = LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing)
                        '43 est la required value pour la vitesse du moteur
                        excelWorksheet.Cells(44, 7).Value = LOG_PERF_TQ_MOTOR_CURRENT.Value.ToString(LOG_PERF_TQ_MOTOR_CURRENT.Format, Nothing)
                        excelWorksheet.Cells(45, 7).Value = LOG_PERF_T_FUEL_DEGF.Value.ToString(LOG_PERF_T_FUEL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(46, 7).Value = LOG_PERF_P_FUEL_PSIG.Value.ToString(LOG_PERF_P_FUEL_PSIG.Format, Nothing)
                        excelWorksheet.Cells(47, 7).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)

                    Case eTestStepGTCP331_200.ECS

                        excelWorksheet = excelSheets.Item("DETAILS")

                        'N/A de 17 a 33 inclusivement
                        excelWorksheet.Cells(34, 8).Value = LOG_PERF_VIB_GEARBOX_IPS.Value.ToString(LOG_PERF_VIB_GEARBOX_IPS.Format, Nothing)
                        '35 est la required value pour la vibration de la gearbox
                        excelWorksheet.Cells(36, 8).Value = LOG_PERF_VIB_TURBINE_IPS.Value.ToString(LOG_PERF_VIB_TURBINE_IPS.Format, Nothing)
                        '37 est la required value pour la vibration de la turbine
                        excelWorksheet.Cells(38, 8).Value = LOG_PERF_VIB_COOLING_FAN_IPS.Value.ToString(LOG_PERF_VIB_COOLING_FAN_IPS.Format, Nothing)
                        excelWorksheet.Cells(39, 8).Value = VIB_COOLING_FAN_ECS_MAX_IPS.Value.ToString(VIB_COOLING_FAN_ECS_MAX_IPS.Format, Nothing)
                        '40 est la required value pour la vibration de la cooling fan
                        excelWorksheet.Cells(41, 8).Value = LOG_PERF_N1_RPM.Value.ToString(LOG_PERF_N1_RPM.Format, Nothing)
                        'excelWorksheet.Cells(42, 8).Value = LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing)
                        '43 est la required value pour la vitesse du moteur
                        excelWorksheet.Cells(44, 8).Value = LOG_PERF_TQ_MOTOR_CURRENT.Value.ToString(LOG_PERF_TQ_MOTOR_CURRENT.Format, Nothing)
                        excelWorksheet.Cells(45, 8).Value = LOG_PERF_T_FUEL_DEGF.Value.ToString(LOG_PERF_T_FUEL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(46, 8).Value = LOG_PERF_P_FUEL_PSIG.Value.ToString(LOG_PERF_P_FUEL_PSIG.Format, Nothing)
                        excelWorksheet.Cells(47, 8).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)

                    Case eTestStepGTCP331_200.MES

                        excelWorksheet = excelSheets.Item("SUMMARY")

