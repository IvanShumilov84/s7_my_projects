    Public Class GTCP331_200_Sequence
        Inherits ApuSequence



        'Les constantes isont lu a partir du fichier celdas_12917.cfg
        Private NumberOfTInletProbe As Integer = 0  '2 Probes
        Private NumberOfTEgtProbe As Integer = 0 ' 4
        Private NumberOfTBleedProbe As Integer = 0 '1

        Private Const MaxNumberOfTBleedProbe As Integer = 8
        Private Const MaxNumberOfTEgtProbe As Integer = 8
        Private Const MaxNumberOfTInletProbe As Integer = 16

        Private Enum eTestStepGTCP331_200
            NO_LOAD = 0
            ECS = 1
            MES = 2
            FINAL_DATA = 3
        End Enum

        Protected Overrides Sub Compute(ByVal CalulateForLogAndPerformanceReports As Boolean)

            Try
                If CalulateForLogAndPerformanceReports Then

                    LOG_PERF_WB_CALC_PPM.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(LOG_PERF_T_ORIFICE_DEGF.Value.ToDouble(), _
                                                                                               LOG_PERF_P_ORIFICE_PSIA.Value.ToDouble(), _
                                                                                              LOG_PERF_P_ORIFICE_DELTA_PSID.Value.ToDouble))

                    Compute_GTCP331_200_Perf(LOG_PERF_T_INLET_AVG_DEGF, _
                                             LOG_PERF_WB_COR_MIN_PPM, _
                                             LOG_PERF_PB_COR_MIN_PSIA, _
                                             LOG_PERF_T_EGT_COR_MAX_DEGF)

                    FlowmeterCtrl.ComputeFlow(True)

                    'IMPORTANT: Toutes les variables flottantes telles que WB_CALC_PPM dont la source et la destination sont vides doivent
                    'manuellement être updaté pour être inscrite dans le LOG ou le PERF report.
                Else

                    WB_CALC_PPM.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(T_ORIFICE_DEGF.Value.ToDouble(), _
                                                                                      P_ORIFICE_PSIA.Value.ToDouble(), _
                                                                                      P_ORIFICE_DELTA_PSID.Value.ToDouble))

                    Compute_GTCP331_200_Perf(T_INLET_AVG_DEGF, _
                                             WB_COR_MIN_PPM, _
                                             PB_COR_MIN_PSIA, _
                                             T_EGT_COR_MAX_DEGF)

                End If

            Catch ex As Exception
                MessageBox.Show("Compute_GTCP331_200" + ex.ToString(), "Error")
            End Try

        End Sub

        Private Sub Compute_GTCP331_200_Perf(ByRef T_INLET_DEGF_AVG As IChannel, _
                                             ByRef WB_COR_MIN_PPM As IChannel, _
                                             ByRef PB_COR_MIN_PSIA As IChannel, _
                                             ByRef T_EGT_COR_MAX_DEGF As IChannel)
            Try
                Select Case CELProject.PERF_TEST_STEP_NB.Value.ToDouble()

                    Case eTestStepGTCP331_200.NO_LOAD, eTestStepGTCP331_200.ECS
                        WB_COR_MIN_PPM.Value = Values.NaN
                        PB_COR_MIN_PSIA.Value = Values.NaN
                        T_EGT_COR_MAX_DEGF.Value = Values.NaN

                    Case eTestStepGTCP331_200.MES

                        WB_COR_MIN_PPM.Value = CELProject.Interpolate_1D(T_INLET_AVG_DEGF.Value.ToDouble, GTCP331_200, 1)
                        PB_COR_MIN_PSIA.Value = CELProject.Interpolate_1D(T_INLET_AVG_DEGF.Value.ToDouble, GTCP331_200, 2)
                        T_EGT_COR_MAX_DEGF.Value = CELProject.Interpolate_1D(T_INLET_AVG_DEGF.Value.ToDouble, GTCP331_200, 3)

                End Select

            Catch Ex As Exception
                MessageBox.Show("Compute_GTCP331_200_Perf: " & Ex.Message)
            Finally
            End Try

        End Sub

