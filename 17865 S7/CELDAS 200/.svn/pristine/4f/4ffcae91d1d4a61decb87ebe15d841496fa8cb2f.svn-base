                        LOG_PERF_ENGINE_RUN_IN.Value = Values.False
                        LOG_PERF_EXHAUST_GAS_TEMPERATURE_SPREAD.Value = Values.Zero
                        LOG_PERF_GEARBOX_PRESSURE_CHECK_200.Value = Values.Zero
                        LOG_PERF_FLOW_SENSOR_ADJUSTMENT.Value = Values.Zero
                        LOG_PERF_LC_PHYSICAL_SURGE_POINT.Value = Values.Zero
                        LOG_PERF_LOAD_COMPRESSOR_MID_BEARING_VENT_TUBE.Value = Values.Zero
                        LOG_PERF_LOAD_COMPRESSOR_SURGE_POINT.Value = Values.Zero
                        LOG_PERF_LOAD_COMPRESSOR_TUBE.Value = Values.Zero
                        LOG_PERF_MID_BEARING_VENT_TUBE.Value = Values.Zero
                        LOG_PERF_SCV_CRACK_POINT_MES.Value = Values.Zero
                        LOG_PERF_SCV_CRACK_POINT_DP_MODE.Value = Values.Zero
                        LOG_PERF_SCV_STABILITY_CHECK_MES.Value = Values.Zero
                        LOG_PERF_SCV_STABILITY_CHECK_9V_ECS.Value = Values.Zero
                        LOG_PERF_SCV_STABILITY_CHECK_2V_ECS.Value = Values.Zero
                        LOG_PERF_SCV_STABILITY_CHECK_DP_MODE.Value = Values.Zero

                    ElseIf CELProject.EngineModel = "GTCP331-250" Then

                        NUMBER_OF_STARTS.Value = Values.Zero
                        OPERATING_TIME_CURRENT_SEC.Value = Values.Zero
                        FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                        WF_TOT1.Value = Values.Zero
                        WF_TOT2.Value = Values.Zero
                        LOG_PERF_APU_FAULT_DURING_TEST.Value = Values.Zero
                        LOG_PERF_CHIP_DETECTOR_CHECK.Value = Values.False
                        LOG_PERF_EGT_SPREAD_CHECK.Value = Values.False
                        LOG_PERF_FILTER_CHECKS.Value = Values.False
                        LOG_PERF_FINAL_ON_TG_CHECKS.Value = Values.False
                        LOG_PERF_GEARBOX_PRESSURE_CHECK_250.Value = Values.False
                        LOG_PERF_GENERATOR_HOT_CHECK.Value = Values.False
                        LOG_PERF_HOT_CHECK.Value = Values.False
                        LOG_PERF_INLET_DOOR_CHECK.Value = Values.False
                        LOG_PERF_LEAK_CHECK.Value = Values.False
                        LOG_PERF_LOP_CHECK.Value = Values.False
                        LOG_PERF_LOSS_OF_SPEED_PROTECTING_DEMO.Value = Values.False
                        LOG_PERF_LOAD_COMPRESSOR_SURGE_MARGIN_CHECK.Value = Values.False
                        LOG_PERF_OIL_LEVEL_CHECK.Value = Values.False
                        LOG_PERF_OPTIONAL_FLOW_SENSOR_CALIBRATION.Value = Values.False
                        LOG_PERF_PRELIMINARY_PROCEDURE_INSTRUCTIONS.Value = Values.False
                        LOG_PERF_REVERSE_FLOW_CHECK.Value = Values.False
                        LOG_PERF_RUN_IN.Value = Values.False
                        LOG_PERF_STATIC_OVERSPEED_CHECK.Value = Values.False
                        LOG_PERF_SURGE_SYSTEM_CHECK.Value = Values.False
                        LOG_PERF_TC_FAULT_CHECK.Value = Values.False

                    End If

                    TestProgress_Save()

                    Try
                        If (System.IO.File.Exists(CELProject.EngineSession.LogFolder + "TestProgress.xml")) Then

                            Rename(CELProject.EngineSession.LogFolder + "TestProgress.xml", CELProject.EngineSession.LogFolder + "TestProgress_" & Format(Date.Now, "yyyy-MM-dd hh'h'mm'm'ss's'") & ".xml")
                        End If

                        TestProgressMgr.TestProgressSheet.Entries.Clear()

                    Catch Ex As Exception
                        MessageBox.Show("TestProgess File not found: " & Ex.ToString())
                    End Try

                End If

            End If
        End Sub

