        Protected Overrides Sub Init_Engine_Controllers()

            Dim PersistentValuesChannels() As String

            If CELProject.EngineModel = "GTCP331-200" Then

                PersistentValuesChannels = {"NUMBER_OF_STARTS", "OPERATING_TIME_CURRENT_SEC", "FUEL_USED_INITIAL_LITERS", "FUEL_USED_TOTAL_LITERS", _
                                            "LOG_PERF_APU_FAULT_DURING_TEST", "LOG_PERF_BLEED_PRESSURE_DP_MODE", "LOG_PERF_BUFFER_PRES_AND_ALT_SIM_CHECK", _
                                            "LOG_PERF_ENGINE_RUN_IN", "LOG_PERF_EXHAUST_GAS_TEMPERATURE_SPREAD", "LOG_PERF_GEARBOX_PRESSURE_CHECK_200", _
                                            "LOG_PERF_FLOW_SENSOR_ADJUSTMENT", "LOG_PERF_LC_PHYSICAL_SURGE_POINT", "LOG_PERF_LOAD_COMPRESSOR_SURGE_POINT", _
                                            "LOG_PERF_SCV_CRACK_POINT_MES", "LOG_PERF_SCV_CRACK_POINT_DP_MODE", "LOG_PERF_SCV_STABILITY_CHECK_9V_ECS", _
                                            "LOG_PERF_SCV_STABILITY_CHECK_2V_ECS", "LOG_PERF_SCV_STABILITY_CHECK_DP_MODE", "LOG_PERF_SCV_STABILITY_CHECK_MES", _
                                            "LOG_PERF_LOAD_COMPRESSOR_MID_BEARING_VENT_TUBE", "LOG_PERF_LOAD_COMPRESSOR_TUBE", "LOG_PERF_MID_BEARING_VENT_TUBE"}

            ElseIf CELProject.EngineModel = "GTCP331-250" Then

                PersistentValuesChannels = {"NUMBER_OF_STARTS", "OPERATING_TIME_CURRENT_SEC", "FUEL_USED_INITIAL_LITERS", "FUEL_USED_TOTAL_LITERS", _
                                            "LOG_PERF_APU_FAULT_DURING_TEST", "LOG_PERF_CHIP_DETECTOR_CHECK", "LOG_PERF_EGT_SPREAD_CHECK", "LOG_PERF_FILTER_CHECKS", _
                                            "LOG_PERF_FINAL_ON_TG_CHECKS", "LOG_PERF_GEARBOX_PRESSURE_CHECK_250", "LOG_PERF_GENERATOR_HOT_CHECK", "LOG_PERF_HOT_CHECK", _
                                            "LOG_PERF_INLET_DOOR_CHECK", "LOG_PERF_LEAK_CHECK", "LOG_PERF_LOP_CHECK", "LOG_PERF_LOSS_OF_SPEED_PROTECTING_DEMO", _
                                            "LOG_PERF_LOAD_COMPRESSOR_SURGE_MARGIN_CHECK", "LOG_PERF_OIL_LEVEL_CHECK", "LOG_PERF_OPTIONAL_FLOW_SENSOR_CALIBRATION", _
                                            "LOG_PERF_PRELIMINARY_PROCEDURE_INSTRUCTIONS", "LOG_PERF_REVERSE_FLOW_CHECK", "LOG_PERF_RUN_IN", _
                                             "LOG_PERF_STATIC_OVERSPEED_CHECK", "LOG_PERF_SURGE_SYSTEM_CHECK", "LOG_PERF_TC_FAULT_CHECK"}

            Else

                PersistentValuesChannels = {""}

            End If

            Dim PersistentValuesFileName As String

            Select Case CELProject.Project.Number

                Case 11825
                    PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputEthiopie.EngineSerialNumber & "\" & UserInputEthiopie.WorkOrder & "\Log\PersistentValues.xml"

                Case Else
                    PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputs.EngineSerialNumber & "\" & UserInputs.WorkOrder & "\Log\PersistentValues.xml"
                    Debug.Assert(False, "Common_Sequence.OnTestSessionRunning: Code Missign for this project")

            End Select


            PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

            If Double.IsNaN(FUEL_USED_TOTAL_LITERS.Value.ToDouble()) Then
                FUEL_USED_INITIAL_LITERS.Value = Values.Zero
            Else
                FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())
            End If

            NumberOfTInletProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/GTCP331-200/T_INLET_NUMBER_PROBE", 0)
            NumberOfTEgtProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/GTCP331-200/T_EGT_NUMBER_PROBE", 0)
            NumberOfTBleedProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/GTCP331-200/T_BLEED_NUMBER_PROBE", 0)

            DeletableTEgtChCtrl = New DeletableChannelController(Me, NumberOfTEgtProbe, MaxNumberOfTEgtProbe, MaxNumberOfTEgtProbe, "T_EGT", "_DEGF", "_DELETE_BTN", "T_EGT_AVG_DEGF", "T_EGT_MIN_DEGF", "T_EGT_MAX_DEGF", "T_EGT_SPREAD_DEGF")
            DeletableTInletChCtrl = New DeletableChannelController(Me, NumberOfTInletProbe, MaxNumberOfTInletProbe, MaxNumberOfTInletProbe, "T_INLET", "_DEGF", "_DELETE_BTN", "T_INLET_AVG_DEGF", "T_INLET_MIN_DEGF", "T_INLET_MAX_DEGF", "T_INLET_SPREAD_DEGF")
            DeletableTBleedChCtrl = New DeletableChannelController(Me, NumberOfTBleedProbe, MaxNumberOfTBleedProbe, MaxNumberOfTBleedProbe, "T_BLEED", "_DEGF", "_DELETE_BTN", "T_BLEED_AVG_DEGF", "T_BLEED_MIN_DEGF", "T_BLEED_MAX_DEGF", "T_BLEED_SPREAD_DEGF")

            FlowmeterCtrl = New FlowmeterController(Me)

            If CELProject.EngineModel = "GTCP331-200" Then

                CoolingFanMaxVibrationNoLoadRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_COOLING_FAN_NOLOAD_IPS", "VIB_COOLING_FAN_NOLOAD_MAX_IPS", "STOP_START_BTN")
                CoolingFanMaxVibrationECSRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_COOLING_FAN_ECS_IPS", "VIB_COOLING_FAN_ECS_MAX_IPS", "STOP_START_BTN")
                CoolingFanMaxVibrationMESRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_COOLING_FAN_MES_IPS", "VIB_COOLING_FAN_MES_MAX_IPS", "STOP_START_BTN")
                StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_CURRENT_AMP", "STARTER_CURRENT_MAX_AMP", "STOP_START_BTN", "READY_TO_LOAD_IND")
                StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_VOLTAGE_VDC", "STARTER_VOLTAGE_MAX_VDC", "STOP_START_BTN", "READY_TO_LOAD_IND")
                TEGT1MaxTemperatureRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_EGT_P1_DEGF", "T_EGT_P1_MAX_START_DEGF", "STOP_START_BTN", "READY_TO_LOAD_IND")
                TEGT2MaxTemperatureRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_EGT_P2_DEGF", "T_EGT_P2_MAX_START_DEGF", "STOP_START_BTN", "READY_TO_LOAD_IND")
                TEGTPSpreadMaxTemperatureRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_EGT_P_SPREAD_DEGF", "T_EGT_P_SPREAD_MAX_DEGF", "STOP_START_BTN", "READY_TO_LOAD_IND_INVERTED")
                TQMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "TQ_MOTOR_CURRENT", "TQ_MOTOR_CURRENT_MAX", "STOP_START_BTN")
                TQMaxCurrentDeviationCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "TQ_MOTOR_CURRENT_DEVIATION", "TQ_MOTOR_CURRENT_DEVIATION_MAX", "CAPTURE_TQ_MOTOR_CURRENT")


            ElseIf CELProject.EngineModel = "GTCP331-250" Then

                CoolingFanMaxVibrationNoLoadRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_COOLING_FAN_NOLOAD_IPS", "VIB_COOLING_FAN_NOLOAD_MAX_IPS", "START_BTN")
                CoolingFanMaxVibrationECSRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_COOLING_FAN_ECS_IPS", "VIB_COOLING_FAN_ECS_MAX_IPS", "START_BTN")
                CoolingFanMaxVibrationMESRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_COOLING_FAN_MES_IPS", "VIB_COOLING_FAN_MES_MAX_IPS", "START_BTN")
                StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_CURRENT_AMP", "STARTER_CURRENT_MAX_AMP", "START_BTN", "READY_TO_LOAD_IND")
                StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_VOLTAGE_VDC", "STARTER_VOLTAGE_MAX_VDC", "START_BTN", "READY_TO_LOAD_IND")
                TEGT1MaxTemperatureRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_EGT_P1_DEGF", "T_EGT_P1_MAX_START_DEGF", "START_BTN", "READY_TO_LOAD_IND")
                TEGT2MaxTemperatureRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_EGT_P2_DEGF", "T_EGT_P2_MAX_START_DEGF", "START_BTN", "READY_TO_LOAD_IND")
                TEGTPSpreadMaxTemperatureRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_EGT_P_SPREAD_DEGF", "T_EGT_P_SPREAD_MAX_DEGF", "START_BTN")
                TQMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "TQ_MOTOR_CURRENT", "TQ_MOTOR_CURRENT_MAX", "START_BTN")

            End If

            'Configuring ECS Control
            ECSCtrl = New ECSController(Me, 2, 9, 2, "ECS_BTN", "ECS_DEMAND", "ECS_UP_DEMAND_BTN", "ECS_DOWN_DEMAND_BTN", ECS_Display)
            ECSCtrl.Memorize = False
            ECSCtrl.Enable = False

            LightOffTimerCtrl = New TimerController(Me, "LIGHT_OFF_TIME_START_CONDITION_LATCH", "LIGHT_OFF_TIME_STOP_CONDITION_LATCH", "LIGHT_OFF_TIME_CONDITION_RESET", "LIGHT_OFF_TIME_SEC", Nothing, 0, "NONE")
            RundownTimerCtrl = New TimerController(Me, "RUNDOWN_TIME_START_CONDITION_LATCH", "RUNDOWN_TIME_STOP_CONDITION_LATCH", "RUNDOWN_TIME_CONDITION_RESET", "RUNDOWN_TIME_SEC", Nothing, 0, "NONE")
            StartTimerCtrl = New TimerController(Me, "STARTING_TIME_START_CONDITION_LATCH", "STARTING_TIME_STOP_CONDITION_LATCH", "STARTING_TIME_CONDITION_RESET", "STARTING_TIME_SEC", Nothing, 0, "NONE")

        End Sub
        Protected Overrides Sub Dispose_Engine_Controllers()

            If Not (DeletableTEgtChCtrl Is Nothing) Then
                DeletableTEgtChCtrl.Dispose()
            End If

            If Not (DeletableTInletChCtrl Is Nothing) Then
                DeletableTInletChCtrl.Dispose()
            End If

            If Not (DeletableTBleedChCtrl Is Nothing) Then
                DeletableTBleedChCtrl.Dispose()
            End If

            If Not (CoolingFanMaxVibrationNoLoadRecordCtrl Is Nothing) Then
                CoolingFanMaxVibrationNoLoadRecordCtrl.Dispose()
            End If

            If Not (CoolingFanMaxVibrationECSRecordCtrl Is Nothing) Then
                CoolingFanMaxVibrationECSRecordCtrl.Dispose()
            End If

            If Not (CoolingFanMaxVibrationMESRecordCtrl Is Nothing) Then
                CoolingFanMaxVibrationMESRecordCtrl.Dispose()
            End If

            If Not (StarterMaxCurrentRecordCtrl Is Nothing) Then
                StarterMaxCurrentRecordCtrl.Dispose()
            End If

            If Not (StarterMaxVoltageRecordCtrl Is Nothing) Then
                StarterMaxVoltageRecordCtrl.Dispose()
            End If

            If Not (TEGT1MaxTemperatureRecordCtrl Is Nothing) Then
                TEGT1MaxTemperatureRecordCtrl.Dispose()
            End If

            If Not (TEGT2MaxTemperatureRecordCtrl Is Nothing) Then
                TEGT2MaxTemperatureRecordCtrl.Dispose()
            End If

            If Not (TEGTPSpreadMaxTemperatureRecordCtrl Is Nothing) Then
                TEGTPSpreadMaxTemperatureRecordCtrl.Dispose()
            End If

            If Not (TQMaxCurrentRecordCtrl Is Nothing) Then
                TQMaxCurrentRecordCtrl.Dispose()
            End If

            If Not (TQMaxCurrentDeviationCtrl Is Nothing) Then
                TQMaxCurrentDeviationCtrl.Dispose()
            End If

            If Not (PersistentValuesCtrl Is Nothing) Then
                PersistentValuesCtrl.Dispose()
            End If

            If Not (LightOffTimerCtrl Is Nothing) Then
                LightOffTimerCtrl.Dispose()
            End If

            If Not (RundownTimerCtrl Is Nothing) Then
                RundownTimerCtrl.Dispose()
            End If

            If Not (StartTimerCtrl Is Nothing) Then
                StartTimerCtrl.Dispose()
            End If

            If Not (FlowmeterCtrl Is Nothing) Then
                FlowmeterCtrl.Dispose()
            End If

        End Sub

        Protected Overrides Function Init_Engine_Channels() As Boolean

            Dim Return_Value As New ArrayList()

            Return_Value.Clear()

            Try

                'Channels required to start and atop the archive automatically.
                Return_Value.Add(MyBase.InitializeChannel(ARCHIVE_RECORD_BTN, "ARCHIVE_RECORD_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(ARCHIVE_STOP_BTN, "ARCHIVE_STOP_BTN"))

                'Init channels for performance
                Select Case CELProject.EngineFamily

                    Case "GTCP331-200"

                        Return_Value.Add(MyBase.InitializeObject(Master_Engine_Window, CELProject.EngineFamily.Replace("-", "_") + "_Screen"))

                        Master_Engine_Window.WindowState = FormWindowState.Normal
                        Master_Engine_Window.Left = 0
                        Master_Engine_Window.Top = 0

                        Dim hmiWindow As Object = MyBase.GetObject("GTCP331_200_Screen")

                        cmbTestStepList = CELProject.SearchControl(hmiWindow, "TestStep_List")
                        Debug.Assert(Not IsNothing(cmbTestStepList), "Control TestStep_List Is Nothing")

                        Return_Value.Add(MyBase.InitializeChannel(BLEED_BTN, "BLEED_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(DELTA_PAMB, "DELTA_PAMB"))
                        Return_Value.Add(MyBase.InitializeChannel(DCF_PPM_MEAN, "DCF_PPM_MEAN"))
                        Return_Value.Add(MyBase.InitializeChannel(ENGINE_AT_REST_IND, "ENGINE_AT_REST_IND"))
                        Return_Value.Add(MyBase.InitializeChannel(FUEL_USED_INITIAL_LITERS, "FUEL_USED_INITIAL_LITERS"))
                        Return_Value.Add(MyBase.InitializeChannel(FUEL_USED_TOTAL_LITERS, "FUEL_USED_TOTAL_LITERS"))
