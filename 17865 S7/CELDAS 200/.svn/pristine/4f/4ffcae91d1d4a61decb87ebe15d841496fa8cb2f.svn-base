                        '39 est la required value pour la pression de la gearbox
                        excelWorksheet.Cells(40, 7).Value = LOG_PERF_VIB_GEARBOX_IPS.Value.ToString(LOG_PERF_VIB_GEARBOX_IPS.Format, Nothing)
                        '41 est la required value pour la vibration de la gearbox
                        excelWorksheet.Cells(42, 7).Value = LOG_PERF_VIB_TURBINE_IPS.Value.ToString(LOG_PERF_VIB_TURBINE_IPS.Format, Nothing)
