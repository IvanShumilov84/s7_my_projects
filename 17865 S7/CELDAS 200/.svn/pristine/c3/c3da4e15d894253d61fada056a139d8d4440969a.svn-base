                        'OPC_S1A_2_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                        'OPC_S1A_3_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                        'OPC_S1A_4_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                        'OPC_THRUST_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                        'OPC_P_MOTIVE_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                        'TARE.Value = KineticaRT.Values.Values.False

                End Select


                Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()
                    Case "PW307A"
                        AddHandler EEC_SHUTDOWN.ValueChanged, AddressOf OnNormalShutdown
                        AddHandler MOPD_ENG_CHA_DELETE.ValueChanged, AddressOf OnMOPD_ENG_DELETE
                        AddHandler MOPD_ENG_CHB_DELETE.ValueChanged, AddressOf OnMOPD_ENG_DELETE
                        AddHandler MOT_CHA_DELETE.ValueChanged, AddressOf OnMOT_DELETE
                        AddHandler MOT_CHB_DELETE.ValueChanged, AddressOf OnMOT_DELETE
                    Case "PW308A ANC"
                        AddHandler EEC_IGNITION_AUTO.ValueChanged, AddressOf OnIgnition_Sw
                        AddHandler EEC_IGNITION_CONT.ValueChanged, AddressOf OnIgnition_Sw
                        AddHandler EEC_NORMAL_SDN.ValueChanged, AddressOf OnNormalShutdown
                        AddHandler EEC_STANDBY_SDN.ValueChanged, AddressOf OnStandbyShutdown
                        AddHandler EEC_POWER_ON.ValueChanged, AddressOf OnResetSpinButtons
                        AddHandler LB_ENABLE.ValueChanged, AddressOf OnLBDisable
                        For i = 0 To TT1_DELETE.GetUpperBound(0) - 1
                            AddHandler TT1_DELETE(i).ValueChanged, AddressOf OnTT1_DELETE
                        Next

                    Case "PW308C ANC"
                        'AddHandler EEC_IGNITION_AUTO.ValueChanged, AddressOf OnIgnition_Sw
                        'AddHandler EEC_IGNITION_CONT.ValueChanged, AddressOf OnIgnition_Sw
                        'AddHandler EEC_IGNITION_OFF.ValueChanged, AddressOf OnIgnition_Sw
                        'AddHandler EEC_NORMAL_SDN.ValueChanged, AddressOf OnNormalShutdown
                        'AddHandler EEC_STANDBY_SDN.ValueChanged, AddressOf OnStandbyShutdown
                        'AddHandler LB_ENABLE.ValueChanged, AddressOf OnLBDisable
                        'For i = 0 To TT1_DELETE.GetUpperBound(0) - 1
                        '    AddHandler TT1_DELETE(i).ValueChanged, AddressOf OnTT1_DELETE
                        'Next
                End Select

                Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()
                    'Not For "DAS CALIBRATION"

                    Case "PW307A", "PW308A ANC", "PW308C ANC"
                        If Not (OPERATING_TIME.Value Is Nothing) Then
                            If (OPERATING_TIME.Value.ToString() = "0") Then
                                ts = New System.TimeSpan(0)
                                OPERATING_TIME.Value = New KineticaRT.Values.Text(ts.Hours.ToString.PadLeft(2, "0") & ":" & ts.Minutes.ToString.PadLeft(2, "0") & ":" & ts.Seconds.ToString.PadLeft(2, "0"))
                            End If
                        Else
                            ts = New System.TimeSpan(0)
                            OPERATING_TIME.Value = New KineticaRT.Values.Text(ts.Hours.ToString.PadLeft(2, "0") & ":" & ts.Minutes.ToString.PadLeft(2, "0") & ":" & ts.Seconds.ToString.PadLeft(2, "0"))
                        End If


                        If Not (FUEL_USED_GM.Value Is Nothing) Then
                            If (FUEL_USED_GM.Value.ToString() = "0") Then
                                FUEL_USED_GM.Value = New KineticaRT.Values.Text("0.0")
                            End If
                        Else
                            FUEL_USED_GM.Value = New KineticaRT.Values.Text("0.0")
                        End If


                        If Not (OPC_MOP_OFFSET.Value Is Nothing) Then
                            If (OPC_MOP_OFFSET.Value.ToString() = "0") Then
                                OPC_MOP_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                            End If
                        Else
                            OPC_MOP_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                        End If

                        If Not (OPC_P_AGB_OFFSET.Value Is Nothing) Then
                            If (OPC_P_AGB_OFFSET.Value.ToString() = "0") Then
                                OPC_P_AGB_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                            End If
                        Else
                            OPC_P_AGB_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                        End If

                        If Not (OPC_P1A_1_OFFSET.Value Is Nothing) Then
                            If (OPC_P1A_1_OFFSET.Value.ToString() = "0") Then
                                OPC_P1A_1_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                            End If
                        Else
                            OPC_P1A_1_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                        End If

                        If Not (OPC_P1A_2_OFFSET.Value Is Nothing) Then
                            If (OPC_P1A_2_OFFSET.Value.ToString() = "0") Then
                                OPC_P1A_2_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                            End If
                        Else
                            OPC_P1A_2_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                        End If

                        If Not (OPC_P3_OFFSET.Value Is Nothing) Then
                            If (OPC_P3_OFFSET.Value.ToString() = "0") Then
                                OPC_P3_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                            End If
                        Else
                            OPC_P3_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                        End If

                        If Not (OPC_S1A_1_OFFSET.Value Is Nothing) Then
                            If (OPC_S1A_1_OFFSET.Value.ToString() = "0") Then
                                OPC_S1A_1_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                            End If
                        Else
                            OPC_S1A_1_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                        End If

                        If Not (OPC_S1A_2_OFFSET.Value Is Nothing) Then
                            If (OPC_S1A_2_OFFSET.Value.ToString() = "0") Then
                                OPC_S1A_2_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                            End If
                        Else
                            OPC_S1A_2_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                        End If

                        If Not (OPC_S1A_3_OFFSET.Value Is Nothing) Then
                            If (OPC_S1A_3_OFFSET.Value.ToString() = "0") Then
                                OPC_S1A_3_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                            End If
                        Else
                            OPC_S1A_3_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                        End If

                        If Not (OPC_S1A_4_OFFSET.Value Is Nothing) Then
                            If (OPC_S1A_4_OFFSET.Value.ToString() = "0") Then
                                OPC_S1A_4_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                            End If
                        Else
                            OPC_S1A_4_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                        End If

                        If Not (OPC_THRUST_OFFSET.Value Is Nothing) Then
                            If (OPC_THRUST_OFFSET.Value.ToString() = "0") Then
                                OPC_THRUST_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                            End If
                        Else
