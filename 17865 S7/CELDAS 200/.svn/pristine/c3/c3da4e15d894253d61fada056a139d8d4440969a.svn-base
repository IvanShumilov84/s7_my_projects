                End Select

                Init_Engine_Channels_Value()


            Catch ex As Exception
                MessageBox.Show("OnTestSessionRunning: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        '**************************
        '* OnTestSessionClosing() *
        '**************************
        Protected Overrides Sub OnTestSessionClosing(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Dim i As Integer
            Try
                MyBase.OnTestSessionClosing(newStatus)
                'For All Engine
                ExitThread = True
                Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()
                    Case "PW307A", "PW308A ANC", "PW308C ANC"

                        Init_Engine_Channels_Value() 'Reinit variables before we quit

                        'Stops the Event Archiver (always on)
                        'Warning this must be done before we remove handlers!
                        If Not (EVENT_ARCHIVE Is Nothing) Then
                            EVENT_ARCHIVE.Stop = True
                            EVENT_ARCHIVE.Triggered = False
                        End If



                        'Remove Handlers before Add Handlers, to remove duplicate handlers

                        If Not (AIR_PRESSURE_STARTER_VALUE Is Nothing) Then
                            RemoveHandler AIR_PRESSURE_STARTER_VALUE.ValueChanged, AddressOf OnAIR_PRESSURE_STARTER_VALUE_CHANGE
                        End If
                        'If Not (ARCHIVE_RECORD Is Nothing) Then
                        '    RemoveHandler ARCHIVE_RECORD.ValueChanged, AddressOf OnArchive
                        'End If
                        'If Not (ARCHIVE_STOP_BTN Is Nothing) Then
                        '    RemoveHandler ARCHIVE_STOP_BTN.ValueChanged, AddressOf OnArchive
                        'End If
                        If Not (CLOSE_AIR_CONTROL_BUTTON Is Nothing) Then
                            RemoveHandler CLOSE_AIR_CONTROL_BUTTON.ValueChanged, AddressOf OnCloseAirStartWindow
                        End If
                        If Not (DECREASE_AIR_BUTTON Is Nothing) Then
                            RemoveHandler DECREASE_AIR_BUTTON.ValueChanged, AddressOf OnDECREASE_AIR_BUTTON
                        End If
                        If Not (EEC_CHN_DISABLE_CHA Is Nothing) Then
                            RemoveHandler EEC_CHN_DISABLE_CHA.ValueChanged, AddressOf OnChn_Disable
                        End If
                        If Not (EEC_CHN_DISABLE_CHB Is Nothing) Then
                            RemoveHandler EEC_CHN_DISABLE_CHB.ValueChanged, AddressOf OnChn_Disable
                        End If
                        If Not (EEC_CHN_DISABLE_NONE Is Nothing) Then
                            RemoveHandler EEC_CHN_DISABLE_NONE.ValueChanged, AddressOf OnChn_Disable
                        End If
                        If Not (EEC_LANE_A Is Nothing) Then
                            RemoveHandler EEC_LANE_A.ValueChanged, AddressOf OnLane_Change
                        End If
                        If Not (EEC_LANE_B Is Nothing) Then
                            RemoveHandler EEC_LANE_B.ValueChanged, AddressOf OnLane_Change
                        End If
                        If Not (EEC_LANE_BOTH Is Nothing) Then
                            RemoveHandler EEC_LANE_BOTH.ValueChanged, AddressOf OnLane_Change
                        End If
                        If Not (ENGINE_AT_REST Is Nothing) Then
                            RemoveHandler ENGINE_AT_REST.ValueChanged, AddressOf OnAlarm
                        End If
                        If Not (ESTOP Is Nothing) Then
                            RemoveHandler ESTOP.ValueChanged, AddressOf OnEmerStop
                            RemoveHandler ESTOP.ValueChanged, AddressOf OnAlarm
                        End If
                        If Not (FUEL_FILTER_BYPASS Is Nothing) Then
                            RemoveHandler FUEL_FILTER_BYPASS.ValueChanged, AddressOf OnAlarm
                        End If
                        If Not (HIGH_MOP_DP Is Nothing) Then
                            RemoveHandler HIGH_MOP_DP.ValueChanged, AddressOf OnAlarm
                        End If
                        If Not (INCREASE_AIR_BUTTON Is Nothing) Then
                            RemoveHandler INCREASE_AIR_BUTTON.ValueChanged, AddressOf OnINCREASE_AIR_BUTTON
                        End If
                        If Not (LOW_FUEL_PRESSURE Is Nothing) Then
                            RemoveHandler LOW_FUEL_PRESSURE.ValueChanged, AddressOf OnAlarm
                        End If
                        If Not (LOW_MOP_DP Is Nothing) Then
                            RemoveHandler LOW_MOP_DP.ValueChanged, AddressOf OnAlarm
                        End If
                        If Not (MANUAL_AIR_BUTTON Is Nothing) Then
                            RemoveHandler MANUAL_AIR_BUTTON.ValueChanged, AddressOf OnShowAirStartWindow
                        End If
                        If Not (MOT_CHIP Is Nothing) Then
                            RemoveHandler MOT_CHIP.ValueChanged, AddressOf OnAlarm
                        End If
                        If Not (N1_OVERSPEED Is Nothing) Then
                            RemoveHandler N1_OVERSPEED.ValueChanged, AddressOf OnAlarm
                        End If
                        If Not (N2_OVERSPEED Is Nothing) Then
                            RemoveHandler N2_OVERSPEED.ValueChanged, AddressOf OnAlarm
                        End If
                        If Not (OIL_FILTER_BYPASS Is Nothing) Then
                            RemoveHandler OIL_FILTER_BYPASS.ValueChanged, AddressOf OnAlarm
                        End If
                        If Not (OVERTEMP Is Nothing) Then
                            RemoveHandler OVERTEMP.ValueChanged, AddressOf OnAlarm
                        End If
                        'If Not (PLAY_BUTTON Is Nothing) Then
                        '    RemoveHandler PLAY_BUTTON.ValueChanged, AddressOf OnArchive
                        'End If
                        If Not (ENGINE_TIME_RESET Is Nothing) Then
                            RemoveHandler ENGINE_TIME_RESET.ValueChanged, AddressOf OnResetEngineTime
                        End If
                        If Not (FUEL_USED_RESET Is Nothing) Then
                            RemoveHandler FUEL_USED_RESET.ValueChanged, AddressOf OnResetFuelUsed
                        End If

                        For i = 0 To T6B_DELETE.GetUpperBound(0) - 1
                            If Not (T6B_DELETE(i) Is Nothing) Then
                                RemoveHandler T6B_DELETE(i).ValueChanged, AddressOf OnT6B_DELETE
                            End If
                        Next
                        For i = 0 To T6E_DELETE.GetUpperBound(0) - 1
                            If Not (T6E_DELETE(i) Is Nothing) Then
                                RemoveHandler T6E_DELETE(i).ValueChanged, AddressOf OnT6E_DELETE
                            End If
                        Next
                        For i = 0 To T6G_DELETE.GetUpperBound(0) - 1
                            If Not (T6G_DELETE(i) Is Nothing) Then
                                RemoveHandler T6G_DELETE(i).ValueChanged, AddressOf OnT6G_DELETE
                            End If
                        Next
                        For i = 0 To T6K_DELETE.GetUpperBound(0) - 1
                            If Not (T6K_DELETE(i) Is Nothing) Then
                                RemoveHandler T6K_DELETE(i).ValueChanged, AddressOf OnT6K_DELETE
                            End If
                        Next



                        'Kill the PW300Worker Thread if still alive
                        If Not (PW300WorkerThread Is Nothing) Then
                            If Not (PW300WorkerThread.Join(500)) Then
                                If PW300WorkerThread.IsAlive Then
                                    PW300WorkerThread.Abort()
                                    PW300WorkerThread.Join()
                                End If
                            End If
                            PW300WorkerThread = Nothing
                        End If

                        'Kill the Event Archiver Thread if still alive
                        If Not (EventArchiverThread Is Nothing) Then
                            If Not (EventArchiverThread.Join(500)) Then
                                If EventArchiverThread.IsAlive Then
                                    EventArchiverThread.Abort()
                                    EventArchiverThread.Join()
                                End If
                            End If
                            EventArchiverThread = Nothing
                        End If
                End Select

                Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()
                    Case "PW307A"
                        If Not (EEC_SHUTDOWN Is Nothing) Then
                            RemoveHandler EEC_SHUTDOWN.ValueChanged, AddressOf OnNormalShutdown
                        End If
                        If Not (TARE Is Nothing) Then
                            RemoveHandler TARE.ValueChanged, AddressOf OnTare
                        End If

                        If Not (MOPD_ENG_CHA_DELETE Is Nothing) Then
                            RemoveHandler MOPD_ENG_CHA_DELETE.ValueChanged, AddressOf OnMOPD_ENG_DELETE
                        End If

                        If Not (MOPD_ENG_CHB_DELETE Is Nothing) Then
                            RemoveHandler MOPD_ENG_CHB_DELETE.ValueChanged, AddressOf OnMOPD_ENG_DELETE
                        End If

                        If Not (MOT_CHA_DELETE Is Nothing) Then
                            RemoveHandler MOT_CHA_DELETE.ValueChanged, AddressOf OnMOT_DELETE
                        End If

                        If Not (MOT_CHB_DELETE Is Nothing) Then
                            RemoveHandler MOT_CHB_DELETE.ValueChanged, AddressOf OnMOT_DELETE
                        End If
                    Case "PW308A ANC"
                        If Not (EEC_IGNITION_AUTO Is Nothing) Then
                            RemoveHandler EEC_IGNITION_AUTO.ValueChanged, AddressOf OnIgnition_Sw
                        End If
                        If Not (EEC_IGNITION_AUTO Is Nothing) Then
                            RemoveHandler EEC_IGNITION_CONT.ValueChanged, AddressOf OnIgnition_Sw
                        End If
                        If Not (EEC_NORMAL_SDN Is Nothing) Then
                            RemoveHandler EEC_NORMAL_SDN.ValueChanged, AddressOf OnNormalShutdown
                        End If
                        If Not (EEC_STANDBY_SDN Is Nothing) Then
                            RemoveHandler EEC_STANDBY_SDN.ValueChanged, AddressOf OnStandbyShutdown
                        End If
                        If Not (EEC_POWER_ON Is Nothing) Then
                            RemoveHandler EEC_POWER_ON.ValueChanged, AddressOf OnResetSpinButtons
                        End If
                        If Not (LB_ENABLE Is Nothing) Then
                            RemoveHandler LB_ENABLE.ValueChanged, AddressOf OnLBDisable
                        End If
                        If Not (TARE Is Nothing) Then
                            RemoveHandler TARE.ValueChanged, AddressOf OnTare
                        End If
                        For i = 0 To TT1_DELETE.GetUpperBound(0) - 1
                            If Not (TT1_DELETE(i) Is Nothing) Then
                                RemoveHandler TT1_DELETE(i).ValueChanged, AddressOf OnTT1_DELETE
                            End If
                        Next


                    Case "PW308C ANC"
                        'Remove Handlers before Add Handlers, to remove duplicate handlers
                        If Not (EEC_IGNITION_AUTO Is Nothing) Then
                            RemoveHandler EEC_IGNITION_AUTO.ValueChanged, AddressOf OnIgnition_Sw
                        End If
                        If Not (EEC_IGNITION_CONT Is Nothing) Then
                            RemoveHandler EEC_IGNITION_CONT.ValueChanged, AddressOf OnIgnition_Sw
                        End If
                        If Not (EEC_IGNITION_OFF Is Nothing) Then
                            RemoveHandler EEC_IGNITION_OFF.ValueChanged, AddressOf OnIgnition_Sw
                        End If
                        If Not (EEC_NORMAL_SDN Is Nothing) Then
                            RemoveHandler EEC_NORMAL_SDN.ValueChanged, AddressOf OnNormalShutdown
                        End If
                        If Not (EEC_STANDBY_SDN Is Nothing) Then
                            RemoveHandler EEC_STANDBY_SDN.ValueChanged, AddressOf OnStandbyShutdown
                        End If
                        If Not (LB_ENABLE Is Nothing) Then
                            RemoveHandler LB_ENABLE.ValueChanged, AddressOf OnLBDisable
                        End If
                        If Not (TARE Is Nothing) Then
                            RemoveHandler TARE.ValueChanged, AddressOf OnTare
                        End If
                        For i = 0 To TT1_DELETE.GetUpperBound(0) - 1
                            If Not (TT1_DELETE(i) Is Nothing) Then
                                RemoveHandler TT1_DELETE(i).ValueChanged, AddressOf OnTT1_DELETE
                            End If
                        Next

                End Select




                'Restore default Culture Info
                System.Threading.Thread.CurrentThread.CurrentCulture = OldCultureInfo
            Catch ex As Exception
                MessageBox.Show("OnTestSessionClosing: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub


        '*************************
        '* OnTestSessionIdling() *
        '*************************
        Protected Overrides Sub OnTestSessionIdling(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionIdling(newStatus)
                Try

                Catch Ex As Exception
                Finally
                End Try
            Catch ex As Exception
                MessageBox.Show("OnTestSessionClosing: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        '**************************
        '* Init_Engine_Channels() *
        '**************************
        Private Function Init_Engine_Channels() As Boolean
            Dim i As Integer
            Dim Return_Value As New ArrayList()

            Return_Value.Clear()

            Try


                Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()
                    'Not For "DAS CALIBRATION"

                    Case "PW307A", "PW308A ANC", "PW308C ANC"
                        'Initialise Common Engine Channels				
                        Return_Value.Add(MyBase.InitializeChannel(AIR_PRESSURE_STARTER_VALUE, "AIR_PRESSURE_STARTER_VALUE"))
                        Return_Value.Add(MyBase.InitializeChannel(AIR_BALANCING, "AIR_BALANCING"))
                        Return_Value.Add(MyBase.InitializeChannel(ARCHIVE, "ARCHIVE"))
                        Return_Value.Add(MyBase.InitializeChannel(ARCHIVE_STOP_BTN, "ARCHIVE_STOP_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(ARCHIVE_PLAY_BTN, "ARCHIVE_PLAY_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(ARCHIVE_RECORD, "ARCHIVE_RECORD"))
                        Return_Value.Add(MyBase.InitializeChannel(BUZZER, "BUZZER"))
                        Return_Value.Add(MyBase.InitializeChannel(CLOSE_AIR_CONTROL_BUTTON, "CLOSE_AIR_CONTROL_BUTTON"))
                        Return_Value.Add(MyBase.InitializeChannel(DECREASE_AIR_BUTTON, "DECREASE_AIR_BUTTON"))
                        Return_Value.Add(MyBase.InitializeChannel(DOUT64, "DOUT64"))
                        Return_Value.Add(MyBase.InitializeChannel(EEC_CHN_DISABLE_CHA, "EEC_CHN_DISABLE_CHA"))
                        Return_Value.Add(MyBase.InitializeChannel(EEC_CHN_DISABLE_CHB, "EEC_CHN_DISABLE_CHB"))
                        Return_Value.Add(MyBase.InitializeChannel(EEC_CHN_DISABLE_NONE, "EEC_CHN_DISABLE_NONE"))
                        Return_Value.Add(MyBase.InitializeChannel(EEC_LANE_A, "EEC_LANE_A"))
                        Return_Value.Add(MyBase.InitializeChannel(EEC_LANE_B, "EEC_LANE_B"))
                        Return_Value.Add(MyBase.InitializeChannel(EEC_LANE_BOTH, "EEC_LANE_BOTH"))
                        Return_Value.Add(MyBase.InitializeChannel(EEC_START, "EEC_START"))
                        Return_Value.Add(MyBase.InitializeChannel(EEC_WOW, "EEC_WOW"))
