        '*****************************
        '* OnTare() *
        '*****************************
        Private Sub OnTare(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                If (CELProject.IsTrue(newVal)) Then


                    OPC_MOP_OFFSET.Value = MOP.Value
                    OPC_P_AGB_OFFSET.Value = P_AGB.Value.Subtract(PSN.Value)
                    OPC_P1A_1_OFFSET.Value = P1A_1.Value.Subtract(PSN.Value)
                    OPC_P1A_2_OFFSET.Value = P1A_2.Value.Subtract(PSN.Value)
                    OPC_P3_OFFSET.Value = PS3.Value.Subtract(PSN.Value)
                    OPC_S1A_1_OFFSET.Value = S1A_1.Value.Subtract(PSN.Value)
                    OPC_S1A_2_OFFSET.Value = S1A_2.Value.Subtract(PSN.Value)
                    OPC_S1A_3_OFFSET.Value = S1A_3.Value.Subtract(PSN.Value)
                    OPC_S1A_4_OFFSET.Value = S1A_4.Value.Subtract(PSN.Value)
                    OPC_THRUST_OFFSET.Value = THRUST.Value
                    OPC_P_MOTIVE_OFFSET.Value = P_MOTIVE.Value


                Else

                    OPC_MOP_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                    OPC_P_AGB_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                    OPC_P1A_1_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                    OPC_P1A_2_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                    OPC_P3_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                    OPC_S1A_1_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                    OPC_S1A_2_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                    OPC_S1A_3_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                    OPC_S1A_4_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                    OPC_THRUST_OFFSET.Value = New KineticaRT.Values.Double(0.0)
                    OPC_P_MOTIVE_OFFSET.Value = New KineticaRT.Values.Double(0.0)

                End If
            Catch ex As Exception
                MessageBox.Show("Engine_Sequence: OnTare: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub



        '*****************************
        '* Operating_Time_Calc()    *
        '*****************************
        Private Sub Operating_Time_Calc()
            Try

                Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()

                    Case "PW307A", "PW308C ANC"

                        If ((OPC_N2_ABOVE_GI.Value.ToString.ToUpper = "TRUE") And (Engine_Running = False)) Then
                            OperatingTime_Start = Now
                            Engine_Running = True
                        End If

                        If ((OPC_N2_ABOVE_GI.Value.ToString.ToUpper = "TRUE") Or ((FUEL_FLOW.Value.ToDouble() > 0.0) And (Engine_Running = True))) Then
                            OperatingTime_Stop = Now
                            Current_ts = OperatingTime_Stop.Subtract(OperatingTime_Start)
                            ts = Current_ts.Add(Previous_ts)
                        End If

                    Case "PW308A ANC"

                        If ((OPC_N2_ABOVE_95GI.Value.ToString.ToUpper = "TRUE") And (Engine_Running = False)) Then
                            OperatingTime_Start = Now
                            Engine_Running = True
                        End If

                        If ((OPC_N2_ABOVE_95GI.Value.ToString.ToUpper = "TRUE") Or ((FUEL_FLOW.Value.ToDouble() > 0.0) And (Engine_Running = True))) Then
                            OperatingTime_Stop = Now
                            Current_ts = OperatingTime_Stop.Subtract(OperatingTime_Start)
                            ts = Current_ts.Add(Previous_ts)
                        End If

                End Select

                OPERATING_TIME.Value = New KineticaRT.Values.Text(ts.Hours.ToString.Padleft(2, "0") & ":" & ts.Minutes.ToString.Padleft(2, "0") & ":" & ts.Seconds.ToString.Padleft(2, "0"))

                If (Fuel_Flow.Value.ToDouble() = 0.0) Then
                    Previous_ts = ts
                    Engine_Running = False
                End If


            Catch ex As Exception
                MessageBox.Show("Operating_Time_Calc: " & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally
            End Try

        End Sub

        '****************************
        '* OnMOPD_ENG_DELETE()      *
        '****************************
        Private Sub OnMOPD_ENG_DELETE(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)


            Try

                Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()

                    Case "PW307A"

                        If (MOPD_ENG_CHA_DELETE.Value.ToString.ToUpper = "FALSE" And MOPD_ENG_CHB_DELETE.Value.ToString.ToUpper = "TRUE") Then
                            MOPD_ENG.Text = "MOPD_ENG_CHA"
                            MOPD_ENG_MAX.Text = "MOPD_ENG_CHA"
                            MOPD_ENG_MIN.Text = "MOPD_ENG_CHA"
                        End If

                        If (MOPD_ENG_CHA_DELETE.Value.ToString.ToUpper = "TRUE" And MOPD_ENG_CHB_DELETE.Value.ToString.ToUpper = "FALSE") Then
                            MOPD_ENG.Text = "MOPD_ENG_CHB"
                            MOPD_ENG_MAX.Text = "MOPD_ENG_CHB"
                            MOPD_ENG_MIN.Text = "MOPD_ENG_CHB"
                        End If

                        If (MOPD_ENG_CHA_DELETE.Value.ToString.ToUpper = "FALSE" And MOPD_ENG_CHB_DELETE.Value.ToString.ToUpper = "FALSE") Then
                            MOPD_ENG.Text = "(MOPD_ENG_CHA + MOPD_ENG_CHB)/2"
                            MOPD_ENG_MAX.Text = "Max(MOPD_ENG_CHA,MOPD_ENG_CHB)"
                            MOPD_ENG_MIN.Text = "Min(MOPD_ENG_CHA,MOPD_ENG_CHB)"
                        End If
                End Select
            Catch Ex As Exception
                MessageBox.Show("OnMOPD_ENG_DELETE: " & Ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            Finally
            End Try

        End Sub



        '****************************
        '* OnMOT_DELETE()           *
        '****************************
        Private Sub OnMOT_DELETE(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)


            Try

                Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()

                    Case "PW307A"

                        If (MOT_CHA_DELETE.Value.ToString.ToUpper = "FALSE" And MOT_CHB_DELETE.Value.ToString.ToUpper = "TRUE") Then
                            MOT.Text = "MOT_CHA"
                            MOT_MAX.Text = "MOT_CHA"
                            MOT_MIN.Text = "MOT_CHA"
                        End If

                        If (MOT_CHA_DELETE.Value.ToString.ToUpper = "TRUE" And MOT_CHB_DELETE.Value.ToString.ToUpper = "FALSE") Then
                            MOT.Text = "MOT_CHB"
                            MOT_MAX.Text = "MOT_CHB"
                            MOT_MIN.Text = "MOT_CHB"
                        End If

                        If (MOT_CHA_DELETE.Value.ToString.ToUpper = "FALSE" And MOT_CHB_DELETE.Value.ToString.ToUpper = "FALSE") Then
                            MOT.Text = "(MOT_CHA + MOT_CHB)/2"
                            MOT_MAX.Text = "Max(MOT_CHA,MOT_CHB)"
                            MOT_MIN.Text = "Min(MOT_CHA,MOT_CHB)"
                        End If
                End Select
            Catch Ex As Exception
                MessageBox.Show("OnMOT_DELETE: " & Ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            Finally
            End Try

        End Sub


        '*******************
        '* OnTT1_DELETE()  *
        '*******************
        Private Sub OnTT1_DELETE(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Dim Avg_Text As String = ""
            Dim Count As Integer = 0
            Dim i As Integer
            Dim Max_Text As String = ""
            Dim Min_Text As String = ""

            Try
                TT1_COUNT.Value = KineticaRT.Values.Values.Zero
                Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()

                    Case "PW308A ANC", "PW308C ANC"

                        For i = 0 To TT1_DELETE.GetUpperBound(0) - 1
                            If (TT1_DELETE(i).Value.ToString.ToUpper = "FALSE") Then
                                Count = Count + 1

                                If Count = 1 Then
                                    Avg_Text = "(TT1_" + (i + 1).ToString()
                                    Max_Text = "Max(TT1_" + (i + 1).ToString()
                                    Min_Text = "Min(TT1_" + (i + 1).ToString()
                                Else
                                    Avg_Text = Avg_Text + " + TT1_" + (i + 1).ToString()
                                    Max_Text = Max_Text + ", TT1_" + (i + 1).ToString()
                                    Min_Text = Min_Text + ", TT1_" + (i + 1).ToString()
                                End If
                            End If
                        Next

                        If Count = 0 Then
                            Avg_Text = "0"
                            Max_Text = "0"
                            Min_Text = "0"
                        Else
                            Avg_Text = Avg_Text + ")/" + Count.ToString()
                            Max_Text = Max_Text + ")"
                            Min_Text = Min_Text + ")"
                        End If

                        TT1_AVG.Text = Avg_Text
                        TT1_COUNT.Value = New KineticaRT.Values.Integer(TT1_DELETE.GetUpperBound(0) - Count)
                        TT1_MAX.Text = Max_Text
                        TT1_MIN.Text = Min_Text

                End Select
            Catch Ex As Exception
                MessageBox.Show("OnTT1_DELETE: " & Ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            Finally
            End Try

        End Sub


