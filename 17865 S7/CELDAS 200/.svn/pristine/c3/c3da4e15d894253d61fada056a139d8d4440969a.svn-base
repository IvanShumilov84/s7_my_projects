        '***********
        '* Connect *
        '***********

        Public Overloads Overrides Sub Connect()
            If Me.Connected = False Then
                MyBase.Connect()

                'Verify the connection to the channels
                If Init_Channels() = False Then
                    MessageBox.Show("ENGINE SEQUENCE: Connect() - missing channels")
                    Return
                End If
                Me.Connected = True
            End If
        End Sub


        '****************
        '* Disconnect() *
        '****************
        Public Overloads Overrides Sub Disconnect()
            If Me.Connected = True Then
                MyBase.disconnect()
                ExitThread = True
                If Not (PW300WorkerThread Is Nothing) Then
                    If Not (PW300WorkerThread.Join(500)) Then
                        If PW300WorkerThread.IsAlive Then
                            PW300WorkerThread.Abort()
                            PW300WorkerThread.Join()
                        End If
                    End If
                    PW300WorkerThread = Nothing
                End If
                'Kill the Event Archiver Thread if still alive
                If Not (EventArchiverThread Is Nothing) Then
                    If Not (EventArchiverThread.Join(500)) Then
                        If EventArchiverThread.IsAlive Then
                            EventArchiverThread.Abort()
                            EventArchiverThread.Join()
                        End If
                    End If
                    EventArchiverThread = Nothing
                End If
                Me.Connected = False
            End If
        End Sub


        '********************************************************************
        '* Private Methods **************************************************
        '********************************************************************

        '*******************
        '* ActivateForm	   *
        '*******************
        Private Sub ActivateForm(ByVal FormName As String, ByVal OwnerName As String, ByVal Activate As Boolean)

            Try

                Dim i, j As Integer

                If (Activate = True) Then
                    For i = 0 To WINDOW_NAME.GetUpperBound(0)
                        If WINDOW_NAME(i) = FormName Then
                            If OwnerName <> "" Then
                                EngineWindow(i).FormBorderStyle = FormBorderStyle.FixedSingle
                                EngineWindow(i).Refresh()
                                EngineWindow(i).BringToFront()

                                For j = 0 To WINDOW_NAME.GetUpperBound(0)
                                    If WINDOW_NAME(j) = OwnerName Then
                                        EngineWindow(i).Owner = EngineWindow(j)
                                        ' EngineWindow(j).BringToFront
                                        ' EngineWindow(j).Refresh

                                        Exit For
                                    End If
                                Next
                            End If

                            EngineWindow(i).Visible = True
                            EngineWindow(i).Activate()
                            Exit For
                        End If
                        If (i - 1) = WINDOW_NAME.GetUpperBound(0) Then
                            MessageBox.Show("ERROR: " & FormName & " Window could not be found.", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                        End If
                    Next
                Else 'Deactivate
                    For i = 0 To WINDOW_NAME.GetUpperBound(0)
                        If WINDOW_NAME(i) = FormName Then
                            EngineWindow(i).Visible = False
                            EngineWindow(i).Refresh()
                        ElseIf WINDOW_NAME(i) = OwnerName Then
                            EngineWindow(i).FormBorderStyle = FormBorderStyle.FixedSingle
                            EngineWindow(i).Refresh()
                            EngineWindow(i).BringToFront()
                        End If

                        If (i - 1) = WINDOW_NAME.GetUpperBound(0) Then
                            MessageBox.Show("ERROR: " & FormName & " Window could not be found.", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                        End If
                    Next
                End If

            Catch

            End Try

        End Sub

        '***************************
        '* ConvertSecondsToTime	   *
        '***************************
        Private Function ConvertSecondsToTime(ByVal dSeconds As Double) As String
            ConvertSecondsToTime = Format(DateAdd("s", dSeconds, "00:00:00"), "HH:mm:ss")
        End Function




        '*****************************
        '* EnsureProcessKilled() 	 *
        '*****************************
        Public Sub EnsureProcessKilled(ByVal MainWindowHandle As IntPtr, ByVal Caption As String)
            Try
                SetLastError(0)
                ' for Excel versions <10, this won't be set yet
                If IntPtr.Equals(MainWindowHandle, IntPtr.Zero) Then MainWindowHandle = FindWindow(Nothing, Caption)
                If IntPtr.Equals(MainWindowHandle, IntPtr.Zero) Then Exit Sub ' at this point, presume the window has been closed.

                Dim iRes, iProcID As Integer
                iRes = GetWindowThreadProcessId(MainWindowHandle, iProcID)
                If iProcID = 0 Then ' can’t get Process ID
                    If EndTask(MainWindowHandle) <> 0 Then Exit Sub ' success
                    'Throw New ApplicationException("Failed to close.")
                End If
                Dim proc As System.Diagnostics.Process
                proc = System.Diagnostics.Process.GetProcessById(iProcID)
                proc.CloseMainWindow()
                proc.Refresh()
                If proc.HasExited Then Exit Sub
                proc.Kill()
            Catch ex As Exception
                'Do nothing
            End Try
        End Sub


        '******************************
        '* Fill_Characterizer_Table() *
        '******************************
        Private Function Fill_Characterizer_Table(ByVal Flowmeter_ID As Integer, ByVal Source_Type As String) As Boolean
            Dim i As Integer

            Fill_Characterizer_Table = False

            Try
                If Source_Type = "Voltage" Then 'Warning: First entry in table should be 0.0
                    For i = 0 To 50
                        X_Characterizer(Flowmeter_ID, i) = Flowmeter_Voltage(Flowmeter_ID, i)
                    Next
                ElseIf Source_Type = "Frequency" Then 'Warning: First entry in table should be 0.0
                    For i = 0 To 50
                        X_Characterizer(Flowmeter_ID, i) = Flowmeter_Frequency(Flowmeter_ID, i)
                    Next
                End If

                For i = 0 To 50 'Warning: First entry in table should be 0.0
                    Y_Characterizer(Flowmeter_ID, i) = Flowmeter_USGPM(Flowmeter_ID, i)
                Next

                Fill_Characterizer_Table = True

            Catch Ex As Exception
            Finally
            End Try

        End Function

        '*****************************
        '* Flowmeter_Characterizer() *
        '*****************************
        Private Function Flowmeter_Characterizer(ByVal Flowmeter_ID As Integer, ByVal Source As Double) As Double
            Dim Flow As Double
            Dim i, j As Integer
            Dim Offset As Double
            Dim Slope As Double

            Try

                If Source <= X_Characterizer(Flowmeter_ID, 0) Then
                    Slope = 0.0
                    Offset = 0.0

                    Flow = Slope * Source + Offset
                ElseIf Source >= X_Characterizer(Flowmeter_ID, 50) Then
                    For i = 49 To 0 Step -1
                        If X_Characterizer(Flowmeter_ID, i) <> X_Characterizer(Flowmeter_ID, 50) Then
                            Exit For
                        End If
                    Next
                    Slope = (Y_Characterizer(Flowmeter_ID, 50) - Y_Characterizer(Flowmeter_ID, i)) / (X_Characterizer(Flowmeter_ID, 50) - X_Characterizer(Flowmeter_ID, i))
                    Offset = Y_Characterizer(Flowmeter_ID, 50) - Slope * X_Characterizer(Flowmeter_ID, 50)

                    Flow = Slope * Source + Offset
                Else
                    For i = 0 To 50
                        If ((Source >= X_Characterizer(Flowmeter_ID, i)) And (Source <= X_Characterizer(Flowmeter_ID, i + 1))) Then
                            'Exit For
                            j = i
                            i = 70
                        End If
                    Next

                    Slope = (Y_Characterizer(Flowmeter_ID, j + 1) - Y_Characterizer(Flowmeter_ID, j)) / (X_Characterizer(Flowmeter_ID, j + 1) - X_Characterizer(Flowmeter_ID, j))
                    Flow = (Slope * Source) + (Y_Characterizer(Flowmeter_ID, j) - Slope * X_Characterizer(Flowmeter_ID, j))
                End If

                Flowmeter_Characterizer = Flow
            Catch Ex As Exception

            Finally
            End Try

        End Function





