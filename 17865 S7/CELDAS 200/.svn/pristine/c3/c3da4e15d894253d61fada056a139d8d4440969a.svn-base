        '**************************
        '* Initialize_Object()    *
        '**************************
        Private Function Initialize_Object(ByRef Channel As Object, ByVal ChannelName As String) As Boolean
            Channel = GetObject(ChannelName)

            If Channel Is Nothing Then
                MessageBox.Show("Initialize_Object - " + ChannelName + " Is Nothing")
                Initialize_Object = False
            Else
                Initialize_Object = True
            End If
        End Function


        '*****************************
        '* Fuel_Used_Calc()          *
        '*****************************
        Private Sub Fuel_Used_Calc()
            Try

                If (Engine_Running = True) Then
                    '****************************************************************************************************
                    '* WF(lbs/hour)  SG(Kg/liter)  (gallon/liter)*(hour/minute)*(kilogram/pounds)=0.001997 gallons/min  *
                    '* calculation rate 2400 times per minute (threadsleeep(25))                                        *
                    '**************************************************************************************************** 

                    If (SG_READ.Value.ToDouble() > 0) Then
                        Current_Fuel_Used = Current_Fuel_Used + (WF.Value.ToDouble() / SG_READ.Value.ToDouble() * 0.001997 * 0.000417)
                    End If

                End If

                FUEL_USED_GM.Value = New KineticaRT.Values.Double(Current_Fuel_Used)

            Catch ex As Exception
                MessageBox.Show("Fuel_Used_Calc: " & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally
            End Try

        End Sub


        '******************
        '* PrintReport	  *
        '******************
        Private Sub PrintReport(ByVal excelWorkbook As Excel.Workbook)
            Dim Result As DialogResult

            Dim excelSheets As Excel.Sheets
            Dim currentSheet As String
            Dim excelWorksheet As Excel.Worksheet

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            Result = System.Windows.Forms.MessageBox.Show("Do you want to print last report ?", "Log Report", MessageBoxButtons.YesNo, MessageBoxIcon.Question)
            If (Result = DialogResult.Yes) Then
                currentSheet = "Sheet1"
                excelWorksheet = excelSheets.Item(currentSheet)
                excelWorksheet.PrintOut()

                currentSheet = "Sheet2"
                excelWorksheet = excelSheets.Item(currentSheet)
                excelWorksheet.PrintOut()

                currentSheet = "Sheet3"
                excelWorksheet = excelSheets.Item(currentSheet)
                excelWorksheet.PrintOut()
            End If
        End Sub


        Private Sub PrintReport(ByVal excelWorksheet As Excel.Worksheet)
            Dim Result As DialogResult

            Result = MessageBox.Show("Print last full log report?", "Log Report", MessageBoxButtons.YesNo)
            If (Result = DialogResult.Yes) Then
                excelWorksheet.PrintOut()
            End If
        End Sub


