        '*************
        '* OnAlarm() *
        '*************
        Private Sub OnAlarm(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try

                If ((OVERTEMP.Value.ToString.ToUpper = "TRUE" _
                 Or N1_OVERSPEED.Value.ToString.ToUpper = "TRUE" _
                 Or N2_OVERSPEED.Value.ToString.ToUpper = "TRUE" _
                 Or LOW_FUEL_PRESSURE.Value.ToString.ToUpper = "TRUE" _
                 Or LOW_MOP_DP.Value.ToString.ToUpper = "TRUE" _
                 Or HIGH_MOP_DP.Value.ToString.ToUpper = "TRUE" _
                 Or FUEL_FILTER_BYPASS.Value.ToString.ToUpper = "TRUE" _
                 Or OIL_FILTER_BYPASS.Value.ToString.ToUpper = "TRUE" _
                 Or MOT_CHIP.Value.ToString.ToUpper = "TRUE") _
                 And ENGINE_AT_REST.Value.ToString.ToUpper = "FALSE" _
                 Or ESTOP.Value.ToString.ToUpper = "TRUE") Then

                    BUZZER.Value = Kineticart.Values.Values.True
                Else
                    BUZZER.Value = Kineticart.Values.Values.False
                End If
            Catch ex As Exception
                MessageBox.Show("AlarmBuzzer: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub


        '**********************
        '* OnChn_Disable()    *
        '**********************
        Private Sub OnChn_Disable(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                If (CELProject.IsTrue(newVal)) Then
                    If (sender.Name = "EEC_CHN_DISABLE_CHA") Then
                        EEC_CHN_DISABLE_CHB.Value = KineticaRT_ZERO
                        EEC_CHN_DISABLE_NONE.Value = KineticaRT_ZERO
                    ElseIf (sender.Name = "EEC_CHN_DISABLE_CHB") Then
                        EEC_CHN_DISABLE_CHA.Value = KineticaRT_ZERO
                        EEC_CHN_DISABLE_NONE.Value = KineticaRT_ZERO
                    ElseIf (sender.Name = "EEC_CHN_DISABLE_NONE") Then
                        EEC_CHN_DISABLE_CHA.Value = KineticaRT_ZERO
                        EEC_CHN_DISABLE_CHB.Value = KineticaRT_ZERO
                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("Engine_Sequence: OnChn_Disable: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub


        '********************
        '* OnCloseTest()    *
        '********************
        Private Sub OnClose_Test(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                If (CELProject.IsTrue(newVal)) Then
                    Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()
                        'Not For "DAS CALIBRATION"
                        Case "PW307A", "PW308A ANC", "PW308C ANC"
                            If Not (AIR_PRESSURE_STARTER_VALUE Is Nothing) Then
                                AIR_PRESSURE_STARTER_VALUE.Value = KineticaRT.Values.Values.Zero
                            End If
                    End Select
                    Thread.Sleep(100)
                    'Close Test
                    CELProject.Test_Mgr_Cmd.Value = New KineticaRT.Values.Text(CELDAS.eTest_Mgr_Cmd.Close)
                End If

                CELProject.CLOSE_TEST_BTN.Value = KineticaRT.Values.Values.False
            Catch ex As Exception
                MessageBox.Show("Engine_Sequence: OnClose_Test: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub








        '*******************
        '* OnEmerStop()    *
        '*******************
        Private Sub OnEmerStop(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                If (newVal.ToString.ToUpper = "TRUE") Then

                    Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()

                        Case "PW307A", "PW308A ANC", "PW308C ANC"

                            AIR_BALANCING.Value = KineticaRT.Values.Values.False
                            FUEL_PUMP.Value = KineticaRT.Values.Values.False
                            FUEL_ARMING.Value = KineticaRT.Values.Values.False
                            EEC_START.Value = KineticaRT.Values.Values.False
                            IGNITER_A.Value = KineticaRT.Values.Values.False
                            IGNITER_B.Value = KineticaRT.Values.Values.False
                            MOTORING.Value = KineticaRT.Values.Values.False
                    End Select


                    Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()

                        Case "PW307A"

                            EEC_START.Value = KineticaRT.Values.Values.False
                            EEC_SHUTDOWN.Value = KineticaRT.Values.Values.True
                            EEC_MOTOR.Value = KineticaRT.Values.Values.False

                        Case "PW308A ANC", "PW308C ANC"

                            EEC_NORMAL_SDN.Value = KineticaRT.Values.Values.True

                    End Select

                End If
            Catch ex As Exception
                MessageBox.Show("Engine_Sequence: OnEmerStop: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub


        '*******************
        '* OnFire_Signal() *
        '*******************
        Private Sub OnFire_Signal(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                If (newVal.ToString.ToUpper = "FALSE") Then
                    FUEL_PUMP.Value = KineticaRT_ZERO
                    ESTOP.Value = New KineticaRT.Values.Double(1)
                ElseIf (newVal.ToString.ToUpper = "TRUE") Then
                    ESTOP.Value = KineticaRT_ZERO
                End If
            Catch ex As Exception
                MessageBox.Show("Engine_Sequence: OnFire_Signal: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub


        '*********************
        '* OnFlowmeter()     *
        '*********************
        Private Sub OnFlowmeter()
            Try
                WF_CAL.Value = New KineticaRT.Values.Double(Flowmeter_Characterizer(1, WF_RAW.Value.ToDouble()))
            Catch ex As Exception
                MessageBox.Show("Engine_Sequence: OnFlowmeter: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub


        '**********************
        '* OnIgnition_Sw()    *
        '**********************
        Private Sub OnIgnition_Sw(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()
                    Case "PW308A ANC"
                        If (CELProject.IsTrue(newVal)) Then
                            If (sender.Name = "EEC_IGNITION_AUTO") Then
                                EEC_IGNITION_CONT.Value = KineticaRT_ZERO
                            ElseIf (sender.Name = "EEC_IGNITION_CONT") Then
                                EEC_IGNITION_AUTO.Value = KineticaRT_ZERO
                            End If
                        End If

                    Case "PW308C ANC"
                        If (CELProject.IsTrue(newVal)) Then
                            If (sender.Name = "EEC_IGNITION_AUTO") Then
                                EEC_IGNITION_CONT.Value = KineticaRT_ZERO
                                EEC_IGNITION_OFF.Value = KineticaRT_ZERO
                            ElseIf (sender.Name = "EEC_IGNITION_CONT") Then
                                EEC_IGNITION_AUTO.Value = KineticaRT_ZERO
                                EEC_IGNITION_OFF.Value = KineticaRT_ZERO
                            ElseIf (sender.Name = "EEC_IGNITION_OFF") Then
                                EEC_IGNITION_AUTO.Value = KineticaRT_ZERO
                                EEC_IGNITION_CONT.Value = KineticaRT_ZERO
                            End If
                        End If
                End Select

            Catch ex As Exception
                MessageBox.Show("Engine_Sequence: OnIgnition_Sw: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub


        '**********************
        '* OnLane_Change()    *
        '**********************
        Private Sub OnLane_Change(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                If (CELProject.IsTrue(newVal)) Then
                    If (sender.Name = "EEC_LANE_A") Then
                        EEC_LANE_B.Value = KineticaRT_ZERO
                        EEC_LANE_BOTH.Value = KineticaRT_ZERO
                        RVDT_OSC_LANE_B.Value = KineticaRT.Values.Values.False
                    ElseIf (sender.Name = "EEC_LANE_B") Then
                        EEC_LANE_A.Value = KineticaRT_ZERO
                        EEC_LANE_BOTH.Value = KineticaRT_ZERO
                        RVDT_OSC_LANE_B.Value = KineticaRT.Values.Values.True
                    ElseIf (sender.Name = "EEC_LANE_BOTH") Then
                        EEC_LANE_A.Value = KineticaRT_ZERO
                        EEC_LANE_B.Value = KineticaRT_ZERO
                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("Engine_Sequence: OnLane_Change: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub


        '********************
        '* OnLBDisable()    *
        '********************
        Private Sub OnLBDisable(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                If (newVal Is KineticaRT.Values.Values.False) Then
                    LB_STAGE1.Value = KineticaRT_ZERO
                    LB_STAGE2.Value = KineticaRT_ZERO
                    LB_STAGE3.Value = KineticaRT_ZERO
                    LB_STAGE4.Value = KineticaRT_ZERO
                    LB_STAGE5.Value = KineticaRT_ZERO
                    If CELProject.Test_Mgr_UUT_Model.Value.ToString() = "PW308A ANC" Then
                        LB_STAGE6.Value = KineticaRT_ZERO
                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("Engine_Sequence: OnLBDisable: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub


        '*******************
        '* OnNormalShutdown()    *
        '*******************
        Private Sub OnNormalShutdown(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                If (newVal.ToString.ToUpper = "TRUE") Then

                    Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()

                        Case "PW307A", "PW308A ANC", "PW308C ANC"

                            EEC_START.Value = KineticaRT.Values.Values.False
                            IGNITER_A.Value = KineticaRT.Values.Values.False
                            IGNITER_B.Value = KineticaRT.Values.Values.False

                    End Select


                    Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()

                        Case "PW308A ANC", "PW308C ANC"

                            EEC_NORMAL_SDN.Value = KineticaRT.Values.Values.True

                    End Select

                End If
            Catch ex As Exception
                MessageBox.Show("Engine_Sequence: OnShutdown: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub


        '*************************
        '* OnResetEngineTime()    *
        '*************************
        Private Sub OnResetEngineTime(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            If (CELProject.IsTrue(newVal)) Then
                Previous_ts = New System.TimeSpan(0)
                ts = New System.TimeSpan(0)
                Engine_Running = False
                OPERATING_TIME.Value = New KineticaRT.Values.Text(ts.Hours.ToString.PadLeft(2, "0") & ":" & ts.Minutes.ToString.PadLeft(2, "0") & ":" & ts.Seconds.ToString.PadLeft(2, "0"))
                'Reset Button
                ENGINE_TIME_RESET.Value = KineticaRT.Values.Values.False
            End If
        End Sub


        '*************************
        '* OnResetFuelUsed()    *
