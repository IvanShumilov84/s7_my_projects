        '*************************
        '* OnINCREASE_AIR_BUTTON()    *
        '*************************
        Private Sub OnINCREASE_AIR_BUTTON(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            If (CELProject.IsTrue(newVal)) Then
                If (AIR_PRESSURE_STARTER_VALUE.Value.ToDouble() < 99) Then
                    AIR_PRESSURE_STARTER_VALUE.Value = New KineticaRT.Values.Double(AIR_PRESSURE_STARTER_VALUE.Value.ToDouble() + 1.0)
                Else
                    AIR_PRESSURE_STARTER_VALUE.Value = New KineticaRT.Values.Double(100.0)
                End If
            End If
        End Sub

        '*************************
        '* OnDECREASE_AIR_BUTTON()    *
        '*************************
        Private Sub OnDECREASE_AIR_BUTTON(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            If (CELProject.IsTrue(newVal)) Then

                If (AIR_PRESSURE_STARTER_VALUE.Value.ToDouble() > 1.0) Then
                    AIR_PRESSURE_STARTER_VALUE.Value = New KineticaRT.Values.Double(AIR_PRESSURE_STARTER_VALUE.Value.ToDouble() - 1.0)
                Else
                    AIR_PRESSURE_STARTER_VALUE.Value = New KineticaRT.Values.Double(0.0)
                End If
            End If
        End Sub


        '*************************
        '* OnAIR_PRESSURE_STARTER_VALUE_CHANGE()    *
        '*************************
        Private Sub OnAIR_PRESSURE_STARTER_VALUE_CHANGE(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)


            If (AIR_PRESSURE_STARTER_VALUE.Value.ToDouble() > 100.0) Then
                AIR_PRESSURE_STARTER_VALUE.Value = New KineticaRT.Values.Double(100.0)
            End If

            If (AIR_PRESSURE_STARTER_VALUE.Value.ToDouble() < 0.0) Then
                AIR_PRESSURE_STARTER_VALUE.Value = New KineticaRT.Values.Double(0.0)
            End If

        End Sub
        '*************************
        '* OnShowAirStartWindow()    *
        '*************************
        Private Sub OnShowAirStartWindow(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            If (CELProject.IsTrue(newVal)) Then

                Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()

                    Case "PW307A"
                        Me.ActivateForm("AirStart_Control_Screen", "PW307A_Screen", True)

                    Case "PW308A ANC"
                        Me.ActivateForm("AirStart_Control_Screen", "PW308A_Screen", True)

                    Case "PW308C ANC"
                        Me.ActivateForm("AirStart_Control_Screen", "PW308C_Screen", True)

                End Select
                'Reset Button
                MANUAL_AIR_BUTTON.Value = KineticaRT.Values.Values.False
            End If
        End Sub

        '*************************************
        '* OnCloseAirStartControlWindow()    *
        '*************************************
        Private Sub OnCloseAirStartWindow(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            If (CELProject.IsTrue(newVal)) Then
                Me.ActivateForm("AirStart_Control_Screen", CELProject.Test_Mgr_UUT_Model.Value.ToString + "_Screen", False)

                'Reset Button
                CLOSE_AIR_CONTROL_BUTTON.Value = KineticaRT.Values.Values.False
            End If
        End Sub


        '************************
        '* PW300WorkingThread() * 
        '************************
        Private Sub PW300WorkingThread()

            Try
                Do While Not ExitThread
                    Thread.Sleep(25)
                    Operating_Time_Calc()
                    Fuel_Used_Calc()
                Loop

            Catch ex As Exception
                MessageBox.Show("PW300WorkingThread: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub



        '******************************
        '* OnTestSessionInitialized() *
        '******************************
        Protected Overrides Sub OnTestSessionInitialized(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionInitialized(newStatus)
                Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()
                    'Not For "DAS CALIBRATION"
                    Case "PW307A", "PW308A ANC", "PW308C ANC"
                        'TODO: dans le test session Read_Flowmeters()
                        Fill_Characterizer_Table(1, "Frequency")

                End Select
            Catch ex As Exception
                MessageBox.Show("OnTestSessionInitialized: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub





        '**************************
        '* OnTestSessionRunning() *
        '**************************
        Protected Overrides Sub OnTestSessionRunning(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Dim i As Integer
            Try
                MyBase.OnTestSessionRunning(newStatus)
                Init_Engine_Channels()

                Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()
                    Case "PW307A"
                        Me.ActivateForm("EEC PW307A", "PW307A_Screen", True)
                    Case "PW308A ANC"
                        Me.ActivateForm("EEC PW308A", "PW308A_Screen", True)
                    Case "PW308C ANC"
                        'ft plus de besoin Me.ActivateForm("EEC PW308C", "PW308C_Screen", True)
                        'CELProject.Open_HMI(Test_Mgr_UUT_Model.Value.ToString())
                End Select
                Me.EngineWindow(0).BeginInvoke(New MethodInvoker(AddressOf Me.Initialize_Engine_Controls))

                Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()
                    'Not For "DAS CALIBRATION"
                    Case "PW307A", "PW308A ANC", "PW308C ANC"
                        ''Add Handlers
                        ''Close_test Must Be first
                        'AddHandler Close_Test.ValueChanged, AddressOf OnClose_Test
