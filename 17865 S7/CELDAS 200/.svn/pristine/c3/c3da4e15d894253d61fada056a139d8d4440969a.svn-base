        '********************************
        '* Init_Engine_Channels_Value() *
        '********************************
        Private Sub Init_Engine_Channels_Value()
            'Dim i As Integer

            Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()
                'Not For "DAS CALIBRATION"
                Case "PW307A", "PW308A ANC", "PW308C ANC"

                    If Not (PLAY_BUTTON Is Nothing) Then
                        PLAY_BUTTON.Value = KineticaRT.Values.Values.False
                    End If

                    Log_FolderName = "C:\" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(1).Value.ToString() + "\Log\"

                    If Not (AIR_PRESSURE_STARTER_VALUE Is Nothing) Then
                        AIR_PRESSURE_STARTER_VALUE.Value = KineticaRT.Values.Values.Zero
                    End If

                    If Not (EEC_CHN_DISABLE_CHA Is Nothing) Then
                        EEC_CHN_DISABLE_CHA.Value = KineticaRT.Values.Values.False
                    End If

                    If Not (EEC_CHN_DISABLE_CHB Is Nothing) Then
                        EEC_CHN_DISABLE_CHB.Value = KineticaRT.Values.Values.False
                    End If

                    If Not (EEC_CHN_DISABLE_NONE Is Nothing) Then
                        EEC_CHN_DISABLE_NONE.Value = KineticaRT.Values.Values.True
                    End If

                    If Not (EEC_LANE_A Is Nothing) Then
                        EEC_LANE_A.Value = KineticaRT.Values.Values.False
                    End If

                    If Not (EEC_LANE_B Is Nothing) Then
                        EEC_LANE_B.Value = KineticaRT.Values.Values.False
                    End If

                    If Not (EEC_LANE_BOTH Is Nothing) Then
                        EEC_LANE_BOTH.Value = KineticaRT.Values.Values.True
                    End If

                    For index As Integer = 0 To T6B_DELETE.GetUpperBound(0) - 1
                        If Not (T6B_DELETE(index) Is Nothing) Then
                            T6B_DELETE(index).Value = KineticaRT.Values.Values.False
                        End If
                    Next

                    For index As Integer = 0 To T6E_DELETE.GetUpperBound(0) - 1
                        If Not (T6E_DELETE(index) Is Nothing) Then
                            T6E_DELETE(index).Value = KineticaRT.Values.Values.False
                        End If
                    Next

                    For index As Integer = 0 To T6G_DELETE.GetUpperBound(0) - 1
                        If Not (T6G_DELETE(index) Is Nothing) Then
                            T6G_DELETE(index).Value = KineticaRT.Values.Values.False
                        End If
                    Next

                    For index As Integer = 0 To T6K_DELETE.GetUpperBound(0) - 1
                        If Not (T6K_DELETE(index) Is Nothing) Then
                            T6K_DELETE(index).Value = KineticaRT.Values.Values.False
                        End If
                    Next

                    If Not (T6B_COUNT Is Nothing) Then
                        T6B_COUNT.Value = KineticaRT.Values.Values.Zero
                    End If

                    If Not (T6E_COUNT Is Nothing) Then
                        T6E_COUNT.Value = KineticaRT.Values.Values.Zero
                    End If

                    If Not (T6G_COUNT Is Nothing) Then
                        T6G_COUNT.Value = KineticaRT.Values.Values.Zero
                    End If

                    If Not (T6K_COUNT Is Nothing) Then
                        T6K_COUNT.Value = KineticaRT.Values.Values.Zero
                    End If

                    If (CELProject.Test_Mgr_UUT_Model.Value.ToString() <> "PW307A") Then
                        For index As Integer = 0 To TT1_DELETE.GetUpperBound(0) - 1
                            If Not (TT1_DELETE(index) Is Nothing) Then
                                TT1_DELETE(index).Value = KineticaRT.Values.Values.False
                            End If
                        Next
                    End If

                    If Not (EEC_WOW Is Nothing) Then
                        EEC_WOW.Value = KineticaRT.Values.Values.True
                    End If

                    If Not (BUZZER Is Nothing) Then
                        BUZZER.Value = KineticaRT.Values.Values.False
                    End If

                    If Not (RVDT_OSC_LANE_B Is Nothing) Then
                        RVDT_OSC_LANE_B.Value = KineticaRT.Values.Values.False
                    End If

                    If Not (DOUT99 Is Nothing) Then
                        DOUT99.Value = KineticaRT.Values.Values.True
                    End If

                    If Not (DOUT100 Is Nothing) Then
                        DOUT100.Value = KineticaRT.Values.Values.True
                    End If
                    ts = New System.TimeSpan(0, 0, 0, 0, 0) 'init operating time to 0 at open test only
            End Select

            Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()

                Case "PW307A"
                    If Not (DOUT64 Is Nothing) Then
                        DOUT64.Value = KineticaRT.Values.Values.False
                    End If

                    If Not (EEC_SHUTDOWN Is Nothing) Then
                        EEC_SHUTDOWN.Value = KineticaRT.Values.Values.True
                    End If

                    If Not (EEC_LINEAR_TLA Is Nothing) Then
                        EEC_LINEAR_TLA.Value = KineticaRT.Values.Values.True
                    End If

                    If Not (EEC_DEV_SOFT Is Nothing) Then
                        EEC_DEV_SOFT.Value = KineticaRT.Values.Values.True
                    End If

                    If Not (EEC_ENG_POS_3 Is Nothing) Then
                        EEC_ENG_POS_3.Value = KineticaRT.Values.Values.True
                    End If

                    '
                    ' EEC_AUTO_IGN is in Fact Continuous Ignition Off/On
                    '
                    If Not (EEC_AUTO_IGN Is Nothing) Then
                        EEC_AUTO_IGN.Value = KineticaRT.Values.Values.False
                    End If
                    If Not (DOUT14 Is Nothing) Then
                        DOUT14.Value = KineticaRT.Values.Values.False
                    End If

                    If Not (DOUT58 Is Nothing) Then
                        DOUT58.Value = KineticaRT.Values.Values.False
                    End If

                    If Not (MOPD_ENG_CHA_DELETE) Is Nothing Then
                        MOPD_ENG_CHA_DELETE.Value = KineticaRT.Values.Values.False
                    End If

                    If Not (MOPD_ENG_CHB_DELETE) Is Nothing Then
                        MOPD_ENG_CHB_DELETE.Value = KineticaRT.Values.Values.False
                    End If

                    If Not (MOT_CHA_DELETE) Is Nothing Then
                        MOT_CHA_DELETE.Value = KineticaRT.Values.Values.False
                    End If

                    If Not (MOT_CHB_DELETE) Is Nothing Then
                        MOT_CHB_DELETE.Value = KineticaRT.Values.Values.False
                    End If

                Case "PW308A ANC"
                    If Not (ARINC_L101_DEMAND Is Nothing) Then
                        ARINC_L101_DEMAND.Value = New KineticaRT.Values.Double("0")
                    End If

                    If Not (ARINC_L102_DEMAND Is Nothing) Then
                        ARINC_L102_DEMAND.Value = New KineticaRT.Values.Double("0")
                    End If

                    If Not (ARINC_L103_DEMAND Is Nothing) Then
                        ARINC_L103_DEMAND.Value = New KineticaRT.Values.Double("0")
                    End If

                    If Not (EEC_IGNITION_AUTO Is Nothing) Then
                        EEC_IGNITION_AUTO.Value = KineticaRT.Values.Values.True
                    End If

                    If Not (EEC_IGNITION_CONT Is Nothing) Then
                        EEC_IGNITION_CONT.Value = KineticaRT.Values.Values.False
                    End If

                    If Not (TT1_COUNT Is Nothing) Then
                        TT1_COUNT.Value = New KineticaRT.Values.Double("0")
                    End If

                    If Not (DOUT14 Is Nothing) Then
                        DOUT14.Value = KineticaRT.Values.Values.True
                    End If

                    If Not (DOUT64 Is Nothing) Then
                        DOUT64.Value = KineticaRT.Values.Values.True
                    End If

                    If Not (DOUT58 Is Nothing) Then
                        DOUT58.Value = KineticaRT.Values.Values.True
                    End If
                Case "PW308C ANC"
                    If Not (EEC_BIT_0 Is Nothing) Then
                        EEC_BIT_0.Value = KineticaRT.Values.Values.True
                    End If
                    If Not (EEC_BIT_1 Is Nothing) Then
                        EEC_BIT_1.Value = KineticaRT.Values.Values.True
                    End If
                    If Not (EEC_IGNITION_AUTO Is Nothing) Then
                        EEC_IGNITION_AUTO.Value = KineticaRT.Values.Values.True
                    End If
                    If Not (EEC_IGNITION_CONT Is Nothing) Then
                        EEC_IGNITION_CONT.Value = KineticaRT.Values.Values.False
                    End If
                    If Not (EEC_IGNITION_OFF Is Nothing) Then
                        EEC_IGNITION_OFF.Value = KineticaRT.Values.Values.False
                    End If
                    If Not (TT1_COUNT Is Nothing) Then
                        TT1_COUNT.Value = New KineticaRT.Values.Double("0")
                    End If

                    If Not (DOUT64 Is Nothing) Then
                        DOUT64.Value = KineticaRT.Values.Values.False
                    End If
                    If Not (EEC_LEFT_ENG_ID Is Nothing) Then
                        EEC_LEFT_ENG_ID.Value = KineticaRT.Values.Values.True
                    End If
                    If Not (DOUT14 Is Nothing) Then
                        DOUT14.Value = KineticaRT.Values.Values.False
                    End If

                    If Not (DOUT58 Is Nothing) Then
                        DOUT58.Value = KineticaRT.Values.Values.False
                    End If
            End Select
        End Sub


        '*************************
        '* MyBase.InitializeChannel()  *
        '*************************
        Private Function Initialize_Channel(ByRef Channel As Object, ByVal ChannelName As String) As Boolean
            Channel = GetChannel(ChannelName)
            If Channel Is Nothing Then
                MessageBox.Show("Initialize_Channel - " + ChannelName + " Is Nothing")
                Initialize_Channel = False
            Else
                Initialize_Channel = True
            End If
        End Function

