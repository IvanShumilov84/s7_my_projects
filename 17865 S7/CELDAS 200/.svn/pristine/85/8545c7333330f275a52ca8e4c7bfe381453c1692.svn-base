        Protected Overrides Sub Init_Engine_Controllers()

            Dim PersistentValuesChannels() As String = {"OPERATING_TIME_SEC", "FUEL_USED_INITIAL_LITERS", "FUEL_USED_TOTAL_LITERS", _
                                             "FUEL_COST_$_PER_LITER", "LABOR_COST_$_PER_HOUR", "FACILITY_COST_$_PER_HOUR", _
                                             "PERF_CONDITION_NUMBER"}

            Dim PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel.ToString & "\" & UserInputs.EngineSerialNumber & "\" & UserInputs.WorkOrder & "\Log\PersistentValues.xml"

            PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

            FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())

            ' Deletable Channels default value if not overridden by the project
            Dim RealNumberOfT1Probe As Integer = MaxNumberOfT1Probe
            Dim RealNumberOfT7Probe As Integer = MaxNumberOfT7Probe

            Select Case CELProject.Project.Number

                Case 14085

                    Dim ConfigPrefix As String = "//ConfigurationSettings/" & CELProject.EngineFamily & "/"
                    RealNumberOfT1Probe = CELProject.Project.ReadOneIntegerConfigItem(ConfigPrefix & "T_INLET_NUMBER_PROBE", 0)
                    RealNumberOfT7Probe = CELProject.Project.ReadOneIntegerConfigItem(ConfigPrefix & "T_EGT_NUMBER_PROBE", 0)

                Case Else
                    Debug.Assert(False, "OnTestSessionRunning: Code Missing for this project")

            End Select

            If RealNumberOfT1Probe > 0 Then
                DeletableT1ChCtrl = New DeletableChannelController(Me, RealNumberOfT1Probe, MaxNumberOfT1Probe, MaxNumberOfT1Probe, "T_T1_", "_DEGF", "_DELETE_BTN", "T_T1_AVG_DEGF", "T_T1_MIN_DEGF", "T_T1_MAX_DEGF", "T_T1_SPREAD_DEGF")
            End If

            If RealNumberOfT7Probe > 0 Then
                DeletableT7ChCtrl = New DeletableChannelController(Me, RealNumberOfT7Probe, MaxNumberOfT7Probe, MaxNumberOfT7Probe, "T_T7_", "_DEGF", "_DELETE_BTN", "T_T7_AVG_DEGF", "T_T7_MIN_DEGF", "T_T7_MAX_DEGF", "T_T7_SPREAD_DEGF")
            End If

            IgnitionMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "IGNITION1_CURRENT_AMP", "IGNITION1_CURRENT_AMP_MAX", "CRANK_START_DEMAND_OPC")
            IgnitionMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "IGNITION1_VOLTAGE_VDC", "IGNITION1_VOLTAGE_VDC_MAX", "CRANK_START_DEMAND_OPC")
            StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_CURRENT_AMP", "STARTER_CURRENT_AMP_MAX", "CRANK_START_DEMAND_OPC")
            StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_VOLTAGE_VDC", "STARTER_VOLTAGE_VDC_MAX", "CRANK_START_DEMAND_OPC")

            TimeToIdleTimerCtrl = New TimerController(Me, "TTI_TIME_START_CONDITION_LATCH", "TTI_TIME_STOP_CONDITION_LATCH", "TTI_TIME_CONDITION_RESET", "TTI_TIME_SEC", Nothing, 0, "NONE")
            TimeToLightTimerCtrl = New TimerController(Me, "TTL_TIME_START_CONDITION_LATCH", "TTL_TIME_STOP_CONDITION_LATCH", "TTL_TIME_CONDITION_RESET", "TTL_TIME_SEC", Nothing, 0, "NONE")
            RundownTimerCtrl = New TimerController(Me, "RDT_TIME_START_CONDITION_LATCH", "RDT_TIME_STOP_CONDITION_LATCH", "RDT_TIME_CONDITION_RESET", "RDT_TIME_SEC", Nothing, 0, "NONE")
            CrankTimerCtrl = New TimerController(Me, "CRANK_TIME_START_CONDITION_LATCH", "CRANK_TIME_STOP_CONDITION_LATCH", "CRANK_TIME_CONDITION_RESET", "CRANK_TIME_SEC", Nothing, 60, "CRANK_TIME_MAX_VALUE_REACHED")
            StarterTimerCtrl = New TimerController(Me, "STARTER_OVERCURRENT_START_CONDITION", "STARTER_OVERCURRENT_STOP_CONDITION", "STARTER_OVERCURRENT_CONDITION_RESET", "STARTER_OVERCURRENT_TIME_SEC", Nothing, 10, "STARTER_OVERCURRENT_MAX_VALUE_REACHED")
            OperatingTimerCtrl = New TimerController(Me, "OPERATING_TIME_START_CONDITION", "OPERATING_TIME_STOP_CONDITION", "OPERATING_TIME_CONDITION_RESET", "OPERATING_TIME_SEC", Nothing, 0, "NONE", True)

            If CELProject.HierarchyType = CELDAS.eHierarchyType.Master Then
                ExhaustFanCtrl = New ExhaustFanController(Me)
                ExhaustFanCtrl.StartWorkerThread(250)
                ExhaustFanCtrl.ExhaustFanProtectionControlTime = 40
                VibAGBMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_AGB_CMS", "VIB_AGB_CMS_PEAK_OPC", "VIB_AGB_CMS_PEAK_RESET")
                VibOutputShaftMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_OUTPUT_SHAFT_CMS", "VIB_OUTPUT_SHAFT_CMS_PEAK_OPC", "VIB_OUTPUT_SHAFT_CMS_PEAK_RESET")
                NGMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "NG_RPM", "NG_RPM_PEAK_OPC", "NG_RPM_PEAK_RESET")
                NPTMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "NPT_RPM", "NPT_RPM_PEAK_OPC", "NPT_RPM_PEAK_RESET")
                T5MaxTemperatureRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_T5_DEGF", "T_T5_DEGF_PEAK_OPC", "T_T5_DEGF_PEAK_RESET")
            End If

            If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then
                StatisticsCtrl = New StatisticsController(Me, "FUEL_COST_$_PER_LITER", "LABOR_COST_$_PER_HOUR", "FACILITY_COST_$_PER_HOUR", "OPERATING_TIME_HOURS", "HOURS", "FUEL_USED_TOTAL_LITERS", "LITER", "FUEL_COST_$", "LABOR_COST_$", "FACILITY_COST_$", "TOTAL_COST_$")
            End If

        End Sub

        Protected Overrides Sub Dispose_Engine_Controllers()

            'Persistent Values Force Save
            If Not (PersistentValuesCtrl Is Nothing) Then
                PersistentValuesCtrl.SavePersistentValues(True)
            End If

            If Not (DeletableT1ChCtrl Is Nothing) Then
                DeletableT1ChCtrl.Dispose()
            End If

            If Not (DeletableT7ChCtrl Is Nothing) Then
                DeletableT7ChCtrl.Dispose()
            End If

            If Not (IgnitionMaxCurrentRecordCtrl Is Nothing) Then
                IgnitionMaxCurrentRecordCtrl.Dispose()
            End If

            If Not (IgnitionMaxVoltageRecordCtrl Is Nothing) Then
                IgnitionMaxVoltageRecordCtrl.Dispose()
            End If

            If Not (StarterMaxCurrentRecordCtrl Is Nothing) Then
                StarterMaxCurrentRecordCtrl.Dispose()
            End If

            If Not (StarterMaxVoltageRecordCtrl Is Nothing) Then
                StarterMaxVoltageRecordCtrl.Dispose()
            End If

            If Not (T5MaxTemperatureRecordCtrl Is Nothing) Then
                T5MaxTemperatureRecordCtrl.Dispose()
            End If

            If Not (VibAGBMaxRecordCtrl Is Nothing) Then
                VibAGBMaxRecordCtrl.Dispose()
            End If

            If Not (VibOutputShaftMaxRecordCtrl Is Nothing) Then
                VibOutputShaftMaxRecordCtrl.Dispose()
            End If

            If Not (NGMaxRecordCtrl Is Nothing) Then
                NGMaxRecordCtrl.Dispose()
            End If

            If Not (NPTMaxRecordCtrl Is Nothing) Then
                NPTMaxRecordCtrl.Dispose()
            End If

            If Not (TimeToIdleTimerCtrl Is Nothing) Then
                TimeToIdleTimerCtrl.Dispose()
            End If

            If Not (TimeToLightTimerCtrl Is Nothing) Then
                TimeToLightTimerCtrl.Dispose()
            End If

            If Not (RundownTimerCtrl Is Nothing) Then
                RundownTimerCtrl.Dispose()
            End If

            If Not (CrankTimerCtrl Is Nothing) Then
                CrankTimerCtrl.Dispose()
            End If

            If Not (StarterTimerCtrl Is Nothing) Then
                StarterTimerCtrl.Dispose()
            End If

            If Not (OperatingTimerCtrl Is Nothing) Then
                OperatingTimerCtrl.Dispose()
            End If

            If Not (StatisticsCtrl Is Nothing) Then
                StatisticsCtrl.Dispose()
            End If

            If Not (PersistentValuesCtrl Is Nothing) Then
                PersistentValuesCtrl.Dispose()
            End If

            If Not (ExhaustFanCtrl Is Nothing) Then
                ExhaustFanCtrl.Dispose()
            End If

        End Sub

        Protected Overrides Sub OnCLOSE_TEST_BTN(sender As IChannel, newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    If CELProject.EngineModel.ToString() = "PT6C-67C" Then

                        CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.OnCLOSE_TEST_BTN_DISPOSE))

                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("OnClose_Test: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        '************************
        '* OnCloseTestDispose() *
        '************************
        Private Sub OnCLOSE_TEST_BTN_DISPOSE()
            Try

                MyBase.StopWorkingThread()
                RemoveHandlers()
                Dispose_Engine_Controllers()

            Catch ex As Exception
                MessageBox.Show("OnClose_Test_Dispose: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionClosing(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionClosing(newStatus)
                'For All Engine

            Catch ex As Exception
                MessageBox.Show("OnTestSessionClosing: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionIdling(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionIdling(newStatus)

            Catch ex As Exception
                MessageBox.Show("OnTestSessionIdling: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Function Init_Engine_Channels() As Boolean
            Dim Return_Value As New ArrayList()

            Return_Value.Clear()

            Try

                Return_Value.Add(MyBase.InitializeChannel(ARCHIVE_RECORD, "ARCHIVE_RECORD"))
                Return_Value.Add(MyBase.InitializeChannel(CLOSE_TEST_BTN_OPC, "CLOSE_TEST_BTN_OPC"))
                Return_Value.Add(MyBase.InitializeChannel(CRANK_START_DEMAND_OPC, "CRANK_START_DEMAND_OPC"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_POS_DEMAND, "DYNO_POS_DEMAND"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_REMOTE_CONTROL_IND, "DYNO_REMOTE_CONTROL_IND"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_SPEED_DEMAND, "DYNO_SPEED_DEMAND"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_SPEED_MODE_BTN, "DYNO_SPEED_MODE_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_SET_INLET_PCT, "DYNO_SET_INLET_PCT"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_TORQUE_DEMAND, "DYNO_TORQUE_DEMAND"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_VALVE_STATUS_IND, "DYNO_VALVE_STATUS_IND"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_CLOSE_WINDOW_BTN, "EEC_CLOSE_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_OPEN_WINDOW_BTN, "EEC_OPEN_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_COMM_BTN, "EEC_COMM_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_POWER_BTN, "EEC_POWER_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(ENGINE_AT_REST, "ENGINE_AT_REST"))
                Return_Value.Add(MyBase.InitializeChannel(FACILITY_CLOSE_WINDOW_BTN, "FACILITY_CLOSE_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(FACILITY_OPEN_WINDOW_BTN, "FACILITY_OPEN_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(FUEL_SOLENOIDS_BTN_OPC, "FUEL_SOLENOIDS_BTN_OPC"))
                Return_Value.Add(MyBase.InitializeChannel(FUEL_SOLENOIDS_BTN_PRESSED, "FUEL_SOLENOIDS_BTN_PRESSED"))
                Return_Value.Add(MyBase.InitializeChannel(FUEL_USED_INITIAL_LITERS, "FUEL_USED_INITIAL_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(FUEL_USED_TOTAL_LITERS, "FUEL_USED_TOTAL_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(FM_INITIAL_VOLUME_LITERS, "FM_INITIAL_VOLUME_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(FM_TOTAL_VOLUME_LITERS, "FM_TOTAL_VOLUME_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(T_T5_DEGF, "T_T5_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(T_T5_CURRENT_DEGF, "T_T5_CURRENT_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(NEW_TEST_BTN, "NEW_TEST_BTN"))

                Return_Value.Add(MyBase.InitializeChannel(UPS_ON_BATTERY_MAX_TIME_REACHED, "UPS_ON_BATTERY_MAX_TIME_REACHED"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_AUTOMODE_FLIGHT_BTN, "EEC_AUTOMODE_FLIGHT_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_AUTOMODE_IDLE_BTN, "EEC_AUTOMODE_IDLE_BTN"))

                Return_Value.Add(MyBase.InitializeChannel(CRANK_BTN, "CRANK_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(IGNITION1_BTN, "IGNITION1_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(IGNITION_AUTO_MANUAL_BTN, "IGNITION_AUTO_MANUAL_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_START_IGNITION_IND, "EEC_START_IGNITION_IND"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_MANUAL_MODE_IND, "EEC_MANUAL_MODE_IND"))
                Return_Value.Add(MyBase.InitializeChannel(READY_TO_START_IND, "READY_TO_START_IND"))

            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.Message)
                Return_Value.Add(False)
            Finally

            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function

