        Private Sub OnUPS_ON_BATTERY_MAX_TIME_REACHED(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If (UPS_ON_BATTERY_MAX_TIME_REACHED.Value = KineticaRT_TRUE) And (EEC_AUTOMODE_FLIGHT_BTN.Value = KineticaRT_TRUE) Then
                    EEC_AUTOMODE_IDLE_BTN.Value = KineticaRT_TRUE
                End If
            Catch Ex As Exception
                MessageBox.Show("OnUPS_ON_BATTERY_MAX_TIME_REACHED: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnDIAGNOSTIC_CLOSE_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    CELProject.ActivateForm("Diagnostic_Screen_Engine", "PT6C_Master_Screen", False, False)
                    'Reset Button
                    CELProject.DIAGNOSTIC_ENGINE_CLOSE_WINDOW_BTN.Value = KineticaRT.Values.Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("OnDIAGNOSTIC_CLOSE_WINDOW_BTN: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnDIAGNOSTIC_OPEN_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    CELProject.ActivateForm("Diagnostic_Screen_Engine", "PT6C_Master_Screen", True, False)
                    'Reset Button
                    CELProject.DIAGNOSTIC_ENGINE_OPEN_WINDOW_BTN.Value = KineticaRT.Values.Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("OnDIAGNOSTIC_OPEN_WINDOW_BTN: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnEEC_OPEN_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    CELProject.ActivateForm("PT6C_EEC_Screen", "PT6C_Master_Screen", True, False)
                    'Reset Button
                    EEC_OPEN_WINDOW_BTN.Value = KineticaRT.Values.Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("OnEEC_OPEN_WINDOW_BTN: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnEEC_CLOSE_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    CELProject.ActivateForm("PT6C_EEC_Screen", "PT6C_Master_Screen", False, False)
                    'Reset Button
                    EEC_CLOSE_WINDOW_BTN.Value = KineticaRT.Values.Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("OnEEC_CLOSE_WINDOW_BTN: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnEEC_START_IGNITION_IND(ByVal sender As IChannel, ByVal newVal As Value)
            Try

                Select Case EEC_START_IGNITION_IND.Value
                    Case KineticaRT_TRUE
                        'When EEC is in automatic mode and start/ignition signal is sent from EEC...
                        If READY_TO_START_IND.Value = KineticaRT_TRUE And EEC_MANUAL_MODE_IND.Value = KineticaRT_FALSE Then
                            'Press the crank button if READY_TO_START_IND is True
                            CRANK_BTN.Value = KineticaRT_TRUE
                            If IGNITION_AUTO_MANUAL_BTN.Value = KineticaRT_FALSE Then
                                'Also press ignition button if ignition mode is automatic
                                IGNITION1_BTN.Value = KineticaRT_TRUE
                            End If
                        End If

                    Case KineticaRT_FALSE
                        'When EEC is in automatic mode, unpress the crank button when start/ignition signal from eec is lost
                        If EEC_MANUAL_MODE_IND.Value = KineticaRT_FALSE Then
                            CRANK_BTN.Value = KineticaRT_FALSE
                            If IGNITION_AUTO_MANUAL_BTN.Value = KineticaRT_FALSE Then
                                'Also unpress the ignition button if in automatic mode
                                IGNITION1_BTN.Value = KineticaRT_FALSE
                            End If
                        End If
                End Select

            Catch Ex As Exception
                MessageBox.Show("OnEEC_START_IGNITION_IND: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnEEC_POWER_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            If CELProject.IsTrue(newVal) Then
                EEC_COMM_BTN.Value = KineticaRT_TRUE
            ElseIf CELProject.IsFalse(newVal) Then
                'Reset comm button if EEC power removed
                EEC_COMM_BTN.Value = KineticaRT_FALSE
            End If
        End Sub

