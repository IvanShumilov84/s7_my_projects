        Protected Overrides Sub OnCLOSE_TEST_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                        MyBase.StopWorkingThread()

                        PersistentValuesCtrl.SavePersistentValues(True)

                        RemoveHandlers()

                        Dispose_Engine_Controllers()




                        If TestProgressMgr IsNot Nothing Then
                            TestProgress_Save()
                            TestProgressMgr.Dispose()
                            TestProgressMgr = Nothing
                        End If



                        'Close the connection to the database
                        DatabaseHelper.CloseConnection(cnMain)

                        CELProject.CLOSE_TEST_BTN.Value = Values.False

                    End If

                End If

            Catch ex As Exception
                MessageBox.Show("OnClose_Test: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionInitialized(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionInitialized(newStatus)

                If CELProject.EngineFamily = "GTCP331-500" Then

                    UserInputsEpcor.MapUserInputsParameters(CELProject)

                    CELProject.EngineSession.WorkingFolder = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + UserInputsEpcor.EngineSerialNumber + "\" + UserInputsEpcor.WorkOrder
                    CELProject.CreateLogFile(AddressOf CreateCustomHeaderLogFile, CELProject.EngineModel, CELProject.EngineModel)


                    If Not DatabaseHelper.OpenConnection(CELProject.Database.OleDbConnectionString, cnMain, True) Then
                        'Close Test if unable to open connection to database
                        CELProject.Test_Mgr_Cmd.Value = New KineticaRT.Values.Text(CELDAS.eTest_Mgr_Cmd.Close)
                    End If

                End If
            Catch ex As Exception
                MessageBox.Show("OnTestSessionInitialized: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)

            Catch ex As Exception

                MessageBox.Show("GTCP331_500_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            End Try
        End Sub

        Protected Overrides Sub OnTestSessionRunning(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                MyBase.OnTestSessionRunning(newStatus)

                If CELProject.EngineFamily = "GTCP331-500" Then
                    Select Case CELProject.EngineModel
                        Case "GTCP331-500B"

                            Init_Arrays()
                            Init_Engine_Channels()
                            Init_Engine_Channels_Value()
                            CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.Init_Engine_Controls)) 'Must be after Init_Engine Channels

                            CELProject.LoadSave_Custom_Parameters(Custom_Parameters, False) 'Load some parameters value from database

                            CELProject.Perf_Nb_Sheet_To_Print = 3

                            Init_Engine_Controllers()

                            AddHandlers()

                    End Select

                    MyBase.StartWorkingThread()

                    TestProgress_Initialize()

                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionRunning: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub
        Protected Overrides Sub AddHandlers()

            AddHandler CELProject.PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
            AddHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnCLOSE_TEST_BTN
            AddHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            AddHandler CELProject.NEW_TEST_BTN.ValueChanged, AddressOf OnNEW_TEST_BTN
            AddHandler CELProject.PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
            AddHandler CELProject.PERF_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnPERF_OPEN_WINDOW_BTN
            AddHandler CELProject.PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN

            AddHandler CELProject.PERF_TEST_RESULT_ACCEPTED.ValueChanged, AddressOf OnPERFTestResultAcceptedCheckBox
            AddHandler CELProject.PERF_TEST_RESULT_REJECTED.ValueChanged, AddressOf OnPERFTestResultRejectedCheckBox

            AddHandler READY_TO_LOAD_IND.ValueChanged, AddressOf OnREADY_TO_LOAD_IND

            AddHandler cmbTestStepList.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged

        End Sub
        Protected Overrides Sub RemoveHandlers()

            RemoveHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnCLOSE_TEST_BTN
            RemoveHandler CELProject.PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
            RemoveHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            RemoveHandler CELProject.PERF_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnPERF_OPEN_WINDOW_BTN
            RemoveHandler CELProject.PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN
            RemoveHandler CELProject.NEW_TEST_BTN.ValueChanged, AddressOf OnNEW_TEST_BTN
            RemoveHandler CELProject.PERF_TEST_RESULT_ACCEPTED.ValueChanged, AddressOf OnPERFTestResultAcceptedCheckBox
            RemoveHandler CELProject.PERF_TEST_RESULT_REJECTED.ValueChanged, AddressOf OnPERFTestResultRejectedCheckBox

            RemoveHandler READY_TO_LOAD_IND.ValueChanged, AddressOf OnREADY_TO_LOAD_IND

            RemoveHandler cmbTestStepList.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged

        End Sub

        Protected Overrides Sub Init_Engine_Controllers()

            Dim PersistentValuesChannels() As String

            PersistentValuesChannels = {
                                "NUMBER_OF_STARTS",
                                "FUEL_USED_INITIAL_LITERS",
                                "FUEL_USED_TOTAL_LITERS",
                                "PERF_TEST_RESULT_ACCEPTED",
                                "PERF_TEST_RESULT_REJECTED",
                                "NG_RPM_MAX_PERSISTENT",
                                "NUMBER_OF_APU_FAULTS_SEEN_DURING_TEST",
                                "OPERATING_TIME_CURRENT_SEC",
                                "P_OIL_PSIG_MAX_PERSISTENT",
                                "VIB_GEARBOX_IPS_PEAK_MAX_PERSISTENT",
                                "VIB_TURBINE_IPS_PEAK_MAX_PERSISTENT",
                                "SCV_STABILITY_CHECK",
                                "CAPTURE_P_ATS_AIR_PRESSURE_PSIG",
                                "CAPTURE_T_ATS_AIR_TEMPERATURE_DEGF",
                                "CAPTURE_WBCDNA_PPM_CLOSE",
                                "CAPTURE_WBCDNA_PPM_HI_CLOSE",
                                "CAPTURE_WBCDNA_PPM_HI_OPEN",
                                "CAPTURE_WBCDNA_PPM_LO_OPEN",
                                "CAPTURE_WBCDNA_PPM_LO_CLOSE",
                                "CAPTURE_WBCDNA_PPM_OPEN"
                               }


            Dim PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputsEpcor.EngineSerialNumber & "\" & UserInputsEpcor.WorkOrder & "\Log\PersistentValues.xml"

            PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

            FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())
            FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())

            NumberOfTInletProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/GTCP331-500B/T_INLET_NUMBER_PROBE", 0)
            NumberOfTEgtProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/GTCP331-500B/T_EGT_NUMBER_PROBE", 0)
            NumberOfTBleedProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/GTCP331-500B/T_BLEED_NUMBER_PROBE", 0)

            DeletableTEgtChCtrl = New DeletableChannelController(Me, NumberOfTEgtProbe, MaxNumberOfTEgtProbe, 5, "T_EGT", "_DEGF", "_DELETE_BTN", "T_EGT_DEGF_AVG", "T_EGT_DEGF_MIN", "T_EGT_DEGF_MAX", "T_EGT_DEGFD_SPREAD")
            DeletableTInletChCtrl = New DeletableChannelController(Me, NumberOfTInletProbe, MaxNumberOfTInletProbe, 5, "T_INLET", "_DEGF", "_DELETE_BTN", "T_INLET_DEGF_AVG", "T_INLET_DEGF_MIN", "T_INLET_DEGF_MAX", "T_INLET_DEGFD_SPREAD")

            StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_CURRENT_AMP", "STARTER_CURRENT_AMP_MAX", "START_BTN")
            StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_VOLTAGE_VDC", "STARTER_VOLTAGE_VDC_MAX", "START_BTN")


            FlowmeterCtrl = New FlowmeterController(Me)

            'Configuring Load Bank Control
            Dim myLBData As LoadBankController.LB_DataInfo = Nothing

            myLBData.FanEnableBtnChannelName = "LB1_FAN_ENABLE_BTN"
            myLBData.FanEnableChannelName = "LB1_FAN_ENABLE_CMD"
            myLBData.EnableChannelName = "LB_LOAD_BTN"
            myLBData.InitialDemandChannelName = "LB1_INITIAL_DEMAND"
            myLBData.DemandChannelName = "LB1_DEMAND"
            myLBData.UpDemandChannelName = "LB1_UP_DEMAND_BTN"
            myLBData.DownDemandChannelName = "LB1_DOWN_DEMAND_BTN"
            myLBData.DemandChannelIncrementName = "LB1_DEMAND_INCREMENT"
            myLBData.FrameName = "GTCP331_500_Screen.fraControlSystem.fraLoadBankControl" 'TODO utiler le search control
            myLBData.DisplayName = "dspLB_DEMAND"

            myLBData.ThreadSpeedMsec = 250 'msec
            myLBData.Maximum = 150
            myLBData.DelestageKwpersec = 10 'instant delestage
            myLBData.FanCoolDownSeconds = 300
            myLBData.Memorize = False
            myLBData.Increment = 1
            myLBData.BtnLatchSeconds = 0
            myLBData.FanEnableChannelPulseName = Nothing
            myLBData.FanStopChannelPulseName = Nothing
            myLBData.PulseEnableInitialType = False
            myLBData.PulseStopInitialType = False

            Select Case CELProject.Project.Number

                Case 12958
                    myLBData.FieldFlashingTimeMsec = 0 ' 1000
                    myLBData.FieldFlashingSignalName = Nothing '"FIELD_FLASHING"
                    myLBData.FieldFlashingTriggerSignalName = "LB_GCU_BTN"

                    LoadBankCtrl = New LoadBankController(myLBData)

                    'Configuring Load Bank Stage Values, maximum allowed is 150 kW, define only required stage
                    LoadBankCtrl.AddStage(1, "LB1_1")
                    LoadBankCtrl.AddStage(1, "LB1_2")
                    LoadBankCtrl.AddStage(2, "LB1_3")
                    LoadBankCtrl.AddStage(4, "LB1_4")
                    LoadBankCtrl.AddStage(8, "LB1_5")
                    LoadBankCtrl.AddStage(15, "LB1_6")
                    LoadBankCtrl.AddStage(25, "LB1_7")
                    LoadBankCtrl.AddStage(50, "LB1_8")
                    LoadBankCtrl.AddStage(100, "LB1_9")
                    LoadBankCtrl.AddCurrentPhases("LB1_CURRENT_IA", "LB1_CURRENT_IB", "LB1_CURRENT_IC", 20)
                    LoadBankCtrl.AddVoltagePhases("LB1_VOLTAGE_VAB", "LB1_VOLTAGE_VBC", "LB1_VOLTAGE_VCA", 20)
                    LoadBankCtrl.StartWorkerThread(250)


                Case Else
                    Debug.Assert(False, "OnTestSessionRunning: Code Missing for this project in")

            End Select

        End Sub
        Protected Overrides Sub Dispose_Engine_Controllers()

            If Not (DeletableTEgtChCtrl Is Nothing) Then
                DeletableTEgtChCtrl.Dispose()
            End If
            If Not (DeletableTInletChCtrl Is Nothing) Then
                DeletableTInletChCtrl.Dispose()
            End If
            If Not (PersistentValuesCtrl Is Nothing) Then
                PersistentValuesCtrl.Dispose()
            End If
            If Not (LoadBankCtrl Is Nothing) Then
                LoadBankCtrl.Dispose()
            End If
            If Not (FlowmeterCtrl Is Nothing) Then
                FlowmeterCtrl.Dispose()
            End If
            If Not (StarterMaxCurrentRecordCtrl Is Nothing) Then
                StarterMaxCurrentRecordCtrl.Dispose()
            End If
            If Not (StarterMaxVoltageRecordCtrl Is Nothing) Then
                StarterMaxVoltageRecordCtrl.Dispose()
            End If

        End Sub

        Protected Overrides Sub OnTestSessionClosing(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                MyBase.OnTestSessionClosing(newStatus)

                If CELProject.EngineFamily = "GTCP331-500" Then

                    Dispose_Engine_Controllers()

                    DatabaseHelper.CloseConnection(cnMain)

                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionClosing: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Function Init_Engine_Channels() As Boolean

            Dim Return_Value As New ArrayList()

            Return_Value.Clear()

            Try

                'Initialise Engine Channels
                Select Case CELProject.EngineFamily

                    Case "GTCP331-500"


                        Return_Value.Add(MyBase.InitializeObject(frmMasterEngineWindow, "GTCP331_500_Screen"))

                        frmMasterEngineWindow.WindowState = FormWindowState.Normal
                        frmMasterEngineWindow.Left = 0
                        frmMasterEngineWindow.Top = 0

                        Dim hmiWindow As Object = MyBase.GetObject("GTCP331_500_Screen")

                        cmbTestStepList = CELProject.SearchControl(hmiWindow, "TestStep_List")
                        Debug.Assert(Not IsNothing(cmbTestStepList), "Control TestStep_List Is Nothing")


                        'Boolean Signals
                        Return_Value.Add(MyBase.InitializeChannel(APU_OPERATING, "APU_OPERATING"))

                        Return_Value.Add(MyBase.InitializeChannel(BLEED_BTN, "BLEED_BTN"))

                        Return_Value.Add(MyBase.InitializeChannel(CAPTURE_ATS_BTN, "CAPTURE_ATS_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(CAPTURE_WBCDNA_CLOSE_BTN, "CAPTURE_WBCDNA_CLOSE_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(CAPTURE_WBCDNA_OPEN_BTN, "CAPTURE_WBCDNA_OPEN_BTN"))

                        Return_Value.Add(MyBase.InitializeChannel(INLET_FLAP_CLOSE_IND, "INLET_FLAP_CLOSE_IND"))
                        Return_Value.Add(MyBase.InitializeChannel(INLET_FLAP_MOVE_IND, "INLET_FLAP_MOVE_IND"))
                        Return_Value.Add(MyBase.InitializeChannel(INLET_FLAP_OPEN_CMD, "INLET_FLAP_OPEN_CMD"))

                        Return_Value.Add(MyBase.InitializeChannel(RUN_STOP_BTN, "RUN_STOP_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(READY_TO_LOAD_IND, "READY_TO_LOAD_IND"))

                        Return_Value.Add(MyBase.InitializeChannel(START_BTN, "START_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(SCV_STABILITY_CHECK, "SCV_STABILITY_CHECK"))


                        'Numeric Signals
