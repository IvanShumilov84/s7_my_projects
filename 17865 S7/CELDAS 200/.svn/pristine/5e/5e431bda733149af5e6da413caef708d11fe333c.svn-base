        Public Class UserInputEpcorGTCP331_500

            'Question
            Public EngineSerialNumber As String = ""
            Public WorkOrder As String = ""
            Public EnginePartNumber As String = ""
            Public SampleFuelSG As String = ""
            Public SampleFuelTemperature As String = ""
            Public LowHeatingValue As String = ""
            Public OilType As String = ""
            Public FuelType As String = ""
            Public CustomerName As String = ""

            'Choice
            Public TestType As String = ""
            Public OperatorName As String = ""
            Public InspectorName As String = ""
            Public RepairType As String = ""


            ' Allow friend access to the empty constructor.
            Friend Sub New()

            End Sub

            Public Sub MapUserInputsParameters(ByRef CELProject As CELDAS)

                EngineSerialNumber = CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
                WorkOrder = CELProject.Test_Mgr_UUT_Answer(1).Value.ToString()
                EnginePartNumber = CELProject.Test_Mgr_UUT_Answer(2).Value.ToString()
                LowHeatingValue = CELProject.Test_Mgr_UUT_Answer(3).Value.ToString()
                SampleFuelSG = CELProject.Test_Mgr_UUT_Answer(4).Value.ToString()
                SampleFuelTemperature = CELProject.Test_Mgr_UUT_Answer(5).Value.ToString()
                OilType = CELProject.Test_Mgr_UUT_Answer(6).Value.ToString()
                FuelType = CELProject.Test_Mgr_UUT_Answer(7).Value.ToString()
                CustomerName = CELProject.Test_Mgr_UUT_Answer(8).Value.ToString()

                'Choice
                TestType = CELProject.Test_Mgr_UUT_Choice(0).Value.ToString()
                OperatorName = CELProject.Test_Mgr_UUT_Choice(1).Value.ToString()
                InspectorName = CELProject.Test_Mgr_UUT_Choice(2).Value.ToString()
                RepairType = CELProject.Test_Mgr_UUT_Choice(3).Value.ToString()
                CELProject.REPAIR_TYPE.Value = New KineticaRT.Values.Text(CELProject.Test_Mgr_UUT_Choice(3).Value.ToString())

            End Sub

        End Class


        Public Function Compute_BleedAirFlow1(TOrifice_DEGF As Double, POrifice_PSIA As Double, POrificeDelta_PSID As Double) As Double Implements IBleedAirFlowCalculation.Compute_BleedAirFlow

