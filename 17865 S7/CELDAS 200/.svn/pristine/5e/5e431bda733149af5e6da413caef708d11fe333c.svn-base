    Public Class GTCP331_500_Sequence
        Inherits ApuSequence
        Implements IBleedAirFlowCalculation

        'Les constantes isont lu a partir du fichier celdas_12917.cfg
        Private NumberOfTInletProbe As Integer = 10
        Private NumberOfTEgtProbe As Integer = 15
        Private NumberOfTBleedProbe As Integer = 2

        Private Const MaxNumberOfTInletProbe As Integer = 10
        Private Const MaxNumberOfTEgtProbe As Integer = 15
        Private Const MaxNumberOfTBleedProbe As Integer = 2

        Private Enum eTestStepGTCP331_500B
            FLOW_SENSOR = 0
            SCV_STAB = 1
            ECS = 2
            NO_LOAD = 3
            MES = 4
            ELEC_START = 5
            AIR_START = 6
            OP_TIME = 7
        End Enum

        Protected Overrides Sub Compute(ByVal CalulateForLogAndPerformanceReports As Boolean)

            Try
                If CalulateForLogAndPerformanceReports Then

                    'Update the Log/Perf channel set
                    CELProject.LogPerfSynch.UpdateValues()

                    LOG_PERF_WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(LOG_PERF_T_ORIFICE_DEGF.Value.ToDouble(), _
                                                                                               LOG_PERF_P_ORIFICE_PSIA.Value.ToDouble(), _
                                                                                              LOG_PERF_P_ORIFICE_DELTA_PSID.Value.ToDouble))

                    Compute_GTCP331_500B_Perf(LOG_PERF_T_INLET_DEGF_AVG, _
                                             LOG_PERF_PB_COR1_PSIA, _
                                             LOG_PERF_GEN_COR_KW)

                    FlowmeterCtrl.ComputeFlow(True)

                    'IMPORTANT: Toutes les variables flottantes telles que WB_CALC_PPM dont la source et la destination sont vides doivent
                    'manuellement être updaté pour être inscrite dans le LOG ou le PERF report.
                Else

                    WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(T_ORIFICE_DEGF.Value.ToDouble(), _
                                                                                      P_ORIFICE_PSIA.Value.ToDouble(), _
                                                                                      P_ORIFICE_DELTA_PSID.Value.ToDouble))

                    Compute_GTCP331_500B_Default(T_INLET_DEGF_AVG, _
                                             PB_COR1_PSIA, _
                                             GEN_COR_KW)

                    'FlowmeterCtrl.ComputeFlow() pas neccesaire le thread s'occupe deja de le faire

                End If

            Catch ex As Exception
                MessageBox.Show("Compute_GTCP331_500B" + ex.ToString(), "Error")
            End Try

        End Sub

        Private Sub Compute_GTCP331_500B_Default(ByRef tinlet_avg_degf As IChannel, _
                                              ByRef pbcor1 As IChannel, _
                                              ByRef gencor As IChannel)
            Try
                Select Case CELProject.PERF_TEST_STEP_NB.Value.ToDouble()

                    Case eTestStepGTCP331_500B.NO_LOAD, eTestStepGTCP331_500B.ELEC_START, eTestStepGTCP331_500B.AIR_START, eTestStepGTCP331_500B.OP_TIME
                        DELTA_WB.Value = Me.KineticaRT_NAN
                        DELTA_PB.Value = Me.KineticaRT_NAN
                        DELTA_TB.Value = Me.KineticaRT_NAN
                        DELTA_WF.Value = Me.KineticaRT_NAN
                        DELTA_EGT.Value = Me.KineticaRT_NAN

                        DELTA_WB_EXC.Value = Me.KineticaRT_NAN
                        DELTA_PB_EXC.Value = Me.KineticaRT_NAN
                        DELTA_TB_EXC.Value = Me.KineticaRT_NAN
                        DELTA_WF_EXC.Value = Me.KineticaRT_NAN
                        DELTA_EGT_EXC.Value = Me.KineticaRT_NAN

                        PBSET_COR_PSIA.Value = Me.KineticaRT_NAN
                        SHP_COR_SHP.Value = New KineticaRT.Values.Text("NaN")

                        WBCDNA_PPM_LO_LIM.Value = Me.KineticaRT_NAN
                        WBCDNA_PPM_HI_LIM.Value = Me.KineticaRT_NAN

                    Case eTestStepGTCP331_500B.FLOW_SENSOR, eTestStepGTCP331_500B.SCV_STAB

                        DELTA_WB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 1)
                        DELTA_PB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 2)
                        DELTA_TB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 3)
                        DELTA_WF.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 4)
                        DELTA_EGT.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 5)

                        DELTA_WB_EXC.Value = New KineticaRT.Values.Double(0.0)
                        DELTA_PB_EXC.Value = New KineticaRT.Values.Double(0.0)
                        DELTA_TB_EXC.Value = New KineticaRT.Values.Double(0.0)
                        DELTA_WF_EXC.Value = New KineticaRT.Values.Double(0.0)
                        DELTA_EGT_EXC.Value = New KineticaRT.Values.Double(0.0)

                        PBSET_COR_PSIA.Value = CELProject.Interpolate_1D(T_INLET_DEGF_AVG.Value.ToDouble, GTCP331_500B_PBSETCOR, 1)

                        If gencor.Value.ToString = "NaN" Then
                            SHP_COR_SHP.Value = New KineticaRT.Values.Text("NaN")
                        Else
                            SHP_COR_SHP.Value = CELProject.Interpolate_1D(gencor.Value.ToDouble, GTCP331_500B_GEN, 1)
                        End If

                        WBCDNA_PPM_LO_LIM.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_WBCDNA_LO_LIMIT, 1)
                        WBCDNA_PPM_HI_LIM.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_WBCDNA_HI_LIMIT, 1)

                    Case eTestStepGTCP331_500B.ECS

                        DELTA_WB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 1)
                        DELTA_PB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 2)
                        DELTA_TB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 3)
                        DELTA_WF.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 4)
                        DELTA_EGT.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 5)

                        DELTA_WB_EXC.Value = New KineticaRT.Values.Double(0.0)
                        DELTA_PB_EXC.Value = New KineticaRT.Values.Double(0.0)
                        DELTA_TB_EXC.Value = New KineticaRT.Values.Double(0.0)
                        DELTA_WF_EXC.Value = New KineticaRT.Values.Double(0.0)
                        DELTA_EGT_EXC.Value = New KineticaRT.Values.Double(0.0)

                        PBSET_COR_PSIA.Value = CELProject.Interpolate_1D(T_INLET_DEGF_AVG.Value.ToDouble, GTCP331_500B_PBSETCOR, 1)

                        If gencor.Value.ToString = "NaN" Then
                            SHP_COR_SHP.Value = New KineticaRT.Values.Text("NaN")
                        Else
                            SHP_COR_SHP.Value = CELProject.Interpolate_1D(gencor.Value.ToDouble, GTCP331_500B_GEN, 1)
                        End If

                        WBCDNA_PPM_LO_LIM.Value = New KineticaRT.Values.Double(165)
                        WBCDNA_PPM_HI_LIM.Value = New KineticaRT.Values.Double(169)

                    Case eTestStepGTCP331_500B.MES

                        DELTA_WB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_MES, 1)
                        DELTA_PB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_MES, 2)
                        DELTA_TB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_MES, 3)
                        DELTA_WF.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_MES, 4)
                        DELTA_EGT.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_MES, 5)

                        DELTA_WB_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_500B_EBP, 1)
                        DELTA_PB_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_500B_EBP, 2)
                        DELTA_TB_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_500B_EBP, 3)
                        DELTA_WF_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_500B_EBP, 4)
                        DELTA_EGT_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_500B_EBP, 5)

                        PBSET_COR_PSIA.Value = Me.KineticaRT_NAN

                        If gencor.Value.ToString() = "NaN" Then
                            SHP_COR_SHP.Value = New KineticaRT.Values.Text("NaN")
                        Else
                            SHP_COR_SHP.Value = CELProject.Interpolate_1D(gencor.Value.ToDouble, GTCP331_500B_GEN, 1)
                        End If

                        WBCDNA_PPM_LO_LIM.Value = New KineticaRT.Values.Double(104)
                        WBCDNA_PPM_HI_LIM.Value = New KineticaRT.Values.Double(108)

                End Select



            Catch Ex As Exception
                MessageBox.Show("Compute_GTCP331_500B_Perf: " & Ex.Message)
            Finally
            End Try

        End Sub

        Private Sub Compute_GTCP331_500B_Perf(ByRef tinlet_avg_degf As IChannel, _
                                              ByRef pbcor1 As IChannel, _
                                              ByRef gencor As IChannel)
            Try
                Select Case CELProject.PERF_TEST_STEP_NB.Value.ToDouble()

                    Case eTestStepGTCP331_500B.NO_LOAD, eTestStepGTCP331_500B.ELEC_START, eTestStepGTCP331_500B.AIR_START, eTestStepGTCP331_500B.OP_TIME
                        LOG_PERF_DELTA_WB.Value = Me.KineticaRT_NAN
                        LOG_PERF_DELTA_PB.Value = Me.KineticaRT_NAN
                        LOG_PERF_DELTA_TB.Value = Me.KineticaRT_NAN
                        LOG_PERF_DELTA_WF.Value = Me.KineticaRT_NAN
                        LOG_PERF_DELTA_EGT.Value = Me.KineticaRT_NAN

                        LOG_PERF_DELTA_WB_EXC.Value = Me.KineticaRT_NAN
                        LOG_PERF_DELTA_PB_EXC.Value = Me.KineticaRT_NAN
                        LOG_PERF_DELTA_TB_EXC.Value = Me.KineticaRT_NAN
                        LOG_PERF_DELTA_WF_EXC.Value = Me.KineticaRT_NAN
                        LOG_PERF_DELTA_EGT_EXC.Value = Me.KineticaRT_NAN

                        LOG_PERF_PBSET_COR_PSIA.Value = Me.KineticaRT_NAN
                        LOG_PERF_SHP_COR_SHP.Value = New KineticaRT.Values.Text("NaN")

                        LOG_PERF_WBCDNA_PPM_LO_LIM.Value = Me.KineticaRT_NAN
                        LOG_PERF_WBCDNA_PPM_HI_LIM.Value = Me.KineticaRT_NAN

                    Case eTestStepGTCP331_500B.FLOW_SENSOR, eTestStepGTCP331_500B.SCV_STAB,
                        LOG_PERF_DELTA_WB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 1)
                        LOG_PERF_DELTA_PB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 2)
                        LOG_PERF_DELTA_TB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 3)
                        LOG_PERF_DELTA_WF.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 4)
                        LOG_PERF_DELTA_EGT.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 5)

                        LOG_PERF_DELTA_WB_EXC.Value = New KineticaRT.Values.Double(0.0)
                        LOG_PERF_DELTA_PB_EXC.Value = New KineticaRT.Values.Double(0.0)
                        LOG_PERF_DELTA_TB_EXC.Value = New KineticaRT.Values.Double(0.0)
                        LOG_PERF_DELTA_WF_EXC.Value = New KineticaRT.Values.Double(0.0)
                        LOG_PERF_DELTA_EGT_EXC.Value = New KineticaRT.Values.Double(0.0)

                        LOG_PERF_PBSET_COR_PSIA.Value = CELProject.Interpolate_1D(T_INLET_DEGF_AVG.Value.ToDouble, GTCP331_500B_PBSETCOR, 1)

                        If gencor.Value.ToString = "NaN" Then
                            LOG_PERF_SHP_COR_SHP.Value = New KineticaRT.Values.Text("NaN")
                        Else
                            LOG_PERF_SHP_COR_SHP.Value = CELProject.Interpolate_1D(gencor.Value.ToDouble, GTCP331_500B_GEN, 1)
                        End If

                        LOG_PERF_WBCDNA_PPM_LO_LIM.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_WBCDNA_LO_LIMIT, 1)
                        LOG_PERF_WBCDNA_PPM_HI_LIM.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_WBCDNA_HI_LIMIT, 1)

                    Case eTestStepGTCP331_500B.ECS

                        LOG_PERF_DELTA_WB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 1)
                        LOG_PERF_DELTA_PB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 2)
                        LOG_PERF_DELTA_TB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 3)
                        LOG_PERF_DELTA_WF.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 4)
                        LOG_PERF_DELTA_EGT.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_ECS, 5)

                        LOG_PERF_DELTA_WB_EXC.Value = New KineticaRT.Values.Double(0.0)
                        LOG_PERF_DELTA_PB_EXC.Value = New KineticaRT.Values.Double(0.0)
                        LOG_PERF_DELTA_TB_EXC.Value = New KineticaRT.Values.Double(0.0)
                        LOG_PERF_DELTA_WF_EXC.Value = New KineticaRT.Values.Double(0.0)
                        LOG_PERF_DELTA_EGT_EXC.Value = New KineticaRT.Values.Double(0.0)

                        LOG_PERF_PBSET_COR_PSIA.Value = CELProject.Interpolate_1D(T_INLET_DEGF_AVG.Value.ToDouble, GTCP331_500B_PBSETCOR, 1)

                        If gencor.Value.ToString = "NaN" Then
                            LOG_PERF_SHP_COR_SHP.Value = New KineticaRT.Values.Text("NaN")
                        Else
                            LOG_PERF_SHP_COR_SHP.Value = CELProject.Interpolate_1D(gencor.Value.ToDouble, GTCP331_500B_GEN, 1)
                        End If

                        LOG_PERF_WBCDNA_PPM_LO_LIM.Value = New KineticaRT.Values.Double(165)
                        LOG_PERF_WBCDNA_PPM_HI_LIM.Value = New KineticaRT.Values.Double(169)

                    Case eTestStepGTCP331_500B.MES

                        LOG_PERF_DELTA_WB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_MES, 1)
                        LOG_PERF_DELTA_PB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_MES, 2)
                        LOG_PERF_DELTA_TB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_MES, 3)
                        LOG_PERF_DELTA_WF.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_MES, 4)
                        LOG_PERF_DELTA_EGT.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_500B_MES, 5)

                        LOG_PERF_DELTA_WB_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_500B_EBP, 1)
                        LOG_PERF_DELTA_PB_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_500B_EBP, 2)
                        LOG_PERF_DELTA_TB_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_500B_EBP, 3)
                        LOG_PERF_DELTA_WF_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_500B_EBP, 4)
                        LOG_PERF_DELTA_EGT_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_500B_EBP, 5)

                        LOG_PERF_PBSET_COR_PSIA.Value = Me.KineticaRT_NAN

                        If gencor.Value.ToString() = "NaN" Then
                            LOG_PERF_SHP_COR_SHP.Value = New KineticaRT.Values.Text("NaN")
                        Else
                            LOG_PERF_SHP_COR_SHP.Value = CELProject.Interpolate_1D(gencor.Value.ToDouble, GTCP331_500B_GEN, 1)
                        End If

                        LOG_PERF_WBCDNA_PPM_LO_LIM.Value = New KineticaRT.Values.Double(104)
                        LOG_PERF_WBCDNA_PPM_HI_LIM.Value = New KineticaRT.Values.Double(108)

                End Select

            Catch Ex As Exception
                MessageBox.Show("Compute_GTCP331_500B_Perf: " & Ex.Message)
            Finally
            End Try

        End Sub

        Protected Overrides Function CreateCustomHeaderLogFile(ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Try
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Date Time:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Cond#:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Comment:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                ExcelWorksheet.Rows(RowIndex).RowHeight = 65.25
                ExcelWorksheet.Rows(RowIndex).VerticalAlignment = Excel.XlVAlign.xlVAlignTop
                ExcelWorksheet.Rows(RowIndex).WrapText = True

                Return True

            Catch ex As Exception
                MessageBox.Show("CreateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        Protected Overrides Function UpdateCustomHeaderLogFile(ByVal AppendOption As Boolean, ByVal IsPerfEntry As Boolean, ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Try
                Dim Log_Condition As Integer

                If AppendOption = False Then
                    Log_Condition = 1
                Else
                    Log_Condition = ExcelWorksheet.Cells(RowIndex + 1, ExcelWorksheet.Columns.Count).End(Excel.XlDirection.xlToLeft).Column - 1
                    Log_Condition = Log_Condition + 1

                End If

                If ((Log_Condition > 1) And ((Log_Condition Mod 5) = 1)) Then

                    'Repeat The Test Spec For this new sets of condition

                    With ExcelWorksheet
                        .Range(.Cells(2, 2), .Cells(RowIndex - 2, 6)).Copy(.Cells(2, Log_Condition + 1))
                    End With
                End If

                ColumnIndex = 1 + Log_Condition

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Format(Now, "yyyy/MM/dd HH:mm:ss")
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Log_Condition.ToString()
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                If IsPerfEntry = False Then
                    Dim CommentText As String = ""
                    Dim InputObject As New InputCommentForm
                    InputObject.ShowDialog("Log Report", "Comment:", "", CommentText)

                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = CommentText
                Else
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "STEP: " & cmbTestStepList.SelectedItem
                End If

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 2
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Values"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignCenter

            Catch ex As Exception
                MessageBox.Show("UpdateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        Private Function CreateEPCOR12958PerformanceFile(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean

            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreateEPCOR12958PerformanceFile = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            Try
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                'Overwrite data each time

                excelWorksheet = excelSheets.Item("SUMMARY")

                If AppendOption = False Then

                    excelWorksheet = excelSheets.Item("SUMMARY")
                    'Customer
                    excelWorksheet.Cells(5, 3).NumberFormat = "@"
                    excelWorksheet.Cells(5, 3).Value = UserInputsEpcor.CustomerName
                    'Work Order
                    excelWorksheet.Cells(6, 3).NumberFormat = "@"
                    excelWorksheet.Cells(6, 3).Value = UserInputsEpcor.WorkOrder
                    'Engine P/N
                    excelWorksheet.Cells(7, 3).NumberFormat = "@"
                    excelWorksheet.Cells(7, 3).Value = UserInputsEpcor.EnginePartNumber
                    'Engine S/N
                    excelWorksheet.Cells(8, 3).NumberFormat = "@"
                    excelWorksheet.Cells(8, 3).Value = UserInputsEpcor.EngineSerialNumber
                    'Oil Type
                    excelWorksheet.Cells(9, 3).NumberFormat = "@"
                    excelWorksheet.Cells(9, 3).Value = UserInputsEpcor.OilType
                    'Tester
                    excelWorksheet.Cells(10, 3).NumberFormat = "@"
                    excelWorksheet.Cells(10, 3).Value = UserInputsEpcor.InspectorName
                    'Date
                    excelWorksheet.Cells(5, 8).NumberFormat = "@"
                    excelWorksheet.Cells(5, 8).Value = Format(Now, "MMM dd, yyyy")
                    'Fuel SG
                    excelWorksheet.Cells(6, 8).NumberFormat = "@"
                    excelWorksheet.Cells(6, 8).Value = UserInputsEpcor.SampleFuelSG
                    'T Fuel
                    excelWorksheet.Cells(7, 8).NumberFormat = "@"
                    excelWorksheet.Cells(7, 8).Value = UserInputsEpcor.SampleFuelTemperature
                    'Fuel Type
                    excelWorksheet.Cells(8, 8).NumberFormat = "@"
                    excelWorksheet.Cells(8, 8).Value = UserInputsEpcor.FuelType
                    'Oil Type
                    excelWorksheet.Cells(9, 8).NumberFormat = "@"
                    excelWorksheet.Cells(9, 8).Value = UserInputsEpcor.OilType


                    excelWorksheet = excelSheets.Item("ACCEPTANCE")
                    excelWorksheet.Cells(47, 1).NumberFormat = "@"
                    excelWorksheet.Cells(47, 1).Value = excelWorksheet.Cells(47, 1).Value.ToString() + Custom_Parameters("APUTestedAccordingTo").ToString()

                End If

                ' PERFORMED TEST DETAILS section

                excelWorksheet = excelSheets.Item("SUMMARY")

                excelWorksheet.Cells(41, 8).Value = APU_DRY_WEIGHT.Value.ToString()
                excelWorksheet.Cells(42, 8).Value = NUMBER_OF_STARTS.Value.ToString()
                excelWorksheet.Cells(44, 8).Value = NUMBER_OF_APU_FAULTS_SEEN_DURING_TEST.Value.ToString()

                Select Case CELProject.PERF_TEST_STEP_NB.Value.ToDouble

                    Case eTestStepGTCP331_500B.FLOW_SENSOR
                        ' FLOW SENSOR TEST section

                        excelWorksheet = excelSheets.Item("SUMMARY")

                        excelWorksheet.Cells(25, 7).Value = CAPTURE_WBCDNA_PPM_LO_OPEN.Value.ToString(CAPTURE_WBCDNA_PPM_LO_OPEN.Format, Nothing)
