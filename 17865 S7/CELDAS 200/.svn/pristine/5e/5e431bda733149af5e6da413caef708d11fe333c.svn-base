                        excelWorksheet.Cells(36, 8).Value = ET_ELECTRICAL_START_TIME_SEC.Value.ToString(ET_ELECTRICAL_START_TIME_SEC.Format, Nothing)

                    Case eTestStepGTCP331_500B.AIR_START
                        ' PERFORMED TEST DETAILS section

                        excelWorksheet = excelSheets.Item("SUMMARY")

                        excelWorksheet.Cells(37, 8).Value = ET_ATS_STARTER_CUTOUT_TIME_SEC.Value.ToString(ET_ATS_STARTER_CUTOUT_TIME_SEC.Format, Nothing)
                        excelWorksheet.Cells(38, 8).Value = ET_ATS_START_TIME_SEC.Value.ToString(ET_ATS_START_TIME_SEC.Format, Nothing)
                        excelWorksheet.Cells(39, 8).Value = CAPTURE_P_ATS_AIR_PRESSURE_PSIG.Value.ToString(CAPTURE_P_ATS_AIR_PRESSURE_PSIG.Format, Nothing)
                        excelWorksheet.Cells(40, 8).Value = CAPTURE_T_ATS_AIR_TEMPERATURE_DEGF.Value.ToString(CAPTURE_T_ATS_AIR_TEMPERATURE_DEGF.Format, Nothing)

                    Case eTestStepGTCP331_500B.OP_TIME
                        ' PERFORMED TEST DETAILS section

                        excelWorksheet = excelSheets.Item("SUMMARY")

                        excelWorksheet.Cells(43, 8).Value = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToString()
                End Select

                TestProgress_RecordPerfStep(TestStepNumber)

                excelWorksheet = excelSheets.Item("ACCEPTANCE")

                'Test Result
                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                End If

                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                End If

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile500B: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreateEPCOR12958PerformanceFile = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)

            End Try


        End Function

        Protected Overrides Sub Init_Engine_Channels_Value()

            CELProject.PERF_TEST_STEP_NB.Value = Values.Zero

            APU_DRY_WEIGHT.Value = Values.Zero
            ET_ATS_STARTER_CUTOUT_TIME_SEC.Value = Values.Zero
            ET_ATS_START_TIME_SEC.Value = Values.Zero
            ET_ELECTRICAL_STARTER_CUTOUT_TIME_SEC.Value = Values.Zero
            ET_ELECTRICAL_START_TIME_SEC.Value = Values.Zero

        End Sub

        Private Sub Init_Arrays()

            Dim SelectString As String
            Dim rs As ADODB.Recordset = Nothing
            Dim i As Integer


            Try
                'Read Table 1309 GTCP331-500B
                SelectString = "SELECT * FROM GTCP331_500B_PBSETCOR ORDER BY [T_INLET_AVG]"
                If DatabaseHelper.OpenRecordset(rs, SelectString, cnMain, True) Then
                    ReDim GTCP331_500B_PBSETCOR(DatabaseHelper.RecordCount(rs) - 1, 1)
                    For i = 0 To GTCP331_500B_PBSETCOR.GetLength(0) - 1
                        GTCP331_500B_PBSETCOR(i, 0) = rs.Fields("T_INLET_AVG").Value
                        GTCP331_500B_PBSETCOR(i, 1) = rs.Fields("PBSETCOR").Value
                        rs.MoveNext()
                    Next i
                    DatabaseHelper.CloseRecordset(rs)
                End If

                Debug.Assert(i > 0)
                i = 0

                'Read Table 1310 GTCP331-500B
                SelectString = "SELECT * FROM GTCP331_500B_ECS ORDER BY [INLET_T]"
                If DatabaseHelper.OpenRecordset(rs, SelectString, cnMain, True) Then
                    ReDim GTCP331_500B_ECS(DatabaseHelper.RecordCount(rs) - 1, 5)
                    For i = 0 To GTCP331_500B_ECS.GetLength(0) - 1
                        GTCP331_500B_ECS(i, 0) = rs.Fields("INLET_T").Value
                        GTCP331_500B_ECS(i, 1) = rs.Fields("WB_DELTA").Value
                        GTCP331_500B_ECS(i, 2) = rs.Fields("PB_DELTA").Value
                        GTCP331_500B_ECS(i, 3) = rs.Fields("TB_DELTA").Value
                        GTCP331_500B_ECS(i, 4) = rs.Fields("WF_DELTA").Value
                        GTCP331_500B_ECS(i, 5) = rs.Fields("EGT_DELTA").Value
                        rs.MoveNext()
                    Next i
                    DatabaseHelper.CloseRecordset(rs)
                End If

                Debug.Assert(i > 0)
                i = 0

                'Read Table 1311 GTCP331-500B
                SelectString = "SELECT * FROM GTCP331_500B_MES ORDER BY [INLET_T]"
                If DatabaseHelper.OpenRecordset(rs, SelectString, cnMain, True) Then
                    ReDim GTCP331_500B_MES(DatabaseHelper.RecordCount(rs) - 1, 5)
                    For i = 0 To GTCP331_500B_MES.GetLength(0) - 1
                        GTCP331_500B_MES(i, 0) = rs.Fields("INLET_T").Value
                        GTCP331_500B_MES(i, 1) = rs.Fields("WB_DELTA").Value
                        GTCP331_500B_MES(i, 2) = rs.Fields("PB_DELTA").Value
                        GTCP331_500B_MES(i, 3) = rs.Fields("TB_DELTA").Value
                        GTCP331_500B_MES(i, 4) = rs.Fields("WF_DELTA").Value
                        GTCP331_500B_MES(i, 5) = rs.Fields("EGT_DELTA").Value
                        rs.MoveNext()
                    Next i
                    DatabaseHelper.CloseRecordset(rs)
                End If

                Debug.Assert(i > 0)
                i = 0

                'Read Table 1312 GTCP331-500B
                SelectString = "SELECT * FROM GTCP331_500B_EBP ORDER BY [PBCOR_ONE]"
                If DatabaseHelper.OpenRecordset(rs, SelectString, cnMain, True) Then
                    ReDim GTCP331_500B_EBP(DatabaseHelper.RecordCount(rs) - 1, 5)
                    For i = 0 To GTCP331_500B_EBP.GetLength(0) - 1
                        GTCP331_500B_EBP(i, 0) = rs.Fields("PBCOR_ONE").Value
                        GTCP331_500B_EBP(i, 1) = rs.Fields("WBEXC_DELTA").Value
                        GTCP331_500B_EBP(i, 2) = rs.Fields("PBEXC_DELTA").Value
                        GTCP331_500B_EBP(i, 3) = rs.Fields("TBEXC_DELTA").Value
                        GTCP331_500B_EBP(i, 4) = rs.Fields("WFEXC_DELTA").Value
                        GTCP331_500B_EBP(i, 5) = rs.Fields("EGTEXC_DELTA").Value
                        rs.MoveNext()
                    Next i
                    DatabaseHelper.CloseRecordset(rs)
                End If

                Debug.Assert(i > 0)
                i = 0

                'Read Table on page 1337 GTCP331-500B
                SelectString = "SELECT * FROM GTCP331_500B_GEN ORDER BY [KWCOR]"
                If DatabaseHelper.OpenRecordset(rs, SelectString, cnMain, True) Then
                    ReDim GTCP331_500B_GEN(DatabaseHelper.RecordCount(rs) - 1, 1)
                    For i = 0 To GTCP331_500B_GEN.GetLength(0) - 1
                        GTCP331_500B_GEN(i, 0) = rs.Fields("KWCOR").Value
                        GTCP331_500B_GEN(i, 1) = rs.Fields("SHPCOR").Value
                        rs.MoveNext()
                    Next i
                    DatabaseHelper.CloseRecordset(rs)
                End If

                Debug.Assert(i > 0)
                i = 0

                'Read Figure 1305 GTCP331-500B
                SelectString = "SELECT * FROM GTCP331_500B_WBCDNA_LO_LIMITS ORDER BY [T_INLET_AVG]"
                If DatabaseHelper.OpenRecordset(rs, SelectString, cnMain, True) Then
                    ReDim GTCP331_500B_WBCDNA_LO_LIMIT(DatabaseHelper.RecordCount(rs) - 1, 1)
                    For i = 0 To GTCP331_500B_WBCDNA_LO_LIMIT.GetLength(0) - 1
                        GTCP331_500B_WBCDNA_LO_LIMIT(i, 0) = rs.Fields("T_INLET_AVG").Value
                        GTCP331_500B_WBCDNA_LO_LIMIT(i, 1) = rs.Fields("LOW_LIMIT").Value
                        rs.MoveNext()
                    Next i
                    DatabaseHelper.CloseRecordset(rs)
                End If

                Debug.Assert(i > 0)
                i = 0

                SelectString = "SELECT * FROM GTCP331_500B_WBCDNA_HI_LIMITS ORDER BY [T_INLET_AVG]"
                If DatabaseHelper.OpenRecordset(rs, SelectString, cnMain, True) Then
                    ReDim GTCP331_500B_WBCDNA_HI_LIMIT(DatabaseHelper.RecordCount(rs) - 1, 1)
                    For i = 0 To GTCP331_500B_WBCDNA_HI_LIMIT.GetLength(0) - 1
                        GTCP331_500B_WBCDNA_HI_LIMIT(i, 0) = rs.Fields("T_INLET_AVG").Value
                        GTCP331_500B_WBCDNA_HI_LIMIT(i, 1) = rs.Fields("HIGH_LIMIT").Value
                        rs.MoveNext()
                    Next i
                    DatabaseHelper.CloseRecordset(rs)
                End If

                Debug.Assert(i > 0)
                i = 0

            Catch Ex As Exception
                MessageBox.Show("InitArrays_GTCP331_500B: " & Ex.ToString())
            Finally
            End Try

        End Sub

        Protected Overrides Sub Init_Engine_Controls()

            SetTestStepList(0)

        End Sub


        'Use Delegate for Cross Thread Operation
        Private Delegate Sub SetTestStepListDelegate(ByVal value As Integer)
        Protected Overrides Sub SetTestStepList(ByVal value As Integer)

            If (Me.cmbTestStepList.InvokeRequired) Then
                Me.cmbTestStepList.BeginInvoke(New SetTestStepListDelegate(AddressOf Me.SetTestStepList), value)
            Else
                cmbTestStepList.Items.Clear()
                cmbTestStepList.Items.Add("FLOW SENSOR CHECK")
                cmbTestStepList.Items.Add("SCV STABILITY TEST")
                cmbTestStepList.Items.Add("ECS")
                cmbTestStepList.Items.Add("NO LOAD")
                cmbTestStepList.Items.Add("MES")
                cmbTestStepList.Items.Add("ELECTRIC START TEST")
                cmbTestStepList.Items.Add("AIR START TEST")
                cmbTestStepList.Items.Add("OPERATING TIME LOG")
                cmbTestStepList.SelectedIndex = value

            End If
        End Sub

        Private Sub EmulateInletFlapOpeningClosing()

            Static FlapPosition As Integer = 0
            Try
                'The flap must be closed only when speed goes lower than 7 pct, otherwise the engine cooldown won<t work 
                If CELProject.IsTrue(RUN_STOP_BTN.Value) Or NG_PCT.Value.ToDouble() > 7 Then
                    If (FlapPosition < 3000) Then
                        FlapPosition = FlapPosition + 100
                    Else
                        FlapPosition = 3000
                    End If

                Else
                    If (FlapPosition > 0) Then
                        FlapPosition = FlapPosition - 100
                    Else
                        FlapPosition = 0
                    End If
                End If

                If FlapPosition = 0 Then
                    INLET_FLAP_CLOSE_IND.Value = Values.True   ' (* 0 is close position*) 
                Else
                    INLET_FLAP_CLOSE_IND.Value = Values.False
                End If
                If (FlapPosition <> 0) And (FlapPosition <> 3000) Then
                    INLET_FLAP_MOVE_IND.Value = Values.True
                Else
                    INLET_FLAP_MOVE_IND.Value = Values.False
                End If
                If FlapPosition = 3000 Then
                    INLET_FLAP_OPEN_CMD.Value = Values.True '(* 3000 is open position*)
                Else
                    INLET_FLAP_OPEN_CMD.Value = Values.False
                End If

            Catch ex As Exception
                Console.WriteLine("EmulateInletFlapOpeningClosing: " + ex.Message)
            End Try

        End Sub

        Protected Overrides Sub OnEngineWorkingThread()

            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                Compute(False)

                EmulateInletFlapOpeningClosing()

                'Persistent Values Save Check
                PersistentValuesCtrl.SavePersistentValues(False)

            End If

        End Sub

        Private Function Compute_BleedAirFlow(ByVal TOrifice_DEGF As Double, _
                                              ByVal POrifice_PSIA As Double, _
                                              ByVal POrificeDelta_PSID As Double) As Double
            Try

                If CELProject.IsTrue(BLEED_BTN.Value) Then

                    Dim BleedAirFLow As Double = CELProject.GetBleedAirFlow( _
                                                                            EngineConfiguration.DuctDiameter, _
                                                                            EngineConfiguration.DuctDiameterUnit, _
                                                                            EngineConfiguration.OrificeDiameter, _
                                                                            EngineConfiguration.OrificeDiameterUnit, _
                                                                            TOrifice_DEGF, _
                                                                            CELDAS.eTemperature.Fahrenheit, _
                                                                            POrifice_PSIA, _
                                                                            CELDAS.ePressure.PSI, _
                                                                            POrificeDelta_PSID, _
                                                                            CELDAS.ePressure.PSI, _
                                                                            EngineConfiguration.OrificeThinkness, _
                                                                            EngineConfiguration.OrificeThinknessUnit, _
                                                                            EngineConfiguration.TapArrangement, _
                                                                            CELDAS.eFlowMass.LbByMin)

                    Return BleedAirFLow

                Else
                    Return 0.0
                End If

            Catch Ex As Exception
                'Log error
                MessageBox.Show("Error in Engine_Sequence.Compute_BleedAirFlow: " & Ex.ToString)
            End Try

        End Function

