                        Return_Value.Add(MyBase.InitializeChannel(TORQUE_ARINC_PCT_MEAN, "TORQUE_ARINC_PCT_MEAN"))

                End Select

            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.Message)
                Return_Value.Add(False)
            Finally

            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function

        Private Function Initialize() As Boolean
            Try

                Dyno_Tq_50PC = 0
                Dyno_Tq_TO = 0
                EEC_Tq_50PC = 0
                EEC_Tq_TO = 0
                PERF_RELATIVE_HUMIDITY_PCT.Value = Values.Zero
                PERF_CONDITION_NUMBER.Value = Values.One
                PERF_EEC_R3.Value = Values.Zero
                PERF_EEC_R4.Value = Values.Zero
                PERF_REMARK_TEXT.Value = New KineticaRT.Values.Text("")
                PERF_T_DEW_PT_DEGF.Value = Values.Zero
                PERF_T_REF_TEMP_DEGF.Value = Values.Zero
                PERF_ITT_TRIM_DEGF.Value = Values.Zero

                DEW_POINT_METHOD_CHKBOX.Value = Values.True

                Return True

            Catch Ex As Exception
                MessageBox.Show("PWC83040_Sequence : Initialize()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return False
            End Try
        End Function

        Private Function Initialize_Perf() As Boolean
            Dim iError As Integer

            Try
                ' Set Configuration Files 
                CopyConfigurationFiles()
                pwc83040.SetConfigurationPath(sConfigurationPath)
                pwc83040.SetDataPath(sDataPath)

                ' Unit Setting
                'pwc83040.PutUnitValue(iError) (optional, only if you are changing units)
                'pwc83040.SaveUnitData(iError) (optional, only if you are changing units)
                pwc83040.GetUnitData(iError)
                If iError <> 0 Then
                    MessageBox.Show("PWC83040_Sequence : Initialize_Perf() Couldn't load Unit Data", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Return False
                End If

                ' Service Bulletin Setting
                Dim ServiceBulletinsSplitted As String() = {}

                If UserInputs.ServiceBulletins <> String.Empty Then
                    ServiceBulletinsSplitted = UserInputs.ServiceBulletins.Split(New Char() {"-"})
                End If

                If ServiceBulletinsSplitted.Length = 0 Then

                    pwc83040.LoadBuildSpec(iError, UserInputs.BuildSpec.ToString, "", "")

                ElseIf ServiceBulletinsSplitted.Length = 1 Then

                    pwc83040.LoadBuildSpec(iError, UserInputs.BuildSpec.ToString, ServiceBulletinsSplitted(0), "")

                ElseIf ServiceBulletinsSplitted.Length = 2 Then

                    pwc83040.LoadBuildSpec(iError, UserInputs.BuildSpec.ToString, ServiceBulletinsSplitted(0), ServiceBulletinsSplitted(1))

                Else
                    Debug.Assert(False, "PWC83018 Load Model : One or two Service Bulletins are supported : User Inputs Error")
                    iError = 1
                End If

                If iError <> 0 Then
                    MessageBox.Show("PWC83040_Sequence : Initialize_Perf() Couldn't load Build Spec" + iError.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Return False
                End If


                'PWC83040SetStaus (unnecessary at present, provided only to accommodate future growth)
                pwc83040.SetEngine(UserInputs.EngineSerialNumber)


                pwc83040.SetBuild(1)

                Return True

            Catch Ex As Exception
                MessageBox.Show("PWC83040_Sequence : Initialize_Perf() : Cannot communicate with P&WC DLL Processing Server" & vbCrLf & vbCrLf & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        Private Sub ProcessCondition()
            Dim Cond_nb As Integer
            Dim FileName As String
            Dim iError As Integer

            Try
                Cond_nb = CInt(PERF_CONDITION_NUMBER.Value.ToDouble())
                pwc83025.SetCondition(Cond_nb)
                SubmitPerfValues()
                pwc83025.Process(iError, 1, 1)

                If (iError = 0) Then
                    FileName = GetOutputFilename()

                    PerfFileName = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + UserInputs.EngineSerialNumber + "\" + UserInputs.WorkOrder + "\Perf\" + "Performance " + Format(Now, "yyyy-MM-dd HH'h'mm'm'ss's'") + ".txt"

                    If (System.IO.File.Exists(PerfFileName)) Then
                        System.IO.File.Delete(PerfFileName)
                    End If

                    System.IO.File.Copy(FileName, PerfFileName)
                    ShowOutputFile(FileName)
                    PERF_CONDITION_NUMBER.Value = New KineticaRT.Values.Double(PERF_CONDITION_NUMBER.Value.ToDouble + 1)
                Else
                    MessageBox.Show("UNEXPECTED ERROR:" + vbCrLf + "==== ERROR PROCESSING CONDITION ====" + vbCrLf)
                    ShowOutputFile("TEMP.OUT")
                End If
            Catch ex As Exception
                MessageBox.Show("PWC83020_Sequence : ProcessCondition() : Cannot communicate with P&WC DLL Processing Server" & vbCrLf & vbCrLf & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub SampleValues()
            Try
                'Sending SGBase=SG Measured, TFuel=TFuel Measured so that we feed directly the corrected values of fuel flows and the dll doesnt correct them
                'Was using WF Perf values before but I couldnt confirm at the time if the USGPM value from the massflowmeter is corrected or not
                'Facility
                Var_T_FUEL_DEGF = LOG_PERF_T_FUEL_AVG_DEGF.Value.ToDouble()
