        Private Sub SetUnitValues()
            Dim i As Integer

            For i = UnitValues.GetLowerBound(0) To UnitValues.GetUpperBound(0)
                If Not pwc83025.PutUnitValue(UnitValues(i, 0), UnitValues(i, 1), "") Then
                    MessageBox.Show("SetUnitValues: Unknown label Or unit '" + _
                        UnitValues(i, 0) + "' (" + UnitValues(i, 1) + ")")
                End If
            Next
        End Sub

        Private Sub ShowOutputFile(fileName As String)
            Dim DetailsForm As CEL.Forms.DisplayFile = Nothing

            Try
                DetailsForm = New CEL.Forms.DisplayFile(fileName)

                DetailsForm.MinimizeBox = False
                DetailsForm.MaximizeBox = False
                DetailsForm.Text = fileName
                DetailsForm.ShowDialog()
            Catch e As Exception
                MsgBox(e.ToString(), MsgBoxStyle.OkOnly Or MsgBoxStyle.Critical, _
                    fileName)
            Finally
                If (Not (DetailsForm Is Nothing)) Then
                    DetailsForm.Dispose()
                End If
            End Try
        End Sub

        Private Sub SubmitPerfValues()
            pwc83025.SetEngine(UserInputs.EngineSerialNumber)

            pwc83025.PutValue("DATE", Format(Now, "yyyy/MM/dd"), "")
            pwc83025.PutValue("TIME", Format(Now, "hh:mm"), "")
            pwc83025.PutValue("CELL", "VECTOR", "")
            pwc83025.PutValue("REMARK", PERF_REMARK_TEXT.Value.ToString(), "")
            pwc83025.PutValue("WORK", UserInputs.WorkOrder, "")
            If UserInputs.TestType = "Overhaul new" Then
                pwc83025.PutValue("LIM_CODE", "1", "")
            ElseIf UserInputs.TestType = "HSI / refurbish" Then
                pwc83025.PutValue("LIM_CODE", "2", "")
            ElseIf UserInputs.TestType = "Repair" Then
                pwc83025.PutValue("LIM_CODE", "3", "")
            End If
            If UserInputs.TestType = "Overhaul new" Then
                pwc83025.PutValue("TEST_TYPE", "OVERHAUL", "")
            ElseIf UserInputs.TestType = "HSI / refurbish" Then
                pwc83025.PutValue("TEST_TYPE", "HSI", "")
            ElseIf UserInputs.TestType = "Repair" Then
                pwc83025.PutValue("TEST_TYPE", "REPAIR", "")
            End If
            pwc83025.PutValue("TSG", Var_SAMPLE_T_FUEL.ToString(), "")
            pwc83025.PutValue("SG", Var_SAMPLE_SG_FUEL.ToString(), "")
            pwc83025.PutValue("SG_BASE", Var_SG_BASE.ToString(), "")
            pwc83025.PutValue("LHV", UserInputs.LHV, "")
            If DEW_POINT_METHOD_CHKBOX.Value = Values.True Then
                pwc83025.PutValue("HUM_METHOD", "D", "")
                pwc83025.PutValue("TDWPT", PERF_T_DEW_PT_DEGF.Value.ToString(), "")
                pwc83025.PutValue("TREFTEMP", PERF_T_REF_TEMP_DEGF.Value.ToString(), "")
            ElseIf RELATIVE_HUMIDITY_METHOD_CHKBOX.Value = Values.True Then
                pwc83025.PutValue("HUM_METHOD", "R", "")
                pwc83025.PutValue("RH", PERF_RELATIVE_HUMIDITY_PCT.Value.ToString(), "")
            End If
            pwc83025.PutValue("NH", Var_NH_RPM.ToString(), "")
            pwc83025.PutValue("NL", Var_NL_RPM.ToString(), "")
            pwc83025.PutValue("NPT", Var_NPT_RPM.ToString(), "")
            pwc83025.PutValue("PCELL", Var_P_BARO_PSIA.ToString(), "")
            pwc83025.PutValue("BARO", Var_P_BARO_PSIA.ToString(), "")

            pwc83025.PutValue("P1.1", Var_P_P1_1_PSIG.ToString(), "")
            pwc83025.PutValue("P1.1", Var_P_P1_2_PSIG.ToString(), "")
            'In the engine manual, RGBOIL(S1707) is defined as PRGB in the DRP
            pwc83025.PutValue("PRGB", Var_P_RGBOIL_PSIA.ToString(), "")

            pwc83025.PutValue("P3", Var_P_P3_PSIG.ToString(), "1")
            pwc83025.PutValue("P8", Var_P_P8_PSIG.ToString(), "")
            pwc83025.PutValue("PDPT", Var_P_PDPT_PSIA.ToString(), "")
            pwc83025.PutValue("TEMP_TRIM", Var_ITT_TRIM_DEGF.ToString(), "")
            pwc83025.PutValue("MOT", Var_T_MOT_DEGF.ToString(), "")
            'We feed a WF Perf specifically for PWC software : Volumetric value x 8.3278 (water density at 60F) x SG_BASE x 60
            pwc83025.PutValue("WF1", Var_WF1_PPH.ToString(), "")
            pwc83025.PutValue("WF2", Var_WF2_PPH.ToString(), "")
            'We are using Fuel Temperature from the probe as the precision is better from the value from the mass flowmeter
            pwc83025.PutValue("TF", Var_T_FUEL_DEGF.ToString(), "")

            pwc83025.PutValue("LPBOV", Var_LPBOV_PCT.ToString(), "")
            pwc83025.PutValue("TMEEC", Var_Q_LBSFT.ToString(), "")
            pwc83025.PutValue("DYNO_TQ", Var_DYNO_TORQUE_LBSFT.ToString(), "")
            pwc83025.PutValue("ITT", Var_ITT_DEGF.ToString(), "")

            If T_T1_1_DELETE_BTN.Value.ToString() = "True" Then
                pwc83025.PutValue("T1", "-10001.000", "1")
