        Private UserInputs As New UserInput11894()

        Public Class UserInput11894

            Public EngineSerialNumber As String = ""
            Public WorkOrder As String = ""
            Public PartNumber As String = ""
            Public LHV As String = ""
            Public OilType As String = ""
            Public FuelType As String = ""
            Public CustomerName As String = ""
            Public ManualRevDate As String = ""

            Public TestType As String = ""
            Public BuildSpec As String = ""
            Public ServiceBulletins As String = ""
            Public OperatorName As String = ""
            Public ObserverName As String = ""
            Public SupervisorName As String = ""

            ' Allow friend access to the empty constructor.
            Friend Sub New()

            End Sub
            Public Sub MapUserInputsParameters(ByRef CELProject As CELDAS)

                EngineSerialNumber = CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
                WorkOrder = CELProject.Test_Mgr_UUT_Answer(1).Value.ToString()
                PartNumber = CELProject.Test_Mgr_UUT_Answer(2).Value.ToString()
                LHV = CELProject.Test_Mgr_UUT_Answer(3).Value.ToString()
                OilType = CELProject.Test_Mgr_UUT_Answer(4).Value.ToString()
                FuelType = CELProject.Test_Mgr_UUT_Answer(5).Value.ToString()
                CustomerName = CELProject.Test_Mgr_UUT_Answer(6).Value.ToString()
                ManualRevDate = CELProject.Test_Mgr_UUT_Answer(7).Value.ToString()

                TestType = CELProject.Test_Mgr_UUT_Choice(0).Value.ToString()
                BuildSpec = CELProject.Test_Mgr_UUT_Choice(1).Value.ToString()
                ServiceBulletins = CELProject.Test_Mgr_UUT_Choice(2).Value.ToString()
                OperatorName = CELProject.Test_Mgr_UUT_Choice(4).Value.ToString()
                ObserverName = CELProject.Test_Mgr_UUT_Choice(5).Value.ToString()
                SupervisorName = CELProject.Test_Mgr_UUT_Choice(6).Value.ToString()

            End Sub

        End Class

    End Class
