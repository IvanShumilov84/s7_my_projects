        Private Sub OnBTN_50PC_TORQUE_TRIM(sender As IChannel, newVal As Value)
            Try
                If (newVal Is Values.True) Then
                    Dyno_Tq_50PC = CSng(DYNO_TORQUE_LBSFT_MEAN.Value.ToDouble())
                    EEC_Tq_50PC = CSng(TORQUE_ARINC_PCT_MEAN.Value.ToDouble())
                End If
            Catch Ex As Exception
                MessageBox.Show("PWC83020_Sequence : OnBTN_50PC_TORQUE_TRIM()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub OnBTN_CLEAR_TORQUE_TRIM(sender As IChannel, newVal As Value)
            Try
                If (newVal Is Values.True) Then
                    PERF_50PC_TORQUE_TRIM_BTN.Value = Values.False
                    PERF_TO_TORQUE_TRIM_BTN.Value = Values.False
                    PERF_CLEAR_TORQUE_TRIM_BTN.Value = Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("PWC83020_Sequence : OnBTN_CLEAR_TORQUE_TRIM()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Public Function UpdateCustomHeaderLogFile(ByVal AppendOption As Boolean, ByVal IsPerfEntry As Boolean, ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean
            Dim Log_Condition As Integer

            If AppendOption = False Then
                Log_Condition = 1
            Else
                'Log_Condition = (ExcelWorksheet.Cells(RowIndex + 1, 1).End(Excel.XlDirection.xlToRight).Column - 1)
                'TODO: Ici changement du au nouveau Microsoft.Office.Interop.Excel	                        'Log_Condition = (ExcelWorksheet.Cells(RowIndex + 1, 1).End(XlDirection.xlToRight).Column - 1)  'cette ligne en office 2010 retourne toujours 16384 -1 donc 16383 et le reste du code plante
                Log_Condition = ExcelWorksheet.Cells(RowIndex + 1, ExcelWorksheet.Columns.Count).End(Excel.XlDirection.xlToLeft).Column - 1
                Log_Condition = Log_Condition + 1

            End If

            If ((Log_Condition > 1) And ((Log_Condition Mod 5) = 1)) Then

                'Repeat The Test Spec For this new sets of condition

                With ExcelWorksheet
                    .Range(.Cells(2, 2), .Cells(RowIndex - 2, 6)).Copy(.Cells(2, Log_Condition + 1))
                End With
            End If

            ColumnIndex = 1 + Log_Condition

            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Format(Now, "yyyy/MM/dd HH:mm:ss")
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += 1
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Log_Condition.ToString()
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += 1
            If IsPerfEntry = False Then
                Dim CommentText As String = ""
                Dim InputObject As New InputCommentForm
                InputObject.ShowDialog("Log Report", "Comment:", "", CommentText)

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = CommentText
            Else
                '						ExcelWorkSheet.Cells(RowIndex, ColumnIndex).Value				= "STEP: " & TEST_STEP_NB.Value.ToString() & " " & Now.ToString()
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "STEP: " & TestStep_List.SelectedItem & " " & Now.ToString()
            End If

            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += 2
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Values"
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignCenter
        End Function

        Private Sub OnBTN_PERFORMANCE_RUN(sender As IChannel, newVal As Value)
            Try
                If (newVal Is Values.True) Then

                    'Update the Log/Perf channel set
                    CELProject.LogPerfSynch.UpdateValues()

                    SampleValues()

                    CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, False, CELProject.EngineModel, True)

                    ProcessCondition()

                    PERF_PERFORMANCE_RUN_BTN.Value = Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("PWC83040_Sequence : OnBTN_PERFORMANCE_RUN()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub OnHUMIDITY_METHOD(sender As IChannel, newVal As Value)
            Try
                If (sender.Name = "DEW_POINT_METHOD_CHKBOX") Then
                    If CELProject.IsTrue(newVal) Then
                        RELATIVE_HUMIDITY_METHOD_CHKBOX.Value = Values.False
                    Else
                        RELATIVE_HUMIDITY_METHOD_CHKBOX.Value = Values.True
                    End If
                End If

                If (sender.Name = "RELATIVE_HUMIDITY_METHOD_CHKBOX") Then
                    If CELProject.IsTrue(newVal) Then
                        DEW_POINT_METHOD_CHKBOX.Value = Values.False
                    Else
                        DEW_POINT_METHOD_CHKBOX.Value = Values.True
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("PWC83040_Sequence : OnHUMIDITY_METHOD()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub OnBTN_TO_TORQUE_TRIM(sender As IChannel, newVal As Value)
            Try
                If (newVal Is Values.True) Then
                    Dyno_Tq_TO = CSng(DYNO_TORQUE_LBSFT_MEAN.Value.ToDouble())
                    EEC_Tq_TO = CSng(TORQUE_ARINC_PCT_MEAN.Value.ToDouble())
                End If
            Catch ex As Exception
                MessageBox.Show("PWC83040_Sequence : OnBTN_TO_TORQUE_TRIM()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub OnBTN_TORQUE_TRIM(sender As IChannel, newVal As Value)
            Dim FileName As String
            Dim ier As Integer
            Dim iOutput As Integer = 1
            Dim iTMTolDouble As Integer
            Dim PerfFileName As String
            Dim rBiasCl As Single = 0
            Dim rGainCl As Single = 0
            Dim rResBias As Single = 0
            Dim rResGain As Single = 0


            Try
                If (newVal Is Values.True) Then

                    'Get values EEC R3 and EEC R4
                    rResBias = CSng(PERF_EEC_R3.Value.ToDouble())
                    rResGain = CSng(PERF_EEC_R4.Value.ToDouble())

                    If (PERF_TRIM_TOLERANCE_BTN.Value.ToString() = "False") Then
                        iTMTolDouble = 1
                    Else
                        iTMTolDouble = 2
                    End If

                    Dim Temp As Boolean = Initialize_Perf()

                    pwc83025.SetBuild(1)
                    pwc83025.SetCondition(1)

                    pwc83025.ProcessTorqueTrim(iOutput, iTMTolDouble, Dyno_Tq_TO, Dyno_Tq_50PC, EEC_Tq_TO, EEC_Tq_50PC, rResGain, rResBias, ier)
                    If (ier = 0) Then
                        FileName = GetOutputFilename()

                        PerfFileName = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + UserInputs.EngineSerialNumber + "\" + UserInputs.WorkOrder + "\Perf\" + "Torque Trim_" + Format(Now, "yyyy-MM-dd HH'h'mm'm'ss's'") + ".txt"

                        If (System.IO.File.Exists(PerfFileName)) Then
                            System.IO.File.Delete(PerfFileName)
                        End If

                        System.IO.File.Copy(FileName, PerfFileName)
                        ShowOutputFile(FileName)

                    Else
                        MessageBox.Show("UNEXPECTED ERROR:" + vbCrLf + "==== ERROR PROCESSING TORQUE TRIM  ====" + vbCrLf)
                        ShowOutputFile("TEMP.OUT")
                    End If

                    PERF_COMPUTE_TORQUE_TRIM_BTN.Value = Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("PWC83040_Sequence : OnBTN_TORQUE_TRIM()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionInitialized(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                MyBase.OnTestSessionInitialized(newStatus)

                If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then

                    Select Case CELProject.EngineFamily

                        Case "PW210"

                            'Client Initialization
                            Dim endpointAddress As New EndpointAddress(Configuration.CreateServerUriString())
                            Dim binding As System.ServiceModel.Channels.Binding = Configuration.CreateBinding()
                            Dim factory As New ChannelFactory(Of IPwc83040)(binding, endpointAddress)
                            pwc83040 = factory.CreateChannel()

                            UserInputs.MapUserInputsParameters(CELProject)
                            Init_Engine_Channels()

                            ' Work in progress (en commentaire pour éviter des bugs)
                            'If Initialize_Perf() = False Then
                            '    Perf_Status_Close = True
                            '    CELProject.Test_Mgr_Cmd.Value = New KineticaRT.Values.Text(CELDAS.eTest_Mgr_Cmd.Close)
                            'Else
                            '    Perf_Status_Close = False
                            'End If

                            'CreateLogFile() Ajouter Creation du Log generique
                            Initialize()



                    End Select
                End If
            Catch Ex As Exception
                MessageBox.Show("PWC83040_Sequence : OnTestSessionInitialized()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)

            Catch ex As Exception

                MessageBox.Show("PWC83040_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            End Try
        End Sub

        Protected Overrides Sub OnTestSessionRunning(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                MyBase.OnTestSessionRunning(newStatus)
                If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then

                    Select Case CELProject.EngineFamily

                        Case "PW210"

                            If Perf_Status_Close Then
                                CELProject.Test_Mgr_Cmd.Value = New KineticaRT.Values.Text(CELDAS.eTest_Mgr_Cmd.Close)
                            End If
                            CreateHandler()

                    End Select
                End If
            Catch Ex As Exception
                MessageBox.Show("PWC83040_Sequence : OnTestSessionRunning()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

       Protected Overrides Sub OnTestSessionClosing(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionClosing(newStatus)
                If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then
                    Select Case CELProject.EngineFamily

                        Case "PW210"

                            DeleteHandler()

                    End Select
                End If
            Catch Ex As Exception
                MessageBox.Show("PWC83040_Sequence : OnTestSessionClosing()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

