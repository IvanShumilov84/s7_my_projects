                            End If
                            W17MaxIGV142LimitTable(0, W17MaxIGV142LimitTable.GetUpperBound(1)) = line.XValue
                            W17MaxIGV142LimitTable(1, W17MaxIGV142LimitTable.GetUpperBound(1)) = line.YValue
                        Case "W17@P1=14.7 Max IGV"
