Namespace StudioDemonstration

	Public Class PW901A_Sequence
        Inherits ApuSequence

        Private Const MaxNumberOfTt1Probe As Integer = 4
		Private Const MaxNumberOfTt17Probe As Integer = 2
		Private Const MaxNumberOfTt7Probe As Integer = 6

		Private Enum eTestStepPW901A
			NO_LOAD = 0
			MAX_IGV = 1
			MAX_ECS = 2
			MES = 3
			FINAL_DATA = 4
		End Enum
        Private Enum eTestLimitTypePW901A
            EGT = 0
            IGV = 1
            N2 = 3
            Pt17 = 4
            W17 = 5
            Wf = 6
        End Enum

        Protected Overrides Sub Compute(ByVal CalulateForLogAndPerformanceReports As Boolean)

            Try
                If CalulateForLogAndPerformanceReports Then

                    LOG_PERF_WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(LOG_PERF_T_ORIFICE_DEGF.Value.ToDouble(), _
                                                                                               LOG_PERF_P_ORIFICE_PSIA.Value.ToDouble(), _
                                                                                               LOG_PERF_P_ORIFICE_DELTA_PSID.Value.ToDouble))

                    'IMPORTANT: Toutes les variables flottantes telles que WB_CALC, DELPB, LB_DEMAND dont la source et la destination sont vides doivent
                    'manuellement être updaté pour être inscrite dans le LOG ou le PERF report.
                Else

                    WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(T_ORIFICE_DEGF.Value.ToDouble(), _
                                                                                      P_ORIFICE_PSIA.Value.ToDouble(), _
                                                                                      P_ORIFICE_DELTA_PSID.Value.ToDouble))
                End If

                'Timers Update
                RundownTimerCtrl.Timer()

                PW901A_Iteration(W7.Value.ToDouble(), CP7.Value.ToDouble(), T_T7_DEGR.Value.ToDouble(), W16.Value.ToDouble(), CP16.Value.ToDouble(), T_T17_DEGR.Value.ToDouble(), W6.Value.ToDouble(), WFCOR.Value.ToDouble(), W1.Value.ToDouble())

            Catch ex As Exception
                MessageBox.Show("Compute_PW901A" + ex.ToString(), "Error")
            End Try

        End Sub

		Private Sub Compute_Time()

			Try
				If CELProject.IsTrue(OPERATING_TIMER_ON.Value) Then

					If LastStart Then
						OperatingTime = OperatingTime.Add(Now.Subtract(OperatingTime_Start))
					End If

					LastStart = True
					OperatingTime_Start = Now
				Else
					LastStart = False
				End If

				OPERATING_TIME_HOURS.Value = New KineticaRT.Values.Double(OperatingTime.Hours + (OperatingTime.Minutes / 60) + (OperatingTime.Seconds / 3600))
				OPERATING_TIME_MINUTES.Value = New KineticaRT.Values.Double((OperatingTime.Hours * 60) + OperatingTime.Minutes + (OperatingTime.Seconds / 60))

				If APU_ACCELERATING Then
					ts_accelerating_time = ts_accelerating_time.Add(Now.Subtract(AcceleratingTime_Start))
					AcceleratingTime_Start = Now
					ACCELERATING_TIME_SEC.Value = New KineticaRT.Values.Double(ts_accelerating_time.Hours * 3600 + (ts_accelerating_time.Minutes * 60) + (ts_accelerating_time.Seconds))
				End If

			Catch Ex As Exception
				MessageBox.Show("Compute_Time: " & Ex.ToString())
			End Try

		End Sub

        Private Sub ValidateFMInitialValue()

            Try

                'Read the mass flow meter value, the value cannot be 0
                If FM_INITIAL_VOLUME_LITERS.Value.ToDouble() = 0.0 Then
                    FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())
                End If

            Catch Ex As Exception
                MessageBox.Show("ValidateFMInitialValue: " & Ex.ToString())
            End Try

        End Sub

		Private Sub ConfigDeletableCtrls()

			' Default value if not override by the project
			Dim RealNumberOfTt1Probe As Integer = MaxNumberOfTt1Probe
			Dim RealNumberOfTt17Probe As Integer = MaxNumberOfTt17Probe
			Dim RealNumberOfTt7Probe As Integer = MaxNumberOfTt7Probe

			Try
				If CELProject.Project.Number = "12917" Then

					RealNumberOfTt1Probe = 4
					RealNumberOfTt17Probe = 2
					RealNumberOfTt7Probe = 6

				End If

				DeletableTt1ChCtrl = New DeletableChannelController(Me, RealNumberOfTt1Probe, MaxNumberOfTt1Probe, MaxNumberOfTt1Probe, "T_TT1_", "_DEGF", "_DELETE_BTN", "T_TT1_AVG_DEGF", "T_TT1_MIN_DEGF", "T_TT1_MAX_DEGF", "T_TT1_SPREAD_DEGF")
				DeletableTt17ChCtrl = New DeletableChannelController(Me, RealNumberOfTt17Probe, MaxNumberOfTt17Probe, MaxNumberOfTt17Probe, "T_TT17_", "_DEGF", "_DELETE_BTN", "T_TT17_AVG_DEGF", "T_TT17_MIN_DEGF", "T_TT17_MAX_DEGF", "T_TT17_SPREAD_DEGF")
				DeletableTt7ChCtrl = New DeletableChannelController(Me, RealNumberOfTt7Probe, MaxNumberOfTt7Probe, MaxNumberOfTt7Probe, "T_TT7_", "_DEGF", "_DELETE_BTN", "T_TT7_AVG_DEGF", "T_TT7_MIN_DEGF", "T_TT7_MAX_DEGF", "T_TT7_SPREAD_DEGF")

			Catch Ex As Exception
				MessageBox.Show("ConfigDeletableCtrls: " & Ex.ToString())
			End Try

		End Sub

        Private Sub ConfigDemandCtrls()

            Try
                'Configuring ECS Control
                ECSCtrl = New ECSController(Me, 1, 9, 1, "ECS_BTN", "ECS_DEMAND", "ECS_UP_DEMAND_BTN", "ECS_DOWN_DEMAND_BTN", ECS_Display)
                ECSCtrl.Memorize = False
                ECSCtrl.Enable = False

            Catch Ex As Exception
                MessageBox.Show("ConfigDemandCtrls: " & Ex.ToString())
            End Try

        End Sub

        Private Sub ConfigMinMaxCtrls()

            Try
                StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_CURRENT_AMP", "STARTER_CURRENT_MAX_AMP", "START_BTN")
                StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_VOLTAGE_VDC", "STARTER_VOLTAGE_MAX_VDC", "START_BTN")

                GGMaxVibrationRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_GG_CMS", "VIB_GG_MAX_CMS", "MAX_VIB_RECORD_BTN", "MAX_VIB_STOP_RECORD")
                LGBMaxVibrationRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_LGB_MS2", "VIB_LGB_MAX_MS2", "MAX_VIB_RECORD_BTN", "MAX_VIB_STOP_RECORD")

                N1MaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "N1_RPM", "N1_MAX_RPM", "N1_MAX_ENB")
                N1MinRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Minimum, "N1_RPM", "N1_MIN_RPM", "N1_MIN_ENB")

            Catch Ex As Exception
                MessageBox.Show("ConfigMinMaxCtrls: " & Ex.ToString())
            End Try

        End Sub

        Private Sub ConfigPersistentValues()

            Try
                'Engine Specific
                Dim PersistentValuesChannels() As String = {"NUMBER_OF_STARTS", "FUEL_USED_INITIAL_LITERS", "FUEL_USED_TOTAL_LITERS", "OPERATING_TIME_SEC"}
                Dim PersistentValuesFileName = "C:\" & CELProject.EngineModel & "\" & UserInputs.EngineSerialNumber & "\" & UserInputs.WorkOrder & "\Log\PersistentValues.xml"
                PW901APersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

                FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())

            Catch Ex As Exception
                MessageBox.Show("ConfigPersistentValuess: " & Ex.ToString())
            End Try

        End Sub

        Private Sub ConfigTimers()

            Try

                RundownTimerCtrl = New TimerController(Me, "RUNDOWN_TIME_START_CONDITION_LATCH", "RUNDOWN_TIME_STOP_CONDITION_LATCH", "RUNDOWN_TIME_CONDITION_RESET", "RUNDOWN_TIME_SEC", Nothing, 0, "NONE")

            Catch Ex As Exception
                MessageBox.Show("ConfigTimers: " & Ex.ToString())
            End Try

        End Sub

        Protected Overrides Sub Init_Engine_Channels_Value()
            Try

                OperatingTime = New System.TimeSpan(0, 0, 0, 0, 0) 'init operating time to 0 at open test only
                ts_accelerating_time = New System.TimeSpan(0, 0, 0, 0, 0) 'init operating time to 0 at open test only

                FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())

                APU_ACCELERATING = False
                IGV_LIMIT_PCT.Value = Values.Zero
                LHV.Value = New KineticaRT.Values.Double(UserInputs.LHV)
                N1_MAX_RPM.Value = Values.Zero
                N1_MIN_RPM.Value = Values.Zero
                N2_LIMIT_RPM.Value = Values.Zero
                N2_DATAPLATE_RPM.Value = Values.Zero
                P_PT17_LIMIT_PSIA.Value = Values.Zero
                PERF_TRIM_DEGC.Value = New KineticaRT.Values.Text("")
                PERF_TRIM_INPUT_DEGC.Value = New KineticaRT.Values.Text("")
                PERF_TRIM_CONTROL_DEGC.Value = New KineticaRT.Values.Text("")
                Q17_CRACKING_PT_19DEG.Value = New KineticaRT.Values.Text("")
                Q17_CRACKING_PT_77DEG.Value = New KineticaRT.Values.Text("")
                T_EGT_DATAPLATE_DEGC.Value = Values.Zero
                T_EGT_LIMIT_DEGC.Value = Values.Zero
                VIB_GG_MAX_CMS.Value = Values.Zero
                VIB_LGB_MAX_MS2.Value = Values.Zero
                W17_LIMIT_LBMIN.Value = Values.Zero
                WF_LIMIT_PPH.Value = Values.Zero

                LOAD_AIR_VALVE_DEMAND.Value = New KineticaRT.Values.Double(45.0)

                Dim limitTablesCollection As New UUTGenericInfoCollection()
                limitTablesCollection.es.Connection.Name = CELProject.DefaultConnectionName
                limitTablesCollection.Query.Where(limitTablesCollection.Query.EngineModel = CELProject.EngineModel)
                limitTablesCollection.Query.OrderBy(limitTablesCollection.Query.TableName.Ascending)
                limitTablesCollection.Query.OrderBy(limitTablesCollection.Query.XValue.Ascending)
                limitTablesCollection.Query.Load()

                For Each line As UUTGenericInfo In limitTablesCollection
                    Select Case line.TableName
                        Case "Delta EGT"
                            If IsNothing(DeltaEGTLimitTable) Then
                                ReDim Preserve DeltaEGTLimitTable(1, 0)
                            Else
                                ReDim Preserve DeltaEGTLimitTable(1, DeltaEGTLimitTable.GetUpperBound(1) + 1)
                            End If
                            DeltaEGTLimitTable(0, DeltaEGTLimitTable.GetUpperBound(1)) = line.XValue
                            DeltaEGTLimitTable(1, DeltaEGTLimitTable.GetUpperBound(1)) = line.YValue
                        Case "Delta N2"
                            If IsNothing(DeltaN2LimitTable) Then
                                ReDim Preserve DeltaN2LimitTable(1, 0)
                            Else
                                ReDim Preserve DeltaN2LimitTable(1, DeltaN2LimitTable.GetUpperBound(1) + 1)
                            End If
                            DeltaN2LimitTable(0, DeltaN2LimitTable.GetUpperBound(1)) = line.XValue
                            DeltaN2LimitTable(1, DeltaN2LimitTable.GetUpperBound(1)) = line.YValue
                        Case "Delta Pt17"
                            If IsNothing(DeltaPt17LimitTable) Then
                                ReDim Preserve DeltaPt17LimitTable(1, 0)
                            Else
                                ReDim Preserve DeltaPt17LimitTable(1, DeltaPt17LimitTable.GetUpperBound(1) + 1)
                            End If
                            DeltaPt17LimitTable(0, DeltaPt17LimitTable.GetUpperBound(1)) = line.XValue
                            DeltaPt17LimitTable(1, DeltaPt17LimitTable.GetUpperBound(1)) = line.YValue
                        Case "Delta W17"
                            If IsNothing(DeltaW17LimitTable) Then
                                ReDim Preserve DeltaW17LimitTable(1, 0)
                            Else
                                ReDim Preserve DeltaW17LimitTable(1, DeltaW17LimitTable.GetUpperBound(1) + 1)
                            End If
                            DeltaW17LimitTable(0, DeltaW17LimitTable.GetUpperBound(1)) = line.XValue
                            DeltaW17LimitTable(1, DeltaW17LimitTable.GetUpperBound(1)) = line.YValue
                        Case "Delta Wf"
                            If IsNothing(DeltaWfLimitTable) Then
                                ReDim Preserve DeltaWfLimitTable(1, 0)
                            Else
                                ReDim Preserve DeltaWfLimitTable(1, DeltaWfLimitTable.GetUpperBound(1) + 1)
                            End If
                            DeltaWfLimitTable(0, DeltaWfLimitTable.GetUpperBound(1)) = line.XValue
                            DeltaWfLimitTable(1, DeltaWfLimitTable.GetUpperBound(1)) = line.YValue
                        Case "EGT MES"
                            If IsNothing(EGTMESLimitTable) Then
                                ReDim Preserve EGTMESLimitTable(1, 0)
                            Else
                                ReDim Preserve EGTMESLimitTable(1, EGTMESLimitTable.GetUpperBound(1) + 1)
                            End If
                            EGTMESLimitTable(0, EGTMESLimitTable.GetUpperBound(1)) = line.XValue
                            EGTMESLimitTable(1, EGTMESLimitTable.GetUpperBound(1)) = line.YValue
                        Case "EGT MAX IGV"
                            If IsNothing(EGTMaxIGVLimitTable) Then
                                ReDim Preserve EGTMaxIGVLimitTable(1, 0)
                            Else
                                ReDim Preserve EGTMaxIGVLimitTable(1, EGTMaxIGVLimitTable.GetUpperBound(1) + 1)
                            End If
                            EGTMaxIGVLimitTable(0, EGTMaxIGVLimitTable.GetUpperBound(1)) = line.XValue
                            EGTMaxIGVLimitTable(1, EGTMaxIGVLimitTable.GetUpperBound(1)) = line.YValue
                        Case "IGV Max ECS"
                            If IsNothing(IGVMaxECSLimitTable) Then
                                ReDim Preserve IGVMaxECSLimitTable(1, 0)
                            Else
                                ReDim Preserve IGVMaxECSLimitTable(1, IGVMaxECSLimitTable.GetUpperBound(1) + 1)
                            End If
                            IGVMaxECSLimitTable(0, IGVMaxECSLimitTable.GetUpperBound(1)) = line.XValue
                            IGVMaxECSLimitTable(1, IGVMaxECSLimitTable.GetUpperBound(1)) = line.YValue
                        Case "IGV Max IGV"
                            If IsNothing(IGVMaxIGVLimitTable) Then
                                ReDim Preserve IGVMaxIGVLimitTable(1, 0)
                            Else
                                ReDim Preserve IGVMaxIGVLimitTable(1, IGVMaxIGVLimitTable.GetUpperBound(1) + 1)
                            End If
                            IGVMaxIGVLimitTable(0, IGVMaxIGVLimitTable.GetUpperBound(1)) = line.XValue
                            IGVMaxIGVLimitTable(1, IGVMaxIGVLimitTable.GetUpperBound(1)) = line.YValue
                        Case "IGV MES"
                            If IsNothing(IGVMESLimitTable) Then
                                ReDim Preserve IGVMESLimitTable(1, 0)
                            Else
                                ReDim Preserve IGVMESLimitTable(1, IGVMESLimitTable.GetUpperBound(1) + 1)
                            End If
                            IGVMESLimitTable(0, IGVMESLimitTable.GetUpperBound(1)) = line.XValue
                            IGVMESLimitTable(1, IGVMESLimitTable.GetUpperBound(1)) = line.YValue
                        Case "N2 MES"
                            If IsNothing(N2MESLimitTable) Then
                                ReDim Preserve N2MESLimitTable(1, 0)
                            Else
                                ReDim Preserve N2MESLimitTable(1, N2MESLimitTable.GetUpperBound(1) + 1)
                            End If
                            N2MESLimitTable(0, N2MESLimitTable.GetUpperBound(1)) = line.XValue
                            N2MESLimitTable(1, N2MESLimitTable.GetUpperBound(1)) = line.YValue
                        Case "N2 MAX IGV"
                            If IsNothing(N2MaxIGVLimitTable) Then
                                ReDim Preserve N2MaxIGVLimitTable(1, 0)
                            Else
                                ReDim Preserve N2MaxIGVLimitTable(1, N2MaxIGVLimitTable.GetUpperBound(1) + 1)
                            End If
                            N2MaxIGVLimitTable(0, N2MaxIGVLimitTable.GetUpperBound(1)) = line.XValue
                            N2MaxIGVLimitTable(1, N2MaxIGVLimitTable.GetUpperBound(1)) = line.YValue
                        Case "P17@P1=14.2 Max IGV"
                            If IsNothing(Pt17MaxIGV142LimitTable) Then
                                ReDim Preserve Pt17MaxIGV142LimitTable(1, 0)
                            Else
                                ReDim Preserve Pt17MaxIGV142LimitTable(1, Pt17MaxIGV142LimitTable.GetUpperBound(1) + 1)
                            End If
                            Pt17MaxIGV142LimitTable(0, Pt17MaxIGV142LimitTable.GetUpperBound(1)) = line.XValue
                            Pt17MaxIGV142LimitTable(1, Pt17MaxIGV142LimitTable.GetUpperBound(1)) = line.YValue
                        Case "P17@P1=14.7 Max IGV"
                            If IsNothing(Pt17MaxIGV147LimitTable) Then
                                ReDim Preserve Pt17MaxIGV147LimitTable(1, 0)
                            Else
                                ReDim Preserve Pt17MaxIGV147LimitTable(1, Pt17MaxIGV147LimitTable.GetUpperBound(1) + 1)
                            End If
                            Pt17MaxIGV147LimitTable(0, Pt17MaxIGV147LimitTable.GetUpperBound(1)) = line.XValue
                            Pt17MaxIGV147LimitTable(1, Pt17MaxIGV147LimitTable.GetUpperBound(1)) = line.YValue
                        Case "P17@P1=14.95 Max IGV"
                            If IsNothing(Pt17MaxIGV1495LimitTable) Then
                                ReDim Preserve Pt17MaxIGV1495LimitTable(1, 0)
                            Else
                                ReDim Preserve Pt17MaxIGV1495LimitTable(1, Pt17MaxIGV1495LimitTable.GetUpperBound(1) + 1)
                            End If
                            Pt17MaxIGV1495LimitTable(0, Pt17MaxIGV1495LimitTable.GetUpperBound(1)) = line.XValue
                            Pt17MaxIGV1495LimitTable(1, Pt17MaxIGV1495LimitTable.GetUpperBound(1)) = line.YValue
                        Case "P17@P1=14.2 MES"
                            If IsNothing(Pt17MES142LimitTable) Then
                                ReDim Preserve Pt17MES142LimitTable(1, 0)
                            Else
                                ReDim Preserve Pt17MES142LimitTable(1, Pt17MES142LimitTable.GetUpperBound(1) + 1)
                            End If
