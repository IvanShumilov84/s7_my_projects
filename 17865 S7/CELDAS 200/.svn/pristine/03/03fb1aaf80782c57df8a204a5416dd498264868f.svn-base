                        Case "P17@P1=14.7 MES"
                            If IsNothing(Pt17MES147LimitTable) Then
                                ReDim Preserve Pt17MES147LimitTable(1, 0)
                            Else
                                ReDim Preserve Pt17MES147LimitTable(1, Pt17MES147LimitTable.GetUpperBound(1) + 1)
                            End If
                            Pt17MES147LimitTable(0, Pt17MES147LimitTable.GetUpperBound(1)) = line.XValue
                            Pt17MES147LimitTable(1, Pt17MES147LimitTable.GetUpperBound(1)) = line.YValue
                        Case "P17@P1=14.95 MES"
                            If IsNothing(Pt17MES1495LimitTable) Then
                                ReDim Preserve Pt17MES1495LimitTable(1, 0)
                            Else
