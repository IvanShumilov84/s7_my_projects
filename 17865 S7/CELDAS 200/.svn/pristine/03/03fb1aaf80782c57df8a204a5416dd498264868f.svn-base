                                ReDim Preserve W17MaxECS147LimitTable(1, W17MaxECS147LimitTable.GetUpperBound(1) + 1)
                            End If
                            W17MaxECS147LimitTable(0, W17MaxECS147LimitTable.GetUpperBound(1)) = line.XValue
                            W17MaxECS147LimitTable(1, W17MaxECS147LimitTable.GetUpperBound(1)) = line.YValue
                        Case "W17@P1=14.95 Max ECS"
                            If IsNothing(W17MaxECS1495LimitTable) Then
                                ReDim Preserve W17MaxECS1495LimitTable(1, 0)
                            Else
                                ReDim Preserve W17MaxECS1495LimitTable(1, W17MaxECS1495LimitTable.GetUpperBound(1) + 1)
                            End If
                            W17MaxECS1495LimitTable(0, W17MaxECS1495LimitTable.GetUpperBound(1)) = line.XValue
                            W17MaxECS1495LimitTable(1, W17MaxECS1495LimitTable.GetUpperBound(1)) = line.YValue
                        Case "W17@P1=14.2 Max IGV"
                            If IsNothing(W17MaxIGV142LimitTable) Then
