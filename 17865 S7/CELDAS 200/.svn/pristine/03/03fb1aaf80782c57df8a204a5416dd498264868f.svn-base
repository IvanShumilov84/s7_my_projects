                End Try

            End If
        End Sub

        Private Sub OnQ17CrackingPoint(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                Dim IGVPos As Double = IGV_POS_PCT.Value.ToDouble()

                If CELProject.IsTrue(newVal) Then

                    If IGVPos >= 18.0 And IGVPos <= 20.0 Then
                        TestCase = 1
                        InitDVA = DIVERTER_VALVE_ANGLE_DEG.Value.ToDouble()
                        Q17_CRACKING_PT_19DEG.Value = New KineticaRT.Values.Text("")
                    ElseIf IGVPos >= 76.0 And IGVPos <= 78.0 Then
                        TestCase = 2
                        InitDVA = DIVERTER_VALVE_ANGLE_DEG.Value.ToDouble()
                        Q17_CRACKING_PT_77DEG.Value = New KineticaRT.Values.Text("")
                    Else
                        TestCase = -1
                        MessageBox.Show("Position de l'IGV invalide", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        PERF_Q17_CRACKING_PT_BTN.Value = Values.False
                    End If
                Else
                    TestCase = -1
                End If
                Q17CrackingPointInProgress = TestCase > 0

            Catch ex As Exception
                MessageBox.Show("OnQ17CrackingPoint: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Function CalculateLimits(ByRef TSN As Double, ByRef TInlet As Double, PInlet As Double, TestStep As Integer, LimitType As Integer) As Double
            Dim BaseLimit As Double
            Dim DeltaLimit As Double
            Dim Limit As Double
            Dim TempLimit1 As Double
            Dim TempLimit2 As Double
            Dim TempLimit3 As Double
            Dim TempTable(1, 2) As Double
            TempTable(0, 0) = 14.2
            TempTable(0, 1) = 14.7
            TempTable(0, 2) = 14.95

            Try
                Select Case LimitType
                    Case eTestLimitTypePW901A.EGT
                        Select Case TestStep
                            Case eTestStepPW901A.MAX_IGV
                                BaseLimit = CELProject.Interpolation_1D(TInlet, EGTMaxIGVLimitTable, 1, True)
                            Case eTestStepPW901A.MES
                                BaseLimit = CELProject.Interpolation_1D(TInlet, EGTMESLimitTable, 1, True)
                        End Select
                        DeltaLimit = CELProject.Interpolation_1D(TSN, DeltaEGTLimitTable, 1, True)
                        Limit = BaseLimit + DeltaLimit
                    Case eTestLimitTypePW901A.IGV
                        Select Case TestStep
                            Case eTestStepPW901A.MAX_ECS
                                Limit = CELProject.Interpolation_1D(TInlet, IGVMaxECSLimitTable, 1, True)
                            Case eTestStepPW901A.MAX_IGV
                                Limit = CELProject.Interpolation_1D(TInlet, IGVMaxIGVLimitTable, 1, True)
                            Case eTestStepPW901A.MES
                                Limit = CELProject.Interpolation_1D(TInlet, IGVMESLimitTable, 1, True)
                        End Select
                    Case eTestLimitTypePW901A.N2
                        Select Case TestStep
                            Case eTestStepPW901A.MAX_IGV
                                BaseLimit = CELProject.Interpolation_1D(TInlet, N2MaxIGVLimitTable, 1, True)
                            Case eTestStepPW901A.MES
                                BaseLimit = CELProject.Interpolation_1D(TInlet, N2MESLimitTable, 1, True)
                        End Select
                        DeltaLimit = CELProject.Interpolation_1D(TSN, DeltaN2LimitTable, 1, True)
                        Limit = BaseLimit + DeltaLimit
                    Case eTestLimitTypePW901A.Pt17
                        Select Case TestStep
                            Case eTestStepPW901A.MAX_IGV
                                TempLimit1 = CELProject.Interpolation_1D(TInlet, Pt17MaxIGV142LimitTable, 1, True)
                                TempLimit2 = CELProject.Interpolation_1D(TInlet, Pt17MaxIGV147LimitTable, 1, True)
                                TempLimit3 = CELProject.Interpolation_1D(TInlet, Pt17MaxIGV1495LimitTable, 1, True)
                            Case eTestStepPW901A.MES
                                TempLimit1 = CELProject.Interpolation_1D(TInlet, Pt17MES142LimitTable, 1, True)
                                TempLimit3 = CELProject.Interpolation_1D(TInlet, Pt17MES1495LimitTable, 1, True)
                                If TInlet < Pt17MES147LimitTable(0, 0) Then 'Pt17 curve for P1 = 14.7 is shorter than the two other curves. In the case where we are outside that curve, take curve P = 14.95 twice
                                    TempLimit2 = TempLimit3
                                    TempTable(0, 1) = TempTable(0, 2)
                                Else
                                    TempLimit2 = CELProject.Interpolation_1D(TInlet, Pt17MES147LimitTable, 1, True)
                                End If
                        End Select
                        TempTable(1, 0) = TempLimit1
                        TempTable(1, 1) = TempLimit2
                        TempTable(1, 2) = TempLimit3
                        BaseLimit = CELProject.Interpolation_1D(PInlet, TempTable, 1, True)
                        DeltaLimit = CELProject.Interpolation_1D(TSN, DeltaPt17LimitTable, 1, True)
                        Limit = BaseLimit + DeltaLimit
                    Case eTestLimitTypePW901A.W17
                        Select Case TestStep
                            Case eTestStepPW901A.MAX_ECS
                                TempLimit1 = CELProject.Interpolation_1D(TInlet, W17MaxECS142LimitTable, 1, True)
                                TempLimit2 = CELProject.Interpolation_1D(TInlet, W17MaxECS147LimitTable, 1, True)
                                TempLimit3 = CELProject.Interpolation_1D(TInlet, W17MaxECS1495LimitTable, 1, True)
                            Case eTestStepPW901A.MAX_IGV
                                TempLimit1 = CELProject.Interpolation_1D(TInlet, W17MaxIGV142LimitTable, 1, True)
                                TempLimit2 = CELProject.Interpolation_1D(TInlet, W17MaxIGV147LimitTable, 1, True)
                                TempLimit3 = CELProject.Interpolation_1D(TInlet, W17MaxIGV1495LimitTable, 1, True)
                        End Select
                        TempTable(1, 0) = TempLimit1
                        TempTable(1, 1) = TempLimit2
                        TempTable(1, 2) = TempLimit3
                        BaseLimit = CELProject.Interpolation_1D(PInlet, TempTable, 1, True)
                        DeltaLimit = CELProject.Interpolation_1D(TSN, DeltaW17LimitTable, 1, True)
                        Limit = BaseLimit * (1 + DeltaLimit / 100.0)
                    Case eTestLimitTypePW901A.Wf
                        TempLimit1 = CELProject.Interpolation_1D(TInlet, Wf142MaxECSLimitTable, 1, True)
                        TempLimit2 = CELProject.Interpolation_1D(TInlet, Wf147MaxECSLimitTable, 1, True)
                        TempLimit3 = CELProject.Interpolation_1D(TInlet, Wf1495MaxECSLimitTable, 1, True)
                        TempTable(1, 0) = TempLimit1
                        TempTable(1, 1) = TempLimit2
                        TempTable(1, 2) = TempLimit3
                        BaseLimit = CELProject.Interpolation_1D(PInlet, TempTable, 1, True)
                        DeltaLimit = CELProject.Interpolation_1D(TSN, DeltaWfLimitTable, 1, True)
                        Limit = BaseLimit * (1 + DeltaLimit / 100.0)
                End Select

                Return Limit

            Catch ex As Exception
                MessageBox.Show("CalculateLimits" + ex.ToString(), "Error")
            End Try
        End Function

        Private Sub CaptureDVTransit()
            Try
                Dim DVADeviation As Double

                DVADeviation = Math.Abs(InitDVA - DIVERTER_VALVE_ANGLE_DEG.Value.ToDouble())

                If (DVADeviation >= 0.5) Then 'If transition occurs
                    'Capture the data and stop watching for transition
                    If TestCase = 1 Then
                        Q17_CRACKING_PT_19DEG.Value = New KineticaRT.Values.Double(Q17.Value.ToDouble())
                    ElseIf TestCase = 2 Then
                        Q17_CRACKING_PT_77DEG.Value = New KineticaRT.Values.Double(Q17.Value.ToDouble())
                    End If

                    Q17CrackingPointInProgress = False

                    'Reset button
                    PERF_Q17_CRACKING_PT_BTN.Value = Values.False
                End If
            Catch ex As Exception
                MessageBox.Show("CaptureDVTransit" + ex.ToString(), "Error")
            End Try
        End Sub

        Private Function Compute_BleedAirFlow(ByVal TOrifice_DEGF As Double, _
                                              ByVal POrifice_PSIA As Double, _
                                              ByVal POrificeDelta_PSID As Double) As Double
            Try

                If CELProject.IsTrue(BLEED_BTN.Value) Then

                    Dim BleedAirFLow As Double = CELProject.GetBleedAirFlow( _
                                                                            EngineConfiguration.DuctDiameter, _
                                                                            EngineConfiguration.DuctDiameterUnit, _
                                                                            EngineConfiguration.OrificeDiameter, _
                                                                            EngineConfiguration.OrificeDiameterUnit, _
                                                                            TOrifice_DEGF, _
                                                                            CELDAS.eTemperature.Fahrenheit, _
                                                                            POrifice_PSIA, _
                                                                            CELDAS.ePressure.PSI, _
                                                                            POrificeDelta_PSID, _
                                                                            CELDAS.ePressure.PSI, _
                                                                            EngineConfiguration.OrificeThinkness, _
                                                                            EngineConfiguration.OrificeThinknessUnit, _
                                                                            EngineConfiguration.TapArrangement, _
                                                                            CELDAS.eFlowMass.LbByMin)

                    Return BleedAirFLow

                Else
                    Return 0.0
                End If

            Catch Ex As Exception
                'Log error
                MessageBox.Show("Error in Engine_Sequence.Compute_BleedAirFlow: " & Ex.ToString)
            End Try

        End Function

        Private Sub OnAcceleratingTime_Calc(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If (sender.Name = "START_BTN") Then
                    If CELProject.IsTrue(newVal) Then
                        ts_accelerating_time = New System.TimeSpan(0, 0, 0, 0, 0)
                        AcceleratingTime_Start = Now
                        APU_ACCELERATING = True
                    End If
                End If

                If (sender.Name = "APU_READY_IND") Then
                    If CELProject.IsTrue(newVal) Then
                        APU_ACCELERATING = False
                    End If
                End If

                If (sender.Name = "RUN_STOP_BTN") Then
                    If CELProject.IsFalse(newVal) Then
                        APU_ACCELERATING = False
                    End If
                End If

                If (sender.Name = "STARTER_RECTIFIER_BTN") Then
                    If CELProject.IsFalse(newVal) And N1_PCT.Value.ToDouble() < 5.0 Then
                        APU_ACCELERATING = False
                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("OnAcceleratingTime_Calc: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

