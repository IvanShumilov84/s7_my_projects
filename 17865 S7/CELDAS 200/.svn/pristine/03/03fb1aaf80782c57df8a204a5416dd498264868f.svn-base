                            Else
                                ReDim Preserve Wf142MaxECSLimitTable(1, Wf142MaxECSLimitTable.GetUpperBound(1) + 1)
                            End If
                            Wf142MaxECSLimitTable(0, Wf142MaxECSLimitTable.GetUpperBound(1)) = line.XValue
                            Wf142MaxECSLimitTable(1, Wf142MaxECSLimitTable.GetUpperBound(1)) = line.YValue
                        Case "Wf@P1=14.7 Max ECS"
                            If IsNothing(Wf147MaxECSLimitTable) Then
                                ReDim Preserve Wf147MaxECSLimitTable(1, 0)
                            Else
                                ReDim Preserve Wf147MaxECSLimitTable(1, Wf147MaxECSLimitTable.GetUpperBound(1) + 1)
                            End If
                            Wf147MaxECSLimitTable(0, Wf147MaxECSLimitTable.GetUpperBound(1)) = line.XValue
                            Wf147MaxECSLimitTable(1, Wf147MaxECSLimitTable.GetUpperBound(1)) = line.YValue
                        Case "Wf@P1=14.95 Max ECS"
                            If IsNothing(Wf1495MaxECSLimitTable) Then
