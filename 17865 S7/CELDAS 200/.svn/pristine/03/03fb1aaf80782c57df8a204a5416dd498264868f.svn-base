                            Wf1495MaxECSLimitTable(0, Wf1495MaxECSLimitTable.GetUpperBound(1)) = line.XValue
                            Wf1495MaxECSLimitTable(1, Wf1495MaxECSLimitTable.GetUpperBound(1)) = line.YValue
                    End Select
                Next

                If Not (CELProject.PERF_TEST_STEP_NB Is Nothing) Then
                    CELProject.PERF_TEST_STEP_NB.Value = Values.Zero
                End If

            Catch Ex As Exception
                MessageBox.Show("Init_Engine_Channels_Value: " & Ex.ToString())
            End Try

        End Sub

        Protected Overrides Sub Init_Engine_Controls()

            Try
                TestStep_List.SelectedIndex = 0

                'This is a workaround to correctly initialize the display of the speed buttons
                Speed_Control_Frame = Engine_Control_Frame.FindObject("fraSpeedControl")
                btnN1_RAISE_BTN = Speed_Control_Frame.FindObject("btnN1Raise")
                btnN2_RAISE_BTN = Speed_Control_Frame.FindObject("btnN2Raise")
                btnN1_LOWER_BTN = Speed_Control_Frame.FindObject("btnN1Lower")
                btnN2_LOWER_BTN = Speed_Control_Frame.FindObject("btnN2Lower")

                btnN1_RAISE_BTN.PictureEnabled = False
                btnN1_RAISE_BTN.PictureEnabled = True
                btnN2_RAISE_BTN.PictureEnabled = False
                btnN2_RAISE_BTN.PictureEnabled = True
                btnN1_LOWER_BTN.PictureEnabled = False
                btnN1_LOWER_BTN.PictureEnabled = True
                btnN2_LOWER_BTN.PictureEnabled = False
                btnN2_LOWER_BTN.PictureEnabled = True

            Catch ex As Exception
                MessageBox.Show("PW901A_Sequence.Init_Engine_Controls() + " + ex.ToString())
            End Try

        End Sub
        Protected Overrides Sub SetTestStepList(value As Integer)

        End Sub
		Private Sub RevimaWriteRunningTime(ByVal excelSheets As Excel.Sheets)

			Try
				Dim excelWorksheet As Excel.Worksheet = excelSheets.Item("APU CONDITION TEST SHEET")

				Dim FuelUsed As Double = PERF_PREVIOUS_TEST_FUEL_USED.Value.ToDouble() + LOG_PERF_FUEL_USED_LITERS.Value.ToDouble()
				Dim OperatingTime As Double = PERF_PREVIOUS_TEST_MINUTES.Value.ToDouble() + LOG_PERF_OPERATING_TIME_MINUTES.Value.ToDouble()

				'Running Time, cellule I8
				excelWorksheet.Cells(8, 9).Value = OperatingTime.ToString(LOG_PERF_OPERATING_TIME_MINUTES.Format) + " " + LOG_PERF_OPERATING_TIME_MINUTES.Units.ToString()

				'Fuel Used, cellule I11
				excelWorksheet.Cells(11, 9).NumberFormat = "@"
				excelWorksheet.Cells(11, 9).Value = FuelUsed.ToString(LOG_PERF_FUEL_USED_LITERS.Format) + " " + LOG_PERF_FUEL_USED_LITERS.Units.ToString()

			Catch Ex As Exception
				MessageBox.Show("RevimaWriteRunningTime: " & Ex.ToString())
			End Try
		End Sub

        Protected Overrides Function CreateCustomHeaderLogFile(ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Try
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Date Time:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Cond#:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Comment:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                ExcelWorksheet.Rows(RowIndex).RowHeight = 65.25
                ExcelWorksheet.Rows(RowIndex).VerticalAlignment = Excel.XlVAlign.xlVAlignTop
                ExcelWorksheet.Rows(RowIndex).WrapText = True

                Return True

            Catch ex As Exception
                MessageBox.Show("CreateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

		Private Function CreateStandardCELPerformanceFile(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim Column As Integer
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreateStandardCELPerformanceFile = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            Try
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    excelWorksheet = excelSheets.Item("SUMMARY")

                    'HEADER

                    'Serial Number
                    excelWorksheet.Cells(5, 28).NumberFormat = "@"
                    excelWorksheet.Cells(5, 28).Value = UserInputs.EngineSerialNumber

                    'Work Order
                    excelWorksheet.Cells(6, 28).NumberFormat = "@"
                    excelWorksheet.Cells(6, 28).Value = UserInputs.WorkOrder

                    'ECB Serial Number
                    excelWorksheet.Cells(7, 28).NumberFormat = "@"
                    excelWorksheet.Cells(7, 28).Value = UserInputs.ECBSerialNumber

                    'Exhaust Duct Serial Number
                    excelWorksheet.Cells(8, 28).NumberFormat = "@"
                    excelWorksheet.Cells(8, 28).Value = UserInputs.ExhaustDuctSerialNumber

                    'Bellmouth Serial Number
                    excelWorksheet.Cells(9, 28).NumberFormat = "@"
                    excelWorksheet.Cells(9, 28).Value = UserInputs.BellmouthSerialNumber

                    'Bleed Duct Serial Number
                    excelWorksheet.Cells(10, 28).NumberFormat = "@"
                    excelWorksheet.Cells(10, 28).Value = UserInputs.BleedDuctSerialNumber

                    'Starter Serial Number
                    excelWorksheet.Cells(11, 28).NumberFormat = "@"
                    excelWorksheet.Cells(11, 28).Value = UserInputs.StarterSerialNumber

                    'Dyno 1 Serial Number
                    excelWorksheet.Cells(12, 28).NumberFormat = "@"
                    excelWorksheet.Cells(12, 28).Value = UserInputs.Dyno1SerialNumber

                    'Dyno 2 Serial Number
                    excelWorksheet.Cells(13, 28).NumberFormat = "@"
                    excelWorksheet.Cells(13, 28).Value = UserInputs.Dyno2SerialNumber

                    'GG Vibration Pickup Serial Number
                    excelWorksheet.Cells(5, 96).NumberFormat = "@"
                    excelWorksheet.Cells(5, 96).Value = UserInputs.GGVibPickupSerialNumber

                    'LGB Vibration Pickup Serial Number
                    excelWorksheet.Cells(6, 96).NumberFormat = "@"
                    excelWorksheet.Cells(6, 96).Value = UserInputs.LGBVibPickupSerialNumber

                    'Oil Type
                    excelWorksheet.Cells(7, 96).NumberFormat = "@"
                    excelWorksheet.Cells(7, 96).Value = UserInputs.OilType

                    'TSN
                    excelWorksheet.Cells(8, 96).NumberFormat = "@"
                    excelWorksheet.Cells(8, 96).Value = UserInputs.TimeSinceNewOrOverhaul

                    'CSN
                    excelWorksheet.Cells(9, 96).NumberFormat = "@"
                    excelWorksheet.Cells(9, 96).Value = UserInputs.CyclesSinceNew

                    'Reason
                    excelWorksheet.Cells(10, 96).NumberFormat = "@"
                    excelWorksheet.Cells(10, 96).Value = UserInputs.Reason

                    'Test Type
                    excelWorksheet.Cells(11, 96).NumberFormat = "@"
                    excelWorksheet.Cells(11, 96).Value = UserInputs.TestType

                    'Load Cell 1 Serial Number
                    excelWorksheet.Cells(12, 96).NumberFormat = "@"
                    excelWorksheet.Cells(12, 96).Value = UserInputs.LoadCell1SerialNumber

                    'Load Cell 1 Serial Number
                    excelWorksheet.Cells(13, 96).NumberFormat = "@"
                    excelWorksheet.Cells(13, 96).Value = UserInputs.LoadCell2SerialNumber

                    'Date
                    excelWorksheet.Cells(14, 96).NumberFormat = "@"
                    excelWorksheet.Cells(14, 96).Value = Format(Now, "d MMMM yyyy")

                    excelWorksheet = excelSheets.Item("ACCEPTANCE")

                    'Document Number
                    excelWorksheet.Cells(42, 5).NumberFormat = "@"
                    excelWorksheet.Cells(42, 5).Value = excelWorksheet.Cells(42, 5).Value.ToString() + Custom_Parameters("APUTestedAccordingTo").ToString()

                End If

				'Calculate Limits
				Select Case TestStepNumber
					Case eTestStepPW901A.MAX_IGV
                        IGV_LIMIT_PCT.Value = New KineticaRT.Values.Double(CalculateLimits(UserInputs.TimeSinceNewOrOverhaul, LOG_PERF_T_TT1_AVG_DEGC.Value.ToDouble(), _
                                                                                           LOG_PERF_P_BARO_PSIA.Value.ToDouble(), TestStepNumber, eTestLimitTypePW901A.IGV))
                        N2_LIMIT_RPM.Value = New KineticaRT.Values.Double(CalculateLimits(UserInputs.TimeSinceNewOrOverhaul, LOG_PERF_T_TT1_AVG_DEGC.Value.ToDouble(), _
                                                                                          LOG_PERF_P_BARO_PSIA.Value.ToDouble(), TestStepNumber, eTestLimitTypePW901A.N2))
						P_PT17_LIMIT_PSIA.Value = New KineticaRT.Values.Double(CalculateLimits(UserInputs.TimeSinceNewOrOverhaul, LOG_PERF_T_TT1_AVG_DEGC.Value.ToDouble(), _
																							   LOG_PERF_P_BARO_PSIA.Value.ToDouble(), TestStepNumber, eTestLimitTypePW901A.Pt17))
                        W17_LIMIT_LBMIN.Value = New KineticaRT.Values.Double(CalculateLimits(UserInputs.TimeSinceNewOrOverhaul, LOG_PERF_T_TT1_AVG_DEGC.Value.ToDouble(), _
                                                                                             LOG_PERF_P_BARO_PSIA.Value.ToDouble(), TestStepNumber, eTestLimitTypePW901A.W17))
                        T_EGT_LIMIT_DEGC.Value = New KineticaRT.Values.Double(CalculateLimits(UserInputs.TimeSinceNewOrOverhaul, LOG_PERF_T_TT1_AVG_DEGC.Value.ToDouble(), _
                                                                                             LOG_PERF_P_BARO_PSIA.Value.ToDouble(), TestStepNumber, eTestLimitTypePW901A.EGT))
					Case eTestStepPW901A.MAX_ECS
						IGV_LIMIT_PCT.Value = New KineticaRT.Values.Double(CalculateLimits(UserInputs.TimeSinceNewOrOverhaul, LOG_PERF_T_TT1_AVG_DEGC.Value.ToDouble(), _
																						   LOG_PERF_P_BARO_PSIA.Value.ToDouble(), TestStepNumber, eTestLimitTypePW901A.IGV))
						W17_LIMIT_LBMIN.Value = New KineticaRT.Values.Double(CalculateLimits(UserInputs.TimeSinceNewOrOverhaul, LOG_PERF_T_TT1_AVG_DEGC.Value.ToDouble(), _
																							 LOG_PERF_P_BARO_PSIA.Value.ToDouble(), TestStepNumber, eTestLimitTypePW901A.W17))
						WF_LIMIT_PPH.Value = New KineticaRT.Values.Double(CalculateLimits(UserInputs.TimeSinceNewOrOverhaul, LOG_PERF_T_TT1_AVG_DEGC.Value.ToDouble(), _
																						  LOG_PERF_P_BARO_PSIA.Value.ToDouble(), TestStepNumber, eTestLimitTypePW901A.Wf))
					Case eTestStepPW901A.MES
						IGV_LIMIT_PCT.Value = New KineticaRT.Values.Double(CalculateLimits(UserInputs.TimeSinceNewOrOverhaul, LOG_PERF_T_TT1_AVG_DEGC.Value.ToDouble(), _
																						   LOG_PERF_P_BARO_PSIA.Value.ToDouble(), TestStepNumber, eTestLimitTypePW901A.IGV))
						N2_LIMIT_RPM.Value = New KineticaRT.Values.Double(CalculateLimits(UserInputs.TimeSinceNewOrOverhaul, LOG_PERF_T_TT1_AVG_DEGC.Value.ToDouble(), _
																						  LOG_PERF_P_BARO_PSIA.Value.ToDouble(), TestStepNumber, eTestLimitTypePW901A.N2))
						P_PT17_LIMIT_PSIA.Value = New KineticaRT.Values.Double(CalculateLimits(UserInputs.TimeSinceNewOrOverhaul, LOG_PERF_T_TT1_AVG_DEGC.Value.ToDouble(), _
																							   LOG_PERF_P_BARO_PSIA.Value.ToDouble(), TestStepNumber, eTestLimitTypePW901A.Pt17))
						T_EGT_LIMIT_DEGC.Value = New KineticaRT.Values.Double(CalculateLimits(UserInputs.TimeSinceNewOrOverhaul, LOG_PERF_T_TT1_AVG_DEGC.Value.ToDouble(), _
																							  LOG_PERF_P_BARO_PSIA.Value.ToDouble(), TestStepNumber, eTestLimitTypePW901A.EGT))

				End Select

				'Summary
				excelWorksheet = excelSheets.Item("SUMMARY")
				Select Case TestStepNumber
					Case eTestStepPW901A.MAX_IGV
						Column = 81
                        excelWorksheet.Cells(24, Column).Value = IGV_LIMIT_PCT.Value.ToString(IGV_LIMIT_PCT.Format, Nothing) + " % MINIMUM"
                        excelWorksheet.Cells(27, Column).Value = N2_LIMIT_RPM.Value.ToString(N2_LIMIT_RPM.Format, Nothing) + " RPM MAXIMUM"
                        excelWorksheet.Cells(28, Column).Value = T_EGT_LIMIT_DEGC.Value.ToString(T_EGT_LIMIT_DEGC.Format, Nothing) + " °C MAXIMUM"
						excelWorksheet.Cells(30, Column).Value = P_PT17_LIMIT_PSIA.Value.ToString(P_PT17_LIMIT_PSIA.Format, Nothing) + " PSIA MINIMUM"
						excelWorksheet.Cells(32, Column).Value = W17_LIMIT_LBMIN.Value.ToString(W17_LIMIT_LBMIN.Format, Nothing) + " LB/MIN MINIMUM"

						Column = 95
						excelWorksheet.Cells(22, Column).Value = LOG_PERF_P_LGB_PSIA.Value.ToString(LOG_PERF_P_LGB_PSIA.Format, Nothing)
						excelWorksheet.Cells(23, Column).Value = LOG_PERF_T_TT1_AVG_DEGC.Value.ToString(LOG_PERF_T_TT1_AVG_DEGC.Format, Nothing)
						excelWorksheet.Cells(24, Column).Value = LOG_PERF_IGV_POS_PCT.Value.ToString(LOG_PERF_IGV_POS_PCT.Format, Nothing)
						excelWorksheet.Cells(25, Column).Value = LOG_PERF_Q17.Value.ToString(LOG_PERF_Q17.Format, Nothing)
						excelWorksheet.Cells(26, Column).Value = LOG_PERF_LOAD_TOTAL_KVA.Value.ToString(LOG_PERF_LOAD_TOTAL_KVA.Format, Nothing)
                        excelWorksheet.Cells(27, Column).Value = LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing)
                        excelWorksheet.Cells(28, Column).Value = LOG_PERF_T_EGT_DEGC.Value.ToString(LOG_PERF_T_EGT_DEGC.Format, Nothing)
                        excelWorksheet.Cells(29, Column).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)
                        excelWorksheet.Cells(30, Column).Value = LOG_PERF_P_PT17_PSIA.Value.ToString(LOG_PERF_P_PT17_PSIA.Format, Nothing)
                        excelWorksheet.Cells(31, Column).Value = LOG_PERF_T_T17_DEGC.Value.ToString(LOG_PERF_T_T17_DEGC.Format, Nothing)
                        excelWorksheet.Cells(32, Column).Value = LOG_PERF_W17_LBMIN.Value.ToString(LOG_PERF_W17_LBMIN.Format, Nothing)

                        'We also proceed with step 12.H.(d) which corresponds to the calculation of N2 and EGT for the data plate
                        '49-21-02 Page 534
                        'N2 = 29100 - N2 (target corrresponding to actual inlet air temperature of Figure 104) + N2 (actual)
                        'EGT = 514 - EGT ((target corrresponding to actual inlet air temperature of Figure 104)) + EGT (actual)

                        N2_DATAPLATE_RPM.Value = New KineticaRT.Values.Double(29000 - CELProject.Interpolation_1D(LOG_PERF_T_TT1_AVG_DEGC.Value.ToDouble(), N2MaxIGVLimitTable, 1, True) + LOG_PERF_N2_RPM.Value.ToDouble)
                        T_EGT_DATAPLATE_DEGC.Value = New KineticaRT.Values.Double(514 - CELProject.Interpolation_1D(LOG_PERF_T_TT1_AVG_DEGC.Value.ToDouble(), EGTMaxIGVLimitTable, 1, True) + LOG_PERF_T_EGT_DEGC.Value.ToDouble)

					Case eTestStepPW901A.MAX_ECS
						Column = 53
						excelWorksheet.Cells(24, Column).Value = IGV_LIMIT_PCT.Value.ToString(IGV_LIMIT_PCT.Format, Nothing) + " % MINIMUM"
						excelWorksheet.Cells(29, Column).Value = WF_LIMIT_PPH.Value.ToString(WF_LIMIT_PPH.Format, Nothing) + " LB/HR MAXIMUM"
                        excelWorksheet.Cells(32, Column).Value = W17_LIMIT_LBMIN.Value.ToString(W17_LIMIT_LBMIN.Format, Nothing) + " LB/MIN MINIMUM"

						Column = 67
						excelWorksheet.Cells(22, Column).Value = LOG_PERF_P_LGB_PSIA.Value.ToString(LOG_PERF_P_LGB_PSIA.Format, Nothing)
						excelWorksheet.Cells(23, Column).Value = LOG_PERF_T_TT1_AVG_DEGC.Value.ToString(LOG_PERF_T_TT1_AVG_DEGC.Format, Nothing)
						excelWorksheet.Cells(24, Column).Value = LOG_PERF_IGV_POS_PCT.Value.ToString(LOG_PERF_IGV_POS_PCT.Format, Nothing)
						excelWorksheet.Cells(25, Column).Value = LOG_PERF_Q17.Value.ToString(LOG_PERF_Q17.Format, Nothing)
						excelWorksheet.Cells(26, Column).Value = LOG_PERF_LOAD_TOTAL_KVA.Value.ToString(LOG_PERF_LOAD_TOTAL_KVA.Format, Nothing)
                        excelWorksheet.Cells(27, Column).Value = LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing)
                        excelWorksheet.Cells(28, Column).Value = LOG_PERF_T_EGT_DEGC.Value.ToString(LOG_PERF_T_EGT_DEGC.Format, Nothing)
                        excelWorksheet.Cells(29, Column).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)
                        excelWorksheet.Cells(30, Column).Value = LOG_PERF_P_PT17_PSIA.Value.ToString(LOG_PERF_P_PT17_PSIA.Format, Nothing)
                        excelWorksheet.Cells(31, Column).Value = LOG_PERF_T_T17_DEGC.Value.ToString(LOG_PERF_T_T17_DEGC.Format, Nothing)
                        excelWorksheet.Cells(32, Column).Value = LOG_PERF_W17_LBMIN.Value.ToString(LOG_PERF_W17_LBMIN.Format, Nothing)
					Case eTestStepPW901A.MES
						Column = 109
						excelWorksheet.Cells(24, Column).Value = IGV_LIMIT_PCT.Value.ToString(IGV_LIMIT_PCT.Format, Nothing) + " % MINIMUM"
						excelWorksheet.Cells(27, Column).Value = N2_LIMIT_RPM.Value.ToString(N2_LIMIT_RPM.Format, Nothing) + " RPM MAXIMUM"
						excelWorksheet.Cells(28, Column).Value = T_EGT_LIMIT_DEGC.Value.ToString(T_EGT_LIMIT_DEGC.Format, Nothing) + " °C MAXIMUM"
						excelWorksheet.Cells(30, Column).Value = P_PT17_LIMIT_PSIA.Value.ToString(P_PT17_LIMIT_PSIA.Format, Nothing) + " PSIA MINIMUM"

						Column = 123
						excelWorksheet.Cells(22, Column).Value = LOG_PERF_P_LGB_PSIA.Value.ToString(LOG_PERF_P_LGB_PSIA.Format, Nothing)
						excelWorksheet.Cells(23, Column).Value = LOG_PERF_T_TT1_AVG_DEGC.Value.ToString(LOG_PERF_T_TT1_AVG_DEGC.Format, Nothing)
						excelWorksheet.Cells(24, Column).Value = LOG_PERF_IGV_POS_PCT.Value.ToString(LOG_PERF_IGV_POS_PCT.Format, Nothing)
						excelWorksheet.Cells(25, Column).Value = LOG_PERF_Q17.Value.ToString(LOG_PERF_Q17.Format, Nothing)
						excelWorksheet.Cells(26, Column).Value = LOG_PERF_LOAD_TOTAL_KVA.Value.ToString(LOG_PERF_LOAD_TOTAL_KVA.Format, Nothing)
                        excelWorksheet.Cells(27, Column).Value = LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing)
                        excelWorksheet.Cells(28, Column).Value = LOG_PERF_T_EGT_DEGC.Value.ToString(LOG_PERF_T_EGT_DEGC.Format, Nothing)
                        excelWorksheet.Cells(29, Column).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)
                        excelWorksheet.Cells(30, Column).Value = LOG_PERF_P_PT17_PSIA.Value.ToString(LOG_PERF_P_PT17_PSIA.Format, Nothing)
                        excelWorksheet.Cells(31, Column).Value = LOG_PERF_T_T17_DEGC.Value.ToString(LOG_PERF_T_T17_DEGC.Format, Nothing)
                        excelWorksheet.Cells(32, Column).Value = LOG_PERF_W17_LBMIN.Value.ToString(LOG_PERF_W17_LBMIN.Format, Nothing)
				End Select

                TestProgress_RecordPerfStep(TestStepNumber)

				'Details Tab
				Select Case TestStepNumber

					Case eTestStepPW901A.NO_LOAD
						Column = 65
					Case eTestStepPW901A.MAX_IGV
						Column = 83
					Case eTestStepPW901A.MAX_ECS
						Column = 101
					Case eTestStepPW901A.MES
						Column = 119
				End Select

				Select Case TestStepNumber

					Case eTestStepPW901A.NO_LOAD, eTestStepPW901A.MAX_IGV, eTestStepPW901A.MAX_ECS, eTestStepPW901A.MES
						excelWorksheet = excelSheets.Item("DETAILS")

						excelWorksheet.Cells(18, Column).Value = Format(Now, "HH:mm")
						excelWorksheet.Cells(19, Column).Value = LOG_PERF_P_BARO_PSIA.Value.ToString(LOG_PERF_P_BARO_PSIA.Format, Nothing)
						excelWorksheet.Cells(20, Column).Value = LOG_PERF_N1_RPM.Value.ToString(LOG_PERF_N1_RPM.Format, Nothing)
                        'excelWorksheet.Cells(21, Column).Value = LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing)
						excelWorksheet.Cells(22, Column).Value = LOG_PERF_LOAD_TOTAL_KVA.Value.ToString(LOG_PERF_LOAD_TOTAL_KVA.Format, Nothing)
						excelWorksheet.Cells(23, Column).Value = LOG_PERF_IGV_POS_PCT.Value.ToString(LOG_PERF_IGV_POS_PCT.Format, Nothing)
						excelWorksheet.Cells(24, Column).Value = LOG_PERF_T_ORIFICE_DEGF.Value.ToString(LOG_PERF_T_ORIFICE_DEGF.Format, Nothing)
						excelWorksheet.Cells(25, Column).Value = LOG_PERF_P_ORIFICE_PSIA.Value.ToString(LOG_PERF_P_ORIFICE_PSIA.Format, Nothing)
						excelWorksheet.Cells(26, Column).Value = LOG_PERF_P_ORIFICE_DELTA_PSID.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_PSID.Format, Nothing)
                        'excelWorksheet.Cells(27, Column).Value = LOG_PERF_W17_LBMIN.Value.ToString(LOG_PERF_W17_LBMIN.Format, Nothing)
						excelWorksheet.Cells(28, Column).Value = LOG_PERF_Q17.Value.ToString(LOG_PERF_Q17.Format, Nothing)
                        'excelWorksheet.Cells(29, Column).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)
						excelWorksheet.Cells(30, Column).Value = LOG_PERF_P_FUEL_PSIG.Value.ToString(LOG_PERF_P_FUEL_PSIG.Format, Nothing)
						excelWorksheet.Cells(31, Column).Value = LOG_PERF_T_FUEL_FM1_DEGF.Value.ToString(LOG_PERF_T_FUEL_FM1_DEGF.Format, Nothing)
						excelWorksheet.Cells(32, Column).Value = LOG_PERF_T_TT1_1_DEGF.Value.ToString(LOG_PERF_T_TT1_1_DEGF.Format, Nothing)
						excelWorksheet.Cells(33, Column).Value = LOG_PERF_T_TT1_2_DEGF.Value.ToString(LOG_PERF_T_TT1_2_DEGF.Format, Nothing)
						excelWorksheet.Cells(34, Column).Value = LOG_PERF_T_TT1_3_DEGF.Value.ToString(LOG_PERF_T_TT1_3_DEGF.Format, Nothing)
						excelWorksheet.Cells(35, Column).Value = LOG_PERF_T_TT1_4_DEGF.Value.ToString(LOG_PERF_T_TT1_4_DEGF.Format, Nothing)
						excelWorksheet.Cells(36, Column).Value = LOG_PERF_T_TT1_AVG_DEGF.Value.ToString(LOG_PERF_T_TT1_AVG_DEGF.Format, Nothing)
						excelWorksheet.Cells(37, Column).Value = LOG_PERF_T_TT7_1_DEGF.Value.ToString(LOG_PERF_T_TT7_1_DEGF.Format, Nothing)
						excelWorksheet.Cells(38, Column).Value = LOG_PERF_T_TT7_2_DEGF.Value.ToString(LOG_PERF_T_TT7_2_DEGF.Format, Nothing)
						excelWorksheet.Cells(39, Column).Value = LOG_PERF_T_TT7_3_DEGF.Value.ToString(LOG_PERF_T_TT7_3_DEGF.Format, Nothing)
						excelWorksheet.Cells(40, Column).Value = LOG_PERF_T_TT7_4_DEGF.Value.ToString(LOG_PERF_T_TT7_4_DEGF.Format, Nothing)
						excelWorksheet.Cells(41, Column).Value = LOG_PERF_T_TT7_5_DEGF.Value.ToString(LOG_PERF_T_TT7_5_DEGF.Format, Nothing)
						excelWorksheet.Cells(42, Column).Value = LOG_PERF_T_TT7_6_DEGF.Value.ToString(LOG_PERF_T_TT7_6_DEGF.Format, Nothing)
						excelWorksheet.Cells(43, Column).Value = LOG_PERF_T_TT7_AVG_DEGF.Value.ToString(LOG_PERF_T_TT7_AVG_DEGF.Format, Nothing)
						excelWorksheet.Cells(44, Column).Value = LOG_PERF_T_EGT_DEGF.Value.ToString(LOG_PERF_T_EGT_DEGF.Format, Nothing)
						excelWorksheet.Cells(45, Column).Value = LOG_PERF_T_EGT_ENGINE_DEGF.Value.ToString(LOG_PERF_T_EGT_ENGINE_DEGF.Format, Nothing)
                        excelWorksheet.Cells(46, Column).Value = LOG_PERF_P1_MINUS_BARO_PSID.Value.ToString(LOG_PERF_P1_MINUS_BARO_PSID.Format, Nothing)
						excelWorksheet.Cells(47, Column).Value = LOG_PERF_P_AGB_PSIG.Value.ToString(LOG_PERF_P_AGB_PSIG.Format, Nothing)
						excelWorksheet.Cells(48, Column).Value = LOG_PERF_P_LGB_PSIG.Value.ToString(LOG_PERF_P_LGB_PSIG.Format, Nothing)
						excelWorksheet.Cells(49, Column).Value = LOG_PERF_T_TT17_AVG_DEGF.Value.ToString(LOG_PERF_T_TT17_AVG_DEGF.Format, Nothing)
                        'excelWorksheet.Cells(50, Column).Value = LOG_PERF_P_PT17_PSIA.Value.ToString(LOG_PERF_P_PT17_PSIA.Format, Nothing)
						excelWorksheet.Cells(51, Column).Value = LOG_PERF_T_MOT_DEGF.Value.ToString(LOG_PERF_T_MOT_DEGF.Format, Nothing)
						excelWorksheet.Cells(52, Column).Value = LOG_PERF_P_MOP_PSIG.Value.ToString(LOG_PERF_P_MOP_PSIG.Format, Nothing)
						excelWorksheet.Cells(53, Column).Value = LOG_PERF_VIB_LGB_MS2.Value.ToString(LOG_PERF_VIB_LGB_MS2.Format, Nothing)
						excelWorksheet.Cells(54, Column).Value = LOG_PERF_VIB_GG_CMS.Value.ToString(LOG_PERF_VIB_GG_CMS.Format, Nothing)
						excelWorksheet.Cells(55, Column).Value = LOG_PERF_SHP.Value.ToString(LOG_PERF_SHP.Format, Nothing)
						excelWorksheet.Cells(56, Column).Value = LOG_PERF_SHP_NORM.Value.ToString(LOG_PERF_SHP_NORM.Format, Nothing)
						excelWorksheet.Cells(57, Column).Value = LOG_PERF_W1.Value.ToString(LOG_PERF_W1.Format, Nothing)
						excelWorksheet.Cells(58, Column).Value = LOG_PERF_W1_NORM.Value.ToString(LOG_PERF_W1_NORM.Format, Nothing)
                        excelWorksheet.Cells(59, Column).Value = LOG_PERF_T7_NORM_DEGF.Value.ToString(LOG_PERF_T7_NORM_DEGF.Format, Nothing)
						excelWorksheet.Cells(60, Column).Value = LOG_PERF_N1_NORM.Value.ToString(LOG_PERF_N1_NORM.Format, Nothing)
						excelWorksheet.Cells(61, Column).Value = LOG_PERF_T6C.Value.ToString(LOG_PERF_T6C.Format, Nothing)
                        excelWorksheet.Cells(62, Column).Value = LOG_PERF_T6C_NORM_DEGF.Value.ToString(LOG_PERF_T6C_NORM_DEGF.Format, Nothing)

					Case eTestStepPW901A.FINAL_DATA

						excelWorksheet = excelSheets.Item("SUMMARY")

						'PERFORMED TEST DETAILS
						excelWorksheet.Cells(35, 109).Value = LOG_PERF_RUNDOWN_TIME_SEC.Value.ToString(LOG_PERF_RUNDOWN_TIME_SEC.Format, Nothing)
						excelWorksheet.Cells(36, 109).Value = LOG_PERF_Q17_CRACKING_PT_19DEG.Value.ToString(LOG_PERF_Q17_CRACKING_PT_19DEG.Format, Nothing)
						excelWorksheet.Cells(37, 109).Value = LOG_PERF_Q17_CRACKING_PT_77DEG.Value.ToString(LOG_PERF_Q17_CRACKING_PT_77DEG.Format, Nothing)
						excelWorksheet.Cells(38, 109).Value = LOG_PERF_VIB_GG_MAX_CMS.Value.ToString(LOG_PERF_VIB_GG_MAX_CMS.Format, Nothing)
						excelWorksheet.Cells(39, 109).Value = LOG_PERF_VIB_LGB_MAX_MS2.Value.ToString(LOG_PERF_VIB_LGB_MAX_MS2.Format, Nothing)
                        excelWorksheet.Cells(40, 109).Value = LOG_PERF_PERF_TRIM_DEGC.Value.ToString(LOG_PERF_PERF_TRIM_DEGC.Format, Nothing)
                        excelWorksheet.Cells(41, 109).Value = LOG_PERF_PERF_TRIM_INPUT_DEGC.Value.ToString(LOG_PERF_PERF_TRIM_INPUT_DEGC.Format, Nothing)
                        excelWorksheet.Cells(42, 109).Value = LOG_PERF_PERF_TRIM_CONTROL_DEGC.Value.ToString(LOG_PERF_PERF_TRIM_CONTROL_DEGC.Format, Nothing)
                        excelWorksheet.Cells(43, 109).Value = N2_DATAPLATE_RPM.Value.ToString(N2_DATAPLATE_RPM.Format, Nothing)
                        excelWorksheet.Cells(44, 109).Value = T_EGT_DATAPLATE_DEGC.Value.ToString(T_EGT_DATAPLATE_DEGC.Format, Nothing)

						excelWorksheet = excelSheets.Item("ACCEPTANCE")

						'Test Result
						If CELProject.IsTrue(PERF_TEST_RESULT_ACCEPTED.Value) Then
							excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
						Else
							excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
						End If

						If CELProject.IsTrue(PERF_TEST_RESULT_REJECTED.Value) Then
							excelWorksheet.OLEObjects("TestResultRejected").object.value = True
						Else
							excelWorksheet.OLEObjects("TestResultRejected").object.value = False
						End If
				End Select

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreateStandardCELPerformanceFile: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreateStandardCELPerformanceFile = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)

            End Try

        End Function

        Protected Overrides Function UpdateCustomHeaderLogFile(ByVal AppendOption As Boolean, ByVal IsPerfEntry As Boolean, ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Try
                Dim Log_Condition As Integer

                If AppendOption = False Then
                    Log_Condition = 1
                Else
                    Log_Condition = ExcelWorksheet.Cells(RowIndex + 1, ExcelWorksheet.Columns.Count).End(Excel.XlDirection.xlToLeft).Column - 1
                    Log_Condition = Log_Condition + 1

                End If

                If ((Log_Condition > 1) And ((Log_Condition Mod 5) = 1)) Then

                    'Repeat The Test Spec For this new sets of condition

                    With ExcelWorksheet
                        .Range(.Cells(2, 2), .Cells(RowIndex - 2, 6)).Copy(.Cells(2, Log_Condition + 1))
                    End With
                End If

                ColumnIndex = 1 + Log_Condition

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Format(Now, "yyyy/MM/dd HH:mm:ss")
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Log_Condition.ToString()
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                If IsPerfEntry = False Then
                    Dim CommentText As String = ""
                    Dim InputObject As New InputCommentForm
                    InputObject.ShowDialog("Log Report", "Comment:", "", CommentText)

                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = CommentText
                Else
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "STEP: " & TestStep_List.SelectedItem
                End If

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 2
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Values"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignCenter

            Catch ex As Exception
                MessageBox.Show("UpdateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

		Private Function PW901A_CP_AirGas(ByVal T As Double, ByVal WFCOR As Double, ByVal W1 As Double)
			'This function implements CP Air-Gas Subroutine in PWC program P10615F.BAS (Lines 5000 to 5060)
			Dim C2 As Double
			Dim C3 As Double
			Dim C4 As Double
			Dim FAR As Double

			C3 = (((0.000000000000003258 * T - 0.00000000002651) * T + 0.00000007093) * T - 0.00004746) * T + 0.2484
			C4 = ((0.000000000001212 * T - 0.00000001041) * T + 0.00003615) * T + 0.139
			FAR = WFCOR / (3600 * W1)
			C2 = C3 * (C4 * FAR / 0.0334 + 1)
			Return C2

		End Function

        Private Sub PW901A_Iteration(ByVal W7 As Double, ByVal CP7 As Double, ByVal T7 As Double, ByVal W16 As Double, ByVal CP16 As Double, ByVal T16 As Double, ByVal W6 As Double, ByVal WFCOR As Double, ByVal W1 As Double)
            'This sub implements iterative code in PWC program P10615F.BAS (Lines 1930 to 1970)
            Dim CP6iter As Double = 0.27
            Dim i As Integer
            Dim T6C As Double

            For i = 1 To 4
                T6C = (W7 * CP7 * T7 - W16 * CP16 * T16) / (W6 * CP6iter)
                CP6iter = PW901A_CP_AirGas(T6C, WFCOR, W1)
            Next

            If Not Double.IsNaN(T6C) Then
                T6C_TEMP.Value = New KineticaRT.Values.Double(T6C)
            Else
                T6C_TEMP.Value = Values.TextNaN
            End If
            If Not Double.IsNaN(CP6iter) Then
                CP6.Value = New KineticaRT.Values.Double(CP6iter)
            Else
                CP6.Value = Values.TextNaN
            End If

        End Sub

        Protected Overrides Sub OnEngineWorkingThread()

            Compute(False)

            'Make sure FM_INITIAL_VOLUME_LITERS is different than 0
            'ValidateFMInitialValue()

            If Q17CrackingPointInProgress Then
                CaptureDVTransit()
            End If

            'Persistent Values Save Check
            PW901APersistentValuesCtrl.SavePersistentValues()

        End Sub

        Private Sub OnREADY_TO_LOAD(ByVal sender As IChannel, ByVal newVal As Value)
            If (CELProject.IsTrue(newVal)) Then

                Try
                    NUMBER_OF_STARTS.Value = New KineticaRT.Values.Double(NUMBER_OF_STARTS.Value.ToDouble + 1)
