                            Else
                                ReDim Preserve W17MaxIGV147LimitTable(1, W17MaxIGV147LimitTable.GetUpperBound(1) + 1)
                            End If
                            W17MaxIGV147LimitTable(0, W17MaxIGV147LimitTable.GetUpperBound(1)) = line.XValue
                            W17MaxIGV147LimitTable(1, W17MaxIGV147LimitTable.GetUpperBound(1)) = line.YValue
                        Case "W17@P1=14.95 Max IGV"
