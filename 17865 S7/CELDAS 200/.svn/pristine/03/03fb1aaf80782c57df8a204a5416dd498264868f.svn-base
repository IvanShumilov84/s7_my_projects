                            End If
                            Pt17MES1495LimitTable(0, Pt17MES1495LimitTable.GetUpperBound(1)) = line.XValue
                            Pt17MES1495LimitTable(1, Pt17MES1495LimitTable.GetUpperBound(1)) = line.YValue
                        Case "W17@P1=14.2 Max ECS"
                            If IsNothing(W17MaxECS142LimitTable) Then
                                ReDim Preserve W17MaxECS142LimitTable(1, 0)
                            Else
                                ReDim Preserve W17MaxECS142LimitTable(1, W17MaxECS142LimitTable.GetUpperBound(1) + 1)
