                Return_Value.Add(MyBase.InitializeChannel(T_T17_DEGR, "T_T17_DEGR"))
                Return_Value.Add(MyBase.InitializeChannel(T6C_TEMP, "T6C_TEMP"))
                Return_Value.Add(MyBase.InitializeChannel(TEST_STEP_MAX_ECS, "TEST_STEP_MAX_ECS"))
                Return_Value.Add(MyBase.InitializeChannel(TEST_STEP_NO_LOAD, "TEST_STEP_NO_LOAD"))
                Return_Value.Add(MyBase.InitializeChannel(TRIM_DEGC, "TRIM_DEGC"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_GG_MAX_CMS, "VIB_GG_MAX_CMS"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_LGB_MAX_MS2, "VIB_LGB_MAX_MS2"))
                Return_Value.Add(MyBase.InitializeChannel(W1, "W1"))
                Return_Value.Add(MyBase.InitializeChannel(W6, "W6"))
                Return_Value.Add(MyBase.InitializeChannel(W7, "W7"))
                Return_Value.Add(MyBase.InitializeChannel(W16, "W16"))
                Return_Value.Add(MyBase.InitializeChannel(W17_LIMIT_LBMIN, "W17_LIMIT_LBMIN"))
                Return_Value.Add(MyBase.InitializeChannel(WB_CALC, "WB_CALC"))
                Return_Value.Add(MyBase.InitializeChannel(WF_LIMIT_PPH, "WF_LIMIT_PPH"))
                Return_Value.Add(MyBase.InitializeChannel(WFCOR, "WFCOR"))


                Return_Value.Add(MyBase.InitializeObject(Main_Panel_Frame, CELProject.EngineModel.Replace("-", "_") + "_Screen.fraMasterPanel"))
                Return_Value.Add(MyBase.InitializeObject(Performance_Control_Frame, CELProject.EngineModel.Replace("-", "_") + "_Screen.fraPerformanceControl"))

                Engine_Control_Frame = Main_Panel_Frame.FindObject("fraEngineControls")
                ECS_Frame = Engine_Control_Frame.FindObject("fraECS")
                ECS_Display = ECS_Frame.FindObject("dspECS_DEMAND")

                If ECS_Display Is Nothing Then
                    MessageBox.Show("MyBase.InitializeObject - dspECS Is Nothing")
                    Return_Value.Add(False)
                Else
                    Return_Value.Add(True)
                End If

                TestStep_List = Performance_Control_Frame.FindObject("TestStep_List")

                If TestStep_List Is Nothing Then
                    MessageBox.Show("MyBase.InitializeObject - TestStep_List Is Nothing")
                    Return_Value.Add(False)
                Else
                    Return_Value.Add(True)
                End If

                Return_Value.Add(MyBase.InitializeChannel(OPERATING_TIME_CURRENT_SEC, "OPERATING_TIME_CURRENT_SEC"))

            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.ToString())
                Return_Value.Add(False)
            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function

        Private Sub TestProgress_Initialize()
            Dim dataInfo As CEL.TestProgress.TestProgressMgr.TestProgress_DataInfo

            dataInfo.EngineStartEventChannelName = "RUN_STOP_BTN"
            dataInfo.EngineStartEventChannelValue = True
            dataInfo.EngineStartEventDescription = "Mise en route"
            dataInfo.EngineStartEventRecordTime = True
            dataInfo.EngineStopEventChannelName = "RUN_STOP_BTN"
            dataInfo.EngineStopEventChannelValue = False
            dataInfo.EngineStopEventDescription = "Arrêt moteur - Temps d'arrêt (s): "
            dataInfo.EngineStopEventRecordTime = True
            dataInfo.TestProgressFrameName = CELProject.EngineModel.Replace("-", "_") + "_Screen.fraTestProgressHorizontal"
            dataInfo.TestProgressSheetFileName = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
            dataInfo.UUTModel = CELProject.EngineModel
            dataInfo.UUTSerialNumber = Me.UserInputs.EngineSerialNumber
            dataInfo.UUTWorkOrder = Me.UserInputs.WorkOrder
            Me.TestProgressMgr = New CEL.TestProgress.TestProgressMgr(dataInfo)
        End Sub

        Private Sub TestProgress_RecordPerfStep(testStep As eTestStepPW901A)
            If Me.TestProgressMgr IsNot Nothing Then
                Dim sheetEntry As CEL.TestProgress.TestProgressSheetEntry = Nothing

                Dim checkItemPsL As String = "PsL - Read: " + LOG_PERF_P_LGB_PSIA.Value.ToString(LOG_PERF_P_LGB_PSIA.Format, Nothing) + " psia"
                Dim checkItemTt1 As String = "Tt1 - Read: " + LOG_PERF_T_TT1_AVG_DEGC.Value.ToString(LOG_PERF_T_TT1_AVG_DEGC.Format, Nothing) + " °C"
                Dim checkItemIGV As String = "IGV - Min: " + IGV_LIMIT_PCT.Value.ToString(IGV_LIMIT_PCT.Format, Nothing) + " Read: " + _
                    LOG_PERF_IGV_POS_PCT.Value.ToString(LOG_PERF_IGV_POS_PCT.Format, Nothing) + " %"
                Dim checkItemQ17 As String = "Q17 - Read: " + LOG_PERF_Q17.Value.ToString(LOG_PERF_Q17.Format, Nothing)
                Dim checkItemGENERATOR As String = "Generator - Read: " + LOG_PERF_LOAD_TOTAL_KVA.Value.ToString(LOG_PERF_LOAD_TOTAL_KVA.Format, Nothing) + " kVA"
                Dim checkItemN2 As String = "N2 - "
                Dim checkItemEGT As String = "EGT - "
                Dim checkItemWF As String = "Fuel Flow - "
                Dim checkItemPt17 As String = "Pt17 - "
                Dim checkItemTt17 As String = "Tt17 - Read: " + LOG_PERF_T_T17_DEGC.Value.ToString(LOG_PERF_T_T17_DEGC.Format, Nothing) + " °C"
                Dim checkItemW17 As String = "W17 - "

                Select Case testStep
                    Case eTestStepPW901A.MAX_ECS

                        checkItemN2 += "Read: " + LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing) + " RPM"
                        checkItemEGT += "Read: " + LOG_PERF_T_EGT_DEGC.Value.ToString(LOG_PERF_T_EGT_DEGC.Format, Nothing) + " °C"
                        checkItemWF += "Max: " + WF_LIMIT_PPH.Value.ToString(WF_LIMIT_PPH.Format, Nothing) + " Read: " + _
                            LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing) + "lb/h"
                        checkItemPt17 += "Read: " + LOG_PERF_P_PT17_PSIA.Value.ToString(LOG_PERF_P_PT17_PSIA.Format, Nothing) + " psia"
                        checkItemW17 += "Min: " + W17_LIMIT_LBMIN.Value.ToString(W17_LIMIT_LBMIN.Format, Nothing) + " Read: " + _
                            LOG_PERF_W17_LBMIN.Value.ToString(LOG_PERF_W17_LBMIN.Format, Nothing) + " lb/min"

                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Max ECS, 180 kVA", {checkItemPsL, checkItemTt1, _
                                                                                                       checkItemIGV, checkItemQ17, checkItemGENERATOR, _
                                                                                                       checkItemN2, checkItemEGT, checkItemWF, checkItemPt17, _
                                                                                                       checkItemTt17, checkItemW17})
                    Case eTestStepPW901A.MAX_IGV

                        checkItemN2 += "Read: " + LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing) + " RPM"
                        checkItemEGT += "Read: " + LOG_PERF_T_EGT_DEGC.Value.ToString(LOG_PERF_T_EGT_DEGC.Format, Nothing) + " °C"
                        checkItemWF += "Read: " + LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing) + "lb/h"
                        checkItemPt17 += "Min: " + P_PT17_LIMIT_PSIA.Value.ToString(P_PT17_LIMIT_PSIA.Format, Nothing) + " Read: " + _
                            LOG_PERF_P_PT17_PSIA.Value.ToString(LOG_PERF_P_PT17_PSIA.Format, Nothing) + " psia"
                        checkItemW17 += "Min: " + W17_LIMIT_LBMIN.Value.ToString(W17_LIMIT_LBMIN.Format, Nothing) + " Read: " + _
                            LOG_PERF_W17_LBMIN.Value.ToString(LOG_PERF_W17_LBMIN.Format, Nothing) + " lb/min"

                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Max IGV, 0 kVA", {checkItemPsL, checkItemTt1, _
                                                                                                       checkItemIGV, checkItemQ17, checkItemGENERATOR, _
                                                                                                       checkItemN2, checkItemEGT, checkItemWF, checkItemPt17, _
                                                                                                       checkItemTt17, checkItemW17})

                    Case eTestStepPW901A.MES

                        checkItemN2 += "Max: " + N2_LIMIT_RPM.Value.ToString(N2_LIMIT_RPM.Format, Nothing) + " Read: " + _
                            LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing) + " RPM"
                        checkItemEGT += "Max: " + T_EGT_LIMIT_DEGC.Value.ToString(T_EGT_LIMIT_DEGC.Format, Nothing) + " Read: " + _
                            LOG_PERF_T_EGT_DEGC.Value.ToString(LOG_PERF_T_EGT_DEGC.Format, Nothing) + " °C"
                        checkItemWF += "Read: " + LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing) + "lb/h"
                        checkItemPt17 += "Min: " + P_PT17_LIMIT_PSIA.Value.ToString(P_PT17_LIMIT_PSIA.Format, Nothing) + " Read: " + _
                            LOG_PERF_P_PT17_PSIA.Value.ToString(LOG_PERF_P_PT17_PSIA.Format, Nothing) + " psia"
                        checkItemW17 += "Read: " + LOG_PERF_W17_LBMIN.Value.ToString(LOG_PERF_W17_LBMIN.Format, Nothing) + " lb/min"

                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "MES, 180 kVA", {checkItemPsL, checkItemTt1, _
                                                                                                       checkItemIGV, checkItemQ17, checkItemGENERATOR, _
                                                                                                       checkItemN2, checkItemEGT, checkItemWF, checkItemPt17, _
                                                                                                       checkItemTt17, checkItemW17})
                End Select

                If sheetEntry IsNot Nothing Then
                    Me.TestProgressMgr.AddTestProgressEntry(sheetEntry)
                End If
            End If
        End Sub

        Private Sub TestProgress_Save()
            If Not Me.TestProgressMgr Is Nothing Then
                TestProgress_UpdateProgressSheetHeader(Me.TestProgressMgr.TestProgressSheet)
                Dim fileName As String = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
                Dim settings As Xml.XmlWriterSettings = New Xml.XmlWriterSettings()
                settings.Indent = True

                Using writer As Xml.XmlWriter = Xml.XmlWriter.Create(fileName, settings)
                    Dim xslPath As String = "type=""text/xsl"" href=""" + Application.StartupPath + "/TestProgressSheet.xsl"""
                    writer.WriteProcessingInstruction("xml-stylesheet", xslPath)
                    Dim ser As New Xml.Serialization.XmlSerializer(GetType(CEL.TestProgress.TestProgressSheet))
                    ser.Serialize(writer, Me.TestProgressMgr.TestProgressSheet)
                End Using
            End If
        End Sub

        Private Sub TestProgress_UpdateProgressSheetHeader(progressSheet As CEL.TestProgress.TestProgressSheet)
            progressSheet.Header("No capteur de vibration GG") = Me.UserInputs.GGVibPickupSerialNumber
            progressSheet.Header("No capteur de vibration LGB") = Me.UserInputs.LGBVibPickupSerialNumber
            progressSheet.Header("Type d'huile") = Me.UserInputs.OilType
            progressSheet.Header("Quantité totale Jet A1") = Me.FUEL_USED_TOTAL_LITERS.Value.ToString()
            Dim runningTime As System.TimeSpan = System.TimeSpan.FromSeconds(Me.OPERATING_TIME_CURRENT_SEC.Value.ToDouble())
            progressSheet.Header("Temps de fonctionnement") = Math.Floor(runningTime.TotalHours).ToString() + _
                " h " + runningTime.Minutes.ToString("00")
        End Sub

