        Protected Overrides Sub OnTestSessionClosing(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                MyBase.OnTestSessionClosing(newStatus)

                If CELProject.EngineFamily = "GTCP85-129" Then

                    Init_Engine_Channels_Value() 'Reinit variables before we quit

                    RemoveHandlers()

                    Dispose_Engine_Controllers()

                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionClosing: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionInitialized(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionInitialized(newStatus)

                If CELProject.EngineFamily = "GTCP85-129" Then

                    Select Case CELProject.Project.Number

                        Case 10726
                            UserInputs.MapUserInputsParameters(CELProject)

                        Case 13031
                            UserInputsSouthAfricanAirways.MapUserInputsParameters(CELProject)

                        Case Else
                            Debug.Assert(False, "OnTestSessionInitialized: Code Missign for this project in")

                    End Select

                    CELProject.EngineSession.WorkingFolder = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(1).Value.ToString()
                    CELProject.CreateLogFile(AddressOf CreateCustomHeaderLogFile, CELProject.EngineModel, CELProject.EngineModel)

                    'Garuda  TODO REMOVE
                    'CELProject.EngineSession.WorkingFolder = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + UserInputs.EngineSerialNumber.ToString() + "\" + UserInputs.WorkOrder.ToString()
                    'CELProject.CreateLogFile(AddressOf CreateCustomHeaderLogFile, "GTCP85-129", CELProject.EngineModel)

                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionInitialized: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)

            Catch ex As Exception

                MessageBox.Show("GTCP85_129_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            End Try
        End Sub

        Protected Overrides Sub OnTestSessionRunning(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try

                MyBase.OnTestSessionRunning(newStatus)

                If CELProject.EngineFamily = "GTCP85-129" Then

                    Init_Engine_Channels()
                    Initialize_Arrays()
                    CELProject.LoadSave_Custom_Parameters(Custom_Parameters, False)

                    CELProject.Perf_Nb_Sheet_To_Print = 3

                    Init_Engine_Controllers()

                    AddHandlers()

                    Init_Engine_Channels_Value()

                    MyBase.StartWorkingThread()

                    'Test Progress Initialization
                    TestProgress_Initialize()

                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionRunning: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub
        Protected Overrides Sub AddHandlers()

            AddHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnCLOSE_TEST_BTN
            AddHandler CELProject.NEW_TEST_BTN.ValueChanged, AddressOf OnNEW_TEST_BTN
            AddHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            AddHandler CELProject.PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
            AddHandler CELProject.PERF_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnPERF_OPEN_WINDOW_BTN
            AddHandler CELProject.PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN
            AddHandler PERF_REC_AIR_PRESSURE_BTN.ValueChanged, AddressOf OnCaptureBtn
            AddHandler PERF_REC_CRANK_CHECK_BTN.ValueChanged, AddressOf OnCaptureBtn
            AddHandler PERF_REC_ETC_CHECK_BTN.ValueChanged, AddressOf OnCaptureBtn
            AddHandler PERF_REC_ETC_RECHECK_BTN.ValueChanged, AddressOf OnCaptureBtn
            AddHandler PERF_REC_FULL_LOAD_SPEED_BTN.ValueChanged, AddressOf OnCaptureBtn
            AddHandler PERF_REC_MIN_SPEED_CHECK_BTN.ValueChanged, AddressOf OnCaptureBtn
            AddHandler PERF_REC_NO_LOAD_SPEED_BTN.ValueChanged, AddressOf OnCaptureBtn
            AddHandler CAPTURE_MAX_EGT_OVERLOAD_BTN.ValueChanged, AddressOf OnCaptureBtn

            AddHandler PERF_PRESERVATION_YES.ValueChanged, AddressOf OnPERFPreservationYesCheckBox
            AddHandler PERF_PRESERVATION_NO.ValueChanged, AddressOf OnPERFPreservationNoCheckBox
            AddHandler cmbTestStepList.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged

        End Sub
        Protected Overrides Sub RemoveHandlers()

            If Not (CELProject.NEW_TEST_BTN Is Nothing) Then
                RemoveHandler CELProject.NEW_TEST_BTN.ValueChanged, AddressOf OnNEW_TEST_BTN
            End If

            If Not (CELProject.CLOSE_TEST_BTN Is Nothing) Then
                RemoveHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnCLOSE_TEST_BTN
            End If

            If Not (CELProject.LOG_TAKE_POINT_BTN Is Nothing) Then
                RemoveHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            End If

            If Not (CELProject.PERF_CLOSE_WINDOW_BTN Is Nothing) Then
                RemoveHandler CELProject.PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
            End If

            If Not (CELProject.PERF_OPEN_WINDOW_BTN Is Nothing) Then
                RemoveHandler CELProject.PERF_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnPERF_OPEN_WINDOW_BTN
            End If

            If Not (PERF_REC_AIR_PRESSURE_BTN Is Nothing) Then
                RemoveHandler PERF_REC_AIR_PRESSURE_BTN.ValueChanged, AddressOf OnCaptureBtn
            End If

            If Not (PERF_REC_CRANK_CHECK_BTN Is Nothing) Then
                RemoveHandler PERF_REC_CRANK_CHECK_BTN.ValueChanged, AddressOf OnCaptureBtn
            End If

            If Not (PERF_REC_ETC_CHECK_BTN Is Nothing) Then
                RemoveHandler PERF_REC_ETC_CHECK_BTN.ValueChanged, AddressOf OnCaptureBtn
            End If

            If Not (PERF_REC_ETC_RECHECK_BTN Is Nothing) Then
                RemoveHandler PERF_REC_ETC_RECHECK_BTN.ValueChanged, AddressOf OnCaptureBtn
            End If

            If Not (PERF_REC_FULL_LOAD_SPEED_BTN Is Nothing) Then
                RemoveHandler PERF_REC_FULL_LOAD_SPEED_BTN.ValueChanged, AddressOf OnCaptureBtn
            End If

            If Not (PERF_REC_MIN_SPEED_CHECK_BTN Is Nothing) Then
                RemoveHandler PERF_REC_MIN_SPEED_CHECK_BTN.ValueChanged, AddressOf OnCaptureBtn
            End If

            If Not (PERF_REC_NO_LOAD_SPEED_BTN Is Nothing) Then
                RemoveHandler PERF_REC_NO_LOAD_SPEED_BTN.ValueChanged, AddressOf OnCaptureBtn
            End If

            If Not (CELProject.PERF_TAKE_POINT_BTN Is Nothing) Then
                RemoveHandler CELProject.PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN
            End If

            If Not (PERF_PRESERVATION_YES Is Nothing) Then
                RemoveHandler PERF_PRESERVATION_YES.ValueChanged, AddressOf OnPERFPreservationYesCheckBox
            End If

            If Not (PERF_PRESERVATION_NO Is Nothing) Then
                RemoveHandler PERF_PRESERVATION_NO.ValueChanged, AddressOf OnPERFPreservationNoCheckBox
            End If

            If Not (cmbTestStepList Is Nothing) Then
                RemoveHandler cmbTestStepList.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged
            End If

            If Not (CAPTURE_MAX_EGT_OVERLOAD_BTN Is Nothing) Then
                RemoveHandler CAPTURE_MAX_EGT_OVERLOAD_BTN.ValueChanged, AddressOf OnCaptureBtn
            End If

        End Sub
        Protected Overrides Sub Init_Engine_Controls()
        End Sub
        Protected Overrides Sub Init_Engine_Controllers()

            Dim PersistentValuesChannels() As String = {"NUMBER_OF_STARTS",
                                  "OPERATING_TIME_CURRENT_SEC",
                                 "FUEL_USED_INITIAL_LITERS",
                                "FUEL_USED_TOTAL_LITERS",
                               "PERF_TEST_RESULT_ACCEPTED",
                              "PERF_TEST_RESULT_REJECTED",
                             "VIB_GEARBOX_MAX_MILS_PERSISTENT",
                            "VIB_TURBINE_MAX_MILS_PERSISTENT"}


            Dim PersistentValuesFileName As String = Nothing

            Select Case CELProject.Project.Number

                Case 13031
                    PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputsSouthAfricanAirways.EngineSerialNumber & "\" & UserInputsSouthAfricanAirways.WorkOrder & "\Log\PersistentValues.xml"
                    GTCP85_129_PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

                    If Double.IsNaN(FUEL_USED_TOTAL_LITERS.Value.ToDouble()) Then
                        FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                    Else
                        FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())
                    End If

                Case Else
                    Debug.Assert(False, "OnTestSessionRunning: Code Missign for this project")

            End Select


            CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.ConfigHMIforEngine))
            'CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.Init_Engine_Controls))          'essaie

            ' Les config sont lu a partir du fichier celdas_XXXXX.cfg
            NumberOfTInletProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/" + CELProject.EngineFamily + "/T_INLET_NUMBER_PROBE", 0)
            RealNumberOfTInletProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/" + CELProject.EngineFamily + "/T_INLET_REAL_NUMBER_PROBE", 0)
            NumberOfTEgtProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/" + CELProject.EngineFamily + "/T_EGT_NUMBER_PROBE", 0)
            RealNumberOfTEgtProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/" + CELProject.EngineFamily + "/T_EGT_REAL_NUMBER_PROBE", 0)

            'Generic delete channel function handling
            DeletableTEgtChCtrl = New DeletableChannelController(Me, RealNumberOfTEgtProbe, NumberOfTEgtProbe, NumberOfTEgtProbe, "T_EGT", "_DEGF", "_DELETE_BTN", "T_EGT_DEGF_AVG", Nothing, Nothing, Nothing)
            DeletableTInletChCtrl = New DeletableChannelController(Me, RealNumberOfTInletProbe, NumberOfTInletProbe, NumberOfTInletProbe, "T_INLET", "_DEGF", "_DELETE_BTN", "T_INLET_DEGF_AVG", Nothing, Nothing, "T_INLET_DEGF_SPREAD")

            FlowmeterCtrl = New FlowmeterController(Me)

            StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_CURRENT_AMP", "STARTER_CURRENT_AMP_MAX", "START_BTN")
            StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_VOLTAGE_VDC", "STARTER_VOLTAGE_VDC_MAX", "START_BTN")

            'Configuring Coarse Load Air Valve, No Fine Load Air Valve
            LoadAirCtrl = New UpDownDemandController("LOAD_AIR_VALVE_DEMAND", "LOAD_AIR_VALVE_DEMAND_INCREMENT", "LOAD_AIR_VALVE_UP_DEMAND", "LOAD_AIR_VALVE_DOWN_DEMAND", Nothing)
            LoadAirCtrl.Maximum = 100
            LoadAirCtrl.Increment = 0.5
            LoadAirCtrl.Minimum = 0
            LoadAirCtrl.ResetValue = 0

            FuelRegulatorCtrl = New UpDownDemandController("FUEL_PRESSURE_DEMAND", "FUEL_PRESSURE_DEMAND_INCREMENT", "FUEL_PRESSURE_UP_DEMAND_BTN", "FUEL_PRESSURE_DOWN_DEMAND_BTN", Nothing)
            FuelRegulatorCtrl.Maximum = 100
            FuelRegulatorCtrl.Increment = 1
            FuelRegulatorCtrl.Minimum = 0
            FuelRegulatorCtrl.ResetValue = 0

            'Configuring Load Bank Control
            Dim myLBData As LoadBankController.LB_DataInfo

            myLBData.FanEnableChannelName = "LB1_FAN_ENABLE_CMD"
            myLBData.FanEnableBtnChannelName = "LB1_FAN_ENABLE_BTN"

            myLBData.EnableChannelName = "LB_LOAD_BTN"
            myLBData.DemandChannelName = "LB1_DEMAND"
            myLBData.UpDemandChannelName = "LB1_UP_DEMAND_BTN"
            myLBData.DownDemandChannelName = "LB1_DOWN_DEMAND_BTN"
            myLBData.DemandChannelIncrementName = "LB1_DEMAND_INCREMENT"
            myLBData.FrameName = "GTCP85_129_Screen.fraControlSystem.fraLoadBank"
            myLBData.DisplayName = "dspLB_DEMAND"
            myLBData.ThreadSpeedMsec = 250 'msec
            myLBData.Maximum = 30
            myLBData.DelestageKwpersec = 1000 'instant delestage
            myLBData.FanCoolDownSeconds = 300
            myLBData.Memorize = False
            myLBData.Increment = 1
            myLBData.InitialDemandChannelName = "LB1_INITIAL_DEMAND"
            myLBData.BtnLatchSeconds = 0
            myLBData.FanEnableChannelPulseName = Nothing
            myLBData.FanStopChannelPulseName = Nothing
            myLBData.PulseEnableInitialType = False
            myLBData.PulseStopInitialType = False

            Select Case CELProject.Project.Number

                Case 12917
                    myLBData.FieldFlashingTimeMsec = 1000
                    myLBData.FieldFlashingSignalName = "FIELD_FLASHING"
                    myLBData.FieldFlashingTriggerSignalName = "LB_GCU_BTN"

                Case 11813
                    myLBData.FieldFlashingTimeMsec = 0  'no field flashing
                    myLBData.FieldFlashingSignalName = Nothing
                    myLBData.FieldFlashingTriggerSignalName = Nothing

                Case 12958
                    myLBData.FieldFlashingTimeMsec = 0  'no field flashing
                    myLBData.FieldFlashingSignalName = Nothing
                    myLBData.FieldFlashingTriggerSignalName = Nothing

                Case 13031
                    myLBData.FieldFlashingTimeMsec = 0  'no field flashing
                    myLBData.FieldFlashingSignalName = Nothing
                    myLBData.FieldFlashingTriggerSignalName = Nothing

                Case Else
                    myLBData.FieldFlashingTimeMsec = 0  'no field flashing
                    myLBData.FieldFlashingSignalName = Nothing
                    myLBData.FieldFlashingTriggerSignalName = Nothing
                    Debug.Assert(False, "OnTestSessionRunning: Code Missign for this project in")

            End Select


            LoadBankCtrl = New LoadBankController(myLBData)

            'Configuring Load Bank Stage Values
            LoadBankCtrl.AddStage(1, "LB1_1")
            LoadBankCtrl.AddStage(2, "LB1_2")
            LoadBankCtrl.AddStage(2, "LB1_3")
            LoadBankCtrl.AddStage(5, "LB1_4")
            LoadBankCtrl.AddStage(5, "LB1_5")
            LoadBankCtrl.AddStage(10, "LB1_6")
            LoadBankCtrl.AddStage(10, "LB1_7")
            LoadBankCtrl.AddStage(25, "LB1_8")
            LoadBankCtrl.AddStage(50, "LB1_9")
            LoadBankCtrl.AddStage(50, "LB1_10")
            LoadBankCtrl.AddCurrentPhases("LB1_CURRENT_IA", "LB1_CURRENT_IB", "LB1_CURRENT_IC", 20)
            LoadBankCtrl.AddVoltagePhases("LB1_VOLTAGE_VAB", "LB1_VOLTAGE_VBC", "LB1_VOLTAGE_VCA", 20)
            LoadBankCtrl.StartWorkerThread(250)


        End Sub
        Protected Overrides Sub Dispose_Engine_Controllers()

            If Not (DeletableTEgtChCtrl Is Nothing) Then
                DeletableTEgtChCtrl.Dispose()
            End If

            If Not (DeletableTInletChCtrl Is Nothing) Then
                DeletableTInletChCtrl.Dispose()
            End If

            If Not (LoadAirCtrl Is Nothing) Then
                LoadAirCtrl.Dispose()
            End If

            If Not (LoadBankCtrl Is Nothing) Then
                LoadBankCtrl.Dispose()
            End If

            If Not (StarterMaxCurrentRecordCtrl Is Nothing) Then
                StarterMaxCurrentRecordCtrl.Dispose()
            End If

            If Not (StarterMaxVoltageRecordCtrl Is Nothing) Then
                StarterMaxVoltageRecordCtrl.Dispose()
            End If

            If Not (FlowmeterCtrl Is Nothing) Then
                FlowmeterCtrl.Dispose()
            End If
            If Not (FuelRegulatorCtrl Is Nothing) Then
                FuelRegulatorCtrl.Dispose()
            End If


        End Sub

