Namespace StudioDemonstration

    Public Class GTCP85_129_Sequence
        Inherits ApuSequence
        Implements IBleedAirFlowCalculation


        'Les constantes sont lu a partir du fichier celdas_XXXXX.cfg
        Private NumberOfTInletProbe As Integer = 0
        Private RealNumberOfTInletProbe As Integer = 0
        Private NumberOfTEgtProbe As Integer = 0
        Private RealNumberOfTEgtProbe As Integer = 0

        Private Const SERVICE_BULLETIN As Integer = 4

        Private Enum eTestStep
            RUN_IN_IDLE = 0
            PERFORMANCE_25_OR_30SHP = 1 'Combination Load (25 SHP for GTCP85-129ABD and 30 SHP for GTCP85-129CEFG/GTCP85-129-129HJK)
            PERFORMANCE_0_SHP = 2
            CONTROLING = 3
            ZERO_LOAD = 4
            MANUAL_ADDITIONAL_INFO = 5
        End Enum

        Private Enum eTestStepGTCP85_129
            ACCELERATION_CRACK_PRESSURE = 0
            MANUAL_START_CHECK = 1 'step 1.E.2
            NO_LOAD = 2
            COMBINATION_LOAD = 3
            BLEED_LOAD_ONLY = 4
            ACCELERATION_CRACK_PRESSURE_RECHECK = 5
            CAPTURE_FINAL_DATA = 6
        End Enum

        Public Enum eRepairType
            Heavy = 0
            LightMedium = 1
        End Enum

        Private Enum ePerfCorrFactorIndex
            TCL = 0
            WB_Chng = 1
            PB_Chng = 2
            TB_Chng = 3
            Last_Index = 3 'has to be equal to the last one
        End Enum

        Protected Overrides Sub Compute(ByVal CalcForLogAndPerfReports As Boolean)

            Try
                If CalcForLogAndPerfReports Then

                    LOG_PERF_WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(LOG_PERF_T_ORIFICE_SOURCE_DEGF.Value.ToDouble(), _
                                                                                                 LOG_PERF_P_ORIFICE_SOURCE_INHGA.Value.ToDouble(), _
                                                                                                 LOG_PERF_P_ORIFICE_DELTA_SOURCE_INH2OD.Value.ToDouble))

                    Compute_GTCP85_129_Perf(LOG_PERF_T_INLET_DEGF_AVG, _
                                            LOG_PERF_DELTA, _
                                            LOG_PERF_P_BARO_SOURCE_INHGA, _
                                            LOG_PERF_P_BLEED_SOURCE_INHGG, _
                                            LOG_PERF_WB_CALC, _
                                            LOG_PERF_T_BLEED_SOURCE_DEGF, _
                                            LOG_PERF_PBChng, _
                                            LOG_PERF_TBChng, _
                                            LOG_PERF_WBChng, _
                                            LOG_PERF_PBStd, _
                                            LOG_PERF_TBStd, _
                                            LOG_PERF_WBStd, _
                                            LOG_PERF_PBStd_LOW_LIMIT, _
                                            LOG_PERF_WBStd_LOW_LIMIT, _
                                            LOG_PERF_TBStd_LOW_LIMIT, _
                                            LOG_PERF_TBStd_HI_LIMIT)

                    FlowmeterCtrl.ComputeFlow(True)

                    'IMPORTANT: Toutes les variables flottantes telles que WB_CALC, DELPB, LB_DEMAND dont la source et la destination sont vides doivent
                    'manuellement être updaté pour être inscrite dans le LOG ou le PERF report.
                Else

                    WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(T_ORIFICE_SOURCE_DEGF.Value.ToDouble(), _
                                                                                      P_ORIFICE_SOURCE_INHGA.Value.ToDouble(), _
                                                                                      P_ORIFICE_DELTA_SOURCE_INH2OD.Value.ToDouble))
                    Compute_GTCP85_129_Perf(T_INLET_DEGF_AVG, _
                                            DELTA, _
                                            P_BARO_SOURCE_INHGA, _
                                            P_BLEED_SOURCE_INHGG, _
                                            WB_CALC, _
                                            T_BLEED_SOURCE_DEGF, _
                                            PBChng, _
                                            TBChng, _
                                            WBChng, _
                                            PBStd, _
                                            TBStd, _
                                            WBStd, _
                                            PBStd_LOW_LIMIT, _
                                            WBStd_LOW_LIMIT, _
                                            TBStd_LOW_LIMIT, _
                                            TBStd_HI_LIMIT)
                End If

            Catch ex As Exception
                MessageBox.Show("Compute_GTCP85_129" + ex.ToString(), "Error")
            End Try

        End Sub

        'TODO   creer une nouvelle version pour USER INPUTS 13031  et Perf report 13031. 
        Private Sub Compute_GTCP85_129_Perf(ByRef tinlet_degf_avg As IChannel, _
                                            ByRef pdelta As IChannel, _
                                            ByRef pbaro_inhga As IChannel, _
                                            ByRef pbleed_inhgg As IChannel, _
                                            ByRef wbcalc As IChannel, _
                                            ByRef tbleed_degf As IChannel, _
                                            ByRef pb_chng As IChannel, _
                                            ByRef tb_chng As IChannel, _
                                            ByRef wb_chng As IChannel, _
                                            ByRef pb_std As IChannel, _
                                            ByRef tb_std As IChannel, _
                                            ByRef wb_std As IChannel, _
                                            ByRef pb_std_low_limit As IChannel, _
                                            ByRef wb_std_low_limit As IChannel, _
                                            ByRef tb_std_low_limit As IChannel, _
                                            ByRef tb_std_hi_limit As IChannel)

            Try
                Dim PB As Double = 0
                Dim PBChngTable As Double = Double.NaN
                Dim PBLowLimit = 0

                Dim TB As Double = 0
                Dim TBChngTable As Double = Double.NaN
                Dim TBLowLimit = 0
                Dim TBHiLimit = 0

                Dim WB As Double = 0
                Dim WBChngTable As Double = Double.NaN
                Dim WBLowLimit = 0

                Dim Tcl As Double = tinlet_degf_avg.Value.ToDouble()
                Dim TestStep As Integer = CELProject.PERF_TEST_STEP_NB.Value.ToDouble() 'eTestStepGTCP85_129.BLEED_LOAD_ONLY' TODO: JSR : Solution temporaire pour éviter les erreurs
                Dim RepairType As Integer = REPAIR_TYPE.Value.ToDouble()

                If (TestStep = eTestStepGTCP85_129.BLEED_LOAD_ONLY) And EngineFamilyABD Then

                    If RepairType = eRepairType.Heavy Then
                        PBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.PB_Chng) 'GTCP85_129ABD_ZeroShaftLoad_HeavyRepair
                        TBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.TB_Chng)
                        WBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.WB_Chng)
                        PBLowLimit = 85.8
                        WBLowLimit = 103.4
                        TBLowLimit = 385
                        TBHiLimit = 455

                    ElseIf RepairType = eRepairType.LightMedium Then
                        PBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.PB_Chng) 'GTCP85_129ABD_ZeroShaftLoad_LightMediumRepair
                        TBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.TB_Chng)
                        WBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.WB_Chng)
                        PBLowLimit = 83.1
                        WBLowLimit = 100.1
                        TBLowLimit = 385
                        TBHiLimit = 455
                    End If

                ElseIf (TestStep = eTestStepGTCP85_129.BLEED_LOAD_ONLY) And EngineFamilyCEFG Then

                    If RepairType = eRepairType.Heavy Then
                        PBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.PB_Chng) 'GTCP85_129CEFG_ZeroShaftLoad_HeavyRepair
                        TBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.TB_Chng)
                        WBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.WB_Chng)
                        PBLowLimit = 87.2
                        WBLowLimit = 112.1
                        TBLowLimit = 400
                        TBHiLimit = 470
                    ElseIf RepairType = eRepairType.LightMedium Then
                        PBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.PB_Chng) 'GTCP85_129CEFG_ZeroShaftLoad_LightMediumRepair
                        TBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.TB_Chng)
                        WBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.WB_Chng)
                        PBLowLimit = 84.4
                        WBLowLimit = 105.3
                        TBLowLimit = 400
                        TBHiLimit = 470
                    End If

                ElseIf (TestStep = eTestStepGTCP85_129.BLEED_LOAD_ONLY) And EngineFamilyHJK Then

                    If RepairType = eRepairType.Heavy Then
                        PBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.PB_Chng) 'GTCP85_129HJK_ZeroShaftLoad_HeavyRepair
                        TBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.TB_Chng)
                        WBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.WB_Chng)
                        PBLowLimit = 90.9
                        WBLowLimit = 114.5
                        TBLowLimit = 403
                        TBHiLimit = 473
                    ElseIf RepairType = eRepairType.LightMedium Then
                        PBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.PB_Chng) 'GTCP85_129HJK_ZeroShaftLoad_LightMediumRepair
                        TBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.TB_Chng)
                        WBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_NO_LOAD, ePerfCorrFactorIndex.WB_Chng)
                        PBLowLimit = 88.2
                        WBLowLimit = 107.7
                        TBLowLimit = 403
                        TBHiLimit = 473
                    End If

                ElseIf TestStep = eTestStepGTCP85_129.COMBINATION_LOAD And EngineFamilyABD Then

                    PBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_LOAD, ePerfCorrFactorIndex.PB_Chng)
                    TBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_LOAD, ePerfCorrFactorIndex.TB_Chng) 'GTCP85_129ABD_25HP
                    WBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_LOAD, ePerfCorrFactorIndex.WB_Chng)

                    PBLowLimit = 91.6
                    WBLowLimit = 97.2
                    TBLowLimit = 388 ' attention hypothese de manuel tolerance +-   et non simplement 423 + 35F. 
                    TBHiLimit = 458

                ElseIf TestStep = eTestStepGTCP85_129.COMBINATION_LOAD And EngineFamilyCEFG Then

                    If RepairType = eRepairType.Heavy Then

                        PBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_LOAD, ePerfCorrFactorIndex.PB_Chng) 'GTCP85_129CEFG_30HP_HeavyRepair
                        TBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_LOAD, ePerfCorrFactorIndex.TB_Chng)
                        WBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_LOAD, ePerfCorrFactorIndex.WB_Chng)
                        PBLowLimit = 93.2
                        WBLowLimit = 103.0
                        TBLowLimit = 403
                        TBHiLimit = 473

                    ElseIf RepairType = eRepairType.LightMedium Then

                        PBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_LOAD, ePerfCorrFactorIndex.PB_Chng) 'GTCP85_129CEFG_30HP_LightMediumRepair
                        TBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_LOAD, ePerfCorrFactorIndex.TB_Chng)
                        WBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_LOAD, ePerfCorrFactorIndex.WB_Chng)
                        PBLowLimit = 90.2
                        WBLowLimit = 96.9
                        TBLowLimit = 403
                        TBHiLimit = 473
                    End If

                ElseIf TestStep = eTestStepGTCP85_129.COMBINATION_LOAD And EngineFamilyHJK Then

                    If RepairType = eRepairType.Heavy Then

                        PBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_LOAD, ePerfCorrFactorIndex.PB_Chng) 'GTCP85_129HJK_30HP_HeavyRepair
                        TBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_LOAD, ePerfCorrFactorIndex.TB_Chng)
                        WBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_LOAD, ePerfCorrFactorIndex.WB_Chng)
                        PBLowLimit = 93.2
                        WBLowLimit = 103.1
                        TBLowLimit = 403
                        TBHiLimit = 473

                    ElseIf RepairType = eRepairType.LightMedium Then

                        PBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_LOAD, ePerfCorrFactorIndex.PB_Chng)
                        TBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_LOAD, ePerfCorrFactorIndex.TB_Chng) 'GTCP85_129HJK_30HP_LightMediumRepair
                        WBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_129_LOAD, ePerfCorrFactorIndex.WB_Chng)
                        PBLowLimit = 90.4
                        WBLowLimit = 96.8
                        TBLowLimit = 403
                        TBHiLimit = 473
                    End If
                End If

                ' Verify that DELTA is NOT zero to prevent divide by zero error
                If pdelta.Value.ToDouble = 0.0 Then
                    WB = Double.NaN
                    PB = Double.NaN
                Else
                    ' P_BLEED Value is in.HgG, the PBStd value is expected in in.HGA.  We must add BARO value
                    PB = (pbaro_inhga.Value.ToDouble() + pbleed_inhgg.Value.ToDouble()) / pdelta.Value.ToDouble() + PBChngTable
                    WB = (wbcalc.Value.ToDouble() / pdelta.Value.ToDouble()) + WBChngTable
                End If

                TB = tbleed_degf.Value.ToDouble() + TBChngTable

                'Update KineticaRT Channels
                pb_chng.Value = New KineticaRT.Values.Double(PBChngTable)
                tb_chng.Value = New KineticaRT.Values.Double(TBChngTable)
                wb_chng.Value = New KineticaRT.Values.Double(WBChngTable)

                pb_std.Value = New KineticaRT.Values.Double(PB)
                tb_std.Value = New KineticaRT.Values.Double(TB)
                wb_std.Value = New KineticaRT.Values.Double(WB)

                pb_std_low_limit.Value = New KineticaRT.Values.Double(PBLowLimit)
                wb_std_low_limit.Value = New KineticaRT.Values.Double(WBLowLimit)
                tb_std_low_limit.Value = New KineticaRT.Values.Double(TBLowLimit)
                tb_std_hi_limit.Value = New KineticaRT.Values.Double(TBHiLimit)

            Catch Ex As Exception
                MessageBox.Show("Compute_GTCP85_129_Perf: " & Ex.ToString)
            End Try
        End Sub

        Private Function Create13031PerformanceFile(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean

            'Declaration

            Dim currentSheet As String

            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            Create13031PerformanceFile = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            Try
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    currentSheet = "SUMMARY"
                    excelWorksheet = excelSheets.Item(currentSheet)
                    'excelWorksheet = excelSheets.Item("APU CONDITION TEST SHEET")

                    Dim row As Integer = 2
                    Dim column As Integer = 5

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = CELProject.EngineModel + " APU TEST DATA SHEET"

                    row = 5
                    column = 3

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.CustomerName
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.WorkOrder
                    row += 1
                    If EngineFamilyHJK Then
                        excelWorksheet.Cells(row, column).NumberFormat = "@"
                        excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.EnginePartNumber
                        row += 1
                    ElseIf (EngineFamilyCEFG Or EngineFamilyABD) Then
                        excelWorksheet.Cells(row, column).NumberFormat = "@"
                        excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.EnginePartNumberAndServiceBulletin
                        row += 1
                    End If
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.EngineSerialNumber
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.RepairTypeDescription
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.TestType

                    row = 5
                    column = 9

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = Format(Now, "MM/dd/yyyy")
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.LHV
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.SampleFuelSG
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.SampleFuelTemperature
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.FuelType
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.OilType

                    'Parametrisation du rapport selon les familles
                    excelWorksheet.Cells(50, 9).NumberFormat = "@"
                    excelWorksheet.Cells(52, 9).NumberFormat = "@"
                    excelWorksheet.Cells(53, 9).NumberFormat = "@"
                    excelWorksheet.Cells(54, 1).NumberFormat = "@"
                    excelWorksheet.Cells(54, 9).NumberFormat = "@"
                    excelWorksheet.Cells(54, 10).NumberFormat = "@"
                    excelWorksheet.Cells(56, 9).NumberFormat = "@"
                    excelWorksheet.Cells(56, 10).NumberFormat = "@"

                    If (EngineFamilyABD Or EngineFamilyCEFG Or
                        (CELProject.EngineModel = "GTCP85-129H") Or (CELProject.EngineModel = "GTCP85-129K")) Then
                        excelWorksheet.Cells(54, 1).Value = "35 % SW. ACT. SPEED"
                        excelWorksheet.Cells(54, 9).Value = "14500"
                        excelWorksheet.Cells(54, 10).Value = "16500"
                    ElseIf (CELProject.EngineModel = "GTCP85-129J") Then
                        excelWorksheet.Cells(54, 1).Value = "50 % SW. ACT. SPEED"
                        excelWorksheet.Cells(54, 9).Value = "19000"
                        excelWorksheet.Cells(54, 10).Value = "21000"
                    End If

                    If EngineFamilyABD Then
                        excelWorksheet.Cells(56, 9).Value = "400"
                        excelWorksheet.Cells(56, 10).Value = "1100"
                    End If

                    If ((EngineFamilyCEFG Or EngineFamilyHJK) And eRepairType.LightMedium) Then
                        excelWorksheet.Cells(53, 9).Value = "0"
                    End If

                    If EngineFamilyHJK Then
                        excelWorksheet.Cells(50, 9).Value = "270 (125 above ambient)"
                    End If

                    If EngineFamilyABD Then
                        excelWorksheet.Cells(26, 9).Value = "25-28"      'SHPCOR
                    ElseIf (EngineFamilyHJK Or EngineFamilyCEFG) Then
                        excelWorksheet.Cells(26, 9).Value = "30-33"      'SHPCOR
                    End If

                    If eRepairType.LightMedium Then
                        excelWorksheet.Cells(52, 9).Value = "4"
                    End If


                    currentSheet = "DETAILS"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    If (EngineFamilyABD Or EngineFamilyCEFG) Then
                        excelWorksheet.Cells(28, 9).Value = "1200"  ' egt Check
                        excelWorksheet.Cells(36, 9).Value = "1200" ' egt Overlaod
                    ElseIf EngineFamilyHJK Then
                        excelWorksheet.Cells(28, 9).Value = "1200"   ' egt Check    ( range 1150-1275)
                        excelWorksheet.Cells(36, 9).Value = "1200"  ' egt Overload  ( range 1150-1275) 
                    End If

                    ' Parametrisation Fin

                    currentSheet = "ACCEPTANCE"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    'APU Tested according to
                    excelWorksheet.Cells(48, 4).NumberFormat = "@"
                    excelWorksheet.Cells(48, 4).Value = Custom_Parameters("APUTestedAccordingTo").ToString()


                End If


                currentSheet = "SUMMARY"
                excelWorksheet = excelSheets.Item(currentSheet)

                Select Case TestStepNumber
                    Case eTestStepGTCP85_129.ACCELERATION_CRACK_PRESSURE

                        excelWorksheet.Cells(40, 7).Value = PERF_REC_FUEL_CRACKING.Value.ToString(PERF_REC_FUEL_CRACKING.Format, Nothing)
                        excelWorksheet.Cells(40, 7).Value = " N/A "  ' South Africa ne lie pas cette valeur, donc on la laisse a N/A dans le rapport. 

                        excelWorksheet.Cells(46, 7).Value = PERF_REC_FUEL_INLET_PRESS.Value.ToString(PERF_REC_FUEL_INLET_PRESS.Format, Nothing)

                        'Case eTestStepGTCP85_129.RTL:
                    Case eTestStepGTCP85_129.NO_LOAD

                        'Test Performance Detail
                        excelWorksheet.Cells(54, 7).Value = SPEED_SWITCH_ACTUATION_35_PCT.Value.ToString(SPEED_SWITCH_ACTUATION_35_PCT.Format, Nothing)
                        excelWorksheet.Cells(55, 7).Value = SPEED_SWITCH_ACTUATION_95_PCT.Value.ToString(SPEED_SWITCH_ACTUATION_95_PCT.Format, Nothing)


                        excelWorksheet.Cells(17, 6).Value = "N/A" 'PBStd_MEAN.Value.ToString(				PBStd_MEAN.Format				,Nothing)
                        excelWorksheet.Cells(19, 6).Value = "N/A" 'WBStd_MEAN.Value.ToString(				WBStd_MEAN.Format				,Nothing)
                        excelWorksheet.Cells(21, 6).Value = "N/A" 'TBStd_MEAN.Value.ToString(				TBStd_MEAN.Format				,Nothing)
                        excelWorksheet.Cells(22, 6).Value = LOG_PERF_T_EGT_DEGF_AVG.Value.ToString(LOG_PERF_T_EGT_DEGF_AVG.Format, Nothing)
                        excelWorksheet.Cells(24, 6).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)
                        excelWorksheet.Cells(26, 6).Value = "N/A" 'GEN_COR_MEAN.Value.ToString(				GEN_COR_MEAN.Format				,Nothing)
                        excelWorksheet.Cells(28, 6).Value = LOG_PERF_VIB_GEARBOX_MILS.Value.ToString(LOG_PERF_VIB_GEARBOX_MILS.Format, Nothing)
                        excelWorksheet.Cells(30, 6).Value = LOG_PERF_VIB_TURBINE_MILS.Value.ToString(LOG_PERF_VIB_TURBINE_MILS.Format, Nothing)

                        '        'Case eTestStepGTCP85_129.ECS_ONLY:
                    Case eTestStepGTCP85_129.BLEED_LOAD_ONLY

                        'Performance Limits at 0SHP depends on type of repair Heavy / Light Medium
                        'If UserInputs.RepairTypeID = Gtcp85129.eRepairType.OverhauledEngine Then

                        excelWorksheet.Cells(17, 7).Value = LOG_PERF_PBStd_LOW_LIMIT.Value.ToString(LOG_PERF_PBStd_LOW_LIMIT.Format, Nothing)   '   "94.6"       'PB
                        excelWorksheet.Cells(19, 7).Value = LOG_PERF_WBStd_LOW_LIMIT.Value.ToString(LOG_PERF_WBStd_LOW_LIMIT.Format, Nothing)   '   "126"        'WB
                        excelWorksheet.Cells(21, 7).Value = LOG_PERF_TBStd_LOW_LIMIT.Value.ToString(LOG_PERF_TBStd_LOW_LIMIT.Format, Nothing) + "-" + LOG_PERF_TBStd_HI_LIMIT.Value.ToString(LOG_PERF_TBStd_HI_LIMIT.Format, Nothing)  ' "418-488"    'TB
                        excelWorksheet.Cells(22, 7).Value = "1200"       'EGT

                        excelWorksheet.Cells(17, 8).Value = LOG_PERF_PBStd.Value.ToString(LOG_PERF_PBStd.Format, Nothing)
                        excelWorksheet.Cells(19, 8).Value = LOG_PERF_WBStd.Value.ToString(LOG_PERF_WBStd.Format, Nothing)
                        excelWorksheet.Cells(21, 8).Value = LOG_PERF_TBStd.Value.ToString(LOG_PERF_TBStd.Format, Nothing)
                        excelWorksheet.Cells(22, 8).Value = LOG_PERF_T_EGT_DEGF_AVG.Value.ToString(LOG_PERF_T_EGT_DEGF_AVG.Format, Nothing)
                        excelWorksheet.Cells(24, 8).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)
                        excelWorksheet.Cells(26, 8).Value = "N/A" 'GEN_COR_MEAN.Value.ToString(				GEN_COR_MEAN.Format				,Nothing)								
                        excelWorksheet.Cells(28, 8).Value = LOG_PERF_VIB_GEARBOX_MILS.Value.ToString(LOG_PERF_VIB_GEARBOX_MILS.Format, Nothing)
                        excelWorksheet.Cells(30, 8).Value = LOG_PERF_VIB_TURBINE_MILS.Value.ToString(LOG_PERF_VIB_TURBINE_MILS.Format, Nothing)

                        '        'Case eTestStepGTCP85_129.ECS_25-30SHP:
                    Case eTestStepGTCP85_129.COMBINATION_LOAD

                        '        'Performance Limits at 60HP depends on type of repair Heavy / Light Medium
                        '        If UserInputs.RepairTypeID = Gtcp8598.eRepairType.OverhauledEngine Then

