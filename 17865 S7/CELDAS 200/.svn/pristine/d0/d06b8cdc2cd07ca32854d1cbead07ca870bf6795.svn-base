                Return_Value.Add(MyBase.InitializeChannel(POWER_BTN_CMD_PULSE, "POWER_BTN_CMD_PULSE"))
                Return_Value.Add(MyBase.InitializeChannel(REPAIR_TYPE, "REPAIR_TYPE"))
                Return_Value.Add(MyBase.InitializeChannel(SPEED_SWITCH_ACTUATION_35_PCT, "SPEED_SWITCH_ACTUATION_35_PCT"))
                Return_Value.Add(MyBase.InitializeChannel(SPEED_SWITCH_ACTUATION_50_PCT, "SPEED_SWITCH_ACTUATION_50_PCT"))
                Return_Value.Add(MyBase.InitializeChannel(SPEED_SWITCH_ACTUATION_95_PCT, "SPEED_SWITCH_ACTUATION_95_PCT"))
                Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_CELL_SOURCE_DEGF, "LOG_PERF_T_CELL_SOURCE_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(T_EGT_TC_DEGF_AVG_MEAN, "T_EGT_TC_DEGF_AVG_MEAN"))
                Return_Value.Add(MyBase.InitializeChannel(T_EGT_TC1_SOURCE_DEGF, "T_EGT_TC1_SOURCE_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(T_EGT_TC_DEGF_AVG, "T_EGT_TC_DEGF_AVG"))
                Return_Value.Add(MyBase.InitializeChannel(T_EGT_DEGF_AVG, "T_EGT_DEGF_AVG"))
                Return_Value.Add(MyBase.InitializeChannel(TBChng, "TBChng"))
                Return_Value.Add(MyBase.InitializeChannel(TBStd, "TBStd"))
                Return_Value.Add(MyBase.InitializeChannel(TBStd_HI_LIMIT, "TBStd_HI_LIMIT"))
                Return_Value.Add(MyBase.InitializeChannel(TBStd_LOW_LIMIT, "TBStd_LOW_LIMIT"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_GEARBOX_MAX_MILS_PERSISTENT, "VIB_GEARBOX_MAX_MILS_PERSISTENT"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_TURBINE_MAX_MILS_PERSISTENT, "VIB_TURBINE_MAX_MILS_PERSISTENT"))
                Return_Value.Add(MyBase.InitializeChannel(VIEW_ALL_CONTROLS_BTN, "VIEW_ALL_CONTROLS_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(WB_CALC, "WB_CALC"))
                Return_Value.Add(MyBase.InitializeChannel(WBChng, "WBChng"))
                Return_Value.Add(MyBase.InitializeChannel(WBStd, "WBStd"))
                Return_Value.Add(MyBase.InitializeChannel(WBStd_LOW_LIMIT, "WBStd_LOW_LIMIT"))
                Return_Value.Add(MyBase.InitializeChannel(WF_TOT1, "WF_TOT1"))



                If CELProject.EngineModel = "GTCP85-129" Or _
                   CELProject.EngineModel = "GTCP85-129A" Or _
                   CELProject.EngineModel = "GTCP85-129B" Or _
                   CELProject.EngineModel = "GTCP85-129D" Then
                    EngineFamilyABD = True
                Else
                    EngineFamilyABD = False
                End If

                If CELProject.EngineModel = "GTCP85-129C" Or _
                   CELProject.EngineModel = "GTCP85-129E" Or _
                   CELProject.EngineModel = "GTCP85-129F" Or _
                   CELProject.EngineModel = "GTCP85-129G" Then
                    EngineFamilyCEFG = True
                Else
                    EngineFamilyCEFG = False
                End If

                If CELProject.EngineModel = "GTCP85-129H" Or _
                   CELProject.EngineModel = "GTCP85-129J" Or _
                   CELProject.EngineModel = "GTCP85-129K" Then
                    EngineFamilyHJK = True
                Else
                    EngineFamilyHJK = False
                End If




                MyBase.InitializeObject(cmbTestStepList, "GTCP85_129_Screen.fraControl.TestStep_List")

                'MM TODO Me.SetTestStepList(0)

                'MM cmbTestStepList.SelectedIndex = 0     'Problème ici ?

                'Dim hmiWindow As Object = MyBase.GetObject("GTCP85-189_Screen")
                'cmbTestStepList = CELProject.SearchControl(hmiWindow, "TestStep_List")
                'Debug.Assert(Not IsNothing(cmbTestStepList), "Control TestStep_List Is Nothing")

                If cmbTestStepList Is Nothing Then 'initialize in ConfigHMIforEngine
                    MessageBox.Show("MyBase.InitializeObject - TestStep_List Is Nothing")
                    Return_Value.Add(False)
                Else
                    Return_Value.Add(True)
                End If

                If UserInputsSouthAfricanAirways.RepairTypeDescription = "Heavy" Then
                    REPAIR_TYPE.Value = New KineticaRT.Values.Double(eRepairType.Heavy)
                Else
                    REPAIR_TYPE.Value = New KineticaRT.Values.Double(eRepairType.LightMedium)
                End If

                'It seems that we have a little problem of initialization at HMI. This is helping to see the NaN when starting the system!!
                PBStd.Value = Values.Zero
                TBStd.Value = Values.Zero
                WBStd.Value = Values.Zero
                PBChng.Value = Values.Zero
                TBChng.Value = Values.Zero
                WBChng.Value = Values.Zero

            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.ToString())
                Return_Value.Add(False)
            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function

