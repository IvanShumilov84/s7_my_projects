    Public Class UserInputGarudaGTCP85_129

        Public EngineSerialNumber As String = ""
        Public WorkOrder As String = ""
        Public TestNumber As String = ""
        Public PDSheetNumber As String = ""
        Public CustomerName As String = ""
        Public Field5_NotUsed As String = ""
        Public LHV As String = ""
        Public SampleFuelSG As String = ""
        Public SampleFuelTemperature As String = ""
        Public OilType As String = ""
        Public FuelType As String = ""
        Public Field11_NotUsed As String = ""
        Public TSN_TSO As String = ""

        Public TestType As String = ""
        Public RepairTypeID As Gtcp85129.eRepairType = Gtcp85129.eRepairType.NotApplicable
        Public Reason As String = ""

        Public RepairTypeDescription As String = ""

        Public OperatorName As String = ""
        Public ObserverName As String = ""
        Public SupervisorName As String = ""
        Public QCInspectorName As String = ""


        ' Allow friend access to the empty constructor.
        Friend Sub New()

        End Sub

        '***************************
        '* MapUserInputsParameters *
        '***************************
        Public Sub MapUserInputsParameters(ByRef CELProject As CELDAS)

            EngineSerialNumber = CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
            WorkOrder = CELProject.Test_Mgr_UUT_Answer(1).Value.ToString()
            TestNumber = CELProject.Test_Mgr_UUT_Answer(2).Value.ToString()
            PDSheetNumber = CELProject.Test_Mgr_UUT_Answer(3).Value.ToString()
            CustomerName = CELProject.Test_Mgr_UUT_Answer(8).Value.ToString()
            Field5_NotUsed = CELProject.Test_Mgr_UUT_Answer(5).Value.ToString() 'not used user input
            LHV = CELProject.Test_Mgr_UUT_Answer(3).Value.ToString()
            SampleFuelSG = CELProject.Test_Mgr_UUT_Answer(4).Value.ToString() 'SG is used in some formula in test session
            SampleFuelTemperature = CELProject.Test_Mgr_UUT_Answer(5).Value.ToString() 'also use in some formula in test session
            OilType = CELProject.Test_Mgr_UUT_Answer(6).Value.ToString()
            FuelType = CELProject.Test_Mgr_UUT_Answer(7).Value.ToString()
            Field11_NotUsed = CELProject.Test_Mgr_UUT_Answer(11).Value.ToString() 'not used user input
            TSN_TSO = CELProject.Test_Mgr_UUT_Answer(12).Value.ToString() 'not used user input
            RepairTypeDescription = CELProject.Test_Mgr_UUT_Choice(3).Value.ToString()

            If RepairTypeDescription = "Heavy" Then
                RepairTypeID = Gtcp85129.eRepairType.OverhauledEngine
            Else
                RepairTypeID = Gtcp85129.eRepairType.RepairedEngine
            End If

            TestType = CELProject.Test_Mgr_UUT_Choice(0).Value.ToString()
            Reason = CELProject.Test_Mgr_UUT_Choice(2).Value.ToString()
            OperatorName = CELProject.Test_Mgr_UUT_Choice(1).Value.ToString()
            ObserverName = CELProject.Test_Mgr_UUT_Choice(5).Value.ToString()
            SupervisorName = CELProject.Test_Mgr_UUT_Choice(6).Value.ToString()
            QCInspectorName = CELProject.Test_Mgr_UUT_Choice(2).Value.ToString()

        End Sub

    End Class

    Public Class UserInput13031_GTCP85_129

        Public EngineSerialNumber As String = ""
        Public WorkOrder As String = ""
        Public CustomerName As String = ""
        Public LHV As String = ""
        Public SampleFuelSG As String = ""
        Public SampleFuelTemperature As String = ""
        Public OilType As String = ""
        Public FuelType As String = ""
        Public EnginePartNumber = ""

        Public TestType As String = ""
        Public RepairTypeID As Gtcp85129.eRepairType = Gtcp85129.eRepairType.NotApplicable
        Public RepairTypeDescription As String = ""
        Public OperatorName As String = ""
        Public QCInspectorName As String = ""
        Public EnginePartNumberAndServiceBulletin As String = ""

        ' Allow friend access to the empty constructor.
        Friend Sub New()

        End Sub

        '***************************
        '* MapUserInputsParameters *
        '***************************
        Public Sub MapUserInputsParameters(ByRef CELProject As CELDAS)

            EngineSerialNumber = CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
            WorkOrder = CELProject.Test_Mgr_UUT_Answer(1).Value.ToString()
            EnginePartNumber = CELProject.Test_Mgr_UUT_Answer(2).Value.ToString()
            LHV = CELProject.Test_Mgr_UUT_Answer(3).Value.ToString()
            SampleFuelSG = CELProject.Test_Mgr_UUT_Answer(4).Value.ToString() 'SG is used in some formula in test session
            SampleFuelTemperature = CELProject.Test_Mgr_UUT_Answer(5).Value.ToString() 'also use in some formula in test session
            OilType = CELProject.Test_Mgr_UUT_Answer(6).Value.ToString()
            FuelType = CELProject.Test_Mgr_UUT_Answer(7).Value.ToString()
            CustomerName = CELProject.Test_Mgr_UUT_Answer(8).Value.ToString()


            TestType = CELProject.Test_Mgr_UUT_Choice(0).Value.ToString()
            OperatorName = CELProject.Test_Mgr_UUT_Choice(1).Value.ToString()
            QCInspectorName = CELProject.Test_Mgr_UUT_Choice(2).Value.ToString()
            RepairTypeDescription = CELProject.Test_Mgr_UUT_Choice(3).Value.ToString()
            EnginePartNumberAndServiceBulletin = CELProject.Test_Mgr_UUT_Choice(4).Value.ToString()

            ' Reason = CELProject.Test_Mgr_UUT_Choice(2).Value.ToString()
            ' ObserverName = CELProject.Test_Mgr_UUT_Choice(5).Value.ToString()
            ' SupervisorName = CELProject.Test_Mgr_UUT_Choice(6).Value.ToString()

            If RepairTypeDescription = "Heavy" Then
                RepairTypeID = Gtcp85129.eRepairType.OverhauledEngine
            Else
                RepairTypeID = Gtcp85129.eRepairType.RepairedEngine
            End If


        End Sub

    End Class

