                        excelWorksheet.Cells(19, 9).Value = LOG_PERF_WBStd_LOW_LIMIT.Value.ToString(LOG_PERF_WBStd_LOW_LIMIT.Format, Nothing)  '"106.7"      'WB
                        excelWorksheet.Cells(21, 9).Value = LOG_PERF_TBStd_LOW_LIMIT.Value.ToString(LOG_PERF_TBStd_LOW_LIMIT.Format, Nothing) + "-" + LOG_PERF_TBStd_HI_LIMIT.Value.ToString(LOG_PERF_TBStd_HI_LIMIT.Format, Nothing)  ' "418-488"    'TB

                        excelWorksheet.Cells(17, 10).Value = LOG_PERF_PBStd.Value.ToString(LOG_PERF_PBStd.Format, Nothing)
                        excelWorksheet.Cells(19, 10).Value = LOG_PERF_WBStd.Value.ToString(LOG_PERF_WBStd.Format, Nothing)
                        excelWorksheet.Cells(21, 10).Value = LOG_PERF_TBStd.Value.ToString(LOG_PERF_TBStd.Format, Nothing)
                        excelWorksheet.Cells(22, 10).Value = LOG_PERF_T_EGT_DEGF_AVG.Value.ToString(LOG_PERF_T_EGT_DEGF_AVG.Format, Nothing)
                        excelWorksheet.Cells(24, 10).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)
                        excelWorksheet.Cells(26, 10).Value = LOG_PERF_GENERATOR_CORRECTED_SHAFT_POWER_HP.Value.ToString(LOG_PERF_GENERATOR_CORRECTED_SHAFT_POWER_HP.Format, Nothing)
                        excelWorksheet.Cells(28, 10).Value = LOG_PERF_VIB_GEARBOX_MILS.Value.ToString(LOG_PERF_VIB_GEARBOX_MILS.Format, Nothing)
                        excelWorksheet.Cells(30, 10).Value = LOG_PERF_VIB_TURBINE_MILS.Value.ToString(LOG_PERF_VIB_TURBINE_MILS.Format, Nothing)


                        excelWorksheet.Cells(37, 7).Value = LOG_PERF_P_BARO_SOURCE_INHGA.Value.ToString(LOG_PERF_P_BARO_SOURCE_INHGA.Format, Nothing)
                        excelWorksheet.Cells(38, 7).Value = LOG_PERF_T_CELL_SOURCE_DEGF.Value.ToString(LOG_PERF_T_CELL_SOURCE_DEGF.Format, Nothing)
                        excelWorksheet.Cells(39, 7).Value = LOG_PERF_T_INLET_DEGF_AVG.Value.ToString(LOG_PERF_T_INLET_DEGF_AVG.Format, Nothing)

                    Case eTestStepGTCP85_129.CAPTURE_FINAL_DATA

                        excelWorksheet.Cells(41, 7).Value = LOG_PERF_VIB_GEARBOX_MILS.Value.ToString(LOG_PERF_VIB_GEARBOX_MILS.Format, Nothing)
                        excelWorksheet.Cells(43, 7).Value = LOG_PERF_VIB_TURBINE_MILS.Value.ToString(LOG_PERF_VIB_TURBINE_MILS.Format, Nothing)
                        excelWorksheet.Cells(45, 7).Value = LOG_PERF_NG_RPM.Value.ToString(LOG_PERF_NG_RPM.Format, Nothing)
                        excelWorksheet.Cells(47, 7).Value = LOG_PERF_P_FUEL_DISCHARGE_SOURCE_PSIG.Value.ToString(LOG_PERF_P_FUEL_DISCHARGE_SOURCE_PSIG.Format, Nothing)
                        excelWorksheet.Cells(48, 7).Value = LOG_PERF_P_OIL_SOURCE_PSIG.Value.ToString(LOG_PERF_P_OIL_SOURCE_PSIG.Format, Nothing)
                        excelWorksheet.Cells(49, 7).Value = PERF_REC_OIL_PUMP_FLUCTUATION.Value.ToString(PERF_REC_OIL_PUMP_FLUCTUATION.Format, Nothing)
                        excelWorksheet.Cells(50, 7).Value = LOG_PERF_T_OIL_DEGF.Value.ToString(LOG_PERF_T_OIL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(52, 7).Value = LOG_PERF_P_TURBINE_BEARING_CAVITY_SOURCE_INHGG.Value.ToString(LOG_PERF_P_TURBINE_BEARING_CAVITY_SOURCE_INHGG.Format, Nothing)
                        excelWorksheet.Cells(53, 7).Value = LOG_PERF_P_ACC_GEARCASE_SOURCE_INHGG.Value.ToString(LOG_PERF_P_ACC_GEARCASE_SOURCE_INHGG.Format, Nothing)
                        excelWorksheet.Cells(56, 7).Value = PERF_REC_SPEED_DROP.Value.ToString(PERF_REC_SPEED_DROP.Format, Nothing)
                        excelWorksheet.Cells(57, 7).Value = PERF_REC_AIR_PRESSURE.Value.ToString(PERF_REC_AIR_PRESSURE.Format, Nothing)

                End Select

                currentSheet = "DETAILS"
                excelWorksheet = excelSheets.Item(currentSheet)

                Select Case TestStepNumber

                    'Case eTestStepGTCP85_129.RTL:
                    Case eTestStepGTCP85_129.NO_LOAD

                        'Do Nothing

                        'Case eTestStepGTCP85_129.ECS_ONLY:
                    Case eTestStepGTCP85_129.BLEED_LOAD_ONLY

                        excelWorksheet.Cells(15, 7).Value = LOG_PERF_WB.Value.ToString(LOG_PERF_WB.Format, Nothing)
                        excelWorksheet.Cells(16, 7).Value = LOG_PERF_P_BLEED_SOURCE_INHGA.Value.ToString(LOG_PERF_P_BLEED_SOURCE_INHGA.Format, Nothing)
                        excelWorksheet.Cells(17, 7).Value = LOG_PERF_T_BLEED_SOURCE_DEGF.Value.ToString(LOG_PERF_T_BLEED_SOURCE_DEGF.Format, Nothing)


                        'Case eTestStepGTCP85_129.ECS_25/30SHP:
                    Case eTestStepGTCP85_129.COMBINATION_LOAD

                        'Parametrisation du rapport selon les familles
                        excelWorksheet.Cells(18, 1).NumberFormat = "@"
                        excelWorksheet.Cells(19, 1).NumberFormat = "@"
                        excelWorksheet.Cells(20, 1).NumberFormat = "@"
                        If EngineFamilyABD Then
                            excelWorksheet.Cells(18, 1).Value = "BLEED AIR FLOW (25 SHP)"
                            excelWorksheet.Cells(19, 1).Value = "BLEED AIR PRESS (25 SHP)"
                            excelWorksheet.Cells(20, 1).Value = "BLEED AIR TEMP (25 SHP)"
                        ElseIf (EngineFamilyHJK Or EngineFamilyCEFG) Then
                            excelWorksheet.Cells(18, 1).Value = "BLEED AIR FLOW (30 SHP)"
                            excelWorksheet.Cells(19, 1).Value = "BLEED AIR PRESS (30 SHP)"
                            excelWorksheet.Cells(20, 1).Value = "BLEED AIR TEMP (30 SHP)"
                        End If
                        'Parametrisation fin

                        excelWorksheet.Cells(18, 7).Value = LOG_PERF_WB.Value.ToString(LOG_PERF_WB.Format, Nothing)
                        excelWorksheet.Cells(19, 7).Value = LOG_PERF_P_BLEED_SOURCE_INHGA.Value.ToString(LOG_PERF_P_BLEED_SOURCE_INHGA.Format, Nothing)
                        excelWorksheet.Cells(20, 7).Value = LOG_PERF_T_BLEED_SOURCE_DEGF.Value.ToString(LOG_PERF_T_BLEED_SOURCE_DEGF.Format, Nothing)
                        excelWorksheet.Cells(21, 7).Value = LOG_PERF_P_ORIFICE_SOURCE_INHGG.Value.ToString(LOG_PERF_P_ORIFICE_SOURCE_INHGG.Format, Nothing)
                        excelWorksheet.Cells(22, 7).Value = LOG_PERF_T_ORIFICE_SOURCE_DEGF.Value.ToString(LOG_PERF_T_ORIFICE_SOURCE_DEGF.Format, Nothing)
                        excelWorksheet.Cells(23, 7).Value = LOG_PERF_P_ORIFICE_DELTA_SOURCE_INH2OD.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_SOURCE_INH2OD.Format, Nothing)

                        If (EngineFamilyABD Or EngineFamilyCEFG) Then
                            excelWorksheet.Cells(25, 7).Value = LOG_PERF_T_EGT_TC1_SOURCE_DEGF.Value.ToString(LOG_PERF_T_EGT_TC1_SOURCE_DEGF.Format, Nothing)
                        ElseIf EngineFamilyHJK Then
                            excelWorksheet.Cells(25, 7).Value = LOG_PERF_T_EGT_TC_DEGF_AVG.Value.ToString(LOG_PERF_T_EGT_TC_DEGF_AVG.Format, Nothing)
                        End If

                        excelWorksheet.Cells(26, 7).Value = LOG_PERF_T_EGT_DEGF_AVG.Value.ToString(LOG_PERF_T_EGT_DEGF_AVG.Format, Nothing)

                    Case eTestStepGTCP85_129.ACCELERATION_CRACK_PRESSURE_RECHECK

                        excelWorksheet.Cells(38, 7).Value = " N/A "  ' South Africa ne lie pas cette valeur, donc on la laisse a N/A dans le rapport.

                    Case eTestStepGTCP85_129.CAPTURE_FINAL_DATA

                        excelWorksheet.Cells(28, 7).Value = PERF_REC_ETC_CHECK.Value.ToString(PERF_REC_ETC_CHECK.Format, Nothing) 'Load Control Thermostat for -98DHF
                        excelWorksheet.Cells(30, 7).Value = PERF_REC_ETC_RECHECK.Value.ToString(PERF_REC_ETC_RECHECK.Format, Nothing) 'Load Control Thermostat for -98DHF
                        excelWorksheet.Cells(32, 7).Value = PERF_REC_LOAD_AIR_CHECK.Value.ToString(PERF_REC_LOAD_AIR_CHECK.Format, Nothing)
                        excelWorksheet.Cells(33, 7).Value = Log_Perf_BleedAirOsc.Value.ToString(Log_Perf_BleedAirOsc.Format, Nothing)
                        excelWorksheet.Cells(34, 7).Value = PERF_REC_MIN_SPEED_OVERLOAD_CHECK.Value.ToString(PERF_REC_MIN_SPEED_OVERLOAD_CHECK.Format, Nothing)
                        excelWorksheet.Cells(36, 7).Value = Log_Perf_MaxEGTDuringOL.Value.ToString(Log_Perf_MaxEGTDuringOL.Format, Nothing)
                        excelWorksheet.Cells(38, 7).Value = " N/A "  ' NO crack pressure gauge on 13031.
                        excelWorksheet.Cells(39, 7).Value = PERF_REC_NB_START.Value.ToString(PERF_REC_NB_START.Format, Nothing)  'NUMBER_OF_STARTS.Value.ToString(NUMBER_OF_STARTS.Format, Nothing)
                        excelWorksheet.Cells(40, 7).Value = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format, Nothing) 'TODO Log_Perf_OperatingTime.Value.ToString()

                        If CELProject.IsTrue(PERF_REC_ENG_VIB_HOT_OIL_CHECK.Value) Then
                            excelWorksheet.Cells(41, 7).Value = "Done"
                        Else
                            excelWorksheet.Cells(41, 7).Value = "    "
                        End If


                End Select

                TestProgress_RecordPerfStep()

                currentSheet = "ACCEPTANCE"
                excelWorksheet = excelSheets.Item(currentSheet)

                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                End If

                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                End If

                If CELProject.IsTrue(PERF_PRESERVATION_YES.Value) Then
                    excelWorksheet.OLEObjects("PreservationYes").object.value = True
                    excelWorksheet.Cells(51, 6).NumberFormat = "@"
                    excelWorksheet.Cells(51, 6).Value = "    Yes for " + PERF_PRESERVATION_MONTH.Value.ToString() + " Months"
                Else
                    excelWorksheet.OLEObjects("PreservationYes").object.value = False
                End If

                If CELProject.IsTrue(PERF_PRESERVATION_NO.Value) Then
                    excelWorksheet.OLEObjects("PreservationNo").object.value = True
                Else
                    excelWorksheet.OLEObjects("PreservationNo").object.value = False
                End If

                excelWorksheet.Cells(54, 3).Value = UserInputsSouthAfricanAirways.OperatorName
                excelWorksheet.Cells(55, 3).Value = UserInputsSouthAfricanAirways.QCInspectorName

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile: " + ex.Message)
                MessageBox.Show(ex.ToString)
                Create13031PerformanceFile = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)

            End Try
        End Function

        Private Function CreateStandardCELPerformanceFile(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean

            'template pour Nouveau projet

        End Function

        Private GTCP85_129_NO_LOAD(,) As Double ' Used to keep a database table in memory for fast access
        Private GTCP85_129_LOAD(,) As Double ' Used to keep a database table in memory for fast access

        Private Function Initialize_Arrays()

            Dim engineSeries As String = String.Empty

            If EngineFamilyABD Then
                engineSeries = "GTCP85-129ABD"
            ElseIf EngineFamilyCEFG Then
                engineSeries = "GTCP85-129CEFG"
            ElseIf EngineFamilyHJK Then
                engineSeries = "GTCP85-129HJK"
            Else
                Debug.Assert(False, "Engine serie not supported")
            End If

            Try
                'Query Database
                Dim engineCorrectionFactors As Gtcp85129Collection = New Gtcp85129Collection
                engineCorrectionFactors.es.Connection.Name = CELProject.DefaultConnectionName

                '* SelectString = "SELECT Tcl,WB_Chng,PB_Chng,TB_Chng FROM GTCP85_129_ShaftLoad_Category INNER JOIN GTCP85_129ABD ON "
                '* SelectString += "GTCP85_129_ShaftLoad_Category.ShaftLoadValue = GTCP85_129ABD.ShaftLoad WHERE "
                '* SelectString += "((GTCP85_129_ShaftLoad_Category.Description=""Zero Shaft Load (Heavy Repair)"") AND "
                '* SelectString += "(GTCP85_129_ShaftLoad_Category.Engine_Model=""GTCP85-129ABD"")) ORDER BY Tcl"
                '* 
                '* SelectString = "SELECT Tcl,WB_Chng,PB_Chng,TB_Chng FROM GTCP85_129_ShaftLoad_Category INNER JOIN GTCP85_129ABD ON "
                '* SelectString += "GTCP85_129_ShaftLoad_Category.ShaftLoadValue = GTCP85_129ABD.ShaftLoad WHERE "
                '* SelectString += "((GTCP85_129_ShaftLoad_Category.Description=""Zero Shaft Load (Light/Med) Repair)"") AND "
                '* SelectString += "(GTCP85_129_ShaftLoad_Category.Engine_Model=""GTCP85-129ABD"")) ORDER BY Tcl"

                engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.EngineSeries = engineSeries)
                engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.RepairTypeEnum = UserInputsSouthAfricanAirways.RepairTypeID)
                engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.ShaftLoad = 0) 'No Load (0 SHP)
                engineCorrectionFactors.Query.OrderBy(engineCorrectionFactors.Query.Tcl.Ascending)
                engineCorrectionFactors.Query.Load()

                Debug.Assert(engineCorrectionFactors.Count > 0, "GTCP85-129.Init_Arrays: engineCorrectionFactors returned 0 record for 0 SHP")

                Dim i As Integer = 0
                ReDim GTCP85_129_NO_LOAD(engineCorrectionFactors.Count - 1, 3)
                For Each correctionFactor As Gtcp85129 In engineCorrectionFactors
                    GTCP85_129_NO_LOAD(i, 0) = correctionFactor.Tcl
                    GTCP85_129_NO_LOAD(i, 1) = correctionFactor.WBChng
                    GTCP85_129_NO_LOAD(i, 2) = correctionFactor.PBChng
                    GTCP85_129_NO_LOAD(i, 3) = correctionFactor.TBChng
                    i += 1
                Next

                engineCorrectionFactors.Dispose()
                engineCorrectionFactors = New Gtcp85129Collection

                '* SelectString = "SELECT Tcl,WB_Chng,PB_Chng,TB_Chng FROM GTCP85_129_ShaftLoad_Category INNER JOIN GTCP85_129ABD ON "
                '* SelectString += "GTCP85_129_ShaftLoad_Category.ShaftLoadValue = GTCP85_129ABD.ShaftLoad WHERE "
                '* SelectString += "((GTCP85_129_ShaftLoad_Category.Description=""Combined 25 HP Shaft Load and Bleed Air Load"") AND "
                '* SelectString += "(GTCP85_129_ShaftLoad_Category.Engine_Model=""GTCP85-129ABD"")) ORDER BY Tcl"

                Select Case engineSeries
                    Case "GTCP85-129ABD"
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.ShaftLoad = 25) ' 25 SHP
                    Case "GTCP85-129CEFG"
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.ShaftLoad = 30) ' 30 SHP
                    Case "GTCP85-129HJK"
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.ShaftLoad = 30) ' 30 SHP
                    Case Else
                        Debug.Assert(False, "Engine serie not supported")
                End Select

                engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.EngineSeries = engineSeries)
                engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.RepairTypeEnum = Gtcp85129.eRepairType.NotApplicable) ' For combined there is no difference for Overhauled or Repaired engine
                engineCorrectionFactors.Query.OrderBy(engineCorrectionFactors.Query.Tcl.Ascending)
                engineCorrectionFactors.Query.Load()

                Debug.Assert(engineCorrectionFactors.Count > 0, "GTCP85-129.Init_Arrays: engineCorrectionFactors returned 0 record for 0 SHP")

                i = 0
                ReDim GTCP85_129_LOAD(engineCorrectionFactors.Count - 1, 3)
                For Each correctionFactor As Gtcp85129 In engineCorrectionFactors
                    GTCP85_129_LOAD(i, 0) = correctionFactor.Tcl
                    GTCP85_129_LOAD(i, 1) = correctionFactor.WBChng
                    GTCP85_129_LOAD(i, 2) = correctionFactor.PBChng
                    GTCP85_129_LOAD(i, 3) = correctionFactor.TBChng
                    i += 1
                Next

                engineCorrectionFactors.Dispose()

                Return True

            Catch Ex As Exception
                MessageBox.Show("InitArrays_GTCP85_129: " & Ex.ToString())
                Return False
            Finally
            End Try
        End Function

        Private Sub ConfigHMIforEngine()

            'The Page for the GTPCP85-129 have been tested for D H and K. For the other engine of the familly we may have to
            'modify a little bit this section.
            '
            'The HMI page contains element for GTCP85-129H and K engine
            'For the D engine we have to remove it.
            'In the EXHAUST DUCT frame, EGT-P2, EGT-P Spread and EGT-P Avg signal are removed
            'In the engine window, the EGT-P Avg bargrapgh is changed to display for EGT-P1
            Try
                Dim brgEGT_P As KineticaRT.Studio.Controls.Linear = Nothing
                Dim dspEGT_P2 As KineticaRT.Studio.Controls.Display = Nothing
                Dim dspEGT_AVG As KineticaRT.Studio.Controls.Display = Nothing
                Dim dspEGT_Spread As KineticaRT.Studio.Controls.Display = Nothing

                ' Dim btnMESModeLH As CEL.KineticaRT.Controls.Button = Nothing
                'Dim btnMESModeRH As CEL.KineticaRT.Controls.Button = Nothing
                ' Dim btnPNEUMATIC_SOL_110 As CEL.KineticaRT.Controls.Button = Nothing
                ' Dim btnSIMULATION As CEL.KineticaRT.Controls.Button = Nothing

                MyBase.InitializeObject(brgEGT_P, "GTCP85_129_Screen.EGT_P_Bargraph")
                MyBase.InitializeObject(dspEGT_P2, "GTCP85_129_Screen.GTCP85_129_EngineRun.fraExhaustDuct.dspT_EGT_TC2_SOURCE_DEGF")
                MyBase.InitializeObject(dspEGT_AVG, "GTCP85_129_Screen.GTCP85_129_EngineRun.fraExhaustDuct.dspT_EGT_TC_DEGF_AVG")
                MyBase.InitializeObject(dspEGT_Spread, "GTCP85_129_Screen.GTCP85_129_EngineRun.fraExhaustDuct.dspT_EGT_TC_DEGF_SPREAD")
                ' MyBase.InitializeObject(btnMESModeLH, "GTCP85_129_Screen.fraMasterPanel.fraMasterEnginePanel.btnMESModeLH")
                ' MyBase.InitializeObject(btnMESModeRH, "GTCP85_129_Screen.fraMasterPanel.fraMasterEnginePanel.btnMESModeRH")
                ' MyBase.InitializeObject(btnPNEUMATIC_SOL_110, "GTCP85_129_Screen.fraMasterPanel.fraMasterEnginePanel.btnPneumaticSol110")
                ' MyBase.InitializeObject(btnSIMULATION, "GTCP85_129_Screen.fraMasterPanel.fraMasterEnginePanel.btnOverspeedSimulation")

            Catch ex As Exception
                MessageBox.Show("ConfigHMIforEngine: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

