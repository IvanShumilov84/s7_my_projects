        Private Function Compute_BleedAirFlow(ByVal TOrifice_DEGF As Double, _
                                                ByVal POrifice_INHGA As Double, _
                                                ByVal POrificeDelta_INH2OG As Double) As Double Implements IBleedAirFlowCalculation.Compute_BleedAirFlow
            Try
                If CELProject.IsTrue(BLEED_AIR_VALVE_BTN.Value) Then


                    Dim BleedAirFLow As Double = CELProject.GetBleedAirFlow(CELProject.EngineConfiguration.DuctDiameter, CELProject.EngineConfiguration.DuctDiameterUnit, _
                                                                            CELProject.EngineConfiguration.OrificeDiameter, CELProject.EngineConfiguration.OrificeDiameterUnit, _
                                                                            TOrifice_DEGF, CELDAS.eTemperature.Fahrenheit, _
                                                                            POrifice_INHGA, CELDAS.ePressure.InchesOfMercury, _
                                                                            POrificeDelta_INH2OG, CELDAS.ePressure.InchesH2O, _
                                                                            CELProject.EngineConfiguration.OrificeThinkness, _
                                                                            CELProject.EngineConfiguration.OrificeThinknessUnit, _
                                                                            CELProject.EngineConfiguration.TapArrangement, _
                                                                            CELDAS.eFlowMass.LbByMin) 'Output in lb/min 

                    Return BleedAirFLow

                Else
                    Return 0.0
                End If


            Catch Ex As Exception
                'Log error
                MessageBox.Show("Error in Engine_Sequence.OnBleedAirflow_Calc: " & Ex.ToString)
            End Try
        End Function

        Private Sub OnCaptureBtn(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    Select Case sender.Name
                        Case "PERF_REC_AIR_PRESSURE_BTN"
                            PERF_REC_AIR_PRESSURE.Value = P_AIR_PRESSURE_REG_SOURCE_INHGG.Value

                        Case "PERF_REC_CRANK_CHECK_BTN"
                            PERF_REC_FUEL_CRACKING.Value = P_FUEL_CRACKING_SOURCE_PSIG.Value
                            PERF_REC_FUEL_INLET_PRESS.Value = P_FUEL_INLET_SOURCE_PSIG.Value

                        Case "PERF_REC_ETC_CHECK_BTN"
                            'PERF_REC_ETC_CHECK.Value = T_EGT_TC_DEGF_AVG_MEAN.Value
                            If EngineFamilyHJK Then
                                PERF_REC_ETC_CHECK.Value = T_EGT_TC_DEGF_AVG.Value
                            Else
                                PERF_REC_ETC_CHECK.Value = T_EGT_TC1_SOURCE_DEGF.Value
                            End If

                        Case "CAPTURE_MAX_EGT_OVERLOAD_BTN"
                            Log_Perf_MaxEGTDuringOL.Value = T_EGT_DEGF_AVG.Value
                            'CAPTURE_MAX_EGT_OVERLOAD_BTN.Value = Values.False

                        Case "PERF_REC_ETC_RECHECK_BTN"
                            'PERF_REC_ETC_RECHECK.Value = T_EGT_TC_DEGF_AVG_MEAN.Value
                            If EngineFamilyHJK Then
                                PERF_REC_ETC_RECHECK.Value = T_EGT_TC_DEGF_AVG.Value
                            Else
                                PERF_REC_ETC_RECHECK.Value = T_EGT_TC1_SOURCE_DEGF.Value
                            End If

                        Case "PERF_REC_FULL_LOAD_SPEED_BTN"
                            PERF_REC_SPEED_FULL_LOAD.Value = NG_RPM_MEAN.Value

                        Case "PERF_REC_MIN_SPEED_CHECK_BTN"
                            PERF_REC_MIN_SPEED_OVERLOAD_CHECK.Value = NG_RPM_MEAN.Value

                        Case "PERF_REC_NO_LOAD_SPEED_BTN"
                            PERF_REC_SPEED_NO_LOAD.Value = NG_RPM_MEAN.Value
                    End Select
                End If

            Catch ex As Exception
                MessageBox.Show("OnCaptureBtn: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnCLOSE_TEST_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    MyBase.StopWorkingThread()

                    If TestProgressMgr IsNot Nothing Then
                        TestProgress_Save()
                        TestProgressMgr.Dispose()
                        TestProgressMgr = Nothing
                    End If

                    'Persistent Values Force Save
                    GTCP85_129_PersistentValuesCtrl.SavePersistentValues(True)

                    RemoveHandlers()

                    Dispose_Engine_Controllers()

                    GTCP85_129_PersistentValuesCtrl.Dispose()

                End If

                CELProject.CLOSE_TEST_BTN.Value = Values.False

            Catch Ex As Exception
                MessageBox.Show("OnClose_Test: " & Ex.ToString())
            End Try
        End Sub

        Protected Overrides Sub OnNEW_TEST_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                If (CELProject.IsTrue(newVal)) Then

                    'TODO
                    NUMBER_OF_STARTS.Value = Values.Zero
                    OPERATING_TIME_CURRENT_SEC.Value = Values.Zero
                    WF_TOT1.Value = Values.Zero
                    ''NG_MAX_PERSISTENT_RPM.Value =Values.Zero
                    ''P_OIL_MAX_PERSISTENT_KPAG.Value =Values.Zero
                    ''MINIMUM_SURGE_MARGIN_TEST_PASSED.Value = Values.False
                    ''NUMBER_APU_FAULT_SEEN_DURING_TEST.Value =Values.Zero
                    ''P_OIL_AT_60KW_SHAFT_LOAD_KPAG.Value =Values.Zero
                    ''T_OIL_AT_60KW_SHAFT_LOAD_DEGC.Value =Values.Zero
                    ''ET_TIME_RUNDOWN_MANUAL_ENTRY.Value =Values.Zero
                    FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                    CELProject.PERF_TEST_RESULT_ACCEPTED.Value = Values.False
                    CELProject.PERF_TEST_RESULT_REJECTED.Value = Values.True
                    VIB_GEARBOX_MAX_MILS_PERSISTENT.Value = Values.Zero
                    VIB_TURBINE_MAX_MILS_PERSISTENT.Value = Values.Zero


                    TestProgress_Save()

                    Try
                        If (System.IO.File.Exists(CELProject.EngineSession.LogFolder + "TestProgress.xml")) Then
                            Rename(CELProject.EngineSession.LogFolder + "TestProgress.xml", CELProject.EngineSession.LogFolder + "TestProgress_" & Format(Date.Now, "yyyy-MM-dd hh'h'mm'm'ss's'") & ".xml")
                        End If

                        TestProgressMgr.TestProgressSheet.Entries.Clear()

                    Catch Ex As Exception
                        MessageBox.Show("TestProgess File not found: " & Ex.ToString())
                    End Try

                End If
            End If

        End Sub

        Private Sub TestProgress_Save()
            If Not Me.TestProgressMgr Is Nothing Then
                Dim fileName As String = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
                Dim settings As Xml.XmlWriterSettings = New Xml.XmlWriterSettings()
                settings.Indent = True

                Using writer As Xml.XmlWriter = Xml.XmlWriter.Create(fileName, settings)
                    Dim xslPath As String = "type=""text/xsl"" href=""" + CELProject.Report.TestProgressFullFileName + """"
                    writer.WriteProcessingInstruction("xml-stylesheet", xslPath)
                    Dim ser As New Xml.Serialization.XmlSerializer(GetType(CEL.TestProgress.TestProgressSheet))
                    ser.Serialize(writer, Me.TestProgressMgr.TestProgressSheet)
                End Using
            End If
        End Sub

        Private Sub TestProgress_Initialize()
            Dim dataInfo As CEL.TestProgress.TestProgressMgr.TestProgress_DataInfo

            dataInfo.EngineStartEventChannelName = "START_BTN"
            dataInfo.EngineStartEventChannelValue = True
            dataInfo.EngineStartEventDescription = "Engine Start"
            dataInfo.EngineStartEventRecordTime = True
            dataInfo.EngineStopEventChannelName = "STOP_CMD"
            dataInfo.EngineStopEventChannelValue = True
            dataInfo.EngineStopEventDescription = "Engine Stop - Rundown Time (s): "
            dataInfo.EngineStopEventRecordTime = True
            dataInfo.TestProgressFrameName = CELProject.EngineFamily.Replace("-", "_") + "_Screen.fraTestProgressHorizontal"
            dataInfo.TestProgressSheetFileName = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
            dataInfo.UUTModel = CELProject.EngineModel


            Select Case CELProject.Project.Number

                Case 13031

                    dataInfo.UUTSerialNumber = Me.UserInputsSouthAfricanAirways.EngineSerialNumber
                    dataInfo.UUTWorkOrder = Me.UserInputsSouthAfricanAirways.WorkOrder

                Case Else
                    Debug.Assert(False, "TestProgress_Initialize: Code Missign for this project")

            End Select

            Me.TestProgressMgr = New CEL.TestProgress.TestProgressMgr(dataInfo)

        End Sub

        Private Sub TestProgress_RecordPerfStep()

            Dim sheetEntry As CEL.TestProgress.TestProgressSheetEntry = Nothing

            Dim TextString As String = cmbTestStepList.SelectedItem & " performance point taken"

            sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(Now.ToString(), TextString)

            If sheetEntry IsNot Nothing Then
                Me.TestProgressMgr.AddTestProgressEntry(sheetEntry)
            End If

        End Sub

        Protected Overrides Sub OnLOG_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    'Update the Log/Perf channel set
                    CELProject.LogPerfSynch.UpdateValues()

                    'Synchronize data for Log and Performance
                    Compute(True)

                    CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, False, "GTCP85-129", True)
                    CELProject.LOG_TAKE_POINT_BTN.Value = Values.False
                End If

            Catch Ex As Exception
                MessageBox.Show("OnLOG_TAKE_POINT_BTN: " & Ex.ToString())
            End Try
        End Sub

