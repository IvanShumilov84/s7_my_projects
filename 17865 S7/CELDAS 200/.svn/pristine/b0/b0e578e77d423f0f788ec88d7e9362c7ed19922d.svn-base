        Public Class UserInput

            Public EngineSerialNumber As String = ""
            Public WorkOrder As String = ""
            Public PartNumber As String = ""
            Public CustomerName As String = ""
            Public OilType As String = ""
            Public FuelType As String = ""
            Public LHV As String = ""
            Public SampleTFuel As String = ""
            Public SampleFuelSG As String = ""
            Public Build As String = ""
            Public TestInstructions As String = ""
            Public TestInstructionsRev As String = ""
            Public FADECPartNumber As String = ""
            Public FADECSerialNumber As String = ""

            Public OperatorName As String = ""
            Public InspectorName As String = ""
            Public TestType As String = ""

            ' Allow friend access to the empty constructor.
            Friend Sub New()

            End Sub

            ' Récupère les informations du UserInput 
            Public Sub MapUserInputsParameters(ByRef CELProject As CELDAS)

                EngineSerialNumber = CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
                WorkOrder = CELProject.Test_Mgr_UUT_Answer(1).Value.ToString()
                PartNumber = CELProject.Test_Mgr_UUT_Answer(2).Value.ToString()
                CustomerName = CELProject.Test_Mgr_UUT_Answer(3).Value.ToString()
                OilType = CELProject.Test_Mgr_UUT_Answer(4).Value.ToString()
                FuelType = CELProject.Test_Mgr_UUT_Answer(5).Value.ToString()
                LHV = CELProject.Test_Mgr_UUT_Answer(6).Value.ToString()
                SampleTFuel = CELProject.Test_Mgr_UUT_Answer(7).Value.ToString()
                SampleFuelSG = CELProject.Test_Mgr_UUT_Answer(8).Value.ToString()
                Build = CELProject.Test_Mgr_UUT_Answer(9).Value.ToString()
                TestInstructions = CELProject.Test_Mgr_UUT_Answer(10).Value.ToString()
