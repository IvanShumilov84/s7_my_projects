                            LOG_PERF_VIB_SURVEY_105NP_TO_VADA_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_AXIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_105NP_TO_VADR_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_105NP_TO_VCHR_IPS.Value = LOG_PERF_VIB_COMBUSTOR_HOUSING_RADIAL_IPS.Value
                        End If
                        If sender.Name = "CAPTURE_START_VIB_SURVEY_105NP_TO" Then
                            LOG_PERF_VIB_SURVEY_105NP_TO_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        '5.5 Final oil level marking
                        If sender.Name = "CAPTURE_FINAL_OIL_LEVEL_MARKING" Then
                            LOG_PERF_FINAL_OIL_LEVEL_ORBT_DEGF.Value = LOG_PERF_T_OIL_BULB_DEGF.Value
                            LOG_PERF_FINAL_OIL_LEVEL_RUNTIME.Value = New Global.KineticaRT.Values.Text(Format(DateAdd("s", OPERATING_TIME_CURRENT_SEC.Value.ToDouble(), "00:00:00"), "HH:mm:ss"))
                        End If

                        If sender.Name = "CAPTURE_START_FINAL_OIL_LEVEL_MARKING" Then
                            LOG_PERF_FINAL_OIL_LEVEL_MARKING_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        '5.6 Final Inspections
                        If sender.Name = "CAPTURE_START_FINAL_INSPECTIONS" Then
                            LOG_PERF_FINAL_INSPECTIONS_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        '5.7 Leak and seal drain check
                        If sender.Name = "CAPTURE_START_LEAK_AND_SEAL_DRAIN_CHECK" Then
                            LOG_PERF_LEAK_AND_SEAL_DRAIN_CHECK_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        'Transient Test Setup
                        If sender.Name = "CAPTURE_TRANSIENT_AMBIENT_TEMPERATURE" Then
                            LOG_PERF_TRANSIENT_AMBIENT_TEMP_DEGF.Value = LOG_PERF_T_CELL_DEGF.Value
                        End If
                        If sender.Name = "CAPTURE_TRANSIENT_AMBIENT_PRESSURE" Then
                            LOG_PERF_TRANSIENT_AMBIENT_PRESSURE_PSIA.Value = LOG_PERF_P_BARO_PSIA.Value
                        End If
                        If sender.Name = "CAPTURE_TRANSIENT_MAXIMUM_RATE_NG" Then
                            LOG_PERF_TRANSIENT_MAX_RATE_NG_RPM.Value = LOG_PERF_NG_MAX_RATE_RPM.Value
                        End If
                        If sender.Name = "CAPTURE_TRANSIENT_NG_MAX_TAKEOFF" Then
                            LOG_PERF_TRANSIENT_NG_MAX_TAKEOFF_RPM.Value = LOG_PERF_NG_RPM.Value
                        End If
                        If sender.Name = "CAPTURE_TRANSIENT_ACCEL_TEST_TARGET_SPEED" Then
                            LOG_PERF_TRANSIENT_ACCEL_TEST_TARGET_SPEED_RPM.Value = LOG_PERF_TRANSIENT_CHECK_ACCEL_NG_ENDPOINT_RPM.Value
                        End If
                        If sender.Name = "CAPTURE_TRANSIENT_DECEL_TEST_TARGET_SPEED" Then
                            LOG_PERF_TRANSIENT_DECEL_TEST_TARGET_SPEED_RPM.Value = LOG_PERF_TRANSIENT_CHECK_DECEL_NG_ENDPOINT_RPM.Value
                        End If

                    End If
                End If

            Catch ex As System.Exception
                MessageBox.Show("OnLOG_PERF_CAPTURE: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try

        End Sub

        Private Function CreatePerformance(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean

            'Declaration
            Dim currentSheet As String
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet
            Dim SelectString As String = String.Empty
            Dim Cmd As OleDbCommand
            Dim Reader As OleDbDataReader

            CreatePerformance = True

            Try

                ' The following gets the Worksheets collection
                excelSheets = excelWorkbook.Worksheets
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    currentSheet = "TESTS"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    Dim row As Integer = 5
                    Dim column As Integer = 3


                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = Format(Now, "yyyy/MM/dd")

                    column += 2

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = Format(Now, "HH:mm:ss")

                    row += 1
                    column -= 3

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = CELProject.Project.Description
                    row += 1

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.TestInstructions

                    column += 3

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.TestInstructionsRev

                    row += 1
                    column -= 3

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.OperatorName
                    row += 1

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.InspectorName

                    row = 5
                    column = 7

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.EngineSerialNumber

                    column += 2
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.Build

                    row += 1
                    column -= 2

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.PartNumber

                    row += 1

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.WorkOrder

                    row += 1

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.FADECPartNumber

                    row += 1

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.FADECSerialNumber

                End If

                currentSheet = "TESTS"
                excelWorksheet = excelSheets.Item(currentSheet)

                '3. Preparation for test
                excelWorksheet.Cells(14, 5).Value = LOG_PERF_PREPARATION_FOR_TEST.Value.ToString

                '4.2 Motoring Checks
                excelWorksheet.Cells(14, 8).Value = LOG_PERF_MOTORING_CHECKS.Value.ToString(LOG_PERF_MOTORING_CHECKS.Format, Nothing)

                '4.2 Motoring Start
                excelWorksheet.Cells(14, 10).Value = LOG_PERF_MOTORING_CHECKS_START.Value.ToString(LOG_PERF_MOTORING_CHECKS_START.Format, Nothing)

                '4.3 Initial Start to G.I Start
                excelWorksheet.Cells(15, 10).Value = LOG_PERF_INITIAL_START_TO_GI_START.Value.ToString(LOG_PERF_INITIAL_START_TO_GI_START.Format, Nothing)

                '4.4 F.I. check
                excelWorksheet.Cells(16, 4).Value = LOG_PERF_FI_NG_PCT.Value.ToString(LOG_PERF_FI_NG_PCT.Format, Nothing)
                excelWorksheet.Cells(16, 6).Value = LOG_PERF_FI_WF_PPH.Value.ToString(LOG_PERF_FI_WF_PPH.Format, Nothing)
                excelWorksheet.Cells(16, 8).Value = LOG_PERF_FI_SHP_HP.Value.ToString(LOG_PERF_FI_SHP_HP.Format, Nothing)
                excelWorksheet.Cells(17, 4).Value = LOG_PERF_FI_OIL_LEVEL.Value.ToString(LOG_PERF_FI_OIL_LEVEL.Format, Nothing)
                excelWorksheet.Cells(17, 6).Value = LOG_PERF_FI_ORBT_DEGF.Value.ToString(LOG_PERF_FI_ORBT_DEGF.Format, Nothing)
                excelWorksheet.Cells(17, 8).Value = LOG_PERF_FI_RUNTIME.Value.ToString

                '4.4 F.I. check Start
                excelWorksheet.Cells(16, 10).Value = LOG_PERF_FI_CHECK_START.Value.ToString(LOG_PERF_FI_CHECK_START.Format, Nothing)

                '4.5 Gas Producer seal Break-in procedure Start
                excelWorksheet.Cells(18, 10).Value = LOG_PERF_GAS_PRODUCER_SEAL_BREAKIN_PROCEDURE_START.Value.ToString(LOG_PERF_GAS_PRODUCER_SEAL_BREAKIN_PROCEDURE_START.Format, Nothing)

                '4.6 TO Power Setting

                excelWorksheet.Cells(20, 6).Value = LOG_PERF_TO_POWER_SETTING_AT_MCP_POFO_PSIG.Value.ToString(LOG_PERF_TO_POWER_SETTING_AT_MCP_POFO_PSIG.Format, Nothing)
                excelWorksheet.Cells(20, 8).Value = LOG_PERF_TO_POWER_SETTING_AT_MCP_WOIL_PPH.Value.ToString(LOG_PERF_TO_POWER_SETTING_AT_MCP_WOIL_PPH.Format, Nothing)
                excelWorksheet.Cells(21, 6).Value = LOG_PERF_TO_POWER_SETTING_AT_MCP_MGTB_DEGF.Value.ToString(LOG_PERF_TO_POWER_SETTING_AT_MCP_MGTB_DEGF.Format, Nothing)
                excelWorksheet.Cells(21, 8).Value = LOG_PERF_TO_POWER_SETTING_AT_MCP_WF_PPH.Value.ToString(LOG_PERF_TO_POWER_SETTING_AT_MCP_WF_PPH.Format, Nothing)
                excelWorksheet.Cells(22, 6).Value = LOG_PERF_TO_POWER_SETTING_HEAT_REJECTION_TOSP_DEGF.Value.ToString(LOG_PERF_TO_POWER_SETTING_HEAT_REJECTION_TOSP_DEGF.Format, Nothing)
                excelWorksheet.Cells(22, 8).Value = LOG_PERF_TO_POWER_SETTING_HEAT_REJECTION_TOPI_DEGF.Value.ToString(LOG_PERF_TO_POWER_SETTING_HEAT_REJECTION_TOPI_DEGF.Format, Nothing)
                excelWorksheet.Cells(23, 6).Value = LOG_PERF_TO_POWER_SETTING_AT_TO_POFO_PSIG.Value.ToString(LOG_PERF_TO_POWER_SETTING_AT_TO_POFO_PSIG.Format, Nothing)
                excelWorksheet.Cells(23, 8).Value = LOG_PERF_TO_POWER_SETTING_AT_TO_WOIL_PPH.Value.ToString(LOG_PERF_TO_POWER_SETTING_AT_TO_WOIL_PPH.Format, Nothing)
                excelWorksheet.Cells(24, 6).Value = LOG_PERF_TO_POWER_SETTING_AT_TO_MGTB_DEGF.Value.ToString(LOG_PERF_TO_POWER_SETTING_AT_TO_MGTB_DEGF.Format, Nothing)
                excelWorksheet.Cells(24, 8).Value = LOG_PERF_TO_POWER_SETTING_AT_TO_WF_PPH.Value.ToString(LOG_PERF_TO_POWER_SETTING_AT_TO_WF_PPH.Format, Nothing)
                excelWorksheet.Cells(25, 6).Value = LOG_PERF_TO_POWER_SETTING_TQ_CHECK_PTQM_PSIG.Value.ToString(LOG_PERF_TO_POWER_SETTING_TQ_CHECK_PTQM_PSIG.Format, Nothing)
                excelWorksheet.Cells(25, 8).Value = LOG_PERF_TO_POWER_SETTING_TQ_CHECK_TORQUE_LBSFT.Value.ToString(LOG_PERF_TO_POWER_SETTING_TQ_CHECK_TORQUE_LBSFT.Format, Nothing)

                '4.6 TO Power Setting Start
                excelWorksheet.Cells(19, 10).Value = LOG_PERF_TO_POWER_SETTING_START.Value.ToString(LOG_PERF_TO_POWER_SETTING_START.Format, Nothing)

                '4.8 Torquemeter Calibration

                excelWorksheet.Cells(26, 6).Value = LOG_PERF_Q_HIGH.Value.ToString(LOG_PERF_Q_HIGH.Format, Nothing)
                excelWorksheet.Cells(26, 8).Value = LOG_PERF_PTQM_H.Value.ToString(LOG_PERF_PTQM_H.Format, Nothing)
                excelWorksheet.Cells(27, 6).Value = LOG_PERF_Q_LOW.Value.ToString(LOG_PERF_Q_LOW.Format, Nothing)
                excelWorksheet.Cells(27, 8).Value = LOG_PERF_PTQM_L.Value.ToString(LOG_PERF_PTQM_L.Format, Nothing)
                excelWorksheet.Cells(28, 6).Value = LOG_PERF_CHAN_A_GAIN.Value.ToString(LOG_PERF_CHAN_A_GAIN.Format, Nothing)
                excelWorksheet.Cells(28, 8).Value = LOG_PERF_CHAN_A_OFFSET.Value.ToString(LOG_PERF_CHAN_A_OFFSET.Format, Nothing)
                excelWorksheet.Cells(29, 6).Value = LOG_PERF_CHAN_B_GAIN.Value.ToString(LOG_PERF_CHAN_B_GAIN.Format, Nothing)
                excelWorksheet.Cells(29, 8).Value = LOG_PERF_CHAN_B_OFFSET.Value.ToString(LOG_PERF_CHAN_B_OFFSET.Format, Nothing)

                '4.8 Torquemeter Calibration Start
                excelWorksheet.Cells(26, 10).Value = LOG_PERF_TORQUEMETER_CALIBRATION_START.Value.ToString(LOG_PERF_TORQUEMETER_CALIBRATION_START.Format, Nothing)

                '5.1 Control System Checks

                excelWorksheet.Cells(30, 6).Value = LOG_PERF_AI_VALVE_CK_VALVE_OFF_MGTB_DEGF.Value.ToString(LOG_PERF_AI_VALVE_CK_VALVE_OFF_MGTB_DEGF.Format, Nothing)
                excelWorksheet.Cells(30, 8).Value = LOG_PERF_AI_VALVE_CK_VALVE_ON_MGTB_DEGF.Value.ToString(LOG_PERF_AI_VALVE_CK_VALVE_ON_MGTB_DEGF.Format, Nothing)
                excelWorksheet.Cells(31, 6).Value = LOG_PERF_MANUAL_MODE_CK_CHAN_A_WF_PPH.Value.ToString(LOG_PERF_MANUAL_MODE_CK_CHAN_A_WF_PPH.Format, Nothing)
                excelWorksheet.Cells(31, 8).Value = LOG_PERF_MANUAL_MODE_CK_CHAN_B_WF_PPH.Value.ToString(LOG_PERF_MANUAL_MODE_CK_CHAN_B_WF_PPH.Format, Nothing)
