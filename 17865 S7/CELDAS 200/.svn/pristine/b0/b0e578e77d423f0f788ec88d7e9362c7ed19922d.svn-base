                        End If

                        If sender.Name = "CAPTURE_VIB_SURVEY_90NP_100NG" Then
                            LOG_PERF_VIB_SURVEY_90NP_100NG_VGBR_IPS.Value = LOG_PERF_VIB_GEARBOX_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_90NP_100NG_VADA_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_AXIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_90NP_100NG_VADR_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_RADIAL_IPS.Value
