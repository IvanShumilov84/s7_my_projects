                        End If

                        If sender.Name = "CAPTURE_VIB_SURVEY_105NP_70NG" Then
                            LOG_PERF_VIB_SURVEY_105NP_70NG_VGBR_IPS.Value = LOG_PERF_VIB_GEARBOX_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_105NP_70NG_VADA_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_AXIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_105NP_70NG_VADR_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_105NP_70NG_VCHR_IPS.Value = LOG_PERF_VIB_COMBUSTOR_HOUSING_RADIAL_IPS.Value
                        End If
                        If sender.Name = "CAPTURE_START_VIB_SURVEY_105NP_70NG" Then
