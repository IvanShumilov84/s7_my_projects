                            LOG_PERF_VIB_SURVEY_90NP_TO_VADA_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_AXIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_90NP_TO_VADR_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_90NP_TO_VCHR_IPS.Value = LOG_PERF_VIB_COMBUSTOR_HOUSING_RADIAL_IPS.Value
