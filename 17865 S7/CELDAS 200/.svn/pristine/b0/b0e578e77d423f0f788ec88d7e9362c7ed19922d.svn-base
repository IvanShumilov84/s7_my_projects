                        End If

                        If sender.Name = "CAPTURE_VIB_SURVEY_105NP_95NG" Then
                            LOG_PERF_VIB_SURVEY_105NP_95NG_VGBR_IPS.Value = LOG_PERF_VIB_GEARBOX_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_105NP_95NG_VADA_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_AXIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_105NP_95NG_VADR_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_105NP_95NG_VCHR_IPS.Value = LOG_PERF_VIB_COMBUSTOR_HOUSING_RADIAL_IPS.Value
                        End If
                        If sender.Name = "CAPTURE_START_VIB_SURVEY_105NP_95NG" Then
                            LOG_PERF_VIB_SURVEY_105NP_95NG_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        If sender.Name = "CAPTURE_VIB_SURVEY_105NP_100NG" Then
                            LOG_PERF_VIB_SURVEY_105NP_100NG_VGBR_IPS.Value = LOG_PERF_VIB_GEARBOX_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_105NP_100NG_VADA_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_AXIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_105NP_100NG_VADR_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_105NP_100NG_VCHR_IPS.Value = LOG_PERF_VIB_COMBUSTOR_HOUSING_RADIAL_IPS.Value
                        End If
                        If sender.Name = "CAPTURE_START_VIB_SURVEY_105NP_100NG" Then
                            LOG_PERF_VIB_SURVEY_105NP_100NG_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        If sender.Name = "CAPTURE_VIB_SURVEY_105NP_TO" Then
