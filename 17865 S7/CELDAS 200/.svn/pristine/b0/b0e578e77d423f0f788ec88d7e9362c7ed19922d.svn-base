                End If

                If CELProject.IsTrue(LOG_PERF_FINAL_INSPECTIONS_OIL_FILTER.Value) Then
                    excelWorksheet.Cells(35, 8).Value = "PASSED"
                Else
                    excelWorksheet.Cells(35, 8).Value = "FAILED"
                End If

                If CELProject.IsTrue(LOG_PERF_FINAL_INSPECTIONS_PTPD.Value) Then
                    excelWorksheet.Cells(35, 10).Value = "PASSED"
                Else
                    excelWorksheet.Cells(35, 10).Value = "FAILED"
                End If

                excelWorksheet.Cells(35, 11).Value = LOG_PERF_FINAL_INSPECTIONS_START.Value.ToString(LOG_PERF_FINAL_INSPECTIONS_START.Format, Nothing)

                '5.7 Leak and seal drain check

                If CELProject.IsTrue(LOG_PERF_LEAK_AND_SEAL_DRAIN_CHECK.Value) Then
                    excelWorksheet.Cells(36, 4).Value = "PASSED"
                Else
                    excelWorksheet.Cells(36, 4).Value = "FAILED"
                End If

                excelWorksheet.Cells(36, 11).Value = LOG_PERF_LEAK_AND_SEAL_DRAIN_CHECK_START.Value.ToString(LOG_PERF_LEAK_AND_SEAL_DRAIN_CHECK_START.Format, Nothing)

                '5.8 Data Review

                If CELProject.IsTrue(LOG_PERF_DATA_REVIEW.Value) Then
                    excelWorksheet.Cells(37, 4).Value = "PASSED"
                Else
                    excelWorksheet.Cells(37, 4).Value = "FAILED"
                End If

                '5.9 Preservation Completed.

                If CELProject.IsTrue(LOG_PERF_PRESERVATION_COMPLETED.Value) Then
                    excelWorksheet.Cells(38, 4).Value = "PASSED"
                Else
                    excelWorksheet.Cells(38, 4).Value = "FAILED"
                End If

                If CELProject.IsTrue(LOG_PERF_DEVIATION_REQUIRED.Value) Then
                    excelWorksheet.Cells(38, 10).Value = "PASSED"
                Else
                    excelWorksheet.Cells(38, 10).Value = "FAILED"
                End If

                currentSheet = "TRANSIENT TESTS"
                excelWorksheet = excelSheets.Item(currentSheet)

                excelWorksheet.Cells(14, 3).Value = LOG_PERF_TRANSIENT_AMBIENT_TEMP_DEGF.Value.ToString(LOG_PERF_TRANSIENT_AMBIENT_TEMP_DEGF.Format, Nothing)
                excelWorksheet.Cells(15, 3).Value = LOG_PERF_TRANSIENT_AMBIENT_PRESSURE_PSIA.Value.ToString(LOG_PERF_TRANSIENT_AMBIENT_PRESSURE_PSIA.Format, Nothing)
                excelWorksheet.Cells(17, 3).Value = LOG_PERF_TRANSIENT_MAX_RATE_NG_RPM.Value.ToString(LOG_PERF_TRANSIENT_MAX_RATE_NG_RPM.Format, Nothing)
                excelWorksheet.Cells(20, 3).Value = LOG_PERF_TRANSIENT_NG_MAX_TAKEOFF_RPM.Value.ToString(LOG_PERF_TRANSIENT_NG_MAX_TAKEOFF_RPM.Format, Nothing)
                excelWorksheet.Cells(23, 3).Value = LOG_PERF_TRANSIENT_ACCEL_TEST_TARGET_SPEED_RPM.Value.ToString(LOG_PERF_TRANSIENT_ACCEL_TEST_TARGET_SPEED_RPM.Format, Nothing)
                excelWorksheet.Cells(24, 3).Value = LOG_PERF_TRANSIENT_DECEL_TEST_TARGET_SPEED_RPM.Value.ToString(LOG_PERF_TRANSIENT_DECEL_TEST_TARGET_SPEED_RPM.Format, Nothing)
                excelWorksheet.Cells(27, 3).Value = LOG_PERF_CHAN_A_ACCEL_TIME_SEC.Value.ToString(LOG_PERF_CHAN_A_ACCEL_TIME_SEC.Format, Nothing)
                excelWorksheet.Cells(28, 3).Value = LOG_PERF_CHAN_A_DECEL_TIME_SEC.Value.ToString(LOG_PERF_CHAN_A_DECEL_TIME_SEC.Format, Nothing)
                excelWorksheet.Cells(30, 3).Value = LOG_PERF_CHAN_B_ACCEL_TIME_SEC.Value.ToString(LOG_PERF_CHAN_B_ACCEL_TIME_SEC.Format, Nothing)
                excelWorksheet.Cells(31, 3).Value = LOG_PERF_CHAN_B_DECEL_TIME_SEC.Value.ToString(LOG_PERF_CHAN_B_DECEL_TIME_SEC.Format, Nothing)

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreatePerformance = False

            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)
            End Try

        End Function

        Protected Overrides Sub OnTestSessionInitialized(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionInitialized(newStatus)

                If CELProject.EngineFamily = "HTS900" Then

                    UserInputs.MapUserInputsParameters(CELProject)

                    CELProject.EngineSession.WorkingFolder = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + UserInputs.EngineSerialNumber + "\" + UserInputs.WorkOrder
                    CELProject.CreateLogFile(AddressOf CreateCustomHeaderLogFile, CELProject.EngineModel, CELProject.EngineModel)

                End If
            Catch ex As Exception
                MessageBox.Show("OnTestSessionInitialized: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)
            Catch ex As Exception
                MessageBox.Show("PWC100_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionRunning(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionRunning(newStatus)
                If CELProject.EngineFamily = "HTS900" Then
                    Init_Engine_Controls()
                    Init_Engine_Channels()
                    Init_Engine_Channels_Value()
                    Init_Engine_Controllers()
                    AddHandlers()
                    MyBase.StartWorkingThread()
                End If
            Catch ex As Exception
                MessageBox.Show("OnTestSessionRunning: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

