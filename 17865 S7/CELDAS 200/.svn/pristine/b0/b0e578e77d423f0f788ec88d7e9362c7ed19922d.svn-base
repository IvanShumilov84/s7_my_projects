        Private Sub OnLOG_PERF_CAPTURE(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then
                    If CELProject.IsTrue(newVal) Then

                        'Sync the Log Perf channels
                        CELProject.LogPerfSynch.UpdateValues()

                        '3. Preparation for test
                        If sender.Name = "CAPTURE_DIGITAL_OFFSET_TIME" Then
                            LOG_PERF_PREPARATION_FOR_TEST.Value = New KineticaRT.Values.Text(Format(Now, "HH:mm:ss"))
                        End If

                        '4.2 Motoring Checks
                        If sender.Name = "CAPTURE_START_MOTORING_CHECKS" Then
                            LOG_PERF_MOTORING_CHECKS.Value = NUMBER_OF_STARTS.Value
                        End If

                        '4.3 Initial Start to G.i.
                        If sender.Name = "CAPTURE_START_INITIAL_START_TO_GI" Then
                            LOG_PERF_INITIAL_START_TO_GI_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        '4.4 F.I check
                        If sender.Name = "CAPTURE_FI_CHECKS" Then
                            LOG_PERF_FI_NG_PCT.Value = LOG_PERF_NG_PCT.Value
                            LOG_PERF_FI_WF_PPH.Value = LOG_PERF_WF_AVG_PPH.Value
                            LOG_PERF_FI_SHP_HP.Value = LOG_PERF_SHP_DYNO_HP.Value
                            LOG_PERF_FI_ORBT_DEGF.Value = LOG_PERF_T_OIL_BULB_DEGF.Value
                            LOG_PERF_FI_RUNTIME.Value = New Global.KineticaRT.Values.Text(Format(DateAdd("s", OPERATING_TIME_CURRENT_SEC.Value.ToDouble(), "00:00:00"), "HH:mm:ss"))
                        End If

                        If sender.Name = "CAPTURE_START_FI_CHECK" Then
                            LOG_PERF_FI_CHECK_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        '4.5 Gas Producer 

                        If sender.Name = "CAPTURE_START_GAS_PRODUCER_SEAL_BREAKIN_PROCEDURE" Then
                            LOG_PERF_GAS_PRODUCER_SEAL_BREAKIN_PROCEDURE_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        '4.6 TO Power Setting

                        If sender.Name = "CAPTURE_TO_POWER_SETTING_AT_MCP" Then
                            LOG_PERF_TO_POWER_SETTING_AT_MCP_POFO_PSIG.Value = LOG_PERF_P_OIL_FILTER_DISCHARGE_PSIG.Value
                            LOG_PERF_TO_POWER_SETTING_AT_MCP_MGTB_DEGF.Value = LOG_PERF_T_MGTB_DEGF.Value
                            LOG_PERF_TO_POWER_SETTING_AT_MCP_WOIL_PPH.Value = LOG_PERF_WO_PPH.Value
                            LOG_PERF_TO_POWER_SETTING_AT_MCP_WF_PPH.Value = LOG_PERF_WF_AVG_PPH.Value
                        End If

                        If sender.Name = "CAPTURE_TO_POWER_SETTING_HEAT_REJECTION" Then
                            LOG_PERF_TO_POWER_SETTING_HEAT_REJECTION_TOSP_DEGF.Value = LOG_PERF_T_OIL_SCAVENGE_PUMP_OUTLET_DEGF.Value
                            LOG_PERF_TO_POWER_SETTING_HEAT_REJECTION_TOPI_DEGF.Value = LOG_PERF_T_OIL_PUMP_INLET_DEGF.Value
                        End If

                        If sender.Name = "CAPTURE_TO_POWER_SETTING_AT_TO" Then
                            LOG_PERF_TO_POWER_SETTING_AT_TO_POFO_PSIG.Value = LOG_PERF_P_OIL_FILTER_DISCHARGE_PSIG.Value
                            LOG_PERF_TO_POWER_SETTING_AT_TO_MGTB_DEGF.Value = LOG_PERF_T_MGTB_DEGF.Value
                            LOG_PERF_TO_POWER_SETTING_AT_TO_WOIL_PPH.Value = LOG_PERF_WO_PPH.Value
                            LOG_PERF_TO_POWER_SETTING_AT_TO_WF_PPH.Value = LOG_PERF_WF_AVG_PPH.Value
                        End If

                        If sender.Name = "CAPTURE_TO_POWER_SETTING_TQ_CHECK" Then
                            LOG_PERF_TO_POWER_SETTING_TQ_CHECK_PTQM_PSIG.Value = LOG_PERF_P_TORQUE_OIL_PRESSURE_PSIG.Value
                            LOG_PERF_TO_POWER_SETTING_TQ_CHECK_TORQUE_LBSFT.Value = LOG_PERF_DYNO_TORQUE_LBSFT.Value
                        End If

                        If sender.Name = "CAPTURE_START_TO_POWER_SETTING" Then
                            LOG_PERF_TO_POWER_SETTING_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        '4.8 Torquemeter Calibration

                        If sender.Name = "CAPTURE_START_TORQUEMETER_CALIBRATION" Then
                            LOG_PERF_TORQUEMETER_CALIBRATION_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        '5.1 Control System Checks
                        If sender.Name = "CAPTURE_AI_VALVE_CK_VALVE_OFF_MGTB_DEGF" Then
                            LOG_PERF_AI_VALVE_CK_VALVE_OFF_MGTB_DEGF.Value = LOG_PERF_T_MGTB_DEGF.Value
                        End If
                        If sender.Name = "CAPTURE_AI_VALVE_CK_VALVE_ON_MGTB_DEGF" Then
                            LOG_PERF_AI_VALVE_CK_VALVE_ON_MGTB_DEGF.Value = LOG_PERF_T_MGTB_DEGF.Value
                        End If
                        If sender.Name = "CAPTURE_MANUAL_MODE_CK_CHAN_A_WF_PPH" Then
                            LOG_PERF_MANUAL_MODE_CK_CHAN_A_WF_PPH.Value = LOG_PERF_WF_AVG_PPH.Value
                        End If
                        If sender.Name = "CAPTURE_MANUAL_MODE_CK_CHAN_B_WF_PPH" Then
                            LOG_PERF_MANUAL_MODE_CK_CHAN_B_WF_PPH.Value = LOG_PERF_WF_AVG_PPH.Value
                        End If
                        If sender.Name = "CAPTURE_MANUAL_MODE_WF_PPH" Then
                            LOG_PERF_MANUAL_MODE_WF_PPH.Value = LOG_PERF_WF_AVG_PPH.Value
                        End If

                        If sender.Name = "CAPTURE_START_CONTROL_SYSTEM_CHECKS" Then
                            LOG_PERF_CONTROL_SYSTEM_CHECKS_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        '5.2 Transient time check (reference DS-A1470)

                        If sender.Name = "CAPTURE_TRANSIENT_FADEC_CHA_DECEL_TIME" Then
                            LOG_PERF_CHAN_A_DECEL_TIME_SEC.Value = TRANSIENT_CHECK_DECEL_TIME_SEC.Value
                        End If
                        If sender.Name = "CAPTURE_TRANSIENT_FADEC_CHB_ACCEL_TIME" Then
                            LOG_PERF_CHAN_B_ACCEL_TIME_SEC.Value = TRANSIENT_CHECK_ACCEL_TIME_SEC.Value
                        End If
                        If sender.Name = "CAPTURE_TRANSIENT_FADEC_CHA_ACCEL_TIME" Then
                            LOG_PERF_CHAN_A_DECEL_TIME_SEC.Value = TRANSIENT_CHECK_ACCEL_TIME_SEC.Value
                        End If
                        If sender.Name = "CAPTURE_TRANSIENT_FADEC_CHB_DECEL_TIME" Then
                            LOG_PERF_CHAN_B_ACCEL_TIME_SEC.Value = TRANSIENT_CHECK_DECEL_TIME_SEC.Value
                        End If

                        If sender.Name = "CAPTURE_START_TRANSIENT_TIME_CHECK" Then
                            LOG_PERF_TRANSIENT_TIME_CHECK_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        '5.3 Performance and Sensor Correlation

                        If sender.Name = "CAPTURE_START_PERFORMANCE_AND_SENSOR_CORRELATION" Then
                            LOG_PERF_PERFORMANCE_AND_SENSOR_CORRELATION_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        '5.4 Vibration Survey

                        If sender.Name = "CAPTURE_VIB_SURVEY_100NP_70NG" Then
                            LOG_PERF_VIB_SURVEY_100NP_70NG_VGBR_IPS.Value = LOG_PERF_VIB_GEARBOX_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_100NP_70NG_VADA_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_AXIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_100NP_70NG_VADR_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_100NP_70NG_VCHR_IPS.Value = LOG_PERF_VIB_COMBUSTOR_HOUSING_RADIAL_IPS.Value
                        End If
                        If sender.Name = "CAPTURE_START_VIB_SURVEY_100NP_70NG" Then
                            LOG_PERF_VIB_SURVEY_100NP_70NG_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        If sender.Name = "CAPTURE_VIB_SURVEY_100NP_80NG" Then
                            LOG_PERF_VIB_SURVEY_100NP_80NG_VGBR_IPS.Value = LOG_PERF_VIB_GEARBOX_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_100NP_80NG_VADA_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_AXIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_100NP_80NG_VADR_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_100NP_80NG_VCHR_IPS.Value = LOG_PERF_VIB_COMBUSTOR_HOUSING_RADIAL_IPS.Value
                        End If
                        If sender.Name = "CAPTURE_START_VIB_SURVEY_100NP_80NG" Then
                            LOG_PERF_VIB_SURVEY_100NP_80NG_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        If sender.Name = "CAPTURE_VIB_SURVEY_100NP_90NG" Then
                            LOG_PERF_VIB_SURVEY_100NP_90NG_VGBR_IPS.Value = LOG_PERF_VIB_GEARBOX_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_100NP_90NG_VADA_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_AXIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_100NP_90NG_VADR_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_100NP_90NG_VCHR_IPS.Value = LOG_PERF_VIB_COMBUSTOR_HOUSING_RADIAL_IPS.Value
                        End If
                        If sender.Name = "CAPTURE_START_VIB_SURVEY_100NP_90NG" Then
                            LOG_PERF_VIB_SURVEY_100NP_90NG_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        If sender.Name = "CAPTURE_VIB_SURVEY_100NP_95NG" Then
                            LOG_PERF_VIB_SURVEY_100NP_95NG_VGBR_IPS.Value = LOG_PERF_VIB_GEARBOX_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_100NP_95NG_VADA_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_AXIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_100NP_95NG_VADR_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_100NP_95NG_VCHR_IPS.Value = LOG_PERF_VIB_COMBUSTOR_HOUSING_RADIAL_IPS.Value
                        End If
                        If sender.Name = "CAPTURE_START_VIB_SURVEY_100NP_95NG" Then
                            LOG_PERF_VIB_SURVEY_100NP_95NG_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        If sender.Name = "CAPTURE_VIB_SURVEY_100NP_100NG" Then
                            LOG_PERF_VIB_SURVEY_100NP_100NG_VGBR_IPS.Value = LOG_PERF_VIB_GEARBOX_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_100NP_100NG_VADA_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_AXIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_100NP_100NG_VADR_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_100NP_100NG_VCHR_IPS.Value = LOG_PERF_VIB_COMBUSTOR_HOUSING_RADIAL_IPS.Value
                        End If
                        If sender.Name = "CAPTURE_START_VIB_SURVEY_100NP_100NG" Then
                            LOG_PERF_VIB_SURVEY_100NP_100NG_START.Value = NUMBER_OF_STARTS.Value
                        End If

                        If sender.Name = "CAPTURE_VIB_SURVEY_100NP_TO" Then
                            LOG_PERF_VIB_SURVEY_100NP_TO_VGBR_IPS.Value = LOG_PERF_VIB_GEARBOX_RADIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_100NP_TO_VADA_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_AXIAL_IPS.Value
