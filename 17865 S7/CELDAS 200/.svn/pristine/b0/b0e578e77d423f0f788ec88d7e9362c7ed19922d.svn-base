                            LOG_PERF_VIB_SURVEY_90NP_95NG_VADA_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_AXIAL_IPS.Value
                            LOG_PERF_VIB_SURVEY_90NP_95NG_VADR_IPS.Value = LOG_PERF_VIB_AIR_DIFFUSER_RADIAL_IPS.Value
