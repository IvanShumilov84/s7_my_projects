        Protected Overrides Function CreateCustomHeaderLogFile(ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Date Time:"
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

            RowIndex += 1
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Cond#:"
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

            RowIndex += 1
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Comment:"
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            ExcelWorksheet.Rows(RowIndex).RowHeight = 65.25
            ExcelWorksheet.Rows(RowIndex).VerticalAlignment = Excel.XlVAlign.xlVAlignTop
            ExcelWorksheet.Rows(RowIndex).WrapText = True

            Return True
        End Function

        Protected Overrides Function UpdateCustomHeaderLogFile(ByVal AppendOption As Boolean, ByVal IsPerfEntry As Boolean, ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean
            Dim Log_Condition As Integer

            If AppendOption = False Then
                Log_Condition = 1
            Else
                'Log_Condition = (ExcelWorksheet.Cells(RowIndex + 1, 1).End(Excel.XlDirection.xlToRight).Column - 1)
                'TODO: Ici changement du au nouveau Microsoft.Office.Interop.Excel	                        'Log_Condition = (ExcelWorksheet.Cells(RowIndex + 1, 1).End(XlDirection.xlToRight).Column - 1)  'cette ligne en office 2010 retourne toujours 16384 -1 donc 16383 et le reste du code plante
                Log_Condition = ExcelWorksheet.Cells(RowIndex + 1, ExcelWorksheet.Columns.Count).End(Excel.XlDirection.xlToLeft).Column - 1
                Log_Condition = Log_Condition + 1

            End If

            If ((Log_Condition > 1) And ((Log_Condition Mod 5) = 1)) Then

                'Repeat The Test Spec For this new sets of condition

                With ExcelWorksheet
                    .Range(.Cells(2, 2), .Cells(RowIndex - 2, 6)).Copy(.Cells(2, Log_Condition + 1))
                End With
            End If

            ColumnIndex = 1 + Log_Condition

            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Format(Now, "yyyy/MM/dd HH:mm:ss")
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += 1
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Log_Condition.ToString()
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += 1
            If IsPerfEntry = False Then
                Dim CommentText As String = ""
                Dim InputObject As New InputCommentForm
                InputObject.ShowDialog("Log Report", "Comment:", "", CommentText)

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = CommentText
            Else
                '						ExcelWorkSheet.Cells(RowIndex, ColumnIndex).Value				= "STEP: " & TEST_STEP_NB.Value.ToString() & " " & Now.ToString()
                'TODO ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "STEP: " & TestStep_List.SelectedItem & " " & Now.ToString()
            End If

            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += 2
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Values"
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignCenter

            Return True
        End Function


        Protected Overrides Sub Init_Engine_Channels_Value()

            FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())
            'Initial Value for Dynamometer in Speed mode at 1200 RPM
            DYNO_SPEED_DEMAND.Value = New KineticaRT.Values.Double(DYNO_SPEED_100_PCT_RPM.Value.ToDouble)
            DYNO_SPEED_MODE_BTN.Value = Values.True

            'Default value for power law mode
            If DYNO_POWERLAW_DEFAULT_TDEMAND IsNot Nothing Then
                DYNO_POWLAW_DEMAND.Value = New KineticaRT.Values.Double(DYNO_POWERLAW_DEFAULT_TDEMAND.Value.ToDouble)
            Else
                DYNO_POWLAW_DEMAND.Value = New KineticaRT.Values.Double(-4700)
            End If

        End Sub

        Protected Overrides Sub OnEngineWorkingThread()

            ' Time to Idle and StartTime are the same here
            TimeToIdleTimerCtrl.Timer()
            TimeToLightTimerCtrl.Timer()
            CrankTimerCtrl.Timer()
            StarterTimerCtrl.Timer()
            OperatingTimerCtrl.Timer()
            If CELProject.HierarchyType = CELDAS.eHierarchyType.Master Then
                AccelCheckTimerCtrl.Timer()
            End If

            BleedAirflow_Calc_PW127E()

            'Persistent Values Save Check
            PersistentValuesCtrl.SavePersistentValues(False)

        End Sub

        Private Sub SetTransientPresets()
            Dim engineModel = CELProject.EngineModel

            Dim enginesWithSCU() As String = {"PW118", "PW118A", "PW118B", "PW119B", "PW119C", "PW120", "PW120A", "PW121"}

            Try
                TransientControl.SaveFileDialog.InitialDirectory = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() & "\" _
                        & CELProject.Test_Mgr_UUT_Answer(1).Value.ToString()

                ' Ajoute le preset seulement si l'unité en test comporte un Q-SCU
                If Array.Exists(enginesWithSCU, Function(engineToCheck)
                                                    Return engineToCheck.Equals(CELProject.EngineModel)
                                                End Function) Then

                    'Graph A - Q-SCU SHP vs Q SHP
                    'XY type graph i.e. Parameter on X Axis vs another parameter(s) on Y Axis
                    'preset.Name = "Q-SCU SHP vs Q SHP"
                    'preset.XAxisSourceChannel = "SHP_HP_SCALE"

                    'Y Axi(e)s is/are of the left
                    'preset.YAxisSourceChannels.Add("SHP_SCU_HP_SCALE")

                    'TransientControl.Presets.Add(preset)

                End If

                If engineModel = "PW127E" Then

                    'Graph B - "Oil Pressure vs NH Speed"
                    'preset.Name = "Oil Pressure vs NH Speed"
                    'preset.XAxisSourceChannel = "NH_RPM_DIAL"
                    'preset.YAxisSourceChannels.Add("P_MOP_PSID_SCALE")
                    'TransientControl.Presets.Add(preset)
                End If

            Catch ex As Exception
                MessageBox.Show("PW100_Sequence: SetTransientPresets: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Private Sub BleedAirflow_Calc_PW127E()
            Dim dhbv As Double
            Dim thbv As Double
            Dim whbcap As Double
            Dim whbvppm As Double

            Try
                dhbv = P_PB1_PSIA.Value.ToDouble() / 14.696
                thbv = (T_TB1_DEGR.Value.ToDouble() / 518.67) ^ 0.5
                whbcap = 0.04508 * (P_PB1_PSIG.Value.ToDouble() * 27.68 / dhbv) ^ 0.44782 * 60
                whbvppm = whbcap * dhbv / thbv

                'Write result to channel WB
                WB_CALC.Value = New KineticaRT.Values.Double(whbvppm)


            Catch Ex As Exception
                'Log error
                MessageBox.Show("PW100_Sequence: BleedAirflow_Calc_PW127E: " & Ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            Finally

            End Try
        End Sub

