        Private Sub OnBTN_TORQUE_TRIM(sender As IChannel, newVal As Value)
            Dim FileName As String
            Dim ier As Integer
            Dim iOutput As Integer = 1
            Dim iTMTolDouble As Integer
            Dim PerfFileName As String
            Dim rBiasCl As Single = 0
            Dim rGainCl As Single = 0
            Dim rResBias As Single = 0
            Dim rResGain As Single = 0


            Try
                If (newVal Is Values.True) Then

                    'Get values EEC R3 and EEC R4
                    rResBias = CSng(PERF_EEC_R3.Value.ToDouble())
                    rResGain = CSng(PERF_EEC_R4.Value.ToDouble())

                    If (PERF_TRIM_TOLERANCE_BTN.Value.ToString() = "False") Then
                        iTMTolDouble = 1
                    Else
                        iTMTolDouble = 2
                    End If

                    Dim Temp As Boolean = Initialize_Perf()

                    pwc83025.SetBuild(1)
                    pwc83025.SetCondition(1)

                    pwc83025.ProcessTorqueTrim(iOutput, iTMTolDouble, Dyno_Tq_TO, Dyno_Tq_50PC, EEC_Tq_TO, EEC_Tq_50PC, rResGain, rResBias, ier)
                    If (ier = 0) Then
                        FileName = GetOutputFilename()

                        PerfFileName = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + UserInputsPW150A.EngineSerialNumber + "\" + UserInputsPW150A.WorkOrder + "\Perf\" + "Torque Trim_" + Format(Now, "yyyy-MM-dd HH'h'mm'm'ss's'") + ".txt"

                        If (System.IO.File.Exists(PerfFileName)) Then
                            System.IO.File.Delete(PerfFileName)
                        End If

                        System.IO.File.Copy(FileName, PerfFileName)
                        ShowOutputFile(FileName)

                    Else
                        MessageBox.Show("UNEXPECTED ERROR:" + vbCrLf + "==== ERROR PROCESSING TORQUE TRIM  ====" + vbCrLf)
                        ShowOutputFile("TEMP.OUT")
                    End If

                    PERF_COMPUTE_TORQUE_TRIM_BTN.Value = Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("PWC83025_Sequence : OnBTN_TORQUE_TRIM()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub
        ''' <summary>
        ''' Function to calculate the Y value by using three points with X and Y values.
        ''' </summary>
        ''' <param name="X">Array of Double(2) contains the x positions of three points</param>
        ''' <param name="Y">Array of Double(2) contains the y positions of three points</param>
        ''' <param name="Point">What is the X point to be calculated</param>
        ''' <returns>Returns what is the value of Y at the Point position using least squared lines method</returns>
        ''' <remarks></remarks>
        Private Function LeastSquaresLine(ByVal X() As Double, ByVal Y() As Double, ByVal Point As Double) As Double

            Dim SumX, SumXSquared, SumY, SumXY As Double
            Dim Xmed, Ymed, ResultPoint As Double

            For I As Integer = 0 To X.Length - 1
                SumX += X(I)
                SumXSquared += X(I) * X(I)
                SumY += Y(I)
                SumXY += X(I) * Y(I)
            Next

            Xmed = SumX / X.Length
            Ymed = SumY / Y.Length


            Dim Slope, Intercept, Determinant As Double
            Determinant = X.Length * SumXSquared - (SumX * SumX)
            Slope = ((X.Length * SumXY) - (SumY * SumX)) / Determinant ' aka b
            'Intercept = (SumY * SumXSquared - SumX * SumXY) / Determinant

            Intercept = Ymed - (Slope * Xmed) ' aka a

            ResultPoint = Intercept + Slope * Point

            'Return New Double() {Slope, Intercept}
            Return ResultPoint

        End Function


