        ''' <summary>
        ''' Process the type of files to look in the directory for performance
        ''' 
        ''' type = 0 is look for files less or equal to 4380 SHP
        ''' type = 1 is look for files more than 4380 SHP and less than 4825
        ''' type = 2 is look for files more than 4825 SHP
        ''' 
        ''' it returns 0 if everything OK if not 1
        ''' </summary>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Private Function ProcessFileType(ByVal type As Integer) As Integer

            Dim result As Integer = 1
            Dim allFiles As StringBuilder
            Dim s As String
            Dim d() As Decimal
            Dim goodfiles As New List(Of String) ' store the good files to display in the combobox

            If type = 0 Or type = 1 Or type = 2 Then

                allFiles = GetPerfRatingFiles()
                Dim crt As Integer = 0
                Dim mystr() As String
                Dim cgoodfiles As Integer = 0

                If type = 0 And Not allFiles Is String.Empty Then

                    workingRatingFile = 1
                    mystr = allFiles.ToString().Split(Environment.NewLine)
                    Dim cuenta As Integer = 0 ' number of good files shp >= 4010 & shp <= 4380

                    For crt = 0 To mystr.GetUpperBound(0) - 1
                        s = mystr(cuenta)
                        s = s.Trim()
                        If Not s = "" Then
                            d = GetPerfData(s)
                            If (d(6) >= 4010 And d(6) <= 4380) Then
                                goodfiles.Add(s)
                                cgoodfiles = cgoodfiles + 1
                            End If
                            cuenta = cuenta + 1
                        End If
                    Next

                    If goodfiles.Count > 0 Then
                        cboFileRating.Items.Add("")
                        For Each item As String In goodfiles
                            cboFileRating.Items.Add(item)
                        Next
                    End If



                ElseIf type = 1 And Not allFiles Is String.Empty Then

                    workingRatingFile = 2
                    mystr = allFiles.ToString().Split(Environment.NewLine)
                    Dim cuenta As Integer = 0 ' number of good files shp > 4380 and shp < 4825

                    For crt = 0 To mystr.GetUpperBound(0) - 1
                        s = mystr(cuenta)
                        s = s.Trim()
                        If Not s = "" Then ' sometimes I got an empty line at the end
                            d = GetPerfData(s)
                            If (d(6) > 4380 And d(6) < 4825) Then
                                goodfiles.Add(s)
                                cgoodfiles = cgoodfiles + 1
                            End If
                            cuenta = cuenta + 1
                        End If
                    Next


                    If goodfiles.Count > 0 Then
                        cboFileRating.Items.Add("")
                        For Each item As String In goodfiles
                            cboFileRating.Items.Add(item)
                        Next
                    End If

                ElseIf type = 2 And Not allFiles Is String.Empty Then

                    workingRatingFile = 3
                    mystr = allFiles.ToString().Split(Environment.NewLine)
                    Dim cuenta As Integer = 0 ' number of good files shp <= 4380

                    For crt = 0 To mystr.GetUpperBound(0) - 1
                        s = mystr(cuenta)
                        s = s.Trim()
                        If Not s = "" Then
                            d = GetPerfData(s)
                            If d(6) >= 4825 And d(6) <= 5316 Then
                                goodfiles.Add(s)
                                cgoodfiles = cgoodfiles + 1
                            End If
                            cuenta = cuenta + 1
                        End If
                    Next

                    If goodfiles.Count > 0 Then
                        cboFileRating.Items.Add("")
                        For Each item As String In goodfiles
                            cboFileRating.Items.Add(item)
                        Next
                    End If

                End If

                result = 0
            End If
            Return result

        End Function

        ''' <summary>
        ''' Function when the file text changed.
        ''' It enables the Rating Analysis button when 3 files are selected.
        ''' </summary>
        ''' <param name="sender"></param>
        ''' <param name="e"></param>
        ''' <remarks></remarks>
        Private Sub OnFileRating_List_SelectedIndexChanged(ByVal sender As System.Object, ByVal e As System.EventArgs)
            Try

                If workingRatingFile = 1 Then

                    If cboFileRating.SelectedItem.ToString() = "" Then
                        ratingFile1 = String.Empty
                        labelFileRating.Text = "N/A"
                        RATING_FILE1_IND.Value = Values.False
                    Else
                        ratingFile1 = cboFileRating.SelectedItem.ToString()
                        labelFileRating.Text = GetDynoTQ(ratingFile1)
                        RATING_FILE1_IND.Value = Values.True
                    End If

                ElseIf workingRatingFile = 2 Then

                    If cboFileRating.SelectedItem.ToString() = "" Then
                        ratingFile2 = String.Empty
                        labelFileRating.Text = "N/A"
                        RATING_FILE2_IND.Value = Values.False
                    Else
                        ratingFile2 = cboFileRating.SelectedItem.ToString()
                        labelFileRating.Text = GetDynoTQ(ratingFile2)
                        RATING_FILE2_IND.Value = Values.True
                    End If
                ElseIf workingRatingFile = 3 Then

                    If cboFileRating.SelectedItem.ToString() = "" Then
                        ratingFile3 = String.Empty
                        labelFileRating.Text = "N/A"
                        RATING_FILE3_IND.Value = Values.False
                    Else
                        ratingFile3 = cboFileRating.SelectedItem.ToString()
                        labelFileRating.Text = GetDynoTQ(ratingFile3)
                        RATING_FILE3_IND.Value = Values.True
                    End If
                End If

                If Not ratingFile1 Is String.Empty And Not ratingFile2 Is String.Empty And Not ratingFile3 Is String.Empty Then
                    'MessageBox.Show("Rating analysing is enable")
                    RATING_WINDOW_BTN_ENB.Value = Values.True
                Else
                    RATING_WINDOW_BTN_ENB.Value = Values.False
                End If


            Catch ex As Exception
                MessageBox.Show("PWC83025_Sequence.OnFileRating_List_SelectedIndexChanged: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        ''' <summary>
        ''' This function will take 3 files then perform ratining analysis them write the excel file for Final Acceptance
        ''' 
        ''' This function assumes that the 3 files are correctly selected and valid
        ''' 
        ''' Finally it will write down the Excel file into the Perf directory 
        ''' </summary>
        ''' <remarks></remarks>
        Private Sub ProcessRatingAnalysis()

            Dim d(5) As Decimal 'd(x) is:  0: shp, 1: nh 2: nl  3: nh_over_nl 4: itt_corr 5: wf_corr
            Dim x(2), y(2) As Double
            Dim results(5) As Double

            results(0) = 5071.0

            d = GetPerfData(ratingFile1) 'd(x) is:  0: shp, 1: nh 2: nl  3: nh_over_nl 4: itt_corr 5: wf_corr
            x(0) = d(0)
            y(0) = d(5) ' d(5) is Wf

            d = GetPerfData(ratingFile2)
            x(1) = d(0)
            y(1) = d(5)

            d = GetPerfData(ratingFile3)
            x(2) = d(0)
            y(2) = d(5)

            results(0) = 5071.0
            results(5) = LeastSquaresLine(x, y, 5071.0)




            d = GetPerfData(ratingFile1) 'd(x) is:  0: shp, 1: nh 2: nl  3: nh_over_nl 4: itt_corr 5: wf_corr
            x(0) = d(0)
            y(0) = d(1) ' d(1) is NH

            d = GetPerfData(ratingFile2)
            x(1) = d(0)
            y(1) = d(1)

            d = GetPerfData(ratingFile3)
            x(2) = d(0)
            y(2) = d(1)

            'xySqrResult(0) = 5071.0
            results(1) = LeastSquaresLine(x, y, 5071.0)

            'MessageBox.Show("Result of NH @ 5071.0 SHP is: " & xySqrResult(1).ToString())


            d = GetPerfData(ratingFile1) 'd(x) is:  0: shp, 1: nh 2: nl  3: nh_over_nl 4: itt_corr 5: wf_corr
            x(0) = d(0)
            y(0) = d(2) ' d(2) is NL

            d = GetPerfData(ratingFile2)
            x(1) = d(0)
            y(1) = d(2)

            d = GetPerfData(ratingFile3)
            x(2) = d(0)
            y(2) = d(2)

            'xySqrResult(0) = 5071.0
            results(2) = LeastSquaresLine(x, y, 5071.0)

            'MessageBox.Show("Result of NL @ 5071.0 SHP is: " & xySqrResult(2).ToString())



            d = GetPerfData(ratingFile1) 'd(x) is:  0: shp, 1: nh 2: nl  3: nh_over_nl 4: itt_corr 5: wf_corr
            x(0) = d(0)
            y(0) = d(3) ' d(3) is NH

            d = GetPerfData(ratingFile2)
            x(1) = d(0)
            y(1) = d(3)

            d = GetPerfData(ratingFile3)
            x(2) = d(0)
            y(2) = d(3)

            'xySqrResult(0) = 5071.0
            results(3) = LeastSquaresLine(x, y, 5071.0)

            'MessageBox.Show("Result of NH @ 5071.0 SHP is: " & xySqrResult(3).ToString())


            d = GetPerfData(ratingFile1) 'd(x) is:  0: shp, 1: nh 2: nl  3: nh_over_nl 4: itt_corr 5: wf_corr
            x(0) = d(0)
            y(0) = d(4) ' d(4) is ITT

            d = GetPerfData(ratingFile2)
            x(1) = d(0)
            y(1) = d(4)

            d = GetPerfData(ratingFile3)
            x(2) = d(0)
            y(2) = d(4)

            'xySqrResult(0) = 5071.0
            results(4) = LeastSquaresLine(x, y, 5071.0)

            'MessageBox.Show("Result of ITT @ 5071.0 SHP is: " & xySqrResult(4).ToString())

            Try
                'http://vb.net-informations.com/excel-2007/vb.net_excel_2007_open_file.htm
                Dim xlApp As Excel.Application
                Dim xlWorkBook As Excel.Workbook
                Dim xlWorkSheet As Excel.Worksheet
                Dim filetowrite As String = String.Empty
                Dim directorytoread As String = "C:\My Projects\CELDAS 200\HMI\PW150\"
                Dim directorytowrite As String = "C:\CELDAS DATA\" & CELProject.EngineModel & _
                "\" & UserInputsPW150A.EngineSerialNumber & _
                "\" & UserInputsPW150A.WorkOrder & _
                "\Perf\"

                xlApp = New Excel.ApplicationClass
                'todo i need to add which files to use Overhaul, Refurbish or Repair for no overhaul

                'If CELProject.Test_Mgr_UUT_Choice(0).Value.ToString() = "Overhaul new" Then
                '    filetowrite = "PW150A Final Acceptance Overhaul Limits.xls"
                'ElseIf CELProject.Test_Mgr_UUT_Choice(0).Value.ToString() = "HSI / refurbish" Then
                '    filetowrite = "PW150A Final Acceptance Refurbish Limits.xls"
                'ElseIf CELProject.Test_Mgr_UUT_Choice(0).Value.ToString() = "Repair" Then
                '    filetowrite = "PW150A Final Acceptance Repair Limits.xls"
                'Else
                '    MsgBox("Error 100: PWC83025_Sequence.ProcessRatingAnalysis: No test type selected")
                'End If
                filetowrite = CELProject.Project.Number & " PW150A Engine Performance Acceptance.xls"

                xlWorkBook = xlApp.Workbooks.Open(directorytoread & filetowrite)
                xlWorkSheet = xlWorkBook.Worksheets("Sheet1")


                xlWorkSheet.Cells(9, 2) = CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
                xlWorkSheet.Cells(9, 11) = CELProject.Test_Mgr_UUT_Choice(1).Value.ToString()
                xlWorkSheet.Cells(11, 2) = CELProject.Test_Mgr_UUT_Answer(1).Value.ToString()

                xlWorkSheet.Cells(21, 10) = results(1).ToString("#,##0.00", CultureInfo.InvariantCulture)
                xlWorkSheet.Cells(22, 10) = results(2).ToString("#,##0.00", CultureInfo.InvariantCulture)
                xlWorkSheet.Cells(23, 10) = results(3).ToString("#,##0.000")
                xlWorkSheet.Cells(24, 10) = results(4).ToString("#,##0.00", CultureInfo.InvariantCulture)
                xlWorkSheet.Cells(25, 10) = results(5).ToString("#,##0.00", CultureInfo.InvariantCulture)

                'todo dynamic link
                If File.Exists(directorytowrite & filetowrite) Then
                    File.Delete(directorytowrite & filetowrite)
                End If

                xlWorkBook.SaveAs(directorytowrite & filetowrite)
                xlWorkBook.Close()
                xlApp.Quit()

                ReleaseMyObject(xlWorkSheet)
                ReleaseMyObject(xlWorkBook)
                ReleaseMyObject(xlApp)

                NotifyIcon.Tag = directorytowrite & filetowrite 'Path.GetDirectoryName(filename)
                NotifyIcon.Visible = True
                NotifyIcon.ShowBalloonTip(15000, "Celdas 200™", "New log file successfully generated:" & _
                                          vbCrLf & directorytowrite & filetowrite & vbCrLf & "Click here to open file.", ToolTipIcon.Info)
                'NotifyIcon.Tag = Nothing

            Catch ex As Exception
                MessageBox.Show("PWC83025_Sequence.ProcessRatingAnalysis: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try

            ratingFile1 = String.Empty
            ratingFile2 = String.Empty
            ratingFile3 = String.Empty

            RATING_FILE1_IND.Value = Values.False
            RATING_FILE2_IND.Value = Values.False
            RATING_FILE3_IND.Value = Values.False

        End Sub


        ''' <summary>
        ''' Releases COM objects in this case EXCEL objects
        ''' </summary>
        ''' <param name="obj"></param>
        ''' <remarks></remarks>
        Private Sub ReleaseMyObject(ByVal obj As Object)
            Try
                System.Runtime.InteropServices.Marshal.ReleaseComObject(obj)
                obj = Nothing
            Catch ex As Exception
                obj = Nothing
            Finally
                GC.Collect()
            End Try
        End Sub

        ''' <summary>
        ''' Provides the Dyno TQ value of the filepath
        ''' </summary>
        ''' <param name="filepath">File path location of the file to be analyze</param>
        ''' <returns>a String with the Mech Torque in SHP</returns>
        ''' <remarks></remarks>
        Private Function GetDynoTQ(ByVal filepath As String) As String
            Dim result As String = "N/A"
            Dim d() As Decimal

            Try
                d = GetPerfData(filepath)
                result = d(6).ToString()
            Catch ex As Exception
                MessageBox.Show("PWC83025_Sequence.GetDynoTQ: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
            
            Return result
        End Function

        ''' <summary>
        ''' Function to handle the click on the Notify Icon
        ''' </summary>
        ''' <remarks></remarks>
        Public Shared Sub OnNotifyIconBalloonTipClicked() Handles NotifyIcon.Click
            Try

                If Not IsNothing(NotifyIcon.Tag) Then
                    If NotifyIcon.Tag.ToString.ToLower.EndsWith("xls") Then
                        Dim filename As String = NotifyIcon.Tag.ToString
                        If File.Exists(filename) Then 'Open EXCEL

                            Dim excelProcess As Process = New Process()
                            excelProcess.StartInfo.FileName = "excel.exe"
                            excelProcess.StartInfo.Arguments = """" & filename & """"
                            excelProcess.Start()

                        End If
                    Else
                        Dim directoryPath As String = NotifyIcon.Tag.ToString
                        If Directory.Exists(directoryPath) Then 'Open EXPLORER
                            Process.Start("explorer.exe", directoryPath)
                        End If
                    End If
                    NotifyIcon.Visible = False ' hide the icon when it has a value
                End If
                NotifyIcon.Tag = Nothing
            Catch ex As Exception
                MessageBox.Show("PWC83025.OnNotifyIconBalloonTipClicked: " + ex.ToString, "Error")
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionInitialized(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                MyBase.OnTestSessionInitialized(newStatus)

                If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then

                    Select Case CELProject.EngineModel

                        Case "PW150A"

                            'Client Initialization
                            Dim endpointAddress As New EndpointAddress(Configuration.CreateServerUriString())
                            Dim binding As System.ServiceModel.Channels.Binding = Configuration.CreateBinding()
                            Dim factory As New ChannelFactory(Of IPwc83025)(binding, endpointAddress)
                            pwc83025 = factory.CreateChannel()

                            UserInputsPW150A.MapUserInputsParameters(CELProject)

                            Init_Engine_Channels()
                            If Initialize_Perf() = False Then
                                Perf_Status_Close = True
                                CELProject.Test_Mgr_Cmd.Value = New KineticaRT.Values.Text(CELDAS.eTest_Mgr_Cmd.Close)
                            Else
                                Perf_Status_Close = False
                            End If

                            'CreateLogFile() Ajouter Creation du Log generique
                            Initialize()



                    End Select
                End If
            Catch Ex As Exception
                MessageBox.Show("PWC83025_Sequence : OnTestSessionInitialized()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)

            Catch ex As Exception

                MessageBox.Show("PWC83025_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            End Try
        End Sub

        Protected Overrides Sub OnTestSessionRunning(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                MyBase.OnTestSessionRunning(newStatus)
                If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then

                    Select Case CELProject.EngineModel

                        Case "PW150A"

                            FlowmeterCtrl = New FlowmeterController(Me)

                            If Perf_Status_Close Then
                                CELProject.Test_Mgr_Cmd.Value = New KineticaRT.Values.Text(CELDAS.eTest_Mgr_Cmd.Close)
                            End If
                            CreateHandler()

                    End Select
                End If
            Catch Ex As Exception
                MessageBox.Show("PWC83025_Sequence : OnTestSessionRunning()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionClosing(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionClosing(newStatus)
                If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then
                    Select Case CELProject.EngineModel

                        Case "PW150A"

                            DeleteHandler()

                            If Not (FlowmeterCtrl Is Nothing) Then
                                FlowmeterCtrl.Dispose()
                            End If

                    End Select
                End If
            Catch Ex As Exception
                MessageBox.Show("PWC83025_Sequence : OnTestSessionClosing()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

