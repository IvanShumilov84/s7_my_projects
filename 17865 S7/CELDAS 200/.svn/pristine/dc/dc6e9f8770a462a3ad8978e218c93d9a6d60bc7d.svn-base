                        Return_Value.Add(MyBase.InitializeChannel(SLAVE_RATING_CLOSE_BTN, "SLAVE_RATING_CLOSE_BTN"))
                        Return_Value.Add(MyBase.InitializeObject(cboFileRating, "PW150_Slave_Rating_Screen.cbo_CHOICE_FILE"))
                        Return_Value.Add(MyBase.InitializeObject(labelFileRating, "PW150_Slave_Rating_Screen.lblSHP"))

                End Select

            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.Message)
                Return_Value.Add(False)
            Finally

            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function

        Private Function Initialize() As Boolean
            Try

                Dyno_Tq_50PC = 0
                Dyno_Tq_TO = 0
                EEC_Tq_50PC = 0
                EEC_Tq_TO = 0
                PERF_CONDITION_NUMBER.Value = Values.One
                PERF_REMARK_TEXT.Value = New KineticaRT.Values.Text("")

                If UserInputsPW150A.LPTVane = "3048422" Then
                    PERF_LPT_VANE1.Value = Values.One
                    PERF_LPT_VANE2.Value = Values.One
                    PERF_LPT_VANE3.Value = Values.One
                    PERF_LPT_VANE4.Value = Values.One
                    PERF_LPT_VANE5.Value = Values.One
                    PERF_LPT_VANE6.Value = Values.One
                    PERF_LPT_VANE7.Value = New KineticaRT.Values.Double(2)
                ElseIf UserInputsPW150A.LPTVane = "3071532" Then
                    PERF_LPT_VANE1.Value = New KineticaRT.Values.Double(2)
                    PERF_LPT_VANE2.Value = New KineticaRT.Values.Double(2)
                    PERF_LPT_VANE3.Value = New KineticaRT.Values.Double(2)
                    PERF_LPT_VANE4.Value = New KineticaRT.Values.Double(2)
                    PERF_LPT_VANE5.Value = New KineticaRT.Values.Double(2)
                    PERF_LPT_VANE6.Value = New KineticaRT.Values.Double(2)
                    PERF_LPT_VANE7.Value = New KineticaRT.Values.Double(3)
                End If

                ratingFile1 = String.Empty
                ratingFile2 = String.Empty
                ratingFile3 = String.Empty

                RATING_WINDOW_BTN_ENB.Value = Values.False
                cboFileRating.Items.Clear()
                workingRatingFile = 0
                NotifyIcon = New System.Windows.Forms.NotifyIcon

                Return True

            Catch Ex As Exception
                MessageBox.Show("PWC83025_Sequence : Initialize()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return False
            End Try
        End Function

        Private Function Initialize_Perf() As Boolean
            Dim iError As Integer
            Dim iVaneCode As Integer
            Dim BuildSpecValue As Integer

            Try

                CopyConfigurationFiles()

                pwc83025.SetConfigurationPath(sConfigurationPath)
                pwc83025.SetDataPath(sDataPath)

                pwc83025.GetUnitData()
                SetUnitValues()

                pwc83025.SetEngine(UserInputsPW150A.EngineSerialNumber)

                'Build is always set to 1 in test case
                pwc83025.SetBuild(1)

                If UserInputsPW150A.LPTVane = "3048422" Then
                    iVaneCode = 1
                ElseIf UserInputsPW150A.LPTVane = "3071532" Then
                    iVaneCode = 2
                End If

                Integer.TryParse(UserInputsPW150A.BuildSpec, BuildSpecValue)
                pwc83025.LoadModel(iError, BuildSpecValue, iVaneCode)


                If iError <> 0 Then
                    MessageBox.Show("PWC83025_Sequence : Initialize_Perf() Couldn't load Build Spec", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)

                    Return False
                Else
                    pwc83025.Initialize()
                    Return True
                End If

            Catch Ex As Exception
                MessageBox.Show("PWC83025_Sequence : Initialize_Perf() : Cannot communicate with P&WC DLL Processing Server" & vbCrLf & vbCrLf & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return False
            End Try
        End Function

        Private Sub ProcessCondition()
            Dim Cond_nb As Integer
            Dim FileName As String
            Dim iError As Integer

            Try
                Cond_nb = CInt(PERF_CONDITION_NUMBER.Value.ToDouble())
                pwc83025.SetCondition(Cond_nb)
                SubmitPerfValues()
                pwc83025.Process(iError, 1, 1)

                If (iError = 0) Then
                    FileName = GetOutputFilename()

                    PerfFileName = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + UserInputsPW150A.EngineSerialNumber + "\" + UserInputsPW150A.WorkOrder + "\Perf\" + "Performance " + Format(Now, "yyyy-MM-dd HH'h'mm'm'ss's'") + ".txt"

                    If (System.IO.File.Exists(PerfFileName)) Then
                        System.IO.File.Delete(PerfFileName)
                    End If

                    System.IO.File.Copy(FileName, PerfFileName)
                    ShowOutputFile(FileName)
                    PERF_CONDITION_NUMBER.Value = New KineticaRT.Values.Double(PERF_CONDITION_NUMBER.Value.ToDouble + 1)
                Else
                    MessageBox.Show("UNEXPECTED ERROR:" + vbCrLf + "==== ERROR PROCESSING CONDITION ====" + vbCrLf)
                    ShowOutputFile("TEMP.OUT")
                End If
            Catch ex As Exception
                MessageBox.Show("PWC83025_Sequence : ProcessCondition() : Cannot communicate with P&WC DLL Processing Server" & vbCrLf & vbCrLf & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub SampleValues()
