        Private Sub OnTestStep_List_SelectedIndexChanged(ByVal sender As System.Object, ByVal e As System.EventArgs)
            Try
                'TSCP700-4B/5 has a Standby speed and inlet temperature check which is not present in the TSCP700-4E test procedure
                'The ENUM is the same for the family even if there is one step less in the TSCP700-4E but we keep the same value for the PERF_TEST_STEP_NB
                'for the final data
                If CELProject.EngineModel = "TSCP700-4B" Or CELProject.EngineModel = "TSCP700-5" Then
                    CELProject.PERF_TEST_STEP_NB.Value = New KineticaRT.Values.Integer(TestStep_List.SelectedIndex)
                ElseIf CELProject.EngineModel = "TSCP700-4E" Then
                    'Final Data Step = 3 for TSCP700-4E instead of 4 for the TSCP700-4B/5
                    If TestStep_List.SelectedIndex = 3 Then
                        CELProject.PERF_TEST_STEP_NB.Value = New KineticaRT.Values.Integer(TestStep_List.SelectedIndex + 1)
                    Else
                        CELProject.PERF_TEST_STEP_NB.Value = New KineticaRT.Values.Integer(TestStep_List.SelectedIndex)
                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("OnTestStep_List_SelectedIndexChanged: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

     
        Protected Overrides Sub OnTestSessionClosing(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                MyBase.OnTestSessionClosing(newStatus)

                If CELProject.EngineFamily = "TSCP700" Then

                    'Close the connection to the database
                    DatabaseHelper.CloseConnection(cnMain)

                    If TestProgressMgr IsNot Nothing Then
                        TestProgress_Save()
                        TestProgressMgr.Dispose()
                        TestProgressMgr = Nothing
                    End If

                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionClosing: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionInitialized(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionInitialized(newStatus)

                If CELProject.EngineFamily = "TSCP700" Then

                    If CELProject.Project.Number = "10726" Then 'Value Specific to the Indonesia project

                        UserInputsGaruda.MapUserInputsParameters(CELProject)
                        CELProject.EngineSession.WorkingFolder = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + UserInputsGaruda.EngineSerialNumber + "\" + UserInputsGaruda.WorkOrder
                    ElseIf CELProject.Project.Number = "12917" Then

                        UserInputsRevima.MapUserInputsParameters(CELProject)
                        CELProject.EngineSession.WorkingFolder = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + UserInputsRevima.EngineSerialNumber + "\" + UserInputsRevima.WorkOrder
                    Else
                        MessageBox.Show("OnTestSessionInitialized: Project not supported", "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                    End If


                    CELProject.CreateLogFile(AddressOf CreateCustomHeaderLogFile, CELProject.EngineModel, CELProject.EngineModel)

                    'Set The Connection (Global scope)
                    If Not DatabaseHelper.OpenConnection(CELProject.Database.OleDbConnectionString, cnMain, True) Then
                        'Close Test if unable to open connection to database
                        CELProject.Test_Mgr_Cmd.Value = New KineticaRT.Values.Text(CELDAS.eTest_Mgr_Cmd.Close)
                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionInitialized: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)

            Catch ex As Exception

                MessageBox.Show("TSCP700_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            End Try
        End Sub
    
        Protected Overrides Sub OnTestSessionRunning(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            'Dim i As Integer
            Try
                MyBase.OnTestSessionRunning(newStatus)

                If CELProject.EngineFamily = "TSCP700" Then

                    Init_Engine_Channels()
                    Init_Arrays()
                    Init_Engine_Channels_Value()

                    CELProject.LoadSave_Custom_Parameters(Custom_Parameters, False)

                    CELProject.Perf_Nb_Sheet_To_Print = 3

                    Dim PersistentValuesChannels() As String = {"NUMBER_OF_STARTS",
                                                                "OPERATING_TIME_CURRENT_SEC",
                                                                "FUEL_USED_INITIAL_LITERS", "FUEL_USED_TOTAL_LITERS"}

                    Dim PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputsRevima.EngineSerialNumber & "\" & UserInputsRevima.WorkOrder & "\Log\PersistentValues.xml"

                    PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

                    Dim FuelUsedTotal As Double = FUEL_USED_TOTAL_LITERS.Value.ToDouble()
                    FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())
                    FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FuelUsedTotal)

                    CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.ConfigHMIforEngine))

                    ' Default value if not override by the project
                    Dim RealNumberOfTBleedProbe As Integer = MaxNumberOfTBleedProbe
                    Dim RealNumberOfTEgtProbe As Integer = MaxNumberOfTEgtProbe
                    Dim RealNumberOfTInletProbe As Integer = MaxNumberOfTInletProbe

                    If CELProject.Project.Number = "10726" Then 'Value Specific to the Indonesia project

                        RealNumberOfTBleedProbe = 1

                    ElseIf CELProject.Project.Number = "12917" Then

                        RealNumberOfTEgtProbe = 9

                        If CELProject.EngineModel = "TSCP700-4B" Or CELProject.EngineModel = "TSCP700-5" Then
                            RealNumberOfTBleedProbe = 2
                        ElseIf CELProject.EngineModel = "TSCP700-4E" Then
                            RealNumberOfTBleedProbe = 1
                        End If

                    End If

                    DeletableTBleedChCtrl = New DeletableChannelController(Me, RealNumberOfTBleedProbe, MaxNumberOfTBleedProbe, MaxNumberOfTBleedProbe, "T_BLEED", "_DEGF", "_DELETE_BTN", "T_BLEED_AVG_DEGF", "T_BLEED_MIN_DEGF", "T_BLEED_MAX_DEGF", "T_BLEED_SPREAD_DEGF")
                    DeletableTEgtChCtrl = New DeletableChannelController(Me, RealNumberOfTEgtProbe, MaxNumberOfTEgtProbe, MaxNumberOfTEgtProbe, "T_EGT", "_DEGF", "_DELETE_BTN", "T_EGT_AVG_DEGF", "T_EGT_MIN_DEGF", "T_EGT_MAX_DEGF", "T_EGT_SPREAD_DEGF")
                    DeletableTInletChCtrl = New DeletableChannelController(Me, RealNumberOfTInletProbe, MaxNumberOfTInletProbe, MaxNumberOfTInletProbe, "T_INLET", "_DEGF", "_DELETE_BTN", "T_INLET_AVG_DEGF", "T_INLET_MIN_DEGF", "T_INLET_MAX_DEGF", "T_INLET_SPREAD_DEGF")

                    FlowmeterCtrl = New FlowmeterController(Me)

                    'Configuring ECS Control
                    ECSCtrl = New ECSController(Me, 0, 10, 0, "ECS_BTN", "ECS_DEMAND", "ECS_UP_DEMAND_BTN", "ECS_DOWN_DEMAND_BTN", ECS_Display)
                    ECSCtrl.Memorize = False
                    ECSCtrl.Enable = False

                    If CELProject.EngineModel = "TSCP700-4B" Or CELProject.EngineModel = "TSCP700-5" Then

                        StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_CURRENT_AMP", "STARTER_CURRENT_MAX_AMP", "START_BTN")
                        StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_VOLTAGE_VDC", "STARTER_VOLTAGE_MAX_VDC", "START_BTN")

                        StartMaxETCRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_ETC_AVG_DEGF", "START_MAX_ETC_DEGF", "START_BTN", "N2_95_IND")
                        StartMaxEGTRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_EGT_AVG_DEGF", "START_MAX_EGT_DEGF", "START_BTN", "N2_95_IND")

                    ElseIf CELProject.EngineModel = "TSCP700-4E" Then

                        StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_CURRENT_AMP", "STARTER_CURRENT_MAX_AMP", "RUN_STOP_BTN")
                        StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_VOLTAGE_VDC", "STARTER_VOLTAGE_MAX_VDC", "RUN_STOP_BTN")

                        StartMaxETCRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_ETC_AVG_DEGF", "START_MAX_ETC_DEGF", "RUN_STOP_BTN", "N2_95_IND")
                        StartMaxEGTRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_EGT_AVG_DEGF", "START_MAX_EGT_DEGF", "RUN_STOP_BTN", "N2_95_IND")

                    End If

                    POilGbBreatherMaxPressureRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "P_OIL_GB_BREATHER_INHGG", "P_OIL_GB_BREATHER_MAX_INHGG", "P_OIL_GB_BREATHER_MAX_RESET_BTN")

                    StartTimerCtrl = New TimerController(Me, "STARTING_TIME_START_CONDITION_LATCH", "STARTING_TIME_STOP_CONDITION_LATCH", "STARTING_TIME_CONDITION_RESET", "STARTING_TIME_SEC", Nothing, 0, "NONE")

                    'Configuring Load Bank Control
                    Dim myLBData As LoadBankController.LB_DataInfo

                    myLBData.FanEnableChannelName = "LB1_FAN_ENABLE_CMD"
                    myLBData.FanEnableBtnChannelName = "LB1_FAN_ENABLE_BTN"
                    myLBData.EnableChannelName = "LB_LOAD_BTN"
                    myLBData.DemandChannelName = "LB1_DEMAND"
                    myLBData.UpDemandChannelName = "LB1_UP_DEMAND_BTN"
                    myLBData.DownDemandChannelName = "LB1_DOWN_DEMAND_BTN"
                    myLBData.DemandChannelIncrementName = "LB1_DEMAND_INCREMENT"
                    myLBData.FrameName = "TSCP700_Screen.fraControlSystem.fraLoadBankControl"
                    myLBData.DisplayName = "dspLB_DEMAND"
                    myLBData.ThreadSpeedMsec = 250 'msec
                    myLBData.Maximum = 100
                    myLBData.DelestageKwpersec = 10 '10 kW/sec delestage
                    myLBData.FanCoolDownSeconds = 300
                    myLBData.Memorize = False
                    myLBData.Increment = 1
                    myLBData.InitialDemandChannelName = Nothing
                    myLBData.BtnLatchSeconds = 0
                    myLBData.FanEnableChannelPulseName = Nothing
                    myLBData.FanStopChannelPulseName = Nothing
                    myLBData.PulseEnableInitialType = False
                    myLBData.PulseStopInitialType = False

                    If CELProject.Project.Number = "12917" Then 'Value Specific to the Revima project

                        myLBData.FieldFlashingTimeMsec = 1000
                        myLBData.FieldFlashingSignalName = "FIELD_FLASHING"
                        myLBData.FieldFlashingTriggerSignalName = "LB_GCU_BTN"

                    Else
                        myLBData.FieldFlashingTimeMsec = 0  'no field flashing
                        myLBData.FieldFlashingSignalName = Nothing
                        myLBData.FieldFlashingTriggerSignalName = Nothing

                    End If


                    LoadBankCtrl = New LoadBankController(myLBData)

                    'Configuring Load Bank Stage Values
                    LoadBankCtrl.AddStage(1, "LB1_1")
                    LoadBankCtrl.AddStage(2, "LB1_2")
                    LoadBankCtrl.AddStage(4, "LB1_3")
                    LoadBankCtrl.AddStage(7, "LB1_4")
                    LoadBankCtrl.AddStage(9, "LB1_5")
                    LoadBankCtrl.AddStage(9, "LB1_6")
                    LoadBankCtrl.AddStage(22, "LB1_7")
                    LoadBankCtrl.AddStage(44, "LB1_8")
                    LoadBankCtrl.AddStage(99, "LB1_9")
                    LoadBankCtrl.AddStage(99, "LB1_10")
                    LoadBankCtrl.AddStage(99, "LB1_11")
                    LoadBankCtrl.AddCurrentPhases("LB1_CURRENT_IA", "LB1_CURRENT_IB", "LB1_CURRENT_IC", 20)
                    LoadBankCtrl.AddVoltagePhases("LB1_VOLTAGE_VAB", "LB1_VOLTAGE_VBC", "LB1_VOLTAGE_VCA", 20)
                    LoadBankCtrl.StartWorkerThread(250)


                    CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.Init_Engine_Controls))

                    'Add Handlers

                    If CELProject.EngineModel = "TSCP700-4E" Then
                        AddHandler ARINC_ECU_STATUS_VALUE.ValueChanged, AddressOf OnArincValueChange
                        AddHandler ARINC_FAULT_RECORDS_VALUE.ValueChanged, AddressOf OnArincValueChange
                        AddHandler ARINC_HISTORY_SHUTDOWN_VALUE.ValueChanged, AddressOf OnArincValueChange
                        AddHandler ARINC_N1_SPEED_SELECT_VALUE.ValueChanged, AddressOf OnArincValueChange
                        AddHandler ARINC_SHUTDOWN_VALUE.ValueChanged, AddressOf OnArincValueChange
                        AddHandler ARINC_START_INHIBIT_STATUS_VALUE.ValueChanged, AddressOf OnArincValueChange
                        AddHandler ARINC_TRANSMIT_RECORD_NUMBER_VALUE.ValueChanged, AddressOf OnArincValueChange
                    End If

                    AddHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnClose_Test
                    AddHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
                    AddHandler CELProject.PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
                    AddHandler CELProject.PERF_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnPERF_OPEN_WINDOW_BTN
                    AddHandler CELProject.PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN
                    AddHandler N2_95_IND.ValueChanged, AddressOf OnAcceleratingTime_Calc
                    AddHandler PERF_PRESERVATION_YES.ValueChanged, AddressOf OnPERFPreservationYesCheckBox
                    AddHandler PERF_PRESERVATION_NO.ValueChanged, AddressOf OnPERFPreservationNoCheckBox
                    AddHandler CELProject.PERF_TEST_RESULT_ACCEPTED.ValueChanged, AddressOf OnPERFTestResultAcceptedCheckBox
                    AddHandler CELProject.PERF_TEST_RESULT_REJECTED.ValueChanged, AddressOf OnPERFTestResultRejectedCheckBox
                    AddHandler TestStep_List.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged

                    Me.DuctDiameter_Inches = CELProject.Test_Mgr_UUT_Calib_Constant(0).Value.ToDouble()
                    Me.OrificeDiameter_Inches = CELProject.Test_Mgr_UUT_Calib_Constant(1).Value.ToDouble()

                    MyBase.StartWorkingThread()

                    TestProgress_Initialize()

                End If
            Catch ex As Exception
                MessageBox.Show("OnTestSessionRunning: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Private Function Init_Engine_Channels() As Boolean

            Dim Return_Value As New ArrayList()

            Return_Value.Clear()

            Try
                'Initialise Common Engine Channels
                If CELProject.EngineModel = "TSCP700-4E" Then
                    Return_Value.Add(MyBase.InitializeChannel(ARINC_ECU_STATUS_TEXT, "ARINC_ECU_STATUS_TEXT"))
                    Return_Value.Add(MyBase.InitializeChannel(ARINC_ECU_STATUS_VALUE, "A429IN_STATUS_WORD_SDI15_11_14"))
                    Return_Value.Add(MyBase.InitializeChannel(ARINC_FAULT_RECORDS_TEXT, "ARINC_FAULT_RECORDS_TEXT"))
                    Return_Value.Add(MyBase.InitializeChannel(ARINC_FAULT_RECORDS_VALUE, "A429IN_FAULT_HISTORY_WORD_1_SDI15_11_13"))
                    Return_Value.Add(MyBase.InitializeChannel(ARINC_HISTORY_SHUTDOWN_TEXT, "ARINC_HISTORY_SHUTDOWN_TEXT"))
                    Return_Value.Add(MyBase.InitializeChannel(ARINC_HISTORY_SHUTDOWN_VALUE, "A429IN_FAULT_HISTORY_WORD_1_SDI15_17_21"))
                    Return_Value.Add(MyBase.InitializeChannel(ARINC_N1_SPEED_SELECT_TEXT, "ARINC_N1_SPEED_SELECT_TEXT"))
                    Return_Value.Add(MyBase.InitializeChannel(ARINC_N1_SPEED_SELECT_VALUE, "A429IN_N1_SPEED_SELECT"))
                    Return_Value.Add(MyBase.InitializeChannel(ARINC_SHUTDOWN_TEXT, "ARINC_SHUTDOWN_TEXT"))
                    Return_Value.Add(MyBase.InitializeChannel(ARINC_SHUTDOWN_VALUE, "A429IN_MAINTENANCE_WORD_4_SDI15_11_15"))
                    Return_Value.Add(MyBase.InitializeChannel(ARINC_START_INHIBIT_STATUS_TEXT, "ARINC_START_INHIBIT_STATUS_TEXT"))
                    Return_Value.Add(MyBase.InitializeChannel(ARINC_START_INHIBIT_STATUS_VALUE, "A429IN_STATUS_WORD_SDI15_26_29"))
                    Return_Value.Add(MyBase.InitializeChannel(ARINC_TRANSMIT_RECORD_NUMBER_TEXT, "ARINC_TRANSMIT_RECORD_NUMBER_TEXT"))
                    Return_Value.Add(MyBase.InitializeChannel(ARINC_TRANSMIT_RECORD_NUMBER_VALUE, "A429IN_FAULT_HISTORY_WORD_1_SDI15_14_16"))
                End If

                Return_Value.Add(MyBase.InitializeChannel(BLEED_BTN, "BLEED_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(DELPB, "DELPB"))
                Return_Value.Add(MyBase.InitializeChannel(DELPB2, "DELPB2"))
                Return_Value.Add(MyBase.InitializeChannel(DELTB, "DELTB"))
                Return_Value.Add(MyBase.InitializeChannel(DELTB2, "DELTB2"))
                Return_Value.Add(MyBase.InitializeChannel(DELWB, "DELWB"))
                Return_Value.Add(MyBase.InitializeChannel(DELWB2, "DELWB2"))
                Return_Value.Add(MyBase.InitializeChannel(FUEL_USED_INITIAL_LITERS, "FUEL_USED_INITIAL_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(FUEL_USED_TOTAL_LITERS, "FUEL_USED_TOTAL_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(FM_INITIAL_VOLUME_LITERS, "FM_INITIAL_VOLUME_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(FM_TOTAL_VOLUME_LITERS, "FM_TOTAL_VOLUME_LITERS"))

                If CELProject.EngineModel = "TSCP700-4B" Or CELProject.EngineModel = "TSCP700-5" Then

                    Return_Value.Add(MyBase.InitializeChannel(Log_Perf_APU_RUN_In_Check, "Log_Perf_APU_RUN_In_Check"))
                    Return_Value.Add(MyBase.InitializeChannel(Log_Perf_Oil_Consumtion_Check, "Log_Perf_Oil_Consumtion_Check"))
                    Return_Value.Add(MyBase.InitializeChannel(Log_Perf_OIL_Filter_Check, "Log_Perf_OIL_Filter_Check"))
                    Return_Value.Add(MyBase.InitializeChannel(Log_Perf_OIL_Level_Sensor_Check, "Log_Perf_OIL_Level_Sensor_Check"))

                ElseIf CELProject.EngineModel = "TSCP700-4E" Then

                    Return_Value.Add(MyBase.InitializeChannel(Log_Perf_Engine_RUN_In_Check, "Log_Perf_Engine_RUN_In_Check"))
                    Return_Value.Add(MyBase.InitializeChannel(Log_Perf_Oil_Consumtion_Check, "Log_Perf_Oil_Consumtion_Check"))
                    Return_Value.Add(MyBase.InitializeChannel(Log_Perf_OIL_Level_Sensor_Check, "Log_Perf_OIL_Level_Sensor_Check"))
                    Return_Value.Add(MyBase.InitializeChannel(Log_Perf_Magnetic_Chip_Detector_Check, "Log_Perf_Magnetic_Chip_Detector_Check"))
                    Return_Value.Add(MyBase.InitializeChannel(Log_Perf_Start_Tests_Check, "Log_Perf_Start_Tests_Check"))
                    Return_Value.Add(MyBase.InitializeChannel(Log_Perf_Test_100_MES_Check, "Log_Perf_Test_100_MES_Check"))
                    Return_Value.Add(MyBase.InitializeChannel(Log_Perf_VTN_Check, "Log_Perf_VTN_Check"))

                Else
                    MessageBox.Show("Init_Egine_Channels: Engine Model Not supported", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                End If

                Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_DELPB, "LOG_PERF_DELPB"))
                Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_DELPB2, "LOG_PERF_DELPB2"))
