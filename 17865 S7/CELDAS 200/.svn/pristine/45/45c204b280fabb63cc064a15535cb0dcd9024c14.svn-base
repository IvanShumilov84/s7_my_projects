    Public Class TSCP700_Sequence
        Inherits CEL.KineticaRT.Sequence.Sequence

        Private CELProject As CELDAS = CELDAS.Instance()

        Private Const MaxNumberOfTBleedProbe As Integer = 4
        Private Const MaxNumberOfTEgtProbe As Integer = 18
        Private Const MaxNumberOfTInletProbe As Integer = 4

        Private Enum eTestStepTSCP700_GARUDA
            RUN_IN_IDLE = 0
            GENERATOR_LOAD = 1
            STANDBY = 2
            MES_PERFORMANCE = 3
            ECS = 4
            ZERO_LOAD = 5
            FINAL_DATA = 6
        End Enum

        'See OnTestStep_List_SelectedIndexChanged to make sure test step number is manage with standby step with TSCP700-4B/5
        Private Enum eTestStepTSCP700_REVIMA
            NO_LOAD = 0
            COMBINATION_LOAD = 1
            MES = 2
            STANDBY = 3
            FINAL_DATA = 4
        End Enum


        Private ReadOnly Property EngineConfiguration() As EngineInformationItem
            Get
                Return UsingConfigurationManager.engineInfoCollection.Item(CELProject.EngineModel)
            End Get
        End Property

        Private Sub Compute_TSCP700(ByVal CalculateForLogAndPerformanceReports As Boolean)

            Try
                If CalculateForLogAndPerformanceReports Then

                    LOG_PERF_WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(LOG_PERF_T_ORIFICE_DEGF.Value.ToDouble(), _
                                                                                               LOG_PERF_P_ORIFICE_PSIA.Value.ToDouble(), _
                                                                                               LOG_PERF_P_ORIFICE_DELTA_PSID.Value.ToDouble))

                    Compute_TSCP700_Perf(LOG_PERF_T_INLET_AVG_DEGF, _
                                            LOG_PERF_N1, _
                                            LOG_PERF_DELWB, _
                                            LOG_PERF_DELPB, _
                                            LOG_PERF_DELTB, _
                                            LOG_PERF_T_UNIT_EGT_SOURCE_DEGF, _
                                            LOG_PERF_DELWB2, _
                                            LOG_PERF_DELPB2, _
                                            LOG_PERF_DELTB2)

                    FlowmeterCtrl.ComputeFlow(True)

                    'IMPORTANT: Toutes les variables flottantes telles que WB_CALC, DELPB, LB_DEMAND dont la source et la destination sont vides doivent
                    'manuellement être updaté pour être inscrite dans le LOG ou le PERF report.
                Else

                    WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(T_ORIFICE_DEGF.Value.ToDouble(), _
                                                                                      P_ORIFICE_PSIA.Value.ToDouble(), _
                                                                                      P_ORIFICE_DELTA_PSID.Value.ToDouble))
                    Compute_TSCP700_Perf(T_INLET_AVG_DEGF, _
                                            N1, _
                                            DELWB, _
                                            DELPB, _
                                            DELTB, _
                                            T_UNIT_EGT_SOURCE_DEGF, _
                                            DELWB2, _
                                            DELPB2, _
                                            DELTB2)
                End If

            Catch ex As Exception
                MessageBox.Show("Compute_TSCP700" + ex.ToString(), "Error")
            End Try

        End Sub

        Private Sub Compute_TSCP700_Perf(ByRef tinlet_degf_avg As IChannel, _
                                          ByRef n1 As IChannel, _
                                          ByRef del_wb As IChannel, _
                                          ByRef del_pb As IChannel, _
                                          ByRef del_tb As IChannel, _
                                          ByRef unit_egt As IChannel, _
                                          ByRef del_wb2 As IChannel, _
                                          ByRef del_pb2 As IChannel, _
                                          ByRef del_tb2 As IChannel)
            Try
                Dim TestStep As Integer = CELProject.PERF_TEST_STEP_NB.Value.ToDouble()

                unit_egt.Value = CELProject.Interpolate_1D(tinlet_degf_avg.Value.ToDouble, TSCP700_TTI, 4)

                PerfCalcOutsideRange = False

                If (TestStep = eTestStepTSCP700_REVIMA.COMBINATION_LOAD And CELProject.Project.Number = "12917") Or (TestStep = eTestStepTSCP700_GARUDA.ECS And CELProject.Project.Number = "10726") Then
                    del_wb.Value = CELProject.Interpolate_1D(tinlet_degf_avg.Value.ToDouble, TSCP700_TTI, 1)
                    del_pb.Value = CELProject.Interpolate_1D(tinlet_degf_avg.Value.ToDouble, TSCP700_TTI, 2)
                    del_tb.Value = CELProject.Interpolate_1D(tinlet_degf_avg.Value.ToDouble, TSCP700_TTI, 3)

                    Dim N1Speed = n1.Value.ToDouble()

                    If N1Speed < TSCP700_N1(0, 0) Then ' N1 speed lower than first data in the table
                        PerfCalcOutsideRange = True
                        del_wb2.Value = New KineticaRT.Values.Double(TSCP700_N1(0, 1))
                        del_pb2.Value = New KineticaRT.Values.Double(TSCP700_N1(0, 2))
                        del_tb2.Value = New KineticaRT.Values.Double(TSCP700_N1(0, 3))

                    ElseIf N1Speed > TSCP700_N1(TSCP700_N1.GetUpperBound(0), 0) Then 'N1 speed higher than last data in the table
                        PerfCalcOutsideRange = True
                        del_wb2.Value = New KineticaRT.Values.Double(TSCP700_N1(TSCP700_N1.GetUpperBound(0), 1))
                        del_pb2.Value = New KineticaRT.Values.Double(TSCP700_N1(TSCP700_N1.GetUpperBound(0), 2))
                        del_tb2.Value = New KineticaRT.Values.Double(TSCP700_N1(TSCP700_N1.GetUpperBound(0), 3))

                    Else 'N1 speed is in the table
                        del_wb2.Value = CELProject.Interpolate_1D(N1Speed, TSCP700_N1, 1)
                        del_pb2.Value = CELProject.Interpolate_1D(N1Speed, TSCP700_N1, 2)
                        del_tb2.Value = CELProject.Interpolate_1D(N1Speed, TSCP700_N1, 3)
                    End If

                Else
                    del_wb.Value = Values.NaN
                    del_pb.Value = Values.NaN
                    del_tb.Value = Values.NaN

                    del_wb2.Value = Values.NaN
                    del_pb2.Value = Values.NaN
                    del_tb2.Value = Values.NaN
                End If


            Catch Ex As Exception
                MessageBox.Show("Compute_TSCP700_Perf: " & Ex.ToString())
            End Try

        End Sub

        Private Sub ValidateFMInitialValue()

            Try

                'Read the mass flow meter value, the value cannot be 0
                If FM_INITIAL_VOLUME_LITERS.Value.ToDouble() = 0.0 Then
                    FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())
                End If

            Catch Ex As Exception
                MessageBox.Show("ValidateFMInitialValue: " & Ex.ToString())
            End Try

        End Sub

       Private Sub GarudaWriteRunningTime(ByVal excelSheets As Excel.Sheets)

            Try
                Dim excelWorksheet As Excel.Worksheet = excelSheets.Item("APU CONDITION TEST SHEET")

                Dim FuelUsed As Double = LOG_PERF_FUEL_USED_TOTAL_LITERS.Value.ToDouble()
                Dim OperatingTime As Double = LOG_PERF_OPERATING_TIME_CURRENT_MINUTES.Value.ToDouble()

                'Running Time, cellule I8
                excelWorksheet.Cells(8, 9).Value = OperatingTime.ToString(LOG_PERF_OPERATING_TIME_CURRENT_MINUTES.Format) + " " + LOG_PERF_OPERATING_TIME_CURRENT_MINUTES.Units.ToString()

                'Fuel Used, cellule I11
                excelWorksheet.Cells(11, 9).NumberFormat = "@"
                excelWorksheet.Cells(11, 9).Value = FuelUsed.ToString(LOG_PERF_FUEL_USED_TOTAL_LITERS.Format) + " " + LOG_PERF_FUEL_USED_TOTAL_LITERS.Units.ToString()

            Catch Ex As Exception
                MessageBox.Show("GarudaWriteRunningTime: " & Ex.ToString())
            End Try
        End Sub

       Private Sub GarudaWriteCommonDataForApuConditionTestSheet(ByVal excelSheets As Excel.Sheets, ByVal Column As Integer, ByVal Page As Integer)

