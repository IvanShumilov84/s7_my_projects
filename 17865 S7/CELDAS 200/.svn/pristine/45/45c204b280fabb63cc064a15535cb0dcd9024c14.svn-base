                Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WB_CALC, "LOG_PERF_WB_CALC"))
                Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WBCOR_PPM, "LOG_PERF_WBCOR_PPM"))
                Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WF_AVG_PPH, "LOG_PERF_WF_AVG_PPH"))
                Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WFCOR_PPH, "LOG_PERF_WFCOR_PPH"))

                Return_Value.Add(MyBase.InitializeChannel(N1, "N1"))
                Return_Value.Add(MyBase.InitializeChannel(N2_95_IND, "N2_95_IND"))
                Return_Value.Add(MyBase.InitializeChannel(NUMBER_OF_STARTS, "NUMBER_OF_STARTS"))
                Return_Value.Add(MyBase.InitializeChannel(P_ORIFICE_PSIA, "P_ORIFICE_PSIA"))
                Return_Value.Add(MyBase.InitializeChannel(P_ORIFICE_DELTA_PSID, "P_ORIFICE_DELTA_PSID"))
                Return_Value.Add(MyBase.InitializeChannel(PBCOR_PERF_MIN_INHGA, "PBCOR_PERF_MIN_INHGA"))
                Return_Value.Add(MyBase.InitializeChannel(PERF_PRESERVATION_YES, "PERF_PRESERVATION_YES"))
                Return_Value.Add(MyBase.InitializeChannel(PERF_PRESERVATION_NO, "PERF_PRESERVATION_NO"))
                Return_Value.Add(MyBase.InitializeChannel(PERF_PRESERVATION_MONTH, "PERF_PRESERVATION_MONTH"))
                Return_Value.Add(MyBase.InitializeChannel(START_MAX_EGT_DEGF, "START_MAX_EGT_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(START_MAX_ETC_DEGF, "START_MAX_ETC_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(STARTING_TIME_SEC, "STARTING_TIME_SEC"))
                Return_Value.Add(MyBase.InitializeChannel(T_INLET_AVG_DEGF, "T_INLET_AVG_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(T_ORIFICE_DEGF, "T_ORIFICE_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(T_UNIT_EGT_SOURCE_DEGF, "T_UNIT_EGT_SOURCE_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(TBCOR_PERF_MAX_DEGF, "TBCOR_PERF_MAX_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(WB_CALC, "WB_CALC"))
                Return_Value.Add(MyBase.InitializeChannel(WBCOR_PERF_MIN_PPM, "WBCOR_PERF_MIN_PPM"))

                Return_Value.Add(MyBase.InitializeChannel(OPERATING_TIME_CURRENT_SEC, "OPERATING_TIME_CURRENT_SEC"))

                Return_Value.Add(MyBase.InitializeObject(Test_Step_Frame, CELProject.EngineFamily.Replace("-", "_") + "_Screen.fraControl"))
                Return_Value.Add(MyBase.InitializeObject(Ctrl_System_Frame, CELProject.EngineFamily.Replace("-", "_") + "_Screen.fraControlSystem"))

                ECS_Frame = Ctrl_System_Frame.FindObject("fraECS")
                ECS_Display = ECS_Frame.FindObject("dspECS_DEMAND")

                If ECS_Display Is Nothing Then
                    MessageBox.Show("MyBase.InitializeObject - dspECS Is Nothing")
                    Return_Value.Add(False)
                Else
                    Return_Value.Add(True)
                End If

                TestStep_List = Test_Step_Frame.FindObject("TestStep_List")

                If TestStep_List Is Nothing Then
                    MessageBox.Show("MyBase.InitializeObject - TestStep_List Is Nothing")
                    Return_Value.Add(False)
                Else
                    Return_Value.Add(True)
                End If

            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.ToString())
                Return_Value.Add(False)
            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function

        Private Sub TestProgress_Initialize()
            Dim dataInfo As CEL.TestProgress.TestProgressMgr.TestProgress_DataInfo

            If CELProject.EngineModel = "TSCP700-4E" Then
                dataInfo.EngineStartEventChannelName = "RUN_STOP_BTN"
                dataInfo.EngineStartEventChannelValue = True
            Else
                dataInfo.EngineStartEventChannelName = "START_BTN"
                dataInfo.EngineStartEventChannelValue = True
            End If
            dataInfo.EngineStartEventDescription = "Mise en route"
            dataInfo.EngineStartEventRecordTime = True
            dataInfo.EngineStopEventChannelName = "RUN_STOP_BTN"
            dataInfo.EngineStopEventChannelValue = False
            dataInfo.EngineStopEventDescription = "Arrêt moteur - Temps d'arrêt (s): "
            dataInfo.EngineStopEventRecordTime = True
            dataInfo.TestProgressFrameName = CELProject.EngineFamily.Replace("-", "_") + "_Screen.fraTestProgressHorizontal"
            dataInfo.TestProgressSheetFileName = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
            dataInfo.UUTModel = CELProject.EngineModel
            dataInfo.UUTSerialNumber = Me.UserInputsRevima.EngineSerialNumber
            dataInfo.UUTWorkOrder = Me.UserInputsRevima.WorkOrder
            Me.TestProgressMgr = New CEL.TestProgress.TestProgressMgr(dataInfo)
        End Sub

       
        Private Sub TestProgress_RecordPerfStep(stepName As String, correction As Boolean)
            If Not Me.TestProgressMgr Is Nothing Then
                Dim checkItemPBCor As String = "Corrected Bleed Air Pressure: - Min: " + _
                    PBCOR_PERF_MIN_INHGA.Value.ToString(PBCOR_PERF_MIN_INHGA.Format, Nothing) + " Read: " + _
                    LOG_PERF_PBCOR_INHGA.Value.ToString(Me.LOG_PERF_PBCOR_INHGA.Format, Nothing) + " inHgA"
                Dim checkItemTBCor As String = "Corrected Bleed Air Temperature: - Max: " + _
                    TBCOR_PERF_MAX_DEGF.Value.ToString(TBCOR_PERF_MAX_DEGF.Format, Nothing) + " Read: " + _
                    LOG_PERF_TBCOR_DEGF.Value.ToString(LOG_PERF_TBCOR_DEGF.Format, Nothing) + " °F"
                Dim checkItemWBCor As String = "Corrected Bleed Air Flow: - Min: " + _
                    WBCOR_PERF_MIN_PPM.Value.ToString(WBCOR_PERF_MIN_PPM.Format, Nothing) + " Read: " + _
                    LOG_PERF_WBCOR_PPM.Value.ToString(LOG_PERF_WBCOR_PPM.Format, Nothing) + " lb/min"
                Dim checkItemWFCor As String = "Corrected Fuel Flow: - Read: " + Me.LOG_PERF_WFCOR_PPH.Value.ToString(Me.LOG_PERF_WFCOR_PPH.Format, Nothing) + " lb/hr"

                If correction Then
                    Me.TestProgressMgr.AddTestProgressEntry( _
                        New CEL.TestProgress.TestProgressSheetEntry(String.Empty, stepName, {checkItemPBCor, checkItemTBCor, checkItemWBCor, checkItemWFCor}))
                Else
                    Me.TestProgressMgr.AddTestProgressEntry( _
                        New CEL.TestProgress.TestProgressSheetEntry(String.Empty, stepName, {checkItemWFCor}))
                End If
            End If
        End Sub

        Private Sub TestProgress_Save()
            If Not Me.TestProgressMgr Is Nothing Then
                TestProgress_UpdateProgressSheetHeader(Me.TestProgressMgr.TestProgressSheet)
                Dim fileName As String = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
                Dim settings As Xml.XmlWriterSettings = New Xml.XmlWriterSettings()
                settings.Indent = True

                Using writer As Xml.XmlWriter = Xml.XmlWriter.Create(fileName, settings)
                    Dim xslPath As String = "type=""text/xsl"" href=""" + Application.StartupPath + "/TestProgressSheet.xsl"""
                    writer.WriteProcessingInstruction("xml-stylesheet", xslPath)
                    Dim ser As New Xml.Serialization.XmlSerializer(GetType(CEL.TestProgress.TestProgressSheet))
                    ser.Serialize(writer, Me.TestProgressMgr.TestProgressSheet)
                End Using
            End If
        End Sub

        Private Sub TestProgress_UpdateProgressSheetHeader(progressSheet As CEL.TestProgress.TestProgressSheet)
            progressSheet.Header("No capteur de vibration turbine") = Me.UserInputsRevima.TurbineVibPickupSerialNumber
            progressSheet.Header("No capteur de vibration accessoire") = Me.UserInputsRevima.GearboxVibPickupSerialNumber
            progressSheet.Header("No Capt. frein") = Me.UserInputsRevima.LoadCellSN
            progressSheet.Header("Type d'huile") = Me.UserInputsRevima.OilType
            progressSheet.Header("Quantité totale Jet A1") = Me.FUEL_USED_TOTAL_LITERS.Value.ToString()
            Dim runningTime As System.TimeSpan = System.TimeSpan.FromSeconds(Me.OPERATING_TIME_CURRENT_SEC.Value.ToDouble())
            progressSheet.Header("Temps de fonctionnement") = Math.Floor(runningTime.TotalHours).ToString() + _
                " h " + runningTime.Minutes.ToString("00")
        End Sub

