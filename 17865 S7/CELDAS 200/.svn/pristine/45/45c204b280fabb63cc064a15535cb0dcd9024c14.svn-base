        'Use Delegate for Cross Thread Operation
        Private Delegate Sub SetTestStepListDelegate(ByVal value As Integer)
        Private Sub SetTestStepList(ByVal value As Integer)

            If (Me.TestStep_List.InvokeRequired) Then
                Me.TestStep_List.BeginInvoke(New SetTestStepListDelegate(AddressOf Me.SetTestStepList), value)
            Else
                TestStep_List.Items.Clear()
                TestStep_List.Items.Add("NO LOAD")
                TestStep_List.Items.Add("COMBINATION LOAD")
                TestStep_List.Items.Add("MES")
                If CELProject.EngineModel = "TSCP700-4B" Or CELProject.EngineModel = "TSCP700-5" Then
                    TestStep_List.Items.Add("STANDBY")
                End If
                TestStep_List.Items.Add("FINAL DATA")
                TestStep_List.SelectedIndex = value

            End If
        End Sub

        Public Function CreateCustomHeaderLogFile(ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Try
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Date Time:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Cond#:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Comment:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                ExcelWorksheet.Rows(RowIndex).RowHeight = 65.25
                ExcelWorksheet.Rows(RowIndex).VerticalAlignment = Excel.XlVAlign.xlVAlignTop
                ExcelWorksheet.Rows(RowIndex).WrapText = True

                Return True

            Catch ex As Exception
                MessageBox.Show("CreateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        Public Function UpdateCustomHeaderLogFile(ByVal AppendOption As Boolean, ByVal IsPerfEntry As Boolean, ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Try
                Dim Log_Condition As Integer

                If AppendOption = False Then
                    Log_Condition = 1
                Else
                    Log_Condition = ExcelWorksheet.Cells(RowIndex + 1, ExcelWorksheet.Columns.Count).End(Excel.XlDirection.xlToLeft).Column - 1
                    Log_Condition = Log_Condition + 1

                End If

                If ((Log_Condition > 1) And ((Log_Condition Mod 5) = 1)) Then

                    'Repeat The Test Spec For this new sets of condition

                    With ExcelWorksheet
                        .Range(.Cells(2, 2), .Cells(RowIndex - 2, 6)).Copy(.Cells(2, Log_Condition + 1))
                    End With
                End If

                ColumnIndex = 1 + Log_Condition

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Format(Now, "yyyy/MM/dd HH:mm:ss")
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Log_Condition.ToString()
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                If IsPerfEntry = False Then
                    Dim CommentText As String = ""
                    Dim InputObject As New InputCommentForm
                    InputObject.ShowDialog("Log Report", "Comment:", "", CommentText)

                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = CommentText
                Else
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "STEP: " & TestStep_List.SelectedItem
                End If

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 2
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Values"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignCenter

            Catch ex As Exception
                MessageBox.Show("UpdateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        Protected Overrides Sub OnEngineWorkingThread()

            Compute_TSCP700(False)

            'Make sure FM_INITIAL_VOLUME_LITERS is different than 0
            ValidateFMInitialValue()

            'Persistent Values Save Check
            PersistentValuesCtrl.SavePersistentValues()

            StartTimerCtrl.Timer()

        End Sub

        Private Function Compute_BleedAirFlow(ByVal TOrifice_DEGF As Double, _
                                              ByVal POrifice_PSIA As Double, _
                                              ByVal POrificeDelta_PSID As Double) As Double
            Try

                If CELProject.IsTrue(BLEED_BTN.Value) Then

                    Dim BleedAirFLow As Double = CELProject.GetBleedAirFlow( _
                                                                            EngineConfiguration.DuctDiameter, _
                                                                            EngineConfiguration.DuctDiameterUnit, _
                                                                            EngineConfiguration.OrificeDiameter, _
                                                                            EngineConfiguration.OrificeDiameterUnit, _
                                                                            TOrifice_DEGF, _
                                                                            CELDAS.eTemperature.Fahrenheit, _
                                                                            POrifice_PSIA, _
                                                                            CELDAS.ePressure.PSI, _
                                                                            POrificeDelta_PSID, _
                                                                            CELDAS.ePressure.PSI, _
                                                                            EngineConfiguration.OrificeThinkness, _
                                                                            EngineConfiguration.OrificeThinknessUnit, _
                                                                            EngineConfiguration.TapArrangement, _
                                                                            CELDAS.eFlowMass.LbByMin)

                    Return BleedAirFLow

                Else
                    Return 0.0
                End If

            Catch Ex As Exception
                'Log error
                MessageBox.Show("Error in Engine_Sequence.Compute_BleedAirFlow: " & Ex.ToString)
            End Try

        End Function

        Private Sub OnAcceleratingTime_Calc(ByVal sender As IChannel, ByVal newVal As Value)
            Try

                If (sender.Name = "N2_95_IND") Then
                    If CELProject.IsTrue(newVal) Then
                        NUMBER_OF_STARTS.Value = New KineticaRT.Values.Double(NUMBER_OF_STARTS.Value.ToDouble + 1)
                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("OnAcceleratingTime_Calc: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

         Private Sub OnClose_Test(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    MyBase.StopWorkingThread()

                    'Persistent Values Force Save
                    PersistentValuesCtrl.SavePersistentValues(True)

                    If Not (ARINC_ECU_STATUS_VALUE Is Nothing) Then
                        RemoveHandler ARINC_ECU_STATUS_VALUE.ValueChanged, AddressOf OnArincValueChange
                    End If

                    If Not (ARINC_FAULT_RECORDS_VALUE Is Nothing) Then
                        RemoveHandler ARINC_FAULT_RECORDS_VALUE.ValueChanged, AddressOf OnArincValueChange
                    End If

                    If Not (ARINC_HISTORY_SHUTDOWN_VALUE Is Nothing) Then
                        RemoveHandler ARINC_HISTORY_SHUTDOWN_VALUE.ValueChanged, AddressOf OnArincValueChange
                    End If

                    If Not (ARINC_N1_SPEED_SELECT_VALUE Is Nothing) Then
                        RemoveHandler ARINC_N1_SPEED_SELECT_VALUE.ValueChanged, AddressOf OnArincValueChange
                    End If

                    If Not (ARINC_SHUTDOWN_VALUE Is Nothing) Then
                        RemoveHandler ARINC_SHUTDOWN_VALUE.ValueChanged, AddressOf OnArincValueChange
                    End If

                    If Not (ARINC_START_INHIBIT_STATUS_VALUE Is Nothing) Then
                        RemoveHandler ARINC_START_INHIBIT_STATUS_VALUE.ValueChanged, AddressOf OnArincValueChange
                    End If

                    If Not (ARINC_TRANSMIT_RECORD_NUMBER_VALUE Is Nothing) Then
                        RemoveHandler ARINC_TRANSMIT_RECORD_NUMBER_VALUE.ValueChanged, AddressOf OnArincValueChange
                    End If

                    If Not (CELProject.CLOSE_TEST_BTN Is Nothing) Then
                        RemoveHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnClose_Test
                    End If

                    If Not (CELProject.LOG_TAKE_POINT_BTN Is Nothing) Then
                        RemoveHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
                    End If

                    If Not (CELProject.PERF_CLOSE_WINDOW_BTN Is Nothing) Then
                        RemoveHandler CELProject.PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
                    End If

                    If Not (CELProject.PERF_OPEN_WINDOW_BTN Is Nothing) Then
                        RemoveHandler CELProject.PERF_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnPERF_OPEN_WINDOW_BTN
                    End If

                    If Not (CELProject.PERF_TAKE_POINT_BTN Is Nothing) Then
                        RemoveHandler CELProject.PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN
                    End If

                    If Not (N2_95_IND Is Nothing) Then
                        RemoveHandler N2_95_IND.ValueChanged, AddressOf OnAcceleratingTime_Calc
                    End If

                    If Not (DeletableTBleedChCtrl Is Nothing) Then
                        DeletableTBleedChCtrl.Dispose()
                    End If

                    If Not (DeletableTEgtChCtrl Is Nothing) Then
                        DeletableTEgtChCtrl.Dispose()
                    End If

                    If Not (DeletableTInletChCtrl Is Nothing) Then
                        DeletableTInletChCtrl.Dispose()
                    End If

                    If Not (LoadBankCtrl Is Nothing) Then
                        LoadBankCtrl.Dispose()
                    End If

                    If Not (PERF_PRESERVATION_YES Is Nothing) Then
                        RemoveHandler PERF_PRESERVATION_YES.ValueChanged, AddressOf OnPERFPreservationYesCheckBox
                    End If

                    If Not (PERF_PRESERVATION_NO Is Nothing) Then
                        RemoveHandler PERF_PRESERVATION_NO.ValueChanged, AddressOf OnPERFPreservationNoCheckBox
                    End If

                    If Not (CELProject.PERF_TEST_RESULT_ACCEPTED Is Nothing) Then
                        RemoveHandler CELProject.PERF_TEST_RESULT_ACCEPTED.ValueChanged, AddressOf OnPERFTestResultAcceptedCheckBox
                    End If

                    If Not (CELProject.PERF_TEST_RESULT_REJECTED Is Nothing) Then
                        RemoveHandler CELProject.PERF_TEST_RESULT_REJECTED.ValueChanged, AddressOf OnPERFTestResultRejectedCheckBox
                    End If

                    If Not (PersistentValuesCtrl Is Nothing) Then
                        PersistentValuesCtrl.Dispose()
                    End If

                    If Not (POilGbBreatherMaxPressureRecordCtrl Is Nothing) Then
                        POilGbBreatherMaxPressureRecordCtrl.Dispose()
                    End If

                    If Not (StarterMaxCurrentRecordCtrl Is Nothing) Then
                        StarterMaxCurrentRecordCtrl.Dispose()
                    End If

                    If Not (StarterMaxVoltageRecordCtrl Is Nothing) Then
                        StarterMaxVoltageRecordCtrl.Dispose()
                    End If

                    If Not (StartMaxETCRecordCtrl Is Nothing) Then
                        StartMaxETCRecordCtrl.Dispose()
                    End If

                    If Not (StartMaxEGTRecordCtrl Is Nothing) Then
                        StartMaxEGTRecordCtrl.Dispose()
                    End If

                    If Not (StartTimerCtrl Is Nothing) Then
                        StartTimerCtrl.Dispose()
                    End If

                    If Not (TestStep_List Is Nothing) Then
                        RemoveHandler TestStep_List.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged
                    End If

                End If

                If Not (FlowmeterCtrl Is Nothing) Then
                    FlowmeterCtrl.Dispose()
                End If

                CELProject.CLOSE_TEST_BTN.Value = Values.False

            Catch ex As Exception
                MessageBox.Show("OnClose_Test: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub OnArincValueChange(ByVal sender As IChannel, ByVal newVal As Value)

            Dim LocalIndex As Integer
            Dim WhichOne As Integer

            Try
                WhichOne = 0
                LocalIndex = ARINC_ECU_STATUS_VALUE.Value.ToDouble()
                WhichOne = 1

                If LocalIndex >= 0 And LocalIndex <= 15 Then
                    ARINC_ECU_STATUS_TEXT.Value = New KineticaRT.Values.Text(ECU_STATUS_CODE(LocalIndex))
                Else
                    ARINC_ECU_STATUS_TEXT.Value = New KineticaRT.Values.Text("Invalid value from ARINC")
                End If

                WhichOne = 2
                LocalIndex = ARINC_START_INHIBIT_STATUS_VALUE.Value.ToDouble()
                WhichOne = 3

                If LocalIndex >= 0 And LocalIndex <= 15 Then
                    ARINC_START_INHIBIT_STATUS_TEXT.Value = New KineticaRT.Values.Text(INHIBIT_CODE(LocalIndex))
                Else
                    ARINC_START_INHIBIT_STATUS_TEXT.Value = New KineticaRT.Values.Text("Invalid value from ARINC")
                End If

                WhichOne = 4
                LocalIndex = ARINC_N1_SPEED_SELECT_VALUE.Value.ToDouble()
                WhichOne = 5

                If LocalIndex >= 0 And LocalIndex <= 3 Then
                    ARINC_N1_SPEED_SELECT_TEXT.Value = New KineticaRT.Values.Text(N1_SPEED_SELECT_CODE(LocalIndex))
                Else
                    ARINC_N1_SPEED_SELECT_TEXT.Value = New KineticaRT.Values.Text("Invalid value from ARINC")
                End If

                WhichOne = 6
                LocalIndex = ARINC_FAULT_RECORDS_VALUE.Value.ToDouble()
                WhichOne = 7

                If LocalIndex >= 0 And LocalIndex <= 7 Then
                    ARINC_FAULT_RECORDS_TEXT.Value = New KineticaRT.Values.Text(FAULT_HISTORY_CODE(LocalIndex))
                Else
                    ARINC_FAULT_RECORDS_TEXT.Value = New KineticaRT.Values.Text("Invalid value from ARINC")
                End If

                WhichOne = 8
                LocalIndex = ARINC_TRANSMIT_RECORD_NUMBER_VALUE.Value.ToDouble()
                WhichOne = 9

                If LocalIndex >= 0 And LocalIndex <= 7 Then
                    ARINC_TRANSMIT_RECORD_NUMBER_TEXT.Value = New KineticaRT.Values.Text(TRANSMIT_CODE(LocalIndex))
                Else
                    ARINC_TRANSMIT_RECORD_NUMBER_TEXT.Value = New KineticaRT.Values.Text("Invalid value from ARINC")
                End If

                WhichOne = 10
                LocalIndex = ARINC_SHUTDOWN_VALUE.Value.ToDouble()
                WhichOne = 11

                If LocalIndex >= 0 And LocalIndex <= 31 Then
                    ARINC_SHUTDOWN_TEXT.Value = New KineticaRT.Values.Text(SHUTDOWN_CODE(LocalIndex))
                Else
                    ARINC_SHUTDOWN_TEXT.Value = New KineticaRT.Values.Text("Invalid value from ARINC")
                End If

                WhichOne = 12
                LocalIndex = ARINC_HISTORY_SHUTDOWN_VALUE.Value.ToDouble()
                WhichOne = 13

                If LocalIndex >= 0 And LocalIndex <= 31 Then
                    ARINC_HISTORY_SHUTDOWN_TEXT.Value = New KineticaRT.Values.Text(SHUTDOWN_CODE(LocalIndex))
                Else
                    ARINC_HISTORY_SHUTDOWN_TEXT.Value = New KineticaRT.Values.Text("Invalid value from ARINC")
                End If

            Catch ex As Exception
                MessageBox.Show("OnArincValueChange: (LocalIndex, WhichOne) = " & LocalIndex.ToString() & "  " & WhichOne.ToString() & vbCrLf & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub OnLOG_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    'Update the Log/Perf channel set
                    CELProject.LogPerfSynch.UpdateValues()

                    'Synchronize data for Log and Performance
                    Compute_TSCP700(True)

                    CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, False, CELProject.EngineModel, True)
                    CELProject.LOG_TAKE_POINT_BTN.Value = Values.False
                End If

            Catch Ex As Exception
                MessageBox.Show("OnLOG_TAKE_POINT_BTN: " & Ex.ToString())
            End Try
        End Sub
  
        Private Sub OnPERF_CLOSE_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    CELProject.ActivateForm("TSCP700_Performance_Screen", CELProject.EngineFamily.Replace("-", "_") + "_Screen", False, False)
                    CELProject.PERF_CLOSE_WINDOW_BTN.Value = Values.False
                End If

            Catch Ex As Exception
                MessageBox.Show("OnPERF_CLOSE_WINDOW_BTN: " & Ex.ToString())
            End Try
        End Sub

    
        Private Sub OnPERF_OPEN_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    CELProject.ActivateForm("TSCP700_Performance_Screen", CELProject.EngineFamily.Replace("-", "_") + "_Screen", True, False)
                    CELProject.PERF_OPEN_WINDOW_BTN.Value = Values.False
                End If

            Catch Ex As Exception
                MessageBox.Show("OnPERF_OPEN_WINDOW_BTN: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnPERF_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            Dim SearchPath As String
            Dim excelWorkbook As Excel.Workbook = Nothing

            Try
                If CELProject.IsTrue(newVal) Then

                    'Update the Log/Perf channel set
                    CELProject.LogPerfSynch.UpdateValues()

                    'Synchronize data for Log and Performance
                    Compute_TSCP700(True)

                    SearchPath = CELProject.EngineSession.PerfFolder

                    Dim NewFileCreated As Boolean

                    If CELProject.Project.Number = "10726" Then 'Value Specific to the Indonesia project

                        Dim Garuda10726TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                        NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, Garuda10726TemplateReportFullFileName, AddressOf CreateGaruda10726PerformanceFile)

                    ElseIf CELProject.Project.Number = "12917" Then 'Value Specific to the Revima project

                        Dim Revima12917TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                        NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, Revima12917TemplateReportFullFileName, AddressOf CreateRevima12917PerformanceFile)

                    Else

                        Dim StandardCELTemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                        NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, StandardCELTemplateReportFullFileName, AddressOf CreateStandardCELPerformanceFile)

                    End If

                    CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, True, CELProject.EngineModel, NewFileCreated)

                    CELProject.PERF_TAKE_POINT_BTN.Value = Values.False
                End If

            Catch ex As Exception
                MessageBox.Show("OnPERF_TAKE_POINT_BTN: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally

            End Try
        End Sub

