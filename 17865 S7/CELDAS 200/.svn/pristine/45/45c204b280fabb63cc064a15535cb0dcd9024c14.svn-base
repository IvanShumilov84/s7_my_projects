        Private Function CreateGaruda10726PerformanceFile(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreateGaruda10726PerformanceFile = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            Try
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    excelWorksheet = excelSheets.Item("APU CONDITION TEST SHEET")

                    'TSN/TSO
                    excelWorksheet.Cells(7, 7).NumberFormat = "@"
                    excelWorksheet.Cells(7, 7).Value = UserInputsGaruda.TimeSinceNewOrOverhaul

                    'Report No.
                    excelWorksheet.Cells(7, 9).NumberFormat = "@"
                    excelWorksheet.Cells(7, 9).Value = UserInputsGaruda.TestNumber

                    'Serial No.
                    excelWorksheet.Cells(8, 3).NumberFormat = "@"
                    excelWorksheet.Cells(8, 3).Value = UserInputsGaruda.EngineSerialNumber

                    'Work Order
                    excelWorksheet.Cells(8, 7).NumberFormat = "@"
                    excelWorksheet.Cells(8, 7).Value = UserInputsGaruda.WorkOrder

                    'Customer
                    excelWorksheet.Cells(9, 3).NumberFormat = "@"
                    excelWorksheet.Cells(9, 3).Value = UserInputsGaruda.CustomerName

                    'Type of Test
                    excelWorksheet.Cells(9, 7).NumberFormat = "@"
                    excelWorksheet.Cells(9, 7).Value = UserInputsGaruda.TestType

                    'Date : cellule J9
                    excelWorksheet.Cells(9, 9).NumberFormat = "@"
                    excelWorksheet.Cells(9, 9).Value = Format(Now, "d MMMM yyyy")

                    'Reference, cellule C10
                    excelWorksheet.Cells(10, 3).NumberFormat = "@"
                    excelWorksheet.Cells(10, 3).Value = Custom_Parameters("APUTestedAccordingTo").ToString()

                    'Operator
                    excelWorksheet.Cells(42, 3).NumberFormat = "@"
                    excelWorksheet.Cells(42, 3).Value = UserInputsGaruda.OperatorName

                    'Observer
                    excelWorksheet.Cells(42, 8).NumberFormat = "@"
                    excelWorksheet.Cells(42, 8).Value = UserInputsGaruda.ObserverName

                    excelWorksheet = excelSheets.Item("APU TEST REPORT")

                    'PD Sheet No.
                    excelWorksheet.Cells(5, 7).NumberFormat = "@"
                    excelWorksheet.Cells(5, 7).Value = UserInputsGaruda.PDSheetNumber

                    'Light/Heavy
                    If UserInputsGaruda.RepairType = "Heavy" Then
                        excelWorksheet.OLEObjects("HeavyRepair").object.value = True
                        excelWorksheet.OLEObjects("LightMediumRepair").object.value = False

                        excelWorksheet.Cells(31, 2).NumberFormat = "@"
                        excelWorksheet.Cells(31, 2).Value = "341"

                    ElseIf UserInputsGaruda.RepairType = "Light" Then
                        excelWorksheet.OLEObjects("HeavyRepair").object.value = False
                        excelWorksheet.OLEObjects("LightMediumRepair").object.value = True

                        excelWorksheet.Cells(31, 2).NumberFormat = "@"
                        excelWorksheet.Cells(31, 2).Value = "320"

                    Else
                        excelWorksheet.OLEObjects("HeavyRepair").object.value = False
                        excelWorksheet.OLEObjects("LightMediumRepair").object.value = False
                    End If

                    'Test Cell Performer (Operator)
                    excelWorksheet.Cells(39, 5).NumberFormat = "@"
                    excelWorksheet.Cells(39, 5).Value = UserInputsGaruda.OperatorName

                    'Supervisor
                    excelWorksheet.Cells(39, 7).NumberFormat = "@"
                    excelWorksheet.Cells(39, 7).Value = UserInputsGaruda.SupervisorName

                    'Inspector
                    excelWorksheet.Cells(39, 9).NumberFormat = "@"
                    excelWorksheet.Cells(39, 9).Value = UserInputsGaruda.QCInspectorName

                End If

                GarudaWriteRunningTime(excelSheets)

                Select Case TestStepNumber

                    Case eTestStepTSCP700_GARUDA.RUN_IN_IDLE

                        GarudaWriteCommonDataForApuConditionTestSheet(excelSheets, 7, 1)

                    Case eTestStepTSCP700_GARUDA.ZERO_LOAD

                        GarudaWriteCommonDataForApuConditionTestSheet(excelSheets, 8, 1)

                    Case eTestStepTSCP700_GARUDA.GENERATOR_LOAD

                        GarudaWriteCommonDataForApuConditionTestSheet(excelSheets, 8, 2)

                    Case eTestStepTSCP700_GARUDA.STANDBY

                        GarudaWriteCommonDataForApuConditionTestSheet(excelSheets, 9, 1)
                        GarudaWriteCommonData2ForApuConditionTestSheet(excelSheets, 9, 1)

                    Case eTestStepTSCP700_GARUDA.ECS

                        GarudaWriteCommonDataForApuConditionTestSheet(excelSheets, 9, 2)
                        GarudaWriteCommonData2ForApuConditionTestSheet(excelSheets, 9, 2)

                    Case eTestStepTSCP700_GARUDA.MES_PERFORMANCE

                        GarudaWriteCommonDataForApuConditionTestSheet(excelSheets, 10, 1)
                        GarudaWriteCommonData2ForApuConditionTestSheet(excelSheets, 10, 1)

                        excelWorksheet = excelSheets.Item("APU TEST REPORT")

                        excelWorksheet.Cells(14, 3).Value = LOG_PERF_P_BARO_MBARA.Value.ToString(LOG_PERF_P_BARO_MBARA.Format, Nothing)
                        excelWorksheet.Cells(15, 3).Value = LOG_PERF_T_INLET_AVG_DEGF.Value.ToString(LOG_PERF_T_INLET_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(16, 3).Value = LOG_PERF_P_OIL_PUMP_DSCH_PSIG.Value.ToString(LOG_PERF_P_OIL_PUMP_DSCH_PSIG.Format, Nothing)
                        excelWorksheet.Cells(17, 3).Value = LOG_PERF_T_OIL_DEGF.Value.ToString(LOG_PERF_T_OIL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(18, 3).Value = LOG_PERF_T_FUEL_DEGF.Value.ToString(LOG_PERF_T_FUEL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(19, 3).Value = LOG_PERF_P_FUEL_PSIG.Value.ToString(LOG_PERF_P_FUEL_PSIG.Format, Nothing)
                        excelWorksheet.Cells(20, 3).Value = LOG_PERF_P_FUEL_DSCH_NOZZLE_PSIG.Value.ToString(LOG_PERF_P_FUEL_DSCH_NOZZLE_PSIG.Format, Nothing)
                        excelWorksheet.Cells(21, 3).Value = LOG_PERF_WF_AVG_PPH.Value.ToString(LOG_PERF_WF_AVG_PPH.Format, Nothing)
                        excelWorksheet.Cells(22, 3).Value = LOG_PERF_T_EGT_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(23, 3).Value = LOG_PERF_T_ETC1_DEGF.Value.ToString(LOG_PERF_T_ETC1_DEGF.Format, Nothing)
                        excelWorksheet.Cells(24, 3).Value = LOG_PERF_T_ETC2_DEGF.Value.ToString(LOG_PERF_T_ETC2_DEGF.Format, Nothing)
                        excelWorksheet.Cells(25, 3).Value = LOG_PERF_VIB_GEARBOX.Value.ToString(LOG_PERF_VIB_GEARBOX.Format, Nothing)
                        excelWorksheet.Cells(26, 3).Value = LOG_PERF_VIB_TURBINE.Value.ToString(LOG_PERF_VIB_TURBINE.Format, Nothing)

                        excelWorksheet.Cells(14, 8).Value = LOG_PERF_N1.Value.ToString(LOG_PERF_N1.Format, Nothing)
                        excelWorksheet.Cells(15, 8).Value = LOG_PERF_N2.Value.ToString(LOG_PERF_N2.Format, Nothing)

                        excelWorksheet.Cells(17, 8).Value = LOG_PERF_P_OIL_GB_BREATHER_INHGG.Value.ToString(LOG_PERF_P_OIL_GB_BREATHER_INHGG.Format, Nothing)
                        excelWorksheet.Cells(18, 8).Value = LOG_PERF_P_BLEED_INHGA.Value.ToString(LOG_PERF_P_BLEED_INHGA.Format, Nothing)

                        excelWorksheet.Cells(20, 8).Value = LOG_PERF_P_ORIFICE_INHGG.Value.ToString(LOG_PERF_P_ORIFICE_INHGG.Format, Nothing)
                        excelWorksheet.Cells(21, 8).Value = LOG_PERF_P_ORIFICE_DELTA_INH2OD.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_INH2OD.Format, Nothing)
                        excelWorksheet.Cells(22, 8).Value = LOG_PERF_P_LP_COMP_DSCH_PSIG.Value.ToString(LOG_PERF_P_LP_COMP_DSCH_PSIG.Format, Nothing)
                        excelWorksheet.Cells(23, 8).Value = LOG_PERF_P_SURGE_INHGG.Value.ToString(LOG_PERF_P_SURGE_INHGG.Format, Nothing)

                        excelWorksheet.Cells(25, 8).Value = LOG_PERF_T_ORIFICE_DEGF.Value.ToString(LOG_PERF_T_ORIFICE_DEGF.Format, Nothing)
                        excelWorksheet.Cells(26, 8).Value = LOG_PERF_T_BLEED_AVG_DEGF.Value.ToString(LOG_PERF_T_BLEED_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(27, 8).Value = LOG_PERF_GENERATOR_POWER_KW.Value.ToString(LOG_PERF_GENERATOR_POWER_KW.Format, Nothing)

                        excelWorksheet.Cells(31, 3).Value = LOG_PERF_WBCOR_PPM.Value.ToString(LOG_PERF_WBCOR_PPM.Format, Nothing)
                        excelWorksheet.Cells(32, 3).Value = LOG_PERF_PBCOR_INHGA.Value.ToString(LOG_PERF_PBCOR_INHGA.Format, Nothing)
                        excelWorksheet.Cells(33, 3).Value = LOG_PERF_TBCOR_DEGF.Value.ToString(LOG_PERF_TBCOR_DEGF.Format, Nothing)
                        excelWorksheet.Cells(34, 3).Value = LOG_PERF_WFCOR_PPH.Value.ToString(LOG_PERF_WFCOR_PPH.Format, Nothing)


                        Dim cTemp As String = Nothing

                        If PerfCalcOutsideRange Then
                            cTemp = "WBCorr, TBCorr and PBCorr cannot be calculated because the N1 speed is below or higher than the specified values in table 709 " + vbCrLf + "The mimimum or maximum values in table 709 are used."
                        Else
                            cTemp = "         "
                        End If

                        excelWorksheet = excelSheets.Item("APU CONDITION TEST SHEET")
                        'cell A48
                        excelWorksheet.Cells(48, 1).NumberFormat = "@"
                        excelWorksheet.Cells(48, 1).Value = cTemp

                        excelWorksheet = excelSheets.Item("APU CONDITION TEST SHEET2")
                        'cell A48
                        excelWorksheet.Cells(48, 1).NumberFormat = "@"
                        excelWorksheet.Cells(48, 1).Value = cTemp

                        excelWorksheet = excelSheets.Item("APU TEST REPORT")
                        'cell A46
                        excelWorksheet.Cells(46, 1).NumberFormat = "@"
                        excelWorksheet.Cells(46, 1).Value = cTemp

                    Case eTestStepTSCP700_GARUDA.FINAL_DATA
                        'Nothing to do, all in common section

                End Select

                'Write the manual Entry
                excelWorksheet = excelSheets.Item("APU TEST REPORT")

                'Preservation, cellule B36
                excelWorksheet.Cells(36, 2).NumberFormat = "@"
                excelWorksheet.Cells(36, 2).Value = "For " + PERF_PRESERVATION_MONTH.Value.ToString() + " Months"

                If CELProject.IsTrue(PERF_PRESERVATION_YES.Value) Then
                    excelWorksheet.OLEObjects("PreservationYes").object.value = True
                Else
                    excelWorksheet.OLEObjects("PreservationYes").object.value = False
                End If

                If CELProject.IsTrue(PERF_PRESERVATION_NO.Value) Then
                    excelWorksheet.OLEObjects("PreservationNo").object.value = True
                Else
                    excelWorksheet.OLEObjects("PreservationNo").object.value = False
                End If

                'Test Result
                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                End If

                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                End If

                excelWorksheet = excelSheets.Item("APU CONDITION TEST SHEET")

                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value) Then
                    excelWorksheet.Cells(11, 3).Value = "Accepted"
                Else
                    excelWorksheet.Cells(11, 3).Value = "Rejected"
                End If

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile: " + ex.ToString())
                MessageBox.Show(ex.ToString)
                CreateGaruda10726PerformanceFile = False
            Finally

                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)

            End Try
        End Function

        Private Sub RevimaWriteCommonDataForSummaryPerformedTestDetails(ByVal excelSheets As Excel.Sheets, ByVal Line As Integer, ByVal Description As String, ByVal StepText As String, Value As Boolean)
            Try
                Dim excelWorksheet As Excel.Worksheet = excelSheets.Item("SUMMARY")

                ' write the line: description, step, units , value
                excelWorksheet.Cells(Line, 2).Value = Description
                excelWorksheet.Cells(Line, 50).Value = StepText

                If Value Then
                    excelWorksheet.Cells(Line, 78).Value = "Passed"
                Else
                    excelWorksheet.Cells(Line, 78).Value = "Failed"

                End If

            Catch Ex As Exception
                MessageBox.Show("RevimaWriteCommonDataForSummaryPerformedTestDetails: " & Ex.ToString())
            End Try
        End Sub

        Private Sub RevimaWriteStandbyData(ByVal excelSheets As Excel.Sheets)

            Try
                Dim excelWorksheet As Excel.Worksheet = excelSheets.Item("SUMMARY")

                excelWorksheet.Cells(32, 2).Value = "Standby Speed N1"
                excelWorksheet.Cells(32, 50).Value = "2.E (2)"
                excelWorksheet.Cells(32, 66).Value = "RPM"
                excelWorksheet.Cells(32, 78).Value = LOG_PERF_N1.Value.ToString(LOG_PERF_N1.Format, Nothing)

                excelWorksheet.Cells(33, 2).Value = "Standby Speed N2"
                excelWorksheet.Cells(33, 50).Value = "2.E (2)"
                excelWorksheet.Cells(33, 66).Value = "RPM"
                excelWorksheet.Cells(33, 78).Value = LOG_PERF_N2.Value.ToString(LOG_PERF_N2.Format, Nothing)

                excelWorksheet.Cells(34, 2).Value = "Compressor Inlet Temp."
                excelWorksheet.Cells(34, 50).Value = "2.E (2)"
                excelWorksheet.Cells(34, 66).Value = "°F"
                excelWorksheet.Cells(34, 78).Value = LOG_PERF_T_INLET_AVG_DEGF.Value.ToString(LOG_PERF_T_INLET_AVG_DEGF.Format, Nothing)

            Catch Ex As Exception
                MessageBox.Show("RevimaWriteStandbyData: " & Ex.ToString())
            End Try
        End Sub

        Private Sub RevimaWriteFinalData(ByVal excelSheets As Excel.Sheets)

            Try
                Dim excelWorksheet As Excel.Worksheet = excelSheets.Item("ACCEPTANCE")

                'Test Result
                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                End If

                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                End If

                excelWorksheet = excelSheets.Item("SUMMARY")

                If CELProject.EngineModel = "TSCP700-4B" Or CELProject.EngineModel = "TSCP700-5" Then

                    RevimaWriteCommonDataForSummaryPerformedTestDetails(excelSheets, 28, "APU Run-In and Electronic Control Check", "2A", CELProject.IsTrue(Log_Perf_APU_RUN_In_Check.Value))
                    RevimaWriteCommonDataForSummaryPerformedTestDetails(excelSheets, 29, "Oil Filter and Mag Plug/Detector Strainer Check", "2B", CELProject.IsTrue(Log_Perf_OIL_Filter_Check.Value))
                    RevimaWriteCommonDataForSummaryPerformedTestDetails(excelSheets, 30, "Oil Consumtion Check", "2C", CELProject.IsTrue(Log_Perf_Oil_Consumtion_Check.Value))
                    RevimaWriteCommonDataForSummaryPerformedTestDetails(excelSheets, 31, "OIL Level Sensor Check", "2D", CELProject.IsTrue(Log_Perf_OIL_Level_Sensor_Check.Value))

                ElseIf CELProject.EngineModel = "TSCP700-4E" Then

                    RevimaWriteCommonDataForSummaryPerformedTestDetails(excelSheets, 28, "Start Tests Check", "1.G (2)", CELProject.IsTrue(Log_Perf_Start_Tests_Check.Value))
                    RevimaWriteCommonDataForSummaryPerformedTestDetails(excelSheets, 29, "Engine Run-In Check", "1.G (3)", CELProject.IsTrue(Log_Perf_Engine_RUN_In_Check.Value))
                    RevimaWriteCommonDataForSummaryPerformedTestDetails(excelSheets, 30, "Magnetic Chip Detector Check", "1.G (4)", CELProject.IsTrue(Log_Perf_Magnetic_Chip_Detector_Check.Value))
                    RevimaWriteCommonDataForSummaryPerformedTestDetails(excelSheets, 31, "Oil Consumtion Check", "1.G (5)", CELProject.IsTrue(Log_Perf_Oil_Consumtion_Check.Value))
                    RevimaWriteCommonDataForSummaryPerformedTestDetails(excelSheets, 32, "VTN Actuator null position N1 speed Check", "1.G (6)", CELProject.IsTrue(Log_Perf_VTN_Check.Value))
                    RevimaWriteCommonDataForSummaryPerformedTestDetails(excelSheets, 33, "Test for 100% MES Speed Check", "1.G (7)", CELProject.IsTrue(Log_Perf_Test_100_MES_Check.Value))
                    RevimaWriteCommonDataForSummaryPerformedTestDetails(excelSheets, 34, "OIL Level Sensor Check", "1.G (8)", CELProject.IsTrue(Log_Perf_OIL_Level_Sensor_Check.Value))

                Else
                    MessageBox.Show("Init_Egine_Channels: Engine Model Not supported", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                End If


                excelWorksheet.Cells(38, 78).Value = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format, Nothing)
                excelWorksheet.Cells(39, 78).Value = NUMBER_OF_STARTS.Value.ToString(NUMBER_OF_STARTS.Format, Nothing)
                excelWorksheet.Cells(40, 78).Value = LOG_PERF_FUEL_USED_TOTAL_LITERS.Value.ToString(LOG_PERF_FUEL_USED_TOTAL_LITERS.Format, Nothing)

            Catch Ex As Exception
                MessageBox.Show("RevimaWriteFinalData: " & Ex.ToString())
            End Try
        End Sub

        Private Sub RevimaWriteCommonDataForSummaryTestSheet(ByVal excelSheets As Excel.Sheets, ByVal Column As Integer, ByVal Correction As Boolean, ByVal ColumnLimit As Integer)

            Try
                Dim excelWorksheet As Excel.Worksheet

                excelWorksheet = excelSheets.Item("SUMMARY")

                If Correction Then
                    'CEL AY20 a AY22
                    excelWorksheet.Cells(20, Column).Value = LOG_PERF_PBCOR_INHGA.Value.ToString(LOG_PERF_PBCOR_INHGA.Format, Nothing)
                    excelWorksheet.Cells(21, Column).Value = LOG_PERF_TBCOR_DEGF.Value.ToString(LOG_PERF_TBCOR_DEGF.Format, Nothing)
                    excelWorksheet.Cells(22, Column).Value = LOG_PERF_WBCOR_PPM.Value.ToString(LOG_PERF_WBCOR_PPM.Format, Nothing)
                End If

                excelWorksheet.Cells(23, Column).Value = LOG_PERF_WFCOR_PPH.Value.ToString(LOG_PERF_WFCOR_PPH.Format, Nothing)

                If ColumnLimit <> 0 Then
                    'Limit for PBCOR
                    excelWorksheet.Cells(20, ColumnLimit).NumberFormat = "@"
                    excelWorksheet.Cells(20, ColumnLimit).Value = "  Min  " & PBCOR_PERF_MIN_INHGA.Value.ToString(PBCOR_PERF_MIN_INHGA.Format, Nothing)

                    'Limit for TBCOR
                    excelWorksheet.Cells(21, ColumnLimit).NumberFormat = "@"
                    excelWorksheet.Cells(21, ColumnLimit).Value = "  Max  " & TBCOR_PERF_MAX_DEGF.Value.ToString(TBCOR_PERF_MAX_DEGF.Format, Nothing)

                    'Limit for WBCORdepending on Light/Heavy
                    excelWorksheet.Cells(22, ColumnLimit).NumberFormat = "@"
                    excelWorksheet.Cells(22, ColumnLimit).Value = "  Min  " & WBCOR_PERF_MIN_PPM.Value.ToString(WBCOR_PERF_MIN_PPM.Format, Nothing)
                End If


            Catch Ex As Exception
                MessageBox.Show("RevimaWriteCommonDataForSummaryTestSheet: " & Ex.ToString())
            End Try

        End Sub

        Private Sub RevimaWriteCommonDataForDetailsTestSheet(ByVal excelSheets As Excel.Sheets, ByVal Column As Integer, ByVal NoBleed As Boolean, ByVal NoCorrection As Boolean)

            Try
                Dim excelWorksheet As Excel.Worksheet

                excelWorksheet = excelSheets.Item("DETAILS")

                excelWorksheet.Cells(18, Column).Value = LOG_PERF_P_BARO_MBARA.Value.ToString(LOG_PERF_P_BARO_MBARA.Format, Nothing)
                excelWorksheet.Cells(19, Column).Value = LOG_PERF_T_INLET_AVG_DEGF.Value.ToString(LOG_PERF_T_INLET_AVG_DEGF.Format, Nothing)
                excelWorksheet.Cells(20, Column).Value = LOG_PERF_T_OIL_DEGF.Value.ToString(LOG_PERF_T_OIL_DEGF.Format, Nothing)
                excelWorksheet.Cells(21, Column).Value = LOG_PERF_T_FUEL_DEGF.Value.ToString(LOG_PERF_T_FUEL_DEGF.Format, Nothing)
                excelWorksheet.Cells(22, Column).Value = LOG_PERF_P_FUEL_PSIG.Value.ToString(LOG_PERF_P_FUEL_PSIG.Format, Nothing)

                If CELProject.EngineModel = "TSCP700-4B" Or CELProject.EngineModel = "TSCP700-5" Then

                    excelWorksheet.Cells(23, Column).Value = LOG_PERF_P_FUEL_DSCH_NOZZLE_PSIG.Value.ToString(LOG_PERF_P_FUEL_DSCH_NOZZLE_PSIG.Format, Nothing)

                ElseIf CELProject.EngineModel = "TSCP700-4E" Then

                    excelWorksheet.Cells(23, Column).Value = "N/A"
                    excelWorksheet.Cells(23, Column).Interior.ColorIndex = 15
                Else

                    MessageBox.Show("RevimaWriteCommonDataForAcceptanceTestSheet: Engine Model Not supported", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)

                End If

                excelWorksheet.Cells(24, Column).Value = LOG_PERF_P_OIL_PUMP_DSCH_PSIG.Value.ToString(LOG_PERF_P_OIL_PUMP_DSCH_PSIG.Format, Nothing)
                excelWorksheet.Cells(25, Column).Value = LOG_PERF_P_OIL_GB_BREATHER_INHGG.Value.ToString(LOG_PERF_P_OIL_GB_BREATHER_INHGG.Format, Nothing)
                excelWorksheet.Cells(26, Column).Value = LOG_PERF_WF_AVG_PPH.Value.ToString(LOG_PERF_WF_AVG_PPH.Format, Nothing)
                excelWorksheet.Cells(27, Column).Value = LOG_PERF_T_EGT_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_AVG_DEGF.Format, Nothing)
                excelWorksheet.Cells(28, Column).Value = LOG_PERF_T_ETC1_DEGF.Value.ToString(LOG_PERF_T_ETC1_DEGF.Format, Nothing)
                excelWorksheet.Cells(29, Column).Value = LOG_PERF_T_ETC2_DEGF.Value.ToString(LOG_PERF_T_ETC2_DEGF.Format, Nothing)
                excelWorksheet.Cells(30, Column).Value = LOG_PERF_VIB_GEARBOX.Value.ToString(LOG_PERF_VIB_GEARBOX.Format, Nothing)
                excelWorksheet.Cells(31, Column).Value = LOG_PERF_VIB_TURBINE.Value.ToString(LOG_PERF_VIB_TURBINE.Format, Nothing)
                excelWorksheet.Cells(32, Column).Value = LOG_PERF_N1.Value.ToString(LOG_PERF_N1.Format, Nothing)
                excelWorksheet.Cells(33, Column).Value = LOG_PERF_N2.Value.ToString(LOG_PERF_N2.Format, Nothing)

                If NoBleed Then

                    excelWorksheet.Cells(34, Column).Value = "N/A"
                    excelWorksheet.Cells(34, Column).Interior.ColorIndex = 15
                    excelWorksheet.Cells(35, Column).Value = "N/A"
                    excelWorksheet.Cells(35, Column).Interior.ColorIndex = 15
                    excelWorksheet.Cells(36, Column).Value = "N/A"
                    excelWorksheet.Cells(36, Column).Interior.ColorIndex = 15

                Else
                    excelWorksheet.Cells(34, Column).Value = LOG_PERF_P_BLEED_INHGA.Value.ToString(LOG_PERF_P_BLEED_INHGA.Format, Nothing)
                    excelWorksheet.Cells(35, Column).Value = LOG_PERF_P_ORIFICE_INHGG.Value.ToString(LOG_PERF_P_ORIFICE_INHGG.Format, Nothing)
                    excelWorksheet.Cells(36, Column).Value = LOG_PERF_P_ORIFICE_DELTA_INH2OD.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_INH2OD.Format, Nothing)

                End If

                excelWorksheet.Cells(37, Column).Value = LOG_PERF_P_SURGE_INHGG.Value.ToString(LOG_PERF_P_SURGE_INHGG.Format, Nothing)

                If CELProject.EngineModel = "TSCP700-4B" Or CELProject.EngineModel = "TSCP700-5" Then

                    excelWorksheet.Cells(38, Column).Value = LOG_PERF_P_LP_COMP_DSCH_PSIG.Value.ToString(LOG_PERF_P_LP_COMP_DSCH_PSIG.Format, Nothing)

                ElseIf CELProject.EngineModel = "TSCP700-4E" Then

                    excelWorksheet.Cells(38, Column).Value = "N/A"
                    excelWorksheet.Cells(38, Column).Interior.ColorIndex = 15
                Else

                    MessageBox.Show("RevimaWriteCommonDataForAcceptanceTestSheet: Engine Model Not supported", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)

                End If

                If NoBleed Then

                    excelWorksheet.Cells(39, Column).Value = "N/A"
                    excelWorksheet.Cells(39, Column).Interior.ColorIndex = 15
                    excelWorksheet.Cells(40, Column).Value = "N/A"
                    excelWorksheet.Cells(40, Column).Interior.ColorIndex = 15

                Else

                    excelWorksheet.Cells(39, Column).Value = LOG_PERF_T_BLEED_AVG_DEGF.Value.ToString(LOG_PERF_T_BLEED_AVG_DEGF.Format, Nothing)
                    excelWorksheet.Cells(40, Column).Value = LOG_PERF_T_ORIFICE_DEGF.Value.ToString(LOG_PERF_T_ORIFICE_DEGF.Format, Nothing)

                End If

                excelWorksheet.Cells(41, Column).Value = LOG_PERF_GENERATOR_POWER_KW.Value.ToString(LOG_PERF_GENERATOR_POWER_KW.Format, Nothing)

                If NoCorrection Then

                    excelWorksheet.Cells(42, Column).Value = "N/A"
                    excelWorksheet.Cells(42, Column).Interior.ColorIndex = 15
                    excelWorksheet.Cells(43, Column).Value = "N/A"
                    excelWorksheet.Cells(43, Column).Interior.ColorIndex = 15
                    excelWorksheet.Cells(44, Column).Value = "N/A"
                    excelWorksheet.Cells(44, Column).Interior.ColorIndex = 15
                    excelWorksheet.Cells(45, Column).Value = "N/A"
                    excelWorksheet.Cells(45, Column).Interior.ColorIndex = 15

                Else

                    excelWorksheet.Cells(42, Column).Value = LOG_PERF_WBCOR_PPM.Value.ToString(LOG_PERF_WBCOR_PPM.Format, Nothing)
                    excelWorksheet.Cells(43, Column).Value = LOG_PERF_PBCOR_INHGA.Value.ToString(LOG_PERF_PBCOR_INHGA.Format, Nothing)
                    excelWorksheet.Cells(44, Column).Value = LOG_PERF_TBCOR_DEGF.Value.ToString(LOG_PERF_TBCOR_DEGF.Format, Nothing)
                    excelWorksheet.Cells(45, Column).Value = LOG_PERF_WFCOR_PPH.Value.ToString(LOG_PERF_WFCOR_PPH.Format, Nothing)

                End If

                excelWorksheet.Cells(46, Column).Value = LOG_PERF_SHPCOR_HP.Value.ToString(LOG_PERF_SHPCOR_HP.Format, Nothing)

            Catch Ex As Exception
                MessageBox.Show("RevimaWriteCommonDataForAcceptanceTestSheet: " & Ex.ToString())
            End Try
        End Sub

        Private Function CreateRevima12917PerformanceFile(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreateRevima12917PerformanceFile = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            Try
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    excelWorksheet = excelSheets.Item("SUMMARY")

                    'APU        (Cell V1)
                    excelWorksheet.Cells(1, 22).NumberFormat = "@"
                    excelWorksheet.Cells(1, 22).Value = CELProject.EngineModel & " APU TEST DATA SHEET"

                    'Engine S/N.   (Cell AB5)
                    excelWorksheet.Cells(5, 28).NumberFormat = "@"
                    excelWorksheet.Cells(5, 28).Value = UserInputsRevima.EngineSerialNumber

                    'Work Order    (Cell AB6)
                    excelWorksheet.Cells(6, 28).NumberFormat = "@"
                    excelWorksheet.Cells(6, 28).Value = UserInputsRevima.WorkOrder

                    'ECB S/N    (Cell AB7)
                    excelWorksheet.Cells(7, 28).NumberFormat = "@"

                    If CELProject.EngineModel = "TSCP700-4E" Then
                        excelWorksheet.Cells(7, 28).Value = UserInputsRevima.ECBSerialNumber
                    Else
                        excelWorksheet.Cells(7, 28).Value = "N/A"
                        excelWorksheet.Cells(7, 28).Interior.ColorIndex = 15
                    End If

                    'Exhaust Duct S/N    (Cell AB8)
                    excelWorksheet.Cells(8, 28).NumberFormat = "@"
                    excelWorksheet.Cells(8, 28).Value = UserInputsRevima.ExhaustDuctSerialNumber

                    'Bellmouth S/N    (Cell AB9)
                    excelWorksheet.Cells(9, 28).NumberFormat = "@"
                    excelWorksheet.Cells(9, 28).Value = UserInputsRevima.BellmouthSerialNumber

                    'Bleed Duct S/N    (Cell AB10)
                    excelWorksheet.Cells(10, 28).NumberFormat = "@"
                    excelWorksheet.Cells(10, 28).Value = UserInputsRevima.BleedDuctSerialNumber

                    'Starter S/N    (Cell AB11)
                    excelWorksheet.Cells(11, 28).NumberFormat = "@"
                    excelWorksheet.Cells(11, 28).Value = UserInputsRevima.StarterSerialNumber

                    'Dyno/Generator S/N    (Cell AB12)
                    excelWorksheet.Cells(12, 28).NumberFormat = "@"
                    excelWorksheet.Cells(12, 28).Value = UserInputsRevima.DynoGeneratorSerialNumber

                    'Turbine Vib Pickup S/N    (Cell AB13)
                    excelWorksheet.Cells(13, 28).NumberFormat = "@"
                    excelWorksheet.Cells(13, 28).Value = UserInputsRevima.TurbineVibPickupSerialNumber

                    'Gearbox Vib Pickup S/N    (Cell AB14)
                    excelWorksheet.Cells(14, 28).NumberFormat = "@"
                    excelWorksheet.Cells(14, 28).Value = UserInputsRevima.GearboxVibPickupSerialNumber

                    'Oil Type S/N    (Cell CE5)
                    excelWorksheet.Cells(5, 83).NumberFormat = "@"
                    excelWorksheet.Cells(5, 83).Value = UserInputsRevima.OilType

                    'TSN/TSO        (Cell CE6)
                    excelWorksheet.Cells(6, 83).NumberFormat = "@"
                    excelWorksheet.Cells(6, 83).Value = UserInputsRevima.TimeSinceNewOrOverhaul

                    'CSN/CSO        (Cell CE7)
                    excelWorksheet.Cells(7, 83).NumberFormat = "@"
                    excelWorksheet.Cells(7, 83).Value = UserInputsRevima.CyclesSinceNewOrOverhaul

                    'Reason        (Cell CE8)
                    excelWorksheet.Cells(8, 83).NumberFormat = "@"
                    excelWorksheet.Cells(8, 83).Value = UserInputsRevima.Reason

                    'Test Type (Cell CE9)
                    excelWorksheet.Cells(9, 83).NumberFormat = "@"
                    excelWorksheet.Cells(9, 83).Value = UserInputsRevima.TestType

                    'Reppair Type (Cell CE10)
                    excelWorksheet.Cells(10, 83).NumberFormat = "@"
                    excelWorksheet.Cells(10, 83).Value = UserInputsRevima.RepairType

                    'Load Cell S/N (Cell CE11)
                    excelWorksheet.Cells(11, 83).NumberFormat = "@"
                    excelWorksheet.Cells(11, 83).Value = UserInputsRevima.LoadCellSN

                    'Load Type (Cell CE12)
                    excelWorksheet.Cells(12, 83).NumberFormat = "@"
                    excelWorksheet.Cells(12, 83).Value = UserInputsRevima.LoadType

                    'Date     (Cell CE13)
                    excelWorksheet.Cells(13, 83).NumberFormat = "@"
                    excelWorksheet.Cells(13, 83).Value = Format(Now, "d MMMM yyyy")

                    If CELProject.EngineModel = "TSCP700-4B" Or CELProject.EngineModel = "TSCP700-5" Then

                        excelWorksheet.Cells(17, 38).Value = "3.A (2a)" 'NO lOAD perf point
                        excelWorksheet.Cells(17, 56).Value = "3.A (2d)" 'Combination Load perf point
                        excelWorksheet.Cells(17, 74).Value = "2.E (6)"  'MES perf point

                        excelWorksheet.Cells(35, 50).Value = "STEP 3.A (2d)"
                        excelWorksheet.Cells(36, 50).Value = "STEP 3.A (2d)"
                        excelWorksheet.Cells(37, 50).Value = "STEP 3.A (2d)"

                        excelWorksheet = excelSheets.Item("DETAILS")

                        excelWorksheet.Cells(16, 37).Value = "3.A (2a)" 'NO lOAD perf point
                        excelWorksheet.Cells(16, 58).Value = "3.A (2d)" 'Combination Load perf point
                        excelWorksheet.Cells(16, 79).Value = "2.E (6)"  'MES perf point


                    ElseIf CELProject.EngineModel = "TSCP700-4E" Then

                        excelWorksheet.Cells(17, 38).Value = "1.H (1b)" 'NO lOAD perf point
                        excelWorksheet.Cells(17, 56).Value = "1.H (2g)" 'Combination Load perf point
                        excelWorksheet.Cells(17, 74).Value = "1.H (3a)" 'MES perf point

                        excelWorksheet.Cells(35, 50).Value = "STEP 1.H (2g)"
                        excelWorksheet.Cells(36, 50).Value = "STEP 1.H (2g)"
                        excelWorksheet.Cells(37, 50).Value = "STEP 1.H (2g)"

                        excelWorksheet = excelSheets.Item("DETAILS")

                        excelWorksheet.Cells(16, 37).Value = "1.H (1b)" 'NO lOAD perf point
                        excelWorksheet.Cells(16, 58).Value = "1.H (2g)" 'Combination Load perf point
                        excelWorksheet.Cells(16, 79).Value = "1.H (3a)" 'MES perf point


                    Else
                        MessageBox.Show("CreateRevima12917PerformanceFile: Engine Model Not supported", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    End If

                    excelWorksheet = excelSheets.Item("ACCEPTANCE")



                    'Document Number (Cell Al43)
                    excelWorksheet.Cells(43, 38).NumberFormat = "@"
                    excelWorksheet.Cells(43, 38).Value = Custom_Parameters("APUTestedAccordingTo").ToString()

                End If

                Select Case TestStepNumber

                    Case eTestStepTSCP700_REVIMA.NO_LOAD

                        RevimaWriteCommonDataForDetailsTestSheet(excelSheets, 37, True, True)
                        RevimaWriteCommonDataForSummaryTestSheet(excelSheets, 47, False, 0)
                        TestProgress_RecordPerfStep("No Load", False)

                    Case eTestStepTSCP700_REVIMA.COMBINATION_LOAD

                        RevimaWriteCommonDataForDetailsTestSheet(excelSheets, 58, False, False)
                        RevimaWriteCommonDataForSummaryTestSheet(excelSheets, 65, True, 56)
                        TestProgress_RecordPerfStep("Combination Load", True)

                        excelWorksheet = excelSheets.Item("SUMMARY")

                        'CEL BZ27 a BZ31
                        excelWorksheet.Cells(35, 78).Value = STARTING_TIME_SEC.Value.ToString(STARTING_TIME_SEC.Format, Nothing)
                        excelWorksheet.Cells(36, 78).Value = START_MAX_EGT_DEGF.Value.ToString(START_MAX_EGT_DEGF.Format, Nothing)
                        excelWorksheet.Cells(37, 78).Value = START_MAX_ETC_DEGF.Value.ToString(START_MAX_ETC_DEGF.Format, Nothing)

                        Dim cTemp As String = Nothing

                        If PerfCalcOutsideRange Then
                            If CELProject.EngineModel = "TSCP700-4E" Then
                                cTemp = "WBCorr, TBCorr and PBCorr cannot be calculated because the N1 speed is below or higher than the specified values in table 106 " + vbCrLf + "The mimimum or maximum values in table 106 are used."
                            Else
                                cTemp = "WBCorr, TBCorr and PBCorr cannot be calculated because the N1 speed is below or higher than the specified values in table 709 " + vbCrLf + "The mimimum or maximum values in table 709 are used."
                            End If
                        Else
                            cTemp = "         "
                        End If

                        excelWorksheet = excelSheets.Item("SUMMARY")
                        'cell B34
                        excelWorksheet.Cells(42, 2).NumberFormat = "@"
                        excelWorksheet.Cells(42, 2).Value = cTemp

                        excelWorksheet = excelSheets.Item("DETAILS")
                        'cell B47
                        excelWorksheet.Cells(49, 2).NumberFormat = "@"
                        excelWorksheet.Cells(49, 2).Value = cTemp

                    Case eTestStepTSCP700_REVIMA.MES

                        RevimaWriteCommonDataForDetailsTestSheet(excelSheets, 79, False, True)
                        RevimaWriteCommonDataForSummaryTestSheet(excelSheets, 83, False, 0)

                    Case eTestStepTSCP700_REVIMA.STANDBY

                        'ONLY FOR TSCP700-4B/5
                        RevimaWriteStandbyData(excelSheets)

                    Case eTestStepTSCP700_REVIMA.FINAL_DATA
                        RevimaWriteFinalData(excelSheets)

                End Select

            Catch ex As Exception

                System.Diagnostics.Trace.WriteLine("CreateRevima12917PerformanceFile: " + ex.ToString())
                MessageBox.Show(ex.ToString)
                CreateRevima12917PerformanceFile = False

            Finally

                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)

            End Try
        End Function

        Private Function CreateStandardCELPerformanceFile(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean

            '**********************************************************************************************************************************
            '               Comme on utilise un autre rapport, Garuda pour le premier projet, on
            '               va devoir faire le rapport de CEL dans un autre projet.
            '**********************************************************************************************************************************
            Return False

        End Function

        Private Sub Init_Arrays()


            Dim i As Integer
            Dim rs As New ADODB.Recordset
            Dim SelectString As String

            Try
                'Read Table 709 from Page 746 Dec 5/97

                SelectString = "SELECT * FROM TSCP700_TTI ORDER BY [TTI]"
                If DatabaseHelper.OpenRecordset(rs, SelectString, cnMain, True) Then
                    ReDim TSCP700_TTI(DatabaseHelper.RecordCount(rs) - 1, 4)
                    For i = 0 To TSCP700_TTI.GetLength(0) - 1
                        TSCP700_TTI(i, 0) = rs.Fields("TTI").Value
                        TSCP700_TTI(i, 1) = rs.Fields("WB_CHNG").Value
                        TSCP700_TTI(i, 2) = rs.Fields("PB_CHNG").Value
                        TSCP700_TTI(i, 3) = rs.Fields("TB_CHNG").Value
                        TSCP700_TTI(i, 4) = rs.Fields("UNIT_EGT").Value
                        rs.MoveNext()
                    Next i
                    DatabaseHelper.CloseRecordset(rs)
                End If

                'Read Revised Table 707 from Temporary Revision 49-387

                SelectString = "SELECT * FROM TSCP700_N1 ORDER BY [N1]"
                If DatabaseHelper.OpenRecordset(rs, SelectString, cnMain, True) Then
                    ReDim TSCP700_N1(DatabaseHelper.RecordCount(rs) - 1, 3)
                    For i = 0 To TSCP700_N1.GetLength(0) - 1
                        TSCP700_N1(i, 0) = rs.Fields("N1").Value
                        TSCP700_N1(i, 1) = rs.Fields("WB2_CHNG").Value
                        TSCP700_N1(i, 2) = rs.Fields("PB2_CHNG").Value
                        TSCP700_N1(i, 3) = rs.Fields("TB2_CHNG").Value
                        rs.MoveNext()
                    Next i
                    DatabaseHelper.CloseRecordset(rs)
                End If

                'Array used for the TSCP700-4E Arinc
                ECU_STATUS_CODE(0) = "UNDEFINED"
                ECU_STATUS_CODE(1) = "PRESTART BITE IN PROGRESS"
                ECU_STATUS_CODE(2) = "REMOTE BITE IN PROGRESS"
                ECU_STATUS_CODE(3) = "APU START IN PROGRESS"
                ECU_STATUS_CODE(4) = "APU RUN"
                ECU_STATUS_CODE(5) = "APU COOL DOWN IN PROGRESS"
                ECU_STATUS_CODE(6) = "ECU SHUTDOWN IDLE"
                ECU_STATUS_CODE(7) = "ECU AUTO SHUTDOWN HOLD"
                ECU_STATUS_CODE(8) = "REMOTE BITE COMMAND ENABLE"
                ECU_STATUS_CODE(9) = "SPARE 9"
                ECU_STATUS_CODE(10) = "SPARE 10"
                ECU_STATUS_CODE(11) = "SPARE 11"
                ECU_STATUS_CODE(12) = "SPARE 12"
                ECU_STATUS_CODE(13) = "SPARE 13"
                ECU_STATUS_CODE(14) = "SPARE 14"
                ECU_STATUS_CODE(15) = "SPARE 15"

                INHIBIT_CODE(0) = "OK (NO INHIBIT)"
                INHIBIT_CODE(1) = "FUEL SOLENOID CIRCUIT"
                INHIBIT_CODE(2) = "LOP SWITCH"
                INHIBIT_CODE(3) = "HOT"
                INHIBIT_CODE(4) = "FUEL TORQUE MOTOR CIRCUIT"
                INHIBIT_CODE(5) = "IGNITION CIRCUIT"
                INHIBIT_CODE(6) = "SPARE 6"
                INHIBIT_CODE(7) = "ECU SUBSYSTEM"
                INHIBIT_CODE(8) = "NOZZLE SOLENOID"
                INHIBIT_CODE(9) = "EGT CIRCUIT"
