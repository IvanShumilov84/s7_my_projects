                excelWorksheet.Cells(32, Column).Value = LOG_PERF_P_SURGE_INHGG.Value.ToString(LOG_PERF_P_SURGE_INHGG.Format, Nothing)
                excelWorksheet.Cells(33, Column).Value = LOG_PERF_P_LP_COMP_DSCH_PSIG.Value.ToString(LOG_PERF_P_LP_COMP_DSCH_PSIG.Format, Nothing)

                excelWorksheet.Cells(36, Column).Value = LOG_PERF_GENERATOR_POWER_KW.Value.ToString(LOG_PERF_GENERATOR_POWER_KW.Format, Nothing)

                excelWorksheet.Cells(41, Column).Value = LOG_PERF_SHPCOR_HP.Value.ToString(LOG_PERF_SHPCOR_HP.Format, Nothing)

            Catch Ex As Exception
