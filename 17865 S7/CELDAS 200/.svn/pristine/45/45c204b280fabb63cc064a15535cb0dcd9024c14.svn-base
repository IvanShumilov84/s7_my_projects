        Private Sub ConfigHMIforEngine()

            'The Page for the TSCP700 have been tested for 4B, 4E and 5. For the other engine of the familly we may have to
            'modify a little bit this section.
            '
            Try
                Dim BTN_TARE As CEL.KineticaRT.Controls.Button = Nothing
                Dim DYNO_Frame As KineticaRT.Controls.Frame = Nothing
                Dim DYNO_Frame2 As KineticaRT.Controls.Frame = Nothing
                Dim DYNO_Text As System.Windows.Forms.Label = Nothing
                Dim LB_Frame As KineticaRT.Controls.Frame = Nothing
                Dim LB_Frame2 As KineticaRT.Controls.Frame = Nothing
                Dim LB_Text As System.Windows.Forms.Label = Nothing
                Dim SHPCOR_DSP As KineticaRT.Studio.Controls.Display = Nothing
                Dim WaterDynoFrame As KineticaRT.Controls.Frame = Nothing
                Dim WaterDynoLamp As KineticaRT.Studio.Controls.LampIndicator = Nothing

                MyBase.InitializeObject(BTN_TARE, "TSCP700_Screen.fraAlarmsAndStatus.btnTARE")
                MyBase.InitializeObject(DYNO_Frame, "TSCP700_Screen.TSCP700_EngineRun.fraDyno")
                MyBase.InitializeObject(DYNO_Frame2, "TSCP700_Screen.fraControlSystem.fraDynanometerControl")
                MyBase.InitializeObject(DYNO_Text, "TSCP700_Screen.fraControlSystem.txtDynanometerControl")
                MyBase.InitializeObject(LB_Frame, "TSCP700_Screen.TSCP700_EngineRun.fraLoadBank")
                MyBase.InitializeObject(LB_Frame2, "TSCP700_Screen.fraControlSystem.fraLoadBankControl")
                MyBase.InitializeObject(LB_Text, "TSCP700_Screen.fraControlSystem.txtLoadBankControl")
                MyBase.InitializeObject(SHPCOR_DSP, "TSCP700_Screen.TSCP700_EngineRun.fraCalculated.dspSHPCOR")
                MyBase.InitializeObject(WaterDynoFrame, "Diagnostic_Screen.fraFacilityReady.fraWaterSystemReady")
                MyBase.InitializeObject(WaterDynoLamp, "Diagnostic_Screen.fraFacilityReady.indWATER_SYSTEM_READY")

                Dim Display_LB As Boolean = False
                Dim Display_Dyno As Boolean = False

                If CELProject.Project.Number = "10726" Then

                    Display_LB = True
                    SHPCOR_DSP.Source = "SHPCOR_HP"

                ElseIf CELProject.Project.Number = "12917" Then

                    If UserInputsRevima.LoadType = "Hydraulic" Then

                        BTN_TARE.Visible = True
                        Display_Dyno = True
                        SHPCOR_DSP.Source = "OUTPUT_POWER_COR_HP_MEAN"

                    ElseIf UserInputsRevima.LoadType = "Electric" Then

                        BTN_TARE.Visible = False
                        Display_LB = True
                        SHPCOR_DSP.Source = "SHPCOR_HP_MEAN"
                        WaterDynoFrame.Visible = False 'in the diagnostic page
                        WaterDynoLamp.Visible = False  'in the diagnostic page

                    Else
                        MessageBox.Show("ConfigHMIforEngine: Load Type Not supported", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    End If
                Else
                    MessageBox.Show("ConfigHMIforEngine: Project Not supported", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                End If

                DYNO_Frame.Visible = Display_Dyno
                DYNO_Frame2.Visible = Display_Dyno
                DYNO_Text.Visible = Display_Dyno
                LB_Frame.Visible = Display_LB
                LB_Frame2.Visible = Display_LB
                LB_Text.Visible = Display_LB

            Catch ex As Exception
                MessageBox.Show("ConfigHMIforEngine: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub


