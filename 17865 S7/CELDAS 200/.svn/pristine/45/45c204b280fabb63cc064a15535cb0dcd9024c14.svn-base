                Dim excelWorksheet As Excel.Worksheet

                If Page = 1 Then
                    excelWorksheet = excelSheets.Item("APU CONDITION TEST SHEET")
                Else
                    excelWorksheet = excelSheets.Item("APU CONDITION TEST SHEET2")
                End If

                excelWorksheet.Cells(13, Column).Value = LOG_PERF_P_BARO_MBARA.Value.ToString(LOG_PERF_P_BARO_MBARA.Format, Nothing)
                excelWorksheet.Cells(14, Column).Value = LOG_PERF_T_INLET_AVG_DEGF.Value.ToString(LOG_PERF_T_INLET_AVG_DEGF.Format, Nothing)
                excelWorksheet.Cells(15, Column).Value = LOG_PERF_T_OIL_DEGF.Value.ToString(LOG_PERF_T_OIL_DEGF.Format, Nothing)
                excelWorksheet.Cells(16, Column).Value = LOG_PERF_T_FUEL_DEGF.Value.ToString(LOG_PERF_T_FUEL_DEGF.Format, Nothing)
                excelWorksheet.Cells(17, Column).Value = LOG_PERF_P_FUEL_PSIG.Value.ToString(LOG_PERF_P_FUEL_PSIG.Format, Nothing)
                excelWorksheet.Cells(18, Column).Value = LOG_PERF_P_FUEL_DSCH_NOZZLE_PSIG.Value.ToString(LOG_PERF_P_FUEL_DSCH_NOZZLE_PSIG.Format, Nothing)
                excelWorksheet.Cells(19, Column).Value = LOG_PERF_P_OIL_PUMP_DSCH_PSIG.Value.ToString(LOG_PERF_P_OIL_PUMP_DSCH_PSIG.Format, Nothing)
                excelWorksheet.Cells(20, Column).Value = LOG_PERF_P_OIL_GB_BREATHER_INHGG.Value.ToString(LOG_PERF_P_OIL_GB_BREATHER_INHGG.Format, Nothing)
                excelWorksheet.Cells(21, Column).Value = LOG_PERF_WF_AVG_PPH.Value.ToString(LOG_PERF_WF_AVG_PPH.Format, Nothing)
                excelWorksheet.Cells(22, Column).Value = LOG_PERF_T_EGT_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_AVG_DEGF.Format, Nothing)
                excelWorksheet.Cells(23, Column).Value = LOG_PERF_T_ETC1_DEGF.Value.ToString(LOG_PERF_T_ETC1_DEGF.Format, Nothing)
                excelWorksheet.Cells(24, Column).Value = LOG_PERF_T_ETC2_DEGF.Value.ToString(LOG_PERF_T_ETC2_DEGF.Format, Nothing)
                excelWorksheet.Cells(25, Column).Value = LOG_PERF_VIB_GEARBOX.Value.ToString(LOG_PERF_VIB_GEARBOX.Format, Nothing)
