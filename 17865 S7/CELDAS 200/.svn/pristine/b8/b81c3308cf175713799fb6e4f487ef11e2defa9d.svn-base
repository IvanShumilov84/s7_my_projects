Namespace StudioDemonstration
	Public Class PWC83032_Sequence
		Inherits CEL.KineticaRT.Sequence.Sequence

		Private CELProject As CELDAS = CELDAS.Instance()

		Private Const sPWCConfigurationPath As String = "C:\Program Files\Pratt & Whitney Canada\PWC83032\configuration\"
		Private Const sConfigurationPath As String = ".\PWC\PWC83032\exe\"

        Private Enum eTestStepPW980A
            MES = 10
            ECS_900 = 11
            ECS_800 = 12
            FINAL_DATA = 13
        End Enum

        Private ReadOnly Property EngineConfiguration() As EngineInformationItem
            Get
                Return UsingConfigurationManager.engineInfoCollection.Item("PW980A")
            End Get
        End Property

		Private Sub CopyConfigurationFiles()
			Dim files As String() = Directory.GetFiles(sPWCConfigurationPath)
			Dim baseFileName, fileName As String

			If Directory.Exists(sConfigurationPath) = True Then
				Directory.Delete(sConfigurationPath, True)
			End If

			Directory.CreateDirectory(sConfigurationPath)

			For Each fileName In files
				baseFileName = Path.GetFileName(fileName)

				File.Copy(fileName, sConfigurationPath + baseFileName)
			Next
		End Sub

        Protected Overrides Sub OnEngineWorkingThread()
            'Do Nothing
        End Sub
		Private Function CreateHandler() As Boolean
			Try
				If CELProject.EngineModel = "PW980A" Then
					AddHandler PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnBTN_TAKE_POINT
                    AddHandler PERF_ENTER_PERFORMANCE_DATA_BTN.ValueChanged, AddressOf OnEnterPerformanceData
                End If

				Return True
			Catch ex As Exception
				MessageBox.Show("PWC83032_Sequence : CreateHandler()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
				Return False
			End Try
		End Function

        Private Function CreateRevimaPerformanceFile(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim Column As Integer
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreateRevimaPerformanceFile = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            Try
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    excelWorksheet = excelSheets.Item("PAGE 1")

                    'HEADER

                    'Serial Number
                    excelWorksheet.Cells(5, 28).NumberFormat = "@"
                    excelWorksheet.Cells(5, 28).Value = UserInputs.EngineSerialNumber

                    'Work Order
                    excelWorksheet.Cells(6, 28).NumberFormat = "@"
                    excelWorksheet.Cells(6, 28).Value = UserInputs.WorkOrder

                    'ECB Serial Number
                    excelWorksheet.Cells(7, 28).NumberFormat = "@"
                    excelWorksheet.Cells(7, 28).Value = UserInputs.ECBSerialNumber

                    'Exhaust Duct Serial Number
                    excelWorksheet.Cells(8, 28).NumberFormat = "@"
                    excelWorksheet.Cells(8, 28).Value = UserInputs.ExhaustDuctSerialNumber

                    'Bellmouth Serial Number
                    excelWorksheet.Cells(9, 28).NumberFormat = "@"
                    excelWorksheet.Cells(9, 28).Value = UserInputs.BellmouthSerialNumber

                    'Bleed Duct Serial Number
                    excelWorksheet.Cells(10, 28).NumberFormat = "@"
                    excelWorksheet.Cells(10, 28).Value = UserInputs.BleedDuctSerialNumber

                    'Starter Serial Number
                    excelWorksheet.Cells(11, 28).NumberFormat = "@"
                    excelWorksheet.Cells(11, 28).Value = UserInputs.StarterSerialNumber

                    'Dyno 1 Serial Number
                    excelWorksheet.Cells(12, 28).NumberFormat = "@"
                    excelWorksheet.Cells(12, 28).Value = UserInputs.Dyno1SerialNumber

                    'Dyno 2 Serial Number
                    excelWorksheet.Cells(13, 28).NumberFormat = "@"
                    excelWorksheet.Cells(13, 28).Value = UserInputs.Dyno2SerialNumber

                    'GG Vibration Pickup Serial Number
                    excelWorksheet.Cells(5, 96).NumberFormat = "@"
                    excelWorksheet.Cells(5, 96).Value = UserInputs.GGVibPickupSerialNumber

                    'LGB Vibration Pickup Serial Number
                    excelWorksheet.Cells(6, 96).NumberFormat = "@"
                    excelWorksheet.Cells(6, 96).Value = UserInputs.LGBVibPickupSerialNumber

                    'Oil Type
                    excelWorksheet.Cells(7, 96).NumberFormat = "@"
                    excelWorksheet.Cells(7, 96).Value = UserInputs.OilType

                    'TSN
                    excelWorksheet.Cells(8, 96).NumberFormat = "@"
                    excelWorksheet.Cells(8, 96).Value = UserInputs.TimeSinceNewOrOverhaul

                    'CSN
                    excelWorksheet.Cells(9, 96).NumberFormat = "@"
                    excelWorksheet.Cells(9, 96).Value = UserInputs.CyclesSinceNew

                    'Reason
                    excelWorksheet.Cells(10, 96).NumberFormat = "@"
                    excelWorksheet.Cells(10, 96).Value = UserInputs.Reason

                    'Test Type
                    excelWorksheet.Cells(11, 96).NumberFormat = "@"
                    excelWorksheet.Cells(11, 96).Value = UserInputs.TestType

                    'Load Cell 1 Serial Number
                    excelWorksheet.Cells(12, 96).NumberFormat = "@"
                    excelWorksheet.Cells(12, 96).Value = UserInputs.LoadCell1SerialNumber

                    'Load Cell 1 Serial Number
                    excelWorksheet.Cells(13, 96).NumberFormat = "@"
                    excelWorksheet.Cells(13, 96).Value = UserInputs.LoadCell2SerialNumber

                    'Date
                    excelWorksheet.Cells(14, 96).NumberFormat = "@"
                    excelWorksheet.Cells(14, 96).Value = Format(Now, "d MMMM yyyy")

                    excelWorksheet = excelSheets.Item("ACCEPTANCE")

                    'Document Number
                    excelWorksheet.Cells(31, 5).NumberFormat = "@"
                    excelWorksheet.Cells(31, 5).Value = excelWorksheet.Cells(31, 5).Value.ToString() + Custom_Parameters("APUTestedAccordingTo").ToString()

                End If

                ' Wait 0.5 second to let the dll to compute before putting the limits in the report
                Thread.Sleep(500)
                'Page 1
                excelWorksheet = excelSheets.Item("PAGE 1")
                Select Case TestStepNumber
                    ' PERFORMANCE SUMMARY
                    Case eTestStepPW980A.ECS_800
                        Column = 53
                        excelWorksheet.Cells(28, Column).Value = PERF_N2_LIMIT_RPM.Value.ToString(PERF_N2_LIMIT_RPM.Format, Nothing)
                        excelWorksheet.Cells(29, Column).Value = PERF_T_T7_AVG_LIMIT_DEGC.Value.ToString(PERF_T_T7_AVG_LIMIT_DEGC.Format, Nothing)
                        excelWorksheet.Cells(30, Column).Value = PERF_WF_LIMIT_PPH.Value.ToString(PERF_WF_LIMIT_PPH.Format, Nothing)

                        excelWorksheet.Cells(32, Column).Value = PERF_P_P17_AVG_LIMIT_PSIA.Value.ToString(PERF_P_P17_AVG_LIMIT_PSIA.Format, Nothing)
                        excelWorksheet.Cells(33, Column).Value = PERF_W17_LIMIT_LBMIN.Value.ToString(PERF_W17_LIMIT_LBMIN.Format, Nothing)

                        Column = 67
                        excelWorksheet.Cells(22, Column).Value = LOG_PERF_P_P09_AVG_PSIA.Value.ToString("F2", Nothing)
                        excelWorksheet.Cells(23, Column).Value = LOG_PERF_T_T09_AVG_DEGC.Value.ToString(LOG_PERF_T_T09_AVG_DEGC.Format, Nothing)
                        excelWorksheet.Cells(24, Column).Value = LOG_PERF_E_IGVACT_PCT.Value.ToString(LOG_PERF_E_IGVACT_PCT.Format, Nothing)
                        excelWorksheet.Cells(25, Column).Value = LOG_PERF_W17C.Value.ToString(LOG_PERF_W17C.Format, Nothing)
                        excelWorksheet.Cells(26, Column).Value = LOG_PERF_LOAD_TOTAL_KVA.Value.ToString(LOG_PERF_LOAD_TOTAL_KVA.Format, Nothing)

                        excelWorksheet.Cells(28, Column).Value = LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing)
                        excelWorksheet.Cells(29, Column).Value = LOG_PERF_E_EGT_DEGC.Value.ToString(LOG_PERF_E_EGT_DEGC.Format, Nothing)
                        excelWorksheet.Cells(30, Column).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)

                        excelWorksheet.Cells(32, Column).Value = LOG_PERF_P_P17_AVG_PSIA.Value.ToString("F2", Nothing)
                        excelWorksheet.Cells(33, Column).Value = LOG_PERF_W17_LBMIN.Value.ToString(LOG_PERF_W17_LBMIN.Format, Nothing)

                    Case eTestStepPW980A.ECS_900
                        Column = 81
                        excelWorksheet.Cells(28, Column).Value = PERF_N2_LIMIT_RPM.Value.ToString(PERF_N2_LIMIT_RPM.Format, Nothing)
                        excelWorksheet.Cells(29, Column).Value = PERF_T_T7_AVG_LIMIT_DEGC.Value.ToString(PERF_T_T7_AVG_LIMIT_DEGC.Format, Nothing)
                        excelWorksheet.Cells(30, Column).Value = PERF_WF_LIMIT_PPH.Value.ToString(PERF_WF_LIMIT_PPH.Format, Nothing)

                        excelWorksheet.Cells(32, Column).Value = PERF_P_P17_AVG_LIMIT_PSIA.Value.ToString(PERF_P_P17_AVG_LIMIT_PSIA.Format, Nothing)
                        excelWorksheet.Cells(33, Column).Value = PERF_W17_LIMIT_LBMIN.Value.ToString(PERF_W17_LIMIT_LBMIN.Format, Nothing)

                        Column = 95
                        excelWorksheet.Cells(22, Column).Value = LOG_PERF_P_P09_AVG_PSIA.Value.ToString("F2", Nothing)
                        excelWorksheet.Cells(23, Column).Value = LOG_PERF_T_T09_AVG_DEGC.Value.ToString(LOG_PERF_T_T09_AVG_DEGC.Format, Nothing)
                        excelWorksheet.Cells(24, Column).Value = LOG_PERF_E_IGVACT_PCT.Value.ToString(LOG_PERF_E_IGVACT_PCT.Format, Nothing)
                        excelWorksheet.Cells(25, Column).Value = LOG_PERF_W17C.Value.ToString(LOG_PERF_W17C.Format, Nothing)
                        excelWorksheet.Cells(26, Column).Value = LOG_PERF_LOAD_TOTAL_KVA.Value.ToString(LOG_PERF_LOAD_TOTAL_KVA.Format, Nothing)

                        excelWorksheet.Cells(28, Column).Value = LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing)
                        excelWorksheet.Cells(29, Column).Value = LOG_PERF_E_EGT_DEGC.Value.ToString(LOG_PERF_E_EGT_DEGC.Format, Nothing)
                        excelWorksheet.Cells(30, Column).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)

                        excelWorksheet.Cells(32, Column).Value = LOG_PERF_P_P17_AVG_PSIA.Value.ToString("F2", Nothing)
                        excelWorksheet.Cells(33, Column).Value = LOG_PERF_W17_LBMIN.Value.ToString(LOG_PERF_W17_LBMIN.Format, Nothing)

                    Case eTestStepPW980A.MES
                        Column = 109
                        excelWorksheet.Cells(32, Column).Value = PERF_P_P17_AVG_LIMIT_PSIA.Value.ToString(PERF_P_P17_AVG_LIMIT_PSIA.Format, Nothing)

                        Column = 123
                        excelWorksheet.Cells(22, Column).Value = LOG_PERF_P_P09_AVG_PSIA.Value.ToString("F2", Nothing)
                        excelWorksheet.Cells(23, Column).Value = LOG_PERF_T_T09_AVG_DEGC.Value.ToString(LOG_PERF_T_T09_AVG_DEGC.Format, Nothing)
                        excelWorksheet.Cells(24, Column).Value = LOG_PERF_E_IGVACT_PCT.Value.ToString(LOG_PERF_E_IGVACT_PCT.Format, Nothing)
                        excelWorksheet.Cells(25, Column).Value = LOG_PERF_W17C.Value.ToString(LOG_PERF_W17C.Format, Nothing)
                        excelWorksheet.Cells(26, Column).Value = LOG_PERF_LOAD_TOTAL_KVA.Value.ToString(LOG_PERF_LOAD_TOTAL_KVA.Format, Nothing)

                        excelWorksheet.Cells(28, Column).Value = LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing)
                        excelWorksheet.Cells(29, Column).Value = LOG_PERF_E_EGT_DEGC.Value.ToString(LOG_PERF_E_EGT_DEGC.Format, Nothing)
                        excelWorksheet.Cells(30, Column).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)

                        excelWorksheet.Cells(32, Column).Value = LOG_PERF_P_P17_AVG_PSIA.Value.ToString("F2", Nothing)
                        excelWorksheet.Cells(33, Column).Value = LOG_PERF_W17_LBMIN.Value.ToString(LOG_PERF_W17_LBMIN.Format, Nothing)

                    Case eTestStepPW980A.FINAL_DATA
                        ' STARTING
                        Column = 52
                        excelWorksheet.Cells(36, Column).Value = PERF_T09_AVG.Value.ToString(PERF_T09_AVG.Format, Nothing)
                        excelWorksheet.Cells(37, Column).Value = PERF_MAX_EGT.Value.ToString(PERF_MAX_EGT.Format, Nothing)
                        excelWorksheet.Cells(38, Column).Value = PERF_TIME_TO_LIGHT.Value.ToString(PERF_TIME_TO_LIGHT.Format, Nothing)
                        excelWorksheet.Cells(39, Column).Value = PERF_TIME_TO_NO_LOAD.Value.ToString(PERF_TIME_TO_NO_LOAD.Format, Nothing)

                        ' DATA PLATE INFORMATION
                        Column = 120
                        excelWorksheet.Cells(36, Column).Value = PERF_ENGINE_DRY_WEIGHT.Value.ToString(PERF_ENGINE_DRY_WEIGHT.Format, Nothing)
                        excelWorksheet.Cells(38, Column).Value = PERF_EGT_TRIM.Value.ToString(PERF_EGT_TRIM.Format, Nothing)
                End Select
                TestProgress_RecordPerfStep(TestStepNumber)

                'Page 2 And Acceptance
                Select Case TestStepNumber

                    Case eTestStepPW980A.FINAL_DATA

                        excelWorksheet = excelSheets.Item("PAGE 2")

                        ' ADDITIONAL INFORMATION
                        Column = 52
                        excelWorksheet.Cells(6, Column).Value = UserInputs.LHV
                        excelWorksheet.Cells(7, Column).Value = PERF_ENGINE_OIL_PRESSURE.Value.ToString(PERF_ENGINE_OIL_PRESSURE.Format, Nothing)
                        excelWorksheet.Cells(8, Column).Value = PERF_GEN_OIL_PRESSURE.Value.ToString(PERF_GEN_OIL_PRESSURE.Format, Nothing)

                        Column = 120
                        excelWorksheet.Cells(6, Column).Value = PERF_IGV_TRIM_MES.Value.ToString(PERF_IGV_TRIM_MES.Format, Nothing)
                        excelWorksheet.Cells(7, Column).Value = PERF_IGV_TRIM_ECS_800.Value.ToString(PERF_IGV_TRIM_ECS_800.Format, Nothing)
                        excelWorksheet.Cells(8, Column).Value = PERF_IGV_TRIM_ECS_900.Value.ToString(PERF_IGV_TRIM_ECS_900.Format, Nothing)

                        ' TRANSITIONS
                        Column = 103
                        If CELProject.IsTrue(PERF_RTL_TO_MES.Value) Then
                            excelWorksheet.Cells(11, Column).Value = "YES"
                        Else
                            excelWorksheet.Cells(11, Column).Value = "NO"
                        End If

                        If CELProject.IsTrue(PERF_MES_TO_ECS.Value) Then
                            excelWorksheet.Cells(12, Column).Value = "YES"
                        Else
                            excelWorksheet.Cells(12, Column).Value = "NO"
                        End If

                        If CELProject.IsTrue(PERF_MIN_TO_MAX_ECS.Value) Then
                            excelWorksheet.Cells(13, Column).Value = "YES"
                        Else
                            excelWorksheet.Cells(13, Column).Value = "NO"
                        End If

                        If CELProject.IsTrue(PERF_ELECT_LOAD_SHED.Value) Then
                            excelWorksheet.Cells(14, Column).Value = "YES"
                        Else
                            excelWorksheet.Cells(14, Column).Value = "NO"
                        End If

                        ' MISCELLANEOUS CHECKS
                        Column = 103
                        If CELProject.IsTrue(PERF_CHIP_DETECTION.Value) Then
                            excelWorksheet.Cells(17, Column).Value = "YES"
                        Else
                            excelWorksheet.Cells(17, Column).Value = "NO"
                        End If

                        If CELProject.IsTrue(PERF_FILTER_CHECK.Value) Then
                            excelWorksheet.Cells(18, Column).Value = "YES"
                        Else
                            excelWorksheet.Cells(18, Column).Value = "NO"
                        End If

                        If CELProject.IsTrue(PERF_LEAKAGE_CHECK.Value) Then
                            excelWorksheet.Cells(19, Column).Value = "YES"
                        Else
                            excelWorksheet.Cells(19, Column).Value = "NO"
                        End If

                        If CELProject.IsTrue(PERF_N1_RUNDOWN_TIME.Value) Then
                            excelWorksheet.Cells(20, Column).Value = "YES"
                        Else
                            excelWorksheet.Cells(20, Column).Value = "NO"
                        End If

                        If CELProject.IsTrue(PERF_N2_RUNDOWN_TIME.Value) Then
                            excelWorksheet.Cells(21, Column).Value = "YES"
                        Else
                            excelWorksheet.Cells(21, Column).Value = "NO"
                        End If

                        ' VIBRATION DATA
                        Column = 103
                        excelWorksheet.Cells(27, Column).Value = PERF_VIB_LIGHT_UP_TO_NO_LOAD_1EN1.Value.ToString(PERF_VIB_LIGHT_UP_TO_NO_LOAD_1EN1.Format, Nothing)
                        excelWorksheet.Cells(28, Column).Value = PERF_VIB_LIGHT_UP_TO_NO_LOAD_1EN2.Value.ToString(PERF_VIB_LIGHT_UP_TO_NO_LOAD_1EN2.Format, Nothing)
                        excelWorksheet.Cells(29, Column).Value = PERF_VIB_N2_RUN_UP_TO_MAX_SPEED_1EN2.Value.ToString(PERF_VIB_N2_RUN_UP_TO_MAX_SPEED_1EN2.Format, Nothing)
                        excelWorksheet.Cells(30, Column).Value = PERF_VIB_N2_RUN_UP_TO_MAX_SPEED_0_925EN2.Value.ToString(PERF_VIB_N2_RUN_UP_TO_MAX_SPEED_0_925EN2.Format, Nothing)
                        excelWorksheet.Cells(31, Column).Value = PERF_VIB_STEADY_STATE_AT_MAX_N2_1EN1.Value.ToString(PERF_VIB_STEADY_STATE_AT_MAX_N2_1EN1.Format, Nothing)
                        excelWorksheet.Cells(32, Column).Value = PERF_VIB_STEADY_STATE_AT_MAX_N2_1EN2.Value.ToString(PERF_VIB_STEADY_STATE_AT_MAX_N2_1EN2.Format, Nothing)
                        excelWorksheet.Cells(33, Column).Value = PERF_VIB_STEADY_STATE_AT_MAX_N2_0_925EN2.Value.ToString(PERF_VIB_STEADY_STATE_AT_MAX_N2_0_925EN2.Format, Nothing)

                        excelWorksheet.Cells(35, Column).Value = PERF_VIB_STEADY_STATE_AT_MAX_N2_39EN1.Value.ToString(PERF_VIB_STEADY_STATE_AT_MAX_N2_39EN1.Format, Nothing)

                        excelWorksheet = excelSheets.Item("ACCEPTANCE")

                        'Test Result
                        If CELProject.IsTrue(PERF_TEST_RESULT_ACCEPTED.Value) Then
                            excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                        Else
                            excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                        End If

                        If CELProject.IsTrue(PERF_TEST_RESULT_REJECTED.Value) Then
                            excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                        Else
                            excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                        End If
                    Case Else
                        ' Do Nothing
                End Select

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreateRevimaPerformanceFile: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreateRevimaPerformanceFile = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)

            End Try

        End Function

		Private Function DeleteHandler() As Boolean
			Try
                If Not CELProject.EngineModel Is Nothing Then
                    If CELProject.EngineModel = "PW980A" Then
                        If Not PERF_TAKE_POINT_BTN Is Nothing Then
                            RemoveHandler PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnBTN_TAKE_POINT
                        End If

                        If Not (PERF_ENTER_PERFORMANCE_DATA_BTN Is Nothing) Then
                            RemoveHandler PERF_ENTER_PERFORMANCE_DATA_BTN.ValueChanged, AddressOf OnEnterPerformanceData
                        End If
                    End If
                End If

				Return True
			Catch ex As Exception
				MessageBox.Show("PWC83032_Sequence : DeleteHandler()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
				Return False
			End Try
		End Function

        Private Function GetOutputFilename() As String
            Dim conditionNo As Integer
            Dim engineBuildNo As Integer
            Dim engineSN As String = ""
            Dim fileName As String
            Dim sDataPath As String = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(1).Value.ToString() + "\perf\"

            pwc83032.GetEngine(engineSN)
            pwc83032.GetBuild(engineBuildNo)
            pwc83032.GetCondition(conditionNo)

            fileName = sDataPath + "OUT_" + engineSN + "_" + Format(engineBuildNo, "0000") + _
                "_" + Format(conditionNo, "0000") + ".DAT"

            Return fileName
        End Function


		Private Function Init_Engine_Channels() As Boolean
			Dim Return_Value As New ArrayList()
            Dim i As Integer

			Return_Value.Clear()

			Try

				Select Case CELProject.EngineModel
					'Not For "DAS CALIBRATION"
					Case "PW980A"
						'Initialise Engine Channels		

                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_E_EGT_DEGC, "LOG_PERF_E_EGT_DEGC"))
						Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_E_IGVACT_PCT, "LOG_PERF_E_IGVACT_PCT"))
						Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_E_PAMB_PSIA, "LOG_PERF_E_PAMB_PSIA"))
						Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_E_Q13, "LOG_PERF_E_Q13"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_E_Q13REF, "LOG_PERF_E_Q13REF"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_E_Q13REF_TO_DLL, "LOG_PERF_E_Q13REF_TO_DLL"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_E_SCVPOS_PCT, "LOG_PERF_E_SCVPOS_PCT"))
						Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_LOAD_DYNO_1_KVA, "LOG_PERF_LOAD_DYNO_1_KVA"))
						Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_LOAD_DYNO_2_KVA, "LOG_PERF_LOAD_DYNO_2_KVA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_LOAD_TOTAL_KVA, "LOG_PERF_LOAD_TOTAL_KVA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_N1_RPM, "LOG_PERF_N1_RPM"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_N2_RPM, "LOG_PERF_N2_RPM"))

                        For i = 0 To LOG_PERF_P_P09_PSIA.GetUpperBound(0) - 1
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_P09_PSIA(i), "LOG_PERF_P_P09_" + (i + 1).ToString() + "_PSIA"))
                        Next

                        For i = 0 To LOG_PERF_P_P17_PSIA.GetUpperBound(0) - 1
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_P17_PSIA(i), "LOG_PERF_P_P17_" + (i + 1).ToString() + "_PSIA"))
                        Next

                        For i = 0 To LOG_PERF_P_S7_PSIA.GetUpperBound(0) - 1
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_S7_PSIA(i), "LOG_PERF_P_S7_" + (i + 1).ToString() + "_PSIA"))
                        Next

                        For i = 0 To LOG_PERF_P_S79_PSIA.GetUpperBound(0) - 1
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_S79_PSIA(i), "LOG_PERF_P_S79_" + (i + 1).ToString() + "_PSIA"))
                        Next

                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_P09_AVG_PSIA, "LOG_PERF_P_P09_AVG_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_P17_AVG_PSIA, "LOG_PERF_P_P17_AVG_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_S7_AVG_PSIA, "LOG_PERF_P_S7_AVG_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_S79_AVG_PSIA, "LOG_PERF_P_S79_AVG_PSIA"))
						Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_BARO_PSIA, "LOG_PERF_P_BARO_PSIA"))
