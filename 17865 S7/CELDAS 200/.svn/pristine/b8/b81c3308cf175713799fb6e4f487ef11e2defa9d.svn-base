                        Return_Value.Add(MyBase.InitializeChannel(PERF_EGT_TRIM, "PERF_EGT_TRIM"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_ELECT_LOAD_SHED, "PERF_ELECT_LOAD_SHED"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_ENGINE_DRY_WEIGHT, "PERF_ENGINE_DRY_WEIGHT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_ENGINE_OIL_PRESSURE, "PERF_ENGINE_OIL_PRESSURE"))
