                        Return_Value.Add(MyBase.InitializeChannel(PERF_T_T7_AVG_LIMIT_DEGC, "PERF_T_T7_AVG_LIMIT_DEGC"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_T09_AVG, "PERF_T09_AVG"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_TEST_RESULT_ACCEPTED, "PERF_TEST_RESULT_ACCEPTED"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_TEST_RESULT_REJECTED, "PERF_TEST_RESULT_REJECTED"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_TEST_STEP_NB, "PERF_TEST_STEP_NB"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_TIME_TO_LIGHT, "PERF_TIME_TO_LIGHT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_TIME_TO_NO_LOAD, "PERF_TIME_TO_NO_LOAD"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_VIB_LIGHT_UP_TO_NO_LOAD_1EN1, "PERF_VIB_LIGHT_UP_TO_NO_LOAD_1EN1"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_VIB_LIGHT_UP_TO_NO_LOAD_1EN2, "PERF_VIB_LIGHT_UP_TO_NO_LOAD_1EN2"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_VIB_N2_RUN_UP_TO_MAX_SPEED_0_925EN2, "PERF_VIB_N2_RUN_UP_TO_MAX_SPEED_0_925EN2"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_VIB_N2_RUN_UP_TO_MAX_SPEED_1EN2, "PERF_VIB_N2_RUN_UP_TO_MAX_SPEED_1EN2"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_VIB_STEADY_STATE_AT_MAX_N2_0_925EN2, "PERF_VIB_STEADY_STATE_AT_MAX_N2_0_925EN2"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_VIB_STEADY_STATE_AT_MAX_N2_1EN1, "PERF_VIB_STEADY_STATE_AT_MAX_N2_1EN1"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_VIB_STEADY_STATE_AT_MAX_N2_1EN2, "PERF_VIB_STEADY_STATE_AT_MAX_N2_1EN2"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_VIB_STEADY_STATE_AT_MAX_N2_39EN1, "PERF_VIB_STEADY_STATE_AT_MAX_N2_39EN1"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_W17_LIMIT_LBMIN, "PERF_W17_LIMIT_LBMIN"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_WF_LIMIT_PPH, "PERF_WF_LIMIT_PPH"))

                        For i = 0 To T_T09_DELETE_BTN.GetUpperBound(0) - 1
                            Return_Value.Add(MyBase.InitializeChannel(T_T09_DELETE_BTN(i), "T_T09_" + (i + 1).ToString() + "_DELETE_BTN"))
                        Next

                        For i = 0 To T_T17_DELETE_BTN.GetUpperBound(0) - 1
                            Return_Value.Add(MyBase.InitializeChannel(T_T17_DELETE_BTN(i), "T_T17_" + (i + 1).ToString() + "_DELETE_BTN"))
                        Next

                        For i = 0 To T_T7_DELETE_BTN.GetUpperBound(0) - 1
                            Return_Value.Add(MyBase.InitializeChannel(T_T7_DELETE_BTN(i), "T_T7_" + (i + 1).ToString() + "_DELETE_BTN"))
                        Next

                        Return_Value.Add(MyBase.InitializeChannel(T_T7_AVG_LIMIT_DEGC, "T_T7_AVG_LIMIT_DEGC"))
                        Return_Value.Add(MyBase.InitializeChannel(W17_LIMIT_LBSEC, "W17_LIMIT_LBSEC"))
                        Return_Value.Add(MyBase.InitializeChannel(WF_LIMIT_PPH, "WF_LIMIT_PPH"))
                        Return_Value.Add(MyBase.InitializeChannel(OPERATING_TIME_CURRENT_SEC, "OPERATING_TIME_CURRENT_SEC"))
                        Return_Value.Add(MyBase.InitializeChannel(FUEL_USED_TOTAL_LITERS, "FUEL_USED_TOTAL_LITERS"))

                End Select

			Catch ex As Exception
				MessageBox.Show("Init_Engine_Channels: " & ex.Message)
				Return_Value.Add(False)
			Finally

			End Try

			If Return_Value.Contains(False) Then
				Init_Engine_Channels = False
			Else
				Init_Engine_Channels = True
			End If
		End Function


		Private Function Initialize() As Boolean
			Try

				PERF_REMARK_TEXT.Value = New KineticaRT.Values.Text("")

				Return True

			Catch Ex As Exception
				MessageBox.Show("PWC83032_Sequence : Initialize()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
				Return False
			End Try
		End Function

        Private Function Initialize_Perf() As Boolean
            Dim iError As Integer
            Dim sDataPath As String = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(1).Value.ToString() + "\perf\"

            Try

                CopyConfigurationFiles()

                pwc83032.SetDataPath(sDataPath)
                pwc83032.SetConfigurationPath(sConfigurationPath)

                pwc83032.SetStatus(UserInputs.Status)

                pwc83032.LoadBuildSpec(iError, UserInputs.BuildSpec, "X", "X")

                If iError <> 0 Then
                    MessageBox.Show("PWC83032_Sequence : Initialize_Perf() Couldn't load Build Spec", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)

                    Return False
                Else
                    pwc83032.SetEngine(UserInputs.EngineSerialNumber)

                    pwc83032.SetBuild(UserInputs.Build)
                    Return True
                End If

            Catch Ex As Exception
                MessageBox.Show("PWC83032_Sequence : Initialize_Perf() : Cannot communicate with P&WC DLL Processing Server" & vbCrLf & vbCrLf & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        Private Sub ProcessCondition()
            Dim Cond_nb As Integer
            Dim FileName As String
            Dim iError As Integer

            Try
                pwc83032.CalOn()

                If PERF_CONDITION_NUMBER.Value.ToDouble() < 10.0 Then 'Not a Performance point
                    pwc83032.SetCal(1)
                Else
                    pwc83032.SetCal(2)
                End If

                Cond_nb = CInt(PERF_CONDITION_NUMBER.Value.ToDouble())
                pwc83032.SetCondition(Cond_nb)

                Dim EngineModel As String = ""
                Dim BuildSpec As Integer
                Dim EngineSN As String = ""
                Dim Build As Integer
                Dim Condition As Integer
                Dim Result As Single

                'Inputs validation
                pwc83032.GetEngineModel(EngineModel)
                If EngineModel <> CELProject.EngineModel Then
                    MessageBox.Show("PWC83032_Sequence : ProcessCondition() Engine Model input is incorrect", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                End If
                pwc83032.GetBuildSpec(BuildSpec)
                If BuildSpec <> UserInputs.BuildSpec Then
                    MessageBox.Show("PWC83032_Sequence : ProcessCondition() Build Spec input is incorrect", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                End If
                pwc83032.GetEngine(EngineSN)
                If EngineSN <> UserInputs.EngineSerialNumber Then
                    MessageBox.Show("PWC83032_Sequence : ProcessCondition() Engine S/N input is incorrect", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                End If
                pwc83032.GetBuild(Build)
                If Build <> UserInputs.Build Then
                    MessageBox.Show("PWC83032_Sequence : ProcessCondition() Engine Build input is incorrect", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                End If
                pwc83032.GetCondition(Condition)
                If Condition <> Cond_nb Then
                    MessageBox.Show("PWC83032_Sequence : ProcessCondition() Condition input is incorrect", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                End If

                pwc83032.GetUnitData(iError)
                SetUnitValues()
                pwc83032.SaveUnitData(iError)

                If SubmitPerfValues() Then
                    pwc83032.SaveData(iError)

                    pwc83032.OutputData()
                    pwc83032.TransferData(iError)
                    pwc83032.ProcessData(iError)
                    pwc83032.CloseOutputData()

                    pwc83032.GetResult("1ZN2", Result)
                    N2_LIMIT_RPM.Value = New KineticaRT.Values.Double(Result)

                    pwc83032.GetResult("1ZP17", Result)
                    P_P17_AVG_LIMIT_PSIA.Value = New KineticaRT.Values.Double(Result)

                    pwc83032.GetResult("1ZEGT", Result)
                    T_T7_AVG_LIMIT_DEGC.Value = New KineticaRT.Values.Double(Result)

                    pwc83032.GetResult("1ZW17", Result)
                    W17_LIMIT_LBSEC.Value = New KineticaRT.Values.Double(Result)

                    pwc83032.GetResult("1ZWFE", Result)
                    WF_LIMIT_PPH.Value = New KineticaRT.Values.Double(Result)

                    If (iError = 0) Then
                        FileName = GetOutputFilename()

                        PerfFileName = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + UserInputs.EngineSerialNumber + "\" + UserInputs.WorkOrder + "\Perf\" + "Performance " + Format(Now, "yyyy-MM-dd HH'h'mm'm'ss's'") + ".txt"

                        If (System.IO.File.Exists(PerfFileName)) Then
                            System.IO.File.Delete(PerfFileName)
                        End If

                        System.IO.File.Copy(FileName, PerfFileName)
                        ShowOutputFile(FileName)
                    Else
                        MessageBox.Show("UNEXPECTED ERROR:" + vbCrLf + "==== ERROR PROCESSING CONDITION ====" + vbCrLf)
                        ShowOutputFile("Pwc83032TEMP.OUT")
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("PWC83032_Sequence : ProcessCondition() : Cannot communicate with P&WC DLL Processing Server" & vbCrLf & vbCrLf & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub SampleValues(isPerfEntry As Boolean)
            Try

                'Temperature and Pressure
                Var_LOG_PERF_P_P09_AVG_PSIA = LOG_PERF_P_P09_AVG_PSIA.Value.ToDouble()
                Var_LOG_PERF_P_P17_AVG_PSIA = LOG_PERF_P_P17_AVG_PSIA.Value.ToDouble()
                Var_LOG_PERF_P_S7_AVG_PSIA = LOG_PERF_P_S7_AVG_PSIA.Value.ToDouble()
                Var_LOG_PERF_P_S79_AVG_PSIA = LOG_PERF_P_S79_AVG_PSIA.Value.ToDouble()
                Var_LOG_PERF_T_T09_AVG_DEGF = LOG_PERF_T_T09_AVG_DEGF.Value.ToDouble()
                Var_LOG_PERF_T_T7_AVG_DEGF = LOG_PERF_T_T7_AVG_DEGF.Value.ToDouble()
                Var_LOG_PERF_T_T17_AVG_DEGF = LOG_PERF_T_T17_AVG_DEGF.Value.ToDouble()

            Catch ex As Exception
                MessageBox.Show("PWC83032_Sequence : SampleValues()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub SetUnitValues()
            Dim i As Integer

            For i = UnitValues.GetLowerBound(0) To UnitValues.GetUpperBound(0)
                If Not pwc83032.PutUnitValue(UnitValues(i, 0), UnitValues(i, 1)) Then
                    MessageBox.Show("SetUnitValues: Unknown label Or unit '" + _
                        UnitValues(i, 0) + "' (" + UnitValues(i, 1) + ")")
                End If
            Next
        End Sub

        Private Sub ShowOutputFile(fileName As String)
            Dim DetailsForm As CEL.Forms.DisplayFile = Nothing

            Try
                DetailsForm = New CEL.Forms.DisplayFile(fileName)

                DetailsForm.MinimizeBox = False
                DetailsForm.MaximizeBox = False
                DetailsForm.Text = fileName
                DetailsForm.ShowDialog()
            Catch e As Exception
                MsgBox(e.ToString(), MsgBoxStyle.OkOnly Or MsgBoxStyle.Critical, _
                    fileName)
            Finally
                If (Not (DetailsForm Is Nothing)) Then
                    DetailsForm.Dispose()
                End If
            End Try
        End Sub

        Private Function SubmitPerfValues() As Boolean

            Dim i As Integer

            'LHV
            If Not pwc83032.PutValue("LHV", UserInputs.LHV, "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering LHV")
                Return False
            End If

            'TSG
            If Not pwc83032.PutValue("TSG", LOG_PERF_SAMPLE_T_FUEL.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering TSG")
                Return False
            End If

            'SG & SGBASE
            If Not pwc83032.PutValue("SG", LOG_PERF_SAMPLE_SG_FUEL.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering SG")
                Return False
            End If

            If Not pwc83032.PutValue("SG_BASE", LOG_PERF_TFV_SG_BASE.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering SG_BASE")
                Return False
            End If

            'T/C ID
            If Not pwc83032.PutValue("CELL", "REVIMA", "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering CELL")
                Return False
            End If

            'CONDITION NUMBER
            If Not pwc83032.PutValue("COND_TYPE_NUM", PERF_CONDITION_NUMBER.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering COND_TYPE_NUM")
                Return False
            End If

            'DATE & TIME
            If Not pwc83032.PutValue("DATE", Format(Now, "yyyy/MM/dd"), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering DATE")
                Return False
            End If
            If Not pwc83032.PutValue("TIME", Format(Now, "HH:MM"), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering TIME")
                Return False
            End If

            'REMARK
            If Not pwc83032.PutValue("REMARK", PERF_REMARK_TEXT.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering REMARK")
                Return False
            End If

            'SPEEDS
            If Not pwc83032.PutValue("N1", LOG_PERF_N1_RPM.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering N1")
                Return False
            End If

            If Not pwc83032.PutValue("N2", LOG_PERF_N2_RPM.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering N2")
                Return False
            End If

            'FUEL FLOWS
            'We feed a WF Perf specifically for PWC software : Volumetric value x 8.3378 (water density at 60F) x SG_BASE x 60
            If Not pwc83032.PutValue("WF1", LOG_PERF_WF_PPH_PERF.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering WF1")
                Return False
            End If

            If Not pwc83032.PutValue("WF2", LOG_PERF_WF_PPH_PERF.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering WF2")
                Return False
            End If

            'FUEL TEMPERATURE
            If Not pwc83032.PutValue("WFT1", LOG_PERF_T_FUEL_FM1_DEGF.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering WFT1")
                Return False
            End If

            If Not pwc83032.PutValue("WFT2", LOG_PERF_T_FUEL_FM1_DEGF.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering WFT2")
                Return False
            End If

            'BLEED FLOW
            If Not pwc83032.PutValue("W17", LOG_PERF_W17_LBSEC.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering W17")
                Return False
            End If

            'BARO
            If Not pwc83032.PutValue("BARO", LOG_PERF_P_BARO_PSIA.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering BARO")
                Return False
            End If

            'INLET GUIDE VALVE
            If Not pwc83032.PutValue("VIGV", LOG_PERF_E_IGVACT_PCT.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering VIGV")
                Return False
            End If

            'GENERATOR LOAD
            If Not pwc83032.PutValue("ACGEN1", LOG_PERF_LOAD_DYNO_1_KVA.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering ACGEN1")
                Return False
            End If

            If Not pwc83032.PutValue("ACGEN2", LOG_PERF_LOAD_DYNO_2_KVA.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering ACGEN2")
                Return False
            End If

            'INLET PRESSURE (P1) -- 8 PROBES
            For i = 0 To P_P09_DELETE_BTN.GetUpperBound(0) - 1

                If CELProject.IsTrue(P_P09_DELETE_BTN(i).Value) Then
                    If Not pwc83032.PutValue("P1", Var_LOG_PERF_P_P09_AVG_PSIA.ToString(), (i + 1).ToString()) Then
                        MessageBox.Show("SubmitPerfValues: Error on entering P1 Average (" + (i + 1).ToString() + ") - Deleted")
                        Return False
                    End If
                Else
                    If Not pwc83032.PutValue("P1", LOG_PERF_P_P09_PSIA(i).Value.ToString(), (i + 1).ToString()) Then
                        MessageBox.Show("SubmitPerfValues: Error on entering P1(" + (i + 1).ToString() + ")")
                        Return False
                    End If
                End If

            Next

            'EXHAUST PRESSURE (P7) -- 4 PROBES
            For i = 0 To P_S7_DELETE_BTN.GetUpperBound(0) - 1

                If CELProject.IsTrue(P_S7_DELETE_BTN(i).Value) Then
                    If Not pwc83032.PutValue("P7", Var_LOG_PERF_P_S7_AVG_PSIA.ToString(), (i + 1).ToString()) Then
                        MessageBox.Show("SubmitPerfValues: Error on entering P7 Average (" + (i + 1).ToString() + ") - Deleted")
                        Return False
                    End If
                Else
                    If Not pwc83032.PutValue("P7", LOG_PERF_P_S7_PSIA(i).Value.ToString(), (i + 1).ToString()) Then
                        MessageBox.Show("SubmitPerfValues: Error on entering P7(" + (i + 1).ToString() + ")")
                        Return False
                    End If
                End If

            Next

            'EXHAUST PRESSURE (P8) -- 4 PROBES
            For i = 0 To P_S79_DELETE_BTN.GetUpperBound(0) - 1

                If CELProject.IsTrue(P_S79_DELETE_BTN(i).Value) Then
                    If Not pwc83032.PutValue("P8", Var_LOG_PERF_P_S79_AVG_PSIA.ToString(), (i + 1).ToString()) Then
                        MessageBox.Show("SubmitPerfValues: Error on entering P8 Average (" + (i + 1).ToString() + ") - Deleted")
                        Return False
                    End If
                Else
                    If Not pwc83032.PutValue("P8", LOG_PERF_P_S79_PSIA(i).Value.ToString(), (i + 1).ToString()) Then
                        MessageBox.Show("SubmitPerfValues: Error on entering P8(" + (i + 1).ToString() + ")")
                        Return False
                    End If
                End If

            Next

            'BLEED PRESSURE (P17) -- 8 PROBES
            For i = 0 To P_P17_DELETE_BTN.GetUpperBound(0) - 1

                If CELProject.IsTrue(P_P17_DELETE_BTN(i).Value) Then
                    If Not pwc83032.PutValue("P17", Var_LOG_PERF_P_P17_AVG_PSIA.ToString(), (i + 1).ToString()) Then
                        MessageBox.Show("SubmitPerfValues: Error on entering P17 Average (" + (i + 1).ToString() + ") - Deleted")
                        Return False
                    End If
                Else
                    If Not pwc83032.PutValue("P17", LOG_PERF_P_P17_PSIA(i).Value.ToString(), (i + 1).ToString()) Then
                        MessageBox.Show("SubmitPerfValues: Error on entering P17(" + (i + 1).ToString() + ")")
                        Return False
                    End If
                End If

            Next

            'INLET TEMPERATURE (T1) -- 12 PROBES
            For i = 0 To T_T09_DELETE_BTN.GetUpperBound(0) - 1

                If CELProject.IsTrue(T_T09_DELETE_BTN(i).Value) Then
                    If Not pwc83032.PutValue("T1", Var_LOG_PERF_T_T09_AVG_DEGF.ToString(), (i + 1).ToString()) Then
                        MessageBox.Show("SubmitPerfValues: Error on entering T1 Average (" + (i + 1).ToString() + ") - Deleted")
                        Return False
                    End If
                Else
                    If Not pwc83032.PutValue("T1", LOG_PERF_T_T09_DEGF(i).Value.ToString(), (i + 1).ToString()) Then
                        MessageBox.Show("SubmitPerfValues: Error on entering T1(" + (i + 1).ToString() + ")")
                        Return False
                    End If
                End If

            Next

            'EXHAUST TEMPERATURE (T7) -- 24 PROBES
            For i = 0 To T_T7_DELETE_BTN.GetUpperBound(0) - 1

                If CELProject.IsTrue(T_T7_DELETE_BTN(i).Value) Then
                    If Not pwc83032.PutValue("T7", Var_LOG_PERF_T_T7_AVG_DEGF.ToString(), (i + 1).ToString()) Then
                        MessageBox.Show("SubmitPerfValues: Error on entering T7 Average (" + (i + 1).ToString() + ") - Deleted")
                        Return False
                    End If
                Else
                    If Not pwc83032.PutValue("T7", LOG_PERF_T_T7_DEGF(i).Value.ToString(), (i + 1).ToString()) Then
                        MessageBox.Show("SubmitPerfValues: Error on entering T7(" + (i + 1).ToString() + ")")
                        Return False
                    End If
                End If

            Next

            'BLEED TEMPERATURE (T17) -- 4 PROBES
            For i = 0 To T_T17_DELETE_BTN.GetUpperBound(0) - 1

                If CELProject.IsTrue(T_T17_DELETE_BTN(i).Value) Then
                    If Not pwc83032.PutValue("T17", Var_LOG_PERF_T_T17_AVG_DEGF.ToString(), (i + 1).ToString()) Then
                        MessageBox.Show("SubmitPerfValues: Error on entering T17 Average (" + (i + 1).ToString() + ") - Deleted")
                        Return False
                    End If
                Else
                    If Not pwc83032.PutValue("T17", LOG_PERF_T_T17_DEGF(i).Value.ToString(), (i + 1).ToString()) Then
                        MessageBox.Show("SubmitPerfValues: Error on entering T17(" + (i + 1).ToString() + ")")
                        Return False
                    End If
                End If

            Next

            'AMBIENT PRESSURE
            If Not pwc83032.PutValue("PAMB", LOG_PERF_E_PAMB_PSIA.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering PAMB")
                Return False
            End If

            'EGT (ENGINE PROBE)
            If Not pwc83032.PutValue("EGT", LOG_PERF_E_EGT_DEGC.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering EGT")
                Return False
            End If

            'Q13 & Q13REF
            If Not pwc83032.PutValue("Q13", LOG_PERF_E_Q13.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering Q13")
                Return False
            End If

            'If Not pwc83032.PutValue("Q13REF", LOG_PERF_E_Q13REF.Value.ToString(), "") Then
            If Not pwc83032.PutValue("Q13REF", LOG_PERF_E_Q13REF_TO_DLL.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering Q13REF")
                Return False
            End If

            'SURGE CONTROL VALVE
            If Not pwc83032.PutValue("SCVPOS", LOG_PERF_E_SCVPOS_PCT.Value.ToString(), "") Then
                MessageBox.Show("SubmitPerfValues: Error on entering SCVPOS")
                Return False
            End If

            Return True

        End Function

        Private Sub OnBTN_TAKE_POINT(sender As IChannel, newVal As Value)
            Try
                If (newVal Is Values.True) Then

                    'Update the Log/Perf channel set
                    'CELProject.LogPerfSynch.UpdateValues() 'ft 30sept2014 pourquoi on ne call pas le UpdateValues????

                    FlowmeterCtrl.ComputeFlow(True)

                    SampleValues(True)

                    ProcessCondition()

                    Dim SearchPath As String
                    Dim NewFileCreated As Boolean

                    SearchPath = CELProject.EngineSession.PerfFolder

                    If PERF_CONDITION_NUMBER.Value.ToDouble() = eTestStepPW980A.MES Or PERF_CONDITION_NUMBER.Value.ToDouble() = eTestStepPW980A.ECS_800 Or PERF_CONDITION_NUMBER.Value.ToDouble() = eTestStepPW980A.ECS_900 Then
                        PERF_TEST_STEP_NB.Value = New KineticaRT.Values.Double(PERF_CONDITION_NUMBER.Value.ToDouble())
                        Dim Revima12917AlternateTemplateReportFullFileName As String = EngineConfiguration.PerformanceReportAlternateTemplateFile
                        NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, Revima12917AlternateTemplateReportFullFileName, AddressOf CreateRevimaPerformanceFile)
                    End If

                    PERF_TAKE_POINT_BTN.Value = Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("PWC83032_Sequence : OnBTN_TAKE_POINT()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub OnEnterPerformanceData(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                Dim SearchPath As String

                If CELProject.IsTrue(newVal) Then
                    PERF_TEST_STEP_NB.Value = New KineticaRT.Values.Double(eTestStepPW980A.FINAL_DATA)

                    Dim NewFileCreated As Boolean

                    SearchPath = CELProject.EngineSession.PerfFolder

                    Dim Revima12917AlternateTemplateReportFullFileName As String = EngineConfiguration.PerformanceReportAlternateTemplateFile
                    NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, Revima12917AlternateTemplateReportFullFileName, AddressOf CreateRevimaPerformanceFile)
                End If

            Catch Ex As Exception
                MessageBox.Show("OnEStop: " & Ex.ToString())
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionInitialized(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                MyBase.OnTestSessionInitialized(newStatus)

                Select Case CELProject.EngineModel

                    Case "PW980A"

                        'Client Initialization
                        Dim endpointAddress As New EndpointAddress(Configuration.CreateServerUriString())
                        Dim binding As System.ServiceModel.Channels.Binding = Configuration.CreateBinding()
                        Dim factory As New ChannelFactory(Of IPwc83032)(binding, endpointAddress)
                        pwc83032 = factory.CreateChannel()

                        UserInputs.MapUserInputsParameters(CELProject)
                        Init_Engine_Channels()
                        If Initialize_Perf() = False Then
                            Perf_Status_Close = True
                            CELProject.Test_Mgr_Cmd.Value = New KineticaRT.Values.Text(CELDAS.eTest_Mgr_Cmd.Close)
                        Else
                            Perf_Status_Close = False
                        End If

                        'CreateLogFile() Ajouter Creation du Log generique
                        Initialize()

                End Select

            Catch Ex As Exception
                MessageBox.Show("PWC83032_Sequence : OnTestSessionInitialized()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)

            Catch ex As Exception

                MessageBox.Show("PWC83032_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            End Try
        End Sub

        Protected Overrides Sub OnTestSessionRunning(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                MyBase.OnTestSessionRunning(newStatus)

                Select Case CELProject.EngineModel

                    Case "PW980A"

                        FlowmeterCtrl = New FlowmeterController(Me)

                        If Perf_Status_Close Then
                            CELProject.Test_Mgr_Cmd.Value = New KineticaRT.Values.Text(CELDAS.eTest_Mgr_Cmd.Close)
                        End If
                        CELProject.LoadSave_Custom_Parameters(Custom_Parameters, False)
                        CreateHandler()
                        TestProgress_Initialize()

                End Select

            Catch Ex As Exception
                MessageBox.Show("PWC83032_Sequence : OnTestSessionRunning()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionClosing(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionClosing(newStatus)

                Select Case CELProject.EngineModel

                    Case "PW980A"

                        DeleteHandler()

                        If Not (FlowmeterCtrl Is Nothing) Then
                            FlowmeterCtrl.Dispose()
                        End If

                        If TestProgressMgr IsNot Nothing Then
                            TestProgress_Save()
                            TestProgressMgr.Dispose()
                            TestProgressMgr = Nothing
                        End If
                End Select

            Catch Ex As Exception
                MessageBox.Show("PWC83032_Sequence : OnTestSessionClosing()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub TestProgress_Initialize()
            Dim dataInfo As CEL.TestProgress.TestProgressMgr.TestProgress_DataInfo

            dataInfo.EngineStartEventChannelName = "START_BTN"
            dataInfo.EngineStartEventChannelValue = True
            dataInfo.EngineStartEventDescription = "Mise en route"
            dataInfo.EngineStartEventRecordTime = True
            dataInfo.EngineStopEventChannelName = "RUN_STOP_BTN"
            dataInfo.EngineStopEventChannelValue = False
            dataInfo.EngineStopEventDescription = "Arrêt moteur - Temps d'arrêt (s): "
            dataInfo.EngineStopEventRecordTime = True
            dataInfo.TestProgressFrameName = CELProject.EngineModel.Replace("-", "_") + "_Screen.fraTestProgressHorizontal"
            dataInfo.TestProgressSheetFileName = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
            dataInfo.UUTModel = CELProject.EngineModel
            dataInfo.UUTSerialNumber = Me.UserInputs.EngineSerialNumber
            dataInfo.UUTWorkOrder = Me.UserInputs.WorkOrder
            Me.TestProgressMgr = New CEL.TestProgress.TestProgressMgr(dataInfo)
        End Sub

        Private Sub TestProgress_RecordPerfStep(testStep As eTestStepPW980A)

            If Me.TestProgressMgr IsNot Nothing Then

                Dim sheetEntry As CEL.TestProgress.TestProgressSheetEntry = Nothing

                Dim checkItemP09 As String = "P09 - Actual: " + LOG_PERF_P_P09_AVG_PSIA.Value.ToString("F2", Nothing) + " psia"
                Dim checkItemT09 As String = "T09 - Actual: " + LOG_PERF_T_T09_AVG_DEGC.Value.ToString(LOG_PERF_T_T09_AVG_DEGC.Format, Nothing) + " °C"
                Dim checkItemIGV As String = "IGV - Actual: " + LOG_PERF_E_IGVACT_PCT.Value.ToString(LOG_PERF_E_IGVACT_PCT.Format, Nothing) + " %"
                Dim checkItemW17C As String = "W17C - Target: "
                Dim checkItemGENERATOR As String = "GENERATOR - Target: 240 Actual : " + _
                    LOG_PERF_LOAD_TOTAL_KVA.Value.ToString(LOG_PERF_LOAD_TOTAL_KVA.Format, Nothing) + " kVA"
                Dim checkItemN2 As String = "N2 - "
                Dim checkItemEGT As String = "EGT - "
                Dim checkItemWF As String = "FUEL FLOW - "
                Dim checkItemP17 As String = "P17 - Min: " + PERF_P_P17_AVG_LIMIT_PSIA.Value.ToString(PERF_P_P17_AVG_LIMIT_PSIA.Format, Nothing) + _
                            " Actual: " + LOG_PERF_P_P17_AVG_PSIA.Value.ToString("F2", Nothing) + " psi"
                Dim checkItemW17 As String = "W17 - "

                Select Case testStep
                    Case eTestStepPW980A.ECS_800
                        checkItemW17C += "1.78 Actual: " + LOG_PERF_W17C.Value.ToString(LOG_PERF_W17C.Format, Nothing) + " kg/s"
                        checkItemN2 += "Max: " + PERF_N2_LIMIT_RPM.Value.ToString(PERF_N2_LIMIT_RPM.Format, Nothing) + _
                            " Actual: " + LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing) + " RPM"
                        checkItemEGT += "Max: " + PERF_T_T7_AVG_LIMIT_DEGC.Value.ToString(PERF_T_T7_AVG_LIMIT_DEGC.Format, Nothing) + _
                            " Actual: " + LOG_PERF_E_EGT_DEGC.Value.ToString(LOG_PERF_E_EGT_DEGC.Format, Nothing) + " °C"
                        checkItemWF += "Max: " + PERF_WF_LIMIT_PPH.Value.ToString(PERF_WF_LIMIT_PPH.Format, Nothing) + _
                            " Actual: " + LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing) + " lb/h"
                        checkItemW17 += "Min: " + PERF_W17_LIMIT_LBMIN.Value.ToString(PERF_W17_LIMIT_LBMIN.Format, Nothing) + _
                            " Actual: " + LOG_PERF_W17_LBMIN.Value.ToString(LOG_PERF_W17_LBMIN.Format, Nothing) + " lb/min"

                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Max ECS-800", {checkItemP09, checkItemT09, _
                                                                                                       checkItemIGV, checkItemW17C, checkItemGENERATOR, _
                                                                                                       checkItemN2, checkItemEGT, checkItemWF, checkItemP17, _
                                                                                                       checkItemW17})
                    Case eTestStepPW980A.ECS_900
                        checkItemW17C += "1.81 Actual: " + LOG_PERF_W17C.Value.ToString(LOG_PERF_W17C.Format, Nothing) + " kg/s"
                        checkItemN2 += "Max: " + PERF_N2_LIMIT_RPM.Value.ToString(PERF_N2_LIMIT_RPM.Format, Nothing) + _
                            " Actual: " + LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing) + " RPM"
                        checkItemEGT += "Max: " + PERF_T_T7_AVG_LIMIT_DEGC.Value.ToString(PERF_T_T7_AVG_LIMIT_DEGC.Format, Nothing) + _
                            " Actual: " + LOG_PERF_E_EGT_DEGC.Value.ToString(LOG_PERF_E_EGT_DEGC.Format, Nothing) + " °C"
                        checkItemWF += "Max: " + PERF_WF_LIMIT_PPH.Value.ToString(PERF_WF_LIMIT_PPH.Format, Nothing) + _
                            " Actual: " + LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing) + " lb/h"
                        checkItemW17 += "Min: " + PERF_W17_LIMIT_LBMIN.Value.ToString(PERF_W17_LIMIT_LBMIN.Format, Nothing) + _
                            " Actual: " + LOG_PERF_W17_LBMIN.Value.ToString(LOG_PERF_W17_LBMIN.Format, Nothing) + " lb/min"

                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Max ECS-900", {checkItemP09, checkItemT09, _
                                                                                                       checkItemIGV, checkItemW17C, checkItemGENERATOR, _
                                                                                                       checkItemN2, checkItemEGT, checkItemWF, checkItemP17, _
                                                                                                       checkItemW17})

                    Case eTestStepPW980A.MES
                        checkItemW17C += "0.78 Actual: " + LOG_PERF_W17C.Value.ToString(LOG_PERF_W17C.Format, Nothing) + " kg/s"
                        checkItemN2 += "Actual: " + LOG_PERF_N2_RPM.Value.ToString(LOG_PERF_N2_RPM.Format, Nothing) + " RPM"
                        checkItemEGT += "Actual: " + LOG_PERF_E_EGT_DEGC.Value.ToString(LOG_PERF_E_EGT_DEGC.Format, Nothing) + " °C"
                        checkItemWF += "Actual: " + LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing) + " lb/h"
                        checkItemW17 += "Actual: " + LOG_PERF_W17_LBMIN.Value.ToString(LOG_PERF_W17_LBMIN.Format, Nothing) + " lb/min"

                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "MES", {checkItemP09, checkItemT09, _
                                                                                                       checkItemIGV, checkItemW17C, checkItemGENERATOR, _
                                                                                                       checkItemN2, checkItemEGT, checkItemWF, checkItemP17, _
                                                                                                       checkItemW17})
                End Select

                If sheetEntry IsNot Nothing Then
                    Me.TestProgressMgr.AddTestProgressEntry(sheetEntry)
                End If
            End If

        End Sub

      Private Sub TestProgress_Save()
            If Not Me.TestProgressMgr Is Nothing Then
                TestProgress_UpdateProgressSheetHeader(Me.TestProgressMgr.TestProgressSheet)
                Dim fileName As String = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
                Dim settings As Xml.XmlWriterSettings = New Xml.XmlWriterSettings()
                settings.Indent = True

                Using writer As Xml.XmlWriter = Xml.XmlWriter.Create(fileName, settings)
                    Dim xslPath As String = "type=""text/xsl"" href=""" + Application.StartupPath + "/TestProgressSheet.xsl"""
                    writer.WriteProcessingInstruction("xml-stylesheet", xslPath)
                    Dim ser As New Xml.Serialization.XmlSerializer(GetType(CEL.TestProgress.TestProgressSheet))
                    ser.Serialize(writer, Me.TestProgressMgr.TestProgressSheet)
                End Using
            End If
        End Sub

        Private Sub TestProgress_UpdateProgressSheetHeader(progressSheet As CEL.TestProgress.TestProgressSheet)
            progressSheet.Header("No capteur de vibration GG") = Me.UserInputs.GGVibPickupSerialNumber
            progressSheet.Header("No capteur de vibration LGB") = Me.UserInputs.LGBVibPickupSerialNumber
            progressSheet.Header("Type d'huile") = Me.UserInputs.OilType
            progressSheet.Header("Quantité totale Jet A1") = Me.FUEL_USED_TOTAL_LITERS.Value.ToString()
            Dim runningTime As System.TimeSpan = System.TimeSpan.FromSeconds(Me.OPERATING_TIME_CURRENT_SEC.Value.ToDouble())
            progressSheet.Header("Temps de fonctionnement") = Math.Floor(runningTime.TotalHours).ToString() + _
                " h " + runningTime.Minutes.ToString("00")
        End Sub

