                        Return_Value.Add(MyBase.InitializeChannel(PERF_N2_LIMIT_RPM, "PERF_N2_LIMIT_RPM"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_N2_RUNDOWN_TIME, "PERF_N2_RUNDOWN_TIME"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_P_P17_AVG_LIMIT_PSIA, "PERF_P_P17_AVG_LIMIT_PSIA"))
