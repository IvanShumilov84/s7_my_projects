                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_T17_AVG_DEGF, "LOG_PERF_T_T17_AVG_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_T7_AVG_DEGF, "LOG_PERF_T_T7_AVG_DEGF"))
						Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_TFV_SG_BASE, "LOG_PERF_TFV_SG_BASE"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_W17_LBMIN, "LOG_PERF_W17_LBMIN"))
