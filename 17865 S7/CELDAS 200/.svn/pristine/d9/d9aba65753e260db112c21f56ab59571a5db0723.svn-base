                            PLA_LEVER_POS.Value = PLA_MAX_RIG_POS.Value
                            PLA_SERVO_ANGLE_READING.Value = PLA_MAX_RIG_POS.Value
                        ElseIf sender Is CLA_STORE_MAX_STOP_ANGLE_BTN Then
                            CLA_MAX_STOP_POS_DONE.Value = Values.True
                            CLA_LEVER_POS.Value = New KineticaRT.Values.Double(0.0)
                        ElseIf sender Is CLA_STORE_MIN_STOP_ANGLE_BTN Then
                            CLA_MIN_STOP_POS_DONE.Value = Values.True
                            CLA_MAX_STOP_POS_DEG.Value = CLA_MAX_RIG_POS.Value
                            CLA_LEVER_POS.Value = CLA_MAX_RIG_POS.Value
                            CLA_SERVO_ANGLE_READING.Value = CLA_MAX_RIG_POS.Value
                        ElseIf sender Is MOR_STORE_MAX_STOP_ANGLE_BTN Then
                            MOR_MAX_STOP_POS_DONE.Value = Values.True
                            MOR_LEVER_POS.Value = New KineticaRT.Values.Double(0.0)
                        ElseIf sender Is MOR_STORE_MIN_STOP_ANGLE_BTN Then
                            MOR_MIN_STOP_POS_DONE.Value = Values.True
                            MOR_MAX_STOP_POS_DEG.Value = MOR_MAX_RIG_POS.Value
                            MOR_LEVER_POS.Value = MOR_MAX_RIG_POS.Value
                            MOR_SERVO_ANGLE_READING.Value = MOR_MAX_RIG_POS.Value
                        End If
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("Throttle_Sequence.OnStoreMaxMinStopBtn(" & throttleInstance.ToString() & "): " & vbCrLf & vbCrLf &
