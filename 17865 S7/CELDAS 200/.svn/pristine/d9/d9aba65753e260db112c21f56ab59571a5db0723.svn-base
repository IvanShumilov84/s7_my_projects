                            AddHandler CLP_RVDT_E1Y0_VDC.ValueChanged, AddressOf OnRVDTResolverCoefficients
                            AddHandler CLP_RVDT_E1Y1_VDC.ValueChanged, AddressOf OnRVDTResolverCoefficients
                            AddHandler CLP_RVDT_E2Y0_VDC.ValueChanged, AddressOf OnRVDTResolverCoefficients
                            AddHandler CLP_RVDT_E2Y1_VDC.ValueChanged, AddressOf OnRVDTResolverCoefficients

                            AddHandler PLA_CAPTURE_RVDT_MIN_BTN.ValueChanged, AddressOf OnCaptureRVDT
                            AddHandler PLA_CAPTURE_RVDT_MAX_BTN.ValueChanged, AddressOf OnCaptureRVDT
                            AddHandler PLA_COMPUTE_RVDT_BTN.ValueChanged, AddressOf OnComputeRVDT
                            AddHandler PLA_SEND_BTN.ValueChanged, AddressOf OnSendRVDTResolver

                            AddHandler PLA_RVDT_E1Y0_VDC.ValueChanged, AddressOf OnRVDTResolverCoefficients
                            AddHandler PLA_RVDT_E1Y1_VDC.ValueChanged, AddressOf OnRVDTResolverCoefficients
                            AddHandler PLA_RVDT_E2Y0_VDC.ValueChanged, AddressOf OnRVDTResolverCoefficients
                            AddHandler PLA_RVDT_E2Y1_VDC.ValueChanged, AddressOf OnRVDTResolverCoefficients

                            AddHandler PLA_RESOLVER_LEVER0.ValueChanged, AddressOf OnRVDTResolverCoefficients
                            AddHandler PLA_RESOLVER_LEVER1.ValueChanged, AddressOf OnRVDTResolverCoefficients
                            AddHandler PLA_RESOLVER_ANGLE0.ValueChanged, AddressOf OnRVDTResolverCoefficients
                            AddHandler PLA_RESOLVER_ANGLE1.ValueChanged, AddressOf OnRVDTResolverCoefficients

                            AddHandler CLP_RESOLVER_LEVER0.ValueChanged, AddressOf OnRVDTResolverCoefficients
                            AddHandler CLP_RESOLVER_LEVER1.ValueChanged, AddressOf OnRVDTResolverCoefficients
                            AddHandler CLP_RESOLVER_ANGLE0.ValueChanged, AddressOf OnRVDTResolverCoefficients
                            AddHandler CLP_RESOLVER_ANGLE1.ValueChanged, AddressOf OnRVDTResolverCoefficients

                            AddHandler RVDT_RESOLVER_SAVE_BTN.ValueChanged, AddressOf OnRVDTResolverSave

                            AddHandler STMSession.Connected, AddressOf Me.OnSTMSessionConnected
                            AddHandler STMSession.Closed, AddressOf Me.OnSTMSessionClosed
                            AddHandler STMSession.Error, AddressOf Me.OnSTMSessionError
                            AddHandler STMSession.MetaDataReceived, AddressOf Me.OnSTMSessionMetaDataReceived
                            AddHandler STMSession.NewDataReceived, AddressOf Me.OnSTMSessionNewDataReceived

                            If CELProject.DataAcquisitionMode = CELDAS.eDataAcquisitionMode.RUN_FOR_TRUE Then
                                AddHandler STMSessionReconnectTimer.Elapsed, AddressOf Me.OnSTMReconnectTimerElapsed

                                ' Set RVDT/Resolver
                                RVDTResolverSelection()

                                Me.ConnectSTMSession()

#If CELDAS200 Then
                                Select Case CELProject.EngineModel

                                    Case "PT6A-68"
                                        AddHandler USER_AUTO_RIGGING.ValueChanged, AddressOf OnUSER_AUTO_RIGGING

                                End Select
#End If
                            Else
                                CRIO_CONNECTED.Value = Values.True
                                CLA_RIGGING_DONE.Value = Values.True
                                PLA_RIGGING_DONE.Value = Values.True
                            End If
                        End If
                    End If
                End If


            Catch ex As Exception
                MessageBox.Show("Throttle_Sequence.OnTestSessionRunning: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionClosing(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                If CELProject.EngineModel <> "DAS CALIBRATION" And CELProject.EngineModel <> "SYSTEM CHECK" And
                    CELProject.HierarchyType = CELDAS.eHierarchyType.Master Then

                    If (Not CLA_CLOSE_THROTTLE_CALIB_BTN Is Nothing) Then
                        RemoveHandler CLA_CLOSE_THROTTLE_CALIB_BTN.ValueChanged, AddressOf OnCLACloseThrottleCalib_Btn
                    End If
                    If (Not CLA_COMPUTE_BTN Is Nothing) Then
                        RemoveHandler CLA_COMPUTE_BTN.ValueChanged, AddressOf OnComputeBtn
                    End If
                    If (Not CLA_RESET_BTN Is Nothing) Then
                        RemoveHandler CLA_RESET_BTN.ValueChanged, AddressOf OnResetBtn
                    End If
                    If (Not CLA_RETURN_TO_IDLE_CMD Is Nothing) Then
                        RemoveHandler CLA_RETURN_TO_IDLE_CMD.ValueChanged, AddressOf OnReturnToIdleCmd
                    End If
                    If (Not CLA_STORE_IDLE_ANGLE_BTN Is Nothing) Then
                        RemoveHandler CLA_STORE_IDLE_ANGLE_BTN.ValueChanged, AddressOf OnStoreIdleAngleBtn
                    End If
                    If (Not CLA_STORE_MIN_ANGLE_BTN Is Nothing) Then
                        RemoveHandler CLA_STORE_MIN_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinAngleBtn
                    End If
                    If (Not CLA_STORE_MIN_STOP_ANGLE_BTN Is Nothing) Then
                        RemoveHandler CLA_STORE_MIN_STOP_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinStopBtn
                    End If
                    If (Not CLA_STORE_MAX_ANGLE_BTN Is Nothing) Then
                        RemoveHandler CLA_STORE_MAX_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinAngleBtn
                    End If
                    If (Not CLA_STORE_MAX_STOP_ANGLE_BTN Is Nothing) Then
                        RemoveHandler CLA_STORE_MAX_STOP_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinStopBtn
                    End If

                    If (Not PLA_CLOSE_THROTTLE_CALIB_BTN Is Nothing) Then
                        RemoveHandler PLA_CLOSE_THROTTLE_CALIB_BTN.ValueChanged, AddressOf OnPLACloseThrottleCalib_Btn
                    End If
                    If (Not PLA_RESET_BTN Is Nothing) Then
                        RemoveHandler PLA_RESET_BTN.ValueChanged, AddressOf OnResetBtn
                    End If
                    If (Not PLA_RETURN_TO_IDLE_CMD Is Nothing) Then
                        RemoveHandler PLA_RETURN_TO_IDLE_CMD.ValueChanged, AddressOf OnReturnToIdleCmd
                    End If
                    If (Not PLA_STORE_IDLE_ANGLE_BTN Is Nothing) Then
                        RemoveHandler PLA_STORE_IDLE_ANGLE_BTN.ValueChanged, AddressOf OnStoreIdleAngleBtn
                    End If
                    If (Not PLA_COMPUTE_BTN Is Nothing) Then
                        RemoveHandler PLA_COMPUTE_BTN.ValueChanged, AddressOf OnComputeBtn
                    End If
                    If (Not PLA_STORE_MIN_ANGLE_BTN Is Nothing) Then
                        RemoveHandler PLA_STORE_MIN_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinAngleBtn
                    End If
                    If (Not PLA_STORE_MIN_STOP_ANGLE_BTN Is Nothing) Then
                        RemoveHandler PLA_STORE_MIN_STOP_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinStopBtn
                    End If
                    If (Not PLA_STORE_MAX_ANGLE_BTN Is Nothing) Then
                        RemoveHandler PLA_STORE_MAX_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinAngleBtn
                    End If
                    If (Not PLA_STORE_MAX_STOP_ANGLE_BTN Is Nothing) Then
                        RemoveHandler PLA_STORE_MAX_STOP_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinStopBtn
                    End If

                    If (Not MOR_RESET_BTN Is Nothing) Then
                        RemoveHandler MOR_RESET_BTN.ValueChanged, AddressOf OnResetBtn
                    End If
                    If (Not MOR_RETURN_TO_IDLE_CMD Is Nothing) Then
                        RemoveHandler MOR_RETURN_TO_IDLE_CMD.ValueChanged, AddressOf OnReturnToIdleCmd
                    End If
                    If (Not MOR_STORE_IDLE_ANGLE_BTN Is Nothing) Then
                        RemoveHandler MOR_STORE_IDLE_ANGLE_BTN.ValueChanged, AddressOf OnStoreIdleAngleBtn
                    End If
                    If (Not MOR_COMPUTE_BTN Is Nothing) Then
                        RemoveHandler MOR_COMPUTE_BTN.ValueChanged, AddressOf OnComputeBtn
                    End If
                    If (Not MOR_STORE_MIN_ANGLE_BTN Is Nothing) Then
                        RemoveHandler MOR_STORE_MIN_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinAngleBtn
                    End If
                    If (Not MOR_STORE_MIN_STOP_ANGLE_BTN Is Nothing) Then
                        RemoveHandler MOR_STORE_MIN_STOP_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinStopBtn
                    End If
                    If (Not MOR_STORE_MAX_ANGLE_BTN Is Nothing) Then
                        RemoveHandler MOR_STORE_MAX_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinAngleBtn
                    End If
                    If (Not MOR_STORE_MAX_STOP_ANGLE_BTN Is Nothing) Then
                        RemoveHandler MOR_STORE_MAX_STOP_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinStopBtn
                    End If

                    If (Not CLOSE_RVDT_RESOLVER_CONFIG_WINDOW_BTN Is Nothing) Then
                        RemoveHandler CLOSE_RVDT_RESOLVER_CONFIG_WINDOW_BTN.ValueChanged, AddressOf OnRVDT_RESOLVER_CONFIG_WINDOW
                    End If
                    If (Not CLP_RVDT_E1Y0_VDC Is Nothing) Then
                        RemoveHandler PLA_RVDT_E1Y0_VDC.ValueChanged, AddressOf OnRVDTResolverCoefficients
                    End If
                    If (Not CLP_RVDT_E1Y1_VDC Is Nothing) Then
                        RemoveHandler PLA_RVDT_E1Y0_VDC.ValueChanged, AddressOf OnRVDTResolverCoefficients
                    End If
                    If (Not CLP_RVDT_E2Y0_VDC Is Nothing) Then
                        RemoveHandler PLA_RVDT_E1Y0_VDC.ValueChanged, AddressOf OnRVDTResolverCoefficients
                    End If
                    If (Not CLP_RVDT_E2Y1_VDC Is Nothing) Then
                        RemoveHandler PLA_RVDT_E1Y0_VDC.ValueChanged, AddressOf OnRVDTResolverCoefficients
                    End If
                    If (Not PLA_RVDT_E1Y0_VDC Is Nothing) Then
                        RemoveHandler PLA_RVDT_E1Y0_VDC.ValueChanged, AddressOf OnRVDTResolverCoefficients
                    End If
                    If (Not PLA_RVDT_E1Y1_VDC Is Nothing) Then
                        RemoveHandler PLA_RVDT_E1Y0_VDC.ValueChanged, AddressOf OnRVDTResolverCoefficients
                    End If
                    If (Not PLA_RVDT_E2Y0_VDC Is Nothing) Then
                        RemoveHandler PLA_RVDT_E1Y0_VDC.ValueChanged, AddressOf OnRVDTResolverCoefficients
                    End If
                    If (Not PLA_RVDT_E2Y1_VDC Is Nothing) Then
                        RemoveHandler PLA_RVDT_E1Y0_VDC.ValueChanged, AddressOf OnRVDTResolverCoefficients
                    End If
                    If (Not RVDT_RESOLVER_SAVE_BTN Is Nothing) Then
                        RemoveHandler RVDT_RESOLVER_SAVE_BTN.ValueChanged, AddressOf OnRVDTResolverSave
                    End If

                    If (Not USER_AUTO_RIGGING Is Nothing) Then
                        RemoveHandler USER_AUTO_RIGGING.ValueChanged, AddressOf OnUSER_AUTO_RIGGING
                    End If

                    DisconnectSTMSession()

                    RemoveHandler STMSessionReconnectTimer.Elapsed, AddressOf Me.OnSTMReconnectTimerElapsed
                    RemoveHandler STMSession.NewDataReceived, AddressOf Me.OnSTMSessionNewDataReceived
                    RemoveHandler STMSession.MetaDataReceived, AddressOf Me.OnSTMSessionMetaDataReceived
                    RemoveHandler STMSession.Error, AddressOf Me.OnSTMSessionError
                    RemoveHandler STMSession.Closed, AddressOf Me.OnSTMSessionClosed
                    RemoveHandler STMSession.Connected, AddressOf Me.OnSTMSessionConnected

                    'Init_Channels_Value()

                End If

            Catch ex As Exception
                MessageBox.Show("Throttle_Sequence.OnTestSessionClosing: " & vbCrLf & vbCrLf & "Error message: " & vbCrLf & ex.ToString, "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try

        End Sub

        Private Sub ShowDynoWarningMessage()

            Dim message As String = "Ensure proper configuration is loaded on the dynamometer controller"

            Dim DefaultDynoWarningMsg As String =
                "** Ensure the proper engine type loaded on the right corner of the display" & vbCrLf &
                "** Place the dynamometer controller switch to enable" & vbCrLf &
                "** Confirm that FLIGHT is DESELECTED" & vbCrLf &
                "** Place the dynamometer controller switch to disable" & vbCrLf &
                "** Confirm that the speed demand on the dynamometer controller correspond to the value at the DAS Control Screen"

            Select Case CELProject.EngineModel
                Case "T56-A-14", "T56-A-15LFE", "T56-A-15GFE"

                    message =
                        "** Ensure the dynamometer is loaded in F63 mode" & vbCrLf &
                        "** Position the PLA lever to idle" & vbCrLf &
                        "** Place the dynamometer controller switch to enable" & vbCrLf &
                        "** Set inlet valve control to AUTO, outlet valve to SPEED and select FLIGHT" & vbCrLf &
                        "** Place the dynamometer controller switch to disable" & vbCrLf &
                        "** Ensure the status shows ACTIVE"

                Case "PT6A-68", "PW123AF"
                Case "PT6A-41", "PT6A-42"
                Case "PT6T-3", "PT6T-3B", "PT6T-6_SIKOR", "PT6T-6_BELL", "PT6T-6B"
                Case "PT6C-67C"

                    message =
                        "** Ensure the proper engine model is loaded on the dynamometer controller" & vbCrLf &
                        "** Torque Mode : dynamometer must be set in manual, inlet valve in manual and then, in Flight Simulator Mode (Torque)" & vbCrLf &
                        "** Speed Mode : dynamometer must be set, in remote mode, at a Speed Demand of 21000 RPM"

                Case "PW206A", "PW206B", "PW206B2", "PW206B3", "PW206C", "PW206E", "PW207D", "PW207D1", "PW207D2", "PW207C", "PW207E", "PW207K"

                    message =
                        "** Ensure the proper engine model is loaded on the dynamometer controller" & vbCrLf &
                        "** Torque Mode : dynamometer must be set in manual, inlet valve in manual and then, in Flight Simulator Mode (Torque)" & vbCrLf &
                        "** Speed Mode : dynamometer must be set, in remote mode, at a Speed Demand of " & DYNO_SPEED_100_PCT_RPM.Value.ToString & " RPM"

            End Select

            MessageBox.Show(message, "WARNING MESSAGE", MessageBoxButtons.OK, MessageBoxIcon.Warning)
        End Sub

