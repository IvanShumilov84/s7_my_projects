Namespace StudioDemonstration

    Public Class Throttle_Sequence
        Inherits CEL.KineticaRT.Sequence.Sequence

        Private CELProject As CELDAS = CELDAS.Instance()
        Private STMSession As CEL.STM.Session = New CEL.STM.Session()
        Private STMSessionReconnectTimer As System.Timers.Timer = New System.Timers.Timer(1000.0)
        Private STMSessionClosing As Boolean = False

        Private Const GOVFormName As String = "GOV_Rigging_Screen"
        Private Const FCUFormName As String = "FCU_Rigging_Screen"
        Private Const MORFormName As String = "MOR_Rigging_Screen"
        Private Const RVDTResolverConfigFormName As String = "RVDT_Resolver_Screen"

        Private Enum ThrottleInstanceName As Byte
            PLA = 0
            CLA = 1
            MOR = 2
        End Enum

        '********************************************************************
        '* Variable Declaration *********************************************
        '********************************************************************




        Public Overloads Overrides Sub Connect()
            If Me.Connected = False Then
                MyBase.Connect()
                Me.Connected = True

                '#If Not CELDAS200 Then
                '                OnTestSessionInitialized(CEL.KineticaRT.Sequence.eTestMgrStatus.Initialized)
                '                OnTestSessionRunning(CEL.KineticaRT.Sequence.eTestMgrStatus.Running)
                '#End If
            End If
        End Sub

        Public Overloads Overrides Sub Disconnect()
            If Me.Connected = True Then
                MyBase.Disconnect()
                Me.Connected = False
                '#If Not CELDAS200 Then
                '                OnTestSessionClosing(CEL.KineticaRT.Sequence.eTestMgrStatus.Closing)
                '#End If

            End If
        End Sub
        Protected Overrides Sub OnEngineWorkingThread()
            'DoNothing
        End Sub

        Private Sub ConnectSTMSession()
            STMSessionClosing = False
            STMSession.Connect(CELProject.cRIO.IpAdress.ToString, CELProject.cRIO.port.ToString)
        End Sub

        Private Sub DisconnectSTMSession()
            Dim stmData(0) As Byte
            If STMSession.IsConnected Then
                STMSessionClosing = True
                ResetRigging()
                STMSession.SendMsg("Close", stmData)
                STMSession.Disconnect()
            End If
        End Sub

        Private Sub OnSTMReconnectTimerElapsed(sender As Object, e As System.Timers.ElapsedEventArgs)
            System.Diagnostics.Trace.WriteLine("STM Session Reconnect timer tick.")

            Me.ConnectSTMSession()

        End Sub

        Private Sub OnSTMSessionConnected(sender As Object, e As System.EventArgs)
            System.Diagnostics.Trace.WriteLine("STM Session Connected.")
            CRIO_CONNECTED.Value = Values.True
        End Sub

        Private Sub OnSTMSessionClosed(sender As Object, e As System.EventArgs)
            System.Diagnostics.Trace.WriteLine("STM Session Closed.")
            CRIO_CONNECTED.Value = Values.False
            If Not STMSessionClosing Then
                STMSessionReconnectTimer.AutoReset = False
                STMSessionReconnectTimer.Start()
            End If
        End Sub

        Private Sub OnSTMSessionError(sender As Object, e As CEL.STM.ErrorEventArgs)
            Select Case e.ErrorCode
                Case System.Net.Sockets.SocketError.ConnectionRefused
                    System.Diagnostics.Trace.WriteLine("STM Session error: Connection refused.")
                    STMSessionReconnectTimer.AutoReset = False
                    STMSessionReconnectTimer.Start()
                Case System.Net.Sockets.SocketError.ConnectionReset
                    System.Diagnostics.Trace.WriteLine("STM Session error: Connection reset by the remote peer.")
                    STMSessionReconnectTimer.AutoReset = False
                    STMSessionReconnectTimer.Start()
                Case System.Net.Sockets.SocketError.TimedOut
                    System.Diagnostics.Trace.WriteLine("STM Session error: Connection timed out.")
                    STMSessionReconnectTimer.AutoReset = False
                    STMSessionReconnectTimer.Start()
                Case Else
                    System.Diagnostics.Trace.WriteLine("STM Session error: " & e.ErrorCode)
            End Select
        End Sub

        Private Sub OnSTMSessionMetaDataReceived(sender As Object, e As System.EventArgs)
            System.Diagnostics.Trace.WriteLine("Received MetaData:")
            For Each metaName As String In STMSession.MetaData
                System.Diagnostics.Trace.WriteLine(metaName)
            Next

            SendConfigTocRIO("PLA")
            SendConfigTocRIO("CLP")

        End Sub

        Private Sub OnSTMSessionNewDataReceived(sender As Object, e As CEL.STM.NewDataReceivedEventArgs)

            Dim bCloseConnection As Boolean = False
            Dim position As Integer = 0
            Dim throttleInstance As ThrottleInstanceName
            Dim Active As Boolean
            Dim Engaged As Boolean
            Dim MaxPositionStored As Boolean
            Dim MinPositionStored As Boolean
            Dim RiggingDone As Boolean
            Dim ComputeDone As Boolean
            Dim MaxStopPositionStored As Boolean
            Dim MinStopPositionStored As Boolean
            Dim IdlePositionStored As Boolean
            Dim LeverPosition As Double
            Dim ServoPosition As Double
            Dim FcuServoAngle As Double
            Dim Faults() As UInt32
            Dim Warnings() As UInt32

            Select Case e.MetaName
                Case "Throttle.Status"
                    Try

                        throttleInstance = CEL.STM.Convert.ByteUnflatten(e.Data, position)
                        position += Marshal.SizeOf(Byte.MaxValue.GetType)
                        Active = CEL.STM.Convert.BoolUnflatten(e.Data, position)
                        position += Marshal.SizeOf(Byte.MaxValue.GetType)
                        Engaged = CEL.STM.Convert.BoolUnflatten(e.Data, position)
                        position += Marshal.SizeOf(Byte.MaxValue.GetType)
                        MaxPositionStored = CEL.STM.Convert.BoolUnflatten(e.Data, position)
                        position += Marshal.SizeOf(Byte.MaxValue.GetType)
                        MinPositionStored = CEL.STM.Convert.BoolUnflatten(e.Data, position)
                        position += Marshal.SizeOf(Byte.MaxValue.GetType)
                        RiggingDone = CEL.STM.Convert.BoolUnflatten(e.Data, position)
                        position += Marshal.SizeOf(Byte.MaxValue.GetType)
                        ComputeDone = CEL.STM.Convert.BoolUnflatten(e.Data, position)
                        position += Marshal.SizeOf(Byte.MaxValue.GetType)
                        MaxStopPositionStored = CEL.STM.Convert.BoolUnflatten(e.Data, position)
                        position += Marshal.SizeOf(Byte.MaxValue.GetType)
                        MinStopPositionStored = CEL.STM.Convert.BoolUnflatten(e.Data, position)
                        position += Marshal.SizeOf(Byte.MaxValue.GetType)
                        IdlePositionStored = CEL.STM.Convert.BoolUnflatten(e.Data, position)
                        position += Marshal.SizeOf(Byte.MaxValue.GetType)
                        LeverPosition = CEL.STM.Convert.DblUnflatten(e.Data, position)
                        position += Marshal.SizeOf(Double.MaxValue.GetType)
                        ServoPosition = CEL.STM.Convert.DblUnflatten(e.Data, position)
                        position += Marshal.SizeOf(Double.MaxValue.GetType)
                        FcuServoAngle = CEL.STM.Convert.DblUnflatten(e.Data, position)
                        position += Marshal.SizeOf(Double.MaxValue.GetType)
                        Faults = CEL.STM.Convert.UIntArrUnflatten(e.Data, position)
                        Warnings = CEL.STM.Convert.UIntArrUnflatten(e.Data, position)

                        THROTTLE_INSTANCE.Value = New KineticaRT.Values.Double(throttleInstance)

                    Catch ex As Exception
                        System.Diagnostics.Trace.WriteLine(" OnSTMSessionNewDataReceived: Unexpected error while Unflatting message: " + ex.Message)
                        bCloseConnection = True
                    End Try

                    If Not bCloseConnection Then
                        Select Case throttleInstance
                            Case ThrottleInstanceName.PLA
                                PLA_COMPUTE_DONE.Value = If(ComputeDone, Values.True, Values.False)
                                PLA_IDLE_POS_DONE.Value = If(IdlePositionStored, Values.True, Values.False)
                                PLA_LEVER_POS.Value = New KineticaRT.Values.Double(LeverPosition)
                                PLA_MAX_POS_DONE.Value = If(MaxPositionStored, Values.True, Values.False)
                                PLA_MAX_STOP_POS_DONE.Value = If(MaxStopPositionStored, Values.True, Values.False)
                                PLA_MIN_POS_DONE.Value = If(MinPositionStored, Values.True, Values.False)
                                PLA_MIN_STOP_POS_DONE.Value = If(MinStopPositionStored, Values.True, Values.False)
                                PLA_RIGGING_DONE.Value = If(RiggingDone, Values.True, Values.False)
                                PLA_SERVO_READING.Value = New KineticaRT.Values.Double(ServoPosition)
                                PLA_SERVO_ANGLE_READING.Value = New KineticaRT.Values.Double(FcuServoAngle)
                                Dim faultIndex As Integer = 0
                                Dim NumberOfFaults As Integer = 0
                                For Each faultCode As UInt32 In Faults
                                    faultIndex += 1
                                    If faultCode <> 0 Then
                                        System.Diagnostics.Trace.WriteLine("Drive(" & throttleInstance.ToString() &
                                                                           ") reported fault" & faultIndex.ToString() &
                                                                           "= " & faultCode.ToString())
                                        NumberOfFaults += 1
                                    End If
                                Next

                                If NumberOfFaults > 0 Then
                                    CRIO_PLA_DRIVE_FAULT.Value = KineticaRT.Values.Values.True
                                Else
                                    CRIO_PLA_DRIVE_FAULT.Value = KineticaRT.Values.Values.False
                                End If

                                Dim warningIndex As Integer = 0
                                Dim NumberOfWarnings As Integer = 0
                                For Each warningCode As UInt32 In Warnings
                                    warningIndex += 1
                                    If warningCode <> 0 Then
                                        System.Diagnostics.Trace.WriteLine("Drive(" & throttleInstance.ToString() &
                                                                           ") reported warning" & warningIndex.ToString() &
                                                                           "= " & warningCode.ToString())
                                        NumberOfWarnings += 1
                                    End If
                                Next

                                If NumberOfWarnings > 0 Then
                                    CRIO_PLA_DRIVE_WARNING.Value = KineticaRT.Values.Values.True
                                Else
                                    CRIO_PLA_DRIVE_WARNING.Value = KineticaRT.Values.Values.False
                                End If

                            Case ThrottleInstanceName.CLA
                                CLA_COMPUTE_DONE.Value = If(ComputeDone, Values.True, Values.False)
                                CLA_IDLE_POS_DONE.Value = If(IdlePositionStored, Values.True, Values.False)
                                CLA_LEVER_POS.Value = New KineticaRT.Values.Double(LeverPosition)
                                CLA_MAX_POS_DONE.Value = If(MaxPositionStored, Values.True, Values.False)
                                CLA_MAX_STOP_POS_DONE.Value = If(MaxStopPositionStored, Values.True, Values.False)
                                CLA_MIN_POS_DONE.Value = If(MinPositionStored, Values.True, Values.False)
                                CLA_MIN_STOP_POS_DONE.Value = If(MinStopPositionStored, Values.True, Values.False)
                                CLA_RIGGING_DONE.Value = If(RiggingDone, Values.True, Values.False)
                                CLA_SERVO_READING.Value = New KineticaRT.Values.Double(ServoPosition)
                                CLA_SERVO_ANGLE_READING.Value = New KineticaRT.Values.Double(FcuServoAngle)
                                Dim faultIndex As Integer = 0
                                Dim NumberOfFaults As Integer = 0
                                For Each faultCode As UInt32 In Faults
                                    faultIndex += 1
                                    If faultCode <> 0 Then
                                        System.Diagnostics.Trace.WriteLine("Drive(" & throttleInstance.ToString() &
                                                                           ") reported fault" & faultIndex.ToString() &
                                                                           "= " & faultCode.ToString())
                                        NumberOfFaults += 1
                                    End If
                                Next

                                If NumberOfFaults > 0 Then
                                    CRIO_CLA_DRIVE_FAULT.Value = KineticaRT.Values.Values.True
                                Else
                                    CRIO_CLA_DRIVE_FAULT.Value = KineticaRT.Values.Values.False
                                End If

                                Dim warningIndex As Integer = 0
                                Dim NumberOfWarnings As Integer = 0
                                For Each warningCode As UInt32 In Warnings
                                    warningIndex += 1
                                    If warningCode <> 0 Then
                                        System.Diagnostics.Trace.WriteLine("Drive(" & throttleInstance.ToString() &
                                                                           ") reported warning" & warningIndex.ToString() &
                                                                           "= " & warningCode.ToString())
                                        NumberOfWarnings += 1
                                    End If
                                Next

                                If NumberOfWarnings > 0 Then
                                    CRIO_CLA_DRIVE_WARNING.Value = KineticaRT.Values.Values.True
                                Else
                                    CRIO_CLA_DRIVE_WARNING.Value = KineticaRT.Values.Values.False
                                End If

                            Case ThrottleInstanceName.MOR

                                'Don't update values for MOR unless it is for one of the following engines:
                                If Not (CELProject.EngineModel = "PT6A-135" Or
                                    CELProject.EngineModel = "PT6A-135A" Or
                                    CELProject.EngineModel = "PT6A-114A" Or
                                    CELProject.EngineModel = "PT6A-34" Or
                                    CELProject.EngineModel = "PT6A-34AG") _
                                Then
                                    Exit Select
                                End If

                                MOR_COMPUTE_DONE.Value = If(ComputeDone, Values.True, Values.False)
                                MOR_IDLE_POS_DONE.Value = If(IdlePositionStored, Values.True, Values.False)
                                MOR_LEVER_POS.Value = New KineticaRT.Values.Double(LeverPosition)
                                MOR_MAX_POS_DONE.Value = If(MaxPositionStored, Values.True, Values.False)
                                MOR_MAX_STOP_POS_DONE.Value = If(MaxStopPositionStored, Values.True, Values.False)
                                MOR_MIN_POS_DONE.Value = If(MinPositionStored, Values.True, Values.False)
                                MOR_MIN_STOP_POS_DONE.Value = If(MinStopPositionStored, Values.True, Values.False)
                                MOR_RIGGING_DONE.Value = If(RiggingDone, Values.True, Values.False)
                                MOR_SERVO_READING.Value = New KineticaRT.Values.Double(ServoPosition)
                                MOR_SERVO_ANGLE_READING.Value = New KineticaRT.Values.Double(FcuServoAngle)
                                MOR_SERVO_ANGLE_READING_OPC.Value = New KineticaRT.Values.Double(FcuServoAngle)
                                Dim faultIndex As Integer = 0
                                Dim NumberOfFaults As Integer = 0
                                For Each faultCode As UInt32 In Faults
                                    faultIndex += 1
                                    If faultCode <> 0 Then
                                        System.Diagnostics.Trace.WriteLine("Drive(" & throttleInstance.ToString() &
                                                                           ") reported fault" & faultIndex.ToString() &
                                                                           "= " & faultCode.ToString())
                                        NumberOfFaults += 1
                                    End If
                                Next

                                If NumberOfFaults > 0 Then
                                    CRIO_MOR_DRIVE_FAULT.Value = KineticaRT.Values.Values.True
                                Else
                                    CRIO_MOR_DRIVE_FAULT.Value = KineticaRT.Values.Values.False
                                End If

                                Dim warningIndex As Integer = 0
                                Dim NumberOfWarnings As Integer = 0
                                For Each warningCode As UInt32 In Warnings
                                    warningIndex += 1
                                    If warningCode <> 0 Then
                                        System.Diagnostics.Trace.WriteLine("Drive(" & throttleInstance.ToString() &
                                                                           ") reported warning" & warningIndex.ToString() &
                                                                           "= " & warningCode.ToString())
                                        NumberOfWarnings += 1
                                    End If
                                Next

                                If NumberOfWarnings > 0 Then
                                    CRIO_MOR_DRIVE_WARNING.Value = KineticaRT.Values.Values.True
                                Else
                                    CRIO_MOR_DRIVE_WARNING.Value = KineticaRT.Values.Values.False
                                End If

                            Case Else
                                System.Diagnostics.Trace.WriteLine("Unexpected Throttle Instance")
                        End Select
                    Else
                        STMSession.Disconnect()
                    End If

                Case Else
                    System.Diagnostics.Trace.WriteLine("Received Unexpected message: " & e.MetaName)
            End Select

        End Sub

        Private Function Init_Channels() As Boolean
            Try
                Dim Return_Value As New ArrayList()

                Return_Value.Clear()

                'Initialize Throttle channels
                Return_Value.Add(Initialize_Channel(CRIO_CONNECTED, "CRIO_CONNECTED"))
