        Private Sub OnCaptureRVDT(ByVal sender As IChannel, ByVal newVal As Value)

            Try
                If CELProject.IsTrue(newVal) Then

                    If sender.Name.Contains("MIN") And sender.Name.Contains("PLA") Then
                        PLA_RVDT_E1_SCALING_FACTORS(0) = PLA_RVDT_E1_MIN_VDC.Value.ToDouble / CELProject.EngineConfiguration.LeverExcitation
                        PLA_RVDT_E2_SCALING_FACTORS(0) = PLA_RVDT_E2_MIN_VDC.Value.ToDouble / CELProject.EngineConfiguration.LeverExcitation
                        PLA_RVDT_LEVER_POSITIONS(0) = PLA_LEVER_POS.Value.ToDouble
                    ElseIf sender.Name.Contains("MAX") And sender.Name.Contains("PLA") Then
                        PLA_RVDT_E1_SCALING_FACTORS(1) = PLA_RVDT_E1_MAX_VDC.Value.ToDouble / CELProject.EngineConfiguration.LeverExcitation
                        PLA_RVDT_E2_SCALING_FACTORS(1) = PLA_RVDT_E2_MAX_VDC.Value.ToDouble / CELProject.EngineConfiguration.LeverExcitation
                        PLA_RVDT_LEVER_POSITIONS(1) = PLA_LEVER_POS.Value.ToDouble
                    ElseIf sender.Name.Contains("MIN") And sender.Name.Contains("CLP") Then
                        CLP_RVDT_E1_SCALING_FACTORS(0) = CLP_RVDT_E1_MIN_VDC.Value.ToDouble / CELProject.EngineConfiguration.LeverExcitation
                        CLP_RVDT_E2_SCALING_FACTORS(0) = CLP_RVDT_E2_MIN_VDC.Value.ToDouble / CELProject.EngineConfiguration.LeverExcitation
                        CLP_RVDT_LEVER_POSITIONS(0) = CLA_LEVER_POS.Value.ToDouble
                    ElseIf sender.Name.Contains("MAX") And sender.Name.Contains("CLP") Then
                        CLP_RVDT_E1_SCALING_FACTORS(1) = CLP_RVDT_E1_MAX_VDC.Value.ToDouble / CELProject.EngineConfiguration.LeverExcitation
                        CLP_RVDT_E2_SCALING_FACTORS(1) = CLP_RVDT_E2_MAX_VDC.Value.ToDouble / CELProject.EngineConfiguration.LeverExcitation
                        CLP_RVDT_LEVER_POSITIONS(1) = CLA_LEVER_POS.Value.ToDouble
                    End If

                End If
            Catch ex As Exception

            End Try
        End Sub

        Private Sub OnComputeRVDT(ByVal sender As IChannel, ByVal newVal As Value)

            Try
                If CELProject.IsTrue(newVal) Then

                    If sender.Name.Contains("PLA") Then

                        Dim PLAE1CurveFit As Double() = CELProject.LeastSquaresLine(PLA_RVDT_LEVER_POSITIONS, PLA_RVDT_E1_SCALING_FACTORS)
                        Dim PLAE2CurveFit As Double() = CELProject.LeastSquaresLine(PLA_RVDT_LEVER_POSITIONS, PLA_RVDT_E2_SCALING_FACTORS)

                        PLA_RVDT_E1Y0_VDC.Value = New KineticaRT.Values.Double((CELProject.EngineConfiguration.PLAMinRange * PLAE1CurveFit(0) + PLAE1CurveFit(1)) * PLA_TRANSFORMER_RATIO.Value.ToDouble)
                        PLA_RVDT_E1Y1_VDC.Value = New KineticaRT.Values.Double((CELProject.EngineConfiguration.PLAMaxRange * PLAE1CurveFit(0) + PLAE1CurveFit(1)) * PLA_TRANSFORMER_RATIO.Value.ToDouble)
                        PLA_RVDT_E2Y0_VDC.Value = New KineticaRT.Values.Double((CELProject.EngineConfiguration.PLAMinRange * PLAE2CurveFit(0) + PLAE2CurveFit(1)) * PLA_TRANSFORMER_RATIO.Value.ToDouble)
                        PLA_RVDT_E2Y1_VDC.Value = New KineticaRT.Values.Double((CELProject.EngineConfiguration.PLAMaxRange * PLAE2CurveFit(0) + PLAE2CurveFit(1)) * PLA_TRANSFORMER_RATIO.Value.ToDouble)

                    ElseIf sender.Name.Contains("CLP") Then

                        Dim CLPE1CurveFit As Double() = CELProject.LeastSquaresLine(CLP_RVDT_LEVER_POSITIONS, CLP_RVDT_E1_SCALING_FACTORS)
                        Dim CLPE2CurveFit As Double() = CELProject.LeastSquaresLine(CLP_RVDT_LEVER_POSITIONS, CLP_RVDT_E2_SCALING_FACTORS)

                        CLP_RVDT_E1Y0_VDC.Value = New KineticaRT.Values.Double((CELProject.EngineConfiguration.CLPMinRange * CLPE1CurveFit(0) + CLPE1CurveFit(1)) * CLP_TRANSFORMER_RATIO.Value.ToDouble)
                        CLP_RVDT_E1Y1_VDC.Value = New KineticaRT.Values.Double((CELProject.EngineConfiguration.CLPMaxRange * CLPE1CurveFit(0) + CLPE1CurveFit(1)) * CLP_TRANSFORMER_RATIO.Value.ToDouble)
                        CLP_RVDT_E2Y0_VDC.Value = New KineticaRT.Values.Double((CELProject.EngineConfiguration.CLPMinRange * CLPE2CurveFit(0) + CLPE2CurveFit(1)) * CLP_TRANSFORMER_RATIO.Value.ToDouble)
                        CLP_RVDT_E2Y1_VDC.Value = New KineticaRT.Values.Double((CELProject.EngineConfiguration.CLPMaxRange * CLPE2CurveFit(0) + CLPE2CurveFit(1)) * CLP_TRANSFORMER_RATIO.Value.ToDouble)

                    End If

                End If
            Catch ex As Exception

            End Try
        End Sub

        Private Sub OnSendRVDTResolver(ByVal sender As IChannel, ByVal newVal As Value)

            Try
                If CELProject.IsTrue(newVal) Then

                    If sender.Name.Contains("PLA") Then
                        SendConfigTocRIO("PLA")
                    ElseIf sender.Name.Contains("CLP") Then
                        SendConfigTocRIO("CLP")
                    End If

                End If
            Catch ex As Exception

            End Try
        End Sub

