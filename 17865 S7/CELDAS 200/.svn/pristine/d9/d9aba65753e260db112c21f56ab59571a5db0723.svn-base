        Private Sub RVDTResolverSelection()
            Try
                If CELProject.EngineConfiguration.PLALeverConfig = "RVDT" Then
                    PLA_RVDT_VSB_SOURCE.Value = Values.True
                ElseIf CELProject.EngineConfiguration.PLALeverConfig = "Resolver" Then
                    PLA_RVDT_VSB_SOURCE.Value = Values.False
                End If
                If CELProject.EngineConfiguration.CLPLeverConfig = "RVDT" Then
                    CLP_RVDT_VSB_SOURCE.Value = Values.True
                ElseIf CELProject.EngineConfiguration.CLPLeverConfig = "Resolver" Then
                    CLP_RVDT_VSB_SOURCE.Value = Values.False
                End If
            Catch ex As Exception
                MessageBox.Show("Critical.Engine_Sequence.RVDTResolverSelection: " & vbCrLf & vbCrLf & "Error message: " & vbCrLf & ex.ToString, "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub


