        Private Sub OnRVDTResolverCoefficients(ByVal sender As IChannel, ByVal newVal As Value)
            Try

                'Update Custom Parameters Dictionnary with new value
                If Custom_Parameters.Contains(sender.Name.ToString) Then
                    Custom_Parameters(sender.Name.ToString) = newVal.ToString
                End If

            Catch ex As Exception
                MessageBox.Show("Throttle_Sequence.OnRVDTConfigure: " & vbCrLf & vbCrLf &
                                "Error message: " & vbCrLf & ex.ToString,
                                "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub SendConfigTocRIO(ByVal LeverConfig As String)
            Try
                Dim msg As String = ""
                Dim msgData As System.Collections.Generic.IList(Of System.ArraySegment(Of Byte))
                msgData = New System.Collections.Generic.List(Of System.ArraySegment(Of Byte))


                If LeverConfig.Contains("PLA") Then

                    If CELProject.EngineConfiguration.PLALeverConfig = "RVDT" Then
                        msg = "0" & ";" & PLA_RVDT_E1Y1_VDC.Value.ToString & ";" & PLA_RVDT_E1Y0_VDC.Value.ToString & ";" & PLA_RVDT_E2Y1_VDC.Value.ToString & ";" & PLA_RVDT_E2Y0_VDC.Value.ToString
                        CEL.STM.Convert.Flatten(msg, msgData)
                        STMSession.SendMsg("RVDT.Configure", msgData)
                    ElseIf CELProject.EngineConfiguration.PLALeverConfig = "Resolver" Then
                        msg = "0" & ";" & PLA_TRANSFORMER_RATIO.Value.ToString & ";" & PLA_RESOLVER_LEVER0.Value.ToString & ";" & PLA_RESOLVER_ANGLE0.Value.ToString & ";" & PLA_RESOLVER_LEVER1.Value.ToString & ";" & PLA_RESOLVER_ANGLE1.Value.ToString
                        CEL.STM.Convert.Flatten(msg, msgData)
                        STMSession.SendMsg("Resolver.Configure", msgData)
                    End If

                ElseIf LeverConfig.Contains("CLP") Then

                    If CELProject.EngineConfiguration.CLPLeverConfig = "RVDT" Then
                        msg = "1" & ";" & CLP_RVDT_E1Y1_VDC.Value.ToString & ";" & CLP_RVDT_E1Y0_VDC.Value.ToString & ";" & CLP_RVDT_E2Y1_VDC.Value.ToString & ";" & CLP_RVDT_E2Y0_VDC.Value.ToString
                        CEL.STM.Convert.Flatten(msg, msgData)
                        STMSession.SendMsg("RVDT.Configure", msgData)
                    ElseIf CELProject.EngineConfiguration.CLPLeverConfig = "Resolver" Then
                        msg = "1" & ";" & CLP_TRANSFORMER_RATIO.Value.ToString & ";" & CLP_RESOLVER_LEVER0.Value.ToString & ";" & CLP_RESOLVER_ANGLE0.Value.ToString & ";" & CLP_RESOLVER_LEVER1.Value.ToString & ";" & CLP_RESOLVER_ANGLE1.Value.ToString
                        CEL.STM.Convert.Flatten(msg, msgData)
                        STMSession.SendMsg("Resolver.Configure", msgData)
                    End If

                End If

            Catch ex As Exception
                MessageBox.Show("Throttle_Sequence.SendConfigTocRIO: " & vbCrLf & vbCrLf &
                "Error message: " & vbCrLf & ex.ToString,
                "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        '*GOV*
        Private Sub OnCLACloseThrottleCalib_Btn(ByVal sender As IChannel, ByVal newVal As Value)
            Try

                If CELProject.IsTrue(newVal) Then

                    If (CELProject.IsTrue(newVal)) Then

                        CELProject.ActivateForm(GOVFormName, CELProject.DefaultParentWindow, False, False)

                    End If

                    CLA_CLOSE_THROTTLE_CALIB_BTN.Value = Values.False

                    ShowDynoWarningMessage()

                End If
            Catch ex As Exception
                MessageBox.Show("Critical.Engine_Sequence.OnCLACloseThrottleCalib_Btn: " & vbCrLf & vbCrLf & "Error message: " & vbCrLf & ex.ToString, "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

