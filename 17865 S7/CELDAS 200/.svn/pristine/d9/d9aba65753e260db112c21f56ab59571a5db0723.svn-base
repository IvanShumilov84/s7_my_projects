                Return_Value.Add(Initialize_Channel(CLP_RVDT_E1_MIN_VDC, "CLP_RVDT_E1_MIN_VDC"))
                Return_Value.Add(Initialize_Channel(CLP_RVDT_E1_MAX_VDC, "CLP_RVDT_E1_MAX_VDC"))
                Return_Value.Add(Initialize_Channel(CLP_RVDT_E2_MIN_VDC, "CLP_RVDT_E2_MIN_VDC"))
                Return_Value.Add(Initialize_Channel(CLP_RVDT_E2_MAX_VDC, "CLP_RVDT_E2_MAX_VDC"))

                Return_Value.Add(Initialize_Channel(CLP_CAPTURE_RVDT_MIN_BTN, "CLP_CAPTURE_RVDT_MIN_BTN"))
                Return_Value.Add(Initialize_Channel(CLP_CAPTURE_RVDT_MAX_BTN, "CLP_CAPTURE_RVDT_MAX_BTN"))
                Return_Value.Add(Initialize_Channel(CLP_COMPUTE_RVDT_BTN, "CLP_COMPUTE_RVDT_BTN"))
                Return_Value.Add(Initialize_Channel(CLP_SEND_BTN, "CLP_SEND_BTN"))
                Return_Value.Add(Initialize_Channel(CLP_TRANSFORMER_RATIO, "CLP_TRANSFORMER_RATIO"))

                Return_Value.Add(Initialize_Channel(PLA_RVDT_E1Y0_VDC, "PLA_RVDT_E1Y0_VDC"))
                Return_Value.Add(Initialize_Channel(PLA_RVDT_E1Y1_VDC, "PLA_RVDT_E1Y1_VDC"))
                Return_Value.Add(Initialize_Channel(PLA_RVDT_E2Y0_VDC, "PLA_RVDT_E2Y0_VDC"))
                Return_Value.Add(Initialize_Channel(PLA_RVDT_E2Y1_VDC, "PLA_RVDT_E2Y1_VDC"))

                Return_Value.Add(Initialize_Channel(PLA_RVDT_E1_MIN_VDC, "PLA_RVDT_E1_MIN_VDC"))
                Return_Value.Add(Initialize_Channel(PLA_RVDT_E1_MAX_VDC, "PLA_RVDT_E1_MAX_VDC"))
                Return_Value.Add(Initialize_Channel(PLA_RVDT_E2_MIN_VDC, "PLA_RVDT_E2_MIN_VDC"))
                Return_Value.Add(Initialize_Channel(PLA_RVDT_E2_MAX_VDC, "PLA_RVDT_E2_MAX_VDC"))

                Return_Value.Add(Initialize_Channel(PLA_CAPTURE_RVDT_MIN_BTN, "PLA_CAPTURE_RVDT_MIN_BTN"))
                Return_Value.Add(Initialize_Channel(PLA_CAPTURE_RVDT_MAX_BTN, "PLA_CAPTURE_RVDT_MAX_BTN"))
                Return_Value.Add(Initialize_Channel(PLA_COMPUTE_RVDT_BTN, "PLA_COMPUTE_RVDT_BTN"))
                Return_Value.Add(Initialize_Channel(PLA_SEND_BTN, "PLA_SEND_BTN"))
                Return_Value.Add(Initialize_Channel(PLA_TRANSFORMER_RATIO, "PLA_TRANSFORMER_RATIO"))

                Return_Value.Add(Initialize_Channel(PLA_RESOLVER_LEVER0, "PLA_RESOLVER_LEVER0"))
                Return_Value.Add(Initialize_Channel(PLA_RESOLVER_LEVER1, "PLA_RESOLVER_LEVER1"))
                Return_Value.Add(Initialize_Channel(PLA_RESOLVER_ANGLE0, "PLA_RESOLVER_ANGLE0"))
                Return_Value.Add(Initialize_Channel(PLA_RESOLVER_ANGLE1, "PLA_RESOLVER_ANGLE1"))


                Return_Value.Add(Initialize_Channel(CLP_RESOLVER_LEVER0, "CLP_RESOLVER_LEVER0"))
                Return_Value.Add(Initialize_Channel(CLP_RESOLVER_LEVER1, "CLP_RESOLVER_LEVER1"))
                Return_Value.Add(Initialize_Channel(CLP_RESOLVER_ANGLE0, "CLP_RESOLVER_ANGLE0"))
                Return_Value.Add(Initialize_Channel(CLP_RESOLVER_ANGLE1, "CLP_RESOLVER_ANGLE1"))


                Return_Value.Add(Initialize_Channel(THROTTLE_INSTANCE, "THROTTLE_INSTANCE"))

                Return_Value.Add(Initialize_Channel(CLOSE_RVDT_RESOLVER_CONFIG_WINDOW_BTN, "CLOSE_RVDT_RESOLVER_CONFIG_WINDOW_BTN"))
                Return_Value.Add(Initialize_Channel(RVDT_RESOLVER_SAVE_BTN, "RVDT_RESOLVER_SAVE_BTN"))

                Return_Value.Add(Initialize_Object(FrameCtrl_FCU_Rigging, "FCU_Rigging_Screen.PT6A_68_RIG_AUTO"))
                Return_Value.Add(Initialize_Object(PT6A_68_RA_Name, "FCU_Rigging_Screen.PT6A_68_RA_LBL"))

                Select Case CELProject.EngineFamily

                    Case "PW200"
                        Return_Value.Add(MyBase.InitializeChannel(DYNO_SPEED_100_PCT_RPM, "DYNO_SPEED_100_PCT_RPM"))
                End Select

#If CELDAS200 Then
                Select Case CELProject.EngineFamily

                    Case "PT6C", "PW200", "PW210"

                        FrameCtrl_FCU_Rigging.Visible = False
                        PT6A_68_RA_Name.Visible = False

                    Case "PT6A"
                        Return_Value.Add(Initialize_Channel(USER_AUTO_RIGGING, "USER_AUTO_RIGGING"))
                        FrameCtrl_FCU_Rigging.Visible = True
                        PT6A_68_RA_Name.Visible = True

                End Select
#End If
                If Return_Value.Contains(False) Then
                    Return False
                Else
                    Return True
                End If

            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: Throttle_Sequence.Init_Channels: " & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.Message)
                Return False
            End Try
        End Function

        Private Function Init_RVDT_Channels_Value() As Boolean
            Try

                'RVDT
                PLA_RVDT_E1Y0_VDC.Value = New KineticaRT.Values.Double(Custom_Parameters("PLA_RVDT_E1Y0_VDC"))
                PLA_RVDT_E1Y1_VDC.Value = New KineticaRT.Values.Double(Custom_Parameters("PLA_RVDT_E1Y1_VDC"))
                PLA_RVDT_E2Y0_VDC.Value = New KineticaRT.Values.Double(Custom_Parameters("PLA_RVDT_E2Y0_VDC"))
                PLA_RVDT_E2Y1_VDC.Value = New KineticaRT.Values.Double(Custom_Parameters("PLA_RVDT_E2Y1_VDC"))

                PLA_RVDT_E1_MIN_VDC.Value = New KineticaRT.Values.Double(Custom_Parameters("PLA_RVDT_E1_MIN_VDC"))
                PLA_RVDT_E1_MAX_VDC.Value = New KineticaRT.Values.Double(Custom_Parameters("PLA_RVDT_E1_MAX_VDC"))
                PLA_RVDT_E2_MIN_VDC.Value = New KineticaRT.Values.Double(Custom_Parameters("PLA_RVDT_E2_MIN_VDC"))
                PLA_RVDT_E2_MAX_VDC.Value = New KineticaRT.Values.Double(Custom_Parameters("PLA_RVDT_E2_MAX_VDC"))

                CLP_RVDT_E1Y0_VDC.Value = New KineticaRT.Values.Double(Custom_Parameters("CLP_RVDT_E1Y0_VDC"))
                CLP_RVDT_E1Y1_VDC.Value = New KineticaRT.Values.Double(Custom_Parameters("CLP_RVDT_E1Y1_VDC"))
                CLP_RVDT_E2Y0_VDC.Value = New KineticaRT.Values.Double(Custom_Parameters("CLP_RVDT_E2Y0_VDC"))
                CLP_RVDT_E2Y1_VDC.Value = New KineticaRT.Values.Double(Custom_Parameters("CLP_RVDT_E2Y1_VDC"))

                CLP_RVDT_E1_MIN_VDC.Value = New KineticaRT.Values.Double(Custom_Parameters("CLP_RVDT_E1_MIN_VDC"))
                CLP_RVDT_E1_MAX_VDC.Value = New KineticaRT.Values.Double(Custom_Parameters("CLP_RVDT_E1_MAX_VDC"))
                CLP_RVDT_E2_MIN_VDC.Value = New KineticaRT.Values.Double(Custom_Parameters("CLP_RVDT_E2_MIN_VDC"))
                CLP_RVDT_E2_MAX_VDC.Value = New KineticaRT.Values.Double(Custom_Parameters("CLP_RVDT_E2_MAX_VDC"))

                ReDim PLA_RVDT_LEVER_POSITIONS(1)
                ReDim PLA_RVDT_E1_SCALING_FACTORS(1)
                ReDim PLA_RVDT_E2_SCALING_FACTORS(1)
                ReDim CLP_RVDT_LEVER_POSITIONS(1)
                ReDim CLP_RVDT_E1_SCALING_FACTORS(1)
                ReDim CLP_RVDT_E2_SCALING_FACTORS(1)

                'RESOLVER
                PLA_RESOLVER_LEVER0.Value = New KineticaRT.Values.Double(Custom_Parameters("PLA_RESOLVER_LEVER0"))
                PLA_RESOLVER_LEVER1.Value = New KineticaRT.Values.Double(Custom_Parameters("PLA_RESOLVER_LEVER1"))
                PLA_RESOLVER_ANGLE0.Value = New KineticaRT.Values.Double(Custom_Parameters("PLA_RESOLVER_ANGLE0"))
                PLA_RESOLVER_ANGLE1.Value = New KineticaRT.Values.Double(Custom_Parameters("PLA_RESOLVER_ANGLE1"))

                CLP_RESOLVER_LEVER0.Value = New KineticaRT.Values.Double(Custom_Parameters("CLP_RESOLVER_LEVER0"))
                CLP_RESOLVER_LEVER1.Value = New KineticaRT.Values.Double(Custom_Parameters("CLP_RESOLVER_LEVER1"))
                CLP_RESOLVER_ANGLE0.Value = New KineticaRT.Values.Double(Custom_Parameters("CLP_RESOLVER_ANGLE0"))
                CLP_RESOLVER_ANGLE1.Value = New KineticaRT.Values.Double(Custom_Parameters("CLP_RESOLVER_ANGLE1"))

                Init_RVDT_Channels_Value = True

            Catch Ex As Exception
                MessageBox.Show("Throttle_Sequence.Init_RVDT_Channels_Value: " & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.Message, "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return False
            End Try
        End Function

        'TODO A RETIRER
        Private Function Initialize_Channel(ByRef Channel As Object, ByVal ChannelName As String) As Boolean
            Try
                Channel = GetChannel(ChannelName)
                If Channel Is Nothing Then
                    MessageBox.Show("Initialize_Channel - " + ChannelName + " Is Nothing")
                    Return False
                End If
                Initialize_Channel = True
            Catch Ex As Exception
                MessageBox.Show("Throttle_Sequence.Initialize_Channel: " & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.Message, "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return False
            End Try
        End Function

        'TODO A RETIRER
        Private Function Initialize_Object(ByRef Channel As Object, ByVal ChannelName As String) As Boolean
            Try
                Channel = GetObject(ChannelName)
                If Channel Is Nothing Then
                    MessageBox.Show("Initialize_Object - " + ChannelName + " Is Nothing")
                    Return False
                End If
                Initialize_Object = True
            Catch Ex As Exception
                MessageBox.Show("Throttle_Sequence.Initialize_Object: " & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.Message, "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return False
            End Try
        End Function

        Private Sub OnComputeBtn(ByVal sender As IChannel, ByVal newVal As Value)
            Dim throttleInstance As ThrottleInstanceName
            Try
                If CELProject.IsTrue(newVal) Then
                    If sender Is PLA_COMPUTE_BTN Then
                        throttleInstance = ThrottleInstanceName.PLA
                    ElseIf sender Is CLA_COMPUTE_BTN Then
                        throttleInstance = ThrottleInstanceName.CLA
                    ElseIf sender Is MOR_COMPUTE_BTN Then
                        throttleInstance = ThrottleInstanceName.MOR
                    Else
                        MessageBox.Show("Throttle_Sequence.OnComputeBtn: " & vbCrLf & vbCrLf &
                                        "Unexpected sender",
                                        "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Return
                    End If

                    Dim msg As String = CByte(throttleInstance).ToString()

                    Dim msgData As System.Collections.Generic.IList(Of System.ArraySegment(Of Byte))
                    msgData = New System.Collections.Generic.List(Of System.ArraySegment(Of Byte))
                    CEL.STM.Convert.Flatten(msg, msgData)
                    If CELProject.DataAcquisitionMode = CELDAS.eDataAcquisitionMode.RUN_FOR_TRUE Then
                        STMSession.SendMsg("Throttle.Compute", msgData)
                    Else
                        If sender Is PLA_COMPUTE_BTN Then
                            PLA_COMPUTE_DONE.Value = Values.True
                            PLA_RIGGING_DONE.Value = Values.True
                        ElseIf sender Is CLA_COMPUTE_BTN Then
                            CLA_COMPUTE_DONE.Value = Values.True
                            CLA_RIGGING_DONE.Value = Values.True
                        ElseIf sender Is MOR_COMPUTE_BTN Then
                            MOR_COMPUTE_DONE.Value = Values.True
                            MOR_RIGGING_DONE.Value = Values.True
                        End If
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("Throttle_Sequence.OnComputeBtn(" & throttleInstance.ToString() & "): " & vbCrLf & vbCrLf &
                                "Error message: " & vbCrLf & ex.ToString,
                                "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally
                sender.Value = Values.False
            End Try
        End Sub

        Private Sub OnEngageBtn(ByVal sender As IChannel, ByVal newVal As Value)
            Dim msgName As String = ""
            Dim throttleInstance As ThrottleInstanceName
            Try
                If sender Is PLA_ENGAGE_BTN Then
                    throttleInstance = ThrottleInstanceName.PLA
                ElseIf sender Is CLA_ENGAGE_BTN Then
                    throttleInstance = ThrottleInstanceName.CLA
                ElseIf sender Is MOR_ENGAGE_BTN Then
                    throttleInstance = ThrottleInstanceName.MOR
                Else
                    MessageBox.Show("Throttle_Sequence.OnEngageBtn: " & vbCrLf & vbCrLf &
                                    "Unexpected sender",
                                    "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Return
                End If

                If CELProject.IsTrue(newVal) Then
                    msgName = "Throttle.Engage"
                Else
                    msgName = "Throttle.Disengage"
                End If

                Dim msg As String = CByte(throttleInstance).ToString()

                Dim msgData As System.Collections.Generic.IList(Of System.ArraySegment(Of Byte))
                msgData = New System.Collections.Generic.List(Of System.ArraySegment(Of Byte))
                CEL.STM.Convert.Flatten(msg, msgData)
                STMSession.SendMsg(msgName, msgData)
            Catch ex As Exception
                MessageBox.Show("Throttle_Sequence.OnEngageBtn: " & vbCrLf & vbCrLf &
                                "Error message: " & vbCrLf & ex.ToString,
                                "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub OnPulse(ByVal sender As IChannel, ByVal newVal As Value)

            Try
                'We send the keep alive message only when the on rising pulse
                If CELProject.IsTrue(newVal) And CELProject.IsTrue(CRIO_CONNECTED.Value) Then

                    Dim msg As String = CByte(ThrottleInstanceName.PLA).ToString()  'it can be PLA or CLA or MOR, it's not important

                    Dim msgData As System.Collections.Generic.IList(Of System.ArraySegment(Of Byte))
                    msgData = New System.Collections.Generic.List(Of System.ArraySegment(Of Byte))
                    CEL.STM.Convert.Flatten(msg, msgData)

                    STMSession.SendMsg("Throttle.KeepAlive", msgData)

                End If

            Catch ex As Exception
                MessageBox.Show("Throttle_Sequence.OnPulse: " & vbCrLf & vbCrLf &
                                "Error message: " & vbCrLf & ex.ToString,
                                "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub OnResetBtn(ByVal sender As IChannel, ByVal newVal As Value)
            Dim throttleInstance As ThrottleInstanceName
            Try
                If CELProject.IsTrue(newVal) Then
                    If sender Is PLA_RESET_BTN Then
                        throttleInstance = ThrottleInstanceName.PLA
                    ElseIf sender Is CLA_RESET_BTN Then
                        throttleInstance = ThrottleInstanceName.CLA
                    ElseIf sender Is MOR_RESET_BTN Then
                        throttleInstance = ThrottleInstanceName.MOR
                    Else
                        MessageBox.Show("Throttle_Sequence.OnResetBtn: " & vbCrLf & vbCrLf &
                                        "Unexpected sender",
                                        "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Return
                    End If

                    Dim msg = CByte(throttleInstance).ToString()

                    Dim msgData As System.Collections.Generic.IList(Of System.ArraySegment(Of Byte))
                    msgData = New System.Collections.Generic.List(Of System.ArraySegment(Of Byte))
                    CEL.STM.Convert.Flatten(msg, msgData)
                    If CELProject.DataAcquisitionMode = CELDAS.eDataAcquisitionMode.RUN_FOR_TRUE Then
                        STMSession.SendMsg("Throttle.ResetRigging", msgData)
                    Else
                        If sender Is PLA_RESET_BTN Then
                            PLA_COMPUTE_DONE.Value = Values.False
                            PLA_IDLE_POS_DONE.Value = Values.False
                            PLA_LEVER_POS.Value = New KineticaRT.Values.Double(0.0)
                            PLA_MAX_POS_DONE.Value = Values.False
                            PLA_MAX_STOP_POS_DONE.Value = Values.False
                            PLA_MIN_POS_DONE.Value = Values.False
                            PLA_MIN_STOP_POS_DONE.Value = Values.False
                            PLA_RIGGING_DONE.Value = Values.False
                            PLA_SERVO_READING.Value = New KineticaRT.Values.Double(0.0)
                            PLA_SERVO_ANGLE_READING.Value = New KineticaRT.Values.Double(0.0)
                            PLA_MIN_RIG_POS.Value = New KineticaRT.Values.Double(0.0)
                        ElseIf sender Is CLA_RESET_BTN Then
                            CLA_COMPUTE_DONE.Value = Values.False
                            CLA_IDLE_POS_DONE.Value = Values.False
                            CLA_LEVER_POS.Value = New KineticaRT.Values.Double(0.0)
                            CLA_MAX_POS_DONE.Value = Values.False
                            CLA_MAX_STOP_POS_DONE.Value = Values.False
                            CLA_MIN_POS_DONE.Value = Values.False
                            CLA_MIN_STOP_POS_DONE.Value = Values.False
                            CLA_RIGGING_DONE.Value = Values.False
                            CLA_SERVO_READING.Value = New KineticaRT.Values.Double(0.0)
                            CLA_SERVO_ANGLE_READING.Value = New KineticaRT.Values.Double(0.0)
                            CLA_MIN_RIG_POS.Value = New KineticaRT.Values.Double(0.0)
                            CLA_MIN_RIG_POS.Value = New KineticaRT.Values.Double(0.0)
                        ElseIf sender Is MOR_RESET_BTN Then
                            MOR_COMPUTE_DONE.Value = Values.False
                            MOR_IDLE_POS_DONE.Value = Values.False
                            MOR_LEVER_POS.Value = New KineticaRT.Values.Double(0.0)
                            MOR_MAX_POS_DONE.Value = Values.False
                            MOR_MAX_STOP_POS_DONE.Value = Values.False
                            MOR_MIN_POS_DONE.Value = Values.False
                            MOR_MIN_STOP_POS_DONE.Value = Values.False
                            MOR_RIGGING_DONE.Value = Values.False
                            MOR_SERVO_READING.Value = New KineticaRT.Values.Double(0.0)
                            MOR_SERVO_ANGLE_READING.Value = New KineticaRT.Values.Double(0.0)
                            MOR_MIN_RIG_POS.Value = New KineticaRT.Values.Double(0.0)
                            MOR_MIN_RIG_POS.Value = New KineticaRT.Values.Double(0.0)
                        End If
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("Throttle_Sequence.OnResetBtn: " & vbCrLf & vbCrLf &
                                "Error message: " & vbCrLf & ex.ToString,
                                "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally
                sender.Value = Values.False
            End Try
        End Sub

        Private Sub ResetRigging()
            Dim PLAInstance As ThrottleInstanceName = ThrottleInstanceName.PLA
            Dim CLAInstance As ThrottleInstanceName = ThrottleInstanceName.CLA
            Dim MORInstance As ThrottleInstanceName = ThrottleInstanceName.MOR

            Try

                If CELProject.IsTrue(CRIO_CONNECTED.Value) Then

                    Dim plamsg = CByte(PLAInstance).ToString()
                    Dim plamsgData As System.Collections.Generic.IList(Of System.ArraySegment(Of Byte))
                    plamsgData = New System.Collections.Generic.List(Of System.ArraySegment(Of Byte))
                    CEL.STM.Convert.Flatten(plamsg, plamsgData)
                    STMSession.SendMsg("Throttle.ResetRigging", plamsgData)

                    Dim clamsg = CByte(CLAInstance).ToString()
                    Dim clamsgData As System.Collections.Generic.IList(Of System.ArraySegment(Of Byte))
                    clamsgData = New System.Collections.Generic.List(Of System.ArraySegment(Of Byte))
                    CEL.STM.Convert.Flatten(clamsg, clamsgData)
                    STMSession.SendMsg("Throttle.ResetRigging", clamsgData)

                    Dim mormsg = CByte(MORInstance).ToString()
                    Dim mormsgData As System.Collections.Generic.IList(Of System.ArraySegment(Of Byte))
                    mormsgData = New System.Collections.Generic.List(Of System.ArraySegment(Of Byte))
                    CEL.STM.Convert.Flatten(mormsg, mormsgData)
                    STMSession.SendMsg("Throttle.ResetRigging", mormsgData)

                End If

            Catch ex As Exception
                MessageBox.Show("Throttle_Sequence.ResetRigging: " & vbCrLf & vbCrLf &
                                "Error message: " & vbCrLf & ex.ToString,
                                "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub OnReturnToIdleCmd(ByVal sender As IChannel, ByVal newVal As Value)
            Dim throttleInstance As ThrottleInstanceName
            Dim stmMessage As String
            Try
                If sender Is CLA_RETURN_TO_IDLE_CMD Then
                    throttleInstance = ThrottleInstanceName.CLA
                ElseIf sender Is MOR_RETURN_TO_IDLE_CMD Then
                    throttleInstance = ThrottleInstanceName.MOR
                ElseIf sender Is PLA_RETURN_TO_IDLE_CMD Then
                    throttleInstance = ThrottleInstanceName.PLA
                Else
                    MessageBox.Show("Throttle_Sequence.OnReturnToIdleCmd: " & vbCrLf & vbCrLf &
                                    "Unexpected sender",
                                    "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Return
                End If

                If CELProject.IsTrue(newVal) Then
                    stmMessage = "Throttle.ActivateGoToIdlePosition"
                Else
                    stmMessage = "Throttle.DeactivateGoToIdlePosition"
                End If

                Dim msg = CByte(throttleInstance).ToString()
                Dim msgData As System.Collections.Generic.IList(Of System.ArraySegment(Of Byte))

                msgData = New System.Collections.Generic.List(Of System.ArraySegment(Of Byte))
                CEL.STM.Convert.Flatten(msg, msgData)
                STMSession.SendMsg(stmMessage, msgData)

            Catch ex As Exception
                MessageBox.Show("Throttle_Sequence.OnReturnToIdleCmd(" & throttleInstance.ToString() & "): " & vbCrLf & vbCrLf &
                                "Error message: " & vbCrLf & ex.ToString,
                                "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub OnStoreIdleAngleBtn(ByVal sender As IChannel, ByVal newVal As Value)
            Dim angle As String = "0.0"
            Dim throttleInstance As ThrottleInstanceName

            Try
                If CELProject.IsTrue(newVal) Then
                    If sender Is CLA_STORE_IDLE_ANGLE_BTN Then
                        CLA_IDLE_POS_DEG.Value = CLA_SERVO_ANGLE_READING.Value
                        angle = CLA_IDLE_POS_DEG.Value.ToString()
                        throttleInstance = ThrottleInstanceName.CLA
                    ElseIf sender Is MOR_STORE_IDLE_ANGLE_BTN Then
                        MOR_IDLE_POS_DEG.Value = MOR_SERVO_ANGLE_READING.Value
                        angle = MOR_IDLE_POS_DEG.Value.ToString()
                        throttleInstance = ThrottleInstanceName.MOR
                    ElseIf sender Is PLA_STORE_IDLE_ANGLE_BTN Then
                        PLA_IDLE_POS_DEG.Value = PLA_SERVO_ANGLE_READING.Value
                        angle = PLA_IDLE_POS_DEG.Value.ToString()
                        throttleInstance = ThrottleInstanceName.PLA
                    Else
                        MessageBox.Show("Throttle_Sequence.OnStoreIdleAngleBtn: " & vbCrLf & vbCrLf &
                                        "Unexpected sender",
                                        "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Return
                    End If

                    Dim msg As String = CByte(throttleInstance).ToString & ";" & angle
                    Dim msgData As System.Collections.Generic.IList(Of System.ArraySegment(Of Byte))

                    msgData = New System.Collections.Generic.List(Of System.ArraySegment(Of Byte))
                    CEL.STM.Convert.Flatten(msg, msgData)
                    If CELProject.DataAcquisitionMode = CELDAS.eDataAcquisitionMode.RUN_FOR_TRUE Then
                        STMSession.SendMsg("Throttle.StoreIdlePosition", msgData)
                    Else
                        If sender Is PLA_STORE_IDLE_ANGLE_BTN Then
                            PLA_IDLE_POS_DONE.Value = Values.True
                            PLA_IDLE_POS_DEG.Value = New KineticaRT.Values.Double(26.0)
                            PLA_LEVER_POS.Value = New KineticaRT.Values.Double(26.0)
                            PLA_SERVO_READING.Value = New KineticaRT.Values.Double(26.0)
                            PLA_SERVO_ANGLE_READING.Value = New KineticaRT.Values.Double(26.0)
                        ElseIf sender Is CLA_STORE_IDLE_ANGLE_BTN Then
                            CLA_IDLE_POS_DONE.Value = Values.True
                            CLA_IDLE_POS_DEG.Value = New KineticaRT.Values.Double(26.0)
                            CLA_LEVER_POS.Value = New KineticaRT.Values.Double(26.0)
                            CLA_SERVO_READING.Value = New KineticaRT.Values.Double(26.0)
                            CLA_SERVO_ANGLE_READING.Value = New KineticaRT.Values.Double(26.0)
                        ElseIf sender Is MOR_STORE_IDLE_ANGLE_BTN Then
                            MOR_IDLE_POS_DONE.Value = Values.True
                            MOR_IDLE_POS_DEG.Value = New KineticaRT.Values.Double(26.0)
                            MOR_LEVER_POS.Value = New KineticaRT.Values.Double(26.0)
                            MOR_SERVO_READING.Value = New KineticaRT.Values.Double(26.0)
                            MOR_SERVO_ANGLE_READING.Value = New KineticaRT.Values.Double(26.0)
                        End If
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("Throttle_Sequence.OnStoreIdleAngleBtn(" & throttleInstance.ToString() & "): " & vbCrLf & vbCrLf &
                                "Error message: " & vbCrLf & ex.ToString,
                                "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally
                sender.Value = KineticaRT.Values.Values.False
            End Try
        End Sub

        Private Sub OnStoreMaxMinAngleBtn(ByVal sender As IChannel, ByVal newVal As Value)
            Dim angle As String = "0.0"
            Dim msgName As String = ""
            Dim throttleInstance As ThrottleInstanceName

            Try
                If CELProject.IsTrue(newVal) Then
                    If sender Is PLA_STORE_MAX_ANGLE_BTN Then
                        angle = PLA_MAX_RIG_POS.Value.ToString()
                        msgName = "Throttle.StoreMaxPosition"
                        throttleInstance = ThrottleInstanceName.PLA
                    ElseIf sender Is PLA_STORE_MIN_ANGLE_BTN Then
                        angle = PLA_MIN_RIG_POS.Value.ToString()
                        msgName = "Throttle.StoreMinPosition"
                        throttleInstance = ThrottleInstanceName.PLA
                    ElseIf sender Is CLA_STORE_MAX_ANGLE_BTN Then
                        angle = CLA_MAX_RIG_POS.Value.ToString()
                        msgName = "Throttle.StoreMaxPosition"
                        throttleInstance = ThrottleInstanceName.CLA
                    ElseIf sender Is CLA_STORE_MIN_ANGLE_BTN Then
                        angle = CLA_MIN_RIG_POS.Value.ToString()
                        msgName = "Throttle.StoreMinPosition"
                        throttleInstance = ThrottleInstanceName.CLA
                    ElseIf sender Is MOR_STORE_MAX_ANGLE_BTN Then
                        angle = MOR_MAX_RIG_POS.Value.ToString()
                        msgName = "Throttle.StoreMaxPosition"
                        throttleInstance = ThrottleInstanceName.MOR
                    ElseIf sender Is MOR_STORE_MIN_ANGLE_BTN Then
                        angle = MOR_MIN_RIG_POS.Value.ToString()
                        msgName = "Throttle.StoreMinPosition"
                        throttleInstance = ThrottleInstanceName.MOR
                    Else
                        MessageBox.Show("Throttle_Sequence.OnStoreMaxMinAngleBtn: " & vbCrLf & vbCrLf &
                                        "Unexpected sender",
                                        "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Return
                    End If

                    Dim msg As String = CByte(throttleInstance).ToString & ";" & angle

                    Dim msgData As System.Collections.Generic.IList(Of System.ArraySegment(Of Byte))
                    msgData = New System.Collections.Generic.List(Of System.ArraySegment(Of Byte))
                    CEL.STM.Convert.Flatten(msg, msgData)
                    If CELProject.DataAcquisitionMode = CELDAS.eDataAcquisitionMode.RUN_FOR_TRUE Then
                        STMSession.SendMsg(msgName, msgData)
                    Else
                        If sender Is PLA_STORE_MAX_ANGLE_BTN Then
                            PLA_MAX_POS_DONE.Value = Values.True
                            PLA_LEVER_POS.Value = New KineticaRT.Values.Double(0.0)
                        ElseIf sender Is PLA_STORE_MIN_ANGLE_BTN Then
                            PLA_MIN_POS_DONE.Value = Values.True
                            PLA_LEVER_POS.Value = PLA_MAX_RIG_POS.Value
                        ElseIf sender Is CLA_STORE_MAX_ANGLE_BTN Then
                            CLA_MAX_POS_DONE.Value = Values.True
                            CLA_LEVER_POS.Value = New KineticaRT.Values.Double(0.0)
                        ElseIf sender Is CLA_STORE_MIN_ANGLE_BTN Then
                            CLA_MIN_POS_DONE.Value = Values.True
                            CLA_LEVER_POS.Value = CLA_MAX_RIG_POS.Value
                        ElseIf sender Is MOR_STORE_MAX_ANGLE_BTN Then
                            MOR_MAX_POS_DONE.Value = Values.True
                            MOR_LEVER_POS.Value = New KineticaRT.Values.Double(0.0)
                        ElseIf sender Is MOR_STORE_MIN_ANGLE_BTN Then
                            MOR_MIN_POS_DONE.Value = Values.True
                            MOR_LEVER_POS.Value = MOR_MAX_RIG_POS.Value
                        End If
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("Throttle_Sequence.OnStoreMaxMinAngleBtn(" & throttleInstance.ToString() & "): " & vbCrLf & vbCrLf &
                                "Error message: " & vbCrLf & ex.ToString,
                                "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally
                sender.Value = Values.False
            End Try

        End Sub

        Private Sub OnStoreMaxMinStopBtn(ByVal sender As IChannel, ByVal newVal As Value)
            Dim msgName As String = ""
            Dim throttleInstance As ThrottleInstanceName

