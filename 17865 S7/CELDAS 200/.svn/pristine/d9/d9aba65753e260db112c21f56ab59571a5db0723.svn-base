        Private Sub OnUSER_AUTO_RIGGING(ByVal sender As IChannel, ByVal newVal As Value)
            'Used Only for PT6A-68
            'The manual says that auto rigging button must be pressed at least 2 seconds
            Try

                If CELProject.IsTrue(newVal) Then

                    Thread.Sleep(2500)
                    USER_AUTO_RIGGING.Value = Values.False

                End If

            Catch ex As Exception

            End Try
        End Sub

        Protected Overrides Sub OnTestSessionInitialized(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try

            Catch ex As Exception
                MessageBox.Show("Throttle_Sequence.OnTestSessionInitialized: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)

            Catch ex As Exception

                MessageBox.Show("Throttle_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            End Try
        End Sub

        Protected Overrides Sub OnTestSessionRunning(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                'Load up in memory some constant table (from database)
                If CELProject.EngineModel <> "DAS CALIBRATION" And CELProject.EngineModel <> "SYSTEM CHECK" And
                    CELProject.HierarchyType = CELDAS.eHierarchyType.Master Then
                    CELProject.LoadSave_Custom_Parameters(Custom_Parameters, False)

                    If Init_Channels() Then
                        If Init_RVDT_Channels_Value() Then

                            AddHandler CLA_CLOSE_THROTTLE_CALIB_BTN.ValueChanged, AddressOf OnCLACloseThrottleCalib_Btn
                            AddHandler CLA_COMPUTE_BTN.ValueChanged, AddressOf OnComputeBtn
                            AddHandler CLA_ENGAGE_BTN.ValueChanged, AddressOf OnEngageBtn
                            AddHandler CLA_RESET_BTN.ValueChanged, AddressOf OnResetBtn
                            AddHandler CLA_RETURN_TO_IDLE_CMD.ValueChanged, AddressOf OnReturnToIdleCmd
                            AddHandler CLA_STORE_IDLE_ANGLE_BTN.ValueChanged, AddressOf OnStoreIdleAngleBtn
                            AddHandler CLA_STORE_MIN_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinAngleBtn
                            AddHandler CLA_STORE_MIN_STOP_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinStopBtn
                            AddHandler CLA_STORE_MAX_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinAngleBtn
                            AddHandler CLA_STORE_MAX_STOP_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinStopBtn

                            AddHandler PLA_CLOSE_THROTTLE_CALIB_BTN.ValueChanged, AddressOf OnPLACloseThrottleCalib_Btn
