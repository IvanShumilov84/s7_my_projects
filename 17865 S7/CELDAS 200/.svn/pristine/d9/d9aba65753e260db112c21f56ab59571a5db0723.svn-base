                            AddHandler PLA_RETURN_TO_IDLE_CMD.ValueChanged, AddressOf OnReturnToIdleCmd
                            AddHandler PLA_STORE_IDLE_ANGLE_BTN.ValueChanged, AddressOf OnStoreIdleAngleBtn
                            AddHandler PLA_STORE_MIN_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinAngleBtn
                            AddHandler PLA_STORE_MIN_STOP_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinStopBtn
                            AddHandler PLA_STORE_MAX_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinAngleBtn
                            AddHandler PLA_STORE_MAX_STOP_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinStopBtn

                            AddHandler PULSE.ValueChanged, AddressOf OnPulse

                            AddHandler MOR_COMPUTE_BTN.ValueChanged, AddressOf OnComputeBtn
                            AddHandler MOR_ENGAGE_BTN.ValueChanged, AddressOf OnEngageBtn
                            AddHandler MOR_RESET_BTN.ValueChanged, AddressOf OnResetBtn
                            AddHandler MOR_RETURN_TO_IDLE_CMD.ValueChanged, AddressOf OnReturnToIdleCmd
                            AddHandler MOR_STORE_IDLE_ANGLE_BTN.ValueChanged, AddressOf OnStoreIdleAngleBtn
                            AddHandler MOR_STORE_MIN_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinAngleBtn
                            AddHandler MOR_STORE_MIN_STOP_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinStopBtn
                            AddHandler MOR_STORE_MAX_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinAngleBtn
                            AddHandler MOR_STORE_MAX_STOP_ANGLE_BTN.ValueChanged, AddressOf OnStoreMaxMinStopBtn

                            AddHandler CLOSE_RVDT_RESOLVER_CONFIG_WINDOW_BTN.ValueChanged, AddressOf OnRVDT_RESOLVER_CONFIG_WINDOW

                            AddHandler CLP_CAPTURE_RVDT_MIN_BTN.ValueChanged, AddressOf OnCaptureRVDT
                            AddHandler CLP_CAPTURE_RVDT_MAX_BTN.ValueChanged, AddressOf OnCaptureRVDT
                            AddHandler CLP_COMPUTE_RVDT_BTN.ValueChanged, AddressOf OnComputeRVDT
