        Public Class UserInput15234

            Public EngineSerialNumber As String = ""
            Public WorkOrder As String = ""
            Public PartNumber As String = ""
            Public LHV As String = ""
            Public OilType As String = ""
            Public FuelType As String = ""
            Public CustomerName As String = ""
            Public ManualRevDate As String = ""

            Public OverTempEGTRTI As String = ""
            Public OverTempEGTStart As String = ""
            Public OverTempITTRTI As String = ""
            Public OverTempITTStart As String = ""
            Public OverTorqueRTI As String = ""

            Public TestType As String = ""
            Public PropellerType As String = ""
            Public GRModelType As String = ""
            Public TorqueSensor As String = ""
            Public OperatorName As String = ""
            Public InspectorName As String = ""
            Public ReturnToIdleSource As String = ""
            Public SpeedSensor As String = ""

            ' Allow friend access to the empty constructor.
            Friend Sub New()

            End Sub
            Public Sub MapUserInputsParameters(ByRef CELProject As CELDAS)

                EngineSerialNumber = CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
                WorkOrder = CELProject.Test_Mgr_UUT_Answer(1).Value.ToString()
                PartNumber = CELProject.Test_Mgr_UUT_Answer(2).Value.ToString()
                LHV = CELProject.Test_Mgr_UUT_Answer(3).Value.ToString()
                OilType = CELProject.Test_Mgr_UUT_Answer(4).Value.ToString()
                FuelType = CELProject.Test_Mgr_UUT_Answer(5).Value.ToString()
                CustomerName = CELProject.Test_Mgr_UUT_Answer(6).Value.ToString()
                ManualRevDate = CELProject.Test_Mgr_UUT_Answer(7).Value.ToString()

                OverTempEGTRTI = CELProject.Test_Mgr_UUT_Answer(12).Value.ToString
                OverTempEGTStart = CELProject.Test_Mgr_UUT_Answer(13).Value.ToString
                OverTempITTRTI = CELProject.Test_Mgr_UUT_Answer(14).Value.ToString
                OverTempITTStart = CELProject.Test_Mgr_UUT_Answer(15).Value.ToString

                OverTorqueRTI = CELProject.Test_Mgr_UUT_Answer(16).Value.ToString

                TestType = CELProject.Test_Mgr_UUT_Choice(0).Value.ToString()
                PropellerType = CELProject.Test_Mgr_UUT_Choice(1).Value.ToString()
                GRModelType = CELProject.Test_Mgr_UUT_Choice(2).Value.ToString()
                TorqueSensor = CELProject.Test_Mgr_UUT_Choice(3).Value.ToString()
                OperatorName = CELProject.Test_Mgr_UUT_Choice(4).Value.ToString()
                InspectorName = CELProject.Test_Mgr_UUT_Choice(5).Value.ToString()
                ReturnToIdleSource = CELProject.Test_Mgr_UUT_Choice(6).Value.ToString()
                SpeedSensor = CELProject.Test_Mgr_UUT_Choice(7).Value.ToString()

            End Sub

        End Class

    End Class
