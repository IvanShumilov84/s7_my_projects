        Private Sub OnENGINE_AT_REST(ByVal sender As IChannel, ByVal newVal As Value)
            Try

                If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                    Exit Sub 'Sort de cette fonction si l'archive est en playback
                End If

                If CELProject.IsFalse(newVal) Then

                    ARCHIVE_RECORD_BTN.Value = Values.True
                    T_EGT_CURRENT_DEGF.Value = T_EGT_DEGF.Value
                    CRANK_BTN_PRESSED.Value = Values.True

                Else
                    If CELProject.EngineModel = "TPE331-14GR" Or CELProject.EngineModel = "TPE331-14HR" Then
                        'TPE331-14
                        'Make sure lube de-Oil is deactivated at engine at rest
                        EEC_LUBE_DE_OIL_SOL_VALVE_BTN.Value = Values.False
                    End If

                    ARCHIVE_STOP_BTN.Value = Values.True
                    'Resetting the stop button when engine at rest goes from false to true as the button
                    'needs to be kept on as a flag to not active the starter logic to DAO's starter command box
                    'when speed is between 10 and 50 % : see STARTER_10PCT_STATUS_LOGIC
                    STOP_BTN.Value = Values.False
                    'Make sure it is reset
                    CRANK_BTN_PRESSED.Value = Values.False

                End If
            Catch ex As Exception
                MessageBox.Show("TPE331_Sequence: OnENGINE_AT_REST: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        '*******************************************
        '* OnEEC_AUTO_FEATHER_AIR_FRAME_IND    *
        '*******************************************
        'TPE331-14
        'EEC sends a Auto Feather Air Frame Signal : we activate the auto feather solenoid valve if the engine is not loaded and we stop the engine (
        Private Sub OnEEC_AUTO_FEATHER_AIR_FRAME_IND(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                Exit Sub 'Sort de cette fonction si l'archive est en playback
            End If

            Try
                If CELProject.IsTrue(newVal) Then
                    If EEC_CRANK_RUN_IND.Value = Values.True And READY_TO_START_IND.Value = Values.True Then
                        If TORQUE_LBSFT.Value.ToDouble < 200.0 Then
                            EEC_AUTO_FEATHER_BTN.Value = Values.True
                            EEC_FUEL_VALVE_OFF_BTN.Value = Values.True
                        Else
                            CELDAS.NotifyIcon.ShowBalloonTip(30000, CELProject.TechnologyName, "Auto Feather Air Frame signal received : Auto Feather Solenoid not activated as Torque > 200 lbs-ft", ToolTipIcon.Info)
                        End If

                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("TPE331_Sequence: OnEEC_AUTO_FEATHER_AIR_FRAME_IND: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        '*******************************************
        '* OnEEC_AUTO_IGNITION_IND    *
        '*******************************************
        'TPE331-14
        'EEC sends a signal when ignition is required
        Private Sub OnEEC_AUTO_IGNITION_IND(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                Exit Sub 'Sort de cette fonction si l'archive est en playback
            End If

            Try
                If CELProject.IsTrue(newVal) Then
                    If EEC_CRANK_RUN_IND.Value = Values.True And READY_TO_START_IND.Value = Values.True Then
                        IGNITER1_BTN.Value = Values.True
                    End If
                Else
                    IGNITER1_BTN.Value = Values.False
                End If
            Catch ex As Exception
                MessageBox.Show("TPE331_Sequence: OnEEC_AUTO_IGNITION_IND: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        '*******************************************
        '* OnEEC_OIL_TEMPERATURE_DECREASING_IND    *
        '*******************************************
        'TPE331-14
        'EEC sends a signal : validate if speed is between 0 to 60% : if yes, activate Scavenge de-Oil Solenoid Valve (FWD and AFT)
        Private Sub OnEEC_OIL_TEMPERATURE_DECREASING_IND(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                Exit Sub 'Sort de cette fonction si l'archive est en playback
            End If

            Try
                If CELProject.IsTrue(newVal) Then
                    If EEC_CRANK_RUN_IND.Value = Values.True And READY_TO_START_IND.Value = Values.True And EEC_SPEED_RELAY_10_60_LATCH_IND.Value = Values.True And EEC_SPEED_RELAY_0_60_LATCH_IND.Value = Values.False Then
                        EEC_SCAVENGE_DE_OIL_SOL_VALVE_AFT_BTN.Value = Values.True
                        EEC_SCAVENGE_DE_OIL_SOL_VALVE_FWD_BTN.Value = Values.True
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("TPE331_Sequence: OnEEC_OIL_TEMPERATURE_DECREASING_IND: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        '*******************************************
        '* OnEEC_SPEED_RELAY_TEMP_10_60_TEMP_IND    *
        '*******************************************
        'TPE331-14
        'Electrically the signal is closed between 10 to 60%
        Private Sub OnEEC_SPEED_RELAY_10_60_IND(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                Exit Sub 'Sort de cette fonction si l'archive est en playback
            End If

            Try
                If CELProject.IsTrue(newVal) Then
                    If EEC_CRANK_RUN_IND.Value = Values.True And READY_TO_START_IND.Value = Values.True Then
                        EEC_FUEL_VALVE_ON_BTN.Value = Values.True
                        EEC_MOTIVE_FLOW_BTN.Value = Values.True
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("TPE331_Sequence: OnEEC_SPEED_RELAY_TEMP_10_60_TEMP_IND: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        '*******************************************
        '* OnEEC_SPEED_RELAY_TEMP_0_60_IND    *
        '*******************************************
        'TPE331-14
        'Electrically the contact is open when the EEC is powered off and still stay open when the eec will be powered and when the speed will be from 0 to 60%. At 60%, the contact will close.
        Private Sub OnEEC_SPEED_RELAY_0_60_IND(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                Exit Sub 'Sort de cette fonction si l'archive est en playback
            End If

            Try
                If CELProject.IsTrue(newVal) Then
                    If EEC_CRANK_RUN_IND.Value = Values.True And READY_TO_START_IND.Value = Values.True Then
                        EEC_SCAVENGE_DE_OIL_SOL_VALVE_AFT_BTN.Value = Values.False
                        EEC_SCAVENGE_DE_OIL_SOL_VALVE_FWD_BTN.Value = Values.False
                        IGNITER1_BTN.Value = Values.False
                        EEC_MOTIVE_FLOW_BTN.Value = Values.False
                        CRANK_BTN_PRESSED.Value = Values.False
                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("TPE331_Sequence: OnEEC_SPEED_RELAY_TEMP_0_60_TEMP_IND: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

