        Protected Overrides Function CreateCustomHeaderLogFile(ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Select Case CELProject.Project.Number
                '* FOR Ethiopia project, customer required a dedicated space to sign the log report. 

                Case 14075
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Operator Signature:"
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                    RowIndex += 1
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Inspector Signature:"
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                    RowIndex += 2

            End Select

            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Date Time:"
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

            RowIndex += 1
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Cond#:"
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

            RowIndex += 1
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Comment:"
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            ExcelWorksheet.Rows(RowIndex).RowHeight = 65.25
            ExcelWorksheet.Rows(RowIndex).VerticalAlignment = Excel.XlVAlign.xlVAlignTop
            ExcelWorksheet.Rows(RowIndex).WrapText = True

            Return True
        End Function

        Protected Overrides Function UpdateCustomHeaderLogFile(ByVal AppendOption As Boolean, ByVal IsPerfEntry As Boolean, ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Dim RowSignatureIndex As Integer

            Select Case CELProject.Project.Number
                '* FOR Ethiopia project, customer required a dedicated space to sign the log report. It is an offset requiring 3 spaces. 

                Case 14075
                    RowSignatureIndex = 3

                Case Else
                    RowSignatureIndex = 0

            End Select

            Dim Log_Condition As Integer

            If AppendOption = False Then
                Log_Condition = 1
            Else
                'Log_Condition = (ExcelWorksheet.Cells(RowIndex + 1, 1).End(Excel.XlDirection.xlToRight).Column - 1)
                'TODO: Ici changement du au nouveau Microsoft.Office.Interop.Excel	                        'Log_Condition = (ExcelWorksheet.Cells(RowIndex + 1, 1).End(XlDirection.xlToRight).Column - 1)  'cette ligne en office 2010 retourne toujours 16384 -1 donc 16383 et le reste du code plante
                Log_Condition = ExcelWorksheet.Cells(RowIndex + 1 + RowSignatureIndex, ExcelWorksheet.Columns.Count).End(Excel.XlDirection.xlToLeft).Column - 1
                Log_Condition = Log_Condition + 1

            End If

            If ((Log_Condition > 1) And ((Log_Condition Mod 5) = 1)) Then

                'Repeat The Test Spec For this new sets of condition

                With ExcelWorksheet
                    .Range(.Cells(2 + RowSignatureIndex, 2), .Cells(RowIndex - 2 + RowSignatureIndex, 6)).Copy(.Cells(2, Log_Condition + 1))
                End With
            End If

            ColumnIndex = 1 + Log_Condition

            ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).Value = Format(Now, "yyyy/MM/dd HH:mm:ss")
            ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += 1
            ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).Value = Log_Condition.ToString()
            ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += 1
            If IsPerfEntry = False Then
                Dim CommentText As String = ""
                Dim InputObject As New InputCommentForm
                InputObject.ShowDialog("Log Report", "Comment:", "", CommentText)

                ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).Value = CommentText
            Else
                '						ExcelWorkSheet.Cells(RowIndex, ColumnIndex).Value				= "STEP: " & TEST_STEP_NB.Value.ToString() & " " & Now.ToString()
                ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).Value = "STEP: " & TestStep_List.SelectedItem & " " & Now.ToString()
            End If

            ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += (2 + RowSignatureIndex)
            ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).Value = "Values"
            ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).Font.Bold = True
            ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignCenter
        End Function

        Protected Overrides Sub Init_Engine_Channels_Value()

            FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())
            T_EGT_RETURN_TO_IDLE_LIMIT_DEGF.Value = New KineticaRT.Values.Double(CDbl(UserInputs.OverTempEGTRTI))
            T_EGT_START_LIMIT_DEGF.Value = New KineticaRT.Values.Double(CDbl(UserInputs.OverTempEGTStart))
            TORQUE_RETURN_TO_IDLE_LIMIT_LBSFT.Value = New KineticaRT.Values.Double(CDbl(UserInputs.OverTorqueRTI))

            If CELProject.EngineModel = "TPE331-14GR" Or CELProject.EngineModel = "TPE331-14HR" Then
                'TPE331-14
                T_RETURN_TO_IDLE_LIMIT_DEGF.Value = T_EGT_RETURN_TO_IDLE_LIMIT_DEGF.Value
            Else
                'Small Blocks
				
				T_ITT_RETURN_TO_IDLE_LIMIT_DEGF.Value = New KineticaRT.Values.Double(CDbl(UserInputs.OverTempITTRTI))
				T_ITT_START_LIMIT_DEGF.Value = New KineticaRT.Values.Double(CDbl(UserInputs.OverTempITTStart))
				
                If UserInputs.ReturnToIdleSource = "EGT" Then
                    T_RETURN_TO_IDLE_LIMIT_DEGF.Value = T_EGT_RETURN_TO_IDLE_LIMIT_DEGF.Value
                Else
                    T_RETURN_TO_IDLE_LIMIT_DEGF.Value = T_ITT_RETURN_TO_IDLE_LIMIT_DEGF.Value
                End If

            End If

        End Sub
        Protected Overrides Sub Init_Engine_Controls()
        End Sub

        Protected Overrides Sub OnEngineWorkingThread()

            StartTimerCtrl.Timer()
            AccelTimerCtrl.Timer()
            StopWatchTimerCtrl.Timer()
            OperatingTimerCtrl.Timer()
            AccelCheckTimerCtrl.Timer()
            FuelPurgeTimerCtrl.Timer()
            FuelValveOnTimerCtrl.Timer()
            FuelValveOffTimerCtrl.Timer()

            'Persistent Values Save Check
            PersistentValuesCtrl.SavePersistentValues(False)

        End Sub

        Private Sub OnACCEL_CHECK_OPEN_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value) Implements IAccelCheckScreen.OnACCEL_CHECK_OPEN_WINDOW_BTN
            Try
                If CELProject.IsTrue(newVal) Then
                    CELProject.ActivateForm("TPE331_Accel_Decel_Check_Screen", "TPE331_Master_Screen", True, False)
