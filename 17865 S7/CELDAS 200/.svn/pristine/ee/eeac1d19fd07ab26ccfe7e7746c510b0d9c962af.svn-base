                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("TPE331_Sequence: OnEEC_SPEED_RELAY_5_IND: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

