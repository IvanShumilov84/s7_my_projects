        '**********************************
        '* OnE_STOP_TRIP_ACTIVE       *
        '**********************************
        Private Sub OnE_STOP_TRIP_ACTIVE(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                Exit Sub 'Sort de cette fonction si l'archive est en playback
            End If

            Try
                If CELProject.IsTrue(newVal) Then
                    If EEC_FUEL_VALVE_OFF_BTN.Value = Values.False Then
                        EEC_FUEL_VALVE_OFF_BTN.Value = Values.True
                    End If

                    If Not CELProject.EngineModel = "TPE331-14GR" And Not CELProject.EngineModel = "TPE331-14HR" Then
                        EEC_FUEL_HEATER_BTN.Value = Values.False
                        EEC_OIL_VENT_VALVE_BTN.Value = Values.False
                        EEC_PRIMARY_ONLY_SOLENOID_VALVE_BTN.Value = Values.False
                    End If

                End If

            Catch ex As Exception
                MessageBox.Show("TPE331_Sequence: OnE_STOP_TRIP_ACTIVE: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        '**********************************
        '* OnFACILITY_FIRE_RETURN_TO_IDLE       *
        '**********************************
        'Facility Fire signal from building will be latched : as it generates a return to idle and that the return to idle signal will latch also, the return to idle command will be latched
        'This code is to have an internal facility fire variable that will trigger the return to idle and will be reset automatically
        'The logic that makes sure the return to idle in case of a fire is done only if we are above GI is done the expression of the channel associated

        Private Sub OnFACILITY_FIRE_RETURN_TO_IDLE(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                Exit Sub 'Sort de cette fonction si l'archive est en playback
            End If

            Try
                If CELProject.IsTrue(newVal) Then
                    FACILITY_FIRE_RETURN_TO_IDLE_IND.Value = Values.True
                End If

            Catch ex As Exception
                MessageBox.Show("TPE331_Sequence: OnFACILITY_FIRE_RETURN_TO_IDLE: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        '**********************************
        '* OnFACILITY_FIRE_RETURN_TO_IDLE_RESET       *
        '**********************************
        'As soon the indication as become TRUE, we reset to FALSE : we only need the pulse to generate a return to idle in case of a fire signal that is, at the source, latched

        Private Sub OnFACILITY_FIRE_RETURN_TO_IDLE_RESET(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                Exit Sub 'Sort de cette fonction si l'archive est en playback
            End If

            Try
                If CELProject.IsTrue(newVal) Then
                    FACILITY_FIRE_RETURN_TO_IDLE_IND.Value = Values.False
                End If

            Catch ex As Exception
                MessageBox.Show("TPE331_Sequence: OnFACILITY_FIRE_RETURN_TO_IDLE_RESET: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub


        '********************
        '* STOP BTN         *
        '********************
        Private Sub OnSTOP_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                Exit Sub 'Sort de cette fonction si l'archive est en playback
            End If

            Try
                If CELProject.IsTrue(newVal) Then

                    If Not CELProject.EngineModel = "TPE331-14GR" And Not CELProject.EngineModel = "TPE331-14HR" Then
                        'In case we havent reached 50/60% yet : default state for the following commands
                        EEC_FUEL_HEATER_BTN.Value = Values.False
                        EEC_OIL_VENT_VALVE_BTN.Value = Values.False
                        EEC_PRIMARY_ONLY_SOLENOID_VALVE_BTN.Value = Values.False
                    Else
                        If EEC_CRANK_RUN_IND.Value = Values.True And ENGINE_AT_REST.Value = Values.False Then
                            'Make sure lube de-Oil is activated when stopping the engine
                            EEC_LUBE_DE_OIL_SOL_VALVE_BTN.Value = Values.True
                        End If
                        'In case we havent reached 60% yet : default state for the following commands
                        EEC_MOTIVE_FLOW_BTN.Value = Values.False
                    End If

                    IGNITER1_BTN.Value = Values.False
                    EEC_FUEL_VALVE_ON_BTN.Value = Values.False
                    EEC_FUEL_VALVE_OFF_BTN.Value = Values.True

                    'FUEL PURGE must not be activated when FEATHERING is commanded : EEC FUEL PURGE INHIBIT is added in the HMI and is also required to be able to activate the FEATHERING
                    If EEC_PURGE_VALVE_INHIBIT_BTN.Value = Values.False Then
                        EEC_PURGE_VALVE_BTN.Value = Values.True
                    End If

                    'Make sure it is reset : used for timers.
                    CRANK_BTN_PRESSED.Value = Values.False
                End If

            Catch ex As Exception
                MessageBox.Show("TPE331_Sequence: OnSTOP_BTN: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        '********************
        '* STOP_FROM_DAO_CMD_IND        *
        '********************
        Private Sub OnSTOP_FROM_DAO_CMD_IND(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                Exit Sub 'Sort de cette fonction si l'archive est en playback
            End If

            Try
                If CELProject.IsTrue(newVal) Then
                    If HARNESS_ID_VALID_IND.Value = Values.True Then
                        STOP_BTN.Value = Values.True
                    End If
                Else
                    STOP_BTN.Value = Values.False
                End If
            Catch ex As Exception
                MessageBox.Show("TPE331_Sequence: OnSTOP_FROM_DAO_CMD_IND: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnLOG_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            If CELProject.IsTrue(newVal) Then

                'Update the Log/Perf channel set
                CELProject.LogPerfSynch.UpdateValues()
                FlowmeterCtrl.ComputeFlow(True)
                CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, False, CELProject.EngineModel, True)
                CELProject.LOG_TAKE_POINT_BTN.Value = Values.False
            End If
        End Sub

        Protected Overrides Sub OnNEW_TEST_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If (CELProject.IsTrue(newVal)) Then

                    If DialogResult.Yes = MessageBox.Show("Do you want to reset the fuel used?", "CELDAS200", MessageBoxButtons.YesNo, MessageBoxIcon.Question) Then

                        FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                        FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())

                    End If

                End If
            Catch ex As Exception
                MessageBox.Show("TPE331_Sequence: OnNewTest: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Private Sub OnNUMBER_OF_STARTS_CONDITION(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                If (CELProject.IsTrue(newVal)) Then

                    Try
                        NUMBER_OF_STARTS.Value = New KineticaRT.Values.Double(NUMBER_OF_STARTS.Value.ToDouble + 1)
                    Catch ex As System.Exception
                        MessageBox.Show("OnNUMBER_OF_STARTS_START_CONDITION: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    End Try

                End If

            End If

        End Sub

        '********************
        '* OnCloseTest()    *
        '********************
        Protected Overrides Sub OnCLOSE_TEST_BTN(sender As IChannel, newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    If CELProject.EngineFamily = "TPE331" Then

                        CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.OnCLOSE_TEST_BTN_DISPOSE))

                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("OnClose_Test: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        '************************
        '* OnCloseTestDispose() *
        '************************
        Private Sub OnCLOSE_TEST_BTN_DISPOSE()
            Try

                If CELProject.EngineFamily = "TPE331" Then

                    MyBase.StopWorkingThread()

                    'Persistent Values Force Save
                    If Not (PersistentValuesCtrl Is Nothing) Then
                        PersistentValuesCtrl.SavePersistentValues(True)
                    End If

                    RemoveHandlers()

                    Dispose_Engine_Controllers()

                End If

            Catch ex As Exception
                MessageBox.Show("OnClose_Test_Dispose: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionInitialized(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionInitialized(newStatus)

                If CELProject.EngineFamily = "TPE331" Then

                    UserInputs.MapUserInputsParameters(CELProject)

                    CELProject.EngineSession.WorkingFolder = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + UserInputs.EngineSerialNumber + "\" + UserInputs.WorkOrder
                    CELProject.CreateLogFile(AddressOf CreateCustomHeaderLogFile, CELProject.EngineModel, CELProject.EngineModel)

                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionInitialized: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)

            Catch ex As Exception

                MessageBox.Show("TPE331_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            End Try
        End Sub

        Protected Overrides Sub OnTestSessionRunning(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionRunning(newStatus)

                If CELProject.EngineFamily = "TPE331" Then

                    Init_Engine_Controls()

                    Init_Engine_Channels()

                    Init_Engine_Channels_Value()

                    Init_Engine_Controllers()

                    AddHandlers()

                    MyBase.StartWorkingThread()

                End If
            Catch ex As Exception
                MessageBox.Show("OnTestSessionRunning: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub
        Protected Overrides Sub AddHandlers()

            AddHandler CLOSE_TEST_BTN_OPC.ValueChanged, AddressOf OnCLOSE_TEST_BTN
            AddHandler ACCEL_DECEL_CHECK_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnACCEL_CHECK_CLOSE_WINDOW_BTN
            AddHandler ACCEL_DECEL_CHECK_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnACCEL_CHECK_OPEN_WINDOW_BTN
            AddHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            AddHandler E_STOP_TRIP_ACTIVE.ValueChanged, AddressOf OnE_STOP_TRIP_ACTIVE
            AddHandler EEC_SPEED_RELAY_5_LATCH_IND.ValueChanged, AddressOf OnEEC_SPEED_RELAY_5_IND
            AddHandler FACILITY_FIRE_IND.ValueChanged, AddressOf OnFACILITY_FIRE_RETURN_TO_IDLE
            AddHandler FACILITY_FIRE_TIME_MAX_VALUE_REACHED.ValueChanged, AddressOf OnFACILITY_FIRE_RETURN_TO_IDLE_RESET

            If CELProject.EngineModel = "TPE331-14GR" Or CELProject.EngineModel = "TPE331-14HR" Then
                AddHandler EEC_AUTO_FEATHER_AIR_FRAME_IND.ValueChanged, AddressOf OnEEC_AUTO_FEATHER_AIR_FRAME_IND
                AddHandler EEC_AUTO_IGNITION_IND.ValueChanged, AddressOf OnEEC_AUTO_IGNITION_IND
                AddHandler EEC_OIL_TEMPERATURE_DECREASING_IND.ValueChanged, AddressOf OnEEC_OIL_TEMPERATURE_DECREASING_IND
                AddHandler EEC_SPEED_RELAY_0_60_LATCH_IND.ValueChanged, AddressOf OnEEC_SPEED_RELAY_0_60_IND
                AddHandler EEC_SPEED_RELAY_10_60_LATCH_IND.ValueChanged, AddressOf OnEEC_SPEED_RELAY_10_60_IND
            Else
                AddHandler EEC_SPEED_RELAY_10_LATCH_IND.ValueChanged, AddressOf OnEEC_SPEED_RELAY_10_IND
                AddHandler EEC_SPEED_RELAY_50_LATCH_IND.ValueChanged, AddressOf OnEEC_SPEED_RELAY_50_IND
                AddHandler EEC_SPEED_RELAY_90_LATCH_IND.ValueChanged, AddressOf OnEEC_SPEED_RELAY_90_IND
            End If

            AddHandler ENGINE_AT_REST.ValueChanged, AddressOf OnENGINE_AT_REST
            AddHandler FACILITY_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnFCS_CLOSE_WINDOW_BTN
            AddHandler FACILITY_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnFCS_OPEN_WINDOW_BTN
            AddHandler NEW_TEST_BTN.ValueChanged, AddressOf OnNEW_TEST_BTN
            AddHandler NUMBER_OF_STARTS_CONDITION_LATCH.ValueChanged, AddressOf OnNUMBER_OF_STARTS_CONDITION
            AddHandler STOP_BTN.ValueChanged, AddressOf OnSTOP_BTN
            AddHandler STOP_FROM_DAO_CMD_IND.ValueChanged, AddressOf OnSTOP_FROM_DAO_CMD_IND

        End Sub
        Protected Overrides Sub RemoveHandlers()

            If Not (CLOSE_TEST_BTN_OPC Is Nothing) Then
                RemoveHandler CLOSE_TEST_BTN_OPC.ValueChanged, AddressOf OnCLOSE_TEST_BTN
            End If
            If Not (ACCEL_DECEL_CHECK_CLOSE_WINDOW_BTN Is Nothing) Then
                RemoveHandler ACCEL_DECEL_CHECK_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnACCEL_CHECK_CLOSE_WINDOW_BTN
            End If
            If Not (ACCEL_DECEL_CHECK_OPEN_WINDOW_BTN Is Nothing) Then
                RemoveHandler ACCEL_DECEL_CHECK_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnACCEL_CHECK_OPEN_WINDOW_BTN
            End If
            If Not (CELProject.LOG_TAKE_POINT_BTN Is Nothing) Then
                RemoveHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            End If
            If Not (E_STOP_TRIP_ACTIVE Is Nothing) Then
                RemoveHandler E_STOP_TRIP_ACTIVE.ValueChanged, AddressOf OnE_STOP_TRIP_ACTIVE
            End If
            If Not (FACILITY_FIRE_IND Is Nothing) Then
                RemoveHandler FACILITY_FIRE_IND.ValueChanged, AddressOf OnFACILITY_FIRE_RETURN_TO_IDLE
            End If
            If Not (FACILITY_FIRE_TIME_MAX_VALUE_REACHED Is Nothing) Then
                RemoveHandler FACILITY_FIRE_TIME_MAX_VALUE_REACHED.ValueChanged, AddressOf OnFACILITY_FIRE_RETURN_TO_IDLE_RESET
            End If
            If Not (EEC_AUTO_FEATHER_AIR_FRAME_IND Is Nothing) Then
                RemoveHandler EEC_AUTO_FEATHER_AIR_FRAME_IND.ValueChanged, AddressOf OnEEC_AUTO_FEATHER_AIR_FRAME_IND
            End If
            If Not (EEC_AUTO_IGNITION_IND Is Nothing) Then
                RemoveHandler EEC_AUTO_IGNITION_IND.ValueChanged, AddressOf OnEEC_AUTO_IGNITION_IND
            End If
            If Not (EEC_OIL_TEMPERATURE_DECREASING_IND Is Nothing) Then
                RemoveHandler EEC_OIL_TEMPERATURE_DECREASING_IND.ValueChanged, AddressOf OnEEC_OIL_TEMPERATURE_DECREASING_IND
            End If
            If Not (EEC_SPEED_RELAY_0_60_LATCH_IND Is Nothing) Then
                RemoveHandler EEC_SPEED_RELAY_0_60_LATCH_IND.ValueChanged, AddressOf OnEEC_SPEED_RELAY_0_60_IND
            End If
            If Not (EEC_SPEED_RELAY_10_60_LATCH_IND Is Nothing) Then
                RemoveHandler EEC_SPEED_RELAY_10_60_LATCH_IND.ValueChanged, AddressOf OnEEC_SPEED_RELAY_10_60_IND
            End If
            If Not (EEC_SPEED_RELAY_5_LATCH_IND Is Nothing) Then
                RemoveHandler EEC_SPEED_RELAY_5_LATCH_IND.ValueChanged, AddressOf OnEEC_SPEED_RELAY_5_IND
            End If
            If Not (EEC_SPEED_RELAY_10_LATCH_IND Is Nothing) Then
                RemoveHandler EEC_SPEED_RELAY_10_LATCH_IND.ValueChanged, AddressOf OnEEC_SPEED_RELAY_10_IND
            End If
            If Not (EEC_SPEED_RELAY_50_LATCH_IND Is Nothing) Then
                RemoveHandler EEC_SPEED_RELAY_50_LATCH_IND.ValueChanged, AddressOf OnEEC_SPEED_RELAY_50_IND
            End If
            If Not (EEC_SPEED_RELAY_90_LATCH_IND Is Nothing) Then
                RemoveHandler EEC_SPEED_RELAY_90_LATCH_IND.ValueChanged, AddressOf OnEEC_SPEED_RELAY_90_IND
            End If
            If Not (ENGINE_AT_REST Is Nothing) Then
                RemoveHandler ENGINE_AT_REST.ValueChanged, AddressOf OnENGINE_AT_REST
            End If
            If Not (FACILITY_CLOSE_WINDOW_BTN Is Nothing) Then
                RemoveHandler FACILITY_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnFCS_CLOSE_WINDOW_BTN
            End If
            If Not (FACILITY_OPEN_WINDOW_BTN Is Nothing) Then
                RemoveHandler FACILITY_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnFCS_OPEN_WINDOW_BTN
            End If
            If Not (NEW_TEST_BTN Is Nothing) Then
                RemoveHandler NEW_TEST_BTN.ValueChanged, AddressOf OnNEW_TEST_BTN
            End If
            If Not (NUMBER_OF_STARTS_CONDITION_LATCH Is Nothing) Then
                RemoveHandler NUMBER_OF_STARTS_CONDITION_LATCH.ValueChanged, AddressOf OnNUMBER_OF_STARTS_CONDITION
            End If
            If Not (STOP_BTN Is Nothing) Then
                RemoveHandler STOP_BTN.ValueChanged, AddressOf OnSTOP_BTN
            End If
            If Not (STOP_FROM_DAO_CMD_IND Is Nothing) Then
                RemoveHandler STOP_FROM_DAO_CMD_IND.ValueChanged, AddressOf OnSTOP_FROM_DAO_CMD_IND
            End If

        End Sub
        Protected Overrides Sub Init_Engine_Controllers()

            Dim PersistentValuesChannels() As String = {"OPERATING_TIME_SEC", "FUEL_USED_INITIAL_LITERS", "FUEL_USED_TOTAL_LITERS"}

            Dim PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputs.EngineSerialNumber & "\" & UserInputs.WorkOrder & "\Log\PersistentValues.xml"

            PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

            FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())

            FlowmeterCtrl = New FlowmeterController(Me)

            DeletableT2ChCtrl = New DeletableChannelController(Me, NumberOfT2Probe, 2, NumberOfT2Probe, "T_T2_", "_DEGF", "_DELETE_BTN", "T_T2_AVG_DEGF", "T_T2_MIN_DEGF", "T_T2_MAX_DEGF", "T_T2_SPREAD_DEGF")
            DeletableT3ChCtrl = New DeletableChannelController(Me, NumberOfT3Probe, 2, NumberOfT3Probe, "T_T3_", "_DEGF", "_DELETE_BTN", "T_T3_AVG_DEGF", "T_T3_MIN_DEGF", "T_T3_MAX_DEGF", "T_T3_SPREAD_DEGF")
            DeletableT5ChCtrl = New DeletableChannelController(Me, NumberOfT5Probe, 16, NumberOfT5Probe, "T_T5_", "_DEGF", "_DELETE_BTN", "T_T5_AVG_DEGF", "T_T5_MIN_DEGF", "T_T5_MAX_DEGF", "T_T5_SPREAD_DEGF")

            IgnitionMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "IGNITION_CURRENT_AMP", "IGNITION_CURRENT_AMP_MAX", "CRANK_BTN_PRESSED")
            IgnitionMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "IGNITION_VOLTAGE_VDC", "IGNITION_VOLTAGE_VDC_MAX", "CRANK_BTN_PRESSED")

            NPMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "NP_RPM", "NP_RPM_PEAK", "NP_RPM_PEAK_RESET")
            VibRGBMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_RGB_IPS", "VIB_RGB_IPS_PEAK", "VIB_RGB_IPS_PEAK_RESET")
            VibTurbineMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_TURBINE_IPS", "VIB_TURBINE_IPS_PEAK", "VIB_TURBINE_IPS_PEAK_RESET")
            EGTMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_EGT_DEGF", "T_EGT_DEGF_PEAK", "T_EGT_DEGF_PEAK_RESET")
            TorqueMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "TORQUE_LBSFT", "TORQUE_LBSFT_PEAK", "TORQUE_LBSFT_PEAK_RESET")

            If Not CELProject.EngineModel = "TPE331-14GR" And Not CELProject.EngineModel = "TPE331-14HR" Then
                TT4MaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_T4_DEGF", "T_T4_DEGF_PEAK", "T_T4_DEGF_PEAK_RESET")
            End If

            StartTimerCtrl = New TimerController(Me, "STARTING_TIME_START_CONDITION_LATCH", "STARTING_TIME_STOP_CONDITION_LATCH", "STARTING_TIME_CONDITION_RESET", "STARTING_TIME_SEC", Nothing, 0, "NONE")
            AccelTimerCtrl = New TimerController(Me, "ACCELERATING_TIME_START_CONDITION_LATCH", "ACCELERATING_TIME_STOP_CONDITION_LATCH", "ACCELERATING_TIME_CONDITION_RESET", "ACCELERATING_TIME_SEC", Nothing, 0, "NONE")
            OperatingTimerCtrl = New TimerController(Me, "OPERATING_TIME_START_CONDITION", "OPERATING_TIME_STOP_CONDITION", "OPERATING_TIME_CONDITION_RESET", "OPERATING_TIME_SEC", "OPERATING_TIME_HHMMSS", 0, "NONE", True)
            AccelCheckTimerCtrl = New TimerController(Me, "ACCEL_DECEL_CHECK_TIMER_START_CONDITION_LATCH", "ACCEL_DECEL_CHECK_TIMER_STOP_CONDITION_LATCH", "ACCEL_DECEL_CHECK_TIMER_RESET_CONDITION", "ACCEL_DECEL_TIME_SEC", Nothing, 0, "NONE")
            StopWatchTimerCtrl = New TimerController(Me, "STOPWATCH_START_CONDITION", "STOPWATCH_STOP_CONDITION", "STOPWATCH_RESET_CONDITION", "STOPWATCH_TIME_SEC", "STOPWATCH_TIME", 0, Nothing, False)

            FuelPurgeTimerCtrl = New TimerController(Me, "FUEL_PURGE_VALVE_START_CONDITION", "FUEL_PURGE_VALVE_STOP_CONDITION", "FUEL_PURGE_VALVE_RESET_CONDITION", "FUEL_PURGE_VALVE_TIME_SEC", Nothing, 10, "FUEL_PURGE_VALVE_MAX_VALUE_REACHED")
            FuelValveOffTimerCtrl = New TimerController(Me, "FUEL_VALVE_OFF_START_CONDITION", "FUEL_VALVE_OFF_STOP_CONDITION", "FUEL_VALVE_OFF_RESET_CONDITION", "FUEL_VALVE_OFF_TIME_SEC", Nothing, 10, "FUEL_VALVE_OFF_MAX_VALUE_REACHED")
            FuelValveOnTimerCtrl = New TimerController(Me, "FUEL_VALVE_ON_START_CONDITION", "FUEL_VALVE_ON_STOP_CONDITION", "FUEL_VALVE_ON_RESET_CONDITION", "FUEL_VALVE_ON_TIME_SEC", Nothing, 10, "FUEL_VALVE_ON_MAX_VALUE_REACHED")

        End Sub
        Protected Overrides Sub Dispose_Engine_Controllers()

            If Not (DeletableT2ChCtrl Is Nothing) Then
                DeletableT2ChCtrl.Dispose()
            End If

            If Not (DeletableT3ChCtrl Is Nothing) Then
                DeletableT3ChCtrl.Dispose()
            End If

            If Not (DeletableT5ChCtrl Is Nothing) Then
                DeletableT5ChCtrl.Dispose()
            End If

            If Not (IgnitionMaxCurrentRecordCtrl Is Nothing) Then
                IgnitionMaxCurrentRecordCtrl.Dispose()
            End If

            If Not (IgnitionMaxVoltageRecordCtrl Is Nothing) Then
                IgnitionMaxVoltageRecordCtrl.Dispose()
            End If

            If Not (NPMaxRecordCtrl Is Nothing) Then
                NPMaxRecordCtrl.Dispose()
            End If

            If Not (VibRGBMaxRecordCtrl Is Nothing) Then
                VibRGBMaxRecordCtrl.Dispose()
            End If

            If Not (VibTurbineMaxRecordCtrl Is Nothing) Then
                VibTurbineMaxRecordCtrl.Dispose()
            End If

            If Not (EGTMaxRecordCtrl Is Nothing) Then
                EGTMaxRecordCtrl.Dispose()
            End If

            If Not (TorqueMaxRecordCtrl Is Nothing) Then
                TorqueMaxRecordCtrl.Dispose()
            End If

            If Not (TT4MaxRecordCtrl Is Nothing) Then
                TT4MaxRecordCtrl.Dispose()
            End If

            If Not (StartTimerCtrl Is Nothing) Then
                StartTimerCtrl.Dispose()
            End If

            If Not (AccelTimerCtrl Is Nothing) Then
                AccelTimerCtrl.Dispose()
            End If

            If Not (AccelCheckTimerCtrl Is Nothing) Then
                AccelCheckTimerCtrl.Dispose()
            End If

            If Not (FuelPurgeTimerCtrl Is Nothing) Then
                FuelPurgeTimerCtrl.Dispose()
            End If

            If Not (StopWatchTimerCtrl Is Nothing) Then
                StopWatchTimerCtrl.Dispose()
            End If

            If Not (OperatingTimerCtrl Is Nothing) Then
                OperatingTimerCtrl.Dispose()
            End If

            If Not (PersistentValuesCtrl Is Nothing) Then
                PersistentValuesCtrl.Dispose()
            End If

            If Not (TransientControl Is Nothing) Then
                TransientControl.ClearPresets()
            End If

            FlowmeterCtrl.Dispose()

        End Sub

        Protected Overrides Sub OnTestSessionClosing(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionClosing(newStatus)
                'For All Engine

            Catch ex As Exception
                MessageBox.Show("OnTestSessionClosing: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Function Init_Engine_Channels() As Boolean
            Dim Return_Value As New ArrayList()

            Return_Value.Clear()

            Try

                Return_Value.Add(MyBase.InitializeChannel(ACCEL_DECEL_CHECK_CLOSE_WINDOW_BTN, "ACCEL_DECEL_CHECK_CLOSE_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(ACCEL_DECEL_CHECK_OPEN_WINDOW_BTN, "ACCEL_DECEL_CHECK_OPEN_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(ARCHIVE_RECORD_BTN, "ARCHIVE_RECORD_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(ARCHIVE_STOP_BTN, "ARCHIVE_STOP_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(CLOSE_TEST_BTN_OPC, "CLOSE_TEST_BTN_OPC"))
                Return_Value.Add(MyBase.InitializeChannel(CRANK_BTN_PRESSED, "CRANK_BTN_PRESSED"))
                Return_Value.Add(MyBase.InitializeChannel(ENGINE_AT_REST, "ENGINE_AT_REST"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_CRANK_RUN_IND, "EEC_CRANK_RUN_IND"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_FUEL_VALVE_ON_BTN, "EEC_FUEL_VALVE_ON_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_FUEL_VALVE_OFF_BTN, "EEC_FUEL_VALVE_OFF_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_SPEED_RELAY_5_LATCH_IND, "EEC_SPEED_RELAY_5_LATCH_IND"))
                Return_Value.Add(MyBase.InitializeChannel(E_STOP_TRIP_ACTIVE, "E_STOP_TRIP_ACTIVE"))
                Return_Value.Add(MyBase.InitializeChannel(FACILITY_FIRE_IND, "FACILITY_FIRE_IND"))
                Return_Value.Add(MyBase.InitializeChannel(FACILITY_FIRE_RETURN_TO_IDLE_IND, "FACILITY_FIRE_RETURN_TO_IDLE_IND"))
                Return_Value.Add(MyBase.InitializeChannel(FACILITY_FIRE_TIME_MAX_VALUE_REACHED, "FACILITY_FIRE_TIME_MAX_VALUE_REACHED"))

                If CELProject.EngineModel = "TPE331-14GR" Or CELProject.EngineModel = "TPE331-14HR" Then
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_FEATHER_AIR_FRAME_IND, "EEC_AUTO_FEATHER_AIR_FRAME_IND"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_FEATHER_BTN, "EEC_AUTO_FEATHER_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_IGNITION_IND, "EEC_AUTO_IGNITION_IND"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_LUBE_DE_OIL_SOL_VALVE_BTN, "EEC_LUBE_DE_OIL_SOL_VALVE_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_MOTIVE_FLOW_BTN, "EEC_MOTIVE_FLOW_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_OIL_TEMPERATURE_DECREASING_IND, "EEC_OIL_TEMPERATURE_DECREASING_IND"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_SCAVENGE_DE_OIL_SOL_VALVE_AFT_BTN, "EEC_SCAVENGE_DE_OIL_SOL_VALVE_AFT_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_SCAVENGE_DE_OIL_SOL_VALVE_FWD_BTN, "EEC_SCAVENGE_DE_OIL_SOL_VALVE_FWD_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_SPEED_RELAY_0_60_LATCH_IND, "EEC_SPEED_RELAY_0_60_LATCH_IND"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_SPEED_RELAY_10_60_LATCH_IND, "EEC_SPEED_RELAY_10_60_LATCH_IND"))
                    Return_Value.Add(MyBase.InitializeChannel(TORQUE_LBSFT, "TORQUE_LBSFT"))
                Else
                    Return_Value.Add(MyBase.InitializeChannel(EEC_FUEL_HEATER_BTN, "EEC_FUEL_HEATER_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_OIL_VENT_VALVE_BTN, "EEC_OIL_VENT_VALVE_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_PRIMARY_ONLY_SOLENOID_VALVE_BTN, "EEC_PRIMARY_ONLY_SOLENOID_VALVE_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_SPEED_RELAY_10_LATCH_IND, "EEC_SPEED_RELAY_10_LATCH_IND"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_SPEED_RELAY_50_LATCH_IND, "EEC_SPEED_RELAY_50_LATCH_IND"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_SPEED_RELAY_90_LATCH_IND, "EEC_SPEED_RELAY_90_LATCH_IND"))
					Return_Value.Add(MyBase.InitializeChannel(T_ITT_RETURN_TO_IDLE_LIMIT_DEGF, "T_ITT_RETURN_TO_IDLE_LIMIT_DEGF"))
					Return_Value.Add(MyBase.InitializeChannel(T_ITT_START_LIMIT_DEGF, "T_ITT_START_LIMIT_DEGF"))
                End If
                Return_Value.Add(MyBase.InitializeChannel(EEC_PURGE_VALVE_BTN, "EEC_PURGE_VALVE_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_PURGE_VALVE_INHIBIT_BTN, "EEC_PURGE_VALVE_INHIBIT_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(FACILITY_CLOSE_WINDOW_BTN, "FACILITY_CLOSE_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(FACILITY_OPEN_WINDOW_BTN, "FACILITY_OPEN_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(FUEL_USED_INITIAL_LITERS, "FUEL_USED_INITIAL_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(FUEL_USED_TOTAL_LITERS, "FUEL_USED_TOTAL_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(FM_INITIAL_VOLUME_LITERS, "FM_INITIAL_VOLUME_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(FM_TOTAL_VOLUME_LITERS, "FM_TOTAL_VOLUME_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(HARNESS_ID_VALID_IND, "HARNESS_ID_VALID_IND"))
                Return_Value.Add(MyBase.InitializeChannel(IGNITER1_BTN, "IGNITER1_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(NEW_TEST_BTN, "NEW_TEST_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(NUMBER_OF_STARTS, "NUMBER_OF_STARTS"))
                Return_Value.Add(MyBase.InitializeChannel(NUMBER_OF_STARTS_CONDITION_LATCH, "NUMBER_OF_STARTS_CONDITION_LATCH"))
                Return_Value.Add(MyBase.InitializeChannel(READY_TO_START_IND, "READY_TO_START_IND"))
                Return_Value.Add(MyBase.InitializeChannel(STOP_BTN, "STOP_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(STOP_FROM_DAO_CMD_IND, "STOP_FROM_DAO_CMD_IND"))
                Return_Value.Add(MyBase.InitializeChannel(T_EGT_DEGF, "T_EGT_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(T_EGT_CURRENT_DEGF, "T_EGT_CURRENT_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(T_EGT_RETURN_TO_IDLE_LIMIT_DEGF, "T_EGT_RETURN_TO_IDLE_LIMIT_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(T_EGT_START_LIMIT_DEGF, "T_EGT_START_LIMIT_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(T_RETURN_TO_IDLE_LIMIT_DEGF, "T_RETURN_TO_IDLE_LIMIT_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(TORQUE_RETURN_TO_IDLE_LIMIT_LBSFT, "TORQUE_RETURN_TO_IDLE_LIMIT_LBSFT"))

            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.Message)
                Return_Value.Add(False)
            Finally

            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function

