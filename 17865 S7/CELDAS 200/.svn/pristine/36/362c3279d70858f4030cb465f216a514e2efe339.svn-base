            End If
            If Not (CELProject.LOG_TAKE_POINT_BTN Is Nothing) Then
                RemoveHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            End If
            If Not (CRANK_START_DEMAND_OPC Is Nothing) Then
                RemoveHandler CRANK_START_DEMAND_OPC.ValueChanged, AddressOf OnCRANK_BTN
            End If
            If Not (DYNO_SET_INLET_PCT Is Nothing) Then
                RemoveHandler DYNO_SET_INLET_PCT.ValueChanged, AddressOf OnDYNO_INLET_VALIDATE
            End If
            If Not (DYNO_POS_DEMAND Is Nothing) Then
                RemoveHandler DYNO_POS_DEMAND.ValueChanged, AddressOf OnDYNO_DEMAND_VALIDATE
            End If
            If Not (DYNO_SPEED_DEMAND Is Nothing) Then
                RemoveHandler DYNO_SPEED_DEMAND.ValueChanged, AddressOf OnDYNO_DEMAND_VALIDATE
            End If
            If Not (DYNO_TORQUE_DEMAND Is Nothing) Then
                RemoveHandler DYNO_TORQUE_DEMAND.ValueChanged, AddressOf OnDYNO_DEMAND_VALIDATE
            End If
            If Not (CELProject.NEW_TEST_BTN Is Nothing) Then
                RemoveHandler CELProject.NEW_TEST_BTN.ValueChanged, AddressOf OnNEW_TEST_BTN
            End If
            If Not (ENGINE_AT_REST Is Nothing) Then
                RemoveHandler ENGINE_AT_REST.ValueChanged, AddressOf OnENGINE_AT_REST
            End If
            If Not (CLOSE_TEST_BTN_OPC Is Nothing) Then
                RemoveHandler CLOSE_TEST_BTN_OPC.ValueChanged, AddressOf OnCLOSE_TEST_BTN
            End If
            Dim i As Integer
            For i = 0 To (MaxNumberOfTorqueTrimPoints - 1)
                If Not (PERF_CAPTURE_TORQUE_BTN(i) Is Nothing) Then
                    RemoveHandler PERF_CAPTURE_TORQUE_BTN(i).ValueChanged, AddressOf OnPERF_CAPTURE_TORQUE_BTN
                End If
            Next
            If Not (PERF_CALCULATE_TORQUE_TRIM_BTN Is Nothing) Then
                RemoveHandler PERF_CALCULATE_TORQUE_TRIM_BTN.ValueChanged, AddressOf OnPERF_CALCULATE_TORQUE_TRIM_BTN
            End If
            If Not (PERF_CLEAR_TORQUE_BTN Is Nothing) Then
                RemoveHandler PERF_CLEAR_TORQUE_BTN.ValueChanged, AddressOf OnPERF_CLEAR_TORQUE_BTN
            End If
            If Not (PERF_CAPTURE_POST_MOMENT_APPLIED_BTN Is Nothing) Then
                RemoveHandler PERF_CAPTURE_POST_MOMENT_APPLIED_BTN.ValueChanged, AddressOf OnONE_P_MOMENT_TEST_CAPTURE_BTN
            End If
            If Not (PERF_CAPTURE_PRE_MOMENT_APPLIED_BTN Is Nothing) Then
                RemoveHandler PERF_CAPTURE_PRE_MOMENT_APPLIED_BTN.ValueChanged, AddressOf OnONE_P_MOMENT_TEST_CAPTURE_BTN
            End If
