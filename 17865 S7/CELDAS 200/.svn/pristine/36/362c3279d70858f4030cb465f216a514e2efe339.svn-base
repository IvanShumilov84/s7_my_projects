        Private Sub OnPERF_CAPTURE_TORQUE_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            Dim iPoint As Integer = Regex.Replace(sender.Name.ToString, "[^0-9]", String.Empty)

            If CELProject.IsTrue(newVal) Then

                If UserInputs.BedType = "1P Moment Rig" Then
                    PERF_TQCOMPEN(iPoint - 1).Value = New KineticaRT.Values.Double(
                        (PWC83020_DYNO_TORQUE_CORRECTION_GAIN.Value.ToDouble() * PMU_TQCOMPEN.Value.ToDouble()) + (PWC83020_DYNO_TORQUE_CORRECTION_BIAS.Value.ToDouble() / 14.9902))
                Else
                    PERF_TQCOMPEN(iPoint - 1).Value = PMU_TQCOMPEN.Value
                End If

                PERF_Q_ENG(iPoint - 1).Value = PMU_Q_ENGINE_LBSFT.Value
                sender.Value = Values.False
            End If

        End Sub

        Private Sub OnPERF_CLEAR_TORQUE_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            If CELProject.IsTrue(newVal) Then
                Dim confirmation As Integer = MessageBox.Show("Are you sure you want to clear the currently recorded values?",
                                                              "PT6A Torque Trim",
                                                              MessageBoxButtons.YesNo)
                If confirmation = DialogResult.Yes Then
                    For i As Integer = 0 To (MaxNumberOfTorqueTrimPoints - 1)
                        PERF_Q_ENG(i).Value = New KineticaRT.Values.Double(0.0)
                        PERF_TQCOMPEN(i).Value = New KineticaRT.Values.Double(0.0)
                    Next
                Else
                    sender.Value = Values.False
                    Exit Sub
                End If
                sender.Value = Values.False
            End If
        End Sub

        Private Sub OnPERF_CALCULATE_TORQUE_TRIM_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            Dim SumX, SumXSquared, SumY, SumXY As Double
            Dim Slope, Intercept, Determinant As Double

            Dim ValidTorqueTrimPoints As New List(Of Integer)

            If CELProject.IsTrue(newVal) Then

                'Get the number of valid points and their index
                For i As Integer = 0 To (MaxNumberOfTorqueTrimPoints - 1)
                    If Not (PERF_Q_ENG(i).Value.ToDouble() = 0 And PERF_TQCOMPEN(i).Value.ToDouble() = 0) Then
                        ValidTorqueTrimPoints.Add(i)
                    End If
                Next

                'Exit sub if no points were taken
                If ValidTorqueTrimPoints.Count <= 0 Then
                    sender.Value = Values.False
                    Exit Sub
                End If

                'Calculate the least sqaure curve (linear regression)
                For Each Pt As Integer In ValidTorqueTrimPoints
                    SumX += PERF_TQCOMPEN(Pt).Value.ToDouble()
                    SumXSquared += PERF_TQCOMPEN(Pt).Value.ToDouble() * PERF_TQCOMPEN(Pt).Value.ToDouble()
                    SumY += PERF_Q_ENG(Pt).Value.ToDouble()
                    SumXY += PERF_Q_ENG(Pt).Value.ToDouble() * PERF_TQCOMPEN(Pt).Value.ToDouble()
                Next

                Determinant = (ValidTorqueTrimPoints.Count * SumXSquared) - (SumX * SumX)
                Slope = ((ValidTorqueTrimPoints.Count * SumXY) - (SumY * SumX)) / Determinant
                Intercept = ((SumY * SumXSquared) - (SumX * SumXY)) / Determinant

                'Update Values
                If UserInputs.BedType = "1P Moment Rig" Then
                    'Gain and Bias are offset by a constant value when engine is on a 1P Moment Rig.
                    'This is because torque trim is done while applying a 5000 lbs-in pressure in the +Y direction
                    PERF_NEW_QTRMGN.Value = New KineticaRT.Values.Double((PMU_QTRMGN.Value.ToDouble() / Slope) - 0.00304)
                    PERF_NEW_QTRMBS.Value = New KineticaRT.Values.Double(((PERF_NEW_QTRMGN.Value.ToDouble() / PMU_QTRMGN.Value.ToDouble()) * (PMU_QTRMBS.Value.ToDouble() - Intercept)) - 3.17828)
                Else
                    'Base calculation of the torque trim Gain and Bias
                    PERF_NEW_QTRMGN.Value = New KineticaRT.Values.Double(PMU_QTRMGN.Value.ToDouble() / Slope)
                    PERF_NEW_QTRMBS.Value = New KineticaRT.Values.Double((PERF_NEW_QTRMGN.Value.ToDouble() / PMU_QTRMGN.Value.ToDouble()) * (PMU_QTRMBS.Value.ToDouble() - Intercept))
                End If


                sender.Value = Values.False
            End If
        End Sub

