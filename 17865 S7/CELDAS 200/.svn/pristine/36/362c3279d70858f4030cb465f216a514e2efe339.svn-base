            End If
            If Not (PERF_ENGAGE_PUMPLINE_TEST_BTN Is Nothing) Then
                RemoveHandler PERF_ENGAGE_PUMPLINE_TEST_BTN.ValueChanged, AddressOf OnPERF_ENGAGE_PUMPLINE_TEST_BTN
            End If
            If Not (FACILITY_CLOSE_WINDOW_BTN Is Nothing) Then
                RemoveHandler FACILITY_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnFCS_CLOSE_WINDOW_BTN
            End If
            If Not (FACILITY_OPEN_WINDOW_BTN Is Nothing) Then
                RemoveHandler FACILITY_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnFCS_OPEN_WINDOW_BTN
            End If
        End Sub


        Protected Overrides Sub Init_Engine_Controllers()

            FlowmeterCtrl = New FlowmeterController(Me)

            Dim PersistentValuesChannels() As String = {"OPERATING_TIME_SEC", "FUEL_USED_TOTAL_LITERS"}
            Dim PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputs.EngineSerialNumber & "\" & UserInputs.WorkOrder & "\Log\PersistentValues.xml"

            If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then
                If Double.IsNaN(FUEL_USED_TOTAL_LITERS.Value.ToDouble()) Then
                    FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                    FUEL_USED_TOTAL_LITERS.Value = Values.Zero
                    OPERATING_TIME_SEC.Value = Values.Zero
                Else
                    PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)
                    FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())
                End If

            End If



            ' Default value if not overridden by the project
            Dim RealNumberOfTEgtProbe As Integer = NumberOfEgtProbeAvailable
            Dim RealNumberOfTInletProbe As Integer = NumberOfTInletProbeAvailable


            Select Case CELProject.Project.Number

                Case 14086

                    Dim ConfigPrefix As String = "//ConfigurationSettings/" & CELProject.EngineFamily & "/" & CELProject.EngineModel & "/"
                    RealNumberOfTInletProbe = CELProject.Project.ReadOneIntegerConfigItem(ConfigPrefix & "T_T1_NUMBER_PROBE", 0)
                    RealNumberOfTEgtProbe = CELProject.Project.ReadOneIntegerConfigItem(ConfigPrefix & "T_T7_NUMBER_PROBE", 0)

                    Debug.Assert(RealNumberOfTInletProbe <> 0 And RealNumberOfTEgtProbe <> 0)

                    If CELProject.HierarchyType = CELDAS.eHierarchyType.Master Then
                        UnitronCtrl = New UnitronController(Me, "STARTER_RECTIFIER_BTN", "STARTER_RECTIFIER_STATUS_IND", "STARTER_RECTIFIER_OVERLOAD_IND", "CRANK_BTN", "STARTER_RECTIFIER_CONTACTOR_FEEDBACK_IND", "STARTER_VOLTAGE_SOURCE_OPC", "STARTER_CURRENT_SOURCE_OPC", Nothing, Nothing)
                    End If

                Case 17631
                    Dim ConfigPrefix As String = "//ConfigurationSettings/" & CELProject.EngineModel & "/"
                    RealNumberOfTInletProbe = CELProject.Project.ReadOneIntegerConfigItem(ConfigPrefix & "T_T1_NUMBER_PROBE", 0)
                    RealNumberOfTEgtProbe = CELProject.Project.ReadOneIntegerConfigItem(ConfigPrefix & "T_T7_NUMBER_PROBE", 0)

                    Debug.Assert(RealNumberOfTInletProbe <> 0 And RealNumberOfTEgtProbe <> 0)

                Case Else
                    Debug.Assert(False, "Init_Engine_Controllers: Code Missing for this project")

            End Select

            DeletableTInletChCtrl = New DeletableChannelController(Me, RealNumberOfTInletProbe, NumberTotalOfTInletProbes, RealNumberOfTInletProbe / 2, "T_T1_", "_DEGF", "_DELETE_BTN", "T_T1_AVG_DEGF", "T_T1_MIN_DEGF", "T_T1_MAX_DEGF", "T_T1_SPREAD_DEGF")
            DeletableTEgtChCtrl = New DeletableChannelController(Me, RealNumberOfTEgtProbe, NumberTotalOfEgtProbes, RealNumberOfTEgtProbe / 2, "T_T7_", "_DEGF", "_DELETE_BTN", "T_T7_AVG_DEGF", "T_T7_MIN_DEGF", "T_T7_MAX_DEGF", "T_T7_SPREAD_DEGF")

            IgnitionMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "IGNITION1_CURRENT_AMP", "IGNITION1_CURRENT_AMP_MAX", "CRANK_START_DEMAND_OPC")
            IgnitionMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "IGNITION1_VOLTAGE_VDC", "IGNITION1_VOLTAGE_VDC_MAX", "CRANK_START_DEMAND_OPC")
            StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_CURRENT_AMP", "STARTER_CURRENT_AMP_MAX", "CRANK_START_DEMAND_OPC")
            StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_VOLTAGE_VDC", "STARTER_VOLTAGE_VDC_MAX", "CRANK_START_DEMAND_OPC")
            MGTMaxTemperatureRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_T5_DEGF", "T_T5_MAX_DEGF", "T_T5_DEGF_PEAK_RESET")
            NGMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "NG_RPM", "NG_RPM_PEAK", "NG_RPM_PEAK_RESET")
            NFMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "NF_RPM", "NF_RPM_PEAK", "NF_RPM_PEAK_RESET")
            VibRGBMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_RGB_G", "VIB_RGB_G_PEAK", "VIB_RGB_G_PEAK_RESET")
            VibAGBMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_AGB_CMS", "VIB_AGB_CMS_PEAK", "VIB_AGB_CMS_PEAK_RESET")

            TimeToIdleTimerCtrl = New TimerController(Me, "TTI_TIME_START_CONDITION_LATCH", "TTI_TIME_STOP_CONDITION_LATCH", "TTI_TIME_CONDITION_RESET", "TTI_TIME_SEC", Nothing, 0, "NONE")
            TimeToLightTimerCtrl = New TimerController(Me, "TTL_TIME_START_CONDITION_LATCH", "TTL_TIME_STOP_CONDITION_LATCH", "TTL_TIME_CONDITION_RESET", "TTL_TIME_SEC", Nothing, 0, "NONE")
            CrankTimerCtrl = New TimerController(Me, "CRANK_TIME_START_CONDITION_LATCH", "CRANK_TIME_STOP_CONDITION_LATCH", "CRANK_TIME_CONDITION_RESET", "CRANK_TIME_SEC", Nothing, 45, "CRANK_TIME_MAX_VALUE_REACHED")
            StarterTimerCtrl = New TimerController(Me, "STARTER_OVERCURRENT_START_CONDITION", "STARTER_OVERCURRENT_STOP_CONDITION", "STARTER_OVERCURRENT_CONDITION_RESET", "STARTER_OVERCURRENT_TIME_SEC", Nothing, 10, "STARTER_OVERCURRENT_MAX_VALUE_REACHED")
            OperatingTimerCtrl = New TimerController(Me, "OPERATING_TIME_START_CONDITION", "OPERATING_TIME_STOP_CONDITION", "OPERATING_TIME_CONDITION_RESET", "OPERATING_TIME_SEC", Nothing, 0, "NONE", True)
            RundownTimerCtrl = New TimerController(Me, "RDT_TIME_START_CONDITION_LATCH", "RDT_TIME_STOP_CONDITION_LATCH", "RDT_TIME_CONDITION_RESET", "RDT_TIME_SEC", Nothing, 0, "NONE")

            If CELProject.HierarchyType = CELDAS.eHierarchyType.Master Then
                AccelCheckTimerCtrl = New TimerController(Me, "ACCEL_CHECK_TIMER_START_CONDITION_LATCH", "ACCEL_CHECK_TIMER_STOP_CONDITION_LATCH", "ACCEL_CHECK_TIMER_RESET_CONDITION", "ACCELERATION_TIME_SEC", Nothing, 0, "NONE")
            End If

        End Sub
        Protected Overrides Sub Dispose_Engine_Controllers()
            If Not (TransientControl Is Nothing) Then
                TransientControl.ClearPresets()
            End If

            'Persistent Values Force Save
            If Not (PersistentValuesCtrl Is Nothing) Then
                PersistentValuesCtrl.SavePersistentValues(True)
            End If

            If Not (DeletableTInletChCtrl Is Nothing) Then
                DeletableTInletChCtrl.Dispose()
            End If

            If Not (DeletableTEgtChCtrl Is Nothing) Then
                DeletableTEgtChCtrl.Dispose()
            End If

            If Not (UnitronCtrl Is Nothing) Then
                UnitronCtrl.Dispose()
            End If

            If Not (IgnitionMaxCurrentRecordCtrl Is Nothing) Then
                IgnitionMaxCurrentRecordCtrl.Dispose()
            End If

            If Not (IgnitionMaxVoltageRecordCtrl Is Nothing) Then
                IgnitionMaxVoltageRecordCtrl.Dispose()
            End If

            If Not (StarterMaxCurrentRecordCtrl Is Nothing) Then
                StarterMaxCurrentRecordCtrl.Dispose()
            End If

            If Not (StarterMaxVoltageRecordCtrl Is Nothing) Then
                StarterMaxVoltageRecordCtrl.Dispose()
            End If

            If Not (NGMaxRecordCtrl Is Nothing) Then
                NGMaxRecordCtrl.Dispose()
            End If

            If Not (NFMaxRecordCtrl Is Nothing) Then
                NFMaxRecordCtrl.Dispose()
            End If

            If Not (VibAGBMaxRecordCtrl Is Nothing) Then
                VibAGBMaxRecordCtrl.Dispose()
            End If

            If Not (VibRGBMaxRecordCtrl Is Nothing) Then
                VibRGBMaxRecordCtrl.Dispose()
            End If

            If Not (MGTMaxTemperatureRecordCtrl Is Nothing) Then
                MGTMaxTemperatureRecordCtrl.Dispose()
            End If

            If Not (TimeToIdleTimerCtrl Is Nothing) Then
                TimeToIdleTimerCtrl.Dispose()
            End If

            If Not (TimeToLightTimerCtrl Is Nothing) Then
                TimeToLightTimerCtrl.Dispose()
            End If

            If Not (CrankTimerCtrl Is Nothing) Then
                CrankTimerCtrl.Dispose()
            End If

            If Not (StarterTimerCtrl Is Nothing) Then
                StarterTimerCtrl.Dispose()
            End If

            If Not (RundownTimerCtrl Is Nothing) Then
                RundownTimerCtrl.Dispose()
            End If

            If Not (OperatingTimerCtrl Is Nothing) Then
                OperatingTimerCtrl.Dispose()
            End If

            If Not (AccelCheckTimerCtrl Is Nothing) Then
                AccelCheckTimerCtrl.Dispose()
            End If

            If Not (PersistentValuesCtrl Is Nothing) Then
                PersistentValuesCtrl.Dispose()
            End If

            If Not (FlowmeterCtrl Is Nothing) Then
                FlowmeterCtrl.Dispose()
            End If
        End Sub

        Private Sub OnELU_WINDOW_OPEN_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            Try
                If (CELProject.IsTrue(newVal)) Then

                    CELProject.ActivateForm("PT6A_ELU_Screen", CELProject.EngineModel + "_Screen", True, False)

                End If

                ELU_WINDOW_OPEN_BTN.Value = Values.False

            Catch Ex As Exception
                clsTopMostMessageBox.Show("CELDAS.OnELU_WINDOW_OPEN_BTN: " & Ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Private Sub OnELU_WINDOW_CLOSE_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            Try
                If (CELProject.IsTrue(newVal)) Then

                    CELProject.ActivateForm("PT6A_ELU_Screen", CELProject.EngineModel + "_Screen", False, False)

                End If

                ELU_WINDOW_CLOSE_BTN.Value = Values.False

            Catch Ex As Exception
                clsTopMostMessageBox.Show("CELDAS.OnELU_WINDOW_CLOSE_BTN: " & Ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub Init_Engine_Controls()
            MyBase.InitializeObject(TransientControl, "PT6A_Slave_Screen.fraGraphics.transientControl")
            '           Me.TransientControl.SetEngineModel(CELProject.EngineModel)
        End Sub

        Protected Overrides Sub OnCLOSE_TEST_BTN(sender As IChannel, newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    If CELProject.EngineFamily = "PT6A" Then
                        CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.OnCLOSE_TEST_BTN_DISPOSE))
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("OnCLOSE_TEST_BTN: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub OnCLOSE_TEST_BTN_DISPOSE()
            Try
                MyBase.StopWorkingThread()
                If Not (PersistentValuesCtrl Is Nothing) Then
                    PersistentValuesCtrl.SavePersistentValues(True)
                End If
                RemoveHandlers()
                Dispose_Engine_Controllers()
            Catch ex As Exception
                MessageBox.Show("OnCLOSE_TEST_BTN_DISPOSE: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionClosing(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionClosing(newStatus)
                'For All Engine

                If CELProject.EngineFamily = "PT6A" Then
                    MyBase.StopWorkingThread()
                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionClosing: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub


        Protected Overrides Function Init_Engine_Channels() As Boolean
            Dim Return_Value As New ArrayList()

            Return_Value.Clear()

            Try
                Return_Value.Add(MyBase.InitializeChannel(ACCEL_CHECK_CLOSE_WINDOW_BTN, "ACCEL_CHECK_CLOSE_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(ACCEL_CHECK_OPEN_WINDOW_BTN, "ACCEL_CHECK_OPEN_WINDOW_BTN"))
                If CELProject.EngineModel = "PT6A-62" Then
                    Return_Value.Add(MyBase.InitializeChannel(ELU_WINDOW_CLOSE_BTN, "ELU_WINDOW_CLOSE_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(ELU_WINDOW_OPEN_BTN, "ELU_WINDOW_OPEN_BTN"))
                End If
                Return_Value.Add(MyBase.InitializeChannel(ARCHIVE_RECORD_BTN, "ARCHIVE_RECORD_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(ARCHIVE_STOP_BTN, "ARCHIVE_STOP_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(ENGINE_AT_REST, "ENGINE_AT_REST"))
                Return_Value.Add(MyBase.InitializeChannel(CRANK_START_DEMAND_OPC, "CRANK_START_DEMAND_OPC"))
                Return_Value.Add(MyBase.InitializeChannel(CRANK_BTN_PRESSED, "CRANK_BTN_PRESSED"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_POS_DEMAND, "DYNO_POS_DEMAND"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_SPEED_DEMAND, "DYNO_SPEED_DEMAND"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_SPEED_100_PCT_RPM, "DYNO_SPEED_100_PCT_RPM"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_SPEED_MODE_BTN, "DYNO_SPEED_MODE_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_POWLAW_DEMAND, "DYNO_POWLAW_DEMAND"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_POWERLAW_DEFAULT_TDEMAND, "DYNO_POWERLAW_DEFAULT_TDEMAND"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_SET_INLET_PCT, "DYNO_SET_INLET_PCT"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_TORQUE_DEMAND, "DYNO_TORQUE_DEMAND"))
                Return_Value.Add(MyBase.InitializeChannel(FACILITY_CLOSE_WINDOW_BTN, "FACILITY_CLOSE_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(FACILITY_OPEN_WINDOW_BTN, "FACILITY_OPEN_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(FUEL_USED_INITIAL_LITERS, "FUEL_USED_INITIAL_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(FUEL_USED_TOTAL_LITERS, "FUEL_USED_TOTAL_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(OPERATING_TIME_SEC, "OPERATING_TIME_SEC"))
                Return_Value.Add(MyBase.InitializeChannel(T_T5_DEGF, "T_T5_DEGF")) 'Is called T4 on PT6A-6,6A and 6B but value is read on the same thermocouple
                Return_Value.Add(MyBase.InitializeChannel(T_T5_CURRENT_DEGF, "T_T5_CURRENT_DEGF")) 'Is called T4 on PT6A-6,6A and 6B but value is read on the same thermocouple
                'Return_Value.Add(MyBase.InitializeChannel(UPS_ON_BATTERY_MAX_TIME_REACHED, "UPS_ON_BATTERY_MAX_TIME_REACHED"))
                'Return_Value.Add(MyBase.InitializeChannel(CRANK_BTN, "CRANK_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(IGNITION_AUTO_MANUAL_BTN, "IGNITION_AUTO_MANUAL_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(IGNITION1_BTN, "IGNITION1_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(CLOSE_TEST_BTN_OPC, "CLOSE_TEST_BTN_OPC"))
                Return_Value.Add(MyBase.InitializeChannel(NG_RPM, "NG_RPM"))
                Return_Value.Add(MyBase.InitializeChannel(P_POP_PSIG, "P_POP_PSIG"))
                Return_Value.Add(MyBase.InitializeChannel(WF_TOT1, "WF_TOT1"))
                Return_Value.Add(MyBase.InitializeChannel(WF_TOT2, "WF_TOT2"))

                'PT6A-68/B/C
                If CELProject.EngineModel = "PT6A-62" Then
                    Return_Value.Add(MyBase.InitializeChannel(BOV_CLOSING_POINT_PANEL_OPEN_BTN, "BOV_CLOSING_POINT_PANEL_OPEN_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(BOV_CLOSING_POINT_PANEL_CLOSE_BTN, "BOV_CLOSING_POINT_PANEL_CLOSE_BTN"))
                End If

                'PT6A-68/B/C
                If CELProject.EngineModel = "PT6A-68" Or CELProject.EngineModel = "PT6A-68B" Or CELProject.EngineModel = "PT6A-68C" Then
                    Return_Value.Add(MyBase.InitializeChannel(PMU_CONTROL_PANEL_OPEN_BTN, "PMU_CONTROL_PANEL_OPEN_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(PMU_CONTROL_PANEL_CLOSE_BTN, "PMU_CONTROL_PANEL_CLOSE_BTN"))
                End If

                If CELProject.EngineModel = "PT6A-68" Then
                    Return_Value.Add(MyBase.InitializeChannel(ONE_P_MOMENT_RIG_CONTROL_PANEL_OPEN_BTN, "ONE_P_MOMENT_RIG_CONTROL_PANEL_OPEN_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(ONE_P_MOMENT_RIG_CONTROL_PANEL_CLOSE_BTN, "ONE_P_MOMENT_RIG_CONTROL_PANEL_CLOSE_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(TORQUE_TRIM_PANEL_OPEN_BTN, "TORQUE_TRIM_PANEL_OPEN_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(TORQUE_TRIM_PANEL_CLOSE_BTN, "TORQUE_TRIM_PANEL_CLOSE_BTN"))

                    If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then
                        Dim i As Integer
                        For i = 0 To (MaxNumberOfTorqueTrimPoints - 1)
                            Return_Value.Add(MyBase.InitializeChannel(PERF_Q_ENG(i), "PERF_Q_ENG_" + (i + 1).ToString("D2")))
                            Return_Value.Add(MyBase.InitializeChannel(PERF_TQCOMPEN(i), "PERF_TQCOMPEN_" + (i + 1).ToString("D2")))
                            Return_Value.Add(MyBase.InitializeChannel(PERF_CAPTURE_TORQUE_BTN(i), "PERF_CAPTURE_TORQUE_BTN_" + (i + 1).ToString("D2")))
                        Next
                        Return_Value.Add(MyBase.InitializeChannel(PERF_CLEAR_TORQUE_BTN, "PERF_CLEAR_TORQUE_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_NEW_QTRMGN, "PERF_NEW_QTRMGN"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_NEW_QTRMBS, "PERF_NEW_QTRMBS"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_CALCULATE_TORQUE_TRIM_BTN, "PERF_CALCULATE_TORQUE_TRIM_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(PMU_Q_ENGINE_LBSFT, "PMU_Q_ENGINE_LBSFT"))
                        Return_Value.Add(MyBase.InitializeChannel(PMU_TQCOMPEN, "PMU_TQCOMPEN"))
                        Return_Value.Add(MyBase.InitializeChannel(PMU_QTRMBS, "PMU_QTRMBS"))
                        Return_Value.Add(MyBase.InitializeChannel(PMU_QTRMGN, "PMU_QTRMGN"))
                    End If

                    If UserInputs.BedType = "1P Moment Rig" And CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then

                        'Initialize channels for the PT6A-68 One P Moment Correction
                        Return_Value.Add(MyBase.InitializeChannel(PWC83020_DYNO_TORQUE_CORRECTION_GAIN, "PWC83020_DYNO_TORQUE_CORRECTION_GAIN"))
                        Return_Value.Add(MyBase.InitializeChannel(PWC83020_DYNO_TORQUE_CORRECTION_BIAS, "PWC83020_DYNO_TORQUE_CORRECTION_BIAS"))

                        'Initialize channels for the PT6A-68 One P Moment Testing
                        Return_Value.Add(MyBase.InitializeChannel(PERF_CAPTURE_POST_MOMENT_APPLIED_BTN, "PERF_CAPTURE_POST_MOMENT_APPLIED_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_CAPTURE_PRE_MOMENT_APPLIED_BTN, "PERF_CAPTURE_PRE_MOMENT_APPLIED_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_MOMENT_MODE_NEGATIVE_BTN, "PERF_MOMENT_MODE_NEGATIVE_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_MOMENT_MODE_PITCH_BTN, "PERF_MOMENT_MODE_PITCH_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_MOMENT_MODE_POSITIVE_BTN, "PERF_MOMENT_MODE_POSITIVE_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_MOMENT_MODE_YAW_BTN, "PERF_MOMENT_MODE_YAW_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_250_SHP_PITCH_POS_MOP_PRE_MOMENT, "PERF_250_SHP_PITCH_POS_MOP_PRE_MOMENT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_250_SHP_PITCH_POS_MOP_POST_MOMENT, "PERF_250_SHP_PITCH_POS_MOP_POST_MOMENT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_250_SHP_PITCH_NEG_MOP_PRE_MOMENT, "PERF_250_SHP_PITCH_NEG_MOP_PRE_MOMENT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_250_SHP_PITCH_NEG_MOP_POST_MOMENT, "PERF_250_SHP_PITCH_NEG_MOP_POST_MOMENT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_250_SHP_YAW_POS_MOP_PRE_MOMENT, "PERF_250_SHP_YAW_POS_MOP_PRE_MOMENT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_250_SHP_YAW_POS_MOP_POST_MOMENT, "PERF_250_SHP_YAW_POS_MOP_POST_MOMENT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_250_SHP_YAW_NEG_MOP_PRE_MOMENT, "PERF_250_SHP_YAW_NEG_MOP_PRE_MOMENT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_250_SHP_YAW_NEG_MOP_POST_MOMENT, "PERF_250_SHP_YAW_NEG_MOP_POST_MOMENT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_1100_SHP_PITCH_POS_MOP_PRE_MOMENT, "PERF_1100_SHP_PITCH_POS_MOP_PRE_MOMENT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_1100_SHP_PITCH_POS_MOP_POST_MOMENT, "PERF_1100_SHP_PITCH_POS_MOP_POST_MOMENT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_1100_SHP_PITCH_NEG_MOP_PRE_MOMENT, "PERF_1100_SHP_PITCH_NEG_MOP_PRE_MOMENT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_1100_SHP_PITCH_NEG_MOP_POST_MOMENT, "PERF_1100_SHP_PITCH_NEG_MOP_POST_MOMENT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_1100_SHP_YAW_POS_MOP_PRE_MOMENT, "PERF_1100_SHP_YAW_POS_MOP_PRE_MOMENT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_1100_SHP_YAW_NEG_MOP_POST_MOMENT, "PERF_1100_SHP_YAW_NEG_MOP_POST_MOMENT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_1100_SHP_YAW_POS_MOP_POST_MOMENT, "PERF_1100_SHP_YAW_POS_MOP_POST_MOMENT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_1100_SHP_YAW_NEG_MOP_PRE_MOMENT, "PERF_1100_SHP_YAW_NEG_MOP_PRE_MOMENT"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_MEAN_MOP_PSIG, "PERF_MEAN_MOP_PSIG"))
                        Return_Value.Add(MyBase.InitializeChannel(ONE_P_MOMENT_TEST_OPEN_WINDOW_BTN, "ONE_P_MOMENT_TEST_OPEN_WINDOW_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(ONE_P_MOMENT_TEST_CLOSE_WINDOW_BTN, "ONE_P_MOMENT_TEST_CLOSE_WINDOW_BTN"))

                        'Initialize channels for the PT6A-68 Baseline Pumpline Test
                        Return_Value.Add(MyBase.InitializeChannel(PERF_MOP2C150_PUMPLINE_TEST, "PERF_MOP2C150_PUMPLINE_TEST"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_POP_PUMPLINE_TEST, "PERF_POP_PUMPLINE_TEST"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_NP_DC_PUMPLINE_TEST, "PERF_NP_DC_PUMPLINE_TEST"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_NG_DC_PUMPLINE_TEST, "PERF_NG_DC_PUMPLINE_TEST"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_ENGAGE_PUMPLINE_TEST_BTN, "PERF_ENGAGE_PUMPLINE_TEST_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(NP_RPM, "NP_RPM"))
                        Return_Value.Add(MyBase.InitializeChannel(P_MOP2C150_PSIG, "P_MOP2C150_PSIG"))
                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.Message)
                Return_Value.Add(False)
            Finally

            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function

