        Private Sub OnONE_P_MOMENT_TEST_CAPTURE_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            Dim PowerMode As Integer
            Const LoPowerMode = 1
            Const HiPowerMode = 2

            Dim MomentMode As Integer
            Const Pitch = 3
            Const Yaw = 4

            Dim MomentDirection As Integer
            Const Positive = 5
            Const Negative = 6

            If CELProject.IsTrue(newVal) Then

                If DYNO_SPEED_DEMAND.Value.ToDouble() > 1500 And DYNO_SPEED_DEMAND.Value.ToDouble() < 1660 Then
                    PowerMode = LoPowerMode
                ElseIf DYNO_SPEED_DEMAND.Value.ToDouble() > 1900 And DYNO_SPEED_DEMAND.Value.ToDouble() < 2000 Then
                    PowerMode = HiPowerMode
                End If

                If CELProject.IsTrue(PERF_MOMENT_MODE_PITCH_BTN.Value) Then
                    MomentMode = Pitch
                ElseIf CELProject.IsTrue(PERF_MOMENT_MODE_YAW_BTN.Value) Then
                    MomentMode = Yaw
                End If

                If CELProject.IsTrue(PERF_MOMENT_MODE_POSITIVE_BTN.Value) Then
                    MomentDirection = Positive
                ElseIf CELProject.IsTrue(PERF_MOMENT_MODE_NEGATIVE_BTN.Value) Then
                    MomentDirection = Negative
                End If

                Select Case sender.Name

                    Case "PERF_CAPTURE_PRE_MOMENT_APPLIED_BTN"
                        Select Case PowerMode
                            Case LoPowerMode
                                Select Case MomentMode
                                    Case Pitch
                                        Select Case MomentDirection
                                            Case Positive
                                                PERF_250_SHP_PITCH_POS_MOP_PRE_MOMENT.Value = New KineticaRT.Values.Double(PERF_MEAN_MOP_PSIG.Value.ToDouble())
                                            Case Negative
                                                PERF_250_SHP_PITCH_NEG_MOP_PRE_MOMENT.Value = New KineticaRT.Values.Double(PERF_MEAN_MOP_PSIG.Value.ToDouble())
                                        End Select
                                    Case Yaw
                                        Select Case MomentDirection
                                            Case Positive
                                                PERF_250_SHP_YAW_POS_MOP_PRE_MOMENT.Value = New KineticaRT.Values.Double(PERF_MEAN_MOP_PSIG.Value.ToDouble())
                                            Case Negative
                                                PERF_250_SHP_YAW_NEG_MOP_PRE_MOMENT.Value = New KineticaRT.Values.Double(PERF_MEAN_MOP_PSIG.Value.ToDouble())
                                        End Select
                                End Select
                            Case HiPowerMode
                                Select Case MomentMode
                                    Case Pitch
                                        Select Case MomentDirection
                                            Case Positive
                                                PERF_1100_SHP_PITCH_POS_MOP_PRE_MOMENT.Value = New KineticaRT.Values.Double(PERF_MEAN_MOP_PSIG.Value.ToDouble())
                                            Case Negative
                                                PERF_1100_SHP_PITCH_NEG_MOP_PRE_MOMENT.Value = New KineticaRT.Values.Double(PERF_MEAN_MOP_PSIG.Value.ToDouble())
                                        End Select
                                    Case Yaw
                                        Select Case MomentDirection
                                            Case Positive
                                                PERF_1100_SHP_YAW_POS_MOP_PRE_MOMENT.Value = New KineticaRT.Values.Double(PERF_MEAN_MOP_PSIG.Value.ToDouble())
                                            Case Negative
                                                PERF_1100_SHP_YAW_NEG_MOP_PRE_MOMENT.Value = New KineticaRT.Values.Double(PERF_MEAN_MOP_PSIG.Value.ToDouble())
                                        End Select
                                End Select
                        End Select

                    Case "PERF_CAPTURE_POST_MOMENT_APPLIED_BTN"
                        Select Case PowerMode
                            Case LoPowerMode
                                Select Case MomentMode
                                    Case Pitch
                                        Select Case MomentDirection
                                            Case Positive
                                                PERF_250_SHP_PITCH_POS_MOP_POST_MOMENT.Value = New KineticaRT.Values.Double(PERF_MEAN_MOP_PSIG.Value.ToDouble())
                                            Case Negative
                                                PERF_250_SHP_PITCH_NEG_MOP_POST_MOMENT.Value = New KineticaRT.Values.Double(PERF_MEAN_MOP_PSIG.Value.ToDouble())
                                        End Select
                                    Case Yaw
                                        Select Case MomentDirection
                                            Case Positive
                                                PERF_250_SHP_YAW_POS_MOP_POST_MOMENT.Value = New KineticaRT.Values.Double(PERF_MEAN_MOP_PSIG.Value.ToDouble())
                                            Case Negative
                                                PERF_250_SHP_YAW_NEG_MOP_POST_MOMENT.Value = New KineticaRT.Values.Double(PERF_MEAN_MOP_PSIG.Value.ToDouble())
                                        End Select
                                End Select
                            Case HiPowerMode
                                Select Case MomentMode
                                    Case Pitch
                                        Select Case MomentDirection
                                            Case Positive
                                                PERF_1100_SHP_PITCH_POS_MOP_POST_MOMENT.Value = New KineticaRT.Values.Double(PERF_MEAN_MOP_PSIG.Value.ToDouble())
                                            Case Negative
                                                PERF_1100_SHP_PITCH_NEG_MOP_POST_MOMENT.Value = New KineticaRT.Values.Double(PERF_MEAN_MOP_PSIG.Value.ToDouble())
                                        End Select
                                    Case Yaw
                                        Select Case MomentDirection
                                            Case Positive
                                                PERF_1100_SHP_YAW_POS_MOP_POST_MOMENT.Value = New KineticaRT.Values.Double(PERF_MEAN_MOP_PSIG.Value.ToDouble())
                                            Case Negative
                                                PERF_1100_SHP_YAW_NEG_MOP_POST_MOMENT.Value = New KineticaRT.Values.Double(PERF_MEAN_MOP_PSIG.Value.ToDouble())
                                        End Select
                                End Select
                        End Select
                End Select

                sender.Value = Values.False
            End If
        End Sub

        Private Sub OnPERF_ENGAGE_PUMPLINE_TEST_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                    Exit Sub 'Sort de cette fonction si l'archive est en playback
                End If

                If CELProject.IsTrue(newVal) Then
                    PumplineTest_Thread = New Thread(AddressOf PumplineTest_Worker)
                    PumplineTest_Thread.Priority = ThreadPriority.Normal
                    PumplineTest_Thread.Name = "PumplineTest_Worker"
                    PumplineTest_Thread.Start()
                End If
            Catch ex As Exception
                MessageBox.Show("OnEngagePumplineTest: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub PumplineTest_Worker()
            Try
                Dim dataMOP2C150 As Double()
                Dim dataNGDC As Double()
                Dim dataNPDC As Double()
                Dim dataPOP As Double()

                Dim curve(2) As Double
                Dim slope As Double
                Dim offset As Double

                Dim i As Integer = 0

                While (CELProject.IsTrue(PERF_ENGAGE_PUMPLINE_TEST_BTN.Value))
                    If NG_RPM.Value.ToDouble() < 12000 AndAlso NG_RPM.Value.ToDouble() > 8000 Then
                        ReDim Preserve dataMOP2C150(i + 1)
                        ReDim Preserve dataNGDC(i + 1)
                        ReDim Preserve dataNPDC(i + 1)
                        ReDim Preserve dataPOP(i + 1)
                        dataMOP2C150(i) = P_MOP2C150_PSIG.Value.ToDouble()
                        dataNGDC(i) = NG_RPM.Value.ToDouble()
                        dataNPDC(i) = NP_RPM.Value.ToDouble()
                        dataPOP(i) = P_POP_PSIG.Value.ToDouble()
                        i = i + 1
                    ElseIf NG_RPM.Value.ToDouble() < 8000 Then
                        PERF_ENGAGE_PUMPLINE_TEST_BTN.Value = Values.False
                        Exit While
                    End If
                    Thread.Sleep(100)
                End While

                If i > 2 Then
                    curve = CELProject.LeastSquaresLine(dataNGDC, dataMOP2C150)
                    slope = curve(0)
                    offset = curve(1)
                    PERF_MOP2C150_PUMPLINE_TEST.Value = New KineticaRT.Values.Double(slope * 10000 + offset)

                    curve = CELProject.LeastSquaresLine(dataNGDC, dataPOP)
                    slope = curve(0)
                    offset = curve(1)
                    PERF_POP_PUMPLINE_TEST.Value = New KineticaRT.Values.Double(slope * 10000 + offset)

                    curve = CELProject.LeastSquaresLine(dataNGDC, dataNPDC)
                    slope = curve(0)
                    offset = curve(1)
                    PERF_NP_DC_PUMPLINE_TEST.Value = New KineticaRT.Values.Double(slope * 10000 + offset)

                    PERF_NG_DC_PUMPLINE_TEST.Value = New KineticaRT.Values.Double(10000)
                End If
            Catch ex As Exception
                MessageBox.Show("OnEngagePumplineTest: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub
#End Region

        Protected Overrides Sub OnDYNO_DEMAND_VALIDATE(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If sender.Name = "DYNO_POS_DEMAND" Then
                    If DYNO_POS_DEMAND.Value.ToDouble() > 100 Then
                        DYNO_POS_DEMAND.Value = New KineticaRT.Values.Double(100)
                    ElseIf DYNO_POS_DEMAND.Value.ToDouble() < 0 Then
                        DYNO_POS_DEMAND.Value = Values.Zero
                    End If
                ElseIf sender.Name = "DYNO_SPEED_DEMAND" Then
                    If DYNO_SPEED_DEMAND.Value.ToDouble() > 2250 Then
                        DYNO_SPEED_DEMAND.Value = New KineticaRT.Values.Double(2250)
                    ElseIf DYNO_SPEED_DEMAND.Value.ToDouble() < 0 Then
                        DYNO_SPEED_DEMAND.Value = Values.Zero
                    End If
                ElseIf sender.Name = "DYNO_TORQUE_DEMAND" Then
                    If DYNO_TORQUE_DEMAND.Value.ToDouble() > 26113 Then
                        DYNO_TORQUE_DEMAND.Value = New KineticaRT.Values.Double(26113)
                    ElseIf DYNO_TORQUE_DEMAND.Value.ToDouble() < 0 Then
                        DYNO_TORQUE_DEMAND.Value = Values.Zero
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("PT6A_Sequence: OnDYNO_DEMAND_VALIDATE: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnDYNO_INLET_VALIDATE(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If DYNO_SET_INLET_PCT.Value.ToDouble() > 100 Then
                    DYNO_SET_INLET_PCT.Value = New KineticaRT.Values.Double(100)
                ElseIf DYNO_SET_INLET_PCT.Value.ToDouble() < 0 Then
                    DYNO_SET_INLET_PCT.Value = Values.Zero
                End If
            Catch ex As Exception
                MessageBox.Show("PT6A_Sequence: OnDYNO_INLET_VALIDATE: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Private Sub OnCRANK_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    ARCHIVE_RECORD_BTN.Value = Values.True
                    T_T5_CURRENT_DEGF.Value = T_T5_DEGF.Value
                    CRANK_BTN_PRESSED.Value = Values.True
                Else
                    CRANK_BTN_PRESSED.Value = Values.False
                End If
            Catch ex As Exception
                MessageBox.Show("PT6A_Sequence: OnSTOP_TIMER_CND_BUTTON: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Private Sub OnENGINE_AT_REST(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    'Automatically stop the archive when engine at rest becomes true.
                    'Crank_btn_pressed condition is to check if the engine is starting or stopping.
                    If ARCHIVE_RECORD_BTN.Value = Values.True And CRANK_BTN_PRESSED.Value = Values.False Then
                        ARCHIVE_STOP_BTN.Value = Values.True
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("PW100_Sequence: OnENGINE_AT_REST: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnLOG_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            If CELProject.IsTrue(newVal) Then

                'Update the Log/Perf channel set
                CELProject.LogPerfSynch.UpdateValues()
                FlowmeterCtrl.ComputeFlow(True)
                CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, False, CELProject.EngineModel, True)
                CELProject.LOG_TAKE_POINT_BTN.Value = Values.False
            End If
        End Sub

        Protected Overrides Sub OnNEW_TEST_BTN(sender As IChannel, newVal As Value)
            Try
                If (CELProject.IsTrue(newVal)) Then

                    If DialogResult.Yes = MessageBox.Show("Do you want to reset the fuel used and the operating time?", "CELDAS200", MessageBoxButtons.YesNo, MessageBoxIcon.Question) Then

                        FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                        WF_TOT1.Value = Values.Zero
                        WF_TOT2.Value = Values.Zero
                    End If

                End If
            Catch ex As Exception
                MessageBox.Show("PT6A_Sequence: OnNewTest: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionInitialized(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionInitialized(newStatus)

                If CELProject.EngineFamily = "PT6A" Then

                    UserInputs.MapUserInputsParameters(CELProject)

                    CELProject.EngineSession.WorkingFolder = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + UserInputs.EngineSerialNumber + "\" + UserInputs.WorkOrder
                    CELProject.CreateLogFile(AddressOf CreateCustomHeaderLogFile, CELProject.EngineModel, CELProject.EngineModel)

                End If

            Catch ex As Exception
                MessageBox.Show("PT6A_Sequence.OnTestSessionInitialized: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)

            Catch ex As Exception

                MessageBox.Show("PT6A_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            End Try
        End Sub

        Protected Overrides Sub OnTestSessionRunning(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionRunning(newStatus)

                If CELProject.EngineFamily = "PT6A" Then

                    Init_Engine_Controls()
                    Init_Engine_Channels()
                    Init_Engine_Channels_Value()
                    Init_Engine_Controllers()

                    AddHandlers()


                    MyBase.StartWorkingThread()

                End If
            Catch ex As Exception
                MessageBox.Show("OnTestSessionRunning: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub
        Protected Overrides Sub AddHandlers()
            AddHandler ACCEL_CHECK_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnACCEL_CHECK_CLOSE_WINDOW_BTN
            AddHandler ACCEL_CHECK_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnACCEL_CHECK_OPEN_WINDOW_BTN

            If CELProject.EngineModel = "PT6A-62" Then
                AddHandler ELU_WINDOW_CLOSE_BTN.ValueChanged, AddressOf OnELU_WINDOW_CLOSE_BTN
                AddHandler ELU_WINDOW_OPEN_BTN.ValueChanged, AddressOf OnELU_WINDOW_OPEN_BTN
                AddHandler BOV_CLOSING_POINT_PANEL_OPEN_BTN.ValueChanged, AddressOf OnBOV_CLOSING_POINT_PANEL_OPEN_BTN
                AddHandler BOV_CLOSING_POINT_PANEL_CLOSE_BTN.ValueChanged, AddressOf OnBOV_CLOSING_POINT_PANEL_CLOSE_BTN
            End If

            If CELProject.EngineModel = "PT6A-68" Or CELProject.EngineModel = "PT6A-68B" Or CELProject.EngineModel = "PT6A-68C" Then
                AddHandler PMU_CONTROL_PANEL_OPEN_BTN.ValueChanged, AddressOf OnPMU_CONTROL_PANEL_OPEN_BTN
                AddHandler PMU_CONTROL_PANEL_CLOSE_BTN.ValueChanged, AddressOf OnPMU_CONTROL_PANEL_CLOSE_BTN
            End If

            If CELProject.EngineModel = "PT6A-68" Then
                AddHandler TORQUE_TRIM_PANEL_OPEN_BTN.ValueChanged, AddressOf OnTORQUE_TRIM_PANEL_OPEN_BTN
                AddHandler TORQUE_TRIM_PANEL_CLOSE_BTN.ValueChanged, AddressOf OnTORQUE_TRIM_PANEL_CLOSE_BTN
                If UserInputs.BedType = "1P Moment Rig" Then
                    AddHandler ONE_P_MOMENT_RIG_CONTROL_PANEL_OPEN_BTN.ValueChanged, AddressOf OnONE_P_MOMENT_RIG_CONTROL_PANEL_OPEN_BTN
                    AddHandler ONE_P_MOMENT_RIG_CONTROL_PANEL_CLOSE_BTN.ValueChanged, AddressOf OnONE_P_MOMENT_RIG_CONTROL_PANEL_CLOSE_BTN
                End If
            End If

            AddHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            AddHandler CRANK_START_DEMAND_OPC.ValueChanged, AddressOf OnCRANK_BTN
            AddHandler DYNO_SET_INLET_PCT.ValueChanged, AddressOf OnDYNO_INLET_VALIDATE
            AddHandler DYNO_POS_DEMAND.ValueChanged, AddressOf OnDYNO_DEMAND_VALIDATE
            AddHandler DYNO_SPEED_DEMAND.ValueChanged, AddressOf OnDYNO_DEMAND_VALIDATE
            AddHandler DYNO_TORQUE_DEMAND.ValueChanged, AddressOf OnDYNO_DEMAND_VALIDATE
            AddHandler CELProject.NEW_TEST_BTN.ValueChanged, AddressOf OnNEW_TEST_BTN
            AddHandler ENGINE_AT_REST.ValueChanged, AddressOf OnENGINE_AT_REST
            AddHandler CLOSE_TEST_BTN_OPC.ValueChanged, AddressOf OnCLOSE_TEST_BTN
            AddHandler FACILITY_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnFCS_CLOSE_WINDOW_BTN
            AddHandler FACILITY_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnFCS_OPEN_WINDOW_BTN

            'PT6A-68 Torque Trim
            If (CELProject.EngineModel = "PT6A-68") And CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then
                Dim i As Integer
                For i = 0 To (MaxNumberOfTorqueTrimPoints - 1)
                    AddHandler PERF_CAPTURE_TORQUE_BTN(i).ValueChanged, AddressOf OnPERF_CAPTURE_TORQUE_BTN
                Next
                AddHandler PERF_CALCULATE_TORQUE_TRIM_BTN.ValueChanged, AddressOf OnPERF_CALCULATE_TORQUE_TRIM_BTN
                AddHandler PERF_CLEAR_TORQUE_BTN.ValueChanged, AddressOf OnPERF_CLEAR_TORQUE_BTN

                If UserInputs.BedType = "1P Moment Rig" Then
                    AddHandler PERF_CAPTURE_POST_MOMENT_APPLIED_BTN.ValueChanged, AddressOf OnONE_P_MOMENT_TEST_CAPTURE_BTN
                    AddHandler PERF_CAPTURE_PRE_MOMENT_APPLIED_BTN.ValueChanged, AddressOf OnONE_P_MOMENT_TEST_CAPTURE_BTN
                    AddHandler ONE_P_MOMENT_TEST_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnONE_P_MOMENT_TEST_OPEN_WINDOW_BTN
                    AddHandler ONE_P_MOMENT_TEST_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnONE_P_MOMENT_TEST_CLOSE_WINDOW_BTN
                    AddHandler PERF_ENGAGE_PUMPLINE_TEST_BTN.ValueChanged, AddressOf OnPERF_ENGAGE_PUMPLINE_TEST_BTN
                End If
            End If
        End Sub
