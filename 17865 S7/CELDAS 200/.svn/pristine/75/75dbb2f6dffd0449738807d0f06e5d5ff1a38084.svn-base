                        Return_Value.Add(MyBase.InitializeObject(frmMasterEngineWindow, "GTCP331_350_Screen"))

                        frmMasterEngineWindow.WindowState = FormWindowState.Normal
                        frmMasterEngineWindow.Left = 0
                        frmMasterEngineWindow.Top = 0

                        Dim hmiWindow As Object = MyBase.GetObject("GTCP331_350_Screen")

