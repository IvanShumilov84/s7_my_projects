                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_BLEED_DEGF_AVG, "LOG_PERF_T_BLEED_DEGF_AVG"))

                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_EGT_P_DEGF_AVG, "LOG_PERF_T_EGT_P_DEGF_AVG"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_EGT_P1_DEGF, "LOG_PERF_T_EGT_P1_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_EGT_P2_DEGF, "LOG_PERF_T_EGT_P2_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_FUEL_DEGF, "LOG_PERF_T_FUEL_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_INLET_DEGF_AVG, "LOG_PERF_T_INLET_DEGF_AVG"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_OIL_DEGF, "LOG_PERF_T_OIL_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_ORIFICE_DEGF, "LOG_PERF_T_ORIFICE_DEGF"))

                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_VIB_GEARBOX_IPS_PEAK, "LOG_PERF_VIB_GEARBOX_IPS_PEAK"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_VIB_TURBINE_IPS_PEAK, "LOG_PERF_VIB_TURBINE_IPS_PEAK"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_VIB_COOLING_FAN_IPS_PEAK, "LOG_PERF_VIB_COOLING_FAN_IPS_PEAK"))

                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WB_COR_PPM, "LOG_PERF_WB_COR_PPM"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WB_COR_PPM_LIMIT_MIN_ECS, "LOG_PERF_WB_COR_PPM_LIMIT_MIN_ECS"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WB_CALC, "LOG_PERF_WB_CALC"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WB_CALC_PPM, "LOG_PERF_WB_CALC_PPM"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WF_AVG_PPH, "LOG_PERF_WF_AVG_PPH"))


                        'Controls
                        Return_Value.Add(MyBase.InitializeObject(fraMasterPanel, "GTCP331_350_Screen.fraMasterPanel"))
                        Return_Value.Add(MyBase.InitializeObject(fraControlSystem, "GTCP331_350_Screen.fraControlSystem"))
                        Return_Value.Add(MyBase.InitializeObject(fraEngineRun, "GTCP331_350_Screen.GTCP331_350_EngineRun"))

                        fraEcsControl = fraControlSystem.FindObject("fraEcsControl")
                        dspECS = fraEcsControl.FindObject("dspECS")
                        If dspECS Is Nothing Then
                            MessageBox.Show("Initialize_Object - dspECS Is Nothing")
                            Return_Value.Add(False)
                        Else
                            Return_Value.Add(True)
                        End If
                        MessageLogger = fraEngineRun.FindObject("MessageLogger")
                        If MessageLogger Is Nothing Then
                            MessageBox.Show("Initialize_Object - MessageLogger Is Nothing")
                            Return_Value.Add(False)
                        Else
                            MessageLogger.Clear()
                            Return_Value.Add(True)
                        End If

                End Select
            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.Message)
                Return_Value.Add(False)
            Finally

            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function

        Private Sub TestProgress_Initialize()
            Dim dataInfo As CEL.TestProgress.TestProgressMgr.TestProgress_DataInfo = Nothing

            dataInfo.EngineStartEventChannelName = "START_BTN"
            dataInfo.EngineStartEventChannelValue = True
            dataInfo.EngineStartEventDescription = "Engine Start"
            dataInfo.EngineStartEventRecordTime = True
            dataInfo.EngineStopEventChannelName = "STOP_CMD"
            dataInfo.EngineStopEventChannelValue = True
            dataInfo.EngineStopEventDescription = "Engine Stop - Rundown Time (s): "
            dataInfo.EngineStopEventRecordTime = True
            dataInfo.TestProgressFrameName = "GTCP331_350_Screen.fraTestProgressHorizontal"
            dataInfo.TestProgressSheetFileName = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
            dataInfo.UUTModel = CELProject.EngineModel

            Select Case CELProject.Project.Number

                Case 12958
                    dataInfo.UUTSerialNumber = Me.UserInputsEpcor.EngineSerialNumber
                    dataInfo.UUTWorkOrder = Me.UserInputsEpcor.WorkOrder
                Case Else
                    Debug.Assert(False, "TestProgress_Initialize(): Specific engine data not configured for this project")
            End Select

            Me.TestProgressMgr = New CEL.TestProgress.TestProgressMgr(dataInfo)

        End Sub

        Private Sub TestProgress_RecordPerfStep_Generic()
            Dim sheetEntry As CEL.TestProgress.TestProgressSheetEntry = Nothing

            Dim TextString As String = cmbTestStepList.SelectedItem & " performance point taken"

            sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(Now.ToString(), TextString)

            If sheetEntry IsNot Nothing Then
                Me.TestProgressMgr.AddTestProgressEntry(sheetEntry)
            End If
        End Sub

        Private Sub TestProgress_RecordPerfStep(testStep As eTestStepGTCP331_350C)

            If Me.TestProgressMgr IsNot Nothing Then

                Select Case CELProject.Project.Number
                    Case 12958
                        TestProgress_RecordPerfStep_Generic()
                    Case Else
                        Debug.Assert(False, "TestProgress_RecordPerfStep(): Specific engine data not configured for this project")
                End Select

            End If
        End Sub

        Private Sub TestProgress_Save()
            If Not Me.TestProgressMgr Is Nothing Then
                TestProgress_UpdateProgressSheetHeader(Me.TestProgressMgr.TestProgressSheet)
                Dim fileName As String = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
                Dim settings As Xml.XmlWriterSettings = New Xml.XmlWriterSettings()
                settings.Indent = True

                Using writer As Xml.XmlWriter = Xml.XmlWriter.Create(fileName, settings)
                    Dim xslPath As String = "type=""text/xsl"" href=""" + Application.StartupPath + "/TestProgressSheet.xsl"""
                    writer.WriteProcessingInstruction("xml-stylesheet", xslPath)
                    Dim ser As New Xml.Serialization.XmlSerializer(GetType(CEL.TestProgress.TestProgressSheet))
                    ser.Serialize(writer, Me.TestProgressMgr.TestProgressSheet)
                End Using
            End If
        End Sub

        Private Sub TestProgress_UpdateProgressSheetHeader(progressSheet As CEL.TestProgress.TestProgressSheet)
            Select Case CELProject.Project.Number
                Case 12958
                    ' do nothing
                Case Else
                    Debug.Assert(False, "TestProgress_UpdateProgressSheetHeader(): Specific engine data not configured for this project")
            End Select
        End Sub

