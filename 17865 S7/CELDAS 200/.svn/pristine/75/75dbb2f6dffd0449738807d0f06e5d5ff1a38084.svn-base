                        excelWorksheet.Cells(35, 7).Value = LOG_PERF_WB_COR_PPM.Value.ToString(LOG_PERF_WB_COR_PPM.Format, Nothing)
                        excelWorksheet.Cells(36, 7).Value = LOG_PERF_P_BLEED_PSIA_AVG.Value.ToString(LOG_PERF_P_BLEED_PSIA_AVG.Format, Nothing)
                        excelWorksheet.Cells(37, 7).Value = LOG_PERF_PB_COR_PSIA.Value.ToString(LOG_PERF_PB_COR_PSIA.Format, Nothing)
                        excelWorksheet.Cells(38, 7).Value = LOG_PERF_T_BLEED_DEGF_AVG.Value.ToString(LOG_PERF_T_BLEED_DEGF_AVG.Format, Nothing)
                        excelWorksheet.Cells(39, 7).Value = LOG_PERF_TB_COR_DEGF.Value.ToString(LOG_PERF_TB_COR_DEGF.Format, Nothing)
                        excelWorksheet.Cells(40, 7).Value = LOG_PERF_WF_AVG_PPH.Value.ToString(LOG_PERF_WF_AVG_PPH.Format, Nothing)

                    Case eTestStepGTCP331_350C.OP_TIME

                        excelWorksheet = excelSheets.Item("SUMMARY")

                        excelWorksheet.Cells(46, 8).Value = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToString()
                End Select

                TestProgress_RecordPerfStep(TestStepNumber)

                excelWorksheet = excelSheets.Item("ACCEPTANCE")

                'Test Result
                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                End If

                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                End If


            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile350C: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreateEPCOR12958PerformanceFile = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)
            End Try


        End Function

