    Public Class GTCP331_350_Sequence
        Inherits ApuSequence

        'Les constantes isont lu a partir du fichier celdas_12917.cfg
        Private NumberOfTInletProbe As Integer = 8
        Private NumberOfTEgtProbe As Integer = 15
        Private NumberOfTBleedProbe As Integer = 4

        Private Const MaxNumberOfTInletProbe As Integer = 8
        Private Const MaxNumberOfTEgtProbe As Integer = 15
        Private Const MaxNumberOfTBleedProbe As Integer = 4

        Private Enum eTestStepGTCP331_350C
            FLOW_SENSOR = 0
            SURGE_SYS = 1
            NO_LOAD = 2
            ECS = 3
            MES = 4
            OP_TIME = 5
            FINAL_DATA = 6
        End Enum

        Protected Overrides Sub Compute(ByVal CalulateForLogAndPerformanceReports As Boolean)

            Try
                If CalulateForLogAndPerformanceReports Then

                    'Update the Log/Perf channel set
                    CELProject.LogPerfSynch.UpdateValues()

                    LOG_PERF_WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(LOG_PERF_T_ORIFICE_DEGF.Value.ToDouble(), _
                                                                                               LOG_PERF_P_ORIFICE_PSIA.Value.ToDouble(), _
                                                                                              LOG_PERF_P_ORIFICE_DELTA_PSID.Value.ToDouble))

                    Compute_GTCP331_350C_Perf(LOG_PERF_T_INLET_DEGF_AVG, _
                                             LOG_PERF_PB_COR1_PSIA)

                    FlowmeterCtrl.ComputeFlow(True)

                    'IMPORTANT: Toutes les variables flottantes telles que WB_CALC_PPM dont la source et la destination sont vides doivent
                    'manuellement être updaté pour être inscrite dans le LOG ou le PERF report.
                Else

                    WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(T_ORIFICE_DEGF.Value.ToDouble(), _
                                                                                      P_ORIFICE_PSIA.Value.ToDouble(), _
                                                                                      P_ORIFICE_DELTA_PSID.Value.ToDouble))

                    Compute_GTCP331_350C_Default(T_INLET_DEGF_AVG, _
                                             PB_COR1_PSIA)

                End If

            Catch ex As Exception
                MessageBox.Show("Compute_GTCP331_350" + ex.ToString(), "Error")
            End Try

        End Sub

        Private Sub Compute_GTCP331_350C_Default(ByRef tinlet_avg_degf As IChannel, _
                                              ByRef pbcor1 As IChannel)
            Try
                Select Case CELProject.PERF_TEST_STEP_NB.Value.ToDouble()
                    'TODO A tester avec le logperfsynch
                    Case eTestStepGTCP331_350C.FLOW_SENSOR, eTestStepGTCP331_350C.NO_LOAD, eTestStepGTCP331_350C.OP_TIME
                        DELTA_WB.Value = Me.KineticaRT_NAN
                        DELTA_PB.Value = Me.KineticaRT_NAN
                        DELTA_TB.Value = Me.KineticaRT_NAN
                        DELTA_EGT.Value = Me.KineticaRT_NAN

                        DELTA_WB_EXC.Value = Me.KineticaRT_NAN
                        DELTA_PB_EXC.Value = Me.KineticaRT_NAN
                        DELTA_TB_EXC.Value = Me.KineticaRT_NAN
                        DELTA_EGT_EXC.Value = Me.KineticaRT_NAN

                    Case eTestStepGTCP331_350C.SURGE_SYS, eTestStepGTCP331_350C.ECS

                        DELTA_WB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_350C_ECS, 1)
                        DELTA_PB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_350C_ECS, 2)
                        DELTA_TB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_350C_ECS, 3)
                        DELTA_EGT.Value = Me.KineticaRT_NAN

                        DELTA_WB_EXC.Value = Values.Zero
                        DELTA_PB_EXC.Value = Values.Zero
                        DELTA_TB_EXC.Value = Values.Zero
                        DELTA_EGT_EXC.Value = Values.Zero

                    Case eTestStepGTCP331_350C.MES

                        DELTA_WB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_350C_MES, 1)
                        DELTA_PB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_350C_MES, 2)
                        DELTA_TB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_350C_MES, 3)
                        DELTA_EGT.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_350C_MES, 4)

                        DELTA_WB_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_350C_EBP, 1)
                        DELTA_PB_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_350C_EBP, 2)
                        DELTA_TB_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_350C_EBP, 3)
                        DELTA_EGT_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_350C_EBP, 4)

                End Select


            Catch Ex As Exception
                MessageBox.Show("Compute_GTCP331_350C_Perf: " & Ex.Message)
            Finally
            End Try

        End Sub

        Private Sub Compute_GTCP331_350C_Perf(ByRef tinlet_avg_degf As IChannel, _
                                             ByRef pbcor1 As IChannel)
            Try
                Select Case CELProject.PERF_TEST_STEP_NB.Value.ToDouble()
                    'TODO A tester avec le logperfsynch
                    Case eTestStepGTCP331_350C.FLOW_SENSOR, eTestStepGTCP331_350C.NO_LOAD, eTestStepGTCP331_350C.OP_TIME
                        LOG_PERF_DELTA_WB.Value = Me.KineticaRT_NAN
                        LOG_PERF_DELTA_PB.Value = Me.KineticaRT_NAN
                        LOG_PERF_DELTA_TB.Value = Me.KineticaRT_NAN
                        LOG_PERF_DELTA_EGT.Value = Me.KineticaRT_NAN

                        LOG_PERF_DELTA_WB_EXC.Value = Me.KineticaRT_NAN
                        LOG_PERF_DELTA_PB_EXC.Value = Me.KineticaRT_NAN
                        LOG_PERF_DELTA_TB_EXC.Value = Me.KineticaRT_NAN
                        LOG_PERF_DELTA_EGT_EXC.Value = Me.KineticaRT_NAN

                    Case eTestStepGTCP331_350C.SURGE_SYS, eTestStepGTCP331_350C.ECS

                        LOG_PERF_DELTA_WB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_350C_ECS, 1)
                        LOG_PERF_DELTA_PB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_350C_ECS, 2)
                        LOG_PERF_DELTA_TB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_350C_ECS, 3)
                        LOG_PERF_DELTA_EGT.Value = Me.KineticaRT_NAN

                        LOG_PERF_DELTA_WB_EXC.Value = Values.Zero
                        LOG_PERF_DELTA_PB_EXC.Value = Values.Zero
                        LOG_PERF_DELTA_TB_EXC.Value = Values.Zero
                        LOG_PERF_DELTA_EGT_EXC.Value = Values.Zero

                    Case eTestStepGTCP331_350C.MES

                        LOG_PERF_DELTA_WB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_350C_MES, 1)
                        LOG_PERF_DELTA_PB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_350C_MES, 2)
                        LOG_PERF_DELTA_TB.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_350C_MES, 3)
                        LOG_PERF_DELTA_EGT.Value = CELProject.Interpolate_1D(tinlet_avg_degf.Value.ToDouble, GTCP331_350C_MES, 4)

                        LOG_PERF_DELTA_WB_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_350C_EBP, 1)
                        LOG_PERF_DELTA_PB_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_350C_EBP, 2)
                        LOG_PERF_DELTA_TB_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_350C_EBP, 3)
                        LOG_PERF_DELTA_EGT_EXC.Value = CELProject.Interpolate_1D(pbcor1.Value.ToDouble, GTCP331_350C_EBP, 4)

                End Select


            Catch Ex As Exception
                MessageBox.Show("Compute_GTCP331_350C_Perf: " & Ex.Message)
            Finally
            End Try

        End Sub

        Protected Overrides Function CreateCustomHeaderLogFile(ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Try
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Date Time:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Cond#:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Comment:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                ExcelWorksheet.Rows(RowIndex).RowHeight = 65.25
                ExcelWorksheet.Rows(RowIndex).VerticalAlignment = Excel.XlVAlign.xlVAlignTop
                ExcelWorksheet.Rows(RowIndex).WrapText = True

                Return True

            Catch ex As Exception
                MessageBox.Show("CreateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        Protected Overrides Function UpdateCustomHeaderLogFile(ByVal AppendOption As Boolean, ByVal IsPerfEntry As Boolean, ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Try
                Dim Log_Condition As Integer

                If AppendOption = False Then
                    Log_Condition = 1
                Else
                    Log_Condition = ExcelWorksheet.Cells(RowIndex + 1, ExcelWorksheet.Columns.Count).End(Excel.XlDirection.xlToLeft).Column - 1
                    Log_Condition = Log_Condition + 1

                End If

                If ((Log_Condition > 1) And ((Log_Condition Mod 5) = 1)) Then

                    'Repeat The Test Spec For this new sets of condition

                    With ExcelWorksheet
                        .Range(.Cells(2, 2), .Cells(RowIndex - 2, 6)).Copy(.Cells(2, Log_Condition + 1))
                    End With
                End If

                ColumnIndex = 1 + Log_Condition

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Format(Now, "yyyy/MM/dd HH:mm:ss")
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Log_Condition.ToString()
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                If IsPerfEntry = False Then
                    Dim CommentText As String = ""
                    Dim InputObject As New InputCommentForm
                    InputObject.ShowDialog("Log Report", "Comment:", "", CommentText)

                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = CommentText
                Else
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "STEP: " & cmbTestStepList.SelectedItem
                End If

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 2
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Values"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignCenter

            Catch ex As Exception
                MessageBox.Show("UpdateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        Private Function CreateEPCOR12958PerformanceFile(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean

            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreateEPCOR12958PerformanceFile = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            Try
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                'Overwrite data each time
                excelWorksheet = excelSheets.Item("SUMMARY")

                If AppendOption = False Then

                    excelWorksheet = excelSheets.Item("SUMMARY")
                    'Customer
                    excelWorksheet.Cells(5, 3).NumberFormat = "@"
                    excelWorksheet.Cells(5, 3).Value = UserInputsEpcor.CustomerName
                    'Work Order
                    excelWorksheet.Cells(6, 3).NumberFormat = "@"
                    excelWorksheet.Cells(6, 3).Value = UserInputsEpcor.WorkOrder
                    'Engine P/N
                    excelWorksheet.Cells(7, 3).NumberFormat = "@"
                    excelWorksheet.Cells(7, 3).Value = UserInputsEpcor.EnginePartNumber
                    'Engine S/N
                    excelWorksheet.Cells(8, 3).NumberFormat = "@"
                    excelWorksheet.Cells(8, 3).Value = UserInputsEpcor.EngineSerialNumber
                    'Date
                    excelWorksheet.Cells(5, 8).NumberFormat = "@"
                    excelWorksheet.Cells(5, 8).Value = Format(Now, "MM/dd/yyyy")
                    'Fuel SG
                    excelWorksheet.Cells(6, 8).NumberFormat = "@"
                    excelWorksheet.Cells(6, 8).Value = UserInputsEpcor.SampleFuelSG
                    'T Fuel
                    excelWorksheet.Cells(7, 8).NumberFormat = "@"
                    excelWorksheet.Cells(7, 8).Value = UserInputsEpcor.SampleFuelTemperature
                    'Fuel Type
                    excelWorksheet.Cells(8, 8).NumberFormat = "@"
                    excelWorksheet.Cells(8, 8).Value = UserInputsEpcor.FuelType
                    'Oil Type
                    excelWorksheet.Cells(9, 8).NumberFormat = "@"
                    excelWorksheet.Cells(9, 8).Value = UserInputsEpcor.OilType

                    'Oil Type
                    excelWorksheet.Cells(9, 3).NumberFormat = "@"
                    excelWorksheet.Cells(9, 3).Value = UserInputsEpcor.RepairType

                    excelWorksheet = excelSheets.Item("ACCEPTANCE")
                    excelWorksheet.Cells(47, 1).NumberFormat = "@"
                    excelWorksheet.Cells(47, 1).Value = excelWorksheet.Cells(47, 1).Value.ToString() + Custom_Parameters("APUTestedAccordingTo").ToString()

                End If

                ' BLEED CONTROL VALVE TEST section
                excelWorksheet = excelSheets.Item("SUMMARY")

                excelWorksheet.Cells(31, 8).Value = CAPTURE_FLOW_SENSOR_PRESSURE_PSIG.Value.ToString(CAPTURE_FLOW_SENSOR_PRESSURE_PSIG.Format, Nothing)

                ' SURGE SYSTEM TEST section
                excelWorksheet = excelSheets.Item("SUMMARY")

                excelWorksheet.Cells(36, 8).Value = CAPTURE_CORRECTED_DISCHARGE_FLOW_PPM.Value.ToString(CAPTURE_CORRECTED_DISCHARGE_FLOW_PPM.Format, Nothing)

                ' PERFORMED TEST DETAILS section
                excelWorksheet = excelSheets.Item("SUMMARY")

                If CELProject.IsTrue(LOG_PERF_SCV_STABILITY_CHECK.Value) Then
                    excelWorksheet.Cells(41, 8).Value = "PASSED"
                Else
                    excelWorksheet.Cells(41, 8).Value = "FAILED"
                End If

                excelWorksheet.Cells(42, 8).Value = LOG_PERF_STARTING_TIME_SEC.Value.ToString(LOG_PERF_STARTING_TIME_SEC.Format, Nothing)
                excelWorksheet.Cells(43, 8).Value = LOG_PERF_STARTER_CUTOUT_TIME_SEC.Value.ToString(LOG_PERF_STARTER_CUTOUT_TIME_SEC.Format, Nothing)

                If CELProject.IsTrue(LOG_PERF_HONEYCOMB_SEAL_CHECK.Value) Then
                    excelWorksheet.Cells(44, 8).Value = "PASSED"
                Else
                    excelWorksheet.Cells(44, 8).Value = "FAILED"
                End If
                excelWorksheet.Cells(45, 8).Value = NUMBER_OF_STARTS.Value.ToString()
                excelWorksheet.Cells(47, 8).Value = NUMBER_OF_APU_FAULTS_SEEN_DURING_TEST.Value.ToString()

                Select Case CELProject.PERF_TEST_STEP_NB.Value.ToDouble

                    Case eTestStepGTCP331_350C.NO_LOAD

                        excelWorksheet = excelSheets.Item("DETAILS")

                        excelWorksheet.Cells(13, 9).Value = LOG_PERF_P_BARO_PSIA.Value.ToString(LOG_PERF_P_BARO_PSIA.Format, Nothing)
                        excelWorksheet.Cells(14, 9).Value = LOG_PERF_T_INLET_DEGF_AVG.Value.ToString(LOG_PERF_T_INLET_DEGF_AVG.Format, Nothing)
                        excelWorksheet.Cells(15, 9).Value = LOG_PERF_T_LCIT_DEGF.Value.ToString(LOG_PERF_T_LCIT_DEGF.Format, Nothing)
                        excelWorksheet.Cells(16, 9).Value = LOG_PERF_P_OIL_PSIG.Value.ToString(LOG_PERF_P_OIL_PSIG.Format, Nothing)
                        excelWorksheet.Cells(17, 9).Value = LOG_PERF_T_OIL_DEGF.Value.ToString(LOG_PERF_T_OIL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(18, 9).Value = LOG_PERF_P_GEARBOX_PSIA.Value.ToString(LOG_PERF_P_GEARBOX_PSIA.Format, Nothing)
                        excelWorksheet.Cells(19, 9).Value = LOG_PERF_T_FUEL_DEGF.Value.ToString(LOG_PERF_T_FUEL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(20, 9).Value = LOG_PERF_P_FUEL_PSIG.Value.ToString(LOG_PERF_P_FUEL_PSIG.Format, Nothing)
                        excelWorksheet.Cells(21, 9).Value = LOG_PERF_VIB_GEARBOX_IPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_IPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(22, 9).Value = LOG_PERF_VIB_TURBINE_IPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_IPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(23, 9).Value = LOG_PERF_VIB_COOLING_FAN_IPS_PEAK.Value.ToString(LOG_PERF_VIB_COOLING_FAN_IPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(24, 9).Value = LOG_PERF_NG_RPM.Value.ToString(LOG_PERF_NG_RPM.Format, Nothing)
                        excelWorksheet.Cells(25, 9).Value = LOG_PERF_ARINC_IGV_POS.Value.ToString(LOG_PERF_ARINC_IGV_POS.Format, Nothing)
                        excelWorksheet.Cells(26, 9).Value = LOG_PERF_T_EGT_P1_DEGF.Value.ToString(LOG_PERF_T_EGT_P1_DEGF.Format, Nothing)
                        excelWorksheet.Cells(27, 9).Value = LOG_PERF_T_EGT_P2_DEGF.Value.ToString(LOG_PERF_T_EGT_P2_DEGF.Format, Nothing)
                        excelWorksheet.Cells(28, 9).Value = LOG_PERF_T_EGT_P_DEGF_AVG.Value.ToString(LOG_PERF_T_EGT_P_DEGF_AVG.Format, Nothing)
                        excelWorksheet.Cells(29, 9).Value = LOG_PERF_P_EXHAUST_PSIA.Value.ToString(LOG_PERF_P_EXHAUST_PSIA.Format, Nothing)
                        excelWorksheet.Cells(40, 9).Value = LOG_PERF_WF_AVG_PPH.Value.ToString(LOG_PERF_WF_AVG_PPH.Format, Nothing)

                    Case eTestStepGTCP331_350C.ECS
                        'ECS OFFSET WORKSHEET section

                        excelWorksheet = excelSheets.Item("SUMMARY")

                        excelWorksheet.Cells(24, 8).Value = LOG_PERF_WB_COR_PPM.Value.ToString(LOG_PERF_WB_COR_PPM.Format, Nothing)
                        excelWorksheet.Cells(25, 8).Value = LOG_PERF_PB_COR_PSIA.Value.ToString(LOG_PERF_PB_COR_PSIA.Format, Nothing)
                        excelWorksheet.Cells(26, 8).Value = LOG_PERF_ARINC_IGV_POS.Value.ToString(LOG_PERF_ARINC_IGV_POS.Format, Nothing)
                        excelWorksheet.Cells(27, 8).Value = LOG_PERF_IGVPERFADJ.Value.ToString(LOG_PERF_IGVPERFADJ.Format, Nothing)

                        excelWorksheet.Cells(15, 6).Value = LOG_PERF_PB_COR_PSIA.Value.ToString(LOG_PERF_PB_COR_PSIA.Format, Nothing)
                        excelWorksheet.Cells(16, 6).Value = LOG_PERF_CORR_WB_PPM.Value.ToString(LOG_PERF_CORR_WB_PPM.Format, Nothing)
                        excelWorksheet.Cells(17, 6).Value = LOG_PERF_WB_COR_PPM.Value.ToString(LOG_PERF_WB_COR_PPM.Format, Nothing)
                        excelWorksheet.Cells(19, 6).Value = LOG_PERF_ARINC_IGV_POS.Value.ToString(LOG_PERF_ARINC_IGV_POS.Format, Nothing)

                        'TODO A tester
