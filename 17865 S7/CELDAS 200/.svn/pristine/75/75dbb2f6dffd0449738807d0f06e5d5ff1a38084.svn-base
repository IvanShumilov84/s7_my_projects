        Protected Overrides Sub OnNEW_TEST_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            If (CELProject.IsTrue(newVal)) Then

                If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                    CAPTURE_CORRECTED_DISCHARGE_FLOW_PPM.Value = Values.Zero
                    CAPTURE_FLOW_SENSOR_PRESSURE_PSIG.Value = Values.Zero
                    NUMBER_OF_APU_FAULTS_SEEN_DURING_TEST.Value = Values.Zero
                    NUMBER_OF_STARTS.Value = Values.Zero
                    SCV_STABILITY_CHECK.Value = Values.False
                    HONEYCOMB_SEAL_CHECK.Value = Values.False

                    OPERATING_TIME_CURRENT_SEC.Value = Values.Zero
                    FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                    NG_RPM_MAX_PERSISTENT.Value = Values.Zero
                    VIB_GEARBOX_IPS_PEAK_MAX_PERSISTENT.Value = Values.Zero
                    VIB_TURBINE_IPS_PEAK_MAX_PERSISTENT.Value = Values.Zero
                    VIB_COOLING_FAN_IPS_PEAK_MAX_PERSISTENT.Value = Values.Zero
                    P_OIL_PSIG_MAX_PERSISTENT.Value = Values.Zero

                    WF_TOT1.Value = Values.Zero
                    WF_TOT2.Value = Values.Zero

                    TestProgress_Save()

                    Try
                        If (System.IO.File.Exists(CELProject.EngineSession.LogFolder + "TestProgress.xml")) Then

                            Rename(CELProject.EngineSession.LogFolder + "TestProgress.xml", CELProject.EngineSession.LogFolder + "TestProgress_" & Format(Date.Now, "yyyy-MM-dd hh'h'mm'm'ss's'") & ".xml")
                        End If

                        TestProgressMgr.TestProgressSheet.Entries.Clear()

                    Catch Ex As Exception
                        MessageBox.Show("TestProgess File not found: " & Ex.ToString())
                    End Try

                End If

            End If

        End Sub

