        Private Sub Init_Arrays()

            Dim SelectString As String
            Dim rs As ADODB.Recordset = Nothing
            Dim i As Integer

            Try

                'Read Table 110 GTCP331-350C
                SelectString = "SELECT * FROM GTCP331_350C_ECS ORDER BY [INLET_T]"
                If DatabaseHelper.OpenRecordset(rs, SelectString, cnMain, True) Then
                    ReDim GTCP331_350C_ECS(DatabaseHelper.RecordCount(rs) - 1, 3)
                    For i = 0 To GTCP331_350C_ECS.GetLength(0) - 1
                        GTCP331_350C_ECS(i, 0) = rs.Fields("INLET_T").Value
                        GTCP331_350C_ECS(i, 1) = rs.Fields("WB_DELTA").Value
                        GTCP331_350C_ECS(i, 2) = rs.Fields("PB_DELTA").Value
                        GTCP331_350C_ECS(i, 3) = rs.Fields("TB_DELTA").Value
                        rs.MoveNext()
                    Next i
                    DatabaseHelper.CloseRecordset(rs)
                End If

                Debug.Assert(i > 0)
                i = 0

                'Read Table 113 GTCP331-350C
                SelectString = "SELECT * FROM GTCP331_350C_MES ORDER BY [INLET_T]"
                If DatabaseHelper.OpenRecordset(rs, SelectString, cnMain, True) Then
                    ReDim GTCP331_350C_MES(DatabaseHelper.RecordCount(rs) - 1, 4)
                    For i = 0 To GTCP331_350C_MES.GetLength(0) - 1
                        GTCP331_350C_MES(i, 0) = rs.Fields("INLET_T").Value
                        GTCP331_350C_MES(i, 1) = rs.Fields("WB_DELTA").Value
                        GTCP331_350C_MES(i, 2) = rs.Fields("PB_DELTA").Value
                        GTCP331_350C_MES(i, 3) = rs.Fields("TB_DELTA").Value
                        GTCP331_350C_MES(i, 4) = rs.Fields("EGT_DELTA").Value
                        rs.MoveNext()
                    Next i
                    DatabaseHelper.CloseRecordset(rs)
                End If

                Debug.Assert(i > 0)
                i = 0

                'Read Table 114 & 114B GTCP331-350C
                SelectString = "SELECT GTCP331_350C_EBP.*, Repair_Category.Description FROM Repair_Category INNER JOIN GTCP331_350C_EBP ON Repair_Category.ID = GTCP331_350C_EBP.Repair_Category WHERE Repair_Category.Description = '" & UserInputsEpcor.RepairType & "' ORDER BY [PBCOR_ONE]"
                If DatabaseHelper.OpenRecordset(rs, SelectString, cnMain, True) Then
                    ReDim GTCP331_350C_EBP(DatabaseHelper.RecordCount(rs) - 1, 4)
                    For i = 0 To GTCP331_350C_EBP.GetLength(0) - 1
                        GTCP331_350C_EBP(i, 0) = rs.Fields("PBCOR_ONE").Value
                        GTCP331_350C_EBP(i, 1) = rs.Fields("WBEXC_DELTA").Value
                        GTCP331_350C_EBP(i, 2) = rs.Fields("PBEXC_DELTA").Value
                        GTCP331_350C_EBP(i, 3) = rs.Fields("TBEXC_DELTA").Value
                        GTCP331_350C_EBP(i, 4) = rs.Fields("EGTEXC_DELTA").Value
                        rs.MoveNext()
                    Next i
                    DatabaseHelper.CloseRecordset(rs)
                End If

                Debug.Assert(i > 0)

            Catch Ex As Exception
                MessageBox.Show("InitArrays: " & Ex.ToString())
            Finally
            End Try
        End Sub

        Protected Overrides Sub Init_Engine_Controls()

            SetTestStepList(0)

        End Sub

        'Use Delegate for Cross Thread Operation
        Private Delegate Sub SetTestStepListDelegate(ByVal value As Integer)
        Protected Overrides Sub SetTestStepList(ByVal value As Integer)

            If (Me.cmbTestStepList.InvokeRequired) Then
                Me.cmbTestStepList.BeginInvoke(New SetTestStepListDelegate(AddressOf Me.SetTestStepList), value)
            Else
                cmbTestStepList.Items.Clear()
                cmbTestStepList.Items.Add("FLOW SENSOR CHECK")
                cmbTestStepList.Items.Add("SURGE SYSTEM")
                cmbTestStepList.Items.Add("NO LOAD")
                cmbTestStepList.Items.Add("ECS")
                cmbTestStepList.Items.Add("MES")
                cmbTestStepList.Items.Add("OPERATING TIME")
                cmbTestStepList.Items.Add("FINAL DATA")
                cmbTestStepList.SelectedIndex = value
            End If
        End Sub

        Private Sub EmulateInletFlapOpeningClosing()

            Static FlapPosition As Integer = 0
            Try

                If CELProject.IsTrue(INLET_FLAP_OPEN_REQUEST_IND.Value) Then
                    If (FlapPosition < 3000) Then
                        FlapPosition = FlapPosition + 100
                    Else
                        FlapPosition = 3000
                    End If

                ElseIf CELProject.IsTrue(INLET_FLAP_CLOSE_REQUEST_IND.Value) Then
                    If (FlapPosition > 0) Then
                        FlapPosition = FlapPosition - 100
                    Else
                        FlapPosition = 0
                    End If
                End If

                If FlapPosition = 0 Then
                    INLET_FLAP_CLOSE_CMD.Value = Values.True   ' (* 0 is close position*) 
                Else
                    INLET_FLAP_CLOSE_CMD.Value = Values.False
                End If
                If FlapPosition = 3000 Then
                    INLET_FLAP_OPEN_CMD.Value = Values.True '(* 3000 is open position*)
                Else
                    INLET_FLAP_OPEN_CMD.Value = Values.False
                End If
                If FlapPosition <> 0 And FlapPosition <> 3000 Then
                    INLET_FLAP_MOVE_CMD.Value = Values.True
                Else
                    INLET_FLAP_MOVE_CMD.Value = Values.False
                End If

            Catch ex As Exception
                Console.WriteLine("EmulateInletFlapOpeningClosing: " + ex.Message)
            End Try

        End Sub

        Protected Overrides Sub OnEngineWorkingThread()

            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                'Performance calculation
                Compute(False)

                EmulateInletFlapOpeningClosing()

                'Persistent Values Save Check
                PersistentValuesCtrl.SavePersistentValues(False)

            End If

        End Sub

        Private Function Compute_BleedAirFlow(ByVal TOrifice_DEGF As Double, _
                                              ByVal POrifice_PSIA As Double, _
                                              ByVal POrificeDelta_PSID As Double) As Double
            Try

                If CELProject.IsTrue(BLEED_BTN.Value) Then

                    Dim BleedAirFLow As Double = CELProject.GetBleedAirFlow( _
                                                                            EngineConfiguration.DuctDiameter, _
                                                                            EngineConfiguration.DuctDiameterUnit, _
                                                                            EngineConfiguration.OrificeDiameter, _
                                                                            EngineConfiguration.OrificeDiameterUnit, _
                                                                            TOrifice_DEGF, _
                                                                            CELDAS.eTemperature.Fahrenheit, _
                                                                            POrifice_PSIA, _
                                                                            CELDAS.ePressure.PSI, _
                                                                            POrificeDelta_PSID, _
                                                                            CELDAS.ePressure.PSI, _
                                                                            EngineConfiguration.OrificeThinkness, _
                                                                            EngineConfiguration.OrificeThinknessUnit, _
                                                                            EngineConfiguration.TapArrangement, _
                                                                            CELDAS.eFlowMass.LbByMin)

                    Return BleedAirFLow

                Else
                    Return 0.0
                End If

            Catch Ex As Exception
                'Log error
                MessageBox.Show("Error in Engine_Sequence.Compute_BleedAirFlow: " & Ex.ToString)
            End Try

        End Function


