        End Sub

        Private Function CreateCELTestReportsFile(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            '           Dim Column As Integer
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet
            Dim sheetIndex As Integer

            CreateCELTestReportsFile = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            '            T53_DRP_PLOT.CurrentPanelIndex

            Try

                Select Case T53_DRP_PLOT.CurrentPanelIndex
                    Case 0 ' Ground Idle Check

                        sheetIndex = excelSheets.Item("Ground Idle Check").Index()
                        excelWorkbook.Worksheets(sheetIndex).Unprotect(UnProtectPassword)

                        excelWorksheet = excelSheets.Item("Ground Idle Check")

                        Dim ligne As Integer = 15

                        WritePerformanceHeader(excelWorksheet, 3, 6)

                        'WF
                        WriteReportCellContent(excelWorksheet, WF_AVG_COMP_PPH, WF_COMP_GROUND_IDLE_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'SHPComp
                        WriteReportCellContent(excelWorksheet, SHP_COMP, SHP_COMP_GROUND_IDLE_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'N1 %
                        WriteReportCellContent(excelWorksheet, N1_PCT, N1_PCT_GROUND_IDLE_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'N1 Throttle
                        WriteReportCellContent(excelWorksheet, N1_THROTTLE_DEG, N1_THROTTLE_GOUND_IDLE_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'PWFI
                        WriteReportCellContent(excelWorksheet, P_FUEL_INLET_PSIG, FUEL_INLET_PRESSURE_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'POFO
                        WriteReportCellContent(excelWorksheet, P_OIL_FILTER_OUTLET_PRESSURE, P_OIL_FILTER_OUTLET_PRESSURE_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'PGBO
                        WriteReportCellContent(excelWorksheet, P_ACCESSORY_DRIVE_GEARBOX, P_ACCESSORY_DRIVE_GEARBOX_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'TOPI
                        WriteReportCellContent(excelWorksheet, T_OIL_PUMP_INLET, T_OIL_PUMP_INLET_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'TOPO
                        WriteReportCellContent(excelWorksheet, T_ENGINE_OIL_DEGF, T_ENGINE_OIL_DEGF_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'T2BO
                        WriteReportCellContent(excelWorksheet, T_NO_2_BEARING_SCAVENGE_OIL_DEGF, T_NO_2_BEARING_SCAVENGE_OIL_DEGF_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'T3BO
                        WriteReportCellContent(excelWorksheet, T_POWER_TURBINE_SCAVENGE_OIL_DEGF, T_POWER_TURBINE_SCAVENGE_OIL_DEGF_TEST_IND, ligne, 6, 7)

                        TakeFullReading(excelWorksheet, 30)

                    Case 1 ' Flight Idle Check

                        sheetIndex = excelSheets.Item("Flight Idle Check").Index()
                        excelWorkbook.Worksheets(sheetIndex).Unprotect(UnProtectPassword)

                        excelWorksheet = excelSheets.Item("Flight Idle Check")

                        Dim ligne As Integer = 15

                        WritePerformanceHeader(excelWorksheet, 3, 6)

                        'WF Comp
                        WriteReportCellContent(excelWorksheet, WF_AVG_COMP_PPH, WF_COMP_FLIGHT_IDLE_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'SHP Comp
                        WriteReportCellContent(excelWorksheet, SHP_COMP, SHP_COMP_FLIGHT_IDLE_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'N1 % 
                        WriteReportCellContent(excelWorksheet, N1_PCT, N1_PCT_FLIGHT_IDLE_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'N1 Throttle
                        WriteReportCellContent(excelWorksheet, N1_THROTTLE_DEG, N1_THROTTLE_FLIGHT_IDLE_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'PWFI
                        WriteReportCellContent(excelWorksheet, P_FUEL_INLET_PSIG, FUEL_INLET_PRESSURE_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'POFO
                        WriteReportCellContent(excelWorksheet, P_OIL_FILTER_OUTLET_PRESSURE, P_OIL_FILTER_OUTLET_PRESSURE_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'PGBO
                        WriteReportCellContent(excelWorksheet, P_ACCESSORY_DRIVE_GEARBOX, P_ACCESSORY_DRIVE_GEARBOX_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'TOPI
                        WriteReportCellContent(excelWorksheet, T_OIL_PUMP_INLET, T_OIL_PUMP_INLET_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'TOPO
                        WriteReportCellContent(excelWorksheet, T_ENGINE_OIL_DEGF, T_ENGINE_OIL_DEGF_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'T2BO
                        WriteReportCellContent(excelWorksheet, T_NO_2_BEARING_SCAVENGE_OIL_DEGF, T_NO_2_BEARING_SCAVENGE_OIL_DEGF_TEST_IND, ligne, 6, 7)

                        ligne += 1

                        'T3BO
                        WriteReportCellContent(excelWorksheet, T_POWER_TURBINE_SCAVENGE_OIL_DEGF, T_POWER_TURBINE_SCAVENGE_OIL_DEGF_TEST_IND, ligne, 6, 7)

                        TakeFullReading(excelWorksheet, 31)

                    Case 2 '60% Normal Check

                        sheetIndex = excelSheets.Item("60% Normal Check").Index()
                        excelWorkbook.Worksheets(sheetIndex).Unprotect(UnProtectPassword)

                        excelWorksheet = excelSheets.Item("60% Normal Check")

                        Dim ligne As Integer = 15

                        WritePerformanceHeader(excelWorksheet, 3, 6)

                        'WF Comp
                        excelWorksheet.Cells(ligne, 5).Value = "< " + WF_AVG_COMP_PPH_MAX_60_PCT_VS_AMBIENT_TEMP.Value.ToString(WF_AVG_COMP_PPH_MAX_60_PCT_VS_AMBIENT_TEMP.Format, Nothing)
