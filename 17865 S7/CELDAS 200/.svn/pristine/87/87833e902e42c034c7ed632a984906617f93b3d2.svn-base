        Private Sub OnVANE_FULLY_CLOSED_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    N1_PCT_VANES_FULLY_CLOSED.Value = New KineticaRT.Values.Double(N1_PCT.Value.ToDouble)
                    N1_RPM_VANES_FULLY_CLOSED.Value = New KineticaRT.Values.Double(N1_RPM.Value.ToDouble)
                    WF_AVG_COMP_PPH_FULLY_CLOSED.Value = New KineticaRT.Values.Double(WF_AVG_COMP_PPH.Value.ToDouble)
                    T_INLET_AVG_DEGR_FULLY_CLOSED.Value = New KineticaRT.Values.Double(T_INLET_AVG_DEGF.Value.ToDouble)
                    VANE_FULLY_CLOSED_BTN.Value = Values.False

                    If N1_RPM_VANES_BEGIN_TO_OPEN.Value.ToDouble > 100 And N1_RPM_VANES_FULLY_OPEN.Value.ToDouble > 100 Then

                        Dim diff As Double = Math.Abs(N1_PCT_VANES_BEGIN_TO_OPEN.Value.ToDouble - N1_PCT_VANES_FULLY_CLOSED.Value.ToDouble) * 100 / N1_PCT_VANES_BEGIN_TO_OPEN.Value.ToDouble
                        Dim diff1 As Double = Math.Abs(N1_RPM_VANES_BEGIN_TO_OPEN.Value.ToDouble - N1_RPM_VANES_FULLY_CLOSED.Value.ToDouble) * 100 / N1_RPM_VANES_BEGIN_TO_OPEN.Value.ToDouble
                        Dim diff2 As Double = Math.Abs(WF_AVG_COMP_PPH_BEGIN_TO_OPEN.Value.ToDouble - WF_AVG_COMP_PPH_FULLY_CLOSED.Value.ToDouble) * 100 / WF_AVG_COMP_PPH_BEGIN_TO_OPEN.Value.ToDouble
                        Dim diff3 As Double = Math.Abs(T_INLET_AVG_DEGR_BEGIN_TO_OPEN.Value.ToDouble - T_INLET_AVG_DEGR_FULLY_CLOSED.Value.ToDouble) * 100 / T_INLET_AVG_DEGR_BEGIN_TO_OPEN.Value.ToDouble

                        N1_PCT_VANES_BEGIN_TO_OPEN_FULLY_CLOSED_DIFF.Value = New KineticaRT.Values.Double(diff)
                        N1_RPM_VANES_BEGIN_TO_OPEN_FULLY_CLOSED_DIFF.Value = New KineticaRT.Values.Double(diff1)
                        WF_AVG_COMP_PPH_BEGIN_TO_OPEN_FULLY_CLOSED_DIFF.Value = New KineticaRT.Values.Double(diff2)
                        T_INLET_AVG_DEGR_BEGIN_TO_OPEN_FULLY_CLOSED_DIFF.Value = New KineticaRT.Values.Double(diff3)

                        If diff > 5 Or diff1 > 5 Or diff2 > 5 Or diff3 > 5 Then
                            IGV_TEST_BEGIN_TO_OPEN_FULLY_CLOSED_IND.Value = Values.False
                        Else
                            IGV_TEST_BEGIN_TO_OPEN_FULLY_CLOSED_IND.Value = Values.True
                        End If
                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("T53_Sequence: OnVANE_FULLY_CLOSED_BTN: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

