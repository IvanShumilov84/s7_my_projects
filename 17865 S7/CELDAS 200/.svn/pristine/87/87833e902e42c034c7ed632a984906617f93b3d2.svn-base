        Protected Overrides Sub Init_Engine_Controllers()

            Dim PersistentValuesChannels() As String = {"OPERATING_TIME_SEC", "NB_ENGINE_START", "CONDITION_NUMBER", "FUEL_USED_TOTAL_LITERS", "FUEL_USED_TOTAL_KG"}
            Dim PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputs.EngineSerialNumber & "\PersistentValues.xml"

            If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then
                PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)
                FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())
                FUEL_USED_INITIAL_KG.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_KG.Value.ToDouble())
                NB_ENGINE_START_OPC.Value = NB_ENGINE_START.Value
                OperatingTimeSec = CInt(OPERATING_TIME_SEC.Value.ToDouble())
            End If

            FlowmeterCtrl = New FlowmeterController(Me)

            VX100WatchDogCtrl = New WatchdogController(Me, "VX100_WATCHDOG_STATUS", "VX100_WATCHDOG_TIME_LIMIT", "VX100_WATCHDOG_LINK")

            DeletableTInletChCtrl = New DeletableChannelController(Me, NumberOfT1Probe, NumberOfT1Probe, NumberOfT1Probe / 2, "T_INLET_", "_DEGF", "_DELETE_BTN", "T_INLET_AVG_DEGF", "T_INLET_MIN_DEGF", "T_INLET_MAX_DEGF", "T_INLET_SPREAD_DEGF")
            DeletableP1SChCtrl = New DeletableChannelController(Me, NumberOfPS1Probe, NumberOfPS1Probe, NumberOfPS1Probe / 2, "P_S_INLET_", "_PSIA", "_DELETE_BTN", "P_S_INLET_AVG_PSIA", "P_S_INLET_MIN_PSIA", "P_S_INLET_MAX_PSIA", "P_S_INLET_SPREAD_PSIA")

            StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_CURRENT", "STARTER_CURRENT_MAX", "STARTER_DEMAND_OPC")
            StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_VOLTAGE", "STARTER_VOLTAGE_MAX", "STARTER_DEMAND_OPC")
            TT9MaxTemperatureRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_EXHAUST_GAS_DEGF", "T_EXHAUST_GAS_DEGF_MAX", "STARTER_DEMAND_OPC")
            Thread.Sleep(500) 'besoins d'un delais sinon WF_MAX affiche NaN
            WFMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "WF_PPH", "WF_MAX", "WF_MAX_RESET")

            NGMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "N1_RPM", "N1_RPM_PEAK", "N1_RPM_PEAK_RESET")
            NPMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "N2_RPM", "N2_RPM_PEAK", "N2_RPM_PEAK_RESET")
            VibAGBMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_FRONT_IPS", "VIB_FRONT_IPS_PEAK", "VIB_FRONT_IPS_PEAK_RESET")
            VibExhaust1MaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_AXIAL_IPS", "VIB_AXIAL_IPS_PEAK", "VIB_AXIAL_IPS_PEAK_RESET")
            VibExhaust4MaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_POWER_TURBINE_IPS", "VIB_POWER_TURBINE_IPS_PEAK", "VIB_POWER_TURBINE_IPS_PEAK_RESET")
            VibDynoMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_DYNO_IPS", "VIB_DYNO_IPS_PEAK", "VIB_DYNO_IPS_PEAK_RESET")

            TimeToGITimerCtrl = New TimerController(Me, "TIME_TO_GI_START_CONDITION_LATCH", "TIME_TO_GI_STOP_CONDITION_LATCH", "TIME_TO_GI_CONDITION_RESET", "TIME_TO_GI_SEC", Nothing, 0, "NONE")
            TimeToCDTimerCtrl = New TimerController(Me, "TIME_TO_COAST_DOWN_START_CONDITION", "TIME_TO_COAST_DOWN_STOP_CONDITION", "TIME_TO_COAST_DOWN_CONDITION_RESET", "TIME_TO_COAST_DOWN_SEC", Nothing, 0, "NONE")
            If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then
                OperatingTimerCtrl = New TimerController(Me, "OPERATING_TIME_START_CONDITION", "OPERATING_TIME_STOP_CONDITION", "OPERATING_TIME_CONDITION_RESET", "OPERATING_TIME_SEC", "OPERATING_TIME_HHMMSS", 0, "NONE", True)
                OPERATING_TIME_HHMMSS_OPC.Value = OPERATING_TIME_HHMMSS.Value
            End If
            StopWatchTimerCtrl = New TimerController(Me, "STOPWATCH_START_CONDITION", "STOPWATCH_STOP_CONDITION", "STOPWATCH_RESET_CONDITION", "STOPWATCH_TIME_SEC", "STOPWATCH_TIME", 0, Nothing, False)

            DynoPumpDriveCtrl = New AutomaticPumpDriveCurrentController(Me, "DYNO_WATER_PUMP_DRIVE_CURRENT_LOW_RANGE", "DYNO_WATER_PUMP_DRIVE_CURRENT_HIGH_RANGE",
                                                                        "DYNO_WATER_PUMP_DRIVE_CURRENT_FOR_LOW_SPEED", "DYNO_WATER_PUMP_DRIVE_CURRENT_FOR_HIGH_SPEED",
                                                                        "DYNO_WATER_PUMP_DRIVE_ENGINE_LOW_SPEED_TRIGGER", "DYNO_WATER_PUMP_DRIVE_ENGINE_HIGH_SPEED_TRIGGER",
                                                                        "DYNO_WATER_SUPPLY_PUMP_BTN", "N1_RPM", "DYNO_WATER_PUMP_DRIVE_CURRENT_CMD")

        End Sub
        Protected Overrides Sub Dispose_Engine_Controllers()

            If Not (DeletableTInletChCtrl Is Nothing) Then
                DeletableTInletChCtrl.Dispose()
            End If

            If Not (DeletableP1SChCtrl Is Nothing) Then
                DeletableP1SChCtrl.Dispose()
            End If

            If Not (DeletableP1TChCtrl Is Nothing) Then
                DeletableP1TChCtrl.Dispose()
            End If

            If Not (DeletablePThroatStaticChCtrl Is Nothing) Then
                DeletablePThroatStaticChCtrl.Dispose()
            End If

            If Not (DeletablePUpstreamStaticChCtrl Is Nothing) Then
                DeletablePUpstreamStaticChCtrl.Dispose()
            End If

            If Not (StarterMaxCurrentRecordCtrl Is Nothing) Then
                StarterMaxCurrentRecordCtrl.Dispose()
            End If

            If Not (StarterMaxVoltageRecordCtrl Is Nothing) Then
                StarterMaxVoltageRecordCtrl.Dispose()
            End If

            If Not (TT9MaxTemperatureRecordCtrl Is Nothing) Then
                TT9MaxTemperatureRecordCtrl.Dispose()
            End If

            If Not (StopWatchTimerCtrl Is Nothing) Then
                StopWatchTimerCtrl.Dispose()
            End If

            If Not (NGMaxRecordCtrl Is Nothing) Then
                NGMaxRecordCtrl.Dispose()
            End If

            If Not (NPMaxRecordCtrl Is Nothing) Then
                NPMaxRecordCtrl.Dispose()
            End If

            If Not (WFMaxRecordCtrl Is Nothing) Then
                WFMaxRecordCtrl.Dispose()
            End If

            If Not (VibAGBMaxRecordCtrl Is Nothing) Then
                VibAGBMaxRecordCtrl.Dispose()
            End If

            If Not (VibBlowerMaxRecordCtrl Is Nothing) Then
                VibBlowerMaxRecordCtrl.Dispose()
            End If

            If Not (VibExhaust1MaxRecordCtrl Is Nothing) Then
                VibExhaust1MaxRecordCtrl.Dispose()
            End If

            If Not (VibExhaust4MaxRecordCtrl Is Nothing) Then
                VibExhaust4MaxRecordCtrl.Dispose()
            End If

            If Not (VibDynoMaxRecordCtrl Is Nothing) Then
                VibDynoMaxRecordCtrl.Dispose()
            End If

            If Not (T45HMaxRecordCtrl Is Nothing) Then
                T45HMaxRecordCtrl.Dispose()
            End If

            If Not (TimeToGITimerCtrl Is Nothing) Then
                TimeToGITimerCtrl.Dispose()
            End If

            If Not (TimeToCDTimerCtrl Is Nothing) Then
                TimeToCDTimerCtrl.Dispose()
            End If

            If Not (AccelCheckTimerCtrl Is Nothing) Then
                AccelCheckTimerCtrl.Dispose()
            End If

            If Not (DynoPumpDriveCtrl Is Nothing) Then
                DynoPumpDriveCtrl.Dispose()
            End If

            If Not (AirStarterRampUpCtrl Is Nothing) Then
                AirStarterRampUpCtrl.Dispose()
            End If

            If Not (StarterTimerCtrl Is Nothing) Then
                StarterTimerCtrl.Dispose()
            End If

            If Not (OperatingTimerCtrl Is Nothing) Then
                OperatingTimerCtrl.Dispose()
            End If

            If Not (PersistentValuesCtrl Is Nothing) Then
                PersistentValuesCtrl.Dispose()
            End If

            If Not (TransientControl Is Nothing) Then
                TransientControl.ClearPresets()
            End If

            If Not (VX100WatchDogCtrl Is Nothing) Then
                VX100WatchDogCtrl.Dispose()
            End If

            FlowmeterCtrl.Dispose()

        End Sub

        Protected Overrides Sub OnTestSessionClosing(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionClosing(newStatus)
                'For All Engine
                If TestProgressMgr IsNot Nothing Then
                    TestProgress_Save(True)
                    TestProgressMgr.Dispose()
                    TestProgressMgr = Nothing
                    If Process.GetProcessesByName("proc_incoming").Length > 0 Then
                        For Each curProcess As Process In Process.GetProcessesByName("proc_incoming")
                            curProcess.Kill()
                        Next
                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionClosing: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

