            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreateCELTestReportsFile: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreateCELTestReportsFile = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(sheetIndex).Protect(ProtectPassword)

            End Try

        End Function

        Private Function GetNewestFileName(searchPath As String, searchFileName As String) As String
            Dim dirs As String() = Directory.GetFiles(searchPath, searchFileName)

            Array.Sort(dirs)

            If dirs.Length > 0 Then
                GetNewestFileName = dirs(dirs.GetUpperBound(0))
            Else
                GetNewestFileName = ""
            End If
        End Function


        '*****************************
        '* TestProgress_Initialize() *
        '*****************************
        Private Sub TestProgress_Initialize()
            Dim dataInfo As CEL.TestProgress.TestProgressMgr.TestProgress_DataInfo = Nothing

            dataInfo.EngineStartEventChannelName = "IGNITION_BTN"
            dataInfo.EngineStartEventChannelValue = True
            dataInfo.EngineStartEventDescription = "Ignition Activated"
            dataInfo.EngineStartEventRecordTime = True
            dataInfo.EngineStopEventChannelName = "ENGINE_AT_REST"
            dataInfo.EngineStopEventChannelValue = True
            dataInfo.EngineStopEventDescription = "Engine At Rest - Rundown Time (s):"
            dataInfo.EngineStopEventRecordTime = True
            '            dataInfo.TestProgressFrameName = CELProject.EngineModel.Replace("-", "_") + "_Screen.fraTestProgressHorizontal"
            dataInfo.TestProgressFrameName = "T53_Master_Screen.fraTestProgressHorizontal"

            Dim newFileName = CELProject.EngineSession.LogFolder + "TestProgress " + Format(Now, "yyyy-MM-dd HH'h'mm'm'ss's'")

            dataInfo.TestProgressSheetFileName = GetNewestFileName(CELProject.EngineSession.LogFolder, "TestProgress*.xml")
            If dataInfo.TestProgressSheetFileName = "" Then
                dataInfo.TestProgressSheetFileName = newFileName + ".xml"
            End If

            dataInfo.TestProgressTextFileName = GetNewestFileName(CELProject.EngineSession.LogFolder, "TestProgress*.txt")
            If dataInfo.TestProgressTextFileName = "" Then
                dataInfo.TestProgressTextFileName = newFileName + ".txt"
            End If

            dataInfo.UUTModel = CELProject.EngineModel

            dataInfo.UUTSerialNumber = Me.UserInputs.EngineSerialNumber
            dataInfo.UUTWorkOrder = Me.UserInputs.WorkOrder

            Me.TestProgressMgr = New CEL.TestProgress.TestProgressMgr(dataInfo)
        End Sub

        '*****************************************
        '* TestProgress_RecordPerfStep_Generic() *
        '*****************************************

        Private Sub TestProgress_RecordPerfStep_Generic()

            Dim sheetEntry As CEL.TestProgress.TestProgressSheetEntry = Nothing

            Dim TextString As String = cmbTestStepList.SelectedItem & " performance point taken"

            sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(Now.ToString(), TextString)

            If sheetEntry IsNot Nothing Then
                Me.TestProgressMgr.AddTestProgressEntry(sheetEntry)
            End If

        End Sub

        '*********************************
        '* TestProgress_RecordPerfStep() *
        '*********************************

        Private Sub TestProgress_RecordPerfStep()

            If Me.TestProgressMgr IsNot Nothing Then

                TestProgress_RecordPerfStep_Generic()

            End If
        End Sub

        '***********************
        '* TestProgress_Save() *
        '***********************

        Private Sub TestProgress_Save(closing As Boolean)
            If Not Me.TestProgressMgr Is Nothing Then
                TestProgress_UpdateProgressSheetHeader(Me.TestProgressMgr.TestProgressSheet)
                '                Dim fileName As String = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
                Dim fileName As String = Me.TestProgressMgr.DataInfo.TestProgressSheetFileName
                Dim settings As Xml.XmlWriterSettings = New Xml.XmlWriterSettings()
                settings.Indent = True

                Using writer As Xml.XmlWriter = Xml.XmlWriter.Create(fileName, settings)
                    Dim xslPath As String = "type=""text/xsl"" href=""" + Application.StartupPath + "/TestProgressSheet.xsl"""
                    writer.WriteProcessingInstruction("xml-stylesheet", xslPath)
                    Dim ser As New Xml.Serialization.XmlSerializer(GetType(CEL.TestProgress.TestProgressSheet))
                    ser.Serialize(writer, Me.TestProgressMgr.TestProgressSheet)
                End Using

                fileName = TestProgressMgr.DataInfo.TestProgressTextFileName
                If Not System.IO.File.Exists(fileName) Then
                    Dim fs As FileStream = System.IO.File.Create(fileName)
                    fs.Close()
                End If
                Dim txtWriter As New System.IO.StreamWriter(fileName)

                txtWriter.Write(TestProgressMgr.TestProgressText)

                If closing Then
                    txtWriter.WriteLine()
                    txtWriter.WriteLine("Operating time : " + OPERATING_TIME_HHMMSS_OPC.Value.ToString)
                    txtWriter.WriteLine("Nb Engine Start : " + NB_ENGINE_START_OPC.Value.ToString)
                    txtWriter.WriteLine()
                    txtWriter.WriteLine("----- End Of Engine Run ----------------------------------------------------------")
                End If

                txtWriter.Close()
            End If
        End Sub

        '********************************************
        '* TestProgress_UpdateProgressSheetHeader() *
        '********************************************

        Private Sub TestProgress_UpdateProgressSheetHeader(progressSheet As CEL.TestProgress.TestProgressSheet)

            Dim runningTime As System.TimeSpan = System.TimeSpan.FromSeconds(Me.OPERATING_TIME_SEC.Value.ToDouble())
            progressSheet.Header("Operating Time") = OPERATING_TIME_HHMMSS_OPC.Value.ToString


        End Sub

        Private HumidityGrainsPerPoundChart(,) As Integer = {{0, 30, 40, 50, 60, 70, 80, 90, 100},
                                                             {10, 3, 4, 6, 8, 11, 16, 21, 29},
                                                             {20, 5, 7, 10, 16, 21, 30, 42, 58},
                                                             {30, 7, 11, 14, 22, 34, 46, 65, 87},
                                                             {40, 9, 14, 20, 30, 44, 62, 85, 116},
                                                             {50, 12, 18, 26, 39, 55, 78, 108, 147},
                                                             {60, 14, 22, 32, 48, 66, 92, 128, 176},
                                                             {70, 17, 26, 38, 54, 78, 108, 152, 208},
                                                             {80, 19, 29, 42, 62, 88, 125, 173, 0},
                                                             {90, 21, 33, 48, 70, 100, 140, 190, 0}}

        Private Function HumidityInterpolate(pLimite1 As Double, pLimite2 As Double, pInterpolationPoint As Double, pValue1 As Double, pValue2 As Double) As Double

            Return pValue1 + (pValue2 - pValue1) * (pInterpolationPoint - pLimite1) / (pLimite2 - pLimite1)
        End Function

        Private Function CalculateAbsHumidity(relativeHumidity As Double, temperatureFahrenheit As Double) As Double
            If relativeHumidity < 10.0 Then
                relativeHumidity = 10
            End If
            If relativeHumidity > 90.0 Then
                relativeHumidity = 90
            End If
            If temperatureFahrenheit < 30.0 Then
                temperatureFahrenheit = 30
            End If
            If temperatureFahrenheit > 100.0 Then
                temperatureFahrenheit = 100
            End If

            Dim i As Integer
            Dim j As Integer

            For i = 1 To 9
                If relativeHumidity <= HumidityGrainsPerPoundChart(i, 0) Then
                    For j = 1 To 8
                        If temperatureFahrenheit <= HumidityGrainsPerPoundChart(0, j) Then
                            Dim LowPoint1 As Double = HumidityGrainsPerPoundChart(i - 1, j - 1)
                            Dim HighPoint1 As Double = HumidityGrainsPerPoundChart(i, j - 1)
                            Dim LowPoint2 As Double = HumidityGrainsPerPoundChart(i - 1, j)
                            Dim HighPoint2 As Double = HumidityGrainsPerPoundChart(i, j)
                            Dim interPolation1 = HumidityInterpolate(HumidityGrainsPerPoundChart(i - 1, 0), HumidityGrainsPerPoundChart(i, 0), relativeHumidity, LowPoint1, HighPoint1)
                            Dim interPolation2 = HumidityInterpolate(HumidityGrainsPerPoundChart(i - 1, 0), HumidityGrainsPerPoundChart(i, 0), relativeHumidity, LowPoint2, HighPoint2)

                            Return HumidityInterpolate(HumidityGrainsPerPoundChart(0, j - 1), HumidityGrainsPerPoundChart(0, j), temperatureFahrenheit, interPolation1, interPolation2)
                        End If
                    Next
                End If
            Next
            Return 0
        End Function

