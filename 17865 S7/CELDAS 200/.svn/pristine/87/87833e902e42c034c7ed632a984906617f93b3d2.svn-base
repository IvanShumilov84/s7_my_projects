        Private Sub OnVANE_BEGIN_TO_OPEN_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    N1_PCT_VANES_BEGIN_TO_OPEN.Value = New KineticaRT.Values.Double(N1_PCT.Value.ToDouble)
                    N1_RPM_VANES_BEGIN_TO_OPEN.Value = New KineticaRT.Values.Double(N1_RPM.Value.ToDouble)
                    WF_AVG_COMP_PPH_BEGIN_TO_OPEN.Value = New KineticaRT.Values.Double(WF_AVG_COMP_PPH.Value.ToDouble)
                    T_INLET_AVG_DEGR_BEGIN_TO_OPEN.Value = New KineticaRT.Values.Double(T_INLET_AVG_DEGF.Value.ToDouble)

                    N1_PCT_VANES_FULLY_OPEN.Value = Values.Zero
                    N1_RPM_VANES_FULLY_OPEN.Value = Values.Zero
                    WF_AVG_COMP_PPH_FULLY_OPEN.Value = Values.Zero
                    T_INLET_AVG_DEGR_FULLY_OPEN.Value = Values.Zero

                    N1_PCT_VANES_BEGIN_TO_CLOSE.Value = Values.Zero
                    N1_RPM_VANES_BEGIN_TO_CLOSE.Value = Values.Zero
                    WF_AVG_COMP_PPH_BEGIN_TO_CLOSE.Value = Values.Zero
                    T_INLET_AVG_DEGR_BEGIN_TO_CLOSE.Value = Values.Zero

                    N1_PCT_VANES_FULLY_CLOSED.Value = Values.Zero
                    N1_RPM_VANES_FULLY_CLOSED.Value = Values.Zero
                    WF_AVG_COMP_PPH_FULLY_CLOSED.Value = Values.Zero
                    T_INLET_AVG_DEGR_FULLY_CLOSED.Value = Values.Zero

                    N1_PCT_VANES_BEGIN_TO_OPEN_AGAIN.Value = Values.Zero
                    N1_RPM_VANES_BEGIN_TO_OPEN_AGAIN.Value = Values.Zero
                    WF_AVG_COMP_PPH_BEGIN_TO_OPEN_AGAIN.Value = Values.Zero
                    T_INLET_AVG_DEGR_BEGIN_TO_OPEN_AGAIN.Value = Values.Zero

                    IGV_TEST_BEGIN_TO_OPEN_FULLY_CLOSED_IND.Value = Values.False
                    IGV_TEST_BEGIN_TO_OPEN_BEGIN_TO_OPEN_AGAIN_IND.Value = Values.False

                    N1_PCT_VANES_BEGIN_TO_OPEN_FULLY_CLOSED_DIFF.Value = New KineticaRT.Values.Double(99.0)
                    N1_PCT_VANES_BEGIN_TO_OPEN_BEGIN_TO_OPEN_AGAIN_DIFF.Value = New KineticaRT.Values.Double(99.0)
                    N1_RPM_VANES_BEGIN_TO_OPEN_FULLY_CLOSED_DIFF.Value = New KineticaRT.Values.Double(99.0)
                    N1_RPM_VANES_BEGIN_TO_OPEN_BEGIN_TO_OPEN_AGAIN_DIFF.Value = New KineticaRT.Values.Double(99.0)
                    WF_AVG_COMP_PPH_BEGIN_TO_OPEN_FULLY_CLOSED_DIFF.Value = New KineticaRT.Values.Double(99.0)
                    WF_AVG_COMP_PPH_BEGIN_TO_OPEN_BEGIN_TO_OPEN_AGAIN_DIFF.Value = New KineticaRT.Values.Double(99.0)
                    T_INLET_AVG_DEGR_BEGIN_TO_OPEN_FULLY_CLOSED_DIFF.Value = New KineticaRT.Values.Double(99.0)
                    T_INLET_AVG_DEGR_BEGIN_TO_OPEN_BEGIN_TO_OPEN_AGAIN_DIFF.Value = New KineticaRT.Values.Double(99.0)

                    VANE_BEGIN_TO_OPEN_BTN.Value = Values.False

                End If

            Catch ex As Exception
                MessageBox.Show("T53_Sequence: OnVANE_BEGIN_TO_OPEN_BTN: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Private Sub OnVANE_FULLY_OPEN_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    N1_PCT_VANES_FULLY_OPEN.Value = New KineticaRT.Values.Double(N1_PCT.Value.ToDouble)
                    N1_RPM_VANES_FULLY_OPEN.Value = New KineticaRT.Values.Double(N1_RPM.Value.ToDouble)
                    WF_AVG_COMP_PPH_FULLY_OPEN.Value = New KineticaRT.Values.Double(WF_AVG_COMP_PPH.Value.ToDouble)
