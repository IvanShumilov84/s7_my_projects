        Private Sub OnStoreMaxMinAngleBtn(ByVal sender As IChannel, ByVal newVal As Value)
            Dim angle As String = "0.0"
            Dim msgName As String = ""

            Try
                If CELProject.IsTrue(newVal) Then
                    If sender Is IGV_STORE_MAX_ANGLE_BTN Then
                        IGV_MAX_RIG_POS.Value = IGV_POS.Value
                        IGV_MAX_POS_DONE.Value = Values.True
                    ElseIf sender Is IGV_STORE_MIN_ANGLE_BTN Then
                        IGV_MIN_RIG_POS.Value = IGV_POS.Value
                        IGV_MIN_POS_DONE.Value = Values.True
                    Else
                        MessageBox.Show("T53_Sequence.OnStoreMaxMinAngleBtn: " & vbCrLf & vbCrLf & _
                                        "Unexpected sender", _
                                        "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Return
                    End If

                End If
            Catch ex As Exception
                MessageBox.Show("T53_Sequence.OnStoreMaxMinAngleBtn: " & vbCrLf & vbCrLf & _
                                "Error message: " & vbCrLf & ex.ToString, _
                                "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally
                sender.Value = Values.False
            End Try

        End Sub

        Private Sub OnComputeBtn(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    If (IGV_MAX_RIG_POS.Value.ToDouble - IGV_MIN_RIG_POS.Value.ToDouble) <> 0.0 Then
                        IGV_SLOPE.Value = New KineticaRT.Values.Double((IGV_MAX_ANGLE.Value.ToDouble - IGV_MIN_ANGLE.Value.ToDouble) _
                                                                     / (IGV_MAX_RIG_POS.Value.ToDouble - IGV_MIN_RIG_POS.Value.ToDouble))
                        IGV_OFFSET.Value = New KineticaRT.Values.Double(IGV_MAX_ANGLE.Value.ToDouble - IGV_SLOPE.Value.ToDouble * IGV_MAX_RIG_POS.Value.ToDouble)
                        IGV_RIGGING_DONE.Value = Values.True
                        IGV_COMPUTE_DONE.Value = Values.True
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("T53_Sequence.OnComputeBtn: " & vbCrLf & vbCrLf & _
                                "Error message: " & vbCrLf & ex.ToString, _
                                "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally
                sender.Value = Values.False
            End Try
        End Sub

        Private Sub OnResetBtn(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    IGV_RIGGING_DONE.Value = Values.False
                    IGV_MIN_POS_DONE.Value = Values.False
                    IGV_MAX_POS_DONE.Value = Values.False
                    IGV_COMPUTE_DONE.Value = Values.False
                End If
            Catch ex As Exception
                MessageBox.Show("T53_Sequence.OnResetBtn: " & vbCrLf & vbCrLf & _
                                "Error message: " & vbCrLf & ex.ToString, _
                                "UNEXPECTED ERROR", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally
                sender.Value = Values.False
            End Try
        End Sub

        Protected Overrides Sub OnDYNO_DEMAND_VALIDATE(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If sender.Name = "DYNO_POS_DEMAND" Then
                    If DYNO_POS_DEMAND.Value.ToDouble() > 100 Then
                        DYNO_POS_DEMAND.Value = New KineticaRT.Values.Double(100)
                    ElseIf DYNO_POS_DEMAND.Value.ToDouble() < 0 Then
                        DYNO_POS_DEMAND.Value = Values.Zero
                    End If
                ElseIf sender.Name = "DYNO_SPEED_DEMAND" Then
                    If DYNO_SPEED_DEMAND.Value.ToDouble() > 22224 Then
                        DYNO_SPEED_DEMAND.Value = New KineticaRT.Values.Double(22224)
                    ElseIf DYNO_SPEED_DEMAND.Value.ToDouble() < 0 Then
                        DYNO_SPEED_DEMAND.Value = Values.Zero
                    End If
                ElseIf sender.Name = "DYNO_TORQUE_DEMAND" Then
                    If DYNO_TORQUE_DEMAND.Value.ToDouble() > 700 Then
                        DYNO_TORQUE_DEMAND.Value = New KineticaRT.Values.Double(700)
                    ElseIf DYNO_TORQUE_DEMAND.Value.ToDouble() < 0 Then
                        DYNO_TORQUE_DEMAND.Value = Values.Zero
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("T53_Sequence: OnDYNO_DEMAND_VALIDATE: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnDYNO_INLET_VALIDATE(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If DYNO_SET_INLET_PCT.Value.ToDouble() > 100 Then
                    DYNO_SET_INLET_PCT.Value = New KineticaRT.Values.Double(100)
                ElseIf DYNO_SET_INLET_PCT.Value.ToDouble() < 0 Then
                    DYNO_SET_INLET_PCT.Value = Values.Zero
                End If
            Catch ex As Exception
                MessageBox.Show("T53_Sequence: OnDYNO_INLET_VALIDATE: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

