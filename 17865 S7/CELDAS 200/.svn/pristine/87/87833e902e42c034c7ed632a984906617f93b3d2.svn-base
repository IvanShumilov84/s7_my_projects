        Protected Overrides Sub Init_Engine_Controls()
            MyBase.InitializeObject(TransientControl, CELProject.EngineFamily + "_Slave_Screen.T53_DRP_PLOT.transientControl")

            MyBase.InitializeObject(T53_DRP_PLOT, CELProject.EngineFamily + "_Slave_Screen.T53_DRP_PLOT")

