        Private Sub OnT_INLET_AVG_DEGF(ByVal sender As IChannel, ByVal newVal As Value)
            '                   Private BLEED_BAND_CLOSED_RANGE As KineticaRT.Channels.TextChannel


            Dim lowLimit As Double = T_INLET_AVG_DEGF.Value.ToDouble * 0.073529412 + 70.44117647
            Dim highLimit As Double = T_INLET_AVG_DEGF.Value.ToDouble * 0.076470588 + 73.05882353

            BLEED_BAND_CLOSED_RANGE.Value = New Global.KineticaRT.Values.Text(lowLimit.ToString("F0") + "% < N1 < " + highLimit.ToString("F0") + "%")

        End Sub

        Private Sub OnBLEED_BAND_CLOSED_TEST_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    CELProject.LogPerfSynch.UpdateValues()
                    FlowmeterCtrl.ComputeFlow(True)
                    CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, True, CELProject.EngineModel, True)

                    N1_THROTTLE_DEG_BLEED_BAND_CLOSED_TEST.Value = New KineticaRT.Values.Double(N1_THROTTLE_DEG.Value.ToDouble)
                    N1_PCT_BLEED_BAND_CLOSED_TEST.Value = New KineticaRT.Values.Double(N1_PCT.Value.ToDouble)
                    N2_PCT_BLEED_BAND_CLOSED_TEST.Value = New KineticaRT.Values.Double(N2_PCT.Value.ToDouble)
                    WF_AVG_COMP_PPH_BLEED_BAND_CLOSED_TEST.Value = New KineticaRT.Values.Double(WF_AVG_COMP_PPH.Value.ToDouble)
                    T_INLET_AVG_DEGF_BLEED_BAND_CLOSED_TEST.Value = New KineticaRT.Values.Double(T_INLET_AVG_DEGF.Value.ToDouble)
                    P_PS4_PSIG_BLEED_BAND_CLOSED_TEST.Value = New KineticaRT.Values.Double(P_PS4_PSIG.Value.ToDouble)

                    P_FUEL_INLET_PSIG_BLEED_BAND_CLOSED_TEST.Value = New KineticaRT.Values.Double(P_FUEL_INLET_PSIG.Value.ToDouble)
                    P_OIL_FILTER_OUTLET_PRESSURE_BLEED_BAND_CLOSED_TEST.Value = New KineticaRT.Values.Double(P_OIL_FILTER_OUTLET_PRESSURE.Value.ToDouble)
                    T_ENGINE_OIL_DEGF_BAND_CLOSED_TEST.Value = New KineticaRT.Values.Double(T_ENGINE_OIL_DEGF.Value.ToDouble)
                    T_OIL_PUMP_INLET_BLEED_BAND_CLOSED_TEST.Value = New KineticaRT.Values.Double(T_OIL_PUMP_INLET.Value.ToDouble)
                    T_NO_2_BEARING_SCAVENGE_OIL_DEGF_BLEED_BAND_CLOSED_TEST.Value = New KineticaRT.Values.Double(T_NO_2_BEARING_SCAVENGE_OIL_DEGF.Value.ToDouble)
                    T_POWER_TURBINE_SCAVENGE_OIL_DEGF_BLEED_BAND_CLOSED_TEST.Value = New KineticaRT.Values.Double(T_POWER_TURBINE_SCAVENGE_OIL_DEGF.Value.ToDouble)

                    Dim SearchPath As String

                    SearchPath = CELProject.EngineSession.PerfFolder
                    Dim StandardCELTemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile

                    CELProject.ProcessPerformanceReport(SearchPath, StandardCELTemplateReportFullFileName, AddressOf bleedBandClosedSaveFullReading)

                    BLEED_BAND_CLOSED_TEST_BTN.Value = Values.False
                End If
            Catch ex As Exception
                MessageBox.Show("T53_Sequence: OnBLEED_BAND_CLOSED_TEST_BTN: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Function bleedBandClosedSaveFullReading(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            '           Dim Column As Integer
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet
            Dim sheetIndex As Integer

            bleedBandClosedSaveFullReading = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            Try
                sheetIndex = excelSheets.Item("Bleed Band Closure Check").Index()
                excelWorkbook.Worksheets(sheetIndex).Unprotect(UnProtectPassword)

                excelWorksheet = excelSheets.Item("Bleed Band Closure Check")

                TakeFullReading(excelWorksheet, 39)

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("bleedBandClosedSaveFullReading: " + ex.Message)
                MessageBox.Show(ex.ToString)
                bleedBandClosedSaveFullReading = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(sheetIndex).Protect(ProtectPassword)

            End Try

        End Function

