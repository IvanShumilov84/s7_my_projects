        Protected Overrides Sub OnEngineWorkingThread()

            TimeToGITimerCtrl.Timer()
            TimeToCDTimerCtrl.Timer()
            If Not (OperatingTimerCtrl Is Nothing) Then
                OperatingTimerCtrl.Timer()
            End If
            StopWatchTimerCtrl.Timer()

            DynoPumpDriveCtrl.OnSpeedChanged()

            VX100WatchDogCtrl.WatchdogElapsedHandler()

            '            ABS_HUMIDITY.Value = New KineticaRT.Values.Double(CalculateAbsHumidity(TC_HUMIDITY.Value.ToDouble(), T_CELL_DEGF.Value.ToDouble()))

            If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then
                If CInt(OPERATING_TIME_SEC.Value.ToDouble()) - OperatingTimeSec >= 1 Or
                   CInt(OPERATING_TIME_SEC.Value.ToDouble()) - OperatingTimeSec < -1 Then ' Will be negatif if counter was reseted to 0
                    OperatingTimeSec = OPERATING_TIME_SEC.Value.ToDouble()
                    OPERATING_TIME_HHMMSS_OPC.Value = OPERATING_TIME_HHMMSS.Value
                End If
            End If

            'Persistent Values Save Check
            If Not (PersistentValuesCtrl Is Nothing) Then
                PersistentValuesCtrl.SavePersistentValues(False)
                '               FUEL_USED_LITERS_OPC.Value = New KineticaRT.Values.Double(FUEL_USED_LITERS.Value.ToDouble)
                '               FUEL_USED_TOTAL_LITERS_OPC.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble)
            End If
        End Sub

