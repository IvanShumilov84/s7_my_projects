                Return_Value.Add(MyBase.InitializeChannel(VIB_FRONT_95_973_VIBRATION_TEST, "VIB_FRONT_95_973_VIBRATION_TEST"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_FRONT_95_973_VIBRATION_TEST_IND, "VIB_FRONT_95_973_VIBRATION_TEST_IND"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_POWER_TURBINE_85_973_VIBRATION_TEST, "VIB_POWER_TURBINE_85_973_VIBRATION_TEST"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_POWER_TURBINE_85_973_VIBRATION_TEST_IND, "VIB_POWER_TURBINE_85_973_VIBRATION_TEST_IND"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_POWER_TURBINE_90_1004_VIBRATION_TEST, "VIB_POWER_TURBINE_90_1004_VIBRATION_TEST"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_POWER_TURBINE_90_1004_VIBRATION_TEST_IND, "VIB_POWER_TURBINE_90_1004_VIBRATION_TEST_IND"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_POWER_TURBINE_90_948_VIBRATION_TEST, "VIB_POWER_TURBINE_90_948_VIBRATION_TEST"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_POWER_TURBINE_90_948_VIBRATION_TEST_IND, "VIB_POWER_TURBINE_90_948_VIBRATION_TEST_IND"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_POWER_TURBINE_90_973_VIBRATION_TEST, "VIB_POWER_TURBINE_90_973_VIBRATION_TEST"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_POWER_TURBINE_90_973_VIBRATION_TEST_IND, "VIB_POWER_TURBINE_90_973_VIBRATION_TEST_IND"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_POWER_TURBINE_95_973_VIBRATION_TEST, "VIB_POWER_TURBINE_95_973_VIBRATION_TEST"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_POWER_TURBINE_95_973_VIBRATION_TEST_IND, "VIB_POWER_TURBINE_95_973_VIBRATION_TEST_IND"))

            Catch ex As Exception
                MessageBox.Show("T53_Sequence:Init_Engine_Channels: " & ex.Message)
                Return_Value.Add(False)
            Finally

            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If

            If Return_Value.Contains(False) Then
                Return False
            Else
                Return True
            End If
        End Function

        '*********************
        '* ProcessDRPInputs  *
        '*********************
        Private Sub ProcessDRPInputs()
            'Dim Cmd 						As OleDbCommand
            'Dim ConnectionString 			As String
            Dim i As Integer
            '            Dim j As Integer
            Dim Now_Day As String
            Dim Now_Hour As String
            Dim Now_Minute As String
            Dim Now_Month As String
            Dim Now_Second As String
            Dim Now_Year As String
            'Dim Reader 						As OleDbDataReader
            'Dim SelectString 				As String
            Dim TestNumber As String
            'Dim TestSession_Connection 		As OleDbConnection
            Dim Var1 As String
            Dim Var2 As KineticaRT.Channels.Channel

            Try

                If Now.Day < 10 Then
                    Now_Day = "0" + Now.Day.ToString
                Else
                    Now_Day = Now.Day.ToString
                End If
                If Now.Hour < 10 Then
                    Now_Hour = "0" + Now.Hour.ToString
                Else
                    Now_Hour = Now.Hour.ToString
                End If
                If Now.Minute < 10 Then
                    Now_Minute = "0" + Now.Minute.ToString
                Else
                    Now_Minute = Now.Minute.ToString
                End If
                If Now.Month < 10 Then
                    Now_Month = "0" + Now.Month.ToString
                Else
                    Now_Month = Now.Month.ToString
                End If
                If Now.Second < 10 Then
                    Now_Second = "0" + Now.Second.ToString
                Else
                    Now_Second = Now.Second.ToString
                End If
                Now_Year = Now.Year.ToString.Substring(2)

                TestNumber = CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
                TestNumber = TestNumber.Substring(3) + "000"

                'Header
                DRPInputs(0) = "LOCATE   TEI"
                DRPInputs(1) = "CELL     002"
                DRPInputs(2) = "ESN      " + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
                DRPInputs(3) = "RDG      " + CONDITION_NUMBER.Value.ToString
                DRPInputs(4) = "TDATE    " + Now_Month + Now_Day + Now_Year
                DRPInputs(5) = "TESTNO   " + TestNumber
                DRPInputs(6) = "TTIME    " + Now_Hour + Now_Minute + Now_Second

                i = 7

                For Each Parameter As String In Custom_Parameters.Keys
                    'Remove 3 first characters that are the index and pad right for a total of 9 characters.
                    Var1 = Parameter.Substring(3).PadRight(9, " ")
                    'For j = Var1.Length To 9
                    '    Var1 = Var1 + " "
                    'Next
                    Var2 = GetChannel(Custom_Parameters(Parameter))
                    If Var2 Is Nothing Then
                        clsTopMostMessageBox.Show("Performance_Sequence : ProcessDRPInputs()" & " Can't retrieve channel Value used for performance parameter = " & Parameter, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    End If
                    If Var2.Value.ToString = "NaN" Then
                        DRPInputs(i) = Var1 + "-99999"
                    Else
                        DRPInputs(i) = Var1 + Var2.Value.ToString
                    End If
                    i = i + 1
                Next

                ''Connect to the TestSession Database
                'ConnectionString = "Provider=Microsoft.Jet.OLEDB.4.0; Data Source=" + TestSession_DatabaseName + ";Jet OLEDB:System database=" + TestSession_DatabaseWorkgroup + "; User ID=" + TestSession_DatabaseUserID + "; Password=" + TestSession_DatabasePassword

                'If OpenConnection(ConnectionString, TestSession_Connection) Then

                '    SelectString = "SELECT * FROM DRPInputList WHERE [Engine_Model] = " + Chr(39) + Test_Mgr_UUT_Model.ToString() + Chr(39)
                '    Cmd = New OleDbCommand(SelectString, TestSession_Connection)
                '    Reader = Cmd.ExecuteReader()

                '    While (Reader.Read())
                '        Var1 = Reader.Item("Parameter").ToString()
                '        For j = Var1.Length To 9
                '            Var1 = Var1 + " "
                '        Next
                '        Var2 = GetChannel(Reader.Item("Variable").ToString())
                '        If Var2 Is Nothing Then
                '            MessageBox.Show("ERROR: Log Variable creation is Nothing")
                '        End If
                '        DRPInputs(i) = Var1 + Var2.Value.ToString
                '        i = i + 1
                '    End While
                '    Reader.Close()

                '    CloseConnection(TestSession_Connection)
                'End If

            Catch ex As Exception
                clsTopMostMessageBox.Show("Performance_Sequence : ProcessDRPInputs()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        '********************************************************************
        '* Handlers *********************************************************
        '********************************************************************

        '*****************************************
        '* OnPERF_PERFORMANCE_REPORT_VIEW_BTN()  *
        '*****************************************
        Protected Sub OnPERF_PERFORMANCE_REPORT_VIEW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If (CELProject.IsTrue(newVal)) Then

                    TestProgress_Save(False)

                    Dim fileName As String
                    Dim File_Dialog As New OpenFileDialog()

                    File_Dialog.Reset()
                    File_Dialog.Filter = "Production Reports|T53 Performance*.xlsx"
                    File_Dialog.FilterIndex = 1

                    File_Dialog.Title = "View Production Reports"
                    File_Dialog.InitialDirectory = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(1).Value.ToString() + "\Reports"

                    If File_Dialog.ShowDialog() = DialogResult.OK Then
                        fileName = File_Dialog.FileName
                    Else
                        fileName = ""
                    End If

                    If fileName <> "" Then
                        If File.Exists(fileName) Then

                            Try
                                Process.Start(fileName)
                            Catch ex As Exception
                                MessageBox.Show("T53_Sequence: OnPERF_PERFORMANCE_REPORT_VIEW_BTN Process.Start: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            End Try

                        End If
                    End If

                End If
            Catch ex As Exception
                MessageBox.Show("T53_Sequence: OnPERF_PERFORMANCE_REPORT_VIEW_BTN: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
            PERF_PERFORMANCE_REPORT_VIEW_BTN.Value = Values.False
        End Sub

        Protected Sub OnPERF_TAKE_TEST_DATA_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            Dim NewFileCreated As Boolean
            Dim SearchPath As String
            Dim excelWorkbook As Excel.Workbook = Nothing

            Try
                If CELProject.IsTrue(newVal) Then
                    Dim pleaseWait As New PleaseWaitForm("Please wait while saving data...")
                    pleaseWait.Show()

                    SearchPath = CELProject.EngineSession.PerfFolder
                    Dim StandardCELTemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile

                    NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, StandardCELTemplateReportFullFileName, AddressOf CreateCELTestReportsFile)

                    CELProject.LogPerfSynch.UpdateValues()
                    FlowmeterCtrl.ComputeFlow(True)
                    CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, True, CELProject.EngineModel, NewFileCreated)

                    pleaseWait.Hide()
                End If

            Catch ex As Exception
                MessageBox.Show("OnPERF_TAKE_TEST_DATA_BTN: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally
                PERF_TAKE_TEST_DATA_BTN.Value = Values.False
            End Try
        End Sub

        Private Sub WritePerformanceHeader(ByRef excelWorksheet As Excel.Worksheet, ByVal col1 As Integer, ByVal col2 As Integer)

            'HEADER
            'Customer
            excelWorksheet.Cells(5, col1).Value = UserInputs.CustomerName

            'Work Order
            excelWorksheet.Cells(6, col1).Value = UserInputs.WorkOrder

            'Part Number
            excelWorksheet.Cells(7, col1).Value = UserInputs.PartNumber

            'Serial Number
            excelWorksheet.Cells(8, col1).Value = UserInputs.EngineSerialNumber

            'Test type
            excelWorksheet.Cells(9, col1).Value = UserInputs.TestType

            'Tester
            excelWorksheet.Cells(10, col1).Value = UserInputs.Inspector

            'Date
            excelWorksheet.Cells(5, col2).Value = Format(Now, "d MMMM yyyy")

            'Sample Fuel SG
            excelWorksheet.Cells(6, col2).Value = UserInputs.SampleFuelSG

            'Sample Fuel T
            excelWorksheet.Cells(7, col2).Value = UserInputs.SampleFuelTemp

            'Fuel Type
            excelWorksheet.Cells(8, col2).Value = UserInputs.FuelType

            'Manual rev
            excelWorksheet.Cells(9, col2).Value = UserInputs.ManualRev

            'Operator
            excelWorksheet.Cells(10, col2).Value = UserInputs.OperatorName
        End Sub

        Private Sub WriteReportCellContent(ByRef excelWorksheet As Excel.Worksheet, ByVal data As INumericChannel, ByVal result As IBooleanChannel, ByVal ligne As Integer, ByVal dataColumn As Integer, ByVal resultColumn As Integer)
            '            excelWorksheet.Cells(ligne, 6).NumberFormat = "General"
            excelWorksheet.Cells(ligne, dataColumn).Value = data.Value.ToString(data.Format, Nothing)

            'WF status
            '            excelWorksheet.Cells(ligne, 7).NumberFormat = "General"
            '           excelWorksheet.Cells(ligne, 7).Font.Name = "WingDings"
            '          excelWorksheet.Cells(ligne, 7).Font.Bold = True
            '            excelWorksheet.Cells(ligne, 7).Font.Size = 18

            If CELProject.IsTrue(result.Value) Then
                excelWorksheet.Cells(ligne, resultColumn).Font.Color = Drawing.Color.Green
                excelWorksheet.Cells(ligne, resultColumn).Formula = "=CHAR(252)" ' Check
            Else
                excelWorksheet.Cells(ligne, resultColumn).Font.Color = Drawing.Color.Red
                excelWorksheet.Cells(ligne, resultColumn).Formula = "=CHAR(251)" ' X
            End If
        End Sub

