        '***************************
        '* OnDYNO_VALIDATE_MODE() *
        '***************************
        Private Sub OnDYNO_VALIDATE_MODE(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    If DYNO_REMOTE_CONTROL_IND.Value.ToDouble() = 1.0 And DYNO_VALVE_STATUS_IND.Value = KineticaRT.Values.Values.True And ENGINE_AT_REST.Value = KineticaRT.Values.Values.True Then
                        DYNO_POS_DEMAND.Value = New KineticaRT.Values.Double(100)
                        Thread.Sleep(250)
                        DYNO_POS_MODE_BTN.Value = KineticaRT.Values.Values.True
                        CELDAS.NotifyIcon.ShowBalloonTip(3000, CELProject.TechnologyName, "Dynamometer set to 22224 RPM in SPEED mode. Please confirm on controller.", ToolTipIcon.Info)
                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("T53_Sequence: OnDYNO_VALIDATE_MODE: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub


        Private Sub OnN1_RPMChanged(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then
                    If CELProject.IsTrue(IGNITION_DEMAND_OPC.Value) And N1_RPM.Value > 15000 And CELProject.IsFalse(NB_ENGINE_START_INCREMENT_DONE.Value) Then
                        NB_ENGINE_START.Value = New KineticaRT.Values.Double(NB_ENGINE_START.Value.ToDouble + 1.0)
                        NB_ENGINE_START_OPC.Value = NB_ENGINE_START.Value
                        NB_ENGINE_START_INCREMENT_DONE.Value = Values.True
                    End If
                    If N1_RPM.Value < 100 And CELProject.IsTrue(NB_ENGINE_START_INCREMENT_DONE.Value) Then
                        NB_ENGINE_START_INCREMENT_DONE.Value = Values.False
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("T53_Sequence: OnN1_RPMChanged: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Private Sub OnAIR_STARTER(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    ARCHIVE_RECORD_BTN.Value = KineticaRT.Values.Values.True
                    STARTER_BTN_PRESSED.Value = Values.True
                Else
                    STARTER_BTN_PRESSED.Value = Values.False
                End If
                STARTER_DEMAND_OPC.Value = STARTER_BTN_PRESSED.Value
            Catch ex As Exception
                MessageBox.Show("T53_Sequence: OnAIR_STARTER: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

