                        N1_PCT_95_973_VIBRATION_TEST_IND.Value = Values.False
                    End If
                    If N2_PCT.Value.ToDouble >= 97.2 And N2_PCT.Value.ToDouble <= 97.4 Then
                        N2_PCT_95_973_VIBRATION_TEST_IND.Value = Values.True
                    Else
                        N2_PCT_95_973_VIBRATION_TEST_IND.Value = Values.False
                    End If
                    If VIB_FRONT_IPS.Value.ToDouble <= 1.3 Then
                        VIB_FRONT_95_973_VIBRATION_TEST_IND.Value = Values.True
                    Else
                        VIB_FRONT_95_973_VIBRATION_TEST_IND.Value = Values.False
                    End If
                    If VIB_AXIAL_IPS.Value.ToDouble <= 1.7 Then
                        VIB_AXIAL_95_973_VIBRATION_TEST_IND.Value = Values.True
                    Else
                        VIB_AXIAL_95_973_VIBRATION_TEST_IND.Value = Values.False
                    End If
                    If VIB_POWER_TURBINE_IPS.Value.ToDouble <= 1.7 Then
                        VIB_POWER_TURBINE_95_973_VIBRATION_TEST_IND.Value = Values.True
                    Else
                        VIB_POWER_TURBINE_95_973_VIBRATION_TEST_IND.Value = Values.False
                    End If

                    VIBRATION_TEST_95_973_BTN.Value = Values.False
                End If
            Catch ex As Exception
                MessageBox.Show("T53_Sequence: OnVIBRATION_TEST_95_973_BTN: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        '*******************
        '* OnAIceOpen()    *
        '*******************
        'Testing : 4-118 Anti-Icing Bleed and Start Valve Check : Record Ng and T0 at the exact moment the anti-ice light goes out.
        Private Sub OnAntiIceOpen(sender As KineticaRT.Channels.IChannel, newVal As KineticaRT.Values.Value)
            If (CELProject.IsFalse(newVal)) Then
                If ENGINE_AT_REST.Value = Values.True Then
                    Log_N1_RPM.Value = New KineticaRT.Values.Double(N1_RPM.Value.ToDouble)
                    Log_T_INLET_AVG_DEGF.Value = New KineticaRT.Values.Double(T_INLET_AVG_DEGF.Value.ToDouble)
                End If
            End If
        End Sub

        '*******************
        '* OnStopEngine() *
        '*******************
        Private Sub OnStopEngine(sender As KineticaRT.Channels.IChannel, newVal As KineticaRT.Values.Value)
            Try
                If (CELProject.IsTrue(newVal)) Then
                    STARTER_BTN.Value = Values.False
                    MAIN_FUEL_VALVE_BTN.Value = Values.False
                    STARTING_FUEL_VALVE_BTN.Value = Values.False
                    IGNITION_BTN.Value = Values.False
                    FUEL_SHUTOFF_BTN.Value = Values.False
                End If
            Catch ex As Exception
                MessageBox.Show("OnStopEngine: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnLOG_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            If CELProject.IsTrue(newVal) Then

                Dim pleaseWait As New PleaseWaitForm("Please wait while saving log data...")
                pleaseWait.Show()

                'Update the Log/Perf channel set
                CELProject.LogPerfSynch.UpdateValues()
                FlowmeterCtrl.ComputeFlow(True)
                CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, False, CELProject.EngineModel, True)
                CELProject.LOG_TAKE_POINT_BTN.Value = Values.False

                pleaseWait.Hide()

            End If
        End Sub

        Protected Overrides Sub OnNEW_TEST_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If (CELProject.IsTrue(newVal)) Then

                    If DialogResult.Yes = MessageBox.Show("Do you want to reset the fuel used, the operating time and the number of starts?", "CELDAS200", MessageBoxButtons.YesNo, MessageBoxIcon.Question) Then

                        NEW_TEST_TRIGGER_OPC.Value = Values.True

                    End If

                End If
            Catch ex As Exception
                MessageBox.Show("T53_Sequence: OnNEW_TEST_BTN: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Sub OnNEW_TEST_PROGRESS_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If (CELProject.IsTrue(newVal)) Then

                    TestProgress_Save(True)

                    Dim dataInfo As CEL.TestProgress.TestProgressMgr.TestProgress_DataInfo = TestProgressMgr.DataInfo

                    Dim testProgressSheet As CEL.TestProgress.TestProgressSheet = Nothing
                    testProgressSheet = New CEL.TestProgress.TestProgressSheet(dataInfo.UUTModel, _
                                                                           dataInfo.UUTSerialNumber, _
                                                                           dataInfo.UUTWorkOrder)
                    TestProgressMgr.InitTestProgressSheet(testProgressSheet)

                    Dim newFileName = CELProject.EngineSession.LogFolder + "TestProgress " + Format(Now, "yyyy-MM-dd HH'h'mm'm'ss's'")
                    dataInfo.TestProgressSheetFileName = newFileName + ".xml"
                    dataInfo.TestProgressTextFileName = newFileName + ".txt"
                    TestProgressMgr.DataInfo = dataInfo
                    TestProgressMgr.TestProgressText = System.Environment.NewLine + "Engine model         : " + TestProgressMgr.DataInfo.UUTModel + System.Environment.NewLine
                    TestProgressMgr.TestProgressText += "Engine serial number : " + TestProgressMgr.DataInfo.UUTSerialNumber + System.Environment.NewLine
                    TestProgressMgr.TestProgressText += "Test Cell            : 002" + System.Environment.NewLine + System.Environment.NewLine
                End If
            Catch ex As Exception
                MessageBox.Show("T53_Sequence: OnNEW_TEST_PROGRESS_BTN: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
            NEW_TEST_PROGRESS_BTN.Value = Values.False
        End Sub

        Protected Sub OnNEW_TEST_PROGRESS_VIEW_REPORT_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If (CELProject.IsTrue(newVal)) Then

                    TestProgress_Save(False)

                    Dim fileName As String
                    Dim File_Dialog As New OpenFileDialog()

                    File_Dialog.Reset()
                    File_Dialog.Filter = "TestProgress (*.xlsx)|*.txt"
                    File_Dialog.FilterIndex = 1

                    File_Dialog.Title = "View Test Progress Report"
                    File_Dialog.InitialDirectory = CELProject.EngineSession.LogFolder 'EngineFolder + "\Log\"

                    If File_Dialog.ShowDialog() = DialogResult.OK Then
                        fileName = File_Dialog.FileName
                    Else
                        fileName = ""
                    End If

                    If fileName <> "" Then
                        If File.Exists(fileName) Then

                            Try
                                Process.Start(fileName)
                            Catch ex As Exception
                                MessageBox.Show("T53_Sequence: OnNEW_TEST_PROGRESS_VIEW_REPORT_BTN Process.Start: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            End Try

                        End If
                    End If

                End If
            Catch ex As Exception
                MessageBox.Show("T53_Sequence: OnNEW_TEST_PROGRESS_VIEW_REPORT_BTN: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
            NEW_TEST_PROGRESS_VIEW_REPORT_BTN.Value = Values.False
        End Sub

        Protected Sub OnNEW_TEST_TRIGGER_OPC(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If (CELProject.IsTrue(newVal)) Then

                    OPERATING_TIME_CONDITION_RESET.Value = Values.True

                    FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                    FUEL_USED_INITIAL_KG.Value = Values.Zero
                    WF_TOT1.Value = Values.Zero
                    WF_TOT2.Value = Values.Zero
                    WF_TOT_WEIGHT1.Value = Values.Zero
                    WF_TOT_WEIGHT2.Value = Values.Zero

                    NB_ENGINE_START.Value = Values.Zero
                    NB_ENGINE_START_OPC.Value = NB_ENGINE_START.Value

                    OPERATING_TIME_CONDITION_RESET.Value = Values.False
                    NEW_TEST_TRIGGER_OPC.Value = Values.False

                End If
            Catch ex As Exception
                MessageBox.Show("T53_Sequence: OnNewTest: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub


        '********************
        '* OnCloseTest()    *
        '********************
        Protected Overrides Sub OnCLOSE_TEST_BTN(sender As IChannel, newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then


                    If CELProject.EngineFamily = "T53" Then

                        CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.OnCLOSE_TEST_BTN_DISPOSE))

                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("OnClose_Test: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        '************************
        '* OnCloseTestDispose() *
        '************************
        Private Sub OnCLOSE_TEST_BTN_DISPOSE()
            Try

                If CELProject.EngineFamily = "T53" Then

                    MyBase.StopWorkingThread()

                    'Persistent Values Force Save
                    If Not (PersistentValuesCtrl Is Nothing) Then
                        PersistentValuesCtrl.SavePersistentValues(True)
                    End If

                    RemoveHandlers()

                    Dispose_Engine_Controllers()

                End If

            Catch ex As Exception
                MessageBox.Show("OnClose_Test_Dispose: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionInitialized(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionInitialized(newStatus)

                If CELProject.EngineFamily = "T53" Then

                    UserInputs.MapUserInputsParameters(CELProject)

                    CELProject.EngineSession.WorkingFolder = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + UserInputs.EngineSerialNumber + "\" + UserInputs.WorkOrder
                    CELProject.CreateLogFile(AddressOf CreateCustomHeaderLogFile, CELProject.EngineModel, CELProject.EngineModel)

                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionInitialized: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)

            Catch ex As Exception

                MessageBox.Show("PW150_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            End Try
        End Sub

        Protected Overrides Sub OnTestSessionRunning(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionRunning(newStatus)

                If CELProject.EngineFamily = "T53" Then

                    Init_Channels()

                    Init_Engine_Controls()

                    Init_Engine_Channels()

                    Init_Engine_Channels_Value()

                    Init_Engine_Controllers()

                    AddHandlers()

                    If CELProject.HierarchyType = CELDAS.eHierarchyType.Master Then
                        HIERACHYTYPE_MASTER.Value = New KineticaRT.Values.Boolean(True)
                    Else
                        HIERACHYTYPE_MASTER.Value = New KineticaRT.Values.Boolean(False)
                    End If

                    TestProgress_Initialize()

                    MyBase.StartWorkingThread()

                    CELProject.LoadSave_Custom_Parameters(Custom_Parameters, False)

                End If
            Catch ex As Exception
                MessageBox.Show("OnTestSessionRunning: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub
