        '**************************
        '* Init_Channels()        *
        '**************************
        Private Function Init_Channels() As Boolean Implements IEngineSequence.Init_Channels
            Try
                'Dim i As Integer
                Dim Return_Value As New ArrayList()

                Return_Value.Clear()

                'Return_Value.Add(MyBase.InitializeChannel(ProjectNb, "ProjectNb")) 'TODO: Atar Renommé ProjectNb pour PROJECT_NB revoir le test session qui utilisait ce channel
                'TODO: Transférer dans Open_Test pour les éléments communs
                Return_Value.Add(MyBase.InitializeChannel(PROJECT_NB, "PROJECT_NB")) 'TODO: Atar Renommé ProjectNb pour PROJECT_NB revoir le test session qui utilisait ce channel

                'Initialise Channels
                'Return_Value.Add(MyBase.InitializeChannel(Close_Test, "Close_Test"))
                'Return_Value.Add(MyBase.InitializeChannel(Test_Mgr_Cmd, "Test_Mgr_Cmd"))
                'Return_Value.Add(MyBase.InitializeChannel(Test_Mgr_Status, "Test_Mgr_Status"))
                'For i = 0 To Test_Mgr_UUT_Answer.GetUpperBound(0) - 1
                '    Return_Value.Add(MyBase.InitializeChannel(Test_Mgr_UUT_Answer(i), "Test_Mgr_UUT_Answer" + (i + 1).ToString()))
                'Next
                'For i = 0 To Test_Mgr_UUT_Calib_Constant.GetUpperBound(0) - 1 '#v1.01# ft 2006/09/12 used to calculate Bleed air (WB)
                '    Return_Value.Add(MyBase.InitializeChannel(Test_Mgr_UUT_Calib_Constant(i), "Test_Mgr_UUT_Calib_Constant" + (i + 1).ToString()))
                'Next
                'For i = 0 To Test_Mgr_UUT_Choice.GetUpperBound(0) - 1
                '    Return_Value.Add(MyBase.InitializeChannel(Test_Mgr_UUT_Choice(i), "Test_Mgr_UUT_Choice" + (i + 1).ToString()))
                'Next
                'Return_Value.Add(MyBase.InitializeChannel(Test_Mgr_UUT_Model, "Test_Mgr_UUT_Model"))
                'For i = 0 To Test_Mgr_UUT_Option.GetUpperBound(0) - 1
                '    Return_Value.Add(MyBase.InitializeChannel(Test_Mgr_UUT_Option(i), "Test_Mgr_UUT_Option" + (i + 1).ToString()))
                'Next

                'Initialise Object
                'For i = 0 To WINDOW_NAME.GetUpperBound(0)
                '    Return_Value.Add(MyBase.InitializeObject(EngineWindow(i), WINDOW_NAME(i)))
                'Next
                'CELProject.InitializeEngineWindows()

                If Return_Value.Contains(False) Then
                    Return False
                Else
                    Return True
                End If

            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: ATAR_09C_Sequence: Init_Channels()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.ToString())
            End Try
        End Function


        '**************************
        '* Init_Engine_Channels() *
        '**************************
        Private Function Init_Engine_Channels() As Boolean Implements IEngineSequence.Init_Engine_Channels
            Try
                'Dim i				As Integer
                Dim Return_Value As New ArrayList()

                Return_Value.Clear()


                If CELProject.Test_Mgr_UUT_Model.Value.ToString() = "ATAR 09C" Then


                    Return_Value.Add(MyBase.InitializeObject(Master_Engine_Window, CELProject.Test_Mgr_UUT_Model.Value.ToString().Replace("-", "_").Replace(" ", "_") + "_Screen"))
                    Master_Engine_Window.WindowState = FormWindowState.Normal
                    Master_Engine_Window.Left = 0
                    Master_Engine_Window.Top = 0
                    Master_Engine_Window.ClientSize = New System.Drawing.Size(2560, 959)

                    Return_Value.Add(MyBase.InitializeChannel(CLOSE_SPARES_BUTTON, "CLOSE_SPARES_BUTTON"))
                    Return_Value.Add(MyBase.InitializeChannel(CLOSE_RIGGING_BUTTON, "CLOSE_RIGGING_BUTTON"))
                    Return_Value.Add(MyBase.InitializeChannel(SPARES_BUTTON, "SPARES_BUTTON"))
                    Return_Value.Add(MyBase.InitializeChannel(Galil_MinSlope, "Galil_MinSlope"))

                    'Return_Value.Add(MyBase.InitializeObject(Control_Frame, Test_Mgr_UUT_Model.Value.ToString() + "_Screen.GenericButtonFrame"))
                    Return_Value.Add(MyBase.InitializeObject(Control_Frame, Me.EngineModel + "_Screen.GenericButtonFrame"))

                    btnArchive = Control_Frame.FindObject("Archive_Button")
                    If btnArchive Is Nothing Then
                        MessageBox.Show("Initialize_Object - Archive_Button Is Nothing")
                        Return_Value.Add(False)
                    Else
                        Return_Value.Add(True)
                    End If

                End If


                Init_Engine_Channels = Not Return_Value.Contains(False)

            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: ATAR_09C_Sequence: Init_Engine_Channels()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.ToString())
            End Try
        End Function


        '****************************
        '* OnClose_Spares_Button()  *
        '****************************
        Private Sub OnClose_Spares_Button(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                If (CELProject.IsTrue(newVal)) Then
                    CELProject.ActivateForm("Spares_Screen", CELProject.Test_Mgr_UUT_Model.Value.ToString() + "_Screen", False, False)
                End If

                CLOSE_SPARES_BUTTON.Value = KineticaRT.Values.Values.False

            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: OpenTest: OnClose_Spares_Button()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.ToString())
            End Try
        End Sub

        '****************************
        '* OnClose_Rigging_Button()  *
        '****************************
        Private Sub OnClose_Rigging_Button(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                If (CELProject.IsTrue(newVal)) Then
                    CELProject.ActivateForm("Throttle_Calib", CELProject.Test_Mgr_UUT_Model.Value.ToString() + "_Screen", False, False)
                End If

                CLOSE_RIGGING_BUTTON.Value = KineticaRT.Values.Values.False

            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: OpenTest: OnClose_Rigging_Button()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.ToString())
            End Try
        End Sub

