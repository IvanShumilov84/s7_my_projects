        '********************************************************************
        '* Public Methods ***************************************************
        '********************************************************************
#Region "Connect / Disconnect"
        '***********
        '* Connect *
        '***********
        Public Overloads Overrides Sub Connect()
            Try
                If Me.Connected = False Then
                    MyBase.Connect()

                    'PROJECT_NUMBER = System.Configuration.ConfigurationSettings.AppSettings("ProjectNo")


                    'Verify the connection to the channels
                    If Init_Channels() = False Then
                        MessageBox.Show(Me.GetType.FullName + ".Connect() - missing channels")
                        Return
                    End If

                    'TODO: Transférer dans open_test
                    PROJECT_NB.Value = New KineticaRT.Values.Text(CELProject.Project.Number)

                    'TODO retirer le OnTest_MNgr_Status
                    'AddHandler Test_Mgr_Status.ValueChanged, AddressOf OnTest_Mgr_Status


                    Me.Connected = True
                End If

            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: ATAR_09C_Sequence: Connect()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.ToString())
                Me.Connected = False
            End Try
        End Sub

        '**************
        '* Disconnect *
        '**************
        Public Overloads Overrides Sub Disconnect()
            Try
                If Me.Connected Then
                    'RemoveHandler Test_Mgr_Status.ValueChanged, AddressOf OnTest_Mgr_Status

                    MyBase.Disconnect()
                    Me.Connected = False
                End If

            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: ATAR_09C_Sequence: Disconnect()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.ToString())
            End Try
        End Sub

#End Region


        '*************************
        '* OnTestSessionIdling() *
        '*************************
        Protected Overrides Sub OnTestSessionIdling(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try

                MyBase.OnTestSessionIdling(newStatus)

            Catch ex As Exception
                MessageBox.Show("OnTestSessionIdling: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub
        '******************************
        '* OnTestSessionInitialized() *
        '******************************
        Protected Overrides Sub OnTestSessionInitialized(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                Me.EngineModel = CELProject.Test_Mgr_UUT_Model.Value.ToString().Replace(" ", "_")


                MyBase.OnTestSessionInitialized(newStatus)

            Catch ex As Exception
                MessageBox.Show("OnTestSessionInitialized: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub


        '**************************
        '* OnTestSessionRunning() *
        '**************************
        Protected Overrides Sub OnTestSessionRunning(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try

                Select Case EngineModel
                    'Not For "DAS CALIBRATION"
                    Case "ATAR_09C"

                        'Me.EngineWindow(0).BeginInvoke(New MethodInvoker(AddressOf Me.Init_Controls))
                        CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.Init_Controls))

                        If (Init_Engine_Channels()) Then
                            If (Init_Engine_Channels_Value()) Then
                                AddHandlers()
                                'CELProject.Open_HMI(Test_Mgr_UUT_Model.Value.ToString())
                            End If
                        End If

                End Select

                MyBase.OnTestSessionRunning(newStatus)

            Catch ex As Exception
                MessageBox.Show("OnTestSessionRunning: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try

        End Sub
        '**************************
        '* OnTestSessionClosing() *
        '**************************
        Protected Overrides Sub OnTestSessionClosing(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try

                Select Case EngineModel
                    Case "ATAR_09C"
                        Init_Engine_Channels_Value() 'Reinit variables before we quit
                        RemoveHandlers()
                End Select

                MyBase.OnTestSessionClosing(newStatus)
                'Restore default Culture Info
                System.Threading.Thread.CurrentThread.CurrentCulture = OldCultureInfo
            Catch ex As Exception
                MessageBox.Show("OnTestSessionClosing: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub
        '********************************
        '* Initialize_Engine_Controls() *
        '********************************
        Private Function Init_Controls() As Boolean Implements IEngineSequence.Init_Controls


            Try

                Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()

                    Case "ATAR 09C"

                End Select

            Catch ex As Exception

            End Try
            Return True
        End Function
        Private Function AddHandlers() As Boolean Implements IEngineSequence.AddHandlers

            AddHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnClose_Test
            AddHandler CLOSE_SPARES_BUTTON.ValueChanged, AddressOf OnClose_Spares_Button
            AddHandler CLOSE_RIGGING_BUTTON.ValueChanged, AddressOf OnClose_Rigging_Button
            AddHandler SPARES_BUTTON.ValueChanged, AddressOf OnSpares_Button

        End Function
        Private Function RemoveHandlers() As Boolean Implements IEngineSequence.RemoveHandlers

            RemoveHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnClose_Test
            RemoveHandler CLOSE_SPARES_BUTTON.ValueChanged, AddressOf OnClose_Spares_Button
            RemoveHandler CLOSE_RIGGING_BUTTON.ValueChanged, AddressOf OnClose_Rigging_Button
            RemoveHandler SPARES_BUTTON.ValueChanged, AddressOf OnSpares_Button

        End Function


