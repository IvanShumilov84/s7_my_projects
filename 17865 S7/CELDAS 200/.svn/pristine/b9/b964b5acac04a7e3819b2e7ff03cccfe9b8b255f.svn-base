        '********************
        '* OnCloseTest()    *
        '********************					
        Private Sub OnClose_Test(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                If (CELProject.IsTrue(newVal)) Then
                    CELProject.Test_Mgr_Cmd.Value = New KineticaRT.Values.Text(CELDAS.eTest_Mgr_Cmd.Close)

                    sender.Value = KineticaRT.Values.Values.False
                End If

            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: OpenTest: OnClose_Test()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.ToString())
            End Try
        End Sub


