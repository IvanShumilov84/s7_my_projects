                        excelWorksheet.Cells(36, 9).Value = COUNTER_FINAL_START_CYCLES.Value.ToString(COUNTER_FINAL_START_CYCLES.Format, Nothing)

                        excelWorksheet = excelSheets.Item("ACCEPTANCE")

                        'Test Result
                        If CELProject.IsTrue(PERF_TEST_RESULT_ACCEPTED.Value) Then
                            excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                        Else
                            excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                        End If

                        If CELProject.IsTrue(PERF_TEST_RESULT_REJECTED.Value) Then
                            excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                        Else
                            excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                        End If

                End Select
                TestProgress_RecordPerfStepC2C3C7(TestStepNumber)
            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreateStandardCELPerformanceFileC2C3C7: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreateStandardCELPerformanceFileC2C3C7 = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)

            End Try

        End Function

        Private Function CreateStandardCELPerformanceFileC12(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreateStandardCELPerformanceFileC12 = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            Try
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    excelWorksheet = excelSheets.Item("SUMMARY")

                    'HEADER

                    'UUT Model APU TEST DATA SHEET
                    excelWorksheet.Cells(1, 3).NumberFormat = "@"
                    excelWorksheet.Cells(1, 3).Value = CELProject.EngineModel & " APU TEST DATA SHEET"

                    'Serial Number
                    excelWorksheet.Cells(5, 3).NumberFormat = "@"
                    excelWorksheet.Cells(5, 3).Value = UserInputs.EngineSerialNumber

                    'Word Order
                    excelWorksheet.Cells(6, 3).NumberFormat = "@"
                    excelWorksheet.Cells(6, 3).Value = UserInputs.WorkOrder

                    'FADEC Serial Number
                    excelWorksheet.Cells(7, 3).NumberFormat = "@"
                    excelWorksheet.Cells(7, 3).Value = UserInputs.ECBSerialNumber

                    'Exhaust Duct Serial Number
                    excelWorksheet.Cells(8, 3).NumberFormat = "@"
                    excelWorksheet.Cells(8, 3).Value = UserInputs.ExhaustDuctSerialNumber

                    'Bellmouth Serial Number
                    excelWorksheet.Cells(9, 3).NumberFormat = "@"
                    excelWorksheet.Cells(9, 3).Value = UserInputs.BellmouthSerialNumber

                    'Bleed Duct Serial Number
                    excelWorksheet.Cells(10, 3).NumberFormat = "@"
                    excelWorksheet.Cells(10, 3).Value = UserInputs.BleedDuctSerialNumber

                    'Starter Serial Number
                    excelWorksheet.Cells(11, 3).NumberFormat = "@"
                    excelWorksheet.Cells(11, 3).Value = UserInputs.StarterSerialNumber

                    'Dyno Serial Number
                    excelWorksheet.Cells(12, 3).NumberFormat = "@"
                    excelWorksheet.Cells(12, 3).Value = UserInputs.DynoSerialNumber

                    'Engine Vibration Pickup Serial Number
                    excelWorksheet.Cells(5, 8).NumberFormat = "@"
                    excelWorksheet.Cells(5, 8).Value = UserInputs.EngineVibrationPickupSerialNumber

                    'Oil Type
                    excelWorksheet.Cells(6, 8).NumberFormat = "@"
                    excelWorksheet.Cells(6, 8).Value = UserInputs.OilType

                    'TSN
                    excelWorksheet.Cells(7, 8).NumberFormat = "@"
                    excelWorksheet.Cells(7, 8).Value = UserInputs.TSN

                    'CSN
                    excelWorksheet.Cells(8, 8).NumberFormat = "@"
                    excelWorksheet.Cells(8, 8).Value = UserInputs.CSN

                    'Reason
                    excelWorksheet.Cells(9, 8).NumberFormat = "@"
                    excelWorksheet.Cells(9, 8).Value = UserInputs.Reason

                    'Test Type
                    excelWorksheet.Cells(10, 8).NumberFormat = "@"
                    excelWorksheet.Cells(10, 8).Value = UserInputs.TestType

                    'Load Cell Serial Number
                    excelWorksheet.Cells(11, 8).NumberFormat = "@"
                    excelWorksheet.Cells(11, 8).Value = UserInputs.LoadCellSerialNumber

                    'Date
                    excelWorksheet.Cells(12, 8).NumberFormat = "@"
                    excelWorksheet.Cells(12, 8).Value = Format(Now, "d MMMM yyyy")

                    excelWorksheet = excelSheets.Item("ACCEPTANCE")

                    'Document Number
                    excelWorksheet.Cells(43, 4).NumberFormat = "@"
                    excelWorksheet.Cells(43, 4).Value = Custom_Parameters("APUTestedAccordingTo").ToString()

                End If

                Select Case TestStepNumber

                    Case eTestStepAPS1000C12.NO_LOAD

                        excelWorksheet = excelSheets.Item("DETAILS")

                        excelWorksheet.Cells(16, 7).Value = LOG_PERF_VIB_ENGINE_G.Value.ToString(LOG_PERF_VIB_ENGINE_G.Format, Nothing)
                        'La cellule 17 est cachée pour que les valeurs du C2/C3/C7 et C12 dans les rapports soient au meme endroit
                        excelWorksheet.Cells(18, 7).Value = LOG_PERF_T_CELL_DEGF.Value.ToString(LOG_PERF_T_CELL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(19, 7).Value = LOG_PERF_T_INLET_AVG_DEGF.Value.ToString(LOG_PERF_T_INLET_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(20, 7).Value = LOG_PERF_T_BLEED_DEGF.Value.ToString(LOG_PERF_T_BLEED_DEGF.Format, Nothing)
                        excelWorksheet.Cells(21, 7).Value = LOG_PERF_T_EGT_P_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_P_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(22, 7).Value = LOG_PERF_T_EGT_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(23, 7).Value = LOG_PERF_T_OIL_SUMP_DEGF.Value.ToString(LOG_PERF_T_OIL_SUMP_DEGF.Format, Nothing)
                        excelWorksheet.Cells(24, 7).Value = LOG_PERF_N1_RPM.Value.ToString(LOG_PERF_N1_RPM.Format, Nothing)
                        excelWorksheet.Cells(25, 7).Value = LOG_PERF_P_BARO_PSIA.Value.ToString(LOG_PERF_P_BARO_PSIA.Format, Nothing)
                        excelWorksheet.Cells(26, 7).Value = LOG_PERF_P_CD_PSIG.Value.ToString(LOG_PERF_P_CD_PSIG.Format, Nothing)
                        excelWorksheet.Cells(27, 7).Value = LOG_PERF_P_ORIFICE_PSIA.Value.ToString(LOG_PERF_P_ORIFICE_PSIA.Format, Nothing)
                        excelWorksheet.Cells(28, 7).Value = LOG_PERF_P_ORIFICE_DELTA_INH20D.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_INH20D.Format, Nothing)
                        excelWorksheet.Cells(29, 7).Value = LOG_PERF_P_EXHAUST_PSIA.Value.ToString(LOG_PERF_P_EXHAUST_PSIA.Format, Nothing)
                        excelWorksheet.Cells(30, 7).Value = LOG_PERF_P_FUEL_BOOST_PSIG.Value.ToString(LOG_PERF_P_FUEL_BOOST_PSIG.Format, Nothing)
                        excelWorksheet.Cells(31, 7).Value = LOG_PERF_P_GB_VENT_PSIA.Value.ToString(LOG_PERF_P_GB_VENT_PSIA.Format, Nothing)
                        excelWorksheet.Cells(32, 7).Value = LOG_PERF_P_OIL_PSIG.Value.ToString(LOG_PERF_P_OIL_PSIG.Format, Nothing)
