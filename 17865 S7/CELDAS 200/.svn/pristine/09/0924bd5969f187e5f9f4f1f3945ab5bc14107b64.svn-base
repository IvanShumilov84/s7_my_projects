                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WB_COR_PPM, "LOG_PERF_WB_COR_PPM"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WF_PPH, "LOG_PERF_WF_PPH"))
                        Return_Value.Add(MyBase.InitializeChannel(LOUVERS_IND, "LOUVERS_IND"))
                        Return_Value.Add(MyBase.InitializeChannel(N1_RPM_MEAN, "N1_RPM_MEAN"))
                        Return_Value.Add(MyBase.InitializeChannel(NUMBER_OF_STARTS, "NUMBER_OF_STARTS"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_TEST_RESULT_ACCEPTED, "PERF_TEST_RESULT_ACCEPTED"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_TEST_RESULT_REJECTED, "PERF_TEST_RESULT_REJECTED"))
                        Return_Value.Add(MyBase.InitializeChannel(P_ORIFICE_PSIA, "P_ORIFICE_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(P_ORIFICE_DELTA_PSID, "P_ORIFICE_DELTA_PSID"))
                        Return_Value.Add(MyBase.InitializeChannel(P_ORIFICE_DELTA_PSID_MEAN, "P_ORIFICE_DELTA_PSID_MEAN"))
                        Return_Value.Add(MyBase.InitializeChannel(P_ORIFICE_PSIA_MEAN, "P_ORIFICE_PSIA_MEAN"))
                        Return_Value.Add(MyBase.InitializeChannel(READY_TO_LOAD_IND, "READY_TO_LOAD_IND"))
                        Return_Value.Add(MyBase.InitializeChannel(SAS_INHIBIT_BLEED_OFF_BTN, "SAS_INHIBIT_BLEED_OFF_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(SMART_TERMINAL_BTN, "SMART_TERMINAL_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(STARTER_RECTIFIER_BTN, "STARTER_RECTIFIER_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(STOP_BTN, "STOP_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(T_EGT_MAX_START_DEGF, "T_EGT_MAX_START_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(T_ORIFICE_DEGF, "T_ORIFICE_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(VIB_ENGINE_G, "VIB_ENGINE_G"))
                        Return_Value.Add(MyBase.InitializeChannel(WB_CALC_PPM, "WB_CALC_PPM"))
                        Return_Value.Add(MyBase.InitializeChannel(WB_PPM_MEAN, "WB_PPM_MEAN"))

                        If CELProject.EngineModel = "APS1000-C12" Then
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_CD_PSIG, "LOG_PERF_P_CD_PSIG"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_EGT_P_AVG_DEGF, "LOG_PERF_T_EGT_P_AVG_DEGF"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_EGT_AVG_COR_DEGF, "LOG_PERF_T_EGT_AVG_COR_DEGF"))
                        Else
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_CD_PSIA, "LOG_PERF_P_CD_PSIA"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_CD_COR_PSIA, "LOG_PERF_P_CD_COR_PSIA"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_CD_COR_CALCULATION_PSIA, "LOG_PERF_P_CD_COR_CALCULATION_PSIA"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WB_COR_CALCULATION_PPM, "LOG_PERF_WB_COR_CALCULATION_PPM"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_EGT_P1_DEGF, "LOG_PERF_T_EGT_P1_DEGF"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_VIB_GEARBOX_G, "LOG_PERF_VIB_GEARBOX_G"))
                            Return_Value.Add(MyBase.InitializeChannel(SURGE_BTN, "SURGE_BTN"))
                            Return_Value.Add(MyBase.InitializeChannel(VIB_GEARBOX_G, "VIB_GEARBOX_G"))
                        End If

                        Return_Value.Add(MyBase.InitializeChannel(OPERATING_TIME_CURRENT_SEC, "OPERATING_TIME_CURRENT_SEC"))

                End Select
            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.ToString())
                Return_Value.Add(False)
            Finally

            End Try

            If Return_Value.Contains(False) Then
                Return False
            End If
            Return True

        End Function

        Private Sub TestProgress_Initialize()
            Dim dataInfo As CEL.TestProgress.TestProgressMgr.TestProgress_DataInfo

            dataInfo.EngineStartEventChannelName = "START_BTN"
            dataInfo.EngineStartEventChannelValue = True
            dataInfo.EngineStartEventDescription = "Mise en route"
            dataInfo.EngineStartEventRecordTime = True
            dataInfo.EngineStopEventChannelName = "STOP_BTN"
            dataInfo.EngineStopEventChannelValue = True
            dataInfo.EngineStopEventDescription = "Arrêt moteur - Temps d'arrêt (s): "
            dataInfo.EngineStopEventRecordTime = True
            dataInfo.TestProgressFrameName = CELProject.EngineFamily.Replace("-", "_") + "_Screen.fraTestProgressHorizontal"
            dataInfo.TestProgressSheetFileName = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
            dataInfo.UUTModel = CELProject.EngineModel
            dataInfo.UUTSerialNumber = Me.UserInputs.EngineSerialNumber
            dataInfo.UUTWorkOrder = Me.UserInputs.WorkOrder
            Me.TestProgressMgr = New CEL.TestProgress.TestProgressMgr(dataInfo)
        End Sub

        Private Sub TestProgress_RecordPerfStepC2C3C7(testStep As eTestStepAPS1000C2C3C7)
            If Me.TestProgressMgr IsNot Nothing Then
                Dim sheetEntry As CEL.TestProgress.TestProgressSheetEntry = Nothing

                Dim checkItemPCDCOR As String = "Corrected Compressor Discharge Pressure - Min: " + _
                    Me.LOG_PERF_P_CD_COR_CALCULATION_PSIA.Value.ToString(Me.LOG_PERF_P_CD_COR_CALCULATION_PSIA.Format, Nothing) + " Read: " + _
                    Me.LOG_PERF_P_CD_COR_PSIA.Value.ToString(Me.LOG_PERF_P_CD_COR_PSIA.Format, Nothing) + " PSIA"
                Dim checkItemWBCOR As String = "Corrected Bleed Air Flow - Min: " + _
                    Me.LOG_PERF_WB_COR_CALCULATION_PPM.Value.ToString(LOG_PERF_WB_COR_CALCULATION_PPM.Format, Nothing) + " Read: " + _
                    Me.LOG_PERF_WB_COR_PPM.Value.ToString(LOG_PERF_WB_COR_PPM.Format, Nothing) + " PPM"
                Dim checkItemEGT As String = "Exhaust Gas Temperature - Max: " + _
                    Me.LOG_PERF_T_EGT_CALCULATION_DEGF.Value.ToString(LOG_PERF_T_EGT_CALCULATION_DEGF.Format, Nothing) + " Read: " + _
                    Me.LOG_PERF_T_EGT_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_AVG_DEGF.Format, Nothing) + " °F"

                Select Case testStep
                    Case eTestStepAPS1000C2C3C7.BLEED_FLOW
                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Bleed Flow Only", {checkItemPCDCOR, checkItemWBCOR})
                    Case eTestStepAPS1000C2C3C7.SHAFT_POWER
                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Shaft Power Only", {checkItemEGT})
                End Select

                If sheetEntry IsNot Nothing Then
                    Me.TestProgressMgr.AddTestProgressEntry(sheetEntry)
                End If
            End If
        End Sub

        Private Sub TestProgress_RecordPerfStepC12(testStep As eTestStepAPS1000C12)
            If Me.TestProgressMgr IsNot Nothing Then
                Dim sheetEntry As CEL.TestProgress.TestProgressSheetEntry = Nothing

                Dim checkItemEGT As String = "Exhaust Gas Temperature - Max: " + _
                    Me.LOG_PERF_T_EGT_CALCULATION_DEGF.Value.ToString(LOG_PERF_T_EGT_CALCULATION_DEGF.Format, Nothing) + " Read: " + _
                    Me.LOG_PERF_T_EGT_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_AVG_DEGF.Format, Nothing) + " °F"

                Select Case testStep
                    Case eTestStepAPS1000C12.COMBINED_LOAD
                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Combined Load", {checkItemEGT})
                End Select

                If sheetEntry IsNot Nothing Then
                    Me.TestProgressMgr.AddTestProgressEntry(sheetEntry)
                End If
            End If
        End Sub

        Private Sub TestProgress_Save()
            If Not Me.TestProgressMgr Is Nothing Then
                TestProgress_UpdateProgressSheetHeader(Me.TestProgressMgr.TestProgressSheet)
                Dim fileName As String = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
                Dim settings As Xml.XmlWriterSettings = New Xml.XmlWriterSettings()
                settings.Indent = True

                Using writer As Xml.XmlWriter = Xml.XmlWriter.Create(fileName, settings)
                    Dim xslPath As String = "type=""text/xsl"" href=""" + Application.StartupPath + "/TestProgressSheet.xsl"""
                    writer.WriteProcessingInstruction("xml-stylesheet", xslPath)
                    Dim ser As New Xml.Serialization.XmlSerializer(GetType(CEL.TestProgress.TestProgressSheet))
                    ser.Serialize(writer, Me.TestProgressMgr.TestProgressSheet)
                End Using
            End If
        End Sub

        Private Sub TestProgress_UpdateProgressSheetHeader(progressSheet As CEL.TestProgress.TestProgressSheet)
            progressSheet.Header("No capteur de vibration moteur") = Me.UserInputs.EngineVibrationPickupSerialNumber
            progressSheet.Header("No capteur de vibration accessoire") = Me.UserInputs.GearboxVibrationPickupSerialNumber
            progressSheet.Header("No Capt. frein") = Me.UserInputs.LoadCellSerialNumber
            progressSheet.Header("Type d'huile") = Me.UserInputs.OilType
            progressSheet.Header("Quantité totale Jet A1") = Me.FUEL_USED_TOTAL_LITERS.Value.ToString()
            Dim runningTime As System.TimeSpan = System.TimeSpan.FromSeconds(Me.OPERATING_TIME_CURRENT_SEC.Value.ToDouble())
            progressSheet.Header("Temps de fonctionnement") = Math.Floor(runningTime.TotalHours).ToString() + _
                " h " + runningTime.Minutes.ToString("00")
        End Sub

