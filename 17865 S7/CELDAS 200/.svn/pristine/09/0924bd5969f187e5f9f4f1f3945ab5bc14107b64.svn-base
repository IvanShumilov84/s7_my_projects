                        excelWorksheet.Cells(16, 8).Value = LOG_PERF_VIB_ENGINE_G.Value.ToString(LOG_PERF_VIB_ENGINE_G.Format, Nothing)
                        'La cellule 17 est cachée pour que les valeurs du C2/C3/C7 et C12 dans les rapports soient au meme endroit
                        excelWorksheet.Cells(18, 8).Value = LOG_PERF_T_CELL_DEGF.Value.ToString(LOG_PERF_T_CELL_DEGF.Format, Nothing)
