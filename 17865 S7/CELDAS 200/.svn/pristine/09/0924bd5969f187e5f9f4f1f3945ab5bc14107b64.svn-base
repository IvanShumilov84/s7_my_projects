                        excelWorksheet.Cells(20, 7).Value = LOG_PERF_T_INLET_AVG_DEGF.Value.ToString(LOG_PERF_T_INLET_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(21, 7).Value = LOG_PERF_T_BLEED_DEGF.Value.ToString(LOG_PERF_T_BLEED_DEGF.Format, Nothing)
                        excelWorksheet.Cells(22, 7).Value = LOG_PERF_T_EGT_P1_DEGF.Value.ToString(LOG_PERF_T_EGT_P1_DEGF.Format, Nothing)
                        excelWorksheet.Cells(23, 7).Value = LOG_PERF_T_EGT_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_AVG_DEGF.Format, Nothing)
