                        excelWorksheet.Cells(20, 8).Value = LOG_PERF_T_BLEED_DEGF.Value.ToString(LOG_PERF_T_BLEED_DEGF.Format, Nothing)
                        excelWorksheet.Cells(21, 8).Value = LOG_PERF_T_EGT_P_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_P_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(22, 8).Value = LOG_PERF_T_EGT_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(23, 8).Value = LOG_PERF_T_OIL_SUMP_DEGF.Value.ToString(LOG_PERF_T_OIL_SUMP_DEGF.Format, Nothing)
                        excelWorksheet.Cells(24, 8).Value = LOG_PERF_N1_RPM.Value.ToString(LOG_PERF_N1_RPM.Format, Nothing)
                        excelWorksheet.Cells(25, 8).Value = LOG_PERF_P_BARO_PSIA.Value.ToString(LOG_PERF_P_BARO_PSIA.Format, Nothing)
                        excelWorksheet.Cells(26, 8).Value = LOG_PERF_P_CD_PSIG.Value.ToString(LOG_PERF_P_CD_PSIG.Format, Nothing)
                        excelWorksheet.Cells(27, 8).Value = LOG_PERF_P_ORIFICE_PSIA.Value.ToString(LOG_PERF_P_ORIFICE_PSIA.Format, Nothing)
                        excelWorksheet.Cells(28, 8).Value = LOG_PERF_P_ORIFICE_DELTA_INH20D.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_INH20D.Format, Nothing)
                        excelWorksheet.Cells(29, 8).Value = LOG_PERF_P_EXHAUST_PSIA.Value.ToString(LOG_PERF_P_EXHAUST_PSIA.Format, Nothing)
                        excelWorksheet.Cells(30, 8).Value = LOG_PERF_P_FUEL_BOOST_PSIG.Value.ToString(LOG_PERF_P_FUEL_BOOST_PSIG.Format, Nothing)
                        excelWorksheet.Cells(31, 8).Value = LOG_PERF_P_GB_VENT_PSIA.Value.ToString(LOG_PERF_P_GB_VENT_PSIA.Format, Nothing)
                        excelWorksheet.Cells(32, 8).Value = LOG_PERF_P_OIL_PSIG.Value.ToString(LOG_PERF_P_OIL_PSIG.Format, Nothing)
                        'excelWorksheet.Cells(33, 8).Value = LOG_PERF_OUTPUT_POWER_KW.Value.ToString(LOG_PERF_OUTPUT_POWER_KW.Format, Nothing)
                        excelWorksheet.Cells(34, 8).Value = LOG_PERF_WB_PPM.Value.ToString(LOG_PERF_WB_PPM.Format, Nothing)
                        excelWorksheet.Cells(35, 8).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)
                        excelWorksheet.Cells(36, 8).Value = LOG_PERF_T_FUEL_DEGF.Value.ToString(LOG_PERF_T_FUEL_DEGF.Format, Nothing)

                    Case eTestStepAPS1000C12.SHAFT_POWER

