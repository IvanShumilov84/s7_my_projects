                        excelWorksheet.Cells(29, 7).Value = LOG_PERF_P_ORIFICE_DELTA_INH20D.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_INH20D.Format, Nothing)
                        excelWorksheet.Cells(30, 7).Value = LOG_PERF_P_EXHAUST_PSIA.Value.ToString(LOG_PERF_P_EXHAUST_PSIA.Format, Nothing)
                        excelWorksheet.Cells(31, 7).Value = LOG_PERF_P_FUEL_BOOST_PSIG.Value.ToString(LOG_PERF_P_FUEL_BOOST_PSIG.Format, Nothing)
