    Public Class PWC83000_Sequence
        Inherits CEL.KineticaRT.Sequence.Sequence

        Private CELProject As CELDAS = CELDAS.Instance()

        Private Const sPWCConfigurationPath As String = "C:\Program Files\Pratt & Whitney Canada\PWC83000\configuration\"
        Private Const sDataPath As String = "C:\Program Files\Pratt & Whitney Canada\PWC83000\data\"
        Private Const sConfigurationPath As String = ".\PWC\PWC83000_configuration\" ' "C:\My Projects\CELDAS 200\HMI\PWC\PWC83000_configuration\" 
        Private Const sPWCdllInstallationPath As String = "C:\Program Files\Pratt & Whitney Canada\Pwc83000"

        'Variable de Test permettant de simuler du data, A METTRE A FALSE EN RELEASE VERSION
        Private Const pwcPerformanceTestMode As Boolean = False

        ''' <summary>
        ''' Determines if the PWC 83000 DLL is correctly installed in the system
        ''' </summary>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Public Function IsPWC83000Installed() As Boolean
            If Directory.Exists(sPWCdllInstallationPath) = True Then
                IsPWC83000Installed = True
            Else
                IsPWC83000Installed = False
            End If
        End Function


        Private Sub CopyConfigurationFiles()
            Dim files As String() = Directory.GetFiles(sPWCConfigurationPath)
            Dim baseFileName, fileName As String

            If Directory.Exists(sConfigurationPath) = True Then
                Directory.Delete(sConfigurationPath, True)
            End If

            Directory.CreateDirectory(sConfigurationPath)

            For Each fileName In files
                baseFileName = Path.GetFileName(fileName)
                File.Copy(fileName, sConfigurationPath + baseFileName)
            Next
        End Sub

        Private Sub CreateDataPath()
            'Vérifie s'il existe un Datapath, autrement il est créé
            Try
                If Directory.Exists(sDataPath) = False Then
                    Directory.CreateDirectory(sDataPath)
                    clsTopMostMessageBox.Show("DataPath doesn't exist and has been Created : ", sDataPath, MessageBoxButtons.OK, MessageBoxIcon.Error)
                End If

            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : DataPath Error !" & vbCrLf & vbCrLf & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                clsTopMostMessageBox.Show("Please Create folder: ", sDataPath, MessageBoxButtons.OK, MessageBoxIcon.Error)
                Exit Sub
            End Try

        End Sub

        Protected Overrides Sub OnEngineWorkingThread()
            'DoNothing
        End Sub

        Private Function CreateHandler() As Boolean
            Try

                If CELProject.EngineFamily = "PW100" Then

                    ' Process performance button
                    AddHandler PERF_RUN_BTN.ValueChanged, AddressOf OnBTN_PERFORMANCE_RUN
                    AddHandler PERF_RESET_BTN.ValueChanged, AddressOf OnBTN_PERFORMANCE_RESET
                    AddHandler PERF_50PC_TORQUE_TRIM_BTN.ValueChanged, AddressOf OnBTN_50PC_TORQUE_TRIM
                    AddHandler PERF_CLEAR_TORQUE_TRIM_BTN.ValueChanged, AddressOf OnBTN_CLEAR_TORQUE_TRIM
                    AddHandler PERF_TO_TORQUE_TRIM_BTN.ValueChanged, AddressOf OnBTN_TO_TORQUE_TRIM
                    AddHandler PERF_TORQUE_TRIM_BTN.ValueChanged, AddressOf OnBTN_TORQUE_TRIM

                    'Rating Analysing
                    AddHandler RATING_WINDOW_BTN.ValueChanged, AddressOf OnRATING_WINDOW_BTN
                    AddHandler RATING_FILE1.ValueChanged, AddressOf OnRATING_OPEN_WINDOW_BTN
                    AddHandler RATING_FILE2.ValueChanged, AddressOf OnRATING_OPEN_WINDOW_BTN
                    AddHandler RATING_FILE3.ValueChanged, AddressOf OnRATING_OPEN_WINDOW_BTN
                    AddHandler SLAVE_RATING_CLOSE_BTN.ValueChanged, AddressOf OnRATING_CLOSE_WINDOW_BTN
                    AddHandler cboFileRating.SelectedIndexChanged, AddressOf OnFileRating_List_SelectedIndexChanged
                    AddHandler NotifyIcon.BalloonTipClicked, AddressOf OnNotifyIconBalloonTipClicked

                    Dim strNotifyIconPath As String = _
                        Application.StartupPath & Path.DirectorySeparatorChar & "Images" & Path.DirectorySeparatorChar & "performance.ico"
                    If Directory.Exists(Path.GetDirectoryName(strNotifyIconPath)) Then
                        If File.Exists(strNotifyIconPath) Then
                            _Icon = New System.Drawing.Icon(strNotifyIconPath)
                            NotifyIcon.Icon = _Icon
                            'NotifyIcon.Visible = True ' No need of this line the icon will be visible only when the report is ready
                        End If
                    End If

                End If

                Return True
            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : CreateHandler() " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return False
            End Try
        End Function

        Private Function DeleteHandler() As Boolean
            Try
                If Not CELProject.EngineModel Is Nothing Then
                    If CELProject.EngineFamily = "PW100" Then

                        If Not PERF_RUN_BTN Is Nothing Then
                            RemoveHandler PERF_RUN_BTN.ValueChanged, AddressOf OnBTN_PERFORMANCE_RUN
                        End If
                        If Not PERF_RESET_BTN Is Nothing Then
                            RemoveHandler PERF_RESET_BTN.ValueChanged, AddressOf OnBTN_PERFORMANCE_RESET
                        End If
                        If Not PERF_50PC_TORQUE_TRIM_BTN Is Nothing Then
                            RemoveHandler PERF_50PC_TORQUE_TRIM_BTN.ValueChanged, AddressOf OnBTN_50PC_TORQUE_TRIM
                        End If
                        If Not PERF_CLEAR_TORQUE_TRIM_BTN Is Nothing Then
                            RemoveHandler PERF_CLEAR_TORQUE_TRIM_BTN.ValueChanged, AddressOf OnBTN_CLEAR_TORQUE_TRIM
                        End If
                        If Not PERF_TO_TORQUE_TRIM_BTN Is Nothing Then
                            RemoveHandler PERF_TO_TORQUE_TRIM_BTN.ValueChanged, AddressOf OnBTN_TO_TORQUE_TRIM
                        End If
                        If Not PERF_TORQUE_TRIM_BTN Is Nothing Then
                            RemoveHandler PERF_TORQUE_TRIM_BTN.ValueChanged, AddressOf OnBTN_TORQUE_TRIM
                        End If

                        'Rating Analysis
                        If Not RATING_WINDOW_BTN Is Nothing Then
                            RemoveHandler RATING_WINDOW_BTN.ValueChanged, AddressOf OnRATING_WINDOW_BTN
                        End If
                        If Not RATING_FILE1 Is Nothing Then
                            RemoveHandler RATING_FILE1.ValueChanged, AddressOf OnRATING_WINDOW_BTN
                        End If
                        If Not RATING_FILE2 Is Nothing Then
                            RemoveHandler RATING_FILE2.ValueChanged, AddressOf OnRATING_WINDOW_BTN
                        End If
                        If Not RATING_FILE3 Is Nothing Then
                            RemoveHandler RATING_FILE3.ValueChanged, AddressOf OnRATING_WINDOW_BTN
                        End If
                        If Not SLAVE_RATING_CLOSE_BTN Is Nothing Then
                            RemoveHandler SLAVE_RATING_CLOSE_BTN.ValueChanged, AddressOf OnRATING_CLOSE_WINDOW_BTN
                        End If

                        RemoveHandler cboFileRating.SelectedIndexChanged, AddressOf OnFileRating_List_SelectedIndexChanged
                        RemoveHandler NotifyIcon.BalloonTipClicked, AddressOf OnNotifyIconBalloonTipClicked

                    End If

                    If Not (FlowmeterCtrl Is Nothing) Then
                        FlowmeterCtrl.Dispose()
                    End If
                End If

                Return True
            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : DeleteHandler()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return False
            End Try
        End Function

        Private Function GetOutputFilename() As String
            Dim conditionNo As Integer
            Dim engineBuildNo As Integer
            Dim engineSN As String = ""

            pwc83000.GetEngine(engineSN)
            pwc83000.GetBuild(engineBuildNo)
            pwc83000.GetCondition(conditionNo)

            Return sDataPath + "OUT_" + engineSN + "_" + Format(engineBuildNo, "0000") +
                "_" + Format(conditionNo, "0000") + ".DAT"
        End Function



