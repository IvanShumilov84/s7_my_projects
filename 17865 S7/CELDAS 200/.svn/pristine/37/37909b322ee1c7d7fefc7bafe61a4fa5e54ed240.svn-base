            'If T_T8_9_DELETE_BTN.Value.ToString() = "True" Then
            '    pwc83000.PutValue("T8", "-10001.000", "9")
            'Else
            '    pwc83000.PutValue("T8", Var_T_TT89_DEGF.ToString(), "9")
