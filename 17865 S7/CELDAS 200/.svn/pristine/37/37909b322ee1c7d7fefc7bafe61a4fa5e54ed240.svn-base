                Var_T_TT83_DEGF = TT83.Value.ToDouble()
                Var_T_TT84_DEGF = TT84.Value.ToDouble()
                Var_T_TT85_DEGF = TT85.Value.ToDouble()
                Var_T_TT86_DEGF = TT86.Value.ToDouble()
