                pwc83000.PutValue("T8", Var_T_TT84_DEGF.ToString(), "4")
            End If
            If T_T8_5_DELETE_BTN.Value.ToString() = "True" Then
                pwc83000.PutValue("T8", "-10001.000", "5")
            Else
                pwc83000.PutValue("T8", Var_T_TT85_DEGF.ToString(), "5")
            End If
            If T_T8_6_DELETE_BTN.Value.ToString() = "True" Then
                pwc83000.PutValue("T8", "-10001.000", "6")
            Else
                pwc83000.PutValue("T8", Var_T_TT86_DEGF.ToString(), "6")
            End If
            If T_T8_7_DELETE_BTN.Value.ToString() = "True" Then
                pwc83000.PutValue("T8", "-10001.000", "7")
