        Private Sub Update30PResultSet(ByVal PerfFileName As String)
            Dim perfValue As Single
            Dim w As StringWriter = New StringWriter()

            Try
                w.WriteLine(Format(Now, "yyyy/MM/dd"))
                w.WriteLine(PerfFileName)
                w.WriteLine(EngineModel)

                w.WriteLine(UserInputEngineSN)

                For Each label As String In ProcessResultLabels
                    pwc83000.GetResult(label, perfValue)
                    w.WriteLine(perfValue.ToString())
                Next label

                If (ProcessedResultSet.GetUpperBound(0) < (PERF_CONDITION_NUMBER.Value.ToDouble() - 1)) Then
                    ReDim Preserve ProcessedResultSet(CInt(PERF_CONDITION_NUMBER.Value.ToDouble() - 1))
                End If
                w.Flush()
                ProcessedResultSet(CInt(PERF_CONDITION_NUMBER.Value.ToDouble()) - 1) = w.GetStringBuilder().ToString().Trim()
                w.Close()

            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : Update30PResultSet() " & vbCrLf & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try

        End Sub

        Private Sub RefreshUserInputs(ByRef CELProject As CELDAS)
            Try

                EngineModel = CELProject.EngineModel
                UserInputEngineSN = CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
                UserInputWorkOrder = CELProject.Test_Mgr_UUT_Answer(1).Value.ToString()
                UserInputPartNumber = CELProject.Test_Mgr_UUT_Answer(2).Value.ToString()
                UserInputLHV = CELProject.Test_Mgr_UUT_Answer(3).Value.ToString()

                UserInputTestType = CELProject.Test_Mgr_UUT_Choice(0).Value.ToString()
                UserInputLimits = CELProject.Test_Mgr_UUT_Choice(1).Value.ToString()

                UserInputBuildSpecification = CELProject.Test_Mgr_UUT_PwBuildSpecification.Value.ToString()
                UserInputServiceBulleting = CELProject.Test_Mgr_UUT_PwServiceBulletin(0).Value.ToString()

                UserInputVane1 = CELProject.Test_Mgr_UUT_Answer(9).Value.ToString()
                UserInputVane2 = CELProject.Test_Mgr_UUT_Answer(10).Value.ToString()
                UserInputVane3 = CELProject.Test_Mgr_UUT_Answer(11).Value.ToString()

            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : MapUserInputsParameters() " & vbCrLf & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        ''' <summary>
        ''' This Sub set the Torque variables to be submitted to the PWC83000 DLL
        ''' TMSCU, TMAFU, TMEEC, TMAFC depending on the engine model
        ''' </summary>
        ''' <remarks></remarks>
        Private Sub SetTMSystems()

            Dim i As Integer
            Try
                For i = perfTMsystems.GetLowerBound(0) To perfTMsystems.GetUpperBound(0)
                    If perfTMsystems(i, 0) = EngineModel Then
                        If perfTMsystems(i, 1).ToUpper() = "Y" Then
                            perfTMscu = True
                        Else
                            perfTMscu = False
                        End If

                        If perfTMsystems(i, 2).ToUpper() = "Y" Then
                            perfTMafu = True
                        Else
                            perfTMafu = False
                        End If

                        If perfTMsystems(i, 3).ToUpper() = "Y" Then
                            perfTMeec = True
                        Else
                            perfTMeec = False
                        End If

                        If perfTMsystems(i, 4).ToUpper() = "Y" Then
                            perfTMafc = True
                        Else
                            perfTMafc = False
                        End If

                        Exit For
                    End If
                Next
            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : SetTMSystems() " & vbCrLf & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try

        End Sub

