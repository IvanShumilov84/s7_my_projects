                'Var_T_TT822_DEGF = TT822.Value.ToDouble()
                'Var_T_TT823_DEGF = TT823.Value.ToDouble()
                'Var_T_TT824_DEGF = TT824.Value.ToDouble()
                'Var_T_TT825_DEGF = TT825.Value.ToDouble()
