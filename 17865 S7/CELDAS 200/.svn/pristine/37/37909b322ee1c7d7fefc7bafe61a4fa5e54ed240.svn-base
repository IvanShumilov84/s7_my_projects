                Return
            End Try
        End Sub

        Private Sub OnBTN_TORQUE_TRIM(sender As IChannel, newVal As Value)
            Dim fileName As String
            Dim ier As Integer
            Dim iOutput As Integer = 1 ' if 1 Save the "OUT_" file
            Dim iTMTolDouble As Integer
            Dim perfFileName As String
            Dim rBiasCl As Single = 0
            Dim rGainCl As Single = 0
            Dim rResBias As Single = 0
            Dim rResGain As Single = 0


            Try
                If (newVal Is Values.True) And CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                    'Get values AFU Bias Class, AFU Gain Class, EEC R3 and EEC R4
                    rBiasCl = CSng(AFU_BIAS_CLASS.Value.ToDouble())
                    rGainCl = CSng(AFU_GAIN_CLASS.Value.ToDouble())
                    rResBias = CSng(EEC_R3.Value.ToDouble())
                    rResGain = CSng(EEC_R4.Value.ToDouble())


                    If (PERF_TRIM_TOLERANCE_BTN.Value.ToString() = "False") Then
                        iTMTolDouble = 1 '1 for regular tolerance of 50 Ft-Lbs
                    Else
                        iTMTolDouble = 2 '2 for doubled tolerance of 100 Ft-Lbs
                    End If

                    Dim temp As Boolean = Initialize_Perf()
                    If temp = False Then
                        clsTopMostMessageBox.Show("PWC83000_Sequence: OnBTN_TORQUE_TRIM" + vbCrLf + "Initialize_Perf() failed", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        PERF_TORQUE_TRIM_BTN.Value = Values.False
                        Exit Sub
                    End If

                    'PWC.PWC83000.ProcessTorqueTrim (iOutput,iTMTolDouble,rDynoTmTO,rDynoTm50PC,rEng1TO,rEng150PC,rEng2TO,rEng250PC,rGainCl,rBiasCl,rResGain,rResBias,ier)
                    pwc83000.ProcessTorqueTrim(iOutput, iTMTolDouble, Var_Dyno_Tq_TO, Var_Dyno_Tq_50PC, Var_SCU_AFU_AFC_Tq_TO,
                                               Var_SCU_AFU_AFC_Tq_50PC, Var_EEC_Tq_TO, Var_EEC_Tq_50PC, rGainCl, rBiasCl,
                                               rResGain, rResBias, ier)

                    If (ier = 0) Then
                        fileName = GetOutputFilename()

                        'Check if directory exist if not create directory
                        If (Not System.IO.Directory.Exists("C:\CELDAS DATA\" + EngineModel + "\" + UserInputEngineSN + "\" + UserInputWorkOrder + "\Perf\")) Then
                            System.IO.Directory.CreateDirectory("C:\CELDAS DATA\" + EngineModel + "\" + UserInputEngineSN + "\" + UserInputWorkOrder + "\Perf\")
                        End If

                        perfFileName = "C:\CELDAS DATA\" + EngineModel + "\" + UserInputEngineSN + "\" + UserInputWorkOrder + "\Perf\" + "Torque_Trim_" + Format(Now, "yyyy-MM-dd HH'h'mm'm'ss's'") + ".OUT"

                        If (System.IO.File.Exists(perfFileName)) Then
                            System.IO.File.Delete(perfFileName)
                        End If

                        System.IO.File.Copy(fileName, perfFileName)
                        ShowOutputFile(fileName)

                    Else
                        'clsTopMostMessageBox.Show("PWC83000_Sequence : OnBTN_TORQUE_TRIM()" + vbCrLf + "UNEXPECTED ERROR:" + vbCrLf + _
                        '                "==== ERROR PROCESSING TORQUE TRIM  ====", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        'An error code from the DLL does not nessessairily mean that the input data was erronous.
                        'It just means that the engine is not torque trimmed yet and additionnal trimming is required.
                        ShowOutputFile("TEMP.OUT")

                    End If

                    PERF_TORQUE_TRIM_BTN.Value = Values.False
                End If
            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : OnBTN_TORQUE_TRIM()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionClosing(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionClosing(newStatus)
                If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then
                    If CELProject.EngineFamily = "PW100" Then
                        DeleteHandler()
                    End If
                End If
            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : OnTestSessionClosing()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionInitialized(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionInitialized(newStatus)

                If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then

                    If CELProject.EngineFamily = "PW100" Then

                        EngineModel = CELProject.EngineModel

                        RefreshUserInputs(CELProject)

                        If IsPWC83000Installed() = False Then
                            clsTopMostMessageBox.Show("PWC83000_Sequence : OnTestSessionInitialized()" & vbCrLf &
                                            "PWC83000 DLL is either not installed or installation path is incorrect", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            Exit Sub
                        End If

                        'Client Initialization
                        Dim endpointAddress As New EndpointAddress(Configuration.CreateServerUriString())
                        Dim binding As System.ServiceModel.Channels.Binding = Configuration.CreateBinding()
                        Dim factory As New ChannelFactory(Of IPwc83000)(binding, endpointAddress)
                        pwc83000 = factory.CreateChannel()


                        SetTMSystems()

                        Init_Engine_Channels()

                        Initialize()

                        If Initialize_Perf() = False Then
                            Perf_Status_Close = True
                        Else
                            Perf_Status_Close = False
                        End If

                    End If
                End If

            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC80000_Sequence : OnTestSessionInitialized()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)

            Catch ex As Exception

                clsTopMostMessageBox.Show("PWC83000_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            End Try
        End Sub

        Protected Overrides Sub OnTestSessionRunning(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionRunning(newStatus)
                If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then

                    If CELProject.EngineFamily = "PW100" Then

                        If Perf_Status_Close Then
                            'CELProject.Test_Mgr_Cmd.Value = New KineticaRT.Values.Text(CELDAS.eTest_Mgr_Cmd.Close)
                        End If
                        CreateHandler()

                    End If

                End If

            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : OnTestSessionRunning()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Public Function UpdateCustomHeaderLogFile(ByVal AppendOption As Boolean, ByVal IsPerfEntry As Boolean, ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean
            Dim Log_Condition As Integer

            If AppendOption = False Then
                Log_Condition = 1
            Else
                'Log_Condition = (ExcelWorksheet.Cells(RowIndex + 1, 1).End(Excel.XlDirection.xlToRight).Column - 1)
                'TODO: Ici changement du au nouveau Microsoft.Office.Interop.Excel	                        'Log_Condition = (ExcelWorksheet.Cells(RowIndex + 1, 1).End(XlDirection.xlToRight).Column - 1)  'cette ligne en office 2010 retourne toujours 16384 -1 donc 16383 et le reste du code plante
                Log_Condition = ExcelWorksheet.Cells(RowIndex + 1, ExcelWorksheet.Columns.Count).End(Excel.XlDirection.xlToLeft).Column - 1
                Log_Condition = Log_Condition + 1

            End If

            If ((Log_Condition > 1) And ((Log_Condition Mod 5) = 1)) Then

                'Repeat The Test Spec For this new sets of condition

                With ExcelWorksheet
                    .Range(.Cells(2, 2), .Cells(RowIndex - 2, 6)).Copy(.Cells(2, Log_Condition + 1))
                End With
            End If

            ColumnIndex = 1 + Log_Condition

            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Format(Now, "yyyy/MM/dd HH:mm:ss")
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += 1
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Log_Condition.ToString()
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += 1

            'Auto Generated Comment
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Performance Point"

            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += 2
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Values"
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignCenter

            Return True
        End Function

        Private Sub ProcessCondition()
            Dim cond_nb As Integer = 1
            Dim build_nb As Integer = 1
            Dim fileName As String = String.Empty
            Dim iError As Integer = 0

            Try
                build_nb = CInt(PERF_BUILD_NUMBER.Value.ToDouble())
                cond_nb = CInt(PERF_CONDITION_NUMBER.Value.ToDouble())
                Init_Engine_Channels()
                pwc83000.SetBuild(build_nb)
                pwc83000.SetCondition(cond_nb)
                SubmitPerfValues()
                pwc83000.Process(iError, True, True)

                If (iError = 0) Then
                    fileName = GetOutputFilename()

                    'Check if directory exist if not create directory
                    If (Not System.IO.Directory.Exists("C:\CELDAS DATA\" + EngineModel + "\" + UserInputEngineSN + "\" + UserInputWorkOrder + "\Perf\")) Then
                        System.IO.Directory.CreateDirectory("C:\CELDAS DATA\" + EngineModel + "\" + UserInputEngineSN + "\" + UserInputWorkOrder + "\Perf\")
                    End If

                    PerfFileName = "C:\CELDAS DATA\" + EngineModel + "\" + UserInputEngineSN + "\" + UserInputWorkOrder + "\Perf\" + "Performance " + Format(Now, "yyyy-MM-dd HH'h'mm'm'ss's'") + ".txt"

                    If (System.IO.File.Exists(PerfFileName)) Then
                        System.IO.File.Delete(PerfFileName)
                    End If

                    System.IO.File.Copy(fileName, PerfFileName)
                    ShowOutputFile(fileName)
                    PERF_CONDITION_NUMBER.Value = New KineticaRT.Values.Double(PERF_CONDITION_NUMBER.Value.ToDouble + 1)
                Else
                    clsTopMostMessageBox.Show("PWC83000_Sequence : ProcessCondition()" & vbCrLf & "UNEXPECTED ERROR:" + vbCrLf + "==== ERROR PROCESSING CONDITION ====" + vbCrLf, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    ShowOutputFile("TEMP.OUT")
                End If
            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : ProcessCondition()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub CaptureValues()
            Try
                Var_T_FUEL_DEGF = TF.Value.ToDouble()
                Var_WF1_PPH = WF1.Value.ToDouble()
                Var_WF2_PPH = WF2.Value.ToDouble()

                Var_P_BARO_PSIA = P_BARO_PSIA.Value.ToDouble() ' PAM.Value.ToDouble()

                Var_DYNO_TORQUE_LBSFT = DYNO_TORQUE_LBSFT.Value.ToDouble()

                If perfTMscu Then
                    Var_TORQUE_SCU_LBSFT = TORQUE_SCU.Value.ToDouble()
                End If

                If perfTMafu Then
                    Var_TORQUE_AFU_LBSFT = TORQUE_AFU.Value.ToDouble()
                End If

                If perfTMeec Then
                    Var_TORQUE_EEC_LBSFT = TORQUE_EEC.Value.ToDouble()
