                Return_Value.Add(MyBase.InitializeObject(cboFileRating, "PW100_Slave_Rating_Screen.cbo_CHOICE_FILE"))
                Return_Value.Add(MyBase.InitializeObject(labelFileRating, "PW100_Slave_Rating_Screen.lblSHP"))
                Return_Value.Add(MyBase.InitializeObject(PERF_PRESB21325_RTN, "PERF_PRESB21325_RTN"))
                Return_Value.Add(MyBase.InitializeObject(PERF_PSTSB21325_RTN, "PERF_PSTSB21325_RTN"))

                'DEW point
                Return_Value.Add(MyBase.InitializeChannel(PERF_DEW_PT_METHOD_CHKBOX, "PERF_DEW_PT_METHOD_CHKBOX"))
                Return_Value.Add(MyBase.InitializeChannel(PERF_T_REF_TEMP_DEGF, "PERF_T_REF_TEMP_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(PERF_T_DEW_PT_DEGF, "PERF_T_DEW_PT_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(PERF_T_REF_TEMP_DEGF_INPUT, "PERF_T_REF_TEMP_DEGF_INPUT"))
                Return_Value.Add(MyBase.InitializeChannel(PERF_T_DEW_PT_DEGF_INPUT, "PERF_T_DEW_PT_DEGF_INPUT"))

            Catch ex As Exception
                clsTopMostMessageBox.Show("Init_Engine_Channels: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return_Value.Add(False)
            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If

        End Function

        Private Function Initialize() As Boolean
            Initialize = False
            Try
                PERF_BUILD_NUMBER.Value = Values.One
                PERF_CONDITION_NUMBER.Value = Values.One
                AFC_GAIN.Value = Values.Zero
                AFC_OFFSET.Value = Values.Zero
                Var_SCU_AFU_AFC_Tq_50PC = 0
                Var_SCU_AFU_AFC_Tq_TO = 0
                Var_Dyno_Tq_50PC = 0
                Var_Dyno_Tq_TO = 0
                EEC_R3.Value = Values.Zero 'FOR PW127 ONLY
                EEC_R4.Value = Values.Zero 'FOR PW127 ONLY
                Var_EEC_Tq_50PC = 0
                Var_EEC_Tq_TO = 0

                VANE_AREA1.Value = New KineticaRT.Values.Double(UserInputVane1)
                VANE_AREA2.Value = New KineticaRT.Values.Double(UserInputVane2)
                VANE_AREA3.Value = New KineticaRT.Values.Double(UserInputVane3)
                REMARK_TEXT.Value = New KineticaRT.Values.Text("")

                'Rating Analysis
                ratingFile1 = String.Empty
                ratingFile2 = String.Empty
                ratingFile3 = String.Empty

                RATING_WINDOW_BTN_ENB.Value = KineticaRT.Values.Values.False
                cboFileRating.Items.Clear()
                workingRatingFile = 0
                NotifyIcon = New System.Windows.Forms.NotifyIcon
                AFU_BIAS_CLASS.Value = Values.Zero
                AFU_GAIN_CLASS.Value = Values.Zero

                ratingLOLO = 0
                ratingLOMID = 0
                ratingHIMID = 0
                ratingHIHI = 0
                ratingCalcPoint = 0

                PERF_PRESB21325_RTN.Value = KineticaRT.Values.Values.False
                PERF_PSTSB21325_RTN.Value = KineticaRT.Values.Values.False

                Initialize = True

            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : Initialize() " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return False
            End Try
        End Function

        Private Function Initialize_Perf() As Boolean

            Initialize_Perf = False

            Dim iError As Integer = 0
            Dim i As Integer = 0
            Dim iSummary As Integer = 0
            Dim dR1 As Double = 0

            Try
                'Following code not required as we use CEL rating analysis
                'Le 30 P est toujours necessaire pour le PW100
                'PCQ la DLL de Pratt n'implemente pas encore l<interpollation a meme la dll
                'If (System.IO.File.Exists("C:\30P\PerfOutput.txt")) Then
                'System.IO.File.Delete("C:\30P\PerfOutput.txt")
                'S'assurer de ne pas perdre le fichier.
                'System.IO.File.Move("C:\30P\PerfOutput.txt", "C:\30P\PerfOutput" & Now.Year & Now.Month & Now.Day & "_" & Now.Hour & Now.Minute & Now.Second & ".txt")
                'End If

                SetRatingValues()

                CopyConfigurationFiles()
                pwc83000.SetConfigurationPath(sConfigurationPath)
                pwc83000.SetDataPath(sDataPath)
                CreateDataPath()

                pwc83000.GetUnitData()

                Dim iBuild As Integer = 0
                Dim sSerialEngNum As String = ""
                Dim iCond As Integer = 0
                iBuild = Integer.Parse(PERF_BUILD_NUMBER.Value.ToString())
                iCond = Integer.Parse(PERF_CONDITION_NUMBER.Value.ToString())

                pwc83000.SetEngine(UserInputEngineSN)
                pwc83000.SetBuild(iBuild)
                pwc83000.SetCondition(iCond)

                Dim iBuildNum As Integer = UserInputBuildSpecification
                iError = 0
                pwc83000.LoadModel(iError, iBuildNum) 'test with integer

                If iError <> 0 Then
                    If iError >= 10 And iError <= 12 Then
                        clsTopMostMessageBox.Show("PWC83000_Sequence.Initialize_Perf(): You do not have a valid license to run the program and you need to contact PWC for a license key. Error #: " & iError.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Else
                        clsTopMostMessageBox.Show("PWC83000_Sequence : Initialize_Perf() Couldn't Load Model" & vbCrLf &
                                        "LoadModel error #: " & iError.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Return False
                    End If
                End If

                iSummary = 255
                pwc83000.SetSummary(iSummary)
                pwc83000.GetSummary(iSummary)
                pwc83000.Define()

                pwc83000.Initialize()
                pwc83000.GetUnitData() ' Read the file unit.data for values
                SetUnitValues() 'Put the data values as indicated on this file

                If EngineModel = "PW121" Then
                    If UserInputServiceBulleting = "PRE21325" Then
                        PERF_PRESB21325_RTN.Value = KineticaRT.Values.Values.True
                        PERF_PSTSB21325_RTN.Value = KineticaRT.Values.Values.False
                        pwc83000.SetITTTrim(2) ' When we have Pre we required to set to 2
                    Else ' UserInputServiceBulleting = "PST21325" Then
                        PERF_PRESB21325_RTN.Value = KineticaRT.Values.Values.False
                        PERF_PSTSB21325_RTN.Value = KineticaRT.Values.Values.True
                    End If
                End If

                pwc83000.GetR1(dR1)

                If iError <> 0 Then
                    Return False
                Else
                    Return True
                End If

            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : Initialize_Perf() : Cannot communicate with P&WC DLL Processing Server" & vbCrLf & vbCrLf & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        ''' <summary>
        ''' Function to calculate the Y value by using three points with X and Y values.
        ''' </summary>
        ''' <param name="X">Array of Double(2) contains the x positions of three points</param>
        ''' <param name="Y">Array of Double(2) contains the y positions of three points</param>
        ''' <param name="Point">What is the X point to be calculated</param>
        ''' <returns>Returns what is the value of Y at the Point position using least squared lines method</returns>
        ''' <remarks></remarks>
        Private Function LeastSquaresLine(ByVal X() As Double, ByVal Y() As Double, ByVal Point As Double) As Double 'ft TODO transferer en librairie

            Dim SumX, SumXSquared, SumY, SumXY As Double
            Dim Xmed, Ymed, ResultPoint As Double

            Try

                For I As Integer = 0 To X.Length - 1
                    SumX += X(I)
                    SumXSquared += X(I) * X(I)
                    SumY += Y(I)
                    SumXY += X(I) * Y(I)
                Next

                Xmed = SumX / X.Length
                Ymed = SumY / Y.Length

                Dim Slope, Intercept, Determinant As Double
                Determinant = X.Length * SumXSquared - (SumX * SumX)
                Slope = ((X.Length * SumXY) - (SumY * SumX)) / Determinant ' aka b
                Intercept = Ymed - (Slope * Xmed) ' aka a

                ResultPoint = Intercept + Slope * Point

            Catch ex As Exception
                ResultPoint = -1
                clsTopMostMessageBox.Show("PWC83000_Sequence : LeastSquaresLine()" & vbCrLf & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
            'Return New Double() {Slope, Intercept}
            Return ResultPoint

        End Function

        ''' <summary>
        ''' Function to perform the Rating analysis is attached to the Rating Analisys button.
        ''' </summary>
        ''' <param name="sender"></param>
        ''' <param name="newVal"></param>
        ''' <remarks></remarks>
        Private Sub OnRATING_WINDOW_BTN(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    If Not ratingFile1 Is String.Empty And Not ratingFile2 Is String.Empty And Not ratingFile3 Is String.Empty Then
                        RATING_WINDOW_BTN_ENB.Value = KineticaRT.Values.Values.False
                        ProcessRatingAnalysis()
                    End If
                End If
            Catch Ex As Exception
                clsTopMostMessageBox.Show("OnRATING_WINDOW_BTN: " * Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally
                RATING_WINDOW_BTN.Value = KineticaRT.Values.Values.False
            End Try
        End Sub

        ''' <summary>
        ''' Function to get performance files listing
        ''' </summary>
        ''' <returns> A string builder with all the files in the Perf directory</returns>
        ''' <remarks></remarks>
        Private Function GetPerfRatingFiles() As StringBuilder

            Dim targetDirectory = "C:\CELDAS DATA\" & EngineModel _
                                  & "\" & UserInputEngineSN & "\" _
                                  & UserInputWorkOrder & "\Perf"

            Dim fileEntries As String() = Directory.GetFiles(targetDirectory)
            Dim fileName
            Dim sb As New System.Text.StringBuilder
            Dim strfile As String

            For Each fileName In fileEntries
                strfile = fileName.ToString()
                If strfile.ToLower.Contains(".txt") Then ' only txt files 
                    If IsAValidPerfFile(strfile) Then ' File contains valid perf data
                        sb.AppendLine(fileName)
                    End If
                End If
            Next fileName

            Return sb

        End Function

        ''' <summary>
        ''' Check if the filepath is a valid Rating data analysis
        ''' </summary>
        ''' <param name="filepath"></param>
        ''' <returns>Returns True if is a valida rating analysis file, False otherwhise</returns>
        ''' <remarks></remarks>
        Private Function IsAValidPerfFile(ByVal filepath As String) As Boolean
            Dim isValid As Boolean = False
            Dim line As String = String.Empty
            Dim file As New StreamReader(filepath)

            While (file.Peek > -1)
                line = file.ReadLine()
                If line.Contains("RESULTS TO S.L.S.") Then
                    isValid = True
                    'Exit While
                ElseIf line.Contains("CANNOT") Then
                    isValid = False
                    Exit While
                End If
            End While

            Return isValid
        End Function

        ''' <summary>
        ''' Function get the performance data.
        ''' </summary>
        ''' <param name="filepath"> Variable containing the path to filter performance data </param>
        ''' <returns> A Decimal Array as follow:
        ''' 
        '''result(0) = shp
        '''result(1) = nh
        '''result(2) = nl
        '''result(3) = nh_over_nl
        '''result(4) = itt_corr
        '''result(5) = wf_corr
        '''result(6) = mech shp
        '''</returns>
        ''' <remarks></remarks>
        Private Function GetPerfData(ByVal filepath As String) As Decimal()

            'Dim counter As Integer = 0
            Dim line As String = ""
            Dim lineNumbers1 As String = ""
            Dim lineITT As String = ""
            Dim lineDyno As String = ""
            Dim proccess As Boolean = False
            Dim options As RegexOptions = RegexOptions.None
            Dim pattern As String = "\s+"
            Dim replacement As String = "|"
            Dim rgx As New Regex(pattern)
            Dim result(6) As Decimal

            Dim file As New StreamReader(filepath)

            While (file.Peek)
                line = file.ReadLine()

                If line.Contains("DYNO TQ") Then
                    lineDyno = file.ReadLine() ' read dyno value line
                End If

                If line.Contains("P3/P1") Then

                    'line = file.ReadLine() ' read next line and get titles
                    lineNumbers1 = file.ReadLine() ' read numbers line

                    While (file.Peek)
                        line = file.ReadLine() ' read next line

                        If line.Contains("NH/") Then
                            lineITT = file.ReadLine() ' read ITT numbers line
                            proccess = True
                            Exit While
                        End If

                    End While
                End If

                If proccess Then
                    Exit While
                End If

            End While

            Try

                If proccess Then

                    lineNumbers1 = lineNumbers1.Trim()
                    lineITT = lineITT.Trim()
                    lineDyno = lineDyno.Trim()

                    lineNumbers1 = rgx.Replace(lineNumbers1, replacement)
                    lineITT = rgx.Replace(lineITT, replacement)
                    lineDyno = rgx.Replace(lineDyno, replacement)

                    Dim arrayNum0() As String = lineDyno.Split(replacement)
                    Dim arrayNum1() As String = lineNumbers1.Split(replacement)
                    Dim arrayNum2() As String = lineITT.Split(replacement)


                    Dim shp, nh, nl, nh_over_nl, t6h, t6c, wf_corr, mech_shp As Decimal

                    shp = Decimal.Parse(arrayNum1(0))
                    nh = Decimal.Parse(arrayNum2(0))
                    nl = Decimal.Parse(arrayNum2(1))
                    nh_over_nl = nh / nl
                    t6h = Decimal.Parse(arrayNum2(4)) 'this is the value to check not the T6 calculated(T6C) as T6H = T6T
                    t6c = Decimal.Parse(arrayNum2(5))
                    If EngineModel = "PW118" Or EngineModel = "PW118A" Or EngineModel = "PW118B" Or
                       EngineModel = "PW119B" Or EngineModel = "PW119C" Or EngineModel = "PW120" Or
                       EngineModel = "PW120A" Or EngineModel = "PW121" Or EngineModel = "PW123AF" Then
                        wf_corr = Decimal.Parse(arrayNum1(7))
                    Else 'PW1118A position differs from PW127E
                        wf_corr = Decimal.Parse(arrayNum1(9))
                    End If
                    mech_shp = Decimal.Parse(arrayNum0(0))
                    mech_shp = (mech_shp * 1020) / 5252.1

                    line = "shp: " & arrayNum1(4) & ", nh: " & arrayNum1(4) & ", nl: " & arrayNum1(3) & ", nh/nl: " _
                        & nh_over_nl.ToString() & ", t6h: " & arrayNum2(4) & ", wf_corr:" & arrayNum1(2) _
                        & "mech shp: " & mech_shp.ToString()

                    result(0) = shp
                    result(1) = nh
                    result(2) = nl
                    result(3) = nh_over_nl
                    result(4) = t6h
                    result(5) = wf_corr
                    result(6) = mech_shp

                End If
            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence GetPerfData():" & vbCrLf & ex.ToString() _
                                        , "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try

            Return result

        End Function

        ''' <summary>
        ''' Sub to OPEN the selection window to chose the rating files
        ''' </summary>
        ''' <param name="sender"></param>
        ''' <param name="newVal"></param>
        ''' <remarks></remarks>
        Private Sub OnRATING_OPEN_WINDOW_BTN(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    cboFileRating.Items.Clear()
                    CELProject.ActivateForm("PW100_Slave_Rating_Screen", "PW100_Slave_Screen", True, False)

                    If sender.Name = "PERF_RATING_FILE1" Then
                        ProcessFileType(0)
                    ElseIf sender.Name = "PERF_RATING_FILE2" Then
                        ProcessFileType(1)
                    ElseIf sender.Name = "PERF_RATING_FILE3" Then
                        ProcessFileType(2)
                    Else
                        clsTopMostMessageBox.Show("PWC83000_Sequence OnRATING_OPEN_WINDOW_BTN():" & vbCrLf &
                                        " Cannot find performance rating file", "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                    End If

                End If
            Catch Ex As Exception
                clsTopMostMessageBox.Show("OnRATING_OPEN_WINDOW_BTN: " & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally
                'Reset Buttons
                RATING_FILE1.Value = KineticaRT.Values.Values.False
                RATING_FILE2.Value = KineticaRT.Values.Values.False
                RATING_FILE3.Value = KineticaRT.Values.Values.False
            End Try
        End Sub

        ''' <summary>
        ''' Sub to CLOSED the selection window to chose the rating files
        ''' </summary>
        ''' <param name="sender"></param>
        ''' <param name="newVal"></param>
        ''' <remarks></remarks>
        Private Sub OnRATING_CLOSE_WINDOW_BTN(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    cboFileRating.Items.Clear()
                    CELProject.ActivateForm("PW100_Slave_Rating_Screen", "PW100_Slave_Screen", False, False)

                End If
            Catch Ex As Exception
                clsTopMostMessageBox.Show("OnRATING_CLOSE_WINDOW_BTN: " & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally
                'Reset Button
                SLAVE_RATING_CLOSE_BTN.Value = KineticaRT.Values.Values.False
            End Try
        End Sub


        ''' <summary>
        ''' Process the type of files to look in the directory for performance
        ''' 
        ''' type = 0 is look for files less or equal to 4380 SHP
        ''' type = 1 is look for files more than 4380 SHP and less than 4825
        ''' type = 2 is look for files more than 4825 SHP
        ''' 
        ''' it returns 0 if everything OK if not 1
        ''' </summary>
        ''' <returns></returns>
        ''' <remarks></remarks>
        Private Function ProcessFileType(ByVal type As Integer) As Integer

            Dim result As Integer = 1
            Dim allFiles As StringBuilder
            Dim s As String
            Dim d() As Decimal
            Dim goodfiles As New List(Of String) ' store the good files to display in the combobox

            If type = 0 Or type = 1 Or type = 2 Then

                allFiles = GetPerfRatingFiles()
                Dim crt As Integer = 0
                Dim mystr() As String
                Dim cgoodfiles As Integer = 0

                If type = 0 And Not allFiles Is String.Empty Then

                    workingRatingFile = 1
                    mystr = allFiles.ToString().Split(Environment.NewLine)
                    Dim cuenta As Integer = 0 ' number of good files shp >= 4010 & shp <= 4380

                    For crt = 0 To mystr.GetUpperBound(0) - 1
                        s = mystr(cuenta)
                        s = s.Trim()
                        If Not s = "" Then
                            d = GetPerfData(s)
                            'If (d(6) >= 4010 And d(6) <= 4380) Then
                            If (d(0) >= ratingLOLO And d(0) <= ratingLOMID) Then
                                goodfiles.Add(s)
                                cgoodfiles = cgoodfiles + 1
                            End If
                            cuenta = cuenta + 1
                        End If
                    Next

                    If goodfiles.Count > 0 Then
                        cboFileRating.Items.Add("")
                        For Each item As String In goodfiles
                            cboFileRating.Items.Add(item)
                        Next
                    End If

                ElseIf type = 1 And Not allFiles Is String.Empty Then

                    workingRatingFile = 2
                    mystr = allFiles.ToString().Split(Environment.NewLine)
                    Dim cuenta As Integer = 0 ' number of good files shp > 4380 and shp < 4825

                    For crt = 0 To mystr.GetUpperBound(0) - 1
                        s = mystr(cuenta)
                        s = s.Trim()
                        If Not s = "" Then ' sometimes I got an empty line at the end
                            d = GetPerfData(s)
                            'If (d(6) > 4380 And d(6) < 4825) Then
                            If (d(0) > ratingLOMID And d(0) < ratingHIMID) Then
                                goodfiles.Add(s)
                                cgoodfiles = cgoodfiles + 1
                            End If
                            cuenta = cuenta + 1
                        End If
                    Next


                    If goodfiles.Count > 0 Then
                        cboFileRating.Items.Add("")
                        For Each item As String In goodfiles
                            cboFileRating.Items.Add(item)
                        Next
                    End If

                ElseIf type = 2 And Not allFiles Is String.Empty Then

                    workingRatingFile = 3
                    mystr = allFiles.ToString().Split(Environment.NewLine)
                    Dim cuenta As Integer = 0 ' number of good files shp <= 4380

                    For crt = 0 To mystr.GetUpperBound(0) - 1
                        s = mystr(cuenta)
                        s = s.Trim()
                        If Not s = "" Then
                            d = GetPerfData(s)
                            If d(0) >= ratingHIMID And d(0) <= ratingHIHI Then
                                goodfiles.Add(s)
                                cgoodfiles = cgoodfiles + 1
                            End If
                            cuenta = cuenta + 1
                        End If
                    Next

                    If goodfiles.Count > 0 Then
                        cboFileRating.Items.Add("")
                        For Each item As String In goodfiles
                            cboFileRating.Items.Add(item)
                        Next
                    End If

                End If

                result = 0
            End If
            Return result

        End Function

        ''' <summary>
        ''' Function when the file text changed.
        ''' It enables the Rating Analysis button when 3 files are selected.
        ''' </summary>
        ''' <param name="sender"></param>
        ''' <param name="e"></param>
        ''' <remarks></remarks>
        Private Sub OnFileRating_List_SelectedIndexChanged(ByVal sender As System.Object, ByVal e As System.EventArgs)
            Try

                If workingRatingFile = 1 Then

                    If cboFileRating.SelectedItem.ToString() = "" Then
                        ratingFile1 = String.Empty
                        labelFileRating.Text = "N/A"
                        RATING_FILE1_IND.Value = KineticaRT.Values.Values.False
                    Else
                        ratingFile1 = cboFileRating.SelectedItem.ToString()
                        labelFileRating.Text = GetDynoTQ(ratingFile1)
                        RATING_FILE1_IND.Value = KineticaRT.Values.Values.True
                    End If

                ElseIf workingRatingFile = 2 Then

                    If cboFileRating.SelectedItem.ToString() = "" Then
                        ratingFile2 = String.Empty
                        labelFileRating.Text = "N/A"
                        RATING_FILE2_IND.Value = KineticaRT.Values.Values.False
                    Else
                        ratingFile2 = cboFileRating.SelectedItem.ToString()
                        labelFileRating.Text = GetDynoTQ(ratingFile2)
                        RATING_FILE2_IND.Value = KineticaRT.Values.Values.True
                    End If
                ElseIf workingRatingFile = 3 Then

                    If cboFileRating.SelectedItem.ToString() = "" Then
                        ratingFile3 = String.Empty
                        labelFileRating.Text = "N/A"
                        RATING_FILE3_IND.Value = KineticaRT.Values.Values.False
                    Else
                        ratingFile3 = cboFileRating.SelectedItem.ToString()
                        labelFileRating.Text = GetDynoTQ(ratingFile3)
                        RATING_FILE3_IND.Value = KineticaRT.Values.Values.True
                    End If
                End If

                If Not ratingFile1 Is String.Empty And Not ratingFile2 Is String.Empty And Not ratingFile3 Is String.Empty Then
                    RATING_WINDOW_BTN_ENB.Value = KineticaRT.Values.Values.True
                Else
                    RATING_WINDOW_BTN_ENB.Value = KineticaRT.Values.Values.False
                End If


            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence OnEngineModel_List_SelectedIndexChanged: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        ''' <summary>
        ''' This function will take 3 files then perform ratining analysis them write the excel file for Final Acceptance
        ''' 
        ''' This function assumes that the 3 files are correctly selected and valid
        ''' 
        ''' Finally it will write down the Excel file into the Perf directory 
        ''' </summary>
        ''' <remarks></remarks>
        Private Sub ProcessRatingAnalysis()

            Dim d(5) As Decimal 'd(x) is:  0: shp, 1: nh 2: nl  3: nh_over_nl 4: itt_corr 5: wf_corr
            Dim x(2), y(2) As Double
            Dim results(5) As Double

            Try
                d = GetPerfData(ratingFile1) 'd(x) is:  0: shp, 1: nh 2: nl  3: nh_over_nl 4: itt_corr 5: wf_corr
                x(0) = d(0)
                y(0) = d(5) ' d(5) is Wf

                d = GetPerfData(ratingFile2)
                x(1) = d(0)
                y(1) = d(5)

                d = GetPerfData(ratingFile3)
                x(2) = d(0)
                y(2) = d(5)

                results(0) = ratingCalcPoint
                results(5) = LeastSquaresLine(x, y, ratingCalcPoint)

                d = GetPerfData(ratingFile1) 'd(x) is:  0: shp, 1: nh 2: nl  3: nh_over_nl 4: itt_corr 5: wf_corr
                x(0) = d(0)
                y(0) = d(1) ' d(1) is NH

                d = GetPerfData(ratingFile2)
                x(1) = d(0)
                y(1) = d(1)

                d = GetPerfData(ratingFile3)
                x(2) = d(0)
                y(2) = d(1)

                'xySqrResult(0) = 5071.0
                results(1) = LeastSquaresLine(x, y, ratingCalcPoint)

                'clsTopMostMessageBox.Show("Result of NH @ 5071.0 SHP is: " & xySqrResult(1).ToString())

                d = GetPerfData(ratingFile1) 'd(x) is:  0: shp, 1: nh 2: nl  3: nh_over_nl 4: itt_corr 5: wf_corr
                x(0) = d(0)
                y(0) = d(2) ' d(2) is NL

                d = GetPerfData(ratingFile2)
                x(1) = d(0)
                y(1) = d(2)

                d = GetPerfData(ratingFile3)
                x(2) = d(0)
                y(2) = d(2)

                'xySqrResult(0) = 5071.0
                results(2) = LeastSquaresLine(x, y, ratingCalcPoint)

                'clsTopMostMessageBox.Show("Result of NL @ 5071.0 SHP is: " & xySqrResult(2).ToString())

                d = GetPerfData(ratingFile1) 'd(x) is:  0: shp, 1: nh 2: nl  3: nh_over_nl 4: itt_corr 5: wf_corr
                x(0) = d(0)
                y(0) = d(3) ' d(3) is NH

                d = GetPerfData(ratingFile2)
                x(1) = d(0)
                y(1) = d(3)

                d = GetPerfData(ratingFile3)
                x(2) = d(0)
                y(2) = d(3)

                'xySqrResult(0) = 5071.0
                results(3) = LeastSquaresLine(x, y, ratingCalcPoint)

                'clsTopMostMessageBox.Show("Result of NH @ 5071.0 SHP is: " & xySqrResult(3).ToString())


                d = GetPerfData(ratingFile1) 'd(x) is:  0: shp, 1: nh 2: nl  3: nh_over_nl 4: itt_corr 5: wf_corr
                x(0) = d(0)
                y(0) = d(4) ' d(4) is ITT

                d = GetPerfData(ratingFile2)
                x(1) = d(0)
                y(1) = d(4)

                d = GetPerfData(ratingFile3)
                x(2) = d(0)
                y(2) = d(4)

                'xySqrResult(0) = 5071.0
                results(4) = LeastSquaresLine(x, y, ratingCalcPoint)

                'http://vb.net-informations.com/excel-2007/vb.net_excel_2007_open_file.htm
                Dim xlApp As Excel.Application
                Dim xlWorkBook As Excel.Workbook
                Dim xlWorkSheet As Excel.Worksheet
                Dim filetowrite As String = String.Empty
                Dim directorytoread As String = "C:\My Projects\CELDAS 200\HMI\PW100\"
                Dim directorytowrite As String = "C:\CELDAS DATA\" & EngineModel & "\" & UserInputEngineSN & "\" & UserInputWorkOrder & "\Perf\"

                xlApp = New Excel.ApplicationClass

                If UserInputServiceBulleting = String.Empty Then
                    filetowrite = EngineModel.ToUpper() & " Engine Performance Acceptance.xls"
                Else
                    filetowrite = EngineModel.ToUpper() & " " & UserInputServiceBulleting & " Engine Performance Acceptance.xls"
                End If

                xlWorkBook = xlApp.Workbooks.Open(directorytoread & filetowrite)
                xlWorkSheet = xlWorkBook.Worksheets("Sheet1")

                xlWorkSheet.Cells(5, 1) = EngineModel.ToUpper() & " ENGINE PERFORMANCE ACCEPTANCE " & UserInputServiceBulleting

                xlWorkSheet.Cells(9, 2) = UserInputEngineSN
                xlWorkSheet.Cells(9, 11) = UserInputBuildSpecification
                xlWorkSheet.Cells(11, 2) = UserInputWorkOrder

                xlWorkSheet.Cells(13, 1) = "SLS ISA PERFORMANCE DATA @ " & ratingCalcPoint.ToString() & " SHP CORR"

                xlWorkSheet.Cells(21, 10) = results(1).ToString("#,##0.00", CultureInfo.InvariantCulture)
                xlWorkSheet.Cells(22, 10) = results(2).ToString("#,##0.00", CultureInfo.InvariantCulture)
                xlWorkSheet.Cells(23, 10) = results(3).ToString("#,##0.000")
                xlWorkSheet.Cells(24, 10) = results(4).ToString("#,##0.00", CultureInfo.InvariantCulture) & " T6H"
                xlWorkSheet.Cells(25, 10) = results(5).ToString("#,##0.00", CultureInfo.InvariantCulture)

                If File.Exists(directorytowrite & filetowrite) Then
                    File.Delete(directorytowrite & filetowrite)
                End If

                xlWorkBook.SaveAs(directorytowrite & filetowrite)
                xlWorkBook.Close()
                xlApp.Quit()

                ReleaseMyObject(xlWorkSheet)
                ReleaseMyObject(xlWorkBook)
                ReleaseMyObject(xlApp)

                NotifyIcon.Tag = directorytowrite & filetowrite 'Path.GetDirectoryName(filename)
                NotifyIcon.Visible = True
                NotifyIcon.ShowBalloonTip(15000, "Celdas 200™", "New log file successfully generated:" &
                                          vbCrLf & directorytowrite & filetowrite & vbCrLf & "Click here to open file.", ToolTipIcon.Info)
                'NotifyIcon.Tag = Nothing

            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence ProcessRatingAnalysis: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try

            ratingFile1 = String.Empty
            ratingFile2 = String.Empty
            ratingFile3 = String.Empty

            RATING_FILE1_IND.Value = KineticaRT.Values.Values.False
            RATING_FILE2_IND.Value = KineticaRT.Values.Values.False
            RATING_FILE3_IND.Value = KineticaRT.Values.Values.False

        End Sub

        ''' <summary>
        ''' Releases COM objects in this case EXCEL objects
        ''' </summary>
        ''' <param name="obj"></param>
        ''' <remarks></remarks>
        Private Sub ReleaseMyObject(ByVal obj As Object)
            Try
                System.Runtime.InteropServices.Marshal.ReleaseComObject(obj)
                obj = Nothing
            Catch ex As Exception
                obj = Nothing
            Finally
                GC.Collect()
            End Try
        End Sub

        ''' <summary>
        ''' Provides the Dyno TQ value of the filepath
        ''' </summary>
        ''' <param name="filepath">File path location of the file to be analyze</param>
        ''' <returns>a String with the Mech Torque in SHP</returns>
        ''' <remarks></remarks>
        Private Function GetDynoTQ(ByVal filepath As String) As String
            Dim result As String = "N/A"
            Dim d() As Decimal

            Try
                d = GetPerfData(filepath)
                result = d(6).ToString()
            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83025_Sequence.GetDynoTQ: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try

            Return result
        End Function

        ''' <summary>
        ''' Function to handle the click on the Notify Icon
        ''' </summary>
        ''' <remarks></remarks>
        Public Shared Sub OnNotifyIconBalloonTipClicked() Handles NotifyIcon.Click
            Try

                If Not IsNothing(NotifyIcon.Tag) Then
                    If NotifyIcon.Tag.ToString.ToLower.EndsWith("xls") Then
                        Dim filename As String = NotifyIcon.Tag.ToString
                        If File.Exists(filename) Then 'Open EXCEL

                            Dim excelProcess As Process = New Process()
                            excelProcess.StartInfo.FileName = "excel.exe"
                            excelProcess.StartInfo.Arguments = """" & filename & """"
                            excelProcess.Start()

                        End If
                    Else
                        Dim directoryPath As String = NotifyIcon.Tag.ToString
                        If Directory.Exists(directoryPath) Then 'Open EXPLORER
                            Process.Start("explorer.exe", directoryPath)
                        End If
                    End If
                    NotifyIcon.Visible = False ' hide the icon when it has a value
                End If
                NotifyIcon.Tag = Nothing
            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83025.OnNotifyIconBalloonTipClicked: " + ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub OnBTN_50PC_TORQUE_TRIM(sender As IChannel, newVal As Value)
            Try
                If (newVal Is Values.True) And CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                    Var_Dyno_Tq_50PC = CSng(DYNO_TORQUE_LBSFT.Value.ToDouble())

                    If perfTMscu Then
                        Var_SCU_AFU_AFC_Tq_50PC = CSng(TORQUE_SCU.Value.ToDouble())
                    ElseIf perfTMafu Then
                        Var_SCU_AFU_AFC_Tq_50PC = CSng(TORQUE_AFU.Value.ToDouble())
                    ElseIf perfTMafc Then
                        Var_SCU_AFU_AFC_Tq_50PC = CSng(TORQUE_AFC.Value.ToDouble())
                    Else
                        Var_SCU_AFU_AFC_Tq_50PC = 0.0
                        clsTopMostMessageBox.Show("PWC83000_Sequence : OnBTN_50PC_TORQUE_TRIM()" & vbCrLf _
                                                  & "Unknown Torque System" _
                                                  , "Error on Torque system", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    End If

                    If perfTMeec Then
                        Var_EEC_Tq_50PC = CSng(TORQUE_EEC.Value.ToDouble())
                    Else
                        Var_EEC_Tq_50PC = 0.0
                    End If

                End If
            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : OnBTN_50PC_TORQUE_TRIM()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub OnBTN_CLEAR_TORQUE_TRIM(sender As IChannel, newVal As Value)

            Try
                If (newVal Is Values.True) And CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then
                    PERF_50PC_TORQUE_TRIM_BTN.Value = Values.False
                    PERF_TO_TORQUE_TRIM_BTN.Value = Values.False
                    PERF_CLEAR_TORQUE_TRIM_BTN.Value = Values.False

                    Var_Dyno_Tq_50PC = 0
                    Var_Dyno_Tq_TO = 0

                    Var_SCU_AFU_AFC_Tq_50PC = 0
                    Var_SCU_AFU_AFC_Tq_TO = 0

                    Var_EEC_Tq_50PC = 0
                    Var_EEC_Tq_TO = 0

                End If
            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : OnBTN_CLEAR_TORQUE_TRIM()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub OnBTN_PERFORMANCE_RUN(sender As IChannel, newVal As Value)
            Try
                If (CELProject.IsTrue(newVal)) And CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                    'Update User Inputs
                    RefreshUserInputs(CELProject)

                    'Update LOG_PERF_ Values
                    CELProject.LogPerfSynch.UpdateValues()
                    FlowmeterCtrl.ComputeFlow(True)

                    'Take Log Point
                    CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, False, CELProject.EngineModel, True)

                    'Process Condition
                    CaptureValues()
                    ProcessCondition()

                    Update30PResultSet(PerfFileName)

                    PERF_RUN_BTN.Value = Values.False
                End If
            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : OnBTN_PERFORMANCE_RUN" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub OnBTN_PERFORMANCE_RESET(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                If (CELProject.IsTrue(newVal)) And CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then
                    PERF_CONDITION_NUMBER.Value = Values.One
                    REMARK_TEXT.Value = New KineticaRT.Values.Text("")
                    ReDim ProcessedResultSet(CInt(1))
                End If
                PERF_RESET_BTN.Value = Values.False
            Catch Ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : OnBTN_RESET()" & vbCrLf & "Error message: " & vbCrLf _
                                & Ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub OnBTN_TO_TORQUE_TRIM(sender As KineticaRT.Channels.IChannel, newVal As KineticaRT.Values.Value)
            Try
                If (newVal Is KineticaRT.Values.Values.True) And CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                    Var_Dyno_Tq_TO = CSng(DYNO_TORQUE_LBSFT.Value.ToDouble())

                    If perfTMscu Then
                        Var_SCU_AFU_AFC_Tq_TO = CSng(TORQUE_SCU.Value.ToDouble())
                    ElseIf perfTMafu Then
                        Var_SCU_AFU_AFC_Tq_TO = CSng(TORQUE_AFU.Value.ToDouble())
                    ElseIf perfTMafc Then
                        Var_SCU_AFU_AFC_Tq_TO = CSng(TORQUE_AFC.Value.ToDouble())
                    Else
                        Var_SCU_AFU_AFC_Tq_TO = 0.0
                        clsTopMostMessageBox.Show("PWC83000_Sequence : OnBTN_TO_TORQUE_TRIM()" & vbCrLf _
                                                  & "Unknown Torque System" _
                                                  , "Error on Torque system", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    End If

                    If perfTMeec Then
                        Var_EEC_Tq_TO = CSng(TORQUE_EEC.Value.ToDouble())
                    Else
