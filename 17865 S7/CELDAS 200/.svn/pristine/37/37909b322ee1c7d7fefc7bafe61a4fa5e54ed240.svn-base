            Else
                pwc83000.PutValue("T8", Var_T_TT83_DEGF.ToString(), "3")
            End If
            If T_T8_4_DELETE_BTN.Value.ToString() = "True" Then
                pwc83000.PutValue("T8", "-10001.000", "4")
