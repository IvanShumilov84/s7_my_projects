                'Var_T_TT830_DEGF = TT830.Value.ToDouble()
                'Var_T_TT831_DEGF = TT831.Value.ToDouble()
                'Var_T_TT832_DEGF = TT832.Value.ToDouble()

                Var_T_TT3_DEGF = TT3.Value.ToDouble()
                Var_T_TB1_DEGF = TB1.Value.ToDouble()

                Var_P_PS3_PSIA = PS3_PSIA.Value.ToDouble()
                Var_P_MOP_PSIA = MOP.Value.ToDouble()
                Var_P_P1T1_PSIA = P1T1_PSIA.Value.ToDouble()
                Var_P_PS25_PSIA = P25_PSIA.Value.ToDouble()
                Var_P_PS8_PSIA = PS8_PSIA.Value.ToDouble()
                Var_P_PB1_PSIA = PB1_PSIA.Value.ToDouble()
                Var_P_PB2_PSIG = PB2_PSIG.Value.ToDouble()

                Var_SG = LOG_PERF_FM1_DENSITY_LBGAL.Value.ToDouble()

                Var_P_AGB_PSIG = P_AGB_PSIG.Value.ToDouble()
                Var_P_RGB_PSIG = P_RGB_PSIG.Value.ToDouble()

                If pwcPerformanceTestMode Then
                    'Testing PW118A Cond 5 2004/04/26
                    'Facility
                    Var_T_FUEL_DEGF = 72.1
                    Var_WF1_PPH = 889.1
                    Var_WF2_PPH = 889.1
                    Var_P_BARO_PSIA = 14.62
                    'TORQUE & POWER
                    Var_DYNO_TORQUE_LBSFT = 7148.6
                    Var_TORQUE_EEC_LBSFT = 470        'In this example is variable is not use so zero value for PW118A
                    Var_TORQUE_AFU_LBSFT = 473.9        'In this example is variable is not use so zero value for PW118A
                    Var_TORQUE_SCU_LBSFT = 473.9    'New variable Var_TORQUE_SCU_LBSFT for PW118A
                    Var_TORQUE_AFC_LBSFT = 473.9

                    'SPEEDS & VIBRATIONS
                    Var_NH_RPM = 32251.4
                    Var_NL_RPM = 26586.4
                    Var_NPT_RPM = 20337.7
                    'TEMPERATURES
                    Var_T_TT11_DEGF = 77.9
                    Var_T_TT12_DEGF = 75.9
                    Var_T_TT13_DEGF = 75.2
                    Var_T_TT14_DEGF = 75.7
                    Var_T_TT15_DEGF = 76.9

                    Var_T_MOT_DEGF = 195
                    Var_T_T6H_DEGF = 1010.53

                    Var_T_TT81_DEGF = 660.3
                    Var_T_TT82_DEGF = 660.26
                    Var_T_TT83_DEGF = 660.26
                    Var_T_TT84_DEGF = 660.3
                    Var_T_TT85_DEGF = 660.3
                    Var_T_TT86_DEGF = 660.26
                    Var_T_TT87_DEGF = 660.26
                    Var_T_TT88_DEGF = 660.3

                    Var_T_TT3_DEGF = 720
                    Var_T_TB1_DEGF = 0.0            'In this example is variable is not use so zero value for PW118A
                    'PRESSURES
                    Var_P_PS3_PSIA = 156.32
                    Var_P_MOP_PSIA = 77.32 ' this value was gravitational 62.7 so psia is 77.32
                    Var_P_P1T1_PSIA = 14.652
                    Var_P_PS25_PSIA = 52.51
                    Var_P_PS8_PSIA = 14.58
                    Var_P_PB1_PSIA = 0.0            'In this example is variable is not use so zero value for PW118A
                    Var_P_PB2_PSIG = 0.0            'In this example is variable is not use so zero value for PW118A
                End If

            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : SampleValues()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub ShowOutputFile(fileName As String)
            Dim DetailsForm As CEL.Forms.DisplayFile = Nothing

            Try
                DetailsForm = New CEL.Forms.DisplayFile(fileName)

                DetailsForm.MinimizeBox = False
                DetailsForm.MaximizeBox = False
                DetailsForm.Text = fileName
                DetailsForm.StartPosition = FormStartPosition.Manual
                DetailsForm.Location = New Point(3040, 0)
                DetailsForm.Height = 1080
                DetailsForm.ShowDialog()
            Catch e As Exception
                MsgBox(e.ToString(), MsgBoxStyle.OkOnly Or MsgBoxStyle.Critical,
                    fileName)
            Finally
                If (Not (DetailsForm Is Nothing)) Then
                    DetailsForm.Dispose()
                End If
            End Try
        End Sub

        Private Sub SetUnitValues()
            Dim i As Integer

            For i = UnitValues.GetLowerBound(0) To UnitValues.GetUpperBound(0)
                If Not pwc83000.PutUnitValue(UnitValues(i, 0), UnitValues(i, 1), "") Then
                    clsTopMostMessageBox.Show("PW83000_Sequence() SetUnitValues: Unknown label Or unit '" +
                        UnitValues(i, 0) + "' (" + UnitValues(i, 1) + ")", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                End If
            Next
        End Sub

        Private Sub SetRatingValues()
            Dim i As Integer
            Dim iLimit As Integer = 1
            Try
                For i = ratingLimits.GetLowerBound(0) To ratingLimits.GetUpperBound(0)

                    If ratingLimits(i, 0).ToString() = EngineModel Then
                        If iLimit = 1 Then
                            ratingLOLO = Decimal.Parse(ratingLimits(i, 1).ToString(), NumberStyles.AllowDecimalPoint)
                            iLimit = 2
                        ElseIf iLimit = 2 Then
                            ratingLOMID = Decimal.Parse(ratingLimits(i, 1).ToString())
                            iLimit = 3
                        ElseIf iLimit = 3 Then
                            ratingHIMID = Decimal.Parse(ratingLimits(i, 1).ToString())
                            iLimit = 4
                        ElseIf iLimit = 4 Then
                            ratingHIHI = Decimal.Parse(ratingLimits(i, 1).ToString())
                            iLimit = 5
                        ElseIf iLimit = 5 Then
                            ratingCalcPoint = Decimal.Parse(ratingLimits(i, 1).ToString())
                            Exit Sub
                        Else
                            clsTopMostMessageBox.Show("PWC83000_Sequence : SetRatingValues() iLimit is unknown", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            Exit Sub
                        End If

                    End If

                Next
            Catch ex As Exception
                clsTopMostMessageBox.Show("PWC83000_Sequence : SetRatingValues()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try

        End Sub

        Private Sub SubmitPerfValues()

            pwc83000.SetEngine(UserInputEngineSN)

            pwc83000.PutValue("DATE", Format(Now, "yyyy/MM/dd"), "")
            pwc83000.PutValue("TIME", Format(Now, "hh:mm"), "")
            pwc83000.PutValue("CELL", "Test Cell", "")
            'Write the Remarks
            pwc83000.PutValue("REMARK ", EngineModel & " " & REMARK_TEXT.Value.ToString(), "")
            pwc83000.PutValue("WORK", UserInputWorkOrder, "")

            If UserInputTestType = "Overhaul" Then
                pwc83000.PutValue("TEST_TYPE", "OVERHAUL", "")
            ElseIf UserInputTestType = "Repair" Then
                pwc83000.PutValue("TEST_TYPE", "REPAIR", "")
            ElseIf UserInputTestType = "HSI" Then
                pwc83000.PutValue("TEST_TYPE", "HSI", "")
            ElseIf UserInputTestType = "As Received" Then
                pwc83000.PutValue("TEST_TYPE", "ASRECEIVED", "")
            Else
                clsTopMostMessageBox.Show("PWC83000_Sequence : SubmitPerfValues()" & vbCrLf &
                                "UserInputTestType is unknown: " & UserInputTestType, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Exit Sub
            End If

            If UserInputLimits = "Overhaul new" Then
                pwc83000.PutValue("LIM_CODE", "1", "")
            ElseIf UserInputLimits = "Overhaul Refurbish or HS" Then
                pwc83000.PutValue("LIM_CODE", "2", "")
            ElseIf UserInputLimits = "Non gas path repair" Then
                pwc83000.PutValue("LIM_CODE", "3", "")
            Else
                clsTopMostMessageBox.Show("PWC83000_Sequence : SubmitPerfValues()" & vbCrLf &
                                "UserInputTestType is unknown: " & UserInputLimits, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Exit Sub
            End If

            If T6_TRIM_ANSWER.Value.ToString() = "True" Then
                pwc83000.PutValue("T6_TRIM_ANSWER", "Y", "")
            Else
                pwc83000.PutValue("T6_TRIM_ANSWER", "N", "")
            End If

            'Values for TSG, TF1 & TF2 is hardcoded because no correction on SG is required by the PWC program
            'Similarly, SG and SG_BASE have the same value.
            pwc83000.PutValue("TSG", "59", "")
            pwc83000.PutValue("SG", Var_SG, "")
            pwc83000.PutValue("SG_BASE", Var_SG, "")
            pwc83000.PutValue("TF1", "59", "")
            pwc83000.PutValue("TF2", "59", "")
            'Write the LHV value (BTU/LB)
            pwc83000.PutValue("LHV", UserInputLHV, "")

            'Write the TDP (DegF)
            If CELProject.IsTrue(PERF_DEW_PT_METHOD_CHKBOX.Value) Then
                pwc83000.PutValue("TDWPT", PERF_T_DEW_PT_DEGF_INPUT.Value.ToString(), "")
                pwc83000.PutValue("TREFTEMP", PERF_T_REF_TEMP_DEGF_INPUT.Value.ToString(), "")
            Else
                pwc83000.PutValue("TDWPT", PERF_T_DEW_PT_DEGF.Value.ToString(), "")
                pwc83000.PutValue("TREFTEMP", PERF_T_REF_TEMP_DEGF.Value.ToString(), "")
            End If
            
            'Write the Vane Areas
            pwc83000.PutValue("VANE_AREA1", VANE_AREA1.Value.ToString(), "")
            pwc83000.PutValue("VANE_AREA2", VANE_AREA2.Value.ToString(), "")
            pwc83000.PutValue("VANE_AREA3", VANE_AREA3.Value.ToString(), "")
            'Write the R1 resistor value (ohm)
            pwc83000.PutValue("R1_RESIS", PERF_RESISTANCE_R1_OHM.Value.ToString(), "")
            'Write the NH Value (RPM)
            pwc83000.PutValue("NH", Var_NH_RPM.ToString(), "")
            'Write the NL Value (RPM)
            pwc83000.PutValue("NL", Var_NL_RPM.ToString(), "")
            'Write the NP Value (RPM)
            pwc83000.PutValue("NPT", Var_NPT_RPM.ToString(), "")
            'Write the WF Value (Lbm/hr)
            pwc83000.PutValue("WF1", Var_WF1_PPH.ToString(), "")
            pwc83000.PutValue("WF2", Var_WF2_PPH.ToString(), "")

            pwc83000.PutValue("P1T", Var_P_P1T1_PSIA.ToString(), "")
            'Write the PS8 Value (psia)
            pwc83000.PutValue("P8S", Var_P_PS8_PSIA.ToString(), "")
            'Write the PS3 Value (psia)
            pwc83000.PutValue("P3S", Var_P_PS3_PSIA.ToString(), "")
            'Write the TT3 Value (DegC)
            pwc83000.PutValue("T3", Var_T_TT3_DEGF.ToString(), "")
            'Write the PAM Value (psia)
            pwc83000.PutValue("BARO", Var_P_BARO_PSIA.ToString(), "")
            'Write the T6H Value (DegC)
            pwc83000.PutValue("T6H", Var_T_T6H_DEGF.ToString(), "")
            'Write the P25 Value (psia) 
            pwc83000.PutValue("P25", Var_P_PS25_PSIA.ToString(), "")
            'Write the TB1 Value (DegC)
            pwc83000.PutValue("TB1", Var_T_TB1_DEGF.ToString(), "")
            'Write the PB1 Value (psia)
            pwc83000.PutValue("PB1", Var_P_PB1_PSIA.ToString(), "")
            'Write the PB2 Value (psig) PB2 = PB1- BARO  Confirmé par Francis Boyte de chez Pratt
            pwc83000.PutValue("PB2", Var_P_PB2_PSIG.ToString(), "")

            'Write the MOP Value (psia)
            pwc83000.PutValue("MOP", Var_P_MOP_PSIA.ToString(), "")
            'Write the MOT Value (DegC)
            pwc83000.PutValue("MOT", Var_T_MOT_DEGF.ToString(), "")
            'Write the P1T Value (psia)

            'AGB oil pressure (not required, not used in calculations) Selon la doc de la DLL de Pratt
            pwc83000.PutValue("PAGB", Var_P_AGB_PSIG.ToString(), "")
            'RGB oil pressure (not required, not used in calculations) Selon la doc de la DLL de Pratt
            pwc83000.PutValue("PRGB", Var_P_RGB_PSIG.ToString(), "")

            'Write the QDyno Value (Lbsft)
            pwc83000.PutValue("DYNO_TQ", Var_DYNO_TORQUE_LBSFT.ToString(), "")

            'New variable for PW118A engines which have SCU engine torque system
            If perfTMscu Then
                pwc83000.PutValue("TMSCU", Var_TORQUE_SCU_LBSFT.ToString(), "")
            End If

            'Write the Q_AFU value (Lbsft) Engine Torque 
            '(* From P&WC ICD PWC38298, for a PW123AF there is no Arinc Torque, Target Torque and Torque A *)
            '(* From P&WC ICD PWC38298, for a PW123AF there is only a Torque B with 0V = 0 lbft, 5V = 10750 lbsft *)
            If perfTMafu Then
                pwc83000.PutValue("TMAFU", Var_TORQUE_AFU_LBSFT.ToString(), "")
            End If

            'Dans le manuel moteur il n'y a pas de reference a TORQUE AFU. Meme si la variable dans le workbench est Torque_AFU, il faut
            'prendre cette valeur et la la pousser dans le parametre TMAFC de la DLL pour le PW123AF
            'pas bonpwc83000.PutValue("TMAFU", Var_TORQUE_AFU.ToString(), "")
            '(* From P&WC ICD PWC38298, for a PW123AF there is no Arinc Torque, Target Torque and Torque A *)
            'FROM CELDAS100 00937
            'Write the Q_EEC Value
            'Print #1, TheseVariables.Item("UUT_Cruncher_Smooth_EEC_Torque").Value

            '(* From P&WC ICD PWC38298, for a PW123AF there is no Arinc Torque, Target Torque and Torque A *)
            'FROM CELDAS100 00937
            'Write the Target Torque Value
            'Print #1, TheseVariables.Item("UUT_Cruncher_Smooth_Target_Torque").Value
            If perfTMeec Then
                pwc83000.PutValue("TMEEC", Var_TORQUE_EEC_LBSFT.ToString(), "")
            End If

            'This variable seems to be only applicable to engine PW123AF
            If perfTMafc Then
                pwc83000.PutValue("TMAFC", Var_TORQUE_AFC_LBSFT.ToString(), "")
            End If

            'Write the TT1 Values
            If T_T1_1_DELETE_BTN.Value.ToString() = "True" Then
                pwc83000.PutValue("T1", "-10001.000", "1")
            Else
                pwc83000.PutValue("T1", Var_T_TT11_DEGF.ToString(), "1")
            End If
            If T_T1_2_DELETE_BTN.Value.ToString() = "True" Then
                pwc83000.PutValue("T1", "-10001.000", "2")
            Else
                pwc83000.PutValue("T1", Var_T_TT12_DEGF.ToString(), "2")
            End If
            If T_T1_3_DELETE_BTN.Value.ToString() = "True" Then
                pwc83000.PutValue("T1", "-10001.000", "3")
            Else
                pwc83000.PutValue("T1", Var_T_TT13_DEGF.ToString(), "3")
            End If
            If T_T1_4_DELETE_BTN.Value.ToString() = "True" Then
                pwc83000.PutValue("T1", "-10001.000", "4")
            Else
                pwc83000.PutValue("T1", Var_T_TT14_DEGF.ToString(), "4")
            End If
            If T_T1_5_DELETE_BTN.Value.ToString() = "True" Then
                pwc83000.PutValue("T1", "-10001.000", "5")
            Else
                pwc83000.PutValue("T1", Var_T_TT15_DEGF.ToString(), "5")
            End If

            'Write the TT8 Values
            If T_T8_1_DELETE_BTN.Value.ToString() = "True" Then
                pwc83000.PutValue("T8", "-10001.000", "1")
            Else
                pwc83000.PutValue("T8", Var_T_TT81_DEGF.ToString(), "1")
