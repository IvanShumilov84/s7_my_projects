        Private Sub OnUPS_ON_BATTERY_MAX_TIME_REACHED(ByVal sender As IChannel, ByVal newVal As Value)
            Try

                If CELProject.IsTrue(newVal) And CELProject.IsTrue(EEC_PMS_FLY_BTN.Value) Then
                    EEC_PMS_IDLE_BTN.Value = KineticaRT_TRUE
                End If
            Catch Ex As Exception
                MessageBox.Show("OnUPS_ON_BATTERY_MAX_TIME_REACHED : " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnACCEL_CHECK_OPEN_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value) Implements IAccelCheckScreen.OnACCEL_CHECK_OPEN_WINDOW_BTN
            Try
                If CELProject.IsTrue(newVal) Then
                    CELProject.ActivateForm("PW210_AccelCheck_Screen", "PW210_Master_Screen", True, False)
                    'Reset Button
                    ACCEL_CHECK_OPEN_WINDOW_BTN.Value = KineticaRT.Values.Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("OnACCEL_CHECK_OPEN_WINDOW_BTN: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnACCEL_CHECK_CLOSE_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value) Implements IAccelCheckScreen.OnACCEL_CHECK_CLOSE_WINDOW_BTN
            Try
                If CELProject.IsTrue(newVal) Then
                    CELProject.ActivateForm("PW210_AccelCheck_Screen", "PW210_Master_Screen", False, False)
                    'Reset Button
                    ACCEL_CHECK_CLOSE_WINDOW_BTN.Value = KineticaRT.Values.Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("OnACCEL_CHECK_CLOSE_WINDOW_BTN: " & Ex.ToString())
            Finally
            End Try
        End Sub

