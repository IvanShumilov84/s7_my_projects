            AddHandler DYNO_SPEED_DEMAND.ValueChanged, AddressOf OnDYNO_DEMAND_VALIDATE
            AddHandler DYNO_TORQUE_DEMAND.ValueChanged, AddressOf OnDYNO_DEMAND_VALIDATE
            AddHandler NEW_TEST_BTN.ValueChanged, AddressOf OnNEW_TEST_BTN


            If CELProject.EngineModel.Equals("PW210A") Then
                AddHandler UPS_ON_BATTERY_MAX_TIME_REACHED.ValueChanged, AddressOf OnUPS_ON_BATTERY_MAX_TIME_REACHED
            End If

        End Sub

        Protected Overrides Sub RemoveHandlers()

            If Not (CLOSE_TEST_BTN_OPC Is Nothing) Then
                RemoveHandler CLOSE_TEST_BTN_OPC.ValueChanged, AddressOf OnCLOSE_TEST_BTN
            End If

            If Not (ACCEL_CHECK_CLOSE_WINDOW_BTN Is Nothing) Then
                RemoveHandler ACCEL_CHECK_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnACCEL_CHECK_CLOSE_WINDOW_BTN
            End If
            If Not (ACCEL_CHECK_OPEN_WINDOW_BTN Is Nothing) Then
                RemoveHandler ACCEL_CHECK_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnACCEL_CHECK_OPEN_WINDOW_BTN
            End If
            If Not (CELProject.LOG_TAKE_POINT_BTN Is Nothing) Then
                RemoveHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            End If
            If Not (CELProject.DIAGNOSTIC_ENGINE_CLOSE_WINDOW_BTN Is Nothing) Then
