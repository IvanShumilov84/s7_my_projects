        Private Function ProcessQ13TrimReport(ByVal SearchPath As String, ByVal TemplateFullFileName As String, ByVal UpdateQ13TrimReportCallBack As UpdateQ13TrimReportFPtr, Optional ByVal BackupPath As String = "") As Boolean
            'Variable Declaration
            Dim filename As String
            Dim backupFilename As String
            Dim newFilename As String = ""
            Dim dirs As String()
            Dim exist As Boolean
            Dim workbookPath As String
            Dim excelWorkbook As Excel.Workbook = Nothing
            Dim appendOption As Boolean
            Dim newFileCreated As Boolean = False

            Try

                dirs = Directory.GetFiles(SearchPath, "*Q13 Trim*.xlsx")
                Array.Sort(dirs)

                If dirs.Length > 0 Then
                    filename = dirs(dirs.GetUpperBound(0))
                Else
                    filename = ""
                End If

                Dim fileInUse As Boolean = False

                'Check if the file exist, if not create one
                exist = File.Exists(filename)

                If exist = False Then
                    CELProject.New_Trim_Required = True
                Else
                    fileInUse = FileAndFolderHelper.FileAlreadyInUse(filename)
                End If

                If Not fileInUse Then
                    If Not CELProject.New_Trim_Required Then

                        '****************Open and Append to the the Q13 Trim Report the Last Trim Point****************'

                        ' The following code opens an existing workbook
                        workbookPath = System.IO.Path.GetFullPath(filename)

                        backupFilename = System.IO.Path.GetFileName(filename)

                        Try
                            excelWorkbook = CELDAS.ExcelApplication.Workbooks.Open(workbookPath, 0, False, 5, "", "", False, Excel.XlPlatform.xlWindows, "", True, False, 0, True, False, False)
                        Catch exception As System.Exception
                            System.Diagnostics.Trace.WriteLine("Opening Excel: " + exception.Message)
                            MessageBox.Show(exception.Message)
                        End Try

                        If Not (excelWorkbook Is Nothing) Then

                            '****************Open the Last Q13 Trim Report Object****************'
                            appendOption = True

                            If UpdateQ13TrimReportCallBack.Invoke(appendOption, TestCase, excelWorkbook) = False Then
                                MessageBox.Show("Q13 Trim Report has generated an error.  The report will not be saved!", "Warning", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                                Exit Function
                            End If

                            excelWorkbook.Save()

                            If BackupPath <> "" Then  'Optional for HS 
                                If Not My.Computer.FileSystem.DirectoryExists(BackupPath) Then
                                    My.Computer.FileSystem.CreateDirectory(BackupPath)
                                End If

                                excelWorkbook.SaveAs(BackupPath + backupFilename)
                            End If

                        End If
                    Else
                        workbookPath = TemplateFullFileName
                        Try
                            excelWorkbook = CELDAS.ExcelApplication.Workbooks.Open(workbookPath, 0, False, 5, "", "", False, Excel.XlPlatform.xlWindows, "", True, False, 0, True, False, False)
                        Catch exception As System.Exception
                            System.Diagnostics.Trace.WriteLine("Opening Excel: " + exception.Message)
                            MessageBox.Show(exception.Message)
                        End Try

                        appendOption = False 'Creating New One

                        If UpdateQ13TrimReportCallBack.Invoke(appendOption, TestCase, excelWorkbook) = False Then
                            MessageBox.Show("Q13 Trim Report has generated an error.  The report will not be saved!", "Warning", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                        Else
                            'Create the new File
                            newFilename = CELProject.EngineModel + " Q13 Trim" + Format(Now, " yyyy MM dd HH,mm,ss")
                            filename = SearchPath + newFilename + ".xlsx"
                            excelWorkbook.SaveAs(filename)

                            'NewFileCreated = True
                        End If

                        If BackupPath <> "" Then 'Optional for HS 
                            If Not My.Computer.FileSystem.DirectoryExists(BackupPath) Then
                                My.Computer.FileSystem.CreateDirectory(BackupPath)
                            End If
                            excelWorkbook.SaveAs(BackupPath + newFilename + ".xlsx")
                        End If

                        CELProject.New_Trim_Required = False

                    End If
                    excelWorkbook.Close()
                    CELDAS.NotifyIcon.Tag = filename 'Path.GetDirectoryName(filename)
                    CELDAS.NotifyIcon.ShowBalloonTip(3000, CELProject.TechnologyName, "New Q13 Trim file successfully generated" + vbCrLf + "Click here to open file.", ToolTipIcon.Info)

                    ProcessQ13TrimReport = True

                Else

                    CELDAS.NotifyIcon.ShowBalloonTip(0, CELProject.TechnologyName, "Q13 Trim point cannot be recorded: The report file is already in use.  Please close Microsoft Excel and try again.", ToolTipIcon.Error)

                End If

            Catch ex As Exception
                MessageBox.Show("ProcessQ13TrimReport: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally

            End Try
        End Function

        Private Sub RevimaWriteRunningTime(ByVal excelSheets As Excel.Sheets)

            Try
                Dim excelWorksheet As Excel.Worksheet = excelSheets.Item("APU CONDITION TEST SHEET")

                Dim FuelUsed As Double = PERF_PREVIOUS_TEST_FUEL_USED.Value.ToDouble() + LOG_PERF_FUEL_USED_LITERS.Value.ToDouble()
                Dim OperatingTime As Double = PERF_PREVIOUS_TEST_MINUTES.Value.ToDouble() + LOG_PERF_OPERATING_TIME_MINUTES.Value.ToDouble()

                'Running Time, cellule I8
                excelWorksheet.Cells(8, 9).Value = OperatingTime.ToString(LOG_PERF_OPERATING_TIME_MINUTES.Format) + " " + LOG_PERF_OPERATING_TIME_MINUTES.Units.ToString()

                'Fuel Used, cellule I11
                excelWorksheet.Cells(11, 9).NumberFormat = "@"
                excelWorksheet.Cells(11, 9).Value = FuelUsed.ToString(LOG_PERF_FUEL_USED_LITERS.Format) + " " + LOG_PERF_FUEL_USED_LITERS.Units.ToString()

            Catch Ex As Exception
                MessageBox.Show("RevimaWriteRunningTime: " & Ex.ToString())
            End Try
        End Sub

		Private Delegate Function UpdateQ13TrimReportFPtr(ByVal AppendOption As Boolean, ByVal TestCase As Integer, ByRef ExcelWorkbook As Excel.Workbook) As Boolean

        Private Function CreateCustomHeaderLogFile(ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Try
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Date Time:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Cond#:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Comment:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                ExcelWorksheet.Rows(RowIndex).RowHeight = 65.25
                ExcelWorksheet.Rows(RowIndex).VerticalAlignment = Excel.XlVAlign.xlVAlignTop
                ExcelWorksheet.Rows(RowIndex).WrapText = True

                Return True

            Catch ex As Exception
                MessageBox.Show("CreateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        Public Function UpdateCustomHeaderLogFile(ByVal AppendOption As Boolean, ByVal IsPerfEntry As Boolean, ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Try
                Dim Log_Condition As Integer

                If AppendOption = False Then
                    Log_Condition = 1
                Else
                    Log_Condition = ExcelWorksheet.Cells(RowIndex + 1, ExcelWorksheet.Columns.Count).End(Excel.XlDirection.xlToLeft).Column - 1
                    Log_Condition = Log_Condition + 1

                End If

                If ((Log_Condition > 1) And ((Log_Condition Mod 5) = 1)) Then

                    'Repeat The Test Spec For this new sets of condition

                    With ExcelWorksheet
                        .Range(.Cells(2, 2), .Cells(RowIndex - 2, 6)).Copy(.Cells(2, Log_Condition + 1))
                    End With
                End If

                ColumnIndex = 1 + Log_Condition

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Format(Now, "yyyy/MM/dd HH:mm:ss")
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Log_Condition.ToString()
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                If IsPerfEntry = False Then
                    Dim CommentText As String = ""
                    Dim InputObject As New InputCommentForm
                    InputObject.ShowDialog("Log Report", "Comment:", "", CommentText)

                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = CommentText
                Else
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "STEP: " & TestStep_List.SelectedItem
                End If

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 2
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Values"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignCenter

            Catch ex As Exception
                MessageBox.Show("UpdateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        Protected Overrides Sub OnEngineWorkingThread()

            'WB_CALC_PPM Update
            Compute_PW980A(False)

            'Make sure FM_INITIAL_VOLUME_LITERS is different than 0
            ValidateFMInitialValue()

            If Q13SetUpTrimInProgress Then
                CaptureSCVTransit()
            End If

            'Persistent Values Save Check
            PW980APersistentValuesCtrl.SavePersistentValues()

        End Sub

		Private Function Compute_BleedAirFlow(ByVal TOrifice_DEGF As Double, _
											  ByVal POrifice_PSIA As Double, _
											  ByVal POrificeDelta_PSID As Double) As Double
			Try

				If CELProject.IsTrue(BLEED_BTN.Value) Then

					Dim BleedAirFLow As Double = CELProject.GetBleedAirFlow( _
																			EngineConfiguration.DuctDiameter, _
																			EngineConfiguration.DuctDiameterUnit, _
																			EngineConfiguration.OrificeDiameter, _
																			EngineConfiguration.OrificeDiameterUnit, _
																			TOrifice_DEGF, _
																			CELDAS.eTemperature.Fahrenheit, _
																			POrifice_PSIA, _
																			CELDAS.ePressure.PSI, _
																			POrificeDelta_PSID, _
																			CELDAS.ePressure.PSI, _
                                                                            EngineConfiguration.OrificeThinkness, _
                                                                            EngineConfiguration.OrificeThinknessUnit, _
																			EngineConfiguration.TapArrangement, _
																			CELDAS.eFlowMass.LbByMin)

					Return BleedAirFLow

				Else
					Return 0.0
				End If

			Catch Ex As Exception
				'Log error
				MessageBox.Show("Error in Engine_Sequence.Compute_BleedAirFlow: " & Ex.ToString)
			End Try

		End Function

	    Private Sub OnAcceleratingTime_Calc(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If (sender.Name = "START_BTN") Then
                    If CELProject.IsTrue(newVal) Then
                        ts_accelerating_time = New System.TimeSpan(0, 0, 0, 0, 0)
                        AcceleratingTime_Start = Now
                        APU_ACCELERATING = True
                        PERF_T09_AVG.Value = New KineticaRT.Values.Double(T_T09_AVG_DEGC.Value.ToDouble())
                    End If
                End If

                If (sender.Name = "APU_READY_IND") Then
                    If CELProject.IsTrue(newVal) Then
                        APU_ACCELERATING = False
                    End If
                End If

                If (sender.Name = "RUN_STOP_BTN") Then
                    If CELProject.IsFalse(newVal) Then
                        APU_ACCELERATING = False
                    End If
                End If

                If (sender.Name = "STARTER_RECTIFIER_BTN") Then
                    If CELProject.IsFalse(newVal) And N1_PCT.Value.ToDouble() < 5.0 Then
                        APU_ACCELERATING = False
                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("OnAcceleratingTime_Calc: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub OnCaptureOilPressure(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    If CELProject.IsTrue(newVal) Then
                        PERF_ENGINE_OIL_PRESSURE.Value = New KineticaRT.Values.Double(E_MOP2_PSIA.Value.ToDouble())
                        PERF_GEN_OIL_PRESSURE.Value = New KineticaRT.Values.Double(E_GOP2_PSIA.Value.ToDouble())
                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("OnCaptureOilPressure: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub OnClose_Test(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    MyBase.StopWorkingThread()

                    'Persistent Values Force Save
                    PW980APersistentValuesCtrl.SavePersistentValues(True)

                    If Not (CELProject.CLOSE_TEST_BTN Is Nothing) Then
                        RemoveHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnClose_Test
                    End If

                    If Not (CELProject.LOG_TAKE_POINT_BTN Is Nothing) Then
                        RemoveHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
                    End If

                    If Not (CELProject.PERF_CLOSE_WINDOW_BTN Is Nothing) Then
                        RemoveHandler CELProject.PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
                    End If

                    If Not (CELProject.PERF_OPEN_WINDOW_BTN Is Nothing) Then
                        RemoveHandler CELProject.PERF_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnPERF_OPEN_WINDOW_BTN
                    End If

                    If Not (CELProject.PERF_TAKE_POINT_BTN Is Nothing) Then
                        RemoveHandler CELProject.PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN
                    End If

                    If Not (APU_READY_IND Is Nothing) Then
                        RemoveHandler APU_READY_IND.ValueChanged, AddressOf OnAcceleratingTime_Calc
                    End If

                    If Not (E_STOP_IND Is Nothing) Then
                        RemoveHandler E_STOP_IND.ValueChanged, AddressOf OnEStop
                        'RemoveHandler APU_READY_IND.ValueChanged, AddressOf OnAPUReady
                    End If

                    If Not (PERF_CAPTURE_OIL_PRESSURE_BTN Is Nothing) Then
                        RemoveHandler PERF_CAPTURE_OIL_PRESSURE_BTN.ValueChanged, AddressOf OnCaptureOilPressure
                    End If

                    If Not (PERF_Q13_SETUP_TRIM_BTN Is Nothing) Then
                        RemoveHandler PERF_Q13_SETUP_TRIM_BTN.ValueChanged, AddressOf OnQ13SetupTrim
                    End If

                    If Not (RUN_STOP_BTN Is Nothing) Then
                        RemoveHandler RUN_STOP_BTN.ValueChanged, AddressOf OnAcceleratingTime_Calc
                    End If

                    If Not (SMART_TERMINAL_BTN Is Nothing) Then
                        RemoveHandler SMART_TERMINAL_BTN.ValueChanged, AddressOf OnSMART_TERMINAL_BTN
                    End If

                    If Not (START_BTN Is Nothing) Then
                        RemoveHandler START_BTN.ValueChanged, AddressOf OnAcceleratingTime_Calc
                    End If

                    If Not (STARTER_RECTIFIER_BTN Is Nothing) Then
                        RemoveHandler STARTER_RECTIFIER_BTN.ValueChanged, AddressOf OnAcceleratingTime_Calc
                    End If

                    If Not (TestStep_List Is Nothing) Then
                        RemoveHandler TestStep_List.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged
                    End If

                    If Not (DeletableP09ChCtrl Is Nothing) Then
                        DeletableP09ChCtrl.Dispose()
                    End If

                    If Not (DeletableP17ChCtrl Is Nothing) Then
                        DeletableP17ChCtrl.Dispose()
                    End If

                    If Not (DeletableT09ChCtrl Is Nothing) Then
                        DeletableT09ChCtrl.Dispose()
                    End If

                    If Not (DeletableT17ChCtrl Is Nothing) Then
                        DeletableT17ChCtrl.Dispose()
                    End If

                    If Not (DeletableT7ChCtrl Is Nothing) Then
                        DeletableT7ChCtrl.Dispose()
                    End If

                    If Not (StarterMaxCurrentRecordCtrl Is Nothing) Then
                        StarterMaxCurrentRecordCtrl.Dispose()
                    End If

                    If Not (StarterMaxVoltageRecordCtrl Is Nothing) Then
                        StarterMaxVoltageRecordCtrl.Dispose()
                    End If

                    If Not (PW980APersistentValuesCtrl Is Nothing) Then
                        PW980APersistentValuesCtrl.Dispose()
                    End If

                    'Diposing of Nothing for now...
                    If Not (LoadAirCtrl Is Nothing) Then
                        LoadAirCtrl.Dispose()
                    End If

                    If Not (FuelRegulatorCtrl Is Nothing) Then
                        FuelRegulatorCtrl.Dispose()
                    End If

                    If Not (FlowmeterCtrl Is Nothing) Then
                        FlowmeterCtrl.Dispose()
                    End If

                End If

                CELProject.CLOSE_TEST_BTN.Value = Values.False

            Catch ex As Exception
                MessageBox.Show("OnClose_Test: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub OnEStop(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    EMER_SD_BTN.Value = Values.True
                End If

            Catch Ex As Exception
                MessageBox.Show("OnEStop: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnLOG_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    'Update the Log/Perf channel set
                    CELProject.LogPerfSynch.UpdateValues()

                    'Synchronize data for Log and Performance
                    Compute_PW980A(True)

                    CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, False, "PW980A", True)
                    CELProject.LOG_TAKE_POINT_BTN.Value = Values.False
                End If

            Catch Ex As Exception
                MessageBox.Show("OnLOG_TAKE_POINT_BTN: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnPERF_CLOSE_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    CELProject.ActivateForm("PW980A_Performance_Screen", CELProject.EngineModel.Replace("-", "_") + "_Screen", False, False)
                    CELProject.PERF_CLOSE_WINDOW_BTN.Value = Values.False
                End If

            Catch Ex As Exception
                MessageBox.Show("OnPERF_CLOSE_WINDOW_BTN: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnPERF_OPEN_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    CELProject.ActivateForm("PW980A_Performance_Screen", CELProject.EngineModel.Replace("-", "_") + "_Screen", True, False)
                    CELProject.PERF_OPEN_WINDOW_BTN.Value = Values.False
                End If

            Catch Ex As Exception
                MessageBox.Show("OnPERF_OPEN_WINDOW_BTN: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnPERF_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            Dim excelWorkbook As Excel.Workbook = Nothing

            Try
                If CELProject.IsTrue(newVal) Then

                    'Update the Log/Perf channel set
                    CELProject.LogPerfSynch.UpdateValues()

                    'Synchronize data for Log and Performance
                    Compute_PW980A(True)

                    Dim NewFileCreated As Boolean

                    If CELProject.Project.Number = "12917" Then 'Value Specific to the Revima project

                        Dim Revima12917TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                        'NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, Revima12917TemplateReportFullFileName, AddressOf CreateRevima12917PerformanceFile)

                    Else

                        Dim StandardCELTemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                        'NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, StandardCELTemplateReportFullFileName, AddressOf CreateStandardCELPerformanceFile)

                    End If

                    CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, True, "PW980A", NewFileCreated)

                    CELProject.PERF_TAKE_POINT_BTN.Value = Values.False
                End If

            Catch ex As Exception
                MessageBox.Show("OnPERF_TAKE_POINT_BTN: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally

            End Try
        End Sub

        Private Sub OnQ13SetupTrim(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                Dim IGVPos As Double = E_IGVACT_PCT.Value.ToDouble()

                If CELProject.IsTrue(newVal) Then

                    If IGVPos >= 21.75 And IGVPos <= 22.25 Then
                        TestCase = 1
                    ElseIf IGVPos >= 29.75 And IGVPos <= 30.25 Then
                        TestCase = 2
                    ElseIf IGVPos >= 39.75 And IGVPos <= 40.25 Then
                        TestCase = 3
                    ElseIf IGVPos >= 44.75 And IGVPos <= 45.25 Then
                        TestCase = 4
                    ElseIf IGVPos >= 49.75 And IGVPos <= 50.25 Then
                        TestCase = 5
                    ElseIf IGVPos >= 55.75 And IGVPos <= 56.25 Then
                        TestCase = 6
                    ElseIf IGVPos >= 59.75 And IGVPos <= 60.25 Then
                        TestCase = 7
                    ElseIf IGVPos >= 64.75 And IGVPos <= 65.25 Then
                        TestCase = 8
                    ElseIf IGVPos >= 69.75 And IGVPos <= 70.25 Then
                        TestCase = 9
                    ElseIf IGVPos >= 79.75 And IGVPos <= 80.25 Then
                        TestCase = 10
                    ElseIf IGVPos >= 85.75 And IGVPos <= 86.25 Then
                        TestCase = 11
                    Else
                        TestCase = -1
                        MessageBox.Show("Position de l'IGV invalide", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        PERF_Q13_SETUP_TRIM_BTN.Value = Values.False
                    End If
                Else
                    TestCase = -1
                End If
                Q13SetUpTrimInProgress = TestCase > 0

                If Q13SetUpTrimInProgress Then
                    Q13_TRIM_E_Q13.Value = New KineticaRT.Values.Text("")
                    Q13_TRIM_Q_LDC.Value = New KineticaRT.Values.Text("")
                End If

            Catch ex As Exception
                MessageBox.Show("OnQ13SetupTrim: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub OnSMART_TERMINAL_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            If (CELProject.IsTrue(newVal)) Then

                Try
                    System.Diagnostics.Process.Start(EngineConfiguration.SmartTerminalUtilityExeFile1)
                Catch ex As System.Exception
                    MessageBox.Show("Smart Terminal Button: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                End Try

                SMART_TERMINAL_BTN.Value = Values.False

            End If
        End Sub

        Private Sub OnTestStep_List_SelectedIndexChanged(ByVal sender As System.Object, ByVal e As System.EventArgs)
            Try
                CELProject.PERF_TEST_STEP_NB.Value = New KineticaRT.Values.Integer(TestStep_List.SelectedIndex)
                PERF_CONDITION_NUMBER.Value = New KineticaRT.Values.Integer(TestStep_List.SelectedIndex + 1)

            Catch ex As Exception
                MessageBox.Show("OnTestStep_List_SelectedIndexChanged: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

		Protected Overrides Sub OnTestSessionInitialized(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
			Try
				MyBase.OnTestSessionInitialized(newStatus)

				If CELProject.EngineModel = "PW980A" Then

					UserInputs.MapUserInputsParameters(CELProject)

                    CELProject.EngineSession.WorkingFolder = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + UserInputs.EngineSerialNumber + "\" + UserInputs.WorkOrder
					CELProject.CreateLogFile(AddressOf CreateCustomHeaderLogFile, "PW980A", CELProject.EngineModel)

                End If

			Catch ex As Exception
				MessageBox.Show("OnTestSessionInitialized: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
			End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)

            Catch ex As Exception

                MessageBox.Show("PW980A_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            End Try
        End Sub

		Protected Overrides Sub OnTestSessionRunning(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
			'Dim i As Integer
			Try
				MyBase.OnTestSessionRunning(newStatus)

				If CELProject.EngineModel = "PW980A" Then

					Init_Engine_Channels()

                    Init_Engine_Channels_Value()

                    'Init_Arrays()
					CELProject.LoadSave_Custom_Parameters(Custom_Parameters, False)

					CELProject.Perf_Nb_Sheet_To_Print = 3

					ConfigDeletableCtrls()

					ConfigMinMaxCtrls()

                    ConfigPersistentValues()

                    FlowmeterCtrl = New FlowmeterController(Me)

                    CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.Init_Engine_Controls))

					'Add Handlers
					'Close_test Must Be first

					AddHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnClose_Test
                    AddHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
					AddHandler CELProject.PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
					AddHandler CELProject.PERF_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnPERF_OPEN_WINDOW_BTN
					AddHandler CELProject.PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN
					AddHandler APU_READY_IND.ValueChanged, AddressOf OnAcceleratingTime_Calc
                    AddHandler E_STOP_IND.ValueChanged, AddressOf OnEStop
                    AddHandler PERF_CAPTURE_OIL_PRESSURE_BTN.ValueChanged, AddressOf OnCaptureOilPressure
					AddHandler PERF_Q13_SETUP_TRIM_BTN.ValueChanged, AddressOf OnQ13SetupTrim
					AddHandler RUN_STOP_BTN.ValueChanged, AddressOf OnAcceleratingTime_Calc
					AddHandler SMART_TERMINAL_BTN.ValueChanged, AddressOf OnSMART_TERMINAL_BTN
					AddHandler START_BTN.ValueChanged, AddressOf OnAcceleratingTime_Calc
					AddHandler STARTER_RECTIFIER_BTN.ValueChanged, AddressOf OnAcceleratingTime_Calc
					AddHandler TestStep_List.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged

					Me.DuctDiameter_Inches = CELProject.Test_Mgr_UUT_Calib_Constant(0).Value.ToDouble()
					Me.OrificeDiameter_Inches = CELProject.Test_Mgr_UUT_Calib_Constant(1).Value.ToDouble()

                    MyBase.StartWorkingThread()

                End If

			Catch ex As Exception
				MessageBox.Show("OnTestSessionRunning: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
			End Try
		End Sub

		Private Function Init_Engine_Channels() As Boolean

			Dim Return_Value As New ArrayList()

			Return_Value.Clear()

			Try
				'Initialise Common Engine Channels
                Return_Value.Add(MyBase.InitializeChannel(APU_READY_IND, "APU_READY_IND"))
                Return_Value.Add(MyBase.InitializeChannel(AFDX_FDS_Aircraft2_SPP_Aircraft2_ARN_TEXT, "AFDX_FDS_Aircraft2_SPP_Aircraft2_ARN_TEXT"))
