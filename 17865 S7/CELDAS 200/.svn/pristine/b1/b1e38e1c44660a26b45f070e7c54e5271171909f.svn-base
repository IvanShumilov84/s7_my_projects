	Public Class PW980A_Sequence
		Inherits CEL.KineticaRT.Sequence.Sequence

		Private CELProject As CELDAS = CELDAS.Instance()

		Private Const MaxNumberOfT09Probe As Integer = 12
		Private Const MaxNumberOfP09Probe As Integer = 8
		Private Const MaxNumberOfT17Probe As Integer = 4
		Private Const MaxNumberOfP17Probe As Integer = 8
		Private Const MaxNumberOfT7Probe As Integer = 24
		Private Const MaxNumberOfS7Probe As Integer = 4
		Private Const MaxNumberOfS79Probe As Integer = 4

		Private Enum eQ13TrimCase
			PT_22_PCT = 1
			PT_30_PCT = 2
			PT_40_PCT = 3
			PT_45_PCT = 4
			PT_50_PCT = 5
			PT_56_PCT = 6
			PT_60_PCT = 7
			PT_65_PCT = 8
			PT_70_PCT = 9
			PT_80_PCT = 10
			PT_86_PCT = 11
		End Enum

		Private ReadOnly Property EngineConfiguration() As EngineInformationItem
			Get
				Return UsingConfigurationManager.engineInfoCollection.Item("PW980A")
			End Get
		End Property

        Private Sub CaptureSCVTransit()
            Try
                If (E_SCVPOS_PCT.Value.ToDouble() < 95.5) Then 'If transition occurs
                    'Capture the data and stop watching for transition
                    Q13_TRIM_E_Q13.Value = New KineticaRT.Values.Double(E_Q13.Value.ToDouble())
                    Q13_TRIM_Q_LDC.Value = New KineticaRT.Values.Double(Q_LDC.Value.ToDouble())
                    Q13SetUpTrimInProgress = False

                    'Process the Q13 Trim report
                    Dim SearchPath As String = CELProject.EngineSession.PerfFolder

                    Dim NewFileCreated As Boolean

                    Dim TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                    NewFileCreated = ProcessQ13TrimReport(SearchPath, TemplateReportFullFileName, AddressOf CreateQ13TrimFile)

                    'Reset button
                    PERF_Q13_SETUP_TRIM_BTN.Value = Values.False
                End If
            Catch ex As Exception
                MessageBox.Show("CaptureSCVTransit" + ex.ToString(), "Error")
            End Try
        End Sub

		Private Sub Compute_PW980A(ByVal CalulateForLogAndPerformanceReports As Boolean)

			Try
				If CalulateForLogAndPerformanceReports Then

					LOG_PERF_WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(LOG_PERF_T_ORIFICE_DEGF.Value.ToDouble(), _
																							   LOG_PERF_P_ORIFICE_PSIA.Value.ToDouble(), _
																							   LOG_PERF_P_ORIFICE_DELTA_PSID.Value.ToDouble))

                    FlowmeterCtrl.ComputeFlow(True)

					'IMPORTANT: Toutes les variables flottantes telles que WB_CALC, DELPB, LB_DEMAND dont la source et la destination sont vides doivent
					'manuellement être updaté pour être inscrite dans le LOG ou le PERF report.
				Else

					WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(T_ORIFICE_DEGF.Value.ToDouble(), _
																					  P_ORIFICE_PSIA.Value.ToDouble(), _
																					  P_ORIFICE_DELTA_PSID.Value.ToDouble))
				End If

			Catch ex As Exception
				MessageBox.Show("Compute_PW980A" + ex.ToString(), "Error")
			End Try

		End Sub

	    Private Sub ValidateFMInitialValue()

            Try

                'Read the mass flow meter value, the value cannot be 0
                If FM_INITIAL_VOLUME_LITERS.Value.ToDouble() = 0.0 Then
                    FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())
                End If

            Catch Ex As Exception
                MessageBox.Show("ValidateFMInitialValue: " & Ex.ToString())
            End Try

        End Sub

		Private Sub ConfigDeletableCtrls()

			' Default value if not override by the project
			Dim RealNumberOfT09Probe As Integer = MaxNumberOfT09Probe
			Dim RealNumberOfP09Probe As Integer = MaxNumberOfP09Probe
			Dim RealNumberOfT17Probe As Integer = MaxNumberOfT17Probe
			Dim RealNumberOfP17Probe As Integer = MaxNumberOfP17Probe
			Dim RealNumberOfT7Probe As Integer = MaxNumberOfT7Probe
			Dim RealNumberOfS7Probe As Integer = MaxNumberOfS7Probe
			Dim RealNumberOfS79Probe As Integer = MaxNumberOfS79Probe

			Try
                If CELProject.Project.Number = "12917" Then

                    RealNumberOfP09Probe = 1
                    RealNumberOfP17Probe = 1
                    RealNumberOfS7Probe = 1
                    RealNumberOfS79Probe = 1

                    If EngineConfiguration.Dresskit = EngineInformationItem.eDressKit.Pratt Then
                        RealNumberOfT09Probe = 12
                        RealNumberOfT17Probe = 4
                        RealNumberOfT7Probe = 24
                    Else
                        RealNumberOfT09Probe = 4
                        RealNumberOfT17Probe = 1
                        RealNumberOfT7Probe = 8
                    End If
                End If


                DeletableT09ChCtrl = New DeletableChannelController(Me, RealNumberOfT09Probe, MaxNumberOfT09Probe, MaxNumberOfT09Probe, "T_T09_", "_DEGF", "_DELETE_BTN", "T_T09_AVG_DEGF", "T_T09_MIN_DEGF", "T_T09_MAX_DEGF", "T_T09_SPREAD_DEGF")
                DeletableP09ChCtrl = New DeletableChannelController(Me, RealNumberOfP09Probe, MaxNumberOfP09Probe, MaxNumberOfP09Probe, "P_P09_", "_PSIA", "_DELETE_BTN", "P_P09_AVG_PSIA", "P_P09_MIN_PSIA", "P_P09_MAX_PSIA", "P_P09_SPREAD_PSIA")
                DeletableT17ChCtrl = New DeletableChannelController(Me, RealNumberOfT17Probe, MaxNumberOfT17Probe, MaxNumberOfT17Probe, "T_T17_", "_DEGF", "_DELETE_BTN", "T_T17_AVG_DEGF", "T_T17_MIN_DEGF", "T_T17_MAX_DEGF", "T_T17_SPREAD_DEGF")
                DeletableP17ChCtrl = New DeletableChannelController(Me, RealNumberOfP17Probe, MaxNumberOfP17Probe, MaxNumberOfP17Probe, "P_P17_", "_PSIA", "_DELETE_BTN", "P_P17_AVG_PSIA", "P_P17_MIN_PSIA", "P_P17_MAX_PSIA", "P_P17_SPREAD_PSIA")
                DeletableT7ChCtrl = New DeletableChannelController(Me, RealNumberOfT7Probe, MaxNumberOfT7Probe, MaxNumberOfT7Probe, "T_T7_", "_DEGF", "_DELETE_BTN", "T_T7_AVG_DEGF", "T_T7_MIN_DEGF", "T_T7_MAX_DEGF", "T_T7_SPREAD_DEGF")
                DeletableS7ChCtrl = New DeletableChannelController(Me, RealNumberOfS7Probe, MaxNumberOfS7Probe, MaxNumberOfS7Probe, "P_S7_", "_PSIA", "_DELETE_BTN", "P_S7_AVG_PSIA", "P_S7_MIN_PSIA", "P_S7_MAX_PSIA", "P_S7_SPREAD_PSIA")
                DeletableS79ChCtrl = New DeletableChannelController(Me, RealNumberOfS79Probe, MaxNumberOfS79Probe, MaxNumberOfS79Probe, "P_S79_", "_PSIA", "_DELETE_BTN", "P_S79_AVG_PSIA", "P_S79_MIN_PSIA", "P_S79_MAX_PSIA", "P_S79_SPREAD_PSIA")

            Catch Ex As Exception
                MessageBox.Show("ConfigDeletableCtrls: " & Ex.ToString())
            End Try

		End Sub

        Private Sub ConfigMinMaxCtrls()

            StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_CURRENT_AMP", "STARTER_CURRENT_MAX_AMP", "START_BTN")
            StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_VOLTAGE_VDC", "STARTER_VOLTAGE_MAX_VDC", "START_BTN")

