		'* Private Members **************************************************
		'********************************************************************

		'************
		'* Channels *
		'************

		Private ACCELERATING_TIME_SEC As INumericChannel
        Private APU_READY_IND As IBooleanChannel
        Private AFDX_FDS_Aircraft2_SPP_Aircraft2_ARN_TEXT As ITextChannel
		Private BLEED_BTN As IBooleanChannel
        Private E_IGVACT_PCT As INumericChannel
        Private E_GOP2_PSIA As INumericChannel
        Private E_MOP2_PSIA As INumericChannel
		Private E_Q13 As INumericChannel
		Private E_SCVPOS_PCT As INumericChannel
