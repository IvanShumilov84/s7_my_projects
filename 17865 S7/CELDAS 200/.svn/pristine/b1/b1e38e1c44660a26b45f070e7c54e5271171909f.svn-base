        Private Sub ConfigPersistentValues()

            'Engine Specific
            Dim PersistentValuesChannels() As String = {"NUMBER_OF_STARTS",
                                                        "OPERATING_TIME_CURRENT_SEC",
                                                        "FUEL_USED_INITIAL_LITERS", "FUEL_USED_TOTAL_LITERS"}
            Dim PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputs.EngineSerialNumber & "\" & UserInputs.WorkOrder & "\Log\PersistentValues.xml"
            PW980APersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

            Dim FuelUsedTotal As Double = FUEL_USED_TOTAL_LITERS.Value.ToDouble()
            FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())
            FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FuelUsedTotal)

        End Sub

        Private Function CreateQ13TrimFile(ByVal AppendOption As Boolean, ByVal TestCase As Integer, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet
            Dim Row As Integer = -1

            CreateQ13TrimFile = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            Try
                excelWorkbook.Worksheets(1).Unprotect(CELProject.Project.PerformanceReportsCellProtection.ToString)

                excelWorksheet = excelSheets.Item("CALCUL TRIM")

                If AppendOption = False Then

                    'APU S/N       (Cell C6)
                    excelWorksheet.Cells(6, 3).NumberFormat = "@"
                    excelWorksheet.Cells(6, 3).Value = UserInputs.EngineSerialNumber

                    'Customer      (Cell C7)
                    excelWorksheet.Cells(7, 3).NumberFormat = "@"
                    excelWorksheet.Cells(7, 3).Value = UserInputs.Customer

                    'Date          (Cell C8)
                    excelWorksheet.Cells(8, 3).NumberFormat = "@"
                    excelWorksheet.Cells(8, 3).Value = Format(Now, "d MMMM yyyy")

                End If

                Select Case TestCase

                    Case eQ13TrimCase.PT_22_PCT
                        Row = 17
                    Case eQ13TrimCase.PT_30_PCT
                        Row = 18
                    Case eQ13TrimCase.PT_40_PCT
                        Row = 19
                    Case eQ13TrimCase.PT_50_PCT
                        Row = 20
                    Case eQ13TrimCase.PT_60_PCT
                        Row = 21
                    Case eQ13TrimCase.PT_70_PCT
                        Row = 22
                    Case eQ13TrimCase.PT_80_PCT
                        Row = 23
                    Case eQ13TrimCase.PT_86_PCT
                        Row = 24
                End Select

                If Row > 0 Then
                    'QLDC
                    excelWorksheet.Cells(Row, 4).Value = Q13_TRIM_Q_LDC.Value.ToString(Q13_TRIM_Q_LDC.Format, Nothing)
                    'E.Q13
                    excelWorksheet.Cells(Row, 5).Value = Q13_TRIM_E_Q13.Value.ToString(Q13_TRIM_E_Q13.Format, Nothing)
                End If

            Catch ex As Exception

                System.Diagnostics.Trace.WriteLine("CreateQ13TrimFile: " + ex.ToString())
                MessageBox.Show(ex.ToString)
                CreateQ13TrimFile = False

            Finally

                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(CELProject.Project.PerformanceReportsCellProtection.ToString)

            End Try
        End Function

