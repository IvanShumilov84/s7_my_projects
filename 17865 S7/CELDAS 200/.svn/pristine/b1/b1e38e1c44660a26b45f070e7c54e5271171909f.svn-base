                Return_Value.Add(MyBase.InitializeChannel(PERF_VIB_N2_RUN_UP_TO_MAX_SPEED_1EN2, "PERF_VIB_N2_RUN_UP_TO_MAX_SPEED_1EN2"))
                Return_Value.Add(MyBase.InitializeChannel(PERF_VIB_STEADY_STATE_AT_MAX_N2_0_925EN2, "PERF_VIB_STEADY_STATE_AT_MAX_N2_0_925EN2"))
                Return_Value.Add(MyBase.InitializeChannel(PERF_VIB_STEADY_STATE_AT_MAX_N2_1EN1, "PERF_VIB_STEADY_STATE_AT_MAX_N2_1EN1"))
                Return_Value.Add(MyBase.InitializeChannel(PERF_VIB_STEADY_STATE_AT_MAX_N2_1EN2, "PERF_VIB_STEADY_STATE_AT_MAX_N2_1EN2"))
                Return_Value.Add(MyBase.InitializeChannel(PERF_VIB_STEADY_STATE_AT_MAX_N2_39EN1, "PERF_VIB_STEADY_STATE_AT_MAX_N2_39EN1"))
				Return_Value.Add(MyBase.InitializeChannel(POWER_BTN, "POWER_BTN"))
				Return_Value.Add(MyBase.InitializeChannel(Q_LDC, "Q_LDC"))
				Return_Value.Add(MyBase.InitializeChannel(Q13_TRIM_E_Q13, "Q13_TRIM_E_Q13"))
				Return_Value.Add(MyBase.InitializeChannel(Q13_TRIM_Q_LDC, "Q13_TRIM_Q_LDC"))
				Return_Value.Add(MyBase.InitializeChannel(RUN_STOP_BTN, "RUN_STOP_BTN"))
				Return_Value.Add(MyBase.InitializeChannel(SMART_TERMINAL_BTN, "SMART_TERMINAL_BTN"))
				Return_Value.Add(MyBase.InitializeChannel(START_BTN, "START_BTN"))
				Return_Value.Add(MyBase.InitializeChannel(STARTER_CURRENT_AMP, "STARTER_CURRENT_AMP"))
				Return_Value.Add(MyBase.InitializeChannel(STARTER_CURRENT_MAX_AMP, "STARTER_CURRENT_MAX_AMP"))
				Return_Value.Add(MyBase.InitializeChannel(STARTER_RECTIFIER_BTN, "STARTER_RECTIFIER_BTN"))
				Return_Value.Add(MyBase.InitializeChannel(STARTER_VOLTAGE_MAX_VDC, "STARTER_VOLTAGE_MAX_VDC"))
				Return_Value.Add(MyBase.InitializeChannel(STARTER_VOLTAGE_VDC, "STARTER_VOLTAGE_VDC"))
				Return_Value.Add(MyBase.InitializeChannel(T_ORIFICE_DEGF, "T_ORIFICE_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(T_T09_AVG_DEGC, "T_T09_AVG_DEGC"))
				Return_Value.Add(MyBase.InitializeChannel(WB_CALC, "WB_CALC"))


				Return_Value.Add(MyBase.InitializeObject(Performance_Control_Frame, CELProject.EngineModel.Replace("-", "_") + "_Screen.fraPerformanceControl"))

				TestStep_List = Performance_Control_Frame.FindObject("TestStep_List")

				If TestStep_List Is Nothing Then
					MessageBox.Show("MyBase.InitializeObject - TestStep_List Is Nothing")
					Return_Value.Add(False)
				Else
					Return_Value.Add(True)
				End If

            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.ToString())
                Return_Value.Add(False)
			End Try

			If Return_Value.Contains(False) Then
				Init_Engine_Channels = False
			Else
				Init_Engine_Channels = True
			End If
		End Function

