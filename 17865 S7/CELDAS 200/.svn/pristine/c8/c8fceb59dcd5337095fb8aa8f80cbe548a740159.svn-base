        Public EngineSerialNumber As String = ""
        Public ECBSerialNumber As String = ""
        Public ECBPartNumber As String = ""
        Public SoftwareVersion As String = ""
        Public WorkOrder As String = ""
        Public ExhaustDuctSerialNumber As String = ""
        Public BellmouthSerialNumber As String = ""
        Public TurbineVibPickupSerialNumber As String = ""
        Public GearboxVibPickupSerialNumber As String = ""
        Public OilType As String = ""
        Public TimeSinceNew As String = "" 'TSN/TSO
        Public CyclesSinceNew As String = "" 'TSN/TSO
        Public SG1SerialNumber As String = "" 'TSN/TSO
        Public SG2SerialNumber As String = "" 'TSN/TSO
        Public CMSCSerialNumber As String = "" 'TSN/TSO
        Public GCU1SerialNumber As String = "" 'TSN/TSO
        Public GCU2SerialNumber As String = "" 'TSN/TSO

        Public Reason As String = ""
        Public TestType As String = ""

        ' Allow friend access to the empty constructor.
        Friend Sub New()

        End Sub
        Public Sub MapUserInputsParameters(ByRef CELProject As CELDAS)

            EngineSerialNumber = CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
            WorkOrder = CELProject.Test_Mgr_UUT_Answer(1).Value.ToString()
            ECBSerialNumber = CELProject.Test_Mgr_UUT_Answer(2).Value.ToString()
            ECBPartNumber = CELProject.Test_Mgr_UUT_Answer(3).Value.ToString()
            SoftwareVersion = CELProject.Test_Mgr_UUT_Answer(4).Value.ToString()
            SG1SerialNumber = CELProject.Test_Mgr_UUT_Answer(5).Value.ToString()
            ExhaustDuctSerialNumber = CELProject.Test_Mgr_UUT_Answer(6).Value.ToString()
            BellmouthSerialNumber = CELProject.Test_Mgr_UUT_Answer(7).Value.ToString()
            SG2SerialNumber = CELProject.Test_Mgr_UUT_Answer(8).Value.ToString()
            TurbineVibPickupSerialNumber = CELProject.Test_Mgr_UUT_Answer(9).Value.ToString()
            GearboxVibPickupSerialNumber = CELProject.Test_Mgr_UUT_Answer(10).Value.ToString()
            CMSCSerialNumber = CELProject.Test_Mgr_UUT_Answer(11).Value.ToString()
            OilType = CELProject.Test_Mgr_UUT_Answer(12).Value.ToString()
            GCU1SerialNumber = CELProject.Test_Mgr_UUT_Answer(14).Value.ToString()
            TimeSinceNew = CELProject.Test_Mgr_UUT_Answer(15).Value.ToString()
            CyclesSinceNew = CELProject.Test_Mgr_UUT_Answer(16).Value.ToString()
            GCU2SerialNumber = CELProject.Test_Mgr_UUT_Answer(17).Value.ToString()

            Reason = CELProject.Test_Mgr_UUT_Choice(0).Value.ToString()
            TestType = CELProject.Test_Mgr_UUT_Choice(1).Value.ToString()
        End Sub
    End Class

