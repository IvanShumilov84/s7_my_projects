                Return_Value.Add(MyBase.InitializeChannel(T_ETC2_DEGF, "T_ETC2_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(T_INLET_400_DEGR, "T_INLET_400_DEGR"))
                Return_Value.Add(MyBase.InitializeChannel(T_INLET_450_DEGR, "T_INLET_450_DEGR"))
                Return_Value.Add(MyBase.InitializeChannel(T_INLET_AVG_DEGF, "T_INLET_AVG_DEGF"))
