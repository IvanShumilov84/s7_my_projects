        Protected Overrides Sub OnTestSessionClosing(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                MyBase.OnTestSessionClosing(newStatus)

                If CELProject.EngineModel = "APS5000A" Then

                    If Not (FlowmeterCtrl Is Nothing) Then
                        FlowmeterCtrl.Dispose()
                    End If

                    If TestProgressMgr IsNot Nothing Then
                        TestProgress_Save()
                        TestProgressMgr.Dispose()
                        TestProgressMgr = Nothing
                    End If

                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionClosing: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionInitialized(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                MyBase.OnTestSessionInitialized(newStatus)

                If CELProject.EngineModel = "APS5000A" Then


                    Select Case CELProject.Project.Number

                        Case 12917
                            UserInputsRevima.MapUserInputsParameters(CELProject)

                        Case 11813
                            UserInputsChine.MapUserInputsParameters(CELProject)

                        Case 12958
                            UserInputsEpcor.MapUserInputsParameters(CELProject)

                        Case Else
                            Debug.Assert(False, "OnTestSessionInitialized, Code Missign for this project")

                    End Select

                    CELProject.EngineSession.WorkingFolder = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(1).Value.ToString()
                    CELProject.CreateLogFile(AddressOf CreateCustomHeaderLogFile, CELProject.EngineModel, CELProject.EngineModel)

                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionInitialized: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)

            Catch ex As Exception

                MessageBox.Show("ASP5000A_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            End Try
        End Sub

        Protected Overrides Sub OnTestSessionRunning(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                MyBase.OnTestSessionRunning(newStatus)


                If CELProject.EngineModel = "APS5000A" Then

                    CELProject.LoadSave_Custom_Parameters(Custom_Parameters, False)

                    Init_Engine_Channels()

                    Init_Engine_Channels_Value()

                    CELProject.Perf_Nb_Sheet_To_Print = 3

                    Init_Engine_Controllers()

                    CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.Init_Engine_Controls))

                    AddHandlers()
                  

                    MyBase.StartWorkingThread()

                    'Test Progress Initialization (first in Révima)
                    Select Case CELProject.Project.Number
                        Case 12917, 12958
                            TestProgress_Initialize()
                        Case 11813
                            ' Do nothing
                        Case Else
                            Debug.Assert(False, "OnTestSessionRunning: Test progress not configured for this project")
                    End Select

                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionRunning: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub
        Protected Overrides Sub AddHandlers()

            'Add Handlers
            AddHandler FROM_CANBUS_SYSCONFIG_ERROR.ValueChanged, AddressOf OnCanbusSysConfigError
            AddHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnCLOSE_TEST_BTN
            AddHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            AddHandler CELProject.NEW_TEST_BTN.ValueChanged, AddressOf OnNEW_TEST_BTN
            AddHandler CELProject.PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
            AddHandler CELProject.PERF_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnPERF_OPEN_WINDOW_BTN
            AddHandler CELProject.PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN
            AddHandler CELProject.PERF_TEST_RESULT_ACCEPTED.ValueChanged, AddressOf OnPERFTestResultAcceptedCheckBox
            AddHandler CELProject.PERF_TEST_RESULT_REJECTED.ValueChanged, AddressOf OnPERFTestResultRejectedCheckBox

            AddHandler CMSC_POWER_BTN.ValueChanged, AddressOf OnCMSC
            AddHandler E_STOP.ValueChanged, AddressOf OnEmerStop
            AddHandler LB_LOAD_BTN.ValueChanged, AddressOf OnLoadOff
            AddHandler POWER_BTN.ValueChanged, AddressOf OnPowerOff
            AddHandler READY_TO_LOAD.ValueChanged, AddressOf OnAcceleratingTime_Calc
            AddHandler RUN_STOP_BTN.ValueChanged, AddressOf OnRunStop
            AddHandler STARTER_RECTIFIER_BTN_APS5000A.ValueChanged, AddressOf OnStarterRectifier
            AddHandler TestStep_List.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged
            AddHandler TEST_LINK_SERVER_BTN.ValueChanged, AddressOf OnTEST_LINK_SERVER_BTN
            AddHandler TEST_LINK_BTN.ValueChanged, AddressOf OnTEST_LINK_BTN

        End Sub
        Protected Overrides Sub RemoveHandlers()

            If Not (FROM_CANBUS_SYSCONFIG_ERROR Is Nothing) Then
                RemoveHandler FROM_CANBUS_SYSCONFIG_ERROR.ValueChanged, AddressOf OnCanbusSysConfigError
            End If

            If Not (CELProject.CLOSE_TEST_BTN Is Nothing) Then
                RemoveHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnCLOSE_TEST_BTN
            End If

            If Not (CELProject.NEW_TEST_BTN Is Nothing) Then
                RemoveHandler CELProject.NEW_TEST_BTN.ValueChanged, AddressOf OnNEW_TEST_BTN
            End If

            If Not (CELProject.LOG_TAKE_POINT_BTN Is Nothing) Then
                RemoveHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            End If

            If Not (CELProject.PERF_CLOSE_WINDOW_BTN Is Nothing) Then
                RemoveHandler CELProject.PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
            End If

            If Not (CELProject.PERF_OPEN_WINDOW_BTN Is Nothing) Then
                RemoveHandler CELProject.PERF_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnPERF_OPEN_WINDOW_BTN
            End If

            If Not (CELProject.PERF_TAKE_POINT_BTN Is Nothing) Then
                RemoveHandler CELProject.PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN
            End If

            If Not (CMSC_POWER_BTN Is Nothing) Then
                RemoveHandler CMSC_POWER_BTN.ValueChanged, AddressOf OnCMSC
            End If

            If Not (E_STOP Is Nothing) Then
                RemoveHandler E_STOP.ValueChanged, AddressOf OnEmerStop
            End If

            If Not (LB_LOAD_BTN Is Nothing) Then
                RemoveHandler LB_LOAD_BTN.ValueChanged, AddressOf OnLoadOff
            End If

            If Not (POWER_BTN Is Nothing) Then
                RemoveHandler POWER_BTN.ValueChanged, AddressOf OnPowerOff
            End If

            If Not (READY_TO_LOAD Is Nothing) Then
                RemoveHandler READY_TO_LOAD.ValueChanged, AddressOf OnAcceleratingTime_Calc
            End If

            If Not (RUN_STOP_BTN Is Nothing) Then
                RemoveHandler RUN_STOP_BTN.ValueChanged, AddressOf OnRunStop
            End If

            If Not (STARTER_RECTIFIER_BTN_APS5000A Is Nothing) Then
                RemoveHandler STARTER_RECTIFIER_BTN_APS5000A.ValueChanged, AddressOf OnStarterRectifier
            End If

            If Not (TEST_LINK_SERVER_BTN Is Nothing) Then
                RemoveHandler TEST_LINK_SERVER_BTN.ValueChanged, AddressOf OnTEST_LINK_SERVER_BTN
            End If

            If Not (TEST_LINK_BTN Is Nothing) Then
                RemoveHandler TEST_LINK_BTN.ValueChanged, AddressOf OnTEST_LINK_BTN
            End If

            If Not (CELProject.PERF_TEST_RESULT_ACCEPTED Is Nothing) Then
                RemoveHandler CELProject.PERF_TEST_RESULT_ACCEPTED.ValueChanged, AddressOf OnPERFTestResultAcceptedCheckBox
            End If

            If Not (CELProject.PERF_TEST_RESULT_REJECTED Is Nothing) Then
                RemoveHandler CELProject.PERF_TEST_RESULT_REJECTED.ValueChanged, AddressOf OnPERFTestResultRejectedCheckBox
            End If

            If Not (TestStep_List Is Nothing) Then
                RemoveHandler TestStep_List.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged
            End If

        End Sub

        Protected Overrides Sub Init_Engine_Controllers()

            Dim PersistentValuesChannels() As String = {"NUMBER_OF_STARTS",
                                                               "OPERATING_TIME_CURRENT_SEC",
                                                               "FUEL_USED_INITIAL_LITERS",
                                                               "FUEL_USED_TOTAL_LITERS",
                                                               "PERF_TEST_RESULT_ACCEPTED",
                                                               "PERF_TEST_RESULT_REJECTED",
                                                               "VIB_GB_MAX",
                                                               "EVENT_1",
                                                               "EVENT_2",
                                                               "HR_MTR_1",
                                                               "HR_MTR_2",
                                                               "Log_Perf_Surge",
                                                               "Log_Perf_FlameOut",
                                                               "Log_Perf_Overspeed",
                                                               "Log_Perf_Underspeed"}

            Dim PersistentValuesFileName As String = Nothing

            Select Case CELProject.Project.Number

                Case 12917
                    PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputsRevima.EngineSerialNumber & "\" & UserInputsRevima.WorkOrder & "\Log\PersistentValues.xml"
                    PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

                    Dim FuelUsedTotal As Double = FUEL_USED_TOTAL_LITERS.Value.ToDouble()
                    FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())
                    FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FuelUsedTotal)

                Case 11813
                    PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputsChine.EngineSerialNumber & "\" & UserInputsChine.WorkOrder & "\Log\PersistentValues.xml"
                    PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

                    If Double.IsNaN(FUEL_USED_TOTAL_LITERS.Value.ToDouble()) Then
                        FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                    Else
                        FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())
                    End If

                Case 12958
                    PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputsEpcor.SerialNumber & "\" & UserInputsEpcor.WorkOrder & "\Log\PersistentValues.xml"
                    PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

                    If Double.IsNaN(FUEL_USED_TOTAL_LITERS.Value.ToDouble()) Then
                        FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                    Else
                        FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())
                    End If

                Case Else
                    Debug.Assert(False, "OnTestSessionRunning: Code Missign for this project")

            End Select

            ' Default value if not override by the project
            Dim RealNumberOfTEgtProbe As Integer = MaxNumberOfTEgtProbe
            Dim RealNumberOfTInletProbe As Integer = MaxNumberOfTInletProbe

            DeletableTEgtChCtrl = New DeletableChannelController(Me, RealNumberOfTEgtProbe, MaxNumberOfTEgtProbe, MaxNumberOfTEgtProbe, "T_EGT", "_DEGF", "_DELETE_BTN", "T_EGT_AVG_DEGF", "T_EGT_MIN_DEGF", "T_EGT_MAX_DEGF", "T_EGT_SPREAD_DEGF")
            DeletableTInletChCtrl = New DeletableChannelController(Me, RealNumberOfTInletProbe, MaxNumberOfTInletProbe, MaxNumberOfTInletProbe, "T_INLET", "_DEGF", "_DELETE_BTN", "T_INLET_AVG_DEGF", "T_INLET_MIN_DEGF", "T_INLET_MAX_DEGF", "T_INLET_SPREAD_DEGF")

            FlowmeterCtrl = New FlowmeterController(Me)

            StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_CURRENT_AMP", "STARTER_CURRENT_MAX_AMP", "START_BTN")
            StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_VOLTAGE_VDC", "STARTER_VOLTAGE_MAX_VDC", "START_BTN")

            VibGearboxMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_GEARBOX", "VIB_GB_MAX", "VIB_MAX_RESET_BTN")

            'Configuring Load Bank Control
            Dim myLBData1 As LoadBankController.LB_DataInfo
            Dim myLBData2 As LoadBankController.LB_DataInfo

            myLBData1.FanEnableChannelName = "LB1_FAN_ENABLE_CMD"
            myLBData1.FanEnableBtnChannelName = "LB1_FAN_ENABLE_BTN"
            myLBData1.EnableChannelName = "LB_LOAD_BTN"
            myLBData1.DemandChannelName = "LB1_DEMAND"
            myLBData1.UpDemandChannelName = "LB1_UP_DEMAND_BTN"
            myLBData1.DownDemandChannelName = "LB1_DOWN_DEMAND_BTN"
            myLBData1.DemandChannelIncrementName = "LB1_DEMAND_INCREMENT"
            myLBData1.InitialDemandChannelName = "LB1_INITIAL_DEMAND"
            myLBData1.FrameName = "APS5000A_Screen.fraControlSystem.fraLoadBankControl1"
            myLBData1.DisplayName = "dspLB1_DEMAND"
            myLBData1.ThreadSpeedMsec = 250 'msec
            myLBData1.Maximum = 310
            myLBData1.DelestageKwpersec = 100000 'instant delestage
            myLBData1.FanCoolDownSeconds = 300
            myLBData1.Memorize = False
            myLBData1.Increment = 1
            myLBData1.FieldFlashingTimeMsec = 0
            myLBData1.FieldFlashingSignalName = Nothing
            myLBData1.FieldFlashingTriggerSignalName = Nothing
            myLBData1.BtnLatchSeconds = 0
            myLBData1.FanEnableChannelPulseName = Nothing
            myLBData1.FanStopChannelPulseName = Nothing
            myLBData1.PulseEnableInitialType = False
            myLBData1.PulseStopInitialType = False

            myLBData2.FanEnableChannelName = "LB2_FAN_ENABLE_CMD"
            myLBData2.FanEnableBtnChannelName = "LB2_FAN_ENABLE_BTN"
            myLBData2.EnableChannelName = "LB_LOAD_BTN"
            myLBData2.DemandChannelName = "LB2_DEMAND"
            myLBData2.UpDemandChannelName = "LB2_UP_DEMAND_BTN"
            myLBData2.DownDemandChannelName = "LB2_DOWN_DEMAND_BTN"
            myLBData2.DemandChannelIncrementName = "LB2_DEMAND_INCREMENT"
            myLBData2.InitialDemandChannelName = "LB2_INITIAL_DEMAND"
            myLBData2.FrameName = "APS5000A_Screen.fraControlSystem.fraLoadBankControl2"
            myLBData2.DisplayName = "dspLB2_DEMAND"
            myLBData2.ThreadSpeedMsec = 250 'msec
            myLBData2.Maximum = 310
            myLBData2.DelestageKwpersec = 100000 'instant delestage
            myLBData2.FanCoolDownSeconds = 300
            myLBData2.Memorize = False
            myLBData2.Increment = 1
            myLBData2.FieldFlashingTimeMsec = 0
            myLBData2.FieldFlashingSignalName = Nothing
            myLBData2.FieldFlashingTriggerSignalName = Nothing
            myLBData2.BtnLatchSeconds = 0
            myLBData2.FanEnableChannelPulseName = Nothing
            myLBData2.FanStopChannelPulseName = Nothing
            myLBData2.PulseEnableInitialType = False
            myLBData2.PulseStopInitialType = False

            LoadBankCtrl1 = New LoadBankController(myLBData1)
            LoadBankCtrl2 = New LoadBankController(myLBData2)

            'Configuring Load Bank Stage Values, maximum allowed is 310 kW, define only required stage
            LoadBankCtrl1.AddStage(1, "LB1_1")
            LoadBankCtrl1.AddStage(1, "LB1_2")
            LoadBankCtrl1.AddStage(2, "LB1_3")
            LoadBankCtrl1.AddStage(4, "LB1_4")
            LoadBankCtrl1.AddStage(8, "LB1_5")
            LoadBankCtrl1.AddStage(15, "LB1_6")
            LoadBankCtrl1.AddStage(25, "LB1_7")
            LoadBankCtrl1.AddStage(50, "LB1_8")
            LoadBankCtrl1.AddStage(100, "LB1_9")
            LoadBankCtrl1.AddStage(100, "LB1_10")
            LoadBankCtrl1.AddStage(100, "LB1_11")
            LoadBankCtrl1.AddCurrentPhases("LBR_CURRENT_IA", "LBR_CURRENT_IB", "LBR_CURRENT_IC", 20)
            LoadBankCtrl1.AddVoltagePhases("LBR_VOLTAGE_VAB", "LBR_VOLTAGE_VBC", "LBR_VOLTAGE_VCA", 20)
            LoadBankCtrl1.StartWorkerThread(250)

            'Configuring Load Bank Stage Values, maximum allowed is 310 kW, define only required stage
            LoadBankCtrl2.AddStage(1, "LB2_1")
            LoadBankCtrl2.AddStage(1, "LB2_2")
            LoadBankCtrl2.AddStage(2, "LB2_3")
            LoadBankCtrl2.AddStage(4, "LB2_4")
            LoadBankCtrl2.AddStage(8, "LB2_5")
            LoadBankCtrl2.AddStage(15, "LB2_6")
            LoadBankCtrl2.AddStage(25, "LB2_7")
            LoadBankCtrl2.AddStage(50, "LB2_8")
            LoadBankCtrl2.AddStage(100, "LB2_9")
            LoadBankCtrl2.AddStage(100, "LB2_10")
            LoadBankCtrl2.AddStage(100, "LB2_11")
            LoadBankCtrl2.AddCurrentPhases("LBL_CURRENT_IA", "LBL_CURRENT_IB", "LBL_CURRENT_IC", 20)
            LoadBankCtrl2.AddVoltagePhases("LBL_VOLTAGE_VAB", "LBL_VOLTAGE_VBC", "LBL_VOLTAGE_VCA", 20)
            LoadBankCtrl2.StartWorkerThread(250)

        End Sub
        Protected Overrides Sub Dispose_Engine_Controllers()


            If Not (DeletableTEgtChCtrl Is Nothing) Then
                DeletableTEgtChCtrl.Dispose()
            End If

            If Not (DeletableTInletChCtrl Is Nothing) Then
                DeletableTInletChCtrl.Dispose()
            End If

            If Not (LoadBankCtrl1 Is Nothing) Then
                LoadBankCtrl1.Dispose()
            End If

            If Not (LoadBankCtrl2 Is Nothing) Then
                LoadBankCtrl2.Dispose()
            End If

            If Not (PersistentValuesCtrl Is Nothing) Then
                PersistentValuesCtrl.Dispose()
            End If

            If Not (StarterMaxCurrentRecordCtrl Is Nothing) Then
                StarterMaxCurrentRecordCtrl.Dispose()
            End If

            If Not (StarterMaxVoltageRecordCtrl Is Nothing) Then
                StarterMaxVoltageRecordCtrl.Dispose()
            End If

            If Not (VibGearboxMaxRecordCtrl Is Nothing) Then
                VibGearboxMaxRecordCtrl.Dispose()
            End If

            If Not (FlowmeterCtrl Is Nothing) Then
                FlowmeterCtrl.Dispose()
            End If

        End Sub
        Protected Overrides Sub SetTestStepList(value As Integer)
        End Sub

        Protected Overrides Function Init_Engine_Channels() As Boolean

            Dim i As Integer
            Dim Return_Value As New ArrayList()

            Return_Value.Clear()

            Try

                Return_Value.Add(MyBase.InitializeChannel(APU_SERIAL_NUMBER, "APU_SERIAL_NUMBER"))

                For i = 0 To CANBUS_APU_ACMF_DATA.GetUpperBound(0) - 1
                    Return_Value.Add(MyBase.InitializeChannel(CANBUS_APU_ACMF_DATA(i), "CANBUS_APU_ACMF_DATA_B" + i.ToString()))
                Next

                For i = 0 To CANBUS_FMU_FUEL_MODULE_PN.GetUpperBound(0) - 1
                    Return_Value.Add(MyBase.InitializeChannel(CANBUS_FMU_FUEL_MODULE_PN(i), "CANBUS_FMU_FUEL_MODULE_PN_B" + i.ToString()))
