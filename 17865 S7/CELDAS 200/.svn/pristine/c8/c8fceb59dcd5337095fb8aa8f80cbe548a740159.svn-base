                Return_Value.Add(MyBase.InitializeChannel(T3_450_DEGF, "T3_450_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(T6_400_DEGF, "T6_400_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(T6_450_DEGF, "T6_450_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(TEST_LINK_BTN, "TEST_LINK_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(TEST_LINK_SERVER_BTN, "TEST_LINK_SERVER_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(THETA_70, "THETA_70"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_GB_MAX, "VIB_GB_MAX"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_GEARBOX, "VIB_GEARBOX"))
                Return_Value.Add(MyBase.InitializeChannel(WF_400_PPH, "WF_400_PPH"))
                Return_Value.Add(MyBase.InitializeChannel(WF_450_PPH, "WF_450_PPH"))
                Return_Value.Add(MyBase.InitializeChannel(WF_PPH, "WF_PPH"))
                Return_Value.Add(MyBase.InitializeChannel(WF_TOT1, "WF_TOT1"))
                Return_Value.Add(MyBase.InitializeChannel(WF_TOT2, "WF_TOT2"))
                Return_Value.Add(MyBase.InitializeChannel(YEAR_TENS_TO_CANBUS, "YEAR_TENS_TO_CANBUS"))
                Return_Value.Add(MyBase.InitializeChannel(YEAR_UNITS_TO_CANBUS, "YEAR_UNITS_TO_CANBUS"))

                'Initialise Engine Controls
                Return_Value.Add(MyBase.InitializeObject(Test_Step_Frame, CELProject.EngineModel.Replace("-", "_") + "_Screen.fraControl"))

                Return_Value.Add(MyBase.InitializeObject(Master_Panel_Frame, CELProject.EngineModel.Replace("-", "_") + "_Screen.Master_Panel_Frame"))

                CMSC_Msg_Text = CELProject.SearchControl(Master_Panel_Frame, "CMSC_MSG")

                If CMSC_Msg_Text Is Nothing Then
                    MessageBox.Show("Initialize_Object - CMSC_Msg_Text Is Nothing")
                    Return_Value.Add(False)
                Else
                    Return_Value.Add(True)
                End If

                TestStep_List = Test_Step_Frame.FindObject("TestStep_List")
                If TestStep_List Is Nothing Then
                    MessageBox.Show("Initialize_Object - TestStep_List Is Nothing")
                    Return_Value.Add(False)
                Else
                    Return_Value.Add(True)
                End If

                Return_Value.Add(MyBase.InitializeChannel(OPERATING_TIME_CURRENT_SEC, "OPERATING_TIME_CURRENT_SEC"))

            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.Message)
                Return_Value.Add(False)
            Finally

            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function


        Private Sub TestProgress_Initialize()
            Dim dataInfo As CEL.TestProgress.TestProgressMgr.TestProgress_DataInfo = Nothing

            dataInfo.EngineStartEventChannelName = "START_BTN"
            dataInfo.EngineStartEventChannelValue = True
            dataInfo.EngineStartEventDescription = "Mise en route"
            dataInfo.EngineStartEventRecordTime = True
            dataInfo.EngineStopEventChannelName = "RUN_STOP_BTN"
            dataInfo.EngineStopEventChannelValue = False
            dataInfo.EngineStopEventDescription = "Arrêt moteur - Temps d'arrêt (s): "
            dataInfo.EngineStopEventRecordTime = True
            dataInfo.TestProgressFrameName = CELProject.EngineModel.Replace("-", "_") + "_Screen.fraTestProgressHorizontal"
            dataInfo.TestProgressSheetFileName = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
            dataInfo.UUTModel = CELProject.EngineModel

            Select Case CELProject.Project.Number
                Case 12917
                    dataInfo.UUTSerialNumber = Me.UserInputsRevima.EngineSerialNumber
                    dataInfo.UUTWorkOrder = Me.UserInputsRevima.WorkOrder
                Case 12958
                    dataInfo.UUTSerialNumber = Me.UserInputsEpcor.SerialNumber
                    dataInfo.UUTWorkOrder = Me.UserInputsEpcor.WorkOrder
                Case Else
                    Debug.Assert(False, "TestProgress_Initialize(): Specific engine data not configured for this project")
            End Select

            Me.TestProgressMgr = New CEL.TestProgress.TestProgressMgr(dataInfo)
        End Sub


        Private Function TestProgress_RecordPerfPointE1_F1() As CEL.TestProgress.TestProgressSheetEntry

            Dim KW_DIFF_NAN As Boolean = Not Double.IsNaN(LOG_PERF_KW_400_KVA.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_KW_450_KVA.Value.ToDouble)
            Dim sheetEntry As CEL.TestProgress.TestProgressSheetEntry = Nothing
            Dim checkItemNormEGT As String = "NORM_EGT - Read: "
            Dim checkItemEGTCOR As String = "EGT_COR - Max: 961 Read: "
            Dim checkItemPEX450 As String = "PEX_450 - Read: "
            Dim checkItemTIN450 As String = "TIME_450 - Read: "
            Dim checkItemNormP3 As String = "NORM_P3 - Read: "
            Dim checkItemNormT3 As String = "NORM_T3 - Read: "
            Dim checkItemNormWF As String = "NORM_WF - Read: "

            If Not Double.IsNaN(LOG_PERF_KW_400_KVA.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_KW_450_KVA.Value.ToDouble) Then
                checkItemNormEGT += LOG_PERF_NORM_EGT.Value.ToString(LOG_PERF_NORM_EGT.Format, Nothing) + " °F"
                checkItemEGTCOR += LOG_PERF_EGT_CORR.Value.ToString(LOG_PERF_EGT_CORR.Format, Nothing) + " °F"
                checkItemPEX450 += LOG_PERF_PEX_450.Value.ToString(LOG_PERF_PEX_450.Format, Nothing) + " psig"
                checkItemTIN450 += LOG_PERF_TIN_450_DEGR.Value.ToString(LOG_PERF_TIN_450_DEGR.Format, Nothing) + " °R"
                checkItemNormP3 += LOG_PERF_NORM_P3.Value.ToString(LOG_PERF_NORM_P3.Format, Nothing) + " psia"
                checkItemNormT3 += LOG_PERF_NORM_T3.Value.ToString(LOG_PERF_NORM_T3.Format, Nothing) + " °F"
                checkItemNormWF += LOG_PERF_NORM_WF.Value.ToString(LOG_PERF_NORM_WF.Format, Nothing) + " pph"

                sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Performance Control", {checkItemNormEGT, checkItemEGTCOR, _
                                                                                                               checkItemPEX450, checkItemTIN450, _
                                                                                                               checkItemNormP3, checkItemNormT3, _
                                                                                                               checkItemNormWF})
            End If

            Return sheetEntry

        End Function



        Private Sub TestProgress_RecordPerfStep_Revima_12917(testStep As eTestStepAPS5000A)
            If Me.TestProgressMgr IsNot Nothing Then
                Dim sheetEntry As CEL.TestProgress.TestProgressSheetEntry = Nothing
                Dim pointE1_F1SheetEntry As CEL.TestProgress.TestProgressSheetEntry = Nothing

                Dim checkItemLeftGenerator As String = "Left Generator Load - Target: "
                Dim checkItemRightGenerator As String = "Right Generator Load - Target: "

                Select Case testStep
                    Case eTestStepAPS5000A.RUN_1_STEP_E
                        checkItemLeftGenerator += "200±5 Actual: " + LBL_POWER_TOT.Value.ToString(LBL_POWER_TOT.Format, Nothing) + " kVA"
                        checkItemRightGenerator += "200±5 Actual: " + LBR_POWER_TOT.Value.ToString(LBR_POWER_TOT.Format, Nothing) + " kVA"

                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Test Point E1 400 kVA Load", {checkItemLeftGenerator, checkItemRightGenerator})
                        pointE1_F1SheetEntry = TestProgress_RecordPerfPointE1_F1()

                    Case eTestStepAPS5000A.RUN_1_STEP_F
                        checkItemLeftGenerator += "225±5 Actual: " + LBL_POWER_TOT.Value.ToString(LBL_POWER_TOT.Format, Nothing) + " kVA"
                        checkItemRightGenerator += "225±5 Actual: " + LBR_POWER_TOT.Value.ToString(LBR_POWER_TOT.Format, Nothing) + " kVA"

                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Test Point F1 450 kVA Load", {checkItemLeftGenerator, checkItemRightGenerator})
                        pointE1_F1SheetEntry = TestProgress_RecordPerfPointE1_F1()

                End Select

                If sheetEntry IsNot Nothing Then
                    Me.TestProgressMgr.AddTestProgressEntry(sheetEntry)
                End If

                If pointE1_F1SheetEntry IsNot Nothing Then
                    Me.TestProgressMgr.AddTestProgressEntry(pointE1_F1SheetEntry)
                End If
            End If
        End Sub



        Private Sub TestProgress_RecordPerfStep_Generic()

            Dim sheetEntry As CEL.TestProgress.TestProgressSheetEntry = Nothing

            Dim TextString As String = TestStep_List.SelectedItem & " performance point taken"

            sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(Now.ToString(), TextString)

            If sheetEntry IsNot Nothing Then
                Me.TestProgressMgr.AddTestProgressEntry(sheetEntry)
            End If

        End Sub


        Private Sub TestProgress_RecordPerfStep(testStep As eTestStepAPS5000A)

            If Me.TestProgressMgr IsNot Nothing Then

                Select Case CELProject.Project.Number
                    Case 12917
                        TestProgress_RecordPerfStep_Revima_12917(testStep)
                    Case 12958
                        TestProgress_RecordPerfStep_Generic()
                    Case Else
                        Debug.Assert(False, "TestProgress_RecordPerfStep(): Specific engine data not configured for this project")
                End Select

            End If
        End Sub


        Private Sub TestProgress_Save()
            If Not Me.TestProgressMgr Is Nothing Then
                TestProgress_UpdateProgressSheetHeader(Me.TestProgressMgr.TestProgressSheet)
                Dim fileName As String = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
                Dim settings As Xml.XmlWriterSettings = New Xml.XmlWriterSettings()
                settings.Indent = True

                Using writer As Xml.XmlWriter = Xml.XmlWriter.Create(fileName, settings)
                    Dim xslPath As String = "type=""text/xsl"" href=""" + Application.StartupPath + "/TestProgressSheet.xsl"""
                    writer.WriteProcessingInstruction("xml-stylesheet", xslPath)
                    Dim ser As New Xml.Serialization.XmlSerializer(GetType(CEL.TestProgress.TestProgressSheet))
                    ser.Serialize(writer, Me.TestProgressMgr.TestProgressSheet)
                End Using
            End If
        End Sub

        Private Sub TestProgress_UpdateProgressSheetHeader(progressSheet As CEL.TestProgress.TestProgressSheet)

            Select Case CELProject.Project.Number
                Case 12917

                    progressSheet.Header("No capteur de vibration turbine") = Me.UserInputsRevima.TurbineVibPickupSerialNumber
                    progressSheet.Header("No capteur de vibration accessoire") = Me.UserInputsRevima.GearboxVibPickupSerialNumber
                    'progressSheet.Header("No Capt. frein") = Me.UserInputs.LoadCellSerialNumber
                    progressSheet.Header("Type d'huile") = Me.UserInputsRevima.OilType
                    progressSheet.Header("Quantité totale Jet A1") = Me.FUEL_USED_TOTAL_LITERS.Value.ToString()
                    Dim runningTime As System.TimeSpan = System.TimeSpan.FromSeconds(Me.OPERATING_TIME_CURRENT_SEC.Value.ToDouble())
                    progressSheet.Header("Temps de fonctionnement") = Math.Floor(runningTime.TotalHours).ToString() + _
                        " h " + runningTime.Minutes.ToString("00")
                Case 12958
                    ' do nothing
                Case Else
                    Debug.Assert(False, "TestProgress_UpdateProgressSheetHeader(): Specific engine data not configured for this project")
            End Select
        End Sub



