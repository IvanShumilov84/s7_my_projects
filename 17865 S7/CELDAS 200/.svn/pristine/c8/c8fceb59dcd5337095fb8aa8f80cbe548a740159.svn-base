                For i = 0 To CANBUS_FMU_FUEL_MODULE_SN.GetUpperBound(0) - 1
                    Return_Value.Add(MyBase.InitializeChannel(CANBUS_FMU_FUEL_MODULE_SN(i), "CANBUS_FMU_FUEL_MODULE_SN_B" + i.ToString()))
