        Private Sub OnCMSC(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                If CELProject.IsTrue(newVal) Then
                    Time_CMSC_ON = Now.AddSeconds(5.0) '5 seconds in future, then the permissive is meet
                End If

                If CELProject.IsFalse(newVal) Then
                    Time_CMSC_ON = Now.AddYears(1.0) 'time in future, this way the timer will not be expired
                    STARTER_ON_TIME_PERM_OK.Value = Values.False
                End If

            End If

        End Sub


        Private Sub OnLoadOff(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                If CELProject.IsFalse(newVal) Then
                    LB1_INITIAL_DEMAND.Value = Values.Zero
                    LB2_INITIAL_DEMAND.Value = Values.Zero
                End If

            End If

        End Sub


        Private Sub OnPowerOff(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                If CELProject.IsTrue(newVal) Then
                    Time_PowerON = Now.AddSeconds(5.0) '5 seconds in future, then the permissive is meet
                End If

                If CELProject.IsFalse(newVal) Then
                    Time_PowerON = Now.AddYears(1.0) 'time in future, this way the timer will not be expired
                    CMSC_POWER_TIME_PERM_OK.Value = Values.False
                    GCU_R_ON_TIME_PERM_OK.Value = Values.False
                End If

            End If


        End Sub


        Private Sub OnRunStop(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                If CELProject.IsTrue(newVal) Then
                    Time_RunStopON = Now.AddSeconds(5.0) '5 seconds in future, then the permissive is meet
                End If

                If CELProject.IsFalse(newVal) Then
                    Time_RunStopON = Now.AddYears(1.0) 'time in future, this way the timer will not be expired
                    START_TIME_PERM_OK.Value = Values.False
                End If

            End If

        End Sub


        Private Sub OnStarterRectifier(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                If CELProject.IsTrue(newVal) Then

                    Time_Starter_RectifierOFF = Now.AddYears(1.0) 'time in future, this way the timer will not be expired
                    STARTER_OFF_TIME_PERM_OK.Value = Values.False

                End If

                If CELProject.IsFalse(newVal) Then

                    Time_Starter_RectifierOFF = Now.AddSeconds(2.0) '5 seconds in future, then the permissive is meet
                End If

            End If

        End Sub

        Private Sub OnTEST_LINK_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                If (CELProject.IsTrue(newVal)) Then

                    Try
                        System.Diagnostics.Process.Start("c:\TestLink APS5000A\TermPkg.exe")
                    Catch ex As System.Exception
                        MessageBox.Show("OnTEST_LINK_BTN: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    End Try

                End If
                TEST_LINK_BTN.Value = Values.False

            End If

        End Sub

