        Private Sub RevimaWritePointE1_F1InPerf(ByVal excelSheets As Excel.Sheets, ByVal Column As Integer)

            ' This function is called to write perf point in SUMMARY and DETAILS for point E1-F1
            Dim excelWorksheet As Excel.Worksheet

            Dim KW_DIFF_NAN As Boolean = Not Double.IsNaN(LOG_PERF_KW_400_KVA.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_KW_450_KVA.Value.ToDouble)

            If (Not Double.IsNaN(LOG_PERF_T6_400_DEGF.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_T6_450_DEGF.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet = excelSheets.Item("SUMMARY")
                excelWorksheet.Cells(21, 72).Value = LOG_PERF_EGT_CORR.Value.ToString(LOG_PERF_EGT_CORR.Format, Nothing)
            End If

            excelWorksheet = excelSheets.Item("DETAILS")

            If (Not Double.IsNaN(LOG_PERF_T_EGT_400_DEGF.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_T_EGT_450_DEGF.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(24, Column).Value = LOG_PERF_NORM_EGT.Value.ToString(LOG_PERF_NORM_EGT.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_T6_400_DEGF.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_T6_450_DEGF.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(26, Column).Value = LOG_PERF_EGT_CORR.Value.ToString(LOG_PERF_EGT_CORR.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_P_EXDUCT_400_PSIG.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_P_EXDUCT_450_PSIG.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(29, Column).Value = LOG_PERF_PEX_450.Value.ToString(LOG_PERF_PEX_450.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_T_INLET_400_DEGR.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_T_INLET_450_DEGR.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(31, Column).Value = LOG_PERF_TIN_450_DEGR.Value.ToString(LOG_PERF_TIN_450_DEGR.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_P3_400_PSIA.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_P3_450_PSIA.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(36, Column).Value = LOG_PERF_NORM_P3.Value.ToString(LOG_PERF_NORM_P3.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_T3_400_DEGF.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_T3_450_DEGF.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(38, Column).Value = LOG_PERF_NORM_T3.Value.ToString(LOG_PERF_NORM_T3.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_WF_400_PPH.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_WF_450_PPH.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(41, Column).Value = LOG_PERF_NORM_WF.Value.ToString(LOG_PERF_NORM_WF.Format, Nothing)
            End If

        End Sub

        Private Function CreateRevima12917PerformanceFile(ByVal AppendOption As Boolean, ByVal TestStepNb As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreateRevima12917PerformanceFile = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            If CELProject.EngineModel = "APS5000A" Then
                Try
                    'Unlock Sheets
                    excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                    excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                    excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                    If AppendOption = False Then

                        excelWorksheet = excelSheets.Item("SUMMARY")

                        'Engine S/N.   (Cell AB5)
                        excelWorksheet.Cells(5, 28).NumberFormat = "@"
                        excelWorksheet.Cells(5, 28).Value = UserInputsRevima.EngineSerialNumber

                        'Work Order    (Cell AB6)
                        excelWorksheet.Cells(6, 28).NumberFormat = "@"
                        excelWorksheet.Cells(6, 28).Value = UserInputsRevima.WorkOrder

                        'ECB S/N    (Cell AB7)
                        excelWorksheet.Cells(7, 28).NumberFormat = "@"
                        excelWorksheet.Cells(7, 28).Value = UserInputsRevima.ECBSerialNumber

                        'ECB P/N    (Cell AB8)
                        excelWorksheet.Cells(8, 28).NumberFormat = "@"
                        excelWorksheet.Cells(8, 28).Value = UserInputsRevima.ECBPartNumber

                        'Software Revision    (Cell AB9)
                        excelWorksheet.Cells(9, 28).NumberFormat = "@"
                        excelWorksheet.Cells(9, 28).Value = UserInputsRevima.SoftwareVersion

                        'Exhaust Duct S/N    (Cell AB10)
                        excelWorksheet.Cells(10, 28).NumberFormat = "@"
                        excelWorksheet.Cells(10, 28).Value = UserInputsRevima.ExhaustDuctSerialNumber

                        'Bellmouth S/N    (Cell AB11)
                        excelWorksheet.Cells(11, 28).NumberFormat = "@"
                        excelWorksheet.Cells(11, 28).Value = UserInputsRevima.BellmouthSerialNumber

                        'SG 1 S/N    (Cell AB12)
                        excelWorksheet.Cells(12, 28).NumberFormat = "@"
                        excelWorksheet.Cells(12, 28).Value = UserInputsRevima.SG1SerialNumber

                        'SG 2 S/N    (Cell AB13)
                        excelWorksheet.Cells(13, 28).NumberFormat = "@"
                        excelWorksheet.Cells(13, 28).Value = UserInputsRevima.SG2SerialNumber

                        'Turbine Vib Pickup S/N    (Cell AB14)
                        excelWorksheet.Cells(14, 28).NumberFormat = "@"
                        excelWorksheet.Cells(14, 28).Value = UserInputsRevima.TurbineVibPickupSerialNumber

                        'Gearbox Vib Pickup S/N    (Cell CE5)
                        excelWorksheet.Cells(5, 83).NumberFormat = "@"
                        excelWorksheet.Cells(5, 83).Value = UserInputsRevima.GearboxVibPickupSerialNumber

                        'CMSC S/N    (Cell CE6)
                        excelWorksheet.Cells(6, 83).NumberFormat = "@"
                        excelWorksheet.Cells(6, 83).Value = UserInputsRevima.CMSCSerialNumber

                        'Oil Type S/N    (Cell CE7)
                        excelWorksheet.Cells(7, 83).NumberFormat = "@"
                        excelWorksheet.Cells(7, 83).Value = UserInputsRevima.OilType

                        'TSN       (Cell CE8)
                        excelWorksheet.Cells(8, 83).NumberFormat = "@"
                        excelWorksheet.Cells(8, 83).Value = UserInputsRevima.TimeSinceNew

                        'CSN        (Cell CE9)
                        excelWorksheet.Cells(9, 83).NumberFormat = "@"
                        excelWorksheet.Cells(9, 83).Value = UserInputsRevima.CyclesSinceNew

                        'GCU 1 S/N    (Cell CE10)
                        excelWorksheet.Cells(10, 83).NumberFormat = "@"
                        excelWorksheet.Cells(10, 83).Value = UserInputsRevima.GCU1SerialNumber

                        'GCU 2 S/N    (Cell CE11)
                        excelWorksheet.Cells(11, 83).NumberFormat = "@"
                        excelWorksheet.Cells(11, 83).Value = UserInputsRevima.GCU2SerialNumber

                        'Reason        (Cell CE12)
                        excelWorksheet.Cells(12, 83).NumberFormat = "@"
                        excelWorksheet.Cells(12, 83).Value = UserInputsRevima.Reason

                        'Test Type (Cell CE13)
                        excelWorksheet.Cells(13, 83).NumberFormat = "@"
                        excelWorksheet.Cells(13, 83).Value = UserInputsRevima.TestType

                        'Date     (Cell CE14)
                        excelWorksheet.Cells(14, 83).NumberFormat = "@"
                        excelWorksheet.Cells(14, 83).Value = Format(Now, "d MMMM yyyy")

                        excelWorksheet = excelSheets.Item("ACCEPTANCE")

                        'Document Number (Cell AW43)
                        excelWorksheet.Cells(43, 49).NumberFormat = "@"
                        excelWorksheet.Cells(43, 49).Value = Custom_Parameters("APUTestedAccordingTo").ToString()

                    End If

                    Select Case TestStepNb
                        Case eTestStepAPS5000A.INITIAL_RUN_STEP_1

                            RevimaWriteEventInPerf(excelSheets.Item("DETAILS"), 31)

                        Case eTestStepAPS5000A.RUN_1_STEP_A

                            RevimaWritePointInPerfDetails(excelSheets.Item("DETAILS"), 43, False, False)

                        Case eTestStepAPS5000A.RUN_1_STEP_D

                            RevimaWritePointInPerfDetails(excelSheets.Item("DETAILS"), 55, True, False)

                        Case eTestStepAPS5000A.RUN_1_STEP_E

                            RevimaWritePointInPerfDetails(excelSheets.Item("DETAILS"), 67, True, False)

                            RevimaWritePointE1_F1InPerf(excelSheets, 115)

                        Case eTestStepAPS5000A.RUN_1_STEP_F

                            excelWorksheet = excelSheets.Item("SUMMARY")

                            excelWorksheet.Cells(20, 72).Value = LOG_PERF_VIB_GEARBOX.Value.ToString(LOG_PERF_VIB_GEARBOX.Format, Nothing)

                            RevimaWritePointInPerfDetails(excelSheets.Item("DETAILS"), 79, True, False)

                            RevimaWritePointE1_F1InPerf(excelSheets, 115)

                        Case eTestStepAPS5000A.RUN_1_STEP_G

                            RevimaWritePointInPerfDetails(excelSheets.Item("DETAILS"), 91, True, False)

                        Case eTestStepAPS5000A.RUN_1_STEP_I

                            RevimaWritePointInPerfDetails(excelSheets.Item("DETAILS"), 103, True, False)

                        Case eTestStepAPS5000A.RUN_2_STEP_A

                            excelWorksheet = excelSheets.Item("SUMMARY")

                            excelWorksheet.Cells(22, 98).Value = ET_50PCT.Value.ToString(ET_50PCT.Format, Nothing)
                            excelWorksheet.Cells(23, 98).Value = ET_RTL.Value.ToString(ET_RTL.Format, Nothing)

                            excelWorksheet = excelSheets.Item("DETAILS")

                            excelWorksheet.Cells(14, 127).Value = ET_50PCT.Value.ToString(ET_50PCT.Format, Nothing)
                            excelWorksheet.Cells(15, 127).Value = ET_RTL.Value.ToString(ET_RTL.Format, Nothing)

                        Case eTestStepAPS5000A.RUN_2_STEP_E

                            excelWorksheet = excelSheets.Item("SUMMARY")

                            excelWorksheet.Cells(20, 98).Value = VIB_GB_MAX.Value.ToString(VIB_GB_MAX.Format, Nothing)

                            excelWorksheet = excelSheets.Item("DETAILS")

                            excelWorksheet.Cells(16, 139).Value = VIB_GB_MAX.Value.ToString(VIB_GB_MAX.Format, Nothing)

                        Case eTestStepAPS5000A.RUN_2_STEP_F

                            excelWorksheet = excelSheets.Item("SUMMARY")

                            excelWorksheet.Cells(24, 98).Value = ET_RD.Value.ToString(ET_RD.Format, Nothing)

                            'Performed Test Details section
                            If CELProject.IsTrue(Log_Perf_Surge.Value) Then
                                excelWorksheet.Cells(29, 78).Value = "YES"
                            Else
                                excelWorksheet.Cells(29, 78).Value = "NO"
                            End If

                            If CELProject.IsTrue(Log_Perf_FlameOut.Value) Then
                                excelWorksheet.Cells(30, 78).Value = "YES"
                            Else
                                excelWorksheet.Cells(30, 78).Value = "NO"
                            End If

                            If CELProject.IsTrue(Log_Perf_Overspeed.Value) Then
                                excelWorksheet.Cells(31, 78).Value = "YES"
                            Else
                                excelWorksheet.Cells(31, 78).Value = "NO"
                            End If

                            If CELProject.IsTrue(Log_Perf_Underspeed.Value) Then
                                excelWorksheet.Cells(32, 78).Value = "YES"
                            Else
                                excelWorksheet.Cells(32, 78).Value = "NO"
                            End If

                            excelWorksheet = excelSheets.Item("DETAILS")

                            excelWorksheet.Cells(17, 151).Value = ET_RD.Value.ToString(ET_RD.Format, Nothing)

                        Case eTestStepAPS5000A.LEAK_CHECK

                            RevimaWritePointInPerfDetails(excelSheets.Item("DETAILS"), 163, False, True)

                        Case eTestStepAPS5000A.FINAL_RUN_TIME

                            excelWorksheet = excelSheets.Item("ACCEPTANCE")

                            'Test Result
                            If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value) Then
                                excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                            Else
                                excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                            End If

                            If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value) Then
                                excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                            Else
                                excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                            End If

                            excelWorksheet = excelSheets.Item("SUMMARY")

                            excelWorksheet.Cells(33, 78).Value = APU_FAULTS_DURING_TEST.Value.ToString(APU_FAULTS_DURING_TEST.Format, Nothing)
                            excelWorksheet.Cells(34, 78).Value = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format, Nothing)
                            excelWorksheet.Cells(35, 78).Value = NUMBER_OF_STARTS.Value.ToString(NUMBER_OF_STARTS.Format, Nothing)
                            excelWorksheet.Cells(36, 78).Value = LOG_PERF_FUEL_USED_TOTAL_LITERS.Value.ToString(LOG_PERF_FUEL_USED_TOTAL_LITERS.Format, Nothing)

                            RevimaWriteEventInPerf(excelSheets.Item("DETAILS"), 175)

                    End Select

                    TestProgress_RecordPerfStep(TestStepNb)

                Catch ex As Exception
                    System.Diagnostics.Trace.WriteLine("CreateRevima12917PerformanceFile: " + ex.Message)
                    MessageBox.Show(ex.ToString)
                    CreateRevima12917PerformanceFile = False
                Finally
                    'Lock Sheets
                    excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                    excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                    excelWorkbook.Worksheets(3).Protect(ProtectPassword)
                End Try
            End If
        End Function
        Private Sub ChineWriteEventInPerf(ByVal excelWorksheet As Excel.Worksheet, ByVal Column As Integer)

            excelWorksheet.Cells(59, Column).Value = HR_MTR_1.Value.ToString(HR_MTR_1.Format, Nothing)
            excelWorksheet.Cells(60, Column).Value = EVENT_1.Value.ToString(EVENT_1.Format, Nothing)
            excelWorksheet.Cells(61, Column).Value = HR_MTR_2.Value.ToString(HR_MTR_2.Format, Nothing)
            excelWorksheet.Cells(62, Column).Value = EVENT_2.Value.ToString(EVENT_2.Format, Nothing)

        End Sub

        Private Sub ChineWritePointInPerfDetails(ByVal excelWorksheet As Excel.Worksheet, ByVal Column As Integer, ByVal UseLogPerfValue As Boolean, ByVal DisplayOilMinMax As Boolean)

            ' This function is called to write perf point in Details for point D1, E1, F1, G1 and I1

            excelWorksheet.Cells(14, Column).Value = ET_RUN.Value.ToString(ET_RUN.Format, Nothing)

            If UseLogPerfValue Then
                excelWorksheet.Cells(19, Column).Value = LOG_PERF_N1_PCT.Value.ToString(LOG_PERF_N1_PCT.Format, Nothing)
                excelWorksheet.Cells(20, Column).Value = LOG_PERF_NGCOR.Value.ToString(LOG_PERF_NGCOR.Format, Nothing)
                excelWorksheet.Cells(21, Column).Value = LOG_PERF_VIB_GEARBOX.Value.ToString(LOG_PERF_VIB_GEARBOX.Format, Nothing)
                excelWorksheet.Cells(22, Column).Value = LOG_PERF_T_ETC1_DEGF.Value.ToString(LOG_PERF_T_ETC1_DEGF.Format, Nothing)
                excelWorksheet.Cells(23, Column).Value = LOG_PERF_T_ETC2_DEGF.Value.ToString(LOG_PERF_T_ETC2_DEGF.Format, Nothing)
                excelWorksheet.Cells(24, Column).Value = LOG_PERF_T_ETC_AVG_DEGF.Value.ToString(LOG_PERF_T_ETC_AVG_DEGF.Format, Nothing)
                excelWorksheet.Cells(26, Column).Value = LOG_PERF_T_EGT_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_AVG_DEGF.Format, Nothing)
                excelWorksheet.Cells(29, Column).Value = LOG_PERF_P_ESP_PSIG.Value.ToString(LOG_PERF_P_ESP_PSIG.Format, Nothing)
                excelWorksheet.Cells(31, Column).Value = LOG_PERF_T_INLET_AVG_DEGF.Value.ToString(LOG_PERF_T_INLET_AVG_DEGF.Format, Nothing)
                excelWorksheet.Cells(33, Column).Value = LOG_PERF_FROM_CANBUS_TA_APUIN_DEGC.Value.ToString(LOG_PERF_FROM_CANBUS_TA_APUIN_DEGC.Format, Nothing)
                excelWorksheet.Cells(34, Column).Value = LOG_PERF_P_INLET_PSIG.Value.ToString(LOG_PERF_P_INLET_PSIG.Format, Nothing)
                excelWorksheet.Cells(35, Column).Value = LOG_PERF_P_BARO_PSIA.Value.ToString(LOG_PERF_P_BARO_PSIA.Format, Nothing)
                excelWorksheet.Cells(36, Column).Value = LOG_PERF_P_DISCH_PSIG.Value.ToString(LOG_PERF_P_DISCH_PSIG.Format, Nothing)
                excelWorksheet.Cells(38, Column).Value = LOG_PERF_T_DISCH_DEGF.Value.ToString(LOG_PERF_T_DISCH_DEGF.Format, Nothing)
                excelWorksheet.Cells(40, Column).Value = LOG_PERF_P_GEARBOX_INH2OG.Value.ToString(LOG_PERF_P_GEARBOX_INH2OG.Format, Nothing)
                excelWorksheet.Cells(41, Column).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)
                excelWorksheet.Cells(43, Column).Value = LOG_PERF_T_OIL_DEGF.Value.ToString(LOG_PERF_T_OIL_DEGF.Format, Nothing)
                excelWorksheet.Cells(44, Column).Value = LOG_PERF_PO_APUFIL_PSIA.Value.ToString(LOG_PERF_PO_APUFIL_PSIA.Format, Nothing)
                excelWorksheet.Cells(45, Column).Value = LOG_PERF_PO_APUSYS_PSIA.Value.ToString(LOG_PERF_PO_APUSYS_PSIA.Format, Nothing)
                excelWorksheet.Cells(48, Column).Value = LOG_PERF_P_OIL_GEN_L_PSIA.Value.ToString(LOG_PERF_P_OIL_GEN_L_PSIA.Format, Nothing)
                excelWorksheet.Cells(49, Column).Value = LOG_PERF_P_OIL_GEN_R_PSIA.Value.ToString(LOG_PERF_P_OIL_GEN_R_PSIA.Format, Nothing)
                excelWorksheet.Cells(52, Column).Value = LOG_PERF_LBL_VOLTAGE_AVG.Value.ToString(LOG_PERF_LBL_VOLTAGE_AVG.Format, Nothing)
                excelWorksheet.Cells(53, Column).Value = LOG_PERF_LBL_CURRENT_AVG.Value.ToString(LOG_PERF_LBL_CURRENT_AVG.Format, Nothing)
                excelWorksheet.Cells(54, Column).Value = LOG_PERF_LBL_POWER_TOT.Value.ToString(LOG_PERF_LBL_POWER_TOT.Format, Nothing)
                excelWorksheet.Cells(55, Column).Value = LOG_PERF_LBR_VOLTAGE_AVG.Value.ToString(LOG_PERF_LBR_VOLTAGE_AVG.Format, Nothing)
                excelWorksheet.Cells(56, Column).Value = LOG_PERF_LBR_CURRENT_AVG.Value.ToString(LOG_PERF_LBR_CURRENT_AVG.Format, Nothing)
                excelWorksheet.Cells(57, Column).Value = LOG_PERF_LBR_POWER_TOT.Value.ToString(LOG_PERF_LBR_POWER_TOT.Format, Nothing)
                excelWorksheet.Cells(58, Column).Value = LOG_PERF_LB_POWER_TOT_KVA.Value.ToString(LOG_PERF_LB_POWER_TOT_KVA.Format, Nothing)
            Else
                excelWorksheet.Cells(19, Column).Value = N1_PCT.Value.ToString(N1_PCT.Format, Nothing)
                excelWorksheet.Cells(20, Column).Value = NGCOR.Value.ToString(NGCOR.Format, Nothing)
                excelWorksheet.Cells(21, Column).Value = VIB_GEARBOX.Value.ToString(VIB_GEARBOX.Format, Nothing)
                excelWorksheet.Cells(22, Column).Value = T_ETC1_DEGF.Value.ToString(T_ETC1_DEGF.Format, Nothing)
                excelWorksheet.Cells(23, Column).Value = T_ETC2_DEGF.Value.ToString(T_ETC2_DEGF.Format, Nothing)
                excelWorksheet.Cells(24, Column).Value = T_ETC_AVG_DEGF.Value.ToString(T_ETC_AVG_DEGF.Format, Nothing)
                excelWorksheet.Cells(26, Column).Value = T_EGT_AVG_DEGF.Value.ToString(T_EGT_AVG_DEGF.Format, Nothing)
                excelWorksheet.Cells(29, Column).Value = P_ESP_PSIG.Value.ToString(P_ESP_PSIG.Format, Nothing)
                excelWorksheet.Cells(31, Column).Value = T_INLET_AVG_DEGF.Value.ToString(T_INLET_AVG_DEGF.Format, Nothing)
                excelWorksheet.Cells(33, Column).Value = FROM_CANBUS_TA_APUIN_DEGC.Value.ToString(FROM_CANBUS_TA_APUIN_DEGC.Format, Nothing)
                excelWorksheet.Cells(34, Column).Value = P_INLET_PSIG.Value.ToString(P_INLET_PSIG.Format, Nothing)
                excelWorksheet.Cells(35, Column).Value = P_BARO_PSIA.Value.ToString(P_BARO_PSIA.Format, Nothing)
                excelWorksheet.Cells(36, Column).Value = P_DISCH_PSIG.Value.ToString(P_DISCH_PSIG.Format, Nothing)
                excelWorksheet.Cells(38, Column).Value = T_DISCH_DEGF.Value.ToString(T_DISCH_DEGF.Format, Nothing)
                excelWorksheet.Cells(40, Column).Value = P_GEARBOX_INH2OG.Value.ToString(P_GEARBOX_INH2OG.Format, Nothing)
                excelWorksheet.Cells(41, Column).Value = WF_PPH.Value.ToString(WF_PPH.Format, Nothing)
                excelWorksheet.Cells(43, Column).Value = T_OIL_DEGF.Value.ToString(T_OIL_DEGF.Format, Nothing)
                excelWorksheet.Cells(44, Column).Value = PO_APUFIL_PSIA.Value.ToString(PO_APUFIL_PSIA.Format, Nothing)
                excelWorksheet.Cells(45, Column).Value = PO_APUSYS_PSIA.Value.ToString(PO_APUSYS_PSIA.Format, Nothing)
                excelWorksheet.Cells(48, Column).Value = P_OIL_GEN_L_PSIA.Value.ToString(P_OIL_GEN_L_PSIA.Format, Nothing)
                excelWorksheet.Cells(49, Column).Value = P_OIL_GEN_R_PSIA.Value.ToString(P_OIL_GEN_R_PSIA.Format, Nothing)
                excelWorksheet.Cells(52, Column).Value = LBL_VOLTAGE_AVG.Value.ToString(LBL_VOLTAGE_AVG.Format, Nothing)
                excelWorksheet.Cells(53, Column).Value = LBL_CURRENT_AVG.Value.ToString(LBL_CURRENT_AVG.Format, Nothing)
                excelWorksheet.Cells(54, Column).Value = LBL_POWER_TOT.Value.ToString(LBL_POWER_TOT.Format, Nothing)
                excelWorksheet.Cells(55, Column).Value = LBR_VOLTAGE_AVG.Value.ToString(LBR_VOLTAGE_AVG.Format, Nothing)
                excelWorksheet.Cells(56, Column).Value = LBR_CURRENT_AVG.Value.ToString(LBR_CURRENT_AVG.Format, Nothing)
                excelWorksheet.Cells(57, Column).Value = LBR_POWER_TOT.Value.ToString(LBR_POWER_TOT.Format, Nothing)
                excelWorksheet.Cells(58, Column).Value = LB_POWER_TOT_KVA.Value.ToString(LB_POWER_TOT_KVA.Format, Nothing)

                If DisplayOilMinMax Then
                    excelWorksheet.Cells(46, Column).Value = PO_APU_MIN.Value.ToString(PO_APU_MIN.Format, Nothing)
                    excelWorksheet.Cells(47, Column).Value = PO_APU_MAX.Value.ToString(PO_APU_MAX.Format, Nothing)
                    excelWorksheet.Cells(50, Column).Value = PO_GEN_MIN.Value.ToString(PO_GEN_MIN.Format, Nothing)
                    excelWorksheet.Cells(51, Column).Value = PO_GEN_MAX.Value.ToString(PO_GEN_MAX.Format, Nothing)

                End If
            End If

        End Sub

        Private Sub ChineWritePointE1_F1InPerf(ByVal excelSheets As Excel.Sheets, ByVal Column As Integer)

            ' This function is called to write perf point in SUMMARY and DETAILS for point E1-F1
            Dim excelWorksheet As Excel.Worksheet

            Dim KW_DIFF_NAN As Boolean = Not Double.IsNaN(LOG_PERF_KW_400_KVA.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_KW_450_KVA.Value.ToDouble)

            If (Not Double.IsNaN(LOG_PERF_T6_400_DEGF.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_T6_450_DEGF.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet = excelSheets.Item("SUMMARY")
                excelWorksheet.Cells(21, 72).Value = LOG_PERF_EGT_CORR.Value.ToString(LOG_PERF_EGT_CORR.Format, Nothing)
            End If

            excelWorksheet = excelSheets.Item("DETAILS")

            If (Not Double.IsNaN(LOG_PERF_T_EGT_400_DEGF.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_T_EGT_450_DEGF.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(25, Column).Value = LOG_PERF_NORM_EGT.Value.ToString(LOG_PERF_NORM_EGT.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_T6_400_DEGF.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_T6_450_DEGF.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(27, Column).Value = LOG_PERF_EGT_CORR.Value.ToString(LOG_PERF_EGT_CORR.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_P_EXDUCT_400_PSIG.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_P_EXDUCT_450_PSIG.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(30, Column).Value = LOG_PERF_PEX_450.Value.ToString(LOG_PERF_PEX_450.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_T_INLET_400_DEGR.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_T_INLET_450_DEGR.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(32, Column).Value = LOG_PERF_TIN_450_DEGR.Value.ToString(LOG_PERF_TIN_450_DEGR.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_P3_400_PSIA.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_P3_450_PSIA.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(37, Column).Value = LOG_PERF_NORM_P3.Value.ToString(LOG_PERF_NORM_P3.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_T3_400_DEGF.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_T3_450_DEGF.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(39, Column).Value = LOG_PERF_NORM_T3.Value.ToString(LOG_PERF_NORM_T3.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_WF_400_PPH.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_WF_450_PPH.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(42, Column).Value = LOG_PERF_NORM_WF.Value.ToString(LOG_PERF_NORM_WF.Format, Nothing)
            End If

        End Sub

        Private Function CreateChine11813PerformanceFile(ByVal AppendOption As Boolean, ByVal TestStepNb As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreateChine11813PerformanceFile = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            If CELProject.EngineModel = "APS5000A" Then
                Try
                    'Unlock Sheets
                    excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                    excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                    excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                    If AppendOption = False Then

                        excelWorksheet = excelSheets.Item("SUMMARY")

                        'Engine S/N.   (Cell AB5)
                        excelWorksheet.Cells(5, 28).NumberFormat = "@"
                        excelWorksheet.Cells(5, 28).Value = UserInputsChine.EngineSerialNumber

                        'Work Order    (Cell AB6)
                        excelWorksheet.Cells(6, 28).NumberFormat = "@"
                        excelWorksheet.Cells(6, 28).Value = UserInputsChine.WorkOrder

                        'ECB S/N    (Cell AB7)
                        excelWorksheet.Cells(7, 28).NumberFormat = "@"
                        excelWorksheet.Cells(7, 28).Value = UserInputsChine.ECBSerialNumber

                        'ECB P/N    (Cell AB8)
                        excelWorksheet.Cells(8, 28).NumberFormat = "@"
                        excelWorksheet.Cells(8, 28).Value = UserInputsChine.ECBPartNumber

                        'Software Version    (Cell AB9)
                        excelWorksheet.Cells(9, 28).NumberFormat = "@"
                        excelWorksheet.Cells(9, 28).Value = UserInputsChine.SoftwareVersion

                        'SG 1 S/N    (Cell AB10)
                        excelWorksheet.Cells(10, 28).NumberFormat = "@"
                        excelWorksheet.Cells(10, 28).Value = UserInputsChine.ASGRSerialNumber

                        'SG 2 S/N    (Cell AB11)
                        excelWorksheet.Cells(11, 28).NumberFormat = "@"
                        excelWorksheet.Cells(11, 28).Value = UserInputsChine.ASGLSerialNumber

                        'Sample T Fuel (Cell AB12)
                        excelWorksheet.Cells(12, 28).NumberFormat = "@"
                        excelWorksheet.Cells(12, 28).Value = UserInputsChine.SampleTFuel

                        'Sample T Fuel (Cell AB13)
                        excelWorksheet.Cells(13, 28).NumberFormat = "@"
                        excelWorksheet.Cells(13, 28).Value = UserInputsChine.SampleSG

                        'Turbine Vib Pickup S/N    (Cell AB14)
                        excelWorksheet.Cells(14, 28).NumberFormat = "@"
                        excelWorksheet.Cells(14, 28).Value = UserInputsChine.TurbineVibPickupSerialNumber

                        'Gearbox Vib Pickup S/N    (Cell CE5)
                        excelWorksheet.Cells(5, 83).NumberFormat = "@"
                        excelWorksheet.Cells(5, 83).Value = UserInputsChine.GearboxVibPickupSerialNumber

                        'CMSC S/N    (Cell CE6)
                        excelWorksheet.Cells(6, 83).NumberFormat = "@"
                        excelWorksheet.Cells(6, 83).Value = UserInputsChine.CMSCSerialNumber

                        'Oil Type S/N    (Cell CE7)
                        excelWorksheet.Cells(7, 83).NumberFormat = "@"
                        excelWorksheet.Cells(7, 83).Value = UserInputsChine.OilType

                        'GCU 1 S/N    (Cell CE8)
                        excelWorksheet.Cells(8, 83).NumberFormat = "@"
                        excelWorksheet.Cells(8, 83).Value = UserInputsChine.GCURSerialNumber

                        'GCU 2 S/N    (Cell CE9)
                        excelWorksheet.Cells(9, 83).NumberFormat = "@"
                        excelWorksheet.Cells(9, 83).Value = UserInputsChine.GCULSerialNumber

                        'TSN       (Cell CE10)
                        excelWorksheet.Cells(10, 83).NumberFormat = "@"
                        excelWorksheet.Cells(10, 83).Value = UserInputsChine.TimeSinceNew

                        'CSN        (Cell CE11)
                        excelWorksheet.Cells(11, 83).NumberFormat = "@"
                        excelWorksheet.Cells(11, 83).Value = UserInputsChine.CyclesSinceNew

                        'Reason        (Cell CE12)
                        excelWorksheet.Cells(12, 83).NumberFormat = "@"
                        excelWorksheet.Cells(12, 83).Value = UserInputsChine.Reason

                        'Test Type (Cell CE13)
                        excelWorksheet.Cells(13, 83).NumberFormat = "@"
                        excelWorksheet.Cells(13, 83).Value = UserInputsChine.TestType

                        'Date     (Cell CE14)
                        excelWorksheet.Cells(14, 83).NumberFormat = "@"
                        excelWorksheet.Cells(14, 83).Value = Format(Now, "d MMMM yyyy")

                        excelWorksheet = excelSheets.Item("ACCEPTANCE")

                        'Document Number (Cell AW43)
                        excelWorksheet.Cells(43, 49).NumberFormat = "@"
                        excelWorksheet.Cells(43, 49).Value = Custom_Parameters("APUTestedAccordingTo").ToString()

                    End If

                    Select Case TestStepNb
                        Case eTestStepAPS5000A.INITIAL_RUN_STEP_1

                            ChineWriteEventInPerf(excelSheets.Item("DETAILS"), 31)

                        Case eTestStepAPS5000A.RUN_1_STEP_A

                            ChineWritePointInPerfDetails(excelSheets.Item("DETAILS"), 43, False, False)

                        Case eTestStepAPS5000A.RUN_1_STEP_D

                            ChineWritePointInPerfDetails(excelSheets.Item("DETAILS"), 55, True, False)

                        Case eTestStepAPS5000A.RUN_1_STEP_E

                            ChineWritePointInPerfDetails(excelSheets.Item("DETAILS"), 67, True, False)

                            ChineWritePointE1_F1InPerf(excelSheets, 115)

                        Case eTestStepAPS5000A.RUN_1_STEP_F

                            excelWorksheet = excelSheets.Item("SUMMARY")

                            excelWorksheet.Cells(20, 72).Value = LOG_PERF_VIB_GEARBOX.Value.ToString(LOG_PERF_VIB_GEARBOX.Format, Nothing)

                            ChineWritePointInPerfDetails(excelSheets.Item("DETAILS"), 79, True, False)

                            ChineWritePointE1_F1InPerf(excelSheets, 115)

                        Case eTestStepAPS5000A.RUN_1_STEP_G

                            ChineWritePointInPerfDetails(excelSheets.Item("DETAILS"), 91, True, False)

                        Case eTestStepAPS5000A.RUN_1_STEP_I

                            ChineWritePointInPerfDetails(excelSheets.Item("DETAILS"), 103, True, False)

                        Case eTestStepAPS5000A.RUN_2_STEP_A

                            excelWorksheet = excelSheets.Item("SUMMARY")

                            excelWorksheet.Cells(22, 98).Value = ET_50PCT.Value.ToString(ET_50PCT.Format, Nothing)
                            excelWorksheet.Cells(23, 98).Value = ET_RTL.Value.ToString(ET_RTL.Format, Nothing)

                            excelWorksheet = excelSheets.Item("DETAILS")

                            excelWorksheet.Cells(15, 127).Value = ET_50PCT.Value.ToString(ET_50PCT.Format, Nothing)
                            excelWorksheet.Cells(16, 127).Value = ET_RTL.Value.ToString(ET_RTL.Format, Nothing)

                        Case eTestStepAPS5000A.RUN_2_STEP_E

                            excelWorksheet = excelSheets.Item("SUMMARY")

                            excelWorksheet.Cells(20, 98).Value = VIB_GB_MAX.Value.ToString(VIB_GB_MAX.Format, Nothing)

                            excelWorksheet = excelSheets.Item("DETAILS")

                            excelWorksheet.Cells(17, 139).Value = VIB_GB_MAX.Value.ToString(VIB_GB_MAX.Format, Nothing)

                        Case eTestStepAPS5000A.RUN_2_STEP_F

                            excelWorksheet = excelSheets.Item("SUMMARY")

                            excelWorksheet.Cells(24, 98).Value = ET_RD.Value.ToString(ET_RD.Format, Nothing)

                            'Performed Test Details section
                            If CELProject.IsTrue(Log_Perf_Surge.Value) Then
                                excelWorksheet.Cells(29, 78).Value = "YES"
                            Else
                                excelWorksheet.Cells(29, 78).Value = "NO"
                            End If

                            If CELProject.IsTrue(Log_Perf_FlameOut.Value) Then
                                excelWorksheet.Cells(30, 78).Value = "YES"
                            Else
                                excelWorksheet.Cells(30, 78).Value = "NO"
                            End If

                            If CELProject.IsTrue(Log_Perf_Overspeed.Value) Then
                                excelWorksheet.Cells(31, 78).Value = "YES"
                            Else
                                excelWorksheet.Cells(31, 78).Value = "NO"
                            End If

                            If CELProject.IsTrue(Log_Perf_Underspeed.Value) Then
                                excelWorksheet.Cells(32, 78).Value = "YES"
                            Else
                                excelWorksheet.Cells(32, 78).Value = "NO"
                            End If

                            excelWorksheet = excelSheets.Item("DETAILS")

                            excelWorksheet.Cells(18, 151).Value = ET_RD.Value.ToString(ET_RD.Format, Nothing)

                        Case eTestStepAPS5000A.LEAK_CHECK

                            ChineWritePointInPerfDetails(excelSheets.Item("DETAILS"), 163, False, True)

                        Case eTestStepAPS5000A.FINAL_RUN_TIME

                            excelWorksheet = excelSheets.Item("ACCEPTANCE")

                            'Test Result
                            If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value) Then
                                excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                            Else
                                excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                            End If

                            If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value) Then
                                excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                            Else
                                excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                            End If

                            excelWorksheet = excelSheets.Item("SUMMARY")

                            excelWorksheet.Cells(33, 78).Value = APU_FAULTS_DURING_TEST.Value.ToString(APU_FAULTS_DURING_TEST.Format, Nothing)
                            excelWorksheet.Cells(34, 78).Value = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format, Nothing)
                            excelWorksheet.Cells(35, 78).Value = NUMBER_OF_STARTS.Value.ToString(NUMBER_OF_STARTS.Format, Nothing)
                            excelWorksheet.Cells(36, 78).Value = LOG_PERF_FUEL_USED_TOTAL_LITERS.Value.ToString(LOG_PERF_FUEL_USED_TOTAL_LITERS.Format, Nothing)

                            ChineWriteEventInPerf(excelSheets.Item("DETAILS"), 175)

                    End Select
                Catch ex As Exception
                    System.Diagnostics.Trace.WriteLine("CreateChine11813PerformanceFile: " + ex.Message)
                    MessageBox.Show(ex.ToString)
                    CreateChine11813PerformanceFile = False
                Finally
                    'Lock Sheets
                    excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                    excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                    excelWorkbook.Worksheets(3).Protect(ProtectPassword)
                End Try
            End If
        End Function

        Private Sub EpcorWriteEventInPerf(ByVal excelWorksheet As Excel.Worksheet, ByVal Column As Integer)

            excelWorksheet.Cells(59, Column).Value = HR_MTR_1.Value.ToString(HR_MTR_1.Format, Nothing)
            excelWorksheet.Cells(60, Column).Value = EVENT_1.Value.ToString(EVENT_1.Format, Nothing)
            excelWorksheet.Cells(61, Column).Value = HR_MTR_2.Value.ToString(HR_MTR_2.Format, Nothing)
            excelWorksheet.Cells(62, Column).Value = EVENT_2.Value.ToString(EVENT_2.Format, Nothing)

        End Sub

        Private Sub EpcorWritePointInPerfDetails(ByVal excelWorksheet As Excel.Worksheet, ByVal Column As Integer, ByVal UseLogPerfValue As Boolean, ByVal DisplayOilMinMax As Boolean)

            ' This function is called to write perf point in Details for point D1, E1, F1, G1 and I1

            excelWorksheet.Cells(14, Column).Value = ET_RUN.Value.ToString(ET_RUN.Format, Nothing)

            If UseLogPerfValue Then
                excelWorksheet.Cells(19, Column).Value = LOG_PERF_N1_PCT.Value.ToString(LOG_PERF_N1_PCT.Format, Nothing)
                excelWorksheet.Cells(20, Column).Value = LOG_PERF_NGCOR.Value.ToString(LOG_PERF_NGCOR.Format, Nothing)
                excelWorksheet.Cells(21, Column).Value = LOG_PERF_VIB_GEARBOX.Value.ToString(LOG_PERF_VIB_GEARBOX.Format, Nothing)
                excelWorksheet.Cells(22, Column).Value = LOG_PERF_T_ETC1_DEGF.Value.ToString(LOG_PERF_T_ETC1_DEGF.Format, Nothing)
                excelWorksheet.Cells(23, Column).Value = LOG_PERF_T_ETC2_DEGF.Value.ToString(LOG_PERF_T_ETC2_DEGF.Format, Nothing)
                excelWorksheet.Cells(24, Column).Value = LOG_PERF_T_ETC_AVG_DEGF.Value.ToString(LOG_PERF_T_ETC_AVG_DEGF.Format, Nothing)
                excelWorksheet.Cells(26, Column).Value = LOG_PERF_T_EGT_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_AVG_DEGF.Format, Nothing)
                excelWorksheet.Cells(29, Column).Value = LOG_PERF_P_ESP_PSIG.Value.ToString(LOG_PERF_P_ESP_PSIG.Format, Nothing)
                excelWorksheet.Cells(31, Column).Value = LOG_PERF_T_INLET_AVG_DEGF.Value.ToString(LOG_PERF_T_INLET_AVG_DEGF.Format, Nothing)
                excelWorksheet.Cells(33, Column).Value = LOG_PERF_FROM_CANBUS_TA_APUIN_DEGC.Value.ToString(LOG_PERF_FROM_CANBUS_TA_APUIN_DEGC.Format, Nothing)
                excelWorksheet.Cells(34, Column).Value = LOG_PERF_P_INLET_PSIG.Value.ToString(LOG_PERF_P_INLET_PSIG.Format, Nothing)
                excelWorksheet.Cells(35, Column).Value = LOG_PERF_P_BARO_PSIA.Value.ToString(LOG_PERF_P_BARO_PSIA.Format, Nothing)
                excelWorksheet.Cells(36, Column).Value = LOG_PERF_P_DISCH_PSIG.Value.ToString(LOG_PERF_P_DISCH_PSIG.Format, Nothing)
                excelWorksheet.Cells(38, Column).Value = LOG_PERF_T_DISCH_DEGF.Value.ToString(LOG_PERF_T_DISCH_DEGF.Format, Nothing)
                excelWorksheet.Cells(40, Column).Value = LOG_PERF_P_GEARBOX_INH2OG.Value.ToString(LOG_PERF_P_GEARBOX_INH2OG.Format, Nothing)
                excelWorksheet.Cells(41, Column).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)
                excelWorksheet.Cells(43, Column).Value = LOG_PERF_T_OIL_DEGF.Value.ToString(LOG_PERF_T_OIL_DEGF.Format, Nothing)
                excelWorksheet.Cells(44, Column).Value = LOG_PERF_PO_APUFIL_PSIA.Value.ToString(LOG_PERF_PO_APUFIL_PSIA.Format, Nothing)
                excelWorksheet.Cells(45, Column).Value = LOG_PERF_PO_APUSYS_PSIA.Value.ToString(LOG_PERF_PO_APUSYS_PSIA.Format, Nothing)
                excelWorksheet.Cells(48, Column).Value = LOG_PERF_P_OIL_GEN_L_PSIA.Value.ToString(LOG_PERF_P_OIL_GEN_L_PSIA.Format, Nothing)
                excelWorksheet.Cells(49, Column).Value = LOG_PERF_P_OIL_GEN_R_PSIA.Value.ToString(LOG_PERF_P_OIL_GEN_R_PSIA.Format, Nothing)
                excelWorksheet.Cells(52, Column).Value = LOG_PERF_LBL_VOLTAGE_AVG.Value.ToString(LOG_PERF_LBL_VOLTAGE_AVG.Format, Nothing)
                excelWorksheet.Cells(53, Column).Value = LOG_PERF_LBL_CURRENT_AVG.Value.ToString(LOG_PERF_LBL_CURRENT_AVG.Format, Nothing)
                excelWorksheet.Cells(54, Column).Value = LOG_PERF_LBL_POWER_TOT.Value.ToString(LOG_PERF_LBL_POWER_TOT.Format, Nothing)
                excelWorksheet.Cells(55, Column).Value = LOG_PERF_LBR_VOLTAGE_AVG.Value.ToString(LOG_PERF_LBR_VOLTAGE_AVG.Format, Nothing)
                excelWorksheet.Cells(56, Column).Value = LOG_PERF_LBR_CURRENT_AVG.Value.ToString(LOG_PERF_LBR_CURRENT_AVG.Format, Nothing)
                excelWorksheet.Cells(57, Column).Value = LOG_PERF_LBR_POWER_TOT.Value.ToString(LOG_PERF_LBR_POWER_TOT.Format, Nothing)
                excelWorksheet.Cells(58, Column).Value = LOG_PERF_LB_POWER_TOT_KVA.Value.ToString(LOG_PERF_LB_POWER_TOT_KVA.Format, Nothing)
            Else
                excelWorksheet.Cells(19, Column).Value = N1_PCT.Value.ToString(N1_PCT.Format, Nothing)
                excelWorksheet.Cells(20, Column).Value = NGCOR.Value.ToString(NGCOR.Format, Nothing)
                excelWorksheet.Cells(21, Column).Value = VIB_GEARBOX.Value.ToString(VIB_GEARBOX.Format, Nothing)
                excelWorksheet.Cells(22, Column).Value = T_ETC1_DEGF.Value.ToString(T_ETC1_DEGF.Format, Nothing)
                excelWorksheet.Cells(23, Column).Value = T_ETC2_DEGF.Value.ToString(T_ETC2_DEGF.Format, Nothing)
                excelWorksheet.Cells(24, Column).Value = T_ETC_AVG_DEGF.Value.ToString(T_ETC_AVG_DEGF.Format, Nothing)
                excelWorksheet.Cells(26, Column).Value = T_EGT_AVG_DEGF.Value.ToString(T_EGT_AVG_DEGF.Format, Nothing)
                excelWorksheet.Cells(29, Column).Value = P_ESP_PSIG.Value.ToString(P_ESP_PSIG.Format, Nothing)
                excelWorksheet.Cells(31, Column).Value = T_INLET_AVG_DEGF.Value.ToString(T_INLET_AVG_DEGF.Format, Nothing)
                excelWorksheet.Cells(33, Column).Value = FROM_CANBUS_TA_APUIN_DEGC.Value.ToString(FROM_CANBUS_TA_APUIN_DEGC.Format, Nothing)
                excelWorksheet.Cells(34, Column).Value = P_INLET_PSIG.Value.ToString(P_INLET_PSIG.Format, Nothing)
                excelWorksheet.Cells(35, Column).Value = P_BARO_PSIA.Value.ToString(P_BARO_PSIA.Format, Nothing)
                excelWorksheet.Cells(36, Column).Value = P_DISCH_PSIG.Value.ToString(P_DISCH_PSIG.Format, Nothing)
                excelWorksheet.Cells(38, Column).Value = T_DISCH_DEGF.Value.ToString(T_DISCH_DEGF.Format, Nothing)
                excelWorksheet.Cells(40, Column).Value = P_GEARBOX_INH2OG.Value.ToString(P_GEARBOX_INH2OG.Format, Nothing)
                excelWorksheet.Cells(41, Column).Value = WF_PPH.Value.ToString(WF_PPH.Format, Nothing)
                excelWorksheet.Cells(43, Column).Value = T_OIL_DEGF.Value.ToString(T_OIL_DEGF.Format, Nothing)
                excelWorksheet.Cells(44, Column).Value = PO_APUFIL_PSIA.Value.ToString(PO_APUFIL_PSIA.Format, Nothing)
                excelWorksheet.Cells(45, Column).Value = PO_APUSYS_PSIA.Value.ToString(PO_APUSYS_PSIA.Format, Nothing)
                excelWorksheet.Cells(48, Column).Value = P_OIL_GEN_L_PSIA.Value.ToString(P_OIL_GEN_L_PSIA.Format, Nothing)
                excelWorksheet.Cells(49, Column).Value = P_OIL_GEN_R_PSIA.Value.ToString(P_OIL_GEN_R_PSIA.Format, Nothing)
                excelWorksheet.Cells(52, Column).Value = LBL_VOLTAGE_AVG.Value.ToString(LBL_VOLTAGE_AVG.Format, Nothing)
                excelWorksheet.Cells(53, Column).Value = LBL_CURRENT_AVG.Value.ToString(LBL_CURRENT_AVG.Format, Nothing)
                excelWorksheet.Cells(54, Column).Value = LBL_POWER_TOT.Value.ToString(LBL_POWER_TOT.Format, Nothing)
                excelWorksheet.Cells(55, Column).Value = LBR_VOLTAGE_AVG.Value.ToString(LBR_VOLTAGE_AVG.Format, Nothing)
                excelWorksheet.Cells(56, Column).Value = LBR_CURRENT_AVG.Value.ToString(LBR_CURRENT_AVG.Format, Nothing)
                excelWorksheet.Cells(57, Column).Value = LBR_POWER_TOT.Value.ToString(LBR_POWER_TOT.Format, Nothing)
                excelWorksheet.Cells(58, Column).Value = LB_POWER_TOT_KVA.Value.ToString(LB_POWER_TOT_KVA.Format, Nothing)

                If DisplayOilMinMax Then
                    excelWorksheet.Cells(46, Column).Value = PO_APU_MIN.Value.ToString(PO_APU_MIN.Format, Nothing)
                    excelWorksheet.Cells(47, Column).Value = PO_APU_MAX.Value.ToString(PO_APU_MAX.Format, Nothing)
                    excelWorksheet.Cells(50, Column).Value = PO_GEN_MIN.Value.ToString(PO_GEN_MIN.Format, Nothing)
                    excelWorksheet.Cells(51, Column).Value = PO_GEN_MAX.Value.ToString(PO_GEN_MAX.Format, Nothing)

                End If
            End If

        End Sub

        Private Sub EpcorWritePointE1_F1InPerf(ByVal excelSheets As Excel.Sheets, ByVal Column As Integer)

            ' This function is called to write perf point in SUMMARY and DETAILS for point E1-F1
            Dim excelWorksheet As Excel.Worksheet

            Dim KW_DIFF_NAN As Boolean = Not Double.IsNaN(LOG_PERF_KW_400_KVA.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_KW_450_KVA.Value.ToDouble)

            If (Not Double.IsNaN(LOG_PERF_T6_400_DEGF.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_T6_450_DEGF.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet = excelSheets.Item("SUMMARY")
                excelWorksheet.Cells(21, 72).Value = LOG_PERF_EGT_CORR.Value.ToString(LOG_PERF_EGT_CORR.Format, Nothing)
            End If

            excelWorksheet = excelSheets.Item("DETAILS")

            If (Not Double.IsNaN(LOG_PERF_T_EGT_400_DEGF.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_T_EGT_450_DEGF.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(25, Column).Value = LOG_PERF_NORM_EGT.Value.ToString(LOG_PERF_NORM_EGT.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_T6_400_DEGF.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_T6_450_DEGF.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(27, Column).Value = LOG_PERF_EGT_CORR.Value.ToString(LOG_PERF_EGT_CORR.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_P_EXDUCT_400_PSIG.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_P_EXDUCT_450_PSIG.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(30, Column).Value = LOG_PERF_PEX_450.Value.ToString(LOG_PERF_PEX_450.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_T_INLET_400_DEGR.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_T_INLET_450_DEGR.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(32, Column).Value = LOG_PERF_TIN_450_DEGR.Value.ToString(LOG_PERF_TIN_450_DEGR.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_P3_400_PSIA.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_P3_450_PSIA.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(37, Column).Value = LOG_PERF_NORM_P3.Value.ToString(LOG_PERF_NORM_P3.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_T3_400_DEGF.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_T3_450_DEGF.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(39, Column).Value = LOG_PERF_NORM_T3.Value.ToString(LOG_PERF_NORM_T3.Format, Nothing)
            End If

            If (Not Double.IsNaN(LOG_PERF_WF_400_PPH.Value.ToDouble) And Not Double.IsNaN(LOG_PERF_WF_450_PPH.Value.ToDouble) And KW_DIFF_NAN) Then
                excelWorksheet.Cells(42, Column).Value = LOG_PERF_NORM_WF.Value.ToString(LOG_PERF_NORM_WF.Format, Nothing)
            End If

        End Sub

        Private Function CreateEpcor12958PerformanceFile(ByVal AppendOption As Boolean, ByVal TestStepNb As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreateEpcor12958PerformanceFile = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            If CELProject.EngineModel = "APS5000A" Then
                Try
                    'Unlock Sheets
                    excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                    excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                    excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                    If AppendOption = False Then

                        excelWorksheet = excelSheets.Item("SUMMARY")

                        'Customer Name   (Cell AB5)
                        excelWorksheet.Cells(5, 28).NumberFormat = "@"
                        excelWorksheet.Cells(5, 28).Value = UserInputsEpcor.CustomerName

                        'Work Order    (Cell AB6)
                        excelWorksheet.Cells(6, 28).NumberFormat = "@"
                        excelWorksheet.Cells(6, 28).Value = UserInputsEpcor.WorkOrder

                        'Engine Part Number (Cell AB7)
                        excelWorksheet.Cells(7, 28).NumberFormat = "@"
                        excelWorksheet.Cells(7, 28).Value = UserInputsEpcor.PartNumber

                        'Serial Number.   (Cell AB8)
                        excelWorksheet.Cells(8, 28).NumberFormat = "@"
                        excelWorksheet.Cells(8, 28).Value = UserInputsEpcor.SerialNumber

                        'Repair Type        (Cell AB9)
                        excelWorksheet.Cells(9, 28).NumberFormat = "@"
                        excelWorksheet.Cells(9, 28).Value = UserInputsEpcor.ChoiceRepairType

                        'Test Type (Cell AB10)
                        excelWorksheet.Cells(10, 28).NumberFormat = "@"
                        excelWorksheet.Cells(10, 28).Value = UserInputsEpcor.ChoiceTestType

                        'Date     (Cell CE5)
                        excelWorksheet.Cells(5, 83).NumberFormat = "@"
                        excelWorksheet.Cells(5, 83).Value = Format(Now, "d MMMM yyyy")

                        'LHV    (Cell CE6)
                        excelWorksheet.Cells(6, 83).NumberFormat = "@"
                        excelWorksheet.Cells(6, 83).Value = UserInputsEpcor.LHV

                        'Sample Fuel sg (Cell CE7)
                        excelWorksheet.Cells(7, 83).NumberFormat = "@"
                        excelWorksheet.Cells(7, 83).Value = UserInputsEpcor.SampleSG

                        'Sample T Fuel (Cell CE8)
                        excelWorksheet.Cells(8, 83).NumberFormat = "@"
                        excelWorksheet.Cells(8, 83).Value = UserInputsEpcor.SampleTFuel

                        'Fuel Type   (Cell CE9)
                        excelWorksheet.Cells(9, 83).NumberFormat = "@"
                        excelWorksheet.Cells(9, 83).Value = UserInputsEpcor.FuelType

                        'Oil Type   (Cell CE10)
                        excelWorksheet.Cells(10, 83).NumberFormat = "@"
                        excelWorksheet.Cells(10, 83).Value = UserInputsEpcor.OilType

                        excelWorksheet = excelSheets.Item("ACCEPTANCE")

                        'Document Number (Cell AW43)
                        excelWorksheet.Cells(43, 49).NumberFormat = "@"
                        excelWorksheet.Cells(43, 49).Value = Custom_Parameters("APUTestedAccordingTo").ToString()

                    End If

                    Select Case TestStepNb
                        Case eTestStepAPS5000A.INITIAL_RUN_STEP_1

                            EpcorWriteEventInPerf(excelSheets.Item("DETAILS"), 31)

                        Case eTestStepAPS5000A.RUN_1_STEP_A

                            EpcorWritePointInPerfDetails(excelSheets.Item("DETAILS"), 43, False, False)

                        Case eTestStepAPS5000A.RUN_1_STEP_D

                            EpcorWritePointInPerfDetails(excelSheets.Item("DETAILS"), 55, True, False)

                        Case eTestStepAPS5000A.RUN_1_STEP_E

                            EpcorWritePointInPerfDetails(excelSheets.Item("DETAILS"), 67, True, False)

                            EpcorWritePointE1_F1InPerf(excelSheets, 115)

                        Case eTestStepAPS5000A.RUN_1_STEP_F

                            excelWorksheet = excelSheets.Item("SUMMARY")

                            excelWorksheet.Cells(20, 72).Value = LOG_PERF_VIB_GEARBOX.Value.ToString(LOG_PERF_VIB_GEARBOX.Format, Nothing)

                            EpcorWritePointInPerfDetails(excelSheets.Item("DETAILS"), 79, True, False)

                            EpcorWritePointE1_F1InPerf(excelSheets, 115)

                        Case eTestStepAPS5000A.RUN_1_STEP_G

                            EpcorWritePointInPerfDetails(excelSheets.Item("DETAILS"), 91, True, False)

                        Case eTestStepAPS5000A.RUN_1_STEP_I

                            EpcorWritePointInPerfDetails(excelSheets.Item("DETAILS"), 103, True, False)

                        Case eTestStepAPS5000A.RUN_2_STEP_A

                            excelWorksheet = excelSheets.Item("SUMMARY")

                            excelWorksheet.Cells(22, 98).Value = ET_50PCT.Value.ToString(ET_50PCT.Format, Nothing)
                            excelWorksheet.Cells(23, 98).Value = ET_RTL.Value.ToString(ET_RTL.Format, Nothing)

                            excelWorksheet = excelSheets.Item("DETAILS")

                            excelWorksheet.Cells(15, 127).Value = ET_50PCT.Value.ToString(ET_50PCT.Format, Nothing)
                            excelWorksheet.Cells(16, 127).Value = ET_RTL.Value.ToString(ET_RTL.Format, Nothing)

                        Case eTestStepAPS5000A.RUN_2_STEP_E

                            excelWorksheet = excelSheets.Item("SUMMARY")

                            excelWorksheet.Cells(20, 98).Value = VIB_GB_MAX.Value.ToString(VIB_GB_MAX.Format, Nothing)

                            excelWorksheet = excelSheets.Item("DETAILS")

                            excelWorksheet.Cells(17, 139).Value = VIB_GB_MAX.Value.ToString(VIB_GB_MAX.Format, Nothing)

                        Case eTestStepAPS5000A.RUN_2_STEP_F

                            excelWorksheet = excelSheets.Item("SUMMARY")

                            excelWorksheet.Cells(24, 98).Value = ET_RD.Value.ToString(ET_RD.Format, Nothing)

                            'Performed Test Details section
                            If CELProject.IsTrue(Log_Perf_Surge.Value) Then
                                excelWorksheet.Cells(29, 78).Value = "YES"
                            Else
                                excelWorksheet.Cells(29, 78).Value = "NO"
                            End If

                            If CELProject.IsTrue(Log_Perf_FlameOut.Value) Then
                                excelWorksheet.Cells(30, 78).Value = "YES"
                            Else
                                excelWorksheet.Cells(30, 78).Value = "NO"
                            End If

                            If CELProject.IsTrue(Log_Perf_Overspeed.Value) Then
                                excelWorksheet.Cells(31, 78).Value = "YES"
                            Else
                                excelWorksheet.Cells(31, 78).Value = "NO"
                            End If

                            If CELProject.IsTrue(Log_Perf_Underspeed.Value) Then
                                excelWorksheet.Cells(32, 78).Value = "YES"
                            Else
                                excelWorksheet.Cells(32, 78).Value = "NO"
                            End If

                            excelWorksheet = excelSheets.Item("DETAILS")

                            excelWorksheet.Cells(18, 151).Value = ET_RD.Value.ToString(ET_RD.Format, Nothing)

                        Case eTestStepAPS5000A.LEAK_CHECK

                            EpcorWritePointInPerfDetails(excelSheets.Item("DETAILS"), 163, False, True)

                        Case eTestStepAPS5000A.FINAL_RUN_TIME

                            excelWorksheet = excelSheets.Item("ACCEPTANCE")

                            'Test Result
                            If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value) Then
                                excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                            Else
                                excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                            End If

                            If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value) Then
                                excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                            Else
                                excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                            End If

                            excelWorksheet.Cells(49, 23).Value = UserInputsEpcor.ChoiceOperator
                            excelWorksheet.Cells(50, 23).Value = UserInputsEpcor.ChoiceInspector

                            excelWorksheet = excelSheets.Item("SUMMARY")

                            excelWorksheet.Cells(33, 78).Value = APU_FAULTS_DURING_TEST.Value.ToString(APU_FAULTS_DURING_TEST.Format, Nothing)
                            excelWorksheet.Cells(34, 78).Value = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format, Nothing)
                            excelWorksheet.Cells(35, 78).Value = NUMBER_OF_STARTS.Value.ToString(NUMBER_OF_STARTS.Format, Nothing)
                            excelWorksheet.Cells(36, 78).Value = LOG_PERF_FUEL_USED_TOTAL_LITERS.Value.ToString(LOG_PERF_FUEL_USED_TOTAL_LITERS.Format, Nothing)

                            EpcorWriteEventInPerf(excelSheets.Item("DETAILS"), 175)

                    End Select

                    TestProgress_RecordPerfStep(TestStepNb)


                Catch ex As Exception
                    System.Diagnostics.Trace.WriteLine("CreateEpcor12958PerformanceFile: " + ex.Message)
                    MessageBox.Show(ex.ToString)
                    CreateEpcor12958PerformanceFile = False
                Finally
                    'Lock Sheets
                    excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                    excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                    excelWorkbook.Worksheets(3).Protect(ProtectPassword)
                End Try
            End If
        End Function

        Private Function CreateStandardCELPerformanceFile(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean

            '**********************************************************************************************************************************
            '               Comme on utilise un autre rapport, Revima pour le premier projet, on
            '               va devoir faire le rapport de CEL dans un autre projet.
            '**********************************************************************************************************************************
            Return False
        End Function

