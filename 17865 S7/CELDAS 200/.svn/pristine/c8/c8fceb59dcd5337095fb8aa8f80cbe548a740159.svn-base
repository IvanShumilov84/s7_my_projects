Namespace StudioDemonstration

    Public Class APS5000A_Sequence
        Inherits ApuSequence

        Private Const MaxNumberOfTEgtProbe As Integer = 15
        Private Const MaxNumberOfTInletProbe As Integer = 8


        Private Enum eTestStepAPS5000A
            INITIAL_RUN_STEP_1 = 0
            RUN_1_STEP_A = 1
            RUN_1_STEP_D = 2
            RUN_1_STEP_E = 3
            RUN_1_STEP_F = 4
            RUN_1_STEP_G = 5
            RUN_1_STEP_I = 6
            RUN_2_STEP_A = 7
            RUN_2_STEP_E = 8
            RUN_2_STEP_F = 9
            LEAK_CHECK = 10
            FINAL_RUN_TIME = 11
        End Enum

        Protected Overrides Sub Compute(ByVal CalculateForLogAndPerformanceReports As Boolean)

            Try
                If CalculateForLogAndPerformanceReports Then

                    Compute_APS5000A_Perf(LOG_PERF_DELTA, LOG_PERF_THETA_70, LOG_PERF_RTH_70, LOG_PERF_T_ETC_AVG_DEGF, LOG_PERF_LB_POWER_TOT_KVA, _
                                            LOG_PERF_P_DISCH_PSIG, LOG_PERF_T_DISCH_DEGF, LOG_PERF_T_EGT_AVG_DEGF, LOG_PERF_WF_PPH, LOG_PERF_P_BARO_PSIA, _
                                            LOG_PERF_T_INLET_AVG_DEGF, LOG_PERF_P_ESP_PSIG, LOG_PERF_T_EGT_400_DEGF, LOG_PERF_KW_400_KVA, LOG_PERF_P3_400_PSIA, _
                                            LOG_PERF_T3_400_DEGF, LOG_PERF_T6_400_DEGF, LOG_PERF_WF_400_PPH, LOG_PERF_T_INLET_400_DEGR, LOG_PERF_P_EXDUCT_400_PSIG, _
                                            LOG_PERF_T_EGT_450_DEGF, LOG_PERF_KW_450_KVA, LOG_PERF_P3_450_PSIA, LOG_PERF_T3_450_DEGF, LOG_PERF_T6_450_DEGF, _
                                            LOG_PERF_WF_450_PPH, LOG_PERF_T_INLET_450_DEGR, LOG_PERF_P_EXDUCT_450_PSIG)

                    FlowmeterCtrl.ComputeFlow(True)

                    'IMPORTANT: Toutes les variables flottantes telles que WB_CALC, DELPB, LB_DEMAND dont la source et la destination sont vides doivent
                    'manuellement être updaté pour être inscrite dans le LOG ou le PERF report.
                Else

                    Compute_APS5000A_Perf(DELTA, THETA_70, RTH_70, T_ETC_AVG_DEGF, LB_POWER_TOT_KVA, _
                                            P_DISCH_PSIG, T_DISCH_DEGF, T_EGT_AVG_DEGF, WF_PPH, P_BARO_PSIA, _
                                            T_INLET_AVG_DEGF, P_ESP_PSIG, T_EGT_400_DEGF, KW_400_KVA, P3_400_PSIA, _
                                            T3_400_DEGF, T6_400_DEGF, WF_400_PPH, T_INLET_400_DEGR, P_EXDUCT_400_PSIG, _
                                            T_EGT_450_DEGF, KW_450_KVA, P3_450_PSIA, T3_450_DEGF, T6_450_DEGF, _
                                            WF_450_PPH, T_INLET_450_DEGR, P_EXDUCT_450_PSIG)
                End If

            Catch ex As Exception
                MessageBox.Show("Compute_APS5000A" + ex.ToString(), "Error")
            End Try
        End Sub

        Private Sub Compute_APS5000A_Perf(ByRef delta As IChannel,
                                          ByRef theta_70 As IChannel,
                                          ByRef rth_70 As IChannel,
                                          ByRef t_etc_avg As IChannel,
                                          ByRef generator_power_total_kw As IChannel,
                                          ByRef p_disch As IChannel,
                                          ByRef t_disch As IChannel,
                                          ByRef t_egt_avg As IChannel,
                                          ByRef wf As IChannel,
                                          ByRef baro As IChannel,
                                          ByRef t_inlet_avg As IChannel,
                                          ByRef p_exhaust As IChannel,
                                          ByRef egt_400 As IChannel,
                                          ByRef kw_400 As IChannel,
                                          ByRef p3_400 As IChannel,
                                          ByRef t3_400 As IChannel,
                                          ByRef t6_400 As IChannel,
                                          ByRef wf_400 As IChannel,
                                          ByRef t_inlet_400 As IChannel,
                                          ByRef p_exduct_400 As IChannel,
                                          ByRef egt_450 As IChannel,
                                          ByRef kw_450 As IChannel,
                                          ByRef p3_450 As IChannel,
                                          ByRef t3_450 As IChannel,
                                          ByRef t6_450 As IChannel,
                                          ByRef wf_450 As IChannel,
                                          ByRef t_inlet_450 As IChannel,
                                          ByRef p_exduct_450 As IChannel)
            Try

                Dim del As Double
                Dim theta As Double
                Dim rth As Double
                Dim EGT As Double
                Dim KW As Double
                Dim P3 As Double
                Dim T3 As Double
                Dim T6 As Double
                Dim WFuel As Double

                Dim TestStep As Integer = CELProject.PERF_TEST_STEP_NB.Value.ToDouble()

                'Set the value if in Test steps E651 or F651
                Select Case TestStep

                    Case eTestStepAPS5000A.RUN_1_STEP_E
                        del = delta.Value.ToDouble()
                        theta = theta_70.Value.ToDouble()
                        rth = rth_70.Value.ToDouble()
                        EGT = t_etc_avg.Value.ToDouble()
                        KW = generator_power_total_kw.Value.ToDouble()
                        P3 = p_disch.Value.ToDouble() + baro.Value.ToDouble()
                        T3 = t_disch.Value.ToDouble()
                        T6 = t_egt_avg.Value.ToDouble()
                        WFuel = wf.Value.ToDouble()

                        egt_400.Value = New KineticaRT.Values.Double((EGT + 459.67) / theta - 459.67)
                        kw_400.Value = New KineticaRT.Values.Double(KW / (del * rth))
                        p3_400.Value = New KineticaRT.Values.Double(P3 / del)
                        t3_400.Value = New KineticaRT.Values.Double((T3 + 459.67) / theta - 459.67)
                        t6_400.Value = New KineticaRT.Values.Double((T6 + 459.67) / theta - 459.67)
                        wf_400.Value = New KineticaRT.Values.Double(WFuel / (del * rth))

                        t_inlet_400.Value = New KineticaRT.Values.Double(t_inlet_avg.Value.ToDouble() + 459.67)
                        p_exduct_400.Value = New KineticaRT.Values.Double(p_exhaust.Value.ToDouble())

                    Case eTestStepAPS5000A.RUN_1_STEP_F
                        del = delta.Value.ToDouble()
                        theta = theta_70.Value.ToDouble()
                        rth = rth_70.Value.ToDouble()
                        EGT = t_etc_avg.Value.ToDouble()
                        KW = generator_power_total_kw.Value.ToDouble()
                        P3 = p_disch.Value.ToDouble() + baro.Value.ToDouble()
                        T3 = t_disch.Value.ToDouble()
                        T6 = t_egt_avg.Value.ToDouble()
                        WFuel = wf.Value.ToDouble()

                        egt_450.Value = New KineticaRT.Values.Double((EGT + 459.67) / theta - 459.67)
                        kw_450.Value = New KineticaRT.Values.Double(KW / (del * rth))
                        p3_450.Value = New KineticaRT.Values.Double(P3 / del)
                        t3_450.Value = New KineticaRT.Values.Double((T3 + 459.67) / theta - 459.67)
                        t6_450.Value = New KineticaRT.Values.Double((T6 + 459.67) / theta - 459.67)
                        wf_450.Value = New KineticaRT.Values.Double(WFuel / (del * rth))

                        t_inlet_450.Value = New KineticaRT.Values.Double(t_inlet_avg.Value.ToDouble() + 459.67)
                        p_exduct_450.Value = New KineticaRT.Values.Double(p_exhaust.Value.ToDouble())

                End Select


            Catch Ex As Exception
                MessageBox.Show("Compute_APS5000A_Perf: " & Ex.ToString())
            End Try

        End Sub

        Private Sub ValidateFMInitialValue()

            Try


                Select Case CELProject.Project.Number

                    Case 12917
                        'Read the mass flow meter value, the value cannot be 0
                        If FM_INITIAL_VOLUME_LITERS.Value.ToDouble() = 0.0 Then
                            FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())
                        End If

                    Case 11813
                        FM_INITIAL_VOLUME_LITERS.Value = Values.Zero

                    Case 12958
                        FM_INITIAL_VOLUME_LITERS.Value = Values.Zero

                    Case Else
                        Debug.Assert(False, "ValidateFMInitialValue: Code Missign for this project")

                End Select


            Catch Ex As Exception
                MessageBox.Show("ValidateFMInitialValue: " & Ex.ToString())
            End Try

        End Sub

        Private Sub RevimaWriteEventInPerf(ByVal excelWorksheet As Excel.Worksheet, ByVal Column As Integer)

            excelWorksheet.Cells(58, Column).Value = HR_MTR_1.Value.ToString(HR_MTR_1.Format, Nothing)
            excelWorksheet.Cells(59, Column).Value = EVENT_1.Value.ToString(EVENT_1.Format, Nothing)
            excelWorksheet.Cells(60, Column).Value = HR_MTR_2.Value.ToString(HR_MTR_2.Format, Nothing)
            excelWorksheet.Cells(61, Column).Value = EVENT_2.Value.ToString(EVENT_2.Format, Nothing)

        End Sub

