        Protected Overrides Function CreateCustomHeaderLogFile(ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Try
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Date Time:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Cond#:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Comment:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                ExcelWorksheet.Rows(RowIndex).RowHeight = 65.25
                ExcelWorksheet.Rows(RowIndex).VerticalAlignment = Excel.XlVAlign.xlVAlignTop
                ExcelWorksheet.Rows(RowIndex).WrapText = True

                Return True

            Catch ex As Exception
                MessageBox.Show("CreateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        Protected Overrides Function UpdateCustomHeaderLogFile(ByVal AppendOption As Boolean, ByVal IsPerfEntry As Boolean, ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Try
                Dim Log_Condition As Integer

                If AppendOption = False Then
                    Log_Condition = 1
                Else
                    Log_Condition = ExcelWorksheet.Cells(RowIndex + 1, ExcelWorksheet.Columns.Count).End(Excel.XlDirection.xlToLeft).Column - 1
                    Log_Condition = Log_Condition + 1

                End If

                If ((Log_Condition > 1) And ((Log_Condition Mod 5) = 1)) Then

                    'Repeat The Test Spec For this new sets of condition

                    With ExcelWorksheet
                        .Range(.Cells(2, 2), .Cells(RowIndex - 2, 6)).Copy(.Cells(2, Log_Condition + 1))
                    End With
                End If

                ColumnIndex = 1 + Log_Condition

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Format(Now, "yyyy/MM/dd HH:mm:ss")
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Log_Condition.ToString()
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                If IsPerfEntry = False Then
                    Dim CommentText As String = ""
                    Dim InputObject As New InputCommentForm
                    InputObject.ShowDialog("Log Report", "Comment:", "", CommentText)

                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = CommentText
                Else
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "STEP: " & TestStep_List.SelectedItem
                End If

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 2
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Values"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignCenter

            Catch ex As Exception
                MessageBox.Show("UpdateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        Sub Permissive_Evaluation()

            If (Date.Compare(Now, Time_Starter_RectifierOFF) >= 0) And CELProject.IsFalse(STARTER_RECTIFIER_BTN_APS5000A.Value) Then
                STARTER_OFF_TIME_PERM_OK.Value = Values.True
            End If

            If (Date.Compare(Now, Time_PowerON) >= 0) And CELProject.IsTrue(POWER_BTN.Value) Then
                CMSC_POWER_TIME_PERM_OK.Value = Values.True
                GCU_R_ON_TIME_PERM_OK.Value = Values.True
            End If

            If (Date.Compare(Now, Time_CMSC_ON) >= 0) And CELProject.IsTrue(CMSC_POWER_BTN.Value) Then
                STARTER_ON_TIME_PERM_OK.Value = Values.True
            End If

            If (Date.Compare(Now, Time_RunStopON) >= 0) And CELProject.IsTrue(RUN_STOP_BTN.Value) Then
                START_TIME_PERM_OK.Value = Values.True
            End If
        End Sub

        Private Sub ProcessCANBusInfo()
            Dim ASCIIchar As New ASCIIEncoding
            Dim i As Integer
            Dim SNbytes(7) As Byte
            Dim TimeToCANBus As Date
            Dim InfoOK As Boolean = True

            'Set the Time for CANBus Transmission
            TimeToCANBus = Now

            Try
                'Date
                If TimeToCANBus.Day < 10 Then
                    DAY_TENS_TO_CANBUS.Value = Values.Zero
                    DAY_UNITS_TO_CANBUS.Value = New KineticaRT.Values.Integer(TimeToCANBus.Day)
                Else
                    DAY_TENS_TO_CANBUS.Value = New KineticaRT.Values.Integer(TimeToCANBus.Day.ToString.Substring(0, 1))
                    DAY_UNITS_TO_CANBUS.Value = New KineticaRT.Values.Integer(TimeToCANBus.Day.ToString.Substring(1, 1))
                End If

                If TimeToCANBus.Month < 10 Then
                    MONTH_TENS_TO_CANBUS.Value = Values.Zero
                    MONTH_UNITS_TO_CANBUS.Value = New KineticaRT.Values.Integer(TimeToCANBus.Month)
                Else
                    MONTH_TENS_TO_CANBUS.Value = New KineticaRT.Values.Integer(TimeToCANBus.Month.ToString.Substring(0, 1))
                    MONTH_UNITS_TO_CANBUS.Value = New KineticaRT.Values.Integer(TimeToCANBus.Month.ToString.Substring(1, 1))
                End If

            Catch ex As Exception
                MessageBox.Show("APS5000A_Sequence: ProcessCANBusInfo: Problem to write current date in Day and Month, Day = " & TimeToCANBus.Day.ToString() & " Month = " & TimeToCANBus.Month.ToString() & "  " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try

            Try
                YEAR_TENS_TO_CANBUS.Value = New KineticaRT.Values.Integer(TimeToCANBus.Year.ToString.Substring(2, 1))
                YEAR_UNITS_TO_CANBUS.Value = New KineticaRT.Values.Integer(TimeToCANBus.Year.ToString.Substring(3, 1))

            Catch ex As Exception
                MessageBox.Show("APS5000A_Sequence: ProcessCANBusInfo: Problem to write current date in year, Year = " & TimeToCANBus.Year.ToString() & "  " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try

            Try
                'Hour
                If TimeToCANBus.Hour < 10 Then
                    HOUR_TENS_TO_CANBUS.Value = Values.Zero
                    HOUR_UNITS_TO_CANBUS.Value = New KineticaRT.Values.Integer(TimeToCANBus.Hour)
                Else
                    HOUR_TENS_TO_CANBUS.Value = New KineticaRT.Values.Integer(TimeToCANBus.Hour.ToString.Substring(0, 1))
                    HOUR_UNITS_TO_CANBUS.Value = New KineticaRT.Values.Integer(TimeToCANBus.Hour.ToString.Substring(1, 1))
                End If

            Catch ex As Exception
                MessageBox.Show("APS5000A_Sequence: ProcessCANBusInfo: Problem to write current time in hour = " & TimeToCANBus.Hour.ToString() & "  " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try

            Try
                If TimeToCANBus.Minute < 10 Then
                    MINUTE_TENS_TO_CANBUS.Value = Values.Zero
                    MINUTE_UNITS_TO_CANBUS.Value = New KineticaRT.Values.Integer(TimeToCANBus.Minute)
                Else
                    MINUTE_TENS_TO_CANBUS.Value = New KineticaRT.Values.Integer(TimeToCANBus.Minute.ToString.Substring(0, 1))
                    MINUTE_UNITS_TO_CANBUS.Value = New KineticaRT.Values.Integer(TimeToCANBus.Minute.ToString.Substring(1, 1))
                End If

            Catch ex As Exception
                MessageBox.Show("APS5000A_Sequence: ProcessCANBusInfo: Problem to write current time in minute = " & TimeToCANBus.Minute.ToString() & "  " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try

            Try
                If TimeToCANBus.Second < 10 Then
                    SECOND_TENS_TO_CANBUS.Value = Values.Zero
                    SECOND_UNITS_TO_CANBUS.Value = New KineticaRT.Values.Integer(TimeToCANBus.Second)
                Else
                    SECOND_TENS_TO_CANBUS.Value = New KineticaRT.Values.Integer(TimeToCANBus.Second.ToString.Substring(0, 1))
                    SECOND_UNITS_TO_CANBUS.Value = New KineticaRT.Values.Integer(TimeToCANBus.Second.ToString.Substring(1, 1))
                End If

            Catch ex As Exception
                MessageBox.Show("APS5000A_Sequence: ProcessCANBusInfo: Problem to write current time in second = " & TimeToCANBus.Second.ToString() & "  " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try

            InfoOK = True

            Try
                For i = 0 To 7
                    If Double.IsNaN(CANBUS_APU_ACMF_DATA(i).Value.ToDouble) Then
                        InfoOK = False
                    End If
                Next

            Catch ex As Exception
                MessageBox.Show("APS5000A_Sequence: ProcessCANBusInfo: Problem in validation data CANBUS_APU_ACMF_DATA(i) i = " & i.ToString() & " CANBUS_APU_ACMF_DATA(i) " & CANBUS_APU_ACMF_DATA(i).Value.ToString() & "   " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try

            Try
                For i = 0 To 9
                    If Double.IsNaN(CANBUS_FMU_FUEL_MODULE_PN(i).Value.ToDouble) Then
                        InfoOK = False
                    End If
                Next

            Catch ex As Exception
                MessageBox.Show("APS5000A_Sequence: ProcessCANBusInfo: Problem in validation data CANBUS_FMU_FUEL_MODULE_PN(i) i = " & i.ToString() & " CANBUS_FMU_FUEL_MODULE_PN(i) " & CANBUS_FMU_FUEL_MODULE_PN(i).Value.ToString() & "   " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try

            Try
                For i = 0 To 3
                    If Double.IsNaN(CANBUS_FMU_FUEL_MODULE_SN(i).Value.ToDouble) Then
                        InfoOK = False
                    End If
                Next

            Catch ex As Exception
                MessageBox.Show("APS5000A_Sequence: ProcessCANBusInfo: Problem in validation data CANBUS_FMU_FUEL_MODULE_SN(i) i = " & i.ToString() & " CANBUS_FMU_FUEL_MODULE_SN(i) " & CANBUS_FMU_FUEL_MODULE_SN(i).Value.ToString() & "   " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try


            Try
                For i = 0 To 6
                    If Double.IsNaN(CANBUS_FMU_FUEL_MODULE_SW(i).Value.ToDouble) Then
                        InfoOK = False
                    End If
                Next

            Catch ex As Exception
                MessageBox.Show("APS5000A_Sequence: ProcessCANBusInfo: Problem in validation data CANBUS_FMU_FUEL_MODULE_SW(i) i = " & i.ToString() & " CANBUS_FMU_FUEL_MODULE_SW(i) " & CANBUS_FMU_FUEL_MODULE_SW(i).Value.ToString() & "   " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try


            If InfoOK Then

                Try
                    'Process the APU S/N
                    'If ID (Byte 0) is 0x00000100, take Bytes 1 to 7 in the first part of the S/N
                    If CANBUS_APU_ACMF_DATA(0).Value.ToDouble = 4 Then
                        For i = 1 To 7
                            SNbytes(i - 1) = CANBUS_APU_ACMF_DATA(i).Value.ToDouble
                        Next
                        APU_SNChar1 = ASCIIchar.GetChars(SNbytes, 0, 7)

                        'If ID (Byte 0) is 0x00001000, take Bytes 1 to 5 in the last part of the S/N
                    ElseIf CANBUS_APU_ACMF_DATA(0).Value.ToDouble = 8 Then
                        For i = 1 To 5
                            SNbytes(i - 1) = CANBUS_APU_ACMF_DATA(i).Value.ToDouble
                        Next
                        APU_SNChar2 = ASCIIchar.GetChars(SNbytes, 0, 5)
                    End If

                    APU_SERIAL_NUMBER.Value = New KineticaRT.Values.Text(APU_SNChar1 + APU_SNChar2)

                Catch ex As Exception
                    MessageBox.Show("APS5000A_Sequence: ProcessCANBusInfo: Problem in processing data CANBUS_APU_ACMF_DATA(i) i = " & i.ToString() & " CANBUS_APU_ACMF_DATA(i) " & CANBUS_APU_ACMF_DATA(i).Value.ToString() & "   " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Return
                End Try

                Try
                    'Process the FMU P/N
                    ReDim SNbytes(9)
                    For i = 0 To SNbytes.GetUpperBound(0)
                        SNbytes(i) = CANBUS_FMU_FUEL_MODULE_PN(i).Value.ToDouble
                    Next

                    FMU_PART_NUMBER.Value = New KineticaRT.Values.Text(ASCIIchar.GetChars(SNbytes))

                Catch ex As Exception
                    MessageBox.Show("APS5000A_Sequence: ProcessCANBusInfo: Problem in processing data part number CANBUS_FMU_FUEL_MODULE_PN(i) i = " & i.ToString() & " CANBUS_FMU_FUEL_MODULE_PN(i) " & CANBUS_FMU_FUEL_MODULE_PN(i).Value.ToString() & "   " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Return
                End Try

                Try
                    'Process the FMU P/N
                    ReDim SNbytes(3)
                    For i = 0 To SNbytes.GetUpperBound(0)
                        SNbytes(i) = CANBUS_FMU_FUEL_MODULE_SN(i).Value.ToDouble
                    Next

                    FMU_SERIAL_NUMBER.Value = New KineticaRT.Values.Text(ASCIIchar.GetChars(SNbytes))

                Catch ex As Exception
                    MessageBox.Show("APS5000A_Sequence: ProcessCANBusInfo: Problem in processing data serial number CANBUS_FMU_FUEL_MODULE_PN(i) i = " & i.ToString() & " CANBUS_FMU_FUEL_MODULE_PN(i) " & CANBUS_FMU_FUEL_MODULE_PN(i).Value.ToString() & "   " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Return
                End Try

                Try
                    'Process the FMU S/W Version
                    ReDim SNbytes(6)
                    For i = 0 To SNbytes.GetUpperBound(0)
                        SNbytes(i) = CANBUS_FMU_FUEL_MODULE_SW(i).Value.ToDouble
                    Next

                    FMU_SOFTWARE_VERSION.Value = New KineticaRT.Values.Text(ASCIIchar.GetChars(SNbytes))

                Catch ex As Exception
                    MessageBox.Show("APS5000A_Sequence: ProcessCANBusInfo: Problem in processing data software number CANBUS_FMU_FUEL_MODULE_SW(i) i = " & i.ToString() & " CANBUS_FMU_FUEL_MODULE_SW(i) " & CANBUS_FMU_FUEL_MODULE_SW(i).Value.ToString() & "   " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Return
                End Try
            End If

        End Sub

        Protected Overrides Sub OnEngineWorkingThread()

            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                'Make sure FM_INITIAL_VOLUME_LITERS is different than 0
                ValidateFMInitialValue()

                Permissive_Evaluation()

                ProcessCANBusInfo()

                'Persistent Values Save Check
                PersistentValuesCtrl.SavePersistentValues()

            End If

        End Sub

        Private Sub OnAcceleratingTime_Calc(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                    If CELProject.IsTrue(newVal) Then
                        NUMBER_OF_STARTS.Value = New KineticaRT.Values.Double(NUMBER_OF_STARTS.Value.ToDouble + 1)
                    End If

                End If

            Catch ex As Exception
                MessageBox.Show("OnAcceleratingTime_Calc: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub SetMessageInvisible()
            Try
                CMSC_Msg_Text.Visible = False
            Catch ex As Exception
                MessageBox.Show("SetMessageInvisible: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub SetMessageVisible()
            Try
                CMSC_Msg_Text.Visible = True
            Catch ex As Exception
                MessageBox.Show("SetMessageVisible: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub


        Private Sub OnCanbusSysConfigError(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                If CELProject.IsTrue(newVal) Then
                    CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.SetMessageVisible))
                End If

                If CELProject.IsFalse(newVal) Then
                    CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.SetMessageInvisible))
                End If

            End If


        End Sub

        Protected Overrides Sub OnCLOSE_TEST_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                    If CELProject.IsTrue(newVal) Then

                        MyBase.StopWorkingThread()

                        'Persistent Values Force Save
                        PersistentValuesCtrl.SavePersistentValues(True)

                        RemoveHandlers()

                        Dispose_Engine_Controllers()

                    End If

                    CELProject.CLOSE_TEST_BTN.Value = Values.False
                End If


            Catch ex As Exception
                MessageBox.Show("OnClose_Test: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub
        Private Sub OnEmerStop(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                If CELProject.IsFalse(EMER_STOP_CMD.Value) Then
                    FUEL_PWR_INHIBIT_BTN.Value = Values.True
                End If

            End If

        End Sub

        Protected Overrides Sub OnLOG_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                    If CELProject.IsTrue(newVal) Then

                        'Update the Log/Perf channel set
                        CELProject.LogPerfSynch.UpdateValues()

                        'Synchronize data for Log and Performance
                        'Compute_APS5000A(True)  This line has to be comment. If we don't, the point will be taken like a process perf point

                        CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, False, CELProject.EngineModel, True)
                        CELProject.LOG_TAKE_POINT_BTN.Value = Values.False
                    End If

                End If

            Catch Ex As Exception
                MessageBox.Show("OnLOG_TAKE_POINT_BTN: " & Ex.ToString())
            End Try
        End Sub

        Protected Overrides Sub OnNEW_TEST_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                If (CELProject.IsTrue(newVal)) Then

                    NUMBER_OF_STARTS.Value = Values.Zero
                    OPERATING_TIME_CURRENT_SEC.Value = Values.Zero
                    FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                    WF_TOT1.Value = Values.Zero
                    WF_TOT2.Value = Values.Zero
                    VIB_GB_MAX.Value = Values.Zero
                    EVENT_1.Value = Values.Zero
                    EVENT_2.Value = Values.Zero
                    HR_MTR_1.Value = Values.Zero
                    HR_MTR_2.Value = Values.Zero
                    Log_Perf_Surge.Value = Values.False
                    Log_Perf_FlameOut.Value = Values.False
                    Log_Perf_Overspeed.Value = Values.False
                    Log_Perf_Underspeed.Value = Values.False

                    TestProgress_Save()

                    Try
                        If (System.IO.File.Exists(CELProject.EngineSession.LogFolder + "TestProgress.xml")) Then

                            Rename(CELProject.EngineSession.LogFolder + "TestProgress.xml", CELProject.EngineSession.LogFolder + "TestProgress_" & Format(Date.Now, "yyyy-MM-dd hh'h'mm'm'ss's'") & ".xml")
                        End If

                        TestProgressMgr.TestProgressSheet.Entries.Clear()

                    Catch Ex As Exception
                        MessageBox.Show("TestProgess File not found: " & Ex.ToString())
                    End Try

                End If

            End If

        End Sub

        Protected Overrides Sub OnPERF_CLOSE_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                    If CELProject.IsTrue(newVal) Then
                        CELProject.ActivateForm("APS5000A_Performance_Screen", CELProject.EngineModel.Replace("-", "_") + "_Screen", False, False)
                        CELProject.PERF_CLOSE_WINDOW_BTN.Value = Values.False
                    End If

                End If

            Catch Ex As Exception
                MessageBox.Show("OnPERF_CLOSE_WINDOW_BTN: " & Ex.ToString())
            End Try
        End Sub


        Protected Overrides Sub OnPERF_OPEN_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                    If CELProject.IsTrue(newVal) Then

                        CELProject.ActivateForm("APS5000A_Performance_Screen", CELProject.EngineModel.Replace("-", "_") + "_Screen", True, False)
                        CELProject.PERF_OPEN_WINDOW_BTN.Value = Values.False
                    End If

                End If

            Catch Ex As Exception
                MessageBox.Show("OnPERF_OPEN_WINDOW_BTN: " & Ex.ToString())
            End Try
        End Sub


        Protected Overrides Sub OnPERF_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            Dim SearchPath As String
            Dim excelWorkbook As Excel.Workbook = Nothing

            Try
                If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                    If CELProject.IsTrue(newVal) Then

                        'Update the Log/Perf channel set
                        CELProject.LogPerfSynch.UpdateValues()

                        'Synchronize data for Log and Performance
                        Compute(False)  'it is normal to call twice here. Everything in only calculated on process of the perf point
                        Compute(True)

                        SearchPath = CELProject.EngineSession.PerfFolder

                        Dim NewFileCreated As Boolean

                        Select Case CELProject.Project.Number

                            Case 12917
                                Dim Revima12917TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                                NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, Revima12917TemplateReportFullFileName, AddressOf CreateRevima12917PerformanceFile)

                            Case 11813
                                Dim Chine11813TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                                NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, Chine11813TemplateReportFullFileName, AddressOf CreateChine11813PerformanceFile)

                            Case 12958
                                Dim Epcor12958TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                                NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, Epcor12958TemplateReportFullFileName, AddressOf CreateEpcor12958PerformanceFile)

                            Case Else
                                Debug.Assert(False, "OnPerf_TAKE_POINT_BTN, Code Missign for this project")
                                Dim StandardCELTemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                                NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, StandardCELTemplateReportFullFileName, AddressOf CreateStandardCELPerformanceFile)

                        End Select

                        CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, True, CELProject.EngineModel, NewFileCreated)

                        CELProject.PERF_TAKE_POINT_BTN.Value = Values.False
                    End If

                End If

            Catch ex As Exception
                MessageBox.Show("OnPERF_TAKE_POINT_BTN: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally

            End Try
        End Sub


