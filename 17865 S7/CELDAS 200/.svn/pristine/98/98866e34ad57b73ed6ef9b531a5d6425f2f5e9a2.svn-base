                        excelWorksheet.Cells(30, 9).Value = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format, Nothing)
                        excelWorksheet.Cells(31, 9).Value = NUMBER_OF_STARTS.Value.ToString(NUMBER_OF_STARTS.Format, Nothing)
                        excelWorksheet.Cells(32, 9).Value = LOG_PERF_FUEL_USED_TOTAL_LITERS.Value.ToString(LOG_PERF_FUEL_USED_TOTAL_LITERS.Format, Nothing)
                        excelWorksheet.Cells(33, 9).Value = HOUR_METER_INIT_OPERATING_TIME.Value.ToString(HOUR_METER_INIT_OPERATING_TIME.Format, Nothing)
                        excelWorksheet.Cells(34, 9).Value = HOUR_METER_FINAL_OPERATING_TIME.Value.ToString(HOUR_METER_FINAL_OPERATING_TIME.Format, Nothing)
                        excelWorksheet.Cells(35, 9).Value = COUNTER_INIT_START_CYCLES.Value.ToString(COUNTER_INIT_START_CYCLES.Format, Nothing)
                        excelWorksheet.Cells(36, 9).Value = COUNTER_FINAL_START_CYCLES.Value.ToString(COUNTER_FINAL_START_CYCLES.Format, Nothing)

                        excelWorksheet = excelSheets.Item("ACCEPTANCE")

                        'Test Result
                        If CELProject.IsTrue(PERF_TEST_RESULT_ACCEPTED.Value) Then
                            excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                        Else
                            excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                        End If

                        If CELProject.IsTrue(PERF_TEST_RESULT_REJECTED.Value) Then
                            excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                        Else
                            excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                        End If

                End Select
                TestProgress_RecordPerfStepC11(TestStepNumber)
            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreateStandardCELPerformanceFileC11: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreateStandardCELPerformanceFileC11 = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)

            End Try

        End Function

        Protected Overrides Sub Init_Engine_Channels_Value()

            If Not (CELProject.PERF_TEST_STEP_NB Is Nothing) Then
                CELProject.PERF_TEST_STEP_NB.Value = Values.Zero
            End If

        End Sub

        Protected Overrides Sub Init_Engine_Controls()

            SetTestStepList(0)

        End Sub

        'Use Delegate for Cross Thread Operation
        Private Delegate Sub SetTestStepListDelegate(ByVal value As Integer)
        Protected Overrides Sub SetTestStepList(ByVal value As Integer)

            If (Me.cmbTestStepList.InvokeRequired) Then
                Me.cmbTestStepList.BeginInvoke(New SetTestStepListDelegate(AddressOf Me.SetTestStepList), value)
            Else
                cmbTestStepList.Items.Clear()
                If CELProject.EngineModel = "APS500-C7B" Then
                    cmbTestStepList.Items.Add("NO LOAD")
                    cmbTestStepList.Items.Add("BLEED FLOW ONLY")
                    cmbTestStepList.Items.Add("SHP ONLY")
                    cmbTestStepList.Items.Add("CONCURRENT SHP AND BLEED FLOW")
                ElseIf CELProject.EngineModel = "APS500-C7D" Then
                    cmbTestStepList.Items.Add("NO LOAD")
                    cmbTestStepList.Items.Add("TEST STEP NUMBER 1")
                    cmbTestStepList.Items.Add("TEST STEP NUMBER 2")
                    cmbTestStepList.Items.Add("TEST STEP NUMBER 3")
                ElseIf CELProject.EngineModel = "APS500-C11" Then
                    cmbTestStepList.Items.Add("NO LOAD")
                    cmbTestStepList.Items.Add("BLEED FLOW ONLY")
                    cmbTestStepList.Items.Add("SHP ONLY")
                    cmbTestStepList.Items.Add("BLEED FLOW WITH LOAD")
                    cmbTestStepList.Items.Add("LEAN BLOW OUT CHECK")
                End If
                cmbTestStepList.Items.Add("FINAL DATA")
                cmbTestStepList.SelectedIndex = value
            End If
        End Sub

        Protected Overrides Sub OnEngineWorkingThread()

            'WB_CALC_PPM Update
            Compute(False)

            'Make sure FM_INITIAL_VOLUME_LITERS is different than 0
            ValidateFMInitialValue()

            'Timers Update
            RundownTimerCtrl.Timer()
            StartTimerCtrl.Timer()

            If CELProject.EngineModel = "APS500-C7D" Then
                TegtOver1010FTimerCtrl.Timer()
            End If

            'Persistent Values Save Check
            PersistentValuesCtrl.SavePersistentValues(False)

        End Sub

        Private Function Compute_BleedAirFlow(ByVal TOrifice_DEGF As Double, _
                                              ByVal POrifice_PSIA As Double, _
                                              ByVal POrificeDelta_PSID As Double) As Double Implements IBleedAirFlowCalculation.Compute_BleedAirFlow
            Try

                If CELProject.IsTrue(BLEED_BTN.Value) Then

                    Dim BleedAirFLow As Double = CELProject.GetBleedAirFlow( _
                                                                            EngineConfiguration.DuctDiameter, _
                                                                            EngineConfiguration.DuctDiameterUnit, _
                                                                            EngineConfiguration.OrificeDiameter, _
                                                                            EngineConfiguration.OrificeDiameterUnit, _
                                                                            TOrifice_DEGF, _
                                                                            CELDAS.eTemperature.Fahrenheit, _
                                                                            POrifice_PSIA, _
                                                                            CELDAS.ePressure.PSI, _
                                                                            POrificeDelta_PSID, _
                                                                            CELDAS.ePressure.PSI, _
                                                                            EngineConfiguration.OrificeThinkness, _
                                                                            EngineConfiguration.OrificeThinknessUnit, _
                                                                            EngineConfiguration.TapArrangement, _
                                                                            CELDAS.eFlowMass.LbByMin)

                    Return BleedAirFLow

                Else
                    Return 0.0
                End If

            Catch Ex As Exception
                'Log error
                MessageBox.Show("Error in Engine_Sequence.Compute_BleedAirFlow: " & Ex.ToString)
            End Try

        End Function

        Protected Overrides Sub OnPERF_CLOSE_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            If CELProject.IsTrue(newVal) Then

                CELProject.ActivateForm("APS500_Performance_Screen", "APS500_Screen", False, False)
                CELProject.PERF_CLOSE_WINDOW_BTN.Value = Values.False

            End If
        End Sub

        Protected Overrides Sub OnPERF_OPEN_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            If CELProject.IsTrue(newVal) Then

                CELProject.ActivateForm("APS500_Performance_Screen", "APS500_Screen", True, False)
                CELProject.PERF_OPEN_WINDOW_BTN.Value = Values.False

            End If
        End Sub

        Protected Overrides Sub OnLOG_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    'Update the Log/Perf channel set
                    CELProject.LogPerfSynch.UpdateValues()

                    'Synchronize data for Log and Performance
                    Compute(True)

                    CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, False, CELProject.EngineModel, True)
                    CELProject.LOG_TAKE_POINT_BTN.Value = Values.False
                End If

            Catch Ex As Exception
                MessageBox.Show("OnLOG_TAKE_POINT_BTN: " & Ex.ToString())
            End Try
        End Sub

        Protected Overrides Sub OnPERF_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            Dim NewFileCreated As Boolean
            Dim SearchPath As String
            Dim excelWorkbook As Excel.Workbook = Nothing

            Try
                If CELProject.IsTrue(newVal) Then

                    'Update the Log/Perf channel set
                    CELProject.LogPerfSynch.UpdateValues()

                    'Synchronize data for Log and Performance
                    Compute(True)

                    SearchPath = CELProject.EngineSession.PerfFolder
                    Dim StandardCELTemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile

                    'Do Not Delete this line
                    'CELProject.ProcessPerformanceReport(SearchPath, StandardCELTemplateReportFullFileName, AddressOf CreateStandardCELPerformanceFile)

                    If CELProject.EngineModel = "APS500-C7B" Then
                        NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, StandardCELTemplateReportFullFileName, AddressOf CreateStandardCELPerformanceFileC7B)
                    ElseIf CELProject.EngineModel = "APS500-C7D" Then
                        NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, StandardCELTemplateReportFullFileName, AddressOf CreateStandardCELPerformanceFileC7D)
                    ElseIf CELProject.EngineModel = "APS500-C11" Then
                        NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, StandardCELTemplateReportFullFileName, AddressOf CreateStandardCELPerformanceFileC11)
                    End If

                    CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, True, CELProject.EngineModel, NewFileCreated)

                    CELProject.PERF_TAKE_POINT_BTN.Value = Values.False
                End If

            Catch ex As Exception
                MessageBox.Show("OnPERF_TAKE_POINT_BTN: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally

            End Try
        End Sub

        Private Sub OnREADY_TO_LOAD_IND(ByVal sender As IChannel, ByVal newVal As Value)
            If (CELProject.IsTrue(newVal)) Then

                Try
                    NUMBER_OF_STARTS.Value = New KineticaRT.Values.Double(NUMBER_OF_STARTS.Value.ToDouble + 1)
                Catch ex As System.Exception
                    MessageBox.Show("OnREADY_TO_LOAD_IND: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                End Try

 

            End If
        End Sub

        Private Sub OnLOUVERS_CLOSED(ByVal sender As IChannel, ByVal newVal As Value)
            If (CELProject.IsFalse(newVal)) Then

                Try
                    If ENGINE_AT_REST_IND.Value = Values.False Then
                        STOP_BTN.Value = Values.True
                    End If
                Catch ex As System.Exception
                    MessageBox.Show("OnLOUVERS_CLOSED: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                End Try

            End If
        End Sub

        Private Sub OnPERFTestResultAcceptedCheckBox(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    PERF_TEST_RESULT_REJECTED.Value = Values.False
                End If

            Catch Ex As Exception
                MessageBox.Show("OnPERFTestResultAcceptedCheckBox: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnPERFTestResultRejectedCheckBox(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    PERF_TEST_RESULT_ACCEPTED.Value = Values.False
                End If

            Catch Ex As Exception
                MessageBox.Show("OnPERFTestResultRejectedCheckBox: " & Ex.ToString())
            End Try
        End Sub

        Protected Overrides Sub OnTestStep_List_SelectedIndexChanged(ByVal sender As System.Object, ByVal e As System.EventArgs)
            Try
                CELProject.PERF_TEST_STEP_NB.Value = New KineticaRT.Values.Integer(cmbTestStepList.SelectedIndex)
            Catch ex As Exception
                MessageBox.Show("OnTestStep_List_SelectedIndexChanged: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            Finally
            End Try
        End Sub

        Protected Overrides Sub OnCLOSE_TEST_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    MyBase.StopWorkingThread()

                    'Persistent Values Force Save
                    PersistentValuesCtrl.SavePersistentValues(True)

                    RemoveHandlers()

                    Dispose_Engine_Controllers()

                End If

            Catch ex As Exception
                MessageBox.Show("OnClose_Test: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionInitialized(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionInitialized(newStatus)

                If CELProject.EngineFamily = "APS500" Then

                    UserInputs.MapUserInputsParameters(CELProject)

                    CELProject.EngineSession.WorkingFolder = "C:\CELDAS DATA\" + CELProject.EngineModel() + "\" + UserInputs.EngineSerialNumber + "\" + UserInputs.WorkOrder
                    CELProject.CreateLogFile(AddressOf CreateCustomHeaderLogFile, CELProject.EngineModel(), CELProject.EngineModel())

                End If
            Catch ex As Exception
                MessageBox.Show("OnTestSessionInitialized: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)

            Catch ex As Exception

                MessageBox.Show("APS500_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            End Try
        End Sub

        Protected Overrides Sub OnTestSessionRunning(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            'Dim i As Integer
            Try
                MyBase.OnTestSessionRunning(newStatus)

                If CELProject.EngineFamily = "APS500" Then

                    Init_Engine_Channels()
                    Init_Engine_Channels_Value()
                    CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.Init_Engine_Controls)) 'Must be after Init_Engine Channels

                    CELProject.LoadSave_Custom_Parameters(Custom_Parameters, False) 'Load some parameters value from database

                    CELProject.Perf_Nb_Sheet_To_Print = 3

                    Init_Engine_Controllers()

                    AddHandlers()

                    MyBase.StartWorkingThread()

                    TestProgress_Initialize()
                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionRunning: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub AddHandlers()

            'Close_test Must Be first
            AddHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnCLOSE_TEST_BTN
            AddHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            AddHandler CELProject.PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
            AddHandler CELProject.PERF_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnPERF_OPEN_WINDOW_BTN
            AddHandler CELProject.PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN
            AddHandler PERF_TEST_RESULT_ACCEPTED.ValueChanged, AddressOf OnPERFTestResultAcceptedCheckBox
            AddHandler PERF_TEST_RESULT_REJECTED.ValueChanged, AddressOf OnPERFTestResultRejectedCheckBox
            AddHandler READY_TO_LOAD_IND.ValueChanged, AddressOf OnREADY_TO_LOAD_IND
            AddHandler LOUVERS_IND.ValueChanged, AddressOf OnLOUVERS_CLOSED
            AddHandler cmbTestStepList.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged

        End Sub
        Protected Overrides Sub RemoveHandlers()

            If Not (CELProject.CLOSE_TEST_BTN Is Nothing) Then
                RemoveHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnCLOSE_TEST_BTN
            End If
            If Not (CELProject.PERF_CLOSE_WINDOW_BTN Is Nothing) Then
                RemoveHandler CELProject.PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
            End If
            If Not (CELProject.LOG_TAKE_POINT_BTN Is Nothing) Then
                RemoveHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            End If
            If Not (CELProject.PERF_OPEN_WINDOW_BTN Is Nothing) Then
                RemoveHandler CELProject.PERF_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnPERF_OPEN_WINDOW_BTN
            End If
            If Not (CELProject.PERF_TAKE_POINT_BTN Is Nothing) Then
                RemoveHandler CELProject.PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN
            End If
            If Not (PERF_TEST_RESULT_ACCEPTED Is Nothing) Then
                RemoveHandler PERF_TEST_RESULT_ACCEPTED.ValueChanged, AddressOf OnPERFTestResultAcceptedCheckBox
            End If
            If Not (PERF_TEST_RESULT_REJECTED Is Nothing) Then
                RemoveHandler PERF_TEST_RESULT_REJECTED.ValueChanged, AddressOf OnPERFTestResultRejectedCheckBox
            End If
            If Not (READY_TO_LOAD_IND Is Nothing) Then
                RemoveHandler READY_TO_LOAD_IND.ValueChanged, AddressOf OnREADY_TO_LOAD_IND
            End If
            If Not (LOUVERS_IND Is Nothing) Then
                RemoveHandler LOUVERS_IND.ValueChanged, AddressOf OnLOUVERS_CLOSED
            End If
            If Not (cmbTestStepList Is Nothing) Then
                RemoveHandler cmbTestStepList.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged
            End If

        End Sub

        Protected Overrides Sub Init_Engine_Controllers()

            Dim PersistentValuesChannels() As String = {"NUMBER_OF_STARTS", "OPERATING_TIME_CURRENT_SEC", "FUEL_USED_INITIAL_LITERS", "FUEL_USED_TOTAL_LITERS"}
            Dim PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputs.EngineSerialNumber & "\" & UserInputs.WorkOrder & "\Log\PersistentValues.xml"

            PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

            Dim FuelUsedTotal As Double = FUEL_USED_TOTAL_LITERS.Value.ToDouble()
            FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())
            FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FuelUsedTotal)

            NumberOfTInletProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/APS500/T_INLET_NUMBER_PROBE", 0)
            NumberOfTEgtProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/APS500/T_EGT_NUMBER_PROBE", 0)
            NumberOfTBleedProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/APS500/T_BLEED_NUMBER_PROBE", 0)

            DeletableTEgtChCtrl = New DeletableChannelController(Me, NumberOfTEgtProbe, MaxNumberOfTEgtProbe, MaxNumberOfTEgtProbe, "T_EGT", "_DEGF", "_DELETE_BTN", "T_EGT_AVG_DEGF", "T_EGT_MIN_DEGF", "T_EGT_MAX_DEGF", "T_EGT_SPREAD_DEGF")
            DeletableTInletChCtrl = New DeletableChannelController(Me, NumberOfTInletProbe, MaxNumberOfTInletProbe, MaxNumberOfTInletProbe, "T_INLET", "_DEGF", "_DELETE_BTN", "T_INLET_AVG_DEGF", "T_INLET_MIN_DEGF", "T_INLET_MAX_DEGF", "T_INLET_SPREAD_DEGF")

            FlowmeterCtrl = New FlowmeterController(Me)

            StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_CURRENT_AMP", "STARTER_CURRENT_MAX_AMP", "START_BTN")
            StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_VOLTAGE_VDC", "STARTER_VOLTAGE_MAX_VDC", "START_BTN")

            TEGTMaxTemperatureRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_EGT_P1_DEGF", "T_EGT_MAX_START_DEGF", "START_BTN")

            RundownTimerCtrl = New TimerController(Me, "RUNDOWN_TIME_START_CONDITION_LATCH", "RUNDOWN_TIME_STOP_CONDITION_LATCH", "RUNDOWN_TIME_CONDITION_RESET", "RUNDOWN_TIME_SEC", Nothing, 0, "NONE")
            StartTimerCtrl = New TimerController(Me, "STARTING_TIME_START_CONDITION_LATCH", "STARTING_TIME_STOP_CONDITION_LATCH", "STARTING_TIME_CONDITION_RESET", "STARTING_TIME_SEC", Nothing, 0, "NONE")

            If CELProject.EngineModel = "APS500-C7D" Then
                TegtOver1010FTimerCtrl = New TimerController(Me, "T_EXHAUST_TIME_OVER_1010F_START_CONDITION", "T_EXHAUST_TIME_OVER_1010F_STOP_CONDITION", "T_EXHAUST_TIME_OVER_1010F_CONDITION_RESET", "T_EXHAUST_TIME_OVER_1010F_SEC", Nothing, 0, "NONE")
            End If

        End Sub
        Protected Overrides Sub Dispose_Engine_Controllers()

            If Not (DeletableTBleedChCtrl Is Nothing) Then
                DeletableTBleedChCtrl.Dispose()
            End If
            If Not (DeletableTEgtChCtrl Is Nothing) Then
                DeletableTEgtChCtrl.Dispose()
            End If
            If Not (DeletableTInletChCtrl Is Nothing) Then
                DeletableTInletChCtrl.Dispose()
            End If
            If Not (StarterMaxCurrentRecordCtrl Is Nothing) Then
                StarterMaxCurrentRecordCtrl.Dispose()
            End If
            If Not (StarterMaxVoltageRecordCtrl Is Nothing) Then
                StarterMaxVoltageRecordCtrl.Dispose()
            End If
            If Not (TEGTMaxTemperatureRecordCtrl Is Nothing) Then
                TEGTMaxTemperatureRecordCtrl.Dispose()
            End If
            If Not (PersistentValuesCtrl Is Nothing) Then
                PersistentValuesCtrl.Dispose()
            End If
            If Not (RundownTimerCtrl Is Nothing) Then
                RundownTimerCtrl.Dispose()
            End If
            If Not (StartTimerCtrl Is Nothing) Then
                StartTimerCtrl.Dispose()
            End If

            If Not (FlowmeterCtrl Is Nothing) Then
                FlowmeterCtrl.Dispose()
            End If

        End Sub

        Protected Overrides Sub OnTestSessionClosing(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            'Dim i As Integer
            Try
                MyBase.OnTestSessionClosing(newStatus)

                Select Case CELProject.EngineFamily
                    Case "APS500"

                        If Not (FlowmeterCtrl Is Nothing) Then
                            FlowmeterCtrl.Dispose()
                        End If

                        If TestProgressMgr IsNot Nothing Then
                            TestProgress_Save()
                            TestProgressMgr.Dispose()
                            TestProgressMgr = Nothing
                        End If
                End Select


            Catch ex As Exception
                MessageBox.Show("OnTestSessionClosing: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Function Init_Engine_Channels() As Boolean
            'Dim i As Integer
            Dim Return_Value As New ArrayList()

            Return_Value.Clear()

            Try

                Select Case CELProject.EngineFamily
                    Case "APS500"

                        Return_Value.Add(MyBase.InitializeObject(Master_Engine_Window, CELProject.EngineFamily.Replace("-", "_") + "_Screen"))

                        Master_Engine_Window.WindowState = FormWindowState.Normal
                        Master_Engine_Window.Left = 0
                        Master_Engine_Window.Top = 0
                        'Master_Engine_Window.ClientSize = New System.Drawing.Size(2560, 959)

                        'ft nouvelle facon de faire
                        Dim hmiWindow As Object = MyBase.GetObject("APS500_Screen")

                        cmbTestStepList = CELProject.SearchControl(hmiWindow, "TestStep_List")
                        Debug.Assert(Not IsNothing(cmbTestStepList), "Control TestStep_List Is Nothing")

                        Return_Value.Add(MyBase.InitializeChannel(BLEED_BTN, "BLEED_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(COUNTER_INIT_START_CYCLES, "COUNTER_INIT_START_CYCLES"))
                        Return_Value.Add(MyBase.InitializeChannel(COUNTER_FINAL_START_CYCLES, "COUNTER_FINAL_START_CYCLES"))
                        Return_Value.Add(MyBase.InitializeChannel(E_STOP_CMD, "E_STOP_CMD"))
                        Return_Value.Add(MyBase.InitializeChannel(ENGINE_AT_REST_IND, "ENGINE_AT_REST_IND"))
                        Return_Value.Add(MyBase.InitializeChannel(FACILITY_FIRE_IND, "FACILITY_FIRE_IND"))
                        Return_Value.Add(MyBase.InitializeChannel(FUEL_USED_INITIAL_LITERS, "FUEL_USED_INITIAL_LITERS"))
                        Return_Value.Add(MyBase.InitializeChannel(FUEL_USED_TOTAL_LITERS, "FUEL_USED_TOTAL_LITERS"))
                        Return_Value.Add(MyBase.InitializeChannel(FM_INITIAL_VOLUME_LITERS, "FM_INITIAL_VOLUME_LITERS"))
                        Return_Value.Add(MyBase.InitializeChannel(FM_TOTAL_VOLUME_LITERS, "FM_TOTAL_VOLUME_LITERS"))
                        Return_Value.Add(MyBase.InitializeChannel(HOUR_METER_INIT_OPERATING_TIME, "HOUR_METER_INIT_OPERATING_TIME"))
                        Return_Value.Add(MyBase.InitializeChannel(HOUR_METER_FINAL_OPERATING_TIME, "HOUR_METER_FINAL_OPERATING_TIME"))
                        Return_Value.Add(MyBase.InitializeChannel(LOAD_AIR_VALVE_DEMAND, "LOAD_AIR_VALVE_DEMAND"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_FUEL_USED_TOTAL_LITERS, "LOG_PERF_FUEL_USED_TOTAL_LITERS"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_BARO_PSIA, "LOG_PERF_P_BARO_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_N1_RPM, "LOG_PERF_N1_RPM"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_OPERATING_TIME_CURRENT_HOURS, "LOG_PERF_OPERATING_TIME_CURRENT_HOURS"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_OUTPUT_POWER_KW, "LOG_PERF_OUTPUT_POWER_KW"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_BLEED_PSIA, "LOG_PERF_P_BLEED_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_CD_PSIG, "LOG_PERF_P_CD_PSIG"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_EXHAUST_INH20G, "LOG_PERF_P_EXHAUST_INH20G"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_GB_VENT_INH20G, "LOG_PERF_P_GB_VENT_INH20G"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_FUEL_BOOST_PSIG, "LOG_PERF_P_FUEL_BOOST_PSIG"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_OIL_PSIG, "LOG_PERF_P_OIL_PSIG"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_ORIFICE_DELTA_INH20D, "LOG_PERF_P_ORIFICE_DELTA_INH20D"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_ORIFICE_DELTA_PSID, "LOG_PERF_P_ORIFICE_DELTA_PSID"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_ORIFICE_PSIA, "LOG_PERF_P_ORIFICE_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_RUNDOWN_TIME_SEC, "LOG_PERF_RUNDOWN_TIME_SEC"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_STARTING_TIME_SEC, "LOG_PERF_STARTING_TIME_SEC"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_BLEED_DEGF, "LOG_PERF_T_BLEED_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_CELL_DEGF, "LOG_PERF_T_CELL_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_EGT_AVG_DEGF, "LOG_PERF_T_EGT_AVG_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_EGT_MAX_START_DEGF, "LOG_PERF_T_EGT_MAX_START_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_EGT_P1_DEGF, "LOG_PERF_T_EGT_P1_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_FUEL_DEGF, "LOG_PERF_T_FUEL_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_INLET_AVG_DEGF, "LOG_PERF_T_INLET_AVG_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_OIL_SUMP_DEGF, "LOG_PERF_T_OIL_SUMP_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_ORIFICE_DEGF, "LOG_PERF_T_ORIFICE_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_VIB_ENGINE_MILS, "LOG_PERF_VIB_ENGINE_MILS"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WB_CALC_PPM, "LOG_PERF_WB_CALC_PPM"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WB_PPM, "LOG_PERF_WB_PPM"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WB_COR_PPM, "LOG_PERF_WB_COR_PPM"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WB_COR_CALCULATION_PPM, "LOG_PERF_WB_COR_CALCULATION_PPM"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WF_PPH, "LOG_PERF_WF_PPH"))
                        Return_Value.Add(MyBase.InitializeChannel(LOUVERS_IND, "LOUVERS_IND"))
                        Return_Value.Add(MyBase.InitializeChannel(N1_RPM_MEAN, "N1_RPM_MEAN"))
                        Return_Value.Add(MyBase.InitializeChannel(NUMBER_OF_STARTS, "NUMBER_OF_STARTS"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_TEST_RESULT_ACCEPTED, "PERF_TEST_RESULT_ACCEPTED"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_TEST_RESULT_REJECTED, "PERF_TEST_RESULT_REJECTED"))
                        Return_Value.Add(MyBase.InitializeChannel(P_ORIFICE_PSIA, "P_ORIFICE_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(P_ORIFICE_DELTA_PSID, "P_ORIFICE_DELTA_PSID"))
                        Return_Value.Add(MyBase.InitializeChannel(P_ORIFICE_DELTA_PSID_MEAN, "P_ORIFICE_DELTA_PSID_MEAN"))
                        Return_Value.Add(MyBase.InitializeChannel(P_ORIFICE_PSIA_MEAN, "P_ORIFICE_PSIA_MEAN"))
                        Return_Value.Add(MyBase.InitializeChannel(READY_TO_LOAD_IND, "READY_TO_LOAD_IND"))
                        Return_Value.Add(MyBase.InitializeChannel(SAS_INHIBIT_BLEED_OFF_BTN, "SAS_INHIBIT_BLEED_OFF_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(STARTER_RECTIFIER_BTN, "STARTER_RECTIFIER_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(STOP_BTN, "STOP_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(T_EGT_MAX_START_DEGF, "T_EGT_MAX_START_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(T_ORIFICE_DEGF, "T_ORIFICE_DEGF"))
                        Return_Value.Add(MyBase.InitializeChannel(VIB_ENGINE_MILS, "VIB_ENGINE_MILS"))
                        Return_Value.Add(MyBase.InitializeChannel(WB_CALC_PPM, "WB_CALC_PPM"))
                        Return_Value.Add(MyBase.InitializeChannel(WB_PPM_MEAN, "WB_PPM_MEAN"))

                        Return_Value.Add(MyBase.InitializeChannel(OPERATING_TIME_CURRENT_SEC, "OPERATING_TIME_CURRENT_SEC"))

                        If CELProject.EngineModel = "APS500-C7B" Then
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_CD_COR_PSIA, "LOG_PERF_P_CD_COR_PSIA"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_CD_COR_CALCULATION_PSIA, "LOG_PERF_P_CD_COR_CALCULATION_PSIA"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_SHP_COR_HP, "LOG_PERF_SHP_COR_HP"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_SHP_COR_CALCULATION_HP, "LOG_PERF_SHP_COR_CALCULATION_HP"))
                        ElseIf CELProject.EngineModel = "APS500-C7D" Then
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_CD_COR_PSIA, "LOG_PERF_P_CD_COR_PSIA"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_SHP_COR_HP, "LOG_PERF_SHP_COR_HP"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_SHP_COR_CALCULATION_HP, "LOG_PERF_SHP_COR_CALCULATION_HP"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_EXHAUST_TIME_OVER_1010F_SEC, "LOG_PERF_T_EXHAUST_TIME_OVER_1010F_SEC"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WF_COR_PPH, "LOG_PERF_WF_COR_PPH"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WF_COR_CALCULATION_PPH, "LOG_PERF_WF_COR_CALCULATION_PPH"))
                        ElseIf CELProject.EngineModel = "APS500-C11" Then
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_EGT_CALCULATION_DEGF, "LOG_PERF_T_EGT_CALCULATION_DEGF"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_EGT_AVG_COR_DEGF, "LOG_PERF_T_EGT_AVG_COR_DEGF"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_EGT_SET_POINT_DEGF, "LOG_PERF_T_EGT_SET_POINT_DEGF"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_CD_COR_PSIA, "LOG_PERF_P_CD_COR_PSIA"))
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_CD_COR_CALCULATION_PSIA, "LOG_PERF_P_CD_COR_CALCULATION_PSIA"))
                        End If

                End Select
            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.ToString())
                Return_Value.Add(False)
            Finally

            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function

        Private Sub TestProgress_Initialize()
            Dim dataInfo As CEL.TestProgress.TestProgressMgr.TestProgress_DataInfo

            dataInfo.EngineStartEventChannelName = "START_BTN"
            dataInfo.EngineStartEventChannelValue = True
            dataInfo.EngineStartEventDescription = "Mise en route"
            dataInfo.EngineStartEventRecordTime = True
            dataInfo.EngineStopEventChannelName = "STOP_BTN"
            dataInfo.EngineStopEventChannelValue = True
            dataInfo.EngineStopEventDescription = "Arrêt moteur - Temps d'arrêt (s): "
            dataInfo.EngineStopEventRecordTime = True
            dataInfo.TestProgressFrameName = CELProject.EngineFamily.Replace("-", "_") + "_Screen.fraTestProgressHorizontal"
            dataInfo.TestProgressSheetFileName = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
            dataInfo.UUTModel = CELProject.EngineModel
            dataInfo.UUTSerialNumber = Me.UserInputs.EngineSerialNumber
            dataInfo.UUTWorkOrder = Me.UserInputs.WorkOrder
            Me.TestProgressMgr = New CEL.TestProgress.TestProgressMgr(dataInfo)
        End Sub


        Private Sub TestProgress_RecordPerfStepC7B(testStep As eTestStepAPS500C7B)
            If Me.TestProgressMgr IsNot Nothing Then
                Dim sheetEntry As CEL.TestProgress.TestProgressSheetEntry = Nothing

                Dim checkItemPBDCOR As String = "Corrected Compressor Discharge Pressure - Min: " + _
                    Me.LOG_PERF_P_CD_COR_CALCULATION_PSIA.Value.ToString(Me.LOG_PERF_P_CD_COR_CALCULATION_PSIA.Format, Nothing) + " Read: " + _
                    Me.LOG_PERF_P_CD_COR_PSIA.Value.ToString(Me.LOG_PERF_P_CD_COR_PSIA.Format, Nothing) + " PSIA"
                Dim checkItemWBCOR As String = "Corrected Bleed Air Flow - Min: " + _
                    Me.LOG_PERF_WB_COR_CALCULATION_PPM.Value.ToString(LOG_PERF_WB_COR_CALCULATION_PPM.Format, Nothing) + " Read: " + _
                    Me.LOG_PERF_WB_COR_PPM.Value.ToString(LOG_PERF_WB_COR_PPM.Format, Nothing) + " PPM"
                Dim checkItemSHPCOR As String = "Corrected Shaft Horse Power - Min: " + _
                    Me.LOG_PERF_SHP_COR_CALCULATION_HP.Value.ToString(LOG_PERF_SHP_COR_CALCULATION_HP.Format, Nothing) + " Read: " + _
                    Me.LOG_PERF_SHP_COR_HP.Value.ToString(LOG_PERF_SHP_COR_HP.Format, Nothing) + " HP"

                Select Case testStep
                    Case eTestStepAPS500C7B.BLEED_FLOW_ONLY
                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Bleed Flow Only", {checkItemPBDCOR, checkItemWBCOR})
                    Case eTestStepAPS500C7B.SHP_ONLY
                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "SHP Only", {checkItemSHPCOR})
                    Case eTestStepAPS500C7B.CONCURRENT_SHP_AND_BLEED_FLOW
                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Concurent SHP And Bleed Flow", {checkItemPBDCOR, checkItemWBCOR})
                End Select

                If sheetEntry IsNot Nothing Then
                    Me.TestProgressMgr.AddTestProgressEntry(sheetEntry)
                End If
            End If
        End Sub

        Private Sub TestProgress_RecordPerfStepC7D(testStep As eTestStepAPS500C7D)
            If Me.TestProgressMgr IsNot Nothing Then
                Dim sheetEntry As CEL.TestProgress.TestProgressSheetEntry = Nothing

                Dim checkItemWBCOR As String = "Corrected Bleed Airflow - Min: " + _
                    Me.LOG_PERF_WB_COR_CALCULATION_PPM.Value.ToString(LOG_PERF_WB_COR_CALCULATION_PPM.Format, Nothing) + " Read: " + _
                    Me.LOG_PERF_WB_COR_PPM.Value.ToString(LOG_PERF_WB_COR_PPM.Format, Nothing) + " PPM"
                Dim checkItemSHPCOR As String = "Corrected Shaft Horse Power - Min: " + _
                    Me.LOG_PERF_SHP_COR_CALCULATION_HP.Value.ToString(LOG_PERF_SHP_COR_CALCULATION_HP.Format, Nothing) + " Read: " + _
                    Me.LOG_PERF_SHP_COR_HP.Value.ToString(LOG_PERF_SHP_COR_HP.Format, Nothing) + " HP"
                Dim checkItemWFCOR As String = "Corrected Fuel Flow - Min: " + _
                    Me.LOG_PERF_WF_COR_CALCULATION_PPH.Value.ToString(LOG_PERF_WF_COR_CALCULATION_PPH.Format, Nothing) + " Read: " + _
                    Me.LOG_PERF_WF_COR_PPH.Value.ToString(LOG_PERF_WF_COR_PPH.Format, Nothing) + " PPH"

                Select Case testStep
                    Case eTestStepAPS500C7D.TEST_STEP_NUMBER_2
                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Test Step Number 2", {checkItemWBCOR, checkItemSHPCOR})
                    Case eTestStepAPS500C7D.TEST_STEP_NUMBER_3
                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Test Step Number 3", {checkItemWFCOR})
                End Select

                If sheetEntry IsNot Nothing Then
                    Me.TestProgressMgr.AddTestProgressEntry(sheetEntry)
                End If
            End If
        End Sub

        Private Sub TestProgress_RecordPerfStepC11(testStep As eTestStepAPS500C11)
            If Me.TestProgressMgr IsNot Nothing Then
                Dim sheetEntry As CEL.TestProgress.TestProgressSheetEntry = Nothing

                Dim checkItemPCDCOR As String = "Corrected Compressor Discharge Pressure - Min: " + _
                    Me.LOG_PERF_P_CD_COR_CALCULATION_PSIA.Value.ToString(LOG_PERF_P_CD_COR_CALCULATION_PSIA.Format, Nothing) + " Read: " + _
                    Me.LOG_PERF_P_CD_COR_PSIA.Value.ToString(LOG_PERF_P_CD_COR_PSIA.Format, Nothing) + " PSIA"
                Dim checkItemWBCOR As String = "Corrected Bleed Airflow - Min: " + _
                    Me.LOG_PERF_WB_COR_CALCULATION_PPM.Value.ToString(LOG_PERF_WB_COR_CALCULATION_PPM.Format, Nothing) + " Read: " + _
                    Me.LOG_PERF_WB_COR_PPM.Value.ToString(LOG_PERF_WB_COR_PPM.Format, Nothing) + " PPM"
                Dim checkItemEGTCOR As String = "Corrected Exhaust Gas Temperature - Max: " + _
                    Me.LOG_PERF_T_EGT_CALCULATION_DEGF.Value.ToString(LOG_PERF_T_EGT_CALCULATION_DEGF.Format, Nothing) + " Read: " + _
                    Me.LOG_PERF_T_EGT_AVG_COR_DEGF.Value.ToString(LOG_PERF_T_EGT_AVG_COR_DEGF.Format, Nothing) + " °F"
                Dim checkItemEGTSET As String = "EGT Set Point : " + _
                    Me.LOG_PERF_T_EGT_SET_POINT_DEGF.Value.ToString(LOG_PERF_T_EGT_SET_POINT_DEGF.Format, Nothing) + " °F"

                Select Case testStep
                    Case eTestStepAPS500C11.BLEED_FLOW_ONLY
                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Bleed Flow Only", {checkItemPCDCOR, checkItemWBCOR})
                    Case eTestStepAPS500C11.SHP_ONLY
                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "SHP Only", {checkItemEGTCOR})
                    Case eTestStepAPS500C11.BLEED_FLOW_WITH_LOAD
                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Bleed Flow With Load", {checkItemPCDCOR, checkItemWBCOR, checkItemEGTSET})
                End Select

                If sheetEntry IsNot Nothing Then
                    Me.TestProgressMgr.AddTestProgressEntry(sheetEntry)
                End If
            End If
        End Sub

        Private Sub TestProgress_Save()
            If Not Me.TestProgressMgr Is Nothing Then
                TestProgress_UpdateProgressSheetHeader(Me.TestProgressMgr.TestProgressSheet)
                Dim fileName As String = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
                Dim settings As Xml.XmlWriterSettings = New Xml.XmlWriterSettings()
                settings.Indent = True

                Using writer As Xml.XmlWriter = Xml.XmlWriter.Create(fileName, settings)
                    Dim xslPath As String = "type=""text/xsl"" href=""" + Application.StartupPath + "/TestProgressSheet.xsl"""
                    writer.WriteProcessingInstruction("xml-stylesheet", xslPath)
                    Dim ser As New Xml.Serialization.XmlSerializer(GetType(CEL.TestProgress.TestProgressSheet))
                    ser.Serialize(writer, Me.TestProgressMgr.TestProgressSheet)
                End Using
            End If
        End Sub

        Private Sub TestProgress_UpdateProgressSheetHeader(progressSheet As CEL.TestProgress.TestProgressSheet)
            progressSheet.Header("No capteur de vibration") = Me.UserInputs.EngineVibrationPickupSerialNumber
            progressSheet.Header("No Capt. frein") = Me.UserInputs.LoadCellSerialNumber
            progressSheet.Header("Type d'huile") = Me.UserInputs.OilType
            progressSheet.Header("Quantité totale Jet A1") = Me.FUEL_USED_TOTAL_LITERS.Value.ToString()
            Dim runningTime As System.TimeSpan = System.TimeSpan.FromSeconds(Me.OPERATING_TIME_CURRENT_SEC.Value.ToDouble())
            progressSheet.Header("Temps de fonctionnement") = Math.Floor(runningTime.TotalHours).ToString() + _
                " h " + runningTime.Minutes.ToString("00")
        End Sub

