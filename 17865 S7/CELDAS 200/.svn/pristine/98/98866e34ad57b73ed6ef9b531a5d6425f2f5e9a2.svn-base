                        excelWorksheet.Cells(31, 10).Value = LOG_PERF_P_GB_VENT_INH20G.Value.ToString(LOG_PERF_P_GB_VENT_INH20G.Format, Nothing)
                        excelWorksheet.Cells(32, 10).Value = LOG_PERF_P_OIL_PSIG.Value.ToString(LOG_PERF_P_OIL_PSIG.Format, Nothing)
                        excelWorksheet.Cells(33, 10).Value = LOG_PERF_OUTPUT_POWER_KW.Value.ToString(LOG_PERF_OUTPUT_POWER_KW.Format, Nothing)
                        excelWorksheet.Cells(34, 10).Value = LOG_PERF_WB_PPM.Value.ToString(LOG_PERF_WB_PPM.Format, Nothing)
                        excelWorksheet.Cells(35, 10).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)
                        excelWorksheet.Cells(36, 10).Value = LOG_PERF_T_FUEL_DEGF.Value.ToString(LOG_PERF_T_FUEL_DEGF.Format, Nothing)

                    Case eTestStepAPS500C7B.FINAL_DATA

                        excelWorksheet = excelSheets.Item("SUMMARY")

                        'PERFORMED TEST DETAILS

                        excelWorksheet.Cells(26, 9).Value = LOG_PERF_STARTING_TIME_SEC.Value.ToString(LOG_PERF_STARTING_TIME_SEC.Format, Nothing)
                        excelWorksheet.Cells(27, 9).Value = LOG_PERF_RUNDOWN_TIME_SEC.Value.ToString(LOG_PERF_RUNDOWN_TIME_SEC.Format, Nothing)
                        excelWorksheet.Cells(28, 9).Value = LOG_PERF_T_EGT_MAX_START_DEGF.Value.ToString(LOG_PERF_T_EGT_MAX_START_DEGF.Format, Nothing)
                        excelWorksheet.Cells(29, 9).Value = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format, Nothing)
                        excelWorksheet.Cells(30, 9).Value = NUMBER_OF_STARTS.Value.ToString(NUMBER_OF_STARTS.Format, Nothing)
                        excelWorksheet.Cells(31, 9).Value = LOG_PERF_FUEL_USED_TOTAL_LITERS.Value.ToString(LOG_PERF_FUEL_USED_TOTAL_LITERS.Format, Nothing)
                        excelWorksheet.Cells(32, 9).Value = HOUR_METER_INIT_OPERATING_TIME.Value.ToString(HOUR_METER_INIT_OPERATING_TIME.Format, Nothing)
                        excelWorksheet.Cells(33, 9).Value = HOUR_METER_FINAL_OPERATING_TIME.Value.ToString(HOUR_METER_FINAL_OPERATING_TIME.Format, Nothing)
                        excelWorksheet.Cells(34, 9).Value = COUNTER_INIT_START_CYCLES.Value.ToString(COUNTER_INIT_START_CYCLES.Format, Nothing)
                        excelWorksheet.Cells(35, 9).Value = COUNTER_FINAL_START_CYCLES.Value.ToString(COUNTER_FINAL_START_CYCLES.Format, Nothing)

                        excelWorksheet = excelSheets.Item("ACCEPTANCE")

                        'Test Result
                        If CELProject.IsTrue(PERF_TEST_RESULT_ACCEPTED.Value) Then
                            excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                        Else
                            excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                        End If

                        If CELProject.IsTrue(PERF_TEST_RESULT_REJECTED.Value) Then
                            excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                        Else
                            excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                        End If

                End Select

                TestProgress_RecordPerfStepC7B(TestStepNumber)

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreateStandardCELPerformanceFileC7B: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreateStandardCELPerformanceFileC7B = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)

            End Try

        End Function

        Private Function CreateStandardCELPerformanceFileC7D(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreateStandardCELPerformanceFileC7D = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            Try
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    excelWorksheet = excelSheets.Item("SUMMARY")

                    'HEADER

                    'Serial Number
                    excelWorksheet.Cells(5, 3).NumberFormat = "@"
                    excelWorksheet.Cells(5, 3).Value = UserInputs.EngineSerialNumber

                    'Word Order
                    excelWorksheet.Cells(6, 3).NumberFormat = "@"
                    excelWorksheet.Cells(6, 3).Value = UserInputs.WorkOrder

                    'ESU Serial Number
                    excelWorksheet.Cells(7, 3).NumberFormat = "@"
                    excelWorksheet.Cells(7, 3).Value = UserInputs.ECBSerialNumber

                    'Exhaust Duct Serial Number
                    excelWorksheet.Cells(8, 3).NumberFormat = "@"
                    excelWorksheet.Cells(8, 3).Value = UserInputs.ExhaustDuctSerialNumber

                    'Bellmouth Serial Number
                    excelWorksheet.Cells(9, 3).NumberFormat = "@"
                    excelWorksheet.Cells(9, 3).Value = UserInputs.BellmouthSerialNumber

                    'Bleed Duct Serial Number
                    excelWorksheet.Cells(10, 3).NumberFormat = "@"
                    excelWorksheet.Cells(10, 3).Value = UserInputs.BleedDuctSerialNumber

                    'Starter Serial Number
                    excelWorksheet.Cells(11, 3).NumberFormat = "@"
                    excelWorksheet.Cells(11, 3).Value = UserInputs.StarterSerialNumber

                    'Dyno Serial Number
                    excelWorksheet.Cells(12, 3).NumberFormat = "@"
                    excelWorksheet.Cells(12, 3).Value = UserInputs.DynoSerialNumber

                    'Engine Vibration Pickup Serial Number
                    excelWorksheet.Cells(5, 9).NumberFormat = "@"
                    excelWorksheet.Cells(5, 9).Value = UserInputs.EngineVibrationPickupSerialNumber

                    'Oil Type
                    excelWorksheet.Cells(6, 9).NumberFormat = "@"
                    excelWorksheet.Cells(6, 9).Value = UserInputs.OilType

                    'TSN
                    excelWorksheet.Cells(7, 9).NumberFormat = "@"
                    excelWorksheet.Cells(7, 9).Value = UserInputs.TSN

                    'CSN
                    excelWorksheet.Cells(8, 9).NumberFormat = "@"
                    excelWorksheet.Cells(8, 9).Value = UserInputs.CSN

                    'Reason
                    excelWorksheet.Cells(9, 9).NumberFormat = "@"
                    excelWorksheet.Cells(9, 9).Value = UserInputs.Reason

                    'Test Type
                    excelWorksheet.Cells(10, 9).NumberFormat = "@"
                    excelWorksheet.Cells(10, 9).Value = UserInputs.TestType

                    'Load Cell Serial Number
                    excelWorksheet.Cells(11, 9).NumberFormat = "@"
                    excelWorksheet.Cells(11, 9).Value = UserInputs.LoadCellSerialNumber

