    '<System.Security.Permissions.PermissionSet(System.Security.Permissions.SecurityAction.Assert, Unrestricted:=True)> _
    Public Class APS500_Sequence
        Inherits ApuSequence
        Implements IBleedAirFlowCalculation

        'Les constantes isont lu a partir du fichier celdas_12917.cfg
        Private NumberOfTInletProbe As Integer = 0  '3 Probes
        Private NumberOfTEgtProbe As Integer = 0 ' 6
        Private NumberOfTBleedProbe As Integer = 0 '1

        Private Const MaxNumberOfTBleedProbe As Integer = 1
        Private Const MaxNumberOfTEgtProbe As Integer = 6
        Private Const MaxNumberOfTInletProbe As Integer = 3

#Region " Enum "

        Private Enum eTestStepAPS500C7B
            NO_LOAD = 0
            BLEED_FLOW_ONLY = 1
