<Description href="#ref-211"/>
<ToolTip href="#ref-211"/>
<Text id="ref-845">If(PLA_COMPUTE_DONE=False,RIG_MSG_05,If(PLA_MIN_STOP_POS_DONE=False,RIG_MSG_06,PLA_RIG_MESSAGE_NEXT2))</Text>
<Units href="#ref-211"/>
