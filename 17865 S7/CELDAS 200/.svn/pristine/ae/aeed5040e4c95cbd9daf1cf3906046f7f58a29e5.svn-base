<Description href="#ref-211"/>
<ToolTip href="#ref-211"/>
<TrueText id="ref-975">True</TrueText>
<FalseText id="ref-976">False</FalseText>
<Text id="ref-977">PLA_MIN_POS_DONE And PLA_MAX_RIG_POS&#62; 70 And PLA_MAX_POS_DONE = False And PLA_ENGAGE_BTN = False And (PLA_STORE_MAX_ANGLE_BTN_ENB_CUSTOM1 Or PLA_STORE_MAX_ANGLE_BTN_ENB_CUSTOM2)</Text>
</a5:BooleanExpression>
<a5:BooleanExpression id="ref-179" xmlns:a5="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Channels/KineticaRT.Logic.Channels%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-978">PLA_STORE_MAX_ANGLE_BTN_ENB_CUSTOM1</Name>
<Description id="ref-979">Peut etre utilise pour specifier un angle particulier pour un moteur et s assurer que le throttle semble etre dans la bonne position</Description>
<ToolTip href="#ref-211"/>
<TrueText id="ref-980">True</TrueText>
<FalseText id="ref-981">False</FalseText>
<Text id="ref-982">If((PLA_MAX_RIG_POS &#62; 70) And (PLA_LEVER_POS &#62; 25) And (PLA_LEVER_POS &#60; 250), True, False ) </Text>
</a5:BooleanExpression>
<a5:BooleanExpression id="ref-180" xmlns:a5="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Channels/KineticaRT.Logic.Channels%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-983">PLA_STORE_MAX_ANGLE_BTN_ENB_CUSTOM2</Name>
<Description id="ref-984">Peut etre utilise pour specifier un angle particulier pour un moteur et s assurer que le throttle semble etre dans la bonne position</Description>
<ToolTip href="#ref-211"/>
<TrueText id="ref-985">True</TrueText>
<FalseText id="ref-986">False</FalseText>
<Text id="ref-987">If((PLA_MAX_RIG_POS = 130) And (PLA_LEVER_POS &#62; 100) And (PLA_LEVER_POS &#60; 250), True, False ) </Text>
</a5:BooleanExpression>
