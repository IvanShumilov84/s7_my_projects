<a5:BooleanExpression id="ref-52" xmlns:a5="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Channels/KineticaRT.Logic.Channels%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-431">CLA_STORE_MAX_ANGLE_BTN_ENB</Name>
<Description href="#ref-211"/>
<ToolTip href="#ref-211"/>
<TrueText id="ref-432">True</TrueText>
<FalseText id="ref-433">False</FalseText>
<Text id="ref-434">CLA_MIN_POS_DONE And CLA_MAX_RIG_POS &#62; 40 And CLA_MAX_POS_DONE = False And CLA_ENGAGE_BTN = False And (CLA_STORE_MAX_ANGLE_BTN_ENB_CUSTOM1 Or CLA_STORE_MAX_ANGLE_BTN_ENB_CUSTOM2)</Text>
</a5:BooleanExpression>
<a5:BooleanExpression id="ref-53" xmlns:a5="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Channels/KineticaRT.Logic.Channels%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-435">CLA_STORE_MAX_ANGLE_BTN_ENB_CUSTOM1</Name>
<Description id="ref-436">Peut etre utilise pour specifier un angle particulier pour un moteur et s assurer que le throttle semble etre dans la bonne position</Description>
<ToolTip href="#ref-211"/>
<TrueText id="ref-437">True</TrueText>
<FalseText id="ref-438">False</FalseText>
<Text id="ref-439">If((CLA_MAX_RIG_POS &#62; 40) And (CLA_LEVER_POS &#62; 30) And (CLA_LEVER_POS &#60; 250), True, False ) </Text>
</a5:BooleanExpression>
<a5:BooleanExpression id="ref-54" xmlns:a5="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Channels/KineticaRT.Logic.Channels%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-440">CLA_STORE_MAX_ANGLE_BTN_ENB_CUSTOM2</Name>
<Description id="ref-441">Peut etre utilise pour specifier un angle particulier pour un moteur et s assurer que le throttle semble etre dans la bonne position</Description>
<ToolTip href="#ref-211"/>
<TrueText id="ref-442">True</TrueText>
<FalseText id="ref-443">False</FalseText>
<Text id="ref-444">If((CLA_MAX_RIG_POS &#62; 70) And (CLA_LEVER_POS &#62; 30) And (CLA_LEVER_POS &#60; 250), True, False ) </Text>
</a5:BooleanExpression>
