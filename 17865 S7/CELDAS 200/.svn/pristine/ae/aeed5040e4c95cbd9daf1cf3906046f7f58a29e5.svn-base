<Min>0</Min>
<Max>100</Max>
<Format id="ref-1058">G</Format>
<DecimalDigits>2</DecimalDigits>
</a6:NumericExpression>
<a6:NumericExpression id="ref-200" xmlns:a6="http://schemas.microsoft.com/clr/nsassem/KineticaRT.Logic.Expressions/KineticaRT.Logic.Expressions%2C%20Version%3D1.2.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3D2e0c8c468356d1c8">
<Name id="ref-1059">RIG_MSG_08</Name>
<Description href="#ref-211"/>
<ToolTip href="#ref-211"/>
<Text id="ref-1060">&#34;SET THE MAXIMUM STOP POSITION. (IF THROTTLE GOES HIGHER TO THIS POSITION, SERVO MOTOR WILL STOP MOVING AT THIS POSITION)&#34;</Text>
<Units href="#ref-211"/>
<Min>0</Min>
<Max>100</Max>
