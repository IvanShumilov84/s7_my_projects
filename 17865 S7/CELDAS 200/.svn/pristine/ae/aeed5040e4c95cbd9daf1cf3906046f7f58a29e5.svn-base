<Name id="ref-1044">RIG_MSG_03</Name>
<Description href="#ref-211"/>
<ToolTip href="#ref-211"/>
<Text id="ref-1045">&#34;SET YOUR 0 POSITION ON FCU EVEN IF THE FCU POSITION IS ALREADY AT 0. USE DISENGAGED/ENGAED BUTTON&#34;</Text>
