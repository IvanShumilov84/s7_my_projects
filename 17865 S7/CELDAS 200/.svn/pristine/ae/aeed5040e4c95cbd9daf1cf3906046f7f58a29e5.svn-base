<Name id="ref-1053">RIG_MSG_06</Name>
<Description href="#ref-211"/>
<ToolTip href="#ref-211"/>
<Text id="ref-1054">&#34;SET MINIMUM STOP POSITION. (IF THROTTLE GOES LOWER TO THIS POSITION, SERVO MOTOR WILL STOP MOVING AT THIS POSITION)&#34;</Text>
<Units href="#ref-211"/>
<Min>0</Min>
<Max>100</Max>
<Format id="ref-1055">G</Format>
<DecimalDigits>2</DecimalDigits>
</a6:NumericExpression>
