<Description href="#ref-211"/>
<ToolTip href="#ref-211"/>
<Text id="ref-848">If(TM_UUT_Model = &#34;XXXX&#34; ,RIG_MSG_07,If(PLA_MAX_STOP_POS_DONE=False,RIG_MSG_08,If(PLA_IDLE_POS_DONE=False,RIG_MSG_11,PLA_RIG_MESSAGE_NEXT3)))</Text>
<Units href="#ref-211"/>
