<Description href="#ref-211"/>
<ToolTip href="#ref-211"/>
<Text id="ref-842">If(OPC_AUTOCAL_STATUS=False,RIG_MSG_01,If(PLA_MAX_RIG_POS=0,RIG_MSG_02,If(PLA_MIN_POS_DONE=False,RIG_MSG_03,If(PLA_MAX_POS_DONE=False,RIG_MSG_04,PLA_RIG_MESSAGE_NEXT1))))</Text>
