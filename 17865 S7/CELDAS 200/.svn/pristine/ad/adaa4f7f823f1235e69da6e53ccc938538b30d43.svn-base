    Public Module Engines

        Public Function GetAllEnginesFromCategory(ByVal category As Category) As ArrayList

            Dim returnList = New ArrayList

            If category = Category.None Then
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.None))

            ElseIf category = Category.PW Then
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.PW305))
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.PW306))
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.PW307))
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.PW308))

            ElseIf category = Category.Small Then
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.Two))
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.TwoC))
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.Three))
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.ThreeA))
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.ThreeB))
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.ThreeC))
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.ThreeD))
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.Four))
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.Five))
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.FiveA))
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.FiveB))

            ElseIf category = Category.Big Then
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.Twenty))
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.Forty))
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.Fifty))
                returnList.AddRange(GetAllEnginesFromGroup(EngineGroup.Sixty))
            Else
                Throw New NotImplementedException("Category " + category + " is not handled in the GetAllFromCategory method.")
            End If

            Return returnList
        End Function

        Public Function GetAllEnginesFromGroup(ByVal group As EngineGroup) As ArrayList

            Dim returnList = New ArrayList

            If group = EngineGroup.None Then
                returnList.Add(Engine.EngineNotConnected)
                returnList.Add(Engine.DASCALIBRATION)
                returnList.Add(Engine.SYSTEMCHECK)

            ElseIf group = EngineGroup.Two Then
                returnList.Add(Engine.TFE73121C)
                returnList.Add(Engine.TFE73122B)
                returnList.Add(Engine.TFE73122J)
                returnList.Add(Engine.TFE73123B)

            ElseIf group = EngineGroup.TwoC Then
                returnList.Add(Engine.TFE7312C1C)
                returnList.Add(Engine.TFE7312C2B)
                returnList.Add(Engine.TFE7312C3B)

            ElseIf group = EngineGroup.Three Then
                returnList.Add(Engine.TFE73131C)
                returnList.Add(Engine.TFE73131E)
                returnList.Add(Engine.TFE73131F)
                returnList.Add(Engine.TFE73131K)
                returnList.Add(Engine.TFE73131G)
                returnList.Add(Engine.TFE73131H)
                returnList.Add(Engine.TFE73131J)
                returnList.Add(Engine.TFE7313R1D)
                returnList.Add(Engine.TFE7313R1G)
                returnList.Add(Engine.TFE7313R1H)

            ElseIf group = EngineGroup.ThreeA Then
                returnList.Add(Engine.TFE7313A2B)
                returnList.Add(Engine.TFE7313A2B1)
                returnList.Add(Engine.TFE7313A200G)
                returnList.Add(Engine.TFE7313AR2B)
                returnList.Add(Engine.TFE7313AR2B1)
                returnList.Add(Engine.TFE7313AR2B2)
                returnList.Add(Engine.TFE7313AR200G)
                returnList.Add(Engine.TFE7313AR3B)
                returnList.Add(Engine.TFE7313AR3B1)
                returnList.Add(Engine.TFE7313AR3B2)

            ElseIf group = EngineGroup.ThreeB Then
                returnList.Add(Engine.TFE7313B100S)
                returnList.Add(Engine.TFE7313BR100S)

            ElseIf group = EngineGroup.ThreeC Then
                returnList.Add(Engine.TFE7313C100S)
                returnList.Add(Engine.TFE7313C200G)
                returnList.Add(Engine.TFE7313C3B)
                returnList.Add(Engine.TFE7313C3B1)
                returnList.Add(Engine.TFE7313CR100S)
                returnList.Add(Engine.TFE7313CR200G)
                returnList.Add(Engine.TFE7313CR3B)
                returnList.Add(Engine.TFE7313CR3B1)
                returnList.Add(Engine.TFE7313CR3B2)

            ElseIf group = EngineGroup.ThreeD Then
                returnList.Add(Engine.TFE7313D1C)
                returnList.Add(Engine.TFE7313D1G)
                returnList.Add(Engine.TFE7313D1H)
                returnList.Add(Engine.TFE7313D1K)
                returnList.Add(Engine.TFE7313DR1D)
                returnList.Add(Engine.TFE7313DR1G)
                returnList.Add(Engine.TFE7313DR1H)

            ElseIf group = EngineGroup.Four Then
                returnList.Add(Engine.TFE73141C)
                returnList.Add(Engine.TFE7314R2S)

            ElseIf group = EngineGroup.Five Then
                returnList.Add(Engine.TFE73151J)
                returnList.Add(Engine.TFE7315R1H)
            ElseIf group = EngineGroup.FiveA Then
                returnList.Add(Engine.TFE7315AR1C)
                returnList.Add(Engine.TFE7315AR2C)
            ElseIf group = EngineGroup.FiveB Then
                returnList.Add(Engine.TFE7315BR1C)
                returnList.Add(Engine.TFE7315BR2C)
                returnList.Add(Engine.TFE7315BR1H)

            ElseIf group = EngineGroup.Twenty Then
                returnList.Add(Engine.TFE73120R1B)
                returnList.Add(Engine.TFE73120AR1B)
                returnList.Add(Engine.TFE73120BR1B)

            ElseIf group = EngineGroup.Forty Then
                returnList.Add(Engine.TFE73140R200G)
                returnList.Add(Engine.TFE73140AR200G)
                returnList.Add(Engine.TFE73140BR1B)
                returnList.Add(Engine.TFE731401C)

            ElseIf group = EngineGroup.Fifty Then
                returnList.Add(Engine.TFE73150R1H)

            ElseIf group = EngineGroup.Sixty Then
                returnList.Add(Engine.TFE731601C)

            ElseIf group = EngineGroup.PW305 Then
                returnList.Add(Engine.PW305AANC)
                returnList.Add(Engine.PW305ASMITH)
                returnList.Add(Engine.PW305BSMITH)

            ElseIf group = EngineGroup.PW306 Then
                returnList.Add(Engine.PW306AANC)
                returnList.Add(Engine.PW306C)

            ElseIf group = EngineGroup.PW307 Then
                returnList.Add(Engine.PW307A)

            ElseIf group = EngineGroup.PW308 Then
                returnList.Add(Engine.PW308AANC)
                returnList.Add(Engine.PW308CANC)
                returnList.Add(Engine.PW308CPLUS)

            Else
                Throw New NotImplementedException("Group " + group + " is not handled in the GetAllTFE731FromGroup method.")
            End If

            Return returnList
        End Function

        Public Function GetAllNamesFromCategory(ByVal category As Category) As ArrayList
            Dim enginesNames = New ArrayList

            Dim engines = GetAllEnginesFromCategory(category)
            For Each eng As Engine In engines
                enginesNames.Add(GetEngineDisplayName(eng))
            Next

            Return enginesNames
        End Function

        Public Function GetEngineCategory(ByVal engine As Engine) As Category

            If engine = Engine.EngineNotConnected Then Return Category.None

            If GetAllEnginesFromCategory(Category.None).Contains(engine) = True Then
                Return Category.None
            ElseIf GetAllEnginesFromCategory(Category.PW).Contains(engine) = True Then
                Return Category.PW
            ElseIf GetAllEnginesFromCategory(Category.Small).Contains(engine) = True Then
                Return Category.Small
            ElseIf GetAllEnginesFromCategory(Category.Big).Contains(engine) = True Then
                Return Category.Big
            Else
                Throw New NotSupportedException("The engine " + engine.ToString() + " is not part of the categories.")
            End If
        End Function

        Public Function GetEngineGroup(ByVal engine As Engine) As EngineGroup

            If engine = Engine.EngineNotConnected Then Return EngineGroup.None

            If GetAllEnginesFromGroup(EngineGroup.None).Contains(engine) = True Then
                Return EngineGroup.None
            ElseIf GetAllEnginesFromGroup(EngineGroup.Two).Contains(engine) = True Then
                Return EngineGroup.Two
            ElseIf GetAllEnginesFromGroup(EngineGroup.TwoC).Contains(engine) = True Then
                Return EngineGroup.TwoC
            ElseIf GetAllEnginesFromGroup(EngineGroup.Three).Contains(engine) = True Then
                Return EngineGroup.Three
            ElseIf GetAllEnginesFromGroup(EngineGroup.ThreeA).Contains(engine) = True Then
                Return EngineGroup.ThreeA
            ElseIf GetAllEnginesFromGroup(EngineGroup.ThreeB).Contains(engine) = True Then
                Return EngineGroup.ThreeB
            ElseIf GetAllEnginesFromGroup(EngineGroup.ThreeC).Contains(engine) = True Then
                Return EngineGroup.ThreeC
            ElseIf GetAllEnginesFromGroup(EngineGroup.ThreeD).Contains(engine) = True Then
                Return EngineGroup.ThreeD
            ElseIf GetAllEnginesFromGroup(EngineGroup.Four).Contains(engine) = True Then
                Return EngineGroup.Four
            ElseIf GetAllEnginesFromGroup(EngineGroup.Five).Contains(engine) = True Then
                Return EngineGroup.Five
            ElseIf GetAllEnginesFromGroup(EngineGroup.FiveA).Contains(engine) = True Then
                Return EngineGroup.FiveA
            ElseIf GetAllEnginesFromGroup(EngineGroup.FiveB).Contains(engine) = True Then
                Return EngineGroup.FiveB
            ElseIf GetAllEnginesFromGroup(EngineGroup.Twenty).Contains(engine) = True Then
                Return EngineGroup.Twenty
            ElseIf GetAllEnginesFromGroup(EngineGroup.Forty).Contains(engine) = True Then
                Return EngineGroup.Forty
            ElseIf GetAllEnginesFromGroup(EngineGroup.Fifty).Contains(engine) = True Then
                Return EngineGroup.Fifty
            ElseIf GetAllEnginesFromGroup(EngineGroup.Sixty).Contains(engine) = True Then
                Return EngineGroup.Sixty
            ElseIf GetAllEnginesFromGroup(EngineGroup.PW305).Contains(engine) = True Then
                Return EngineGroup.PW305
            ElseIf GetAllEnginesFromGroup(EngineGroup.PW306).Contains(engine) = True Then
                Return EngineGroup.PW306
            ElseIf GetAllEnginesFromGroup(EngineGroup.PW307).Contains(engine) = True Then
                Return EngineGroup.PW307
            ElseIf GetAllEnginesFromGroup(EngineGroup.PW308).Contains(engine) = True Then
                Return EngineGroup.PW308
            Else
                Throw New NotSupportedException("The engine " + engine.ToString() + " is not part of the categories.")
            End If
        End Function

        Public Function GetEngineDisplayName(ByVal engine As Engine) As String
            Select Case engine
                Case Engine.DASCALIBRATION
                    Return "DAS CALIBRATION"
                Case Engine.SYSTEMCHECK
                    Return "SYSTEM CHECK"
                Case Engine.PW305AANC
                    Return "PW305A ANC"
                Case Engine.PW305ASMITH
                    Return "PW305A SMITH"
                Case Engine.PW305BSMITH
                    Return "PW305B SMITH"
                Case Engine.PW306AANC
                    Return "PW306A ANC"
                Case Engine.PW306C
                    Return "PW306C"
                Case Engine.PW307A
                    Return "PW307A"
                Case Engine.PW308AANC
                    Return "PW308A ANC"
                Case Engine.PW308CANC
                    Return "PW308C ANC"
                Case Engine.PW308CPLUS
                    Return "PW308C+"
                Case Engine.TFE73121C
                    Return "TFE731-2-1C"
                Case Engine.TFE73122B
                    Return "TFE731-2-2B"
                Case Engine.TFE73122J
                    Return "TFE731-2-2J"
                Case Engine.TFE73123B
                    Return "TFE731-2-3B"
                Case Engine.TFE7312C1C
                    Return "TFE731-2C-1C"
                Case Engine.TFE7312C2B
                    Return "TFE731-2C-2B"
                Case Engine.TFE7312C3B
                    Return "TFE731-2C-3B"
