        Private Sub TFEEngineWork()
            Dim selectedEngine = Test_Mgr_UUT_Model.Value.ToString()
            Dim engineCategory = Engines.GetEngineCategory(Engines.GetEngineFromDisplayName(selectedEngine))
            If engineCategory <> Category.Small AndAlso engineCategory <> Category.Big Then Return

            Throw New NotImplementedException("Uncomment all this if you need to use TFE731")
            'Uncomment all this if you need to use TFE731
            '-------------------------------------------

            'OnFlowmeter()
            'Time_To_Accel(selectedEngine)
            'TFEIgnitionAutoTrigger()

        End Sub

        Dim IGNITION_ALREADY_TRIGGERED As Boolean = False

        Private Sub TFEIgnitionAutoTrigger()
            Try

                If Not IGNITION_AUTO.Value.ToString.ToUpper = "TRUE" Then Return

                'We can allow the trigger to happen once again when the engine stop
                If ENGINE_AT_REST.Value.ToString.ToUpper = "TRUE" Then
                    IGNITION_ALREADY_TRIGGERED = False
                    Return
                End If

                'Because the engine is running we need to validate the correct state to ignite
                If IGNITION_ALREADY_TRIGGERED Then Return
                If Not IGNITION_LOGIC.Value.ToString.ToUpper = "TRUE" Then Return

                'Lets kick the igniters!
                IGNITION_ALREADY_TRIGGERED = True
                IGNITERS.Value = KineticaRT.Values.Values.True

            Catch ex As Exception
                MessageBox.Show("Time_To_Light_Calc: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally
            End Try

        End Sub

        Private Sub AddHandlersForTFE(selectedEngine As String)

            Dim i As Integer
            Dim rake As Integer
            Dim probe As Integer

            Dim engineCategory = Engines.GetEngineCategory(Engines.GetEngineFromDisplayName(selectedEngine))
            If engineCategory <> Category.Small AndAlso engineCategory <> Category.Big Then Return

            'Close_test Must Be first


            Throw New NotImplementedException("Uncomment all this if you need to use TFE731")
            'Uncomment all this if you need to use TFE731
            '-------------------------------------------

            'AddHandler Close_Test.ValueChanged, AddressOf OnClose_Test
            'AddHandler ARCHIVE_RECORD.ValueChanged, AddressOf OnArchive
            'AddHandler ARCHIVE_STOP.ValueChanged, AddressOf OnArchive
            'AddHandler EVENT_ARCHIVE.PropertyChanged, AddressOf OnEventArchivePropertyChanged
            '
            'AddHandler ENGINE_AT_REST.ValueChanged, AddressOf OnAlarm
            'AddHandler ESTOP.ValueChanged, AddressOf OnEmerStop
            'AddHandler ESTOP.ValueChanged, AddressOf OnAlarm
            'AddHandler FUEL_FILTER_BYPASS.ValueChanged, AddressOf OnAlarm
            'AddHandler LOW_FUEL_PRESSURE.ValueChanged, AddressOf OnAlarm
            'AddHandler MOT_CHIP.ValueChanged, AddressOf OnAlarm
            'AddHandler N1_OVERSPEED.ValueChanged, AddressOf OnAlarm
            'AddHandler N2_OVERSPEED.ValueChanged, AddressOf OnAlarm
            'AddHandler OIL_FILTER_BYPASS.ValueChanged, AddressOf OnAlarm
            'AddHandler OVERTEMP.ValueChanged, AddressOf OnAlarm
            'AddHandler ENGINE_TIME_RESET.ValueChanged, AddressOf OnResetEngineTime
            'AddHandler FUEL_USED_RESET.ValueChanged, AddressOf OnResetFuelUsed
            'AddHandler TARE.ValueChanged, AddressOf OnTare
            '
            'AddHandler ShowAccelTimeWindow.ValueChanged, AddressOf OnShowAccelTimeWindow
            'AddHandler CLOSE_ACCEL_CHECK_BUTTON.ValueChanged, AddressOf OnCloseAccelTimeWindow
            'AddHandler STOP_TIMER_CND_BUTTON.ValueChanged, AddressOf OnStopTimerCondition
            'AddHandler ARM_TIMER_BUTTON.ValueChanged, AddressOf OnArmTimer
            '
            'If Not(OPERATING_TIME Is Nothing) Then
            '    ts = New System.TimeSpan(0)
            '    OPERATING_TIME.Value = New KineticaRT.Values.Text(ts.Hours.ToString.PadLeft(2, "0") & ":" & ts.Minutes.ToString.PadLeft(2, "0") & ":" & ts.Seconds.ToString.PadLeft(2, "0"))
            'Else
            '    ts = New System.TimeSpan(0)
            'End If
            '
            'If Not(FUEL_USED_GM.Value Is Nothing) Then
            '    If (FUEL_USED_GM.Value.ToString() = "0") Then
            '        FUEL_USED_GM.Value = New KineticaRT.Values.Text("0.0")
            '    End If
            'Else
            '    FUEL_USED_GM.Value = New KineticaRT.Values.Text("0.0")
            'End If
            '
            'ExitThread = False
            '
            ''This Thread contols the Event Archiver
            'EventArchiverThread = New Thread(AddressOf EventArchiveThread)
            'EventArchiverThread.Priority = ThreadPriority.Normal
            'EventArchiverThread.Name = "EventArchiverThread"
            'EventArchiverThread.Start()

            EVENT_ARCHIVE.Record = True

            EngineWorkerThread = New Thread(AddressOf EngineWorkingThread)
            EngineWorkerThread.Priority = ThreadPriority.Normal
            EngineWorkerThread.Name = "EngineWorkerThread"
            EngineWorkerThread.Start()


            If Not (T45_MAX.Value Is Nothing) Then
                T45_MAX.Value = New KineticaRT.Values.Double(0.0)
            End If

            If Not (IDLE_TIME.Value Is Nothing) Then
                IDLE_TIME.Value = New KineticaRT.Values.Text("0.0")
            End If

            If Not (LIGHT_TIME.Value Is Nothing) Then
                LIGHT_TIME.Value = New KineticaRT.Values.Text("0.0")
            End If

            For i = 0 To OPC_Ps1dot2_DELETE.GetUpperBound(0)
                AddHandler OPC_Ps1dot2_DELETE(i).ValueChanged, AddressOf OnPs1dot2_DELETE
            Next

            If engineCategory = Category.Small Then

                For i = 0 To OPC_T1_DELETE.GetUpperBound(0)
                    AddHandler OPC_T1_DELETE(i).ValueChanged, AddressOf OnT1_DELETE
                Next

                For rake = 0 To OPC_T8_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_T8_DELETE.GetUpperBound(1)
                        AddHandler OPC_T8_DELETE(rake, probe).ValueChanged, AddressOf OnT8_DELETE
                    Next
                Next

                For rake = 0 To OPC_T11_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_T11_DELETE.GetUpperBound(1)
                        AddHandler OPC_T11_DELETE(rake, probe).ValueChanged, AddressOf OnT11_DELETE
                    Next
                Next

                For i = 0 To OPC_P1dot2_DELETE.GetUpperBound(0)
                    AddHandler OPC_P1dot2_DELETE(i).ValueChanged, AddressOf OnP1dot2_DELETE
                Next

                For rake = 0 To OPC_P8_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_P8_DELETE.GetUpperBound(1)
                        AddHandler OPC_P8_DELETE(rake, probe).ValueChanged, AddressOf OnP8_DELETE
                    Next
                Next

                For rake = 0 To OPC_P11_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_P11_DELETE.GetUpperBound(1)
                        AddHandler OPC_P11_DELETE(rake, probe).ValueChanged, AddressOf OnP11_DELETE
                    Next
                Next

            Else

                For i = 0 To OPC_Tt1dot2_DELETE.GetUpperBound(0)
                    AddHandler OPC_Tt1dot2_DELETE(i).ValueChanged, AddressOf OnTt1dot2_DELETE
                Next

                For rake = 0 To OPC_Tt60_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_Tt60_DELETE.GetUpperBound(1)
                        AddHandler OPC_Tt60_DELETE(rake, probe).ValueChanged, AddressOf OnTt60_DELETE
                    Next
                Next

                For rake = 0 To OPC_T155_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_T155_DELETE.GetUpperBound(1)
                        AddHandler OPC_T155_DELETE(rake, probe).ValueChanged, AddressOf OnT155_DELETE
                    Next
                Next

                For i = 0 To OPC_Pt1dot2_DELETE.GetUpperBound(0)
                    AddHandler OPC_Pt1dot2_DELETE(i).ValueChanged, AddressOf OnPt1dot2_DELETE
                Next

                For rake = 0 To OPC_Pt60_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_Pt60_DELETE.GetUpperBound(1)
                        AddHandler OPC_Pt60_DELETE(rake, probe).ValueChanged, AddressOf OnPt60_DELETE
                    Next
                Next

                For rake = 0 To OPC_P155_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_P155_DELETE.GetUpperBound(1)
                        AddHandler OPC_P155_DELETE(rake, probe).ValueChanged, AddressOf OnP155_DELETE
                    Next
                Next

            End If

            TFE731_Helper.UpdateDeletableChannels(Me, CELProject.Project, selectedEngine)

        End Sub

        Private Sub CloseTFESession(selectedEngine As String)

            Dim engineCategory = Engines.GetEngineCategory(Engines.GetEngineFromDisplayName(selectedEngine))
            If engineCategory <> Category.Small AndAlso engineCategory <> Category.Big Then Return

            Dim i As Integer
            Dim rake As Integer
            Dim probe As Integer

            Init_Engine_Channels_Value() 'Reinit variables before we quit

            'Stops the Event Archiver (always on)
