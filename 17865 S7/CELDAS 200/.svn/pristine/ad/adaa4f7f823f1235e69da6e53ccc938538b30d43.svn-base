            'Return_Value.Add(Initialize_Channel(STOP_TIMER_CND_BUTTON, "STOP_TIMER_CND_BUTTON"))
            'Return_Value.Add(Initialize_Channel(ARM_TIMER_BUTTON, "ARM_TIMER_BUTTON"))
            'Return_Value.Add(Initialize_Channel(DEADBAND_TLA_VALUE, "DEADBAND_TLA_VALUE"))
            'Return_Value.Add(Initialize_Channel(TLA, "TLA"))
            '
            ''Tare parameters
            'InitializeTFEEnginesOffsetsChannels(engineCategory, Return_Value)
            'InitializeTFEEnginesOffsetsAsZero(engineCategory)
            '
            'Return_Value.Add(Initialize_Channel(ARCHIVE, "ARCHIVE"))
            'Return_Value.Add(Initialize_Channel(ARCHIVE_STOP, "ARCHIVE_STOP"))
            'Return_Value.Add(Initialize_Channel(ARCHIVE_PLAY, "ARCHIVE_PLAY"))
            'Return_Value.Add(Initialize_Channel(ARCHIVE_RECORD, "ARCHIVE_RECORD"))
            'Return_Value.Add(Initialize_Channel(EVENT_ARCHIVE, "EVENT_ARCHIVE"))
            'Return_Value.Add(Initialize_Channel(EVENT_ARCHIVE_RECORD, "EVENT_ARCHIVE_RECORD"))
            '
            '
            'Return_Value.Add(Initialize_Channel(LOW_FUEL_PRESSURE, "LOW_FUEL_PRESSURE"))
            'Return_Value.Add(Initialize_Channel(OPERATING_TIME, "OPERATING_TIME"))
            'Return_Value.Add(Initialize_Channel(ENGINE_TIME_RESET, "ENGINE_TIME_RESET"))
            'Return_Value.Add(Initialize_Channel(FUEL_USED_GM, "FUEL_USED_GM"))
            'Return_Value.Add(Initialize_Channel(FUEL_USED_RESET, "FUEL_USED_RESET"))
            'Return_Value.Add(Initialize_Channel(WF, "WF"))
            'Return_Value.Add(Initialize_Channel(WF_CAL, "WF_CAL"))
            'Return_Value.Add(Initialize_Channel(WF_RAW, "WF_RAW"))
            'Return_Value.Add(Initialize_Channel(FUEL_FLOW, "WF"))
            'Return_Value.Add(Initialize_Channel(OVERTEMP, "OVERTEMP"))
            'Return_Value.Add(Initialize_Channel(MOTORING, "MOTORING"))
            'Return_Value.Add(Initialize_Channel(FUEL_ARMING, "FUEL_ARMING"))
            'Return_Value.Add(Initialize_Channel(FUEL_PUMP, "FUEL_PUMP"))
            'Return_Value.Add(Initialize_Channel(ENGINE_AT_REST, "ENGINE_AT_REST"))
