            Return_Value.Add(Initialize_Channel(N1_RPM, "N1_RPM"))
            Return_Value.Add(Initialize_Channel(N2_RPM, "N2_RPM"))
            Return_Value.Add(Initialize_Channel(N1_OVERSPEED, "N1_OVERSPEED"))
            Return_Value.Add(Initialize_Channel(N2_OVERSPEED, "N2_OVERSPEED"))
            Return_Value.Add(Initialize_Channel(ESTOP, "ESTOP"))
            Return_Value.Add(Initialize_Channel(THRUST, "THRUST"))
            Return_Value.Add(Initialize_Channel(FUEL_FILTER_BYPASS, "FUEL_FILTER_BYPASS"))
            Return_Value.Add(Initialize_Channel(OIL_FILTER_BYPASS, "OIL_FILTER_BYPASS"))
            Return_Value.Add(Initialize_Channel(MOT_CHIP, "MOT_CHIP"))
            Return_Value.Add(Initialize_Channel(BUZZER, "BUZZER"))

            Throw New NotImplementedException("Uncomment all this if you need to use TFE731")
            'Uncomment all this if you need to use TFE731
            '-------------------------------------------

            'Return_Value.Add(Initialize_Channel(ShowAccelTimeWindow, "ShowAccelTimeWindow"))
            'Return_Value.Add(Initialize_Channel(CLOSE_ACCEL_CHECK_BUTTON, "CLOSE_ACCEL_CHECK_BUTTON"))
