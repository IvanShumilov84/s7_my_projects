    Public Class TFE731_Sequence
        Inherits EngineSequence

        Public Sub New()

        End Sub

        'THIS CLASS IS JUST A QUICK COPY/PASTE FROM 18942 METHODS, IT STILL REQUIRE MODIFICATIONS TO WORK
        'You may refer to the following classes
        'https://svn.cel-aerospace.ca/svn/repos/Project/08/08618 Vector/trunk/Prj08618_HMI_Critical/Engine_Sequence.vb
        'https://svn.cel-aerospace.ca/svn/repos/Project/08/08618 Vector/trunk/Prj08618_HMI_Performance/Engine_Sequence.vb
        'To run this class you will need to uncomment the lines follwing "Uncomment all this if you need to use TFE731"

        Private Sub InitializeTFEChannelsValues(selectedEngine As String)

            Dim engineCategory = Engines.GetEngineCategory(Engines.GetEngineFromDisplayName(selectedEngine))
            If engineCategory <> Category.Small AndAlso engineCategory <> Category.Big Then Return

            Dim rake As Integer
            Dim probe As Integer


            For index As Integer = 0 To OPC_Ps1dot2_DELETE.GetUpperBound(0)
                If Not (OPC_Ps1dot2_DELETE(index) Is Nothing) Then
                    OPC_Ps1dot2_DELETE(index).Value = KineticaRT.Values.Values.False
                End If
            Next
            If Not (Ps1dot2_COUNT Is Nothing) Then
                Ps1dot2_COUNT.Value = New KineticaRT.Values.Integer(OPC_Ps1dot2_DELETE.Length)
            End If


            If engineCategory = Category.Small Then

                For index As Integer = 0 To OPC_T1_DELETE.GetUpperBound(0)
                    If Not (OPC_T1_DELETE(index) Is Nothing) Then
                        OPC_T1_DELETE(index).Value = KineticaRT.Values.Values.False
                    End If
                Next
                If Not (T1_COUNT Is Nothing) Then
                    T1_COUNT.Value = New KineticaRT.Values.Integer(OPC_T1_DELETE.Length)
                End If

                For rake = 0 To OPC_T8_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_T8_DELETE.GetUpperBound(1)
                        If Not (OPC_T8_DELETE(rake, probe) Is Nothing) Then
                            OPC_T8_DELETE(rake, probe).Value = KineticaRT.Values.Values.False
                        End If
                    Next
                Next
                If Not (T8_COUNT Is Nothing) Then
                    T8_COUNT.Value = New KineticaRT.Values.Integer(OPC_T8_DELETE.Length)
                End If

                For rake = 0 To OPC_T11_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_T11_DELETE.GetUpperBound(1)
                        If Not (OPC_T11_DELETE(rake, probe) Is Nothing) Then
                            OPC_T11_DELETE(rake, probe).Value = KineticaRT.Values.Values.False
                        End If
                    Next
                Next
                If Not (T11_COUNT Is Nothing) Then
                    T11_COUNT.Value = New KineticaRT.Values.Integer(OPC_T11_DELETE.Length)
                End If

                For index As Integer = 0 To OPC_P1dot2_DELETE.GetUpperBound(0)
                    If Not (OPC_P1dot2_DELETE(index) Is Nothing) Then
                        OPC_P1dot2_DELETE(index).Value = KineticaRT.Values.Values.False
                    End If
                Next
                If Not (P1dot2_COUNT Is Nothing) Then
                    P1dot2_COUNT.Value = New KineticaRT.Values.Integer(OPC_P1dot2_DELETE.Length)
                End If

                For rake = 0 To OPC_P11_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_P11_DELETE.GetUpperBound(1)
                        If Not (OPC_P11_DELETE(rake, probe) Is Nothing) Then
                            OPC_P11_DELETE(rake, probe).Value = KineticaRT.Values.Values.False
                        End If
                    Next
                Next
                If Not (P11_COUNT Is Nothing) Then
                    P11_COUNT.Value = New KineticaRT.Values.Integer(OPC_P11_DELETE.Length)
                End If

                For rake = 0 To OPC_P8_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_P8_DELETE.GetUpperBound(1)
                        If Not (OPC_P8_DELETE(rake, probe) Is Nothing) Then
                            OPC_P8_DELETE(rake, probe).Value = KineticaRT.Values.Values.False
                        End If
                    Next
                Next
                If Not (P8_COUNT Is Nothing) Then
                    P8_COUNT.Value = New KineticaRT.Values.Integer(OPC_P8_DELETE.Length)
                End If

            ElseIf engineCategory = Category.Big Then

                For index As Integer = 0 To OPC_Tt1dot2_DELETE.GetUpperBound(0)
                    If Not (OPC_Tt1dot2_DELETE(index) Is Nothing) Then
                        OPC_Tt1dot2_DELETE(index).Value = KineticaRT.Values.Values.False
                    End If
                Next
                If Not (Tt1dot2_COUNT Is Nothing) Then
                    Tt1dot2_COUNT.Value = New KineticaRT.Values.Integer(OPC_Tt1dot2_DELETE.Length)
                End If

                For rake = 0 To OPC_Tt60_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_Tt60_DELETE.GetUpperBound(1)
                        If Not (OPC_Tt60_DELETE(rake, probe) Is Nothing) Then
                            OPC_Tt60_DELETE(rake, probe).Value = KineticaRT.Values.Values.False
                        End If
                    Next
                Next
                If Not (Tt60_COUNT Is Nothing) Then
                    Tt60_COUNT.Value = New KineticaRT.Values.Integer(OPC_Tt60_DELETE.Length)
                End If

                For rake = 0 To OPC_T155_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_T155_DELETE.GetUpperBound(1)
                        If Not (OPC_T155_DELETE(rake, probe) Is Nothing) Then
                            OPC_T155_DELETE(rake, probe).Value = KineticaRT.Values.Values.False
                        End If
                    Next
                Next
                If Not (T155_COUNT Is Nothing) Then
                    T155_COUNT.Value = New KineticaRT.Values.Integer(OPC_T155_DELETE.Length)
                End If

                For index As Integer = 0 To OPC_Pt1dot2_DELETE.GetUpperBound(0)
                    If Not (OPC_Pt1dot2_DELETE(index) Is Nothing) Then
                        OPC_Pt1dot2_DELETE(index).Value = KineticaRT.Values.Values.False
                    End If
                Next
                If Not (Pt1dot2_COUNT Is Nothing) Then
                    Pt1dot2_COUNT.Value = New KineticaRT.Values.Integer(OPC_Pt1dot2_DELETE.Length)
                End If

                For rake = 0 To OPC_P155_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_P155_DELETE.GetUpperBound(1)
                        If Not (OPC_P155_DELETE(rake, probe) Is Nothing) Then
                            OPC_P155_DELETE(rake, probe).Value = KineticaRT.Values.Values.False
                        End If
                    Next
                Next
                If Not (P155_COUNT Is Nothing) Then
                    P155_COUNT.Value = New KineticaRT.Values.Integer(OPC_P155_DELETE.Length)
                End If

                For rake = 0 To OPC_Pt60_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_Pt60_DELETE.GetUpperBound(1)
                        If Not (OPC_Pt60_DELETE(rake, probe) Is Nothing) Then
                            OPC_Pt60_DELETE(rake, probe).Value = KineticaRT.Values.Values.False
                        End If
                    Next
                Next
                If Not (Pt60_COUNT Is Nothing) Then
                    Pt60_COUNT.Value = New KineticaRT.Values.Integer(OPC_Pt60_DELETE.Length)
                End If

            End If

            TFE731_Helper.UpdateDeletableChannels(Me, CELProject.Project, selectedEngine)

            If Not (STARTER_BTN Is Nothing) Then
                STARTER_BTN.Value = KineticaRT.Values.Values.False
            End If

            If Not (IGNITION_AUTO Is Nothing) Then
                IGNITION_AUTO.Value = KineticaRT.Values.Values.True
            End If

            If Not (IGNITERS Is Nothing) Then
                IGNITERS.Value = KineticaRT.Values.Values.False
            End If

            If Not (VIB_AIR_TFE Is Nothing) Then
                VIB_AIR_TFE.Value = KineticaRT.Values.Values.True 'Vib air cooling
            End If

            If Not (EEC_POWER_ON Is Nothing) Then
                EEC_POWER_ON.Value = KineticaRT.Values.Values.True 'EEC Box power
            End If

            If Not (EEC_VIB_CONFIG Is Nothing) Then
                EEC_VIB_CONFIG.Value = KineticaRT.Values.Values.True 'Vib config
            End If

            If Not (DRIVE_ON Is Nothing) Then
                DRIVE_ON.Value = KineticaRT.Values.Values.True 'DOUT197 tpo reset the drive must be default true for TFE
            End If

        End Sub

        Private Sub ExecuteTFEEmergencyStop(selectedEngine As String)

            Dim engineCategory = Engines.GetEngineCategory(Engines.GetEngineFromDisplayName(selectedEngine))
            If engineCategory <> Category.Small AndAlso engineCategory <> Category.Big Then Return


            FUEL_PUMP.Value = KineticaRT.Values.Values.False            ' Turn the fuel pump off
            FUEL_ARMING.Value = KineticaRT.Values.Values.False          ' Fuel E-Stop Shuttoff S.V. (Strongback)
            IGNITERS.Value = KineticaRT.Values.Values.False             ' Manual Igniters
            IGNITION_AUTO.Value = KineticaRT.Values.Values.False        ' Auto Ignitiers
            IGNITERS.Value = KineticaRT.Values.Values.False             ' Ignitiers
            STARTER_BTN.Value = KineticaRT.Values.Values.False          ' Disable starter
        End Sub

        Private Sub ExecuteTFENormalShutdown(selectedEngine As String)

            Dim engineCategory = Engines.GetEngineCategory(Engines.GetEngineFromDisplayName(selectedEngine))
            If engineCategory <> Category.Small AndAlso engineCategory <> Category.Big Then Return

            EEC_START.Value = KineticaRT.Values.Values.False
            FUEL_PUMP.Value = KineticaRT.Values.Values.False
            IGNITERS.Value = KineticaRT.Values.Values.False

        End Sub

        Private Sub TareTFE731Engines(selectedEngine As String, newVal As KineticaRT.Values.Boolean)

            Dim engineCategory = Engines.GetEngineCategory(Engines.GetEngineFromDisplayName(selectedEngine))
            If engineCategory <> Category.Small AndAlso engineCategory <> Category.Big Then Return

            If (newVal Is KineticaRT.Values.Values.True) Then
                InitializeTFEEnginesOffsets(engineCategory)
            Else
                InitializeTFEEnginesOffsetsAsZero(engineCategory)
            End If

        End Sub

        Private Sub InitializeTFEEnginesOffsets(engineCategory As Category)

            If engineCategory <> Category.Small AndAlso engineCategory <> Category.Big Then Return

            OPC_THRUST_OFFSET.Value = THRUST.Value
            OPC_POSCF2_OFFSET.Value = POSCF2.Value
            OPC_POTGB_OFFSET.Value = POTGB.Value
            OPC_POAGB_OFFSET.Value = POAGB.Value.Subtract(PSN.Value)
            OPC_POSREG_OFFSET.Value = POSREG.Value

            OPC_Ps1dot2_1_OFFSET.Value = Ps1dot2_1.Value.Subtract(PSN.Value)
            OPC_Ps1dot2_2_OFFSET.Value = Ps1dot2_2.Value.Subtract(PSN.Value)
            OPC_Ps1dot2_3_OFFSET.Value = Ps1dot2_3.Value.Subtract(PSN.Value)
            OPC_Ps1dot2_4_OFFSET.Value = Ps1dot2_4.Value.Subtract(PSN.Value)
            OPC_Ps1dot2_5_OFFSET.Value = Ps1dot2_5.Value.Subtract(PSN.Value)
            OPC_Ps1dot2_6_OFFSET.Value = Ps1dot2_6.Value.Subtract(PSN.Value)


            InitializeSmallTFEEnginesOffsets(engineCategory)
            InitializeBigTFEEnginesOffsets(engineCategory)

        End Sub

        Private Sub InitializeTFEEnginesOffsetsAsZero(engineCategory As Category)

            If engineCategory <> Category.Small AndAlso engineCategory <> Category.Big Then Return

            OPC_THRUST_OFFSET.Value = New KineticaRT.Values.Double(0.0)
            OPC_POSCF2_OFFSET.Value = New KineticaRT.Values.Double(0.0)
            OPC_POTGB_OFFSET.Value = New KineticaRT.Values.Double(0.0)
            OPC_POAGB_OFFSET.Value = New KineticaRT.Values.Double(0.0)
            OPC_POSREG_OFFSET.Value = New KineticaRT.Values.Double(0.0)

            OPC_Ps1dot2_1_OFFSET.Value = New KineticaRT.Values.Double(0.0)
            OPC_Ps1dot2_2_OFFSET.Value = New KineticaRT.Values.Double(0.0)
            OPC_Ps1dot2_3_OFFSET.Value = New KineticaRT.Values.Double(0.0)
            OPC_Ps1dot2_4_OFFSET.Value = New KineticaRT.Values.Double(0.0)
            OPC_Ps1dot2_5_OFFSET.Value = New KineticaRT.Values.Double(0.0)
            OPC_Ps1dot2_6_OFFSET.Value = New KineticaRT.Values.Double(0.0)


            InitializeSmallTFEEnginesOffsetsAsZero(engineCategory)
            InitializeBigTFEEnginesOffsetsAsZero(engineCategory)

        End Sub

