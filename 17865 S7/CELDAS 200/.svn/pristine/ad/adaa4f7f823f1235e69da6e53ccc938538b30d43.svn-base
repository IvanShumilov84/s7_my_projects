        Private Sub InitializeBigTFEEnginesOffsets(engineCategory As Category)

            If engineCategory <> Category.Big Then Return

            OPC_Pt30_OFFSET.Value = Pt30.Value.Subtract(PSN.Value)
            OPC_Ps245_OFFSET.Value = Ps245.Value.Subtract(PSN.Value)

            OPC_Pt1dot2_1_OFFSET.Value = Pt1dot2_1.Value.Subtract(PSN.Value)
            OPC_Pt1dot2_2_OFFSET.Value = Pt1dot2_2.Value.Subtract(PSN.Value)
            OPC_Pt1dot2_3_OFFSET.Value = Pt1dot2_3.Value.Subtract(PSN.Value)
            OPC_Pt1dot2_4_OFFSET.Value = Pt1dot2_4.Value.Subtract(PSN.Value)
            OPC_Pt1dot2_5_OFFSET.Value = Pt1dot2_5.Value.Subtract(PSN.Value)
            OPC_Pt1dot2_6_OFFSET.Value = Pt1dot2_6.Value.Subtract(PSN.Value)
            OPC_Pt1dot2_7_OFFSET.Value = Pt1dot2_7.Value.Subtract(PSN.Value)
            OPC_Pt1dot2_8_OFFSET.Value = Pt1dot2_8.Value.Subtract(PSN.Value)

            OPC_Ps1dot2_7_OFFSET.Value = Ps1dot2_7.Value.Subtract(PSN.Value)
