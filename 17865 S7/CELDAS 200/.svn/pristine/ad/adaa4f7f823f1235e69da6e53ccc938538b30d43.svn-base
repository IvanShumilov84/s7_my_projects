                Case "TFE731-5BR-1H"
                    Return Engine.TFE7315BR1H
                Case "TFE731-20R-1B"
                    Return Engine.TFE73120R1B
                Case "TFE731-20AR-1B"
                    Return Engine.TFE73120AR1B
                Case "TFE731-20BR-1B"
