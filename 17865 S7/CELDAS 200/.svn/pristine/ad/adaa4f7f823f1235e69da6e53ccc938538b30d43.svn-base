            'Return_Value.Add(Initialize_Channel(IGNITERS_RESET, "IGNITERS_RESET"))
            'Return_Value.Add(Initialize_Channel(MAIN_RESET, "MAIN_RESET"))

            Return_Value.Add(Initialize_Channel(OPC_N2_ABOVE_GI, "OPC_N2_ABOVE_GI"))

            Return_Value.Add(Initialize_Channel(IGNITION_AUTO, "IGNITION_AUTO"))
            Return_Value.Add(Initialize_Channel(IGNITERS, "IGNITERS"))
            Return_Value.Add(Initialize_Channel(SG_READ, "SG_READ"))

            Return_Value.Add(Initialize_Channel(TARE, "TARE"))
            Return_Value.Add(Initialize_Channel(PSN, "PSN"))


            Return_Value.Add(Initialize_Channel(STARTER_BTN, "STARTER_BTN"))

            Return_Value.Add(Initialize_Channel(POSCF2, "POSCF2"))
            Return_Value.Add(Initialize_Channel(POTGB, "POTGB"))
            Return_Value.Add(Initialize_Channel(POAGB, "POAGB"))
            Return_Value.Add(Initialize_Channel(POSREG, "POSREG"))

            If engineCategory = Category.Small Then
                OPC_Ps1dot2_DELETE = New KineticaRT.Servers.OpcClient.BooleanItem(5) {}
            Else
                OPC_Ps1dot2_DELETE = New KineticaRT.Servers.OpcClient.BooleanItem(7) {}
            End If

            Return_Value.Add(Initialize_Channel(Ps1dot2_1, "PS1DOT2_1"))
            Return_Value.Add(Initialize_Channel(Ps1dot2_2, "PS1DOT2_2"))
            Return_Value.Add(Initialize_Channel(Ps1dot2_3, "PS1DOT2_3"))
            Return_Value.Add(Initialize_Channel(Ps1dot2_4, "PS1DOT2_4"))
            Return_Value.Add(Initialize_Channel(Ps1dot2_5, "PS1DOT2_5"))
            Return_Value.Add(Initialize_Channel(Ps1dot2_6, "PS1DOT2_6"))
            Return_Value.Add(Initialize_Channel(Ps1dot2_AVG, "PS1DOT2_AVG"))
            Return_Value.Add(Initialize_Channel(Ps1dot2_MAX, "PS1DOT2_MAX"))
            Return_Value.Add(Initialize_Channel(Ps1dot2_MIN, "PS1DOT2_MIN"))
            Return_Value.Add(Initialize_Channel(Ps1dot2_COUNT, "PS1DOT2_COUNT"))
            For i = 0 To OPC_Ps1dot2_DELETE.GetUpperBound(0)
                Return_Value.Add(Initialize_Channel(OPC_Ps1dot2_DELETE(i), "OPC_PS1DOT2_" + (i + 1).ToString() + "_DELETE"))
            Next

            Return_Value.Add(Initialize_Channel(DRIVE_ON, "DRIVE_ON"))

            InitializeTFESmallEngineChannels(Return_Value, engineCategory)
            InitializeTFEBigEngineChannels(Return_Value, engineCategory)

        End Sub

        Private Sub InitializeTFESmallEngineChannels(ByRef return_Value As ArrayList, ByVal selectedEngine As String)

            If String.IsNullOrWhiteSpace(selectedEngine) Then Return

            Dim engine = Engines.GetEngineFromDisplayName(selectedEngine)
            Dim engineCategory = Engines.GetEngineCategory(engine)
            If engineCategory <> Category.Small Then Return


            Dim i As Integer
            Dim rake As Integer
            Dim probe As Integer

            return_Value.Add(Initialize_Channel(T1_AVG, "T1_AVG"))
            return_Value.Add(Initialize_Channel(T1_MAX, "T1_MAX"))
            return_Value.Add(Initialize_Channel(T1_MIN, "T1_MIN"))
            return_Value.Add(Initialize_Channel(T1_COUNT, "T1_COUNT"))

            For i = 0 To OPC_T1_DELETE.GetUpperBound(0)
                return_Value.Add(Initialize_Channel(OPC_T1_DELETE(i), "OPC_T1_" + (i + 1).ToString() + "_DELETE"))
            Next

            return_Value.Add(Initialize_Channel(T5, "T45_DISPLAY"))

            return_Value.Add(Initialize_Channel(P3, "P3_DISPLAY"))
            return_Value.Add(Initialize_Channel(P7, "P7_DISPLAY"))
            return_Value.Add(Initialize_Channel(PFPI, "PFPI"))
            return_Value.Add(Initialize_Channel(T3, "T3_DISPLAY"))
            return_Value.Add(Initialize_Channel(Ps235, "PS235"))
            return_Value.Add(Initialize_Channel(Ts235, "TS235"))
            return_Value.Add(Initialize_Channel(P1dot2_1, "P1DOT2_1"))
            return_Value.Add(Initialize_Channel(P1dot2_2, "P1DOT2_2"))
            return_Value.Add(Initialize_Channel(P1dot2_3, "P1DOT2_3"))
            return_Value.Add(Initialize_Channel(P1dot2_4, "P1DOT2_4"))
            return_Value.Add(Initialize_Channel(P1dot2_5, "P1DOT2_5"))
            return_Value.Add(Initialize_Channel(P1dot2_6, "P1DOT2_6"))
            return_Value.Add(Initialize_Channel(P1dot2_AVG, "P1DOT2_AVG"))
            return_Value.Add(Initialize_Channel(P1dot2_MAX, "P1DOT2_MAX"))
            return_Value.Add(Initialize_Channel(P1dot2_MIN, "P1DOT2_MIN"))
            return_Value.Add(Initialize_Channel(P1dot2_COUNT, "P1DOT2_COUNT"))

            For i = 0 To OPC_P1dot2_DELETE.GetUpperBound(0)
                return_Value.Add(Initialize_Channel(OPC_P1dot2_DELETE(i), "OPC_P1DOT2_" + (i + 1).ToString() + "_DELETE"))
            Next

            return_Value.Add(Initialize_Channel(P8_1_1, "P8_1_1"))
            return_Value.Add(Initialize_Channel(P8_1_2, "P8_1_2"))
            return_Value.Add(Initialize_Channel(P8_1_3, "P8_1_3"))
            return_Value.Add(Initialize_Channel(P8_1_4, "P8_1_4"))
            return_Value.Add(Initialize_Channel(P8_1_5, "P8_1_5"))
            return_Value.Add(Initialize_Channel(P8_2_1, "P8_2_1"))
            return_Value.Add(Initialize_Channel(P8_2_2, "P8_2_2"))
            return_Value.Add(Initialize_Channel(P8_2_3, "P8_2_3"))
            return_Value.Add(Initialize_Channel(P8_2_4, "P8_2_4"))
            return_Value.Add(Initialize_Channel(P8_2_5, "P8_2_5"))
            return_Value.Add(Initialize_Channel(P8_3_1, "P8_3_1"))
            return_Value.Add(Initialize_Channel(P8_3_2, "P8_3_2"))
            return_Value.Add(Initialize_Channel(P8_3_3, "P8_3_3"))
            return_Value.Add(Initialize_Channel(P8_3_4, "P8_3_4"))
            return_Value.Add(Initialize_Channel(P8_3_5, "P8_3_5"))
            return_Value.Add(Initialize_Channel(P8_4_1, "P8_4_1"))
            return_Value.Add(Initialize_Channel(P8_4_2, "P8_4_2"))
            return_Value.Add(Initialize_Channel(P8_4_3, "P8_4_3"))
            return_Value.Add(Initialize_Channel(P8_4_4, "P8_4_4"))
            return_Value.Add(Initialize_Channel(P8_4_5, "P8_4_5"))
            return_Value.Add(Initialize_Channel(P8_5_1, "P8_5_1"))
            return_Value.Add(Initialize_Channel(P8_5_2, "P8_5_2"))
            return_Value.Add(Initialize_Channel(P8_5_3, "P8_5_3"))
            return_Value.Add(Initialize_Channel(P8_5_4, "P8_5_4"))
            return_Value.Add(Initialize_Channel(P8_5_5, "P8_5_5"))
            return_Value.Add(Initialize_Channel(P8_AVG, "P8_AVG"))
            return_Value.Add(Initialize_Channel(P8_MAX, "P8_MAX"))
            return_Value.Add(Initialize_Channel(P8_MIN, "P8_MIN"))
            return_Value.Add(Initialize_Channel(P8_COUNT, "P8_COUNT"))

            For rake = 0 To OPC_P8_DELETE.GetUpperBound(0)
                For probe = 0 To OPC_P8_DELETE.GetUpperBound(1)
                    return_Value.Add(Initialize_Channel(OPC_P8_DELETE(rake, probe), "OPC_P8_" + (rake + 1).ToString() + "_" + (probe + 1).ToString() + "_DELETE"))
                Next
            Next


            return_Value.Add(Initialize_Channel(T8_AVG, "T8_AVG"))
            return_Value.Add(Initialize_Channel(T8_MAX, "T8_MAX"))
            return_Value.Add(Initialize_Channel(T8_MIN, "T8_MIN"))
            return_Value.Add(Initialize_Channel(T8_COUNT, "T8_COUNT"))

            For rake = 0 To OPC_T8_DELETE.GetUpperBound(0)
                For probe = 0 To OPC_T8_DELETE.GetUpperBound(1)
                    return_Value.Add(Initialize_Channel(OPC_T8_DELETE(rake, probe), "OPC_T8_" + (rake + 1).ToString() + "_" + (probe + 1).ToString() + "_DELETE"))
                Next
            Next

            return_Value.Add(Initialize_Channel(P11_1_1, "P11_1_1"))
            return_Value.Add(Initialize_Channel(P11_1_2, "P11_1_2"))
            return_Value.Add(Initialize_Channel(P11_1_3, "P11_1_3"))
            return_Value.Add(Initialize_Channel(P11_1_4, "P11_1_4"))
            return_Value.Add(Initialize_Channel(P11_1_5, "P11_1_5"))
            return_Value.Add(Initialize_Channel(P11_1_6, "P11_1_6"))
            return_Value.Add(Initialize_Channel(P11_2_1, "P11_2_1"))
            return_Value.Add(Initialize_Channel(P11_2_2, "P11_2_2"))
            return_Value.Add(Initialize_Channel(P11_2_3, "P11_2_3"))
            return_Value.Add(Initialize_Channel(P11_2_4, "P11_2_4"))
            return_Value.Add(Initialize_Channel(P11_2_5, "P11_2_5"))
            return_Value.Add(Initialize_Channel(P11_2_6, "P11_2_6"))
            return_Value.Add(Initialize_Channel(P11_3_1, "P11_3_1"))
            return_Value.Add(Initialize_Channel(P11_3_2, "P11_3_2"))
            return_Value.Add(Initialize_Channel(P11_3_3, "P11_3_3"))
            return_Value.Add(Initialize_Channel(P11_3_4, "P11_3_4"))
            return_Value.Add(Initialize_Channel(P11_3_5, "P11_3_5"))
            return_Value.Add(Initialize_Channel(P11_3_6, "P11_3_6"))
            return_Value.Add(Initialize_Channel(P11_4_1, "P11_4_1"))
            return_Value.Add(Initialize_Channel(P11_4_2, "P11_4_2"))
            return_Value.Add(Initialize_Channel(P11_4_3, "P11_4_3"))
            return_Value.Add(Initialize_Channel(P11_4_4, "P11_4_4"))
            return_Value.Add(Initialize_Channel(P11_4_5, "P11_4_5"))
            return_Value.Add(Initialize_Channel(P11_4_6, "P11_4_6"))
            return_Value.Add(Initialize_Channel(P11_AVG, "P11_AVG"))
            return_Value.Add(Initialize_Channel(P11_MAX, "P11_MAX"))
            return_Value.Add(Initialize_Channel(P11_MIN, "P11_MIN"))
            return_Value.Add(Initialize_Channel(P11_COUNT, "P11_COUNT"))

            For rake = 0 To OPC_P11_DELETE.GetUpperBound(0)
                For probe = 0 To OPC_P11_DELETE.GetUpperBound(1)
                    return_Value.Add(Initialize_Channel(OPC_P11_DELETE(rake, probe), "OPC_P11_" + (rake + 1).ToString() + "_" + (probe + 1).ToString() + "_DELETE"))
                Next
            Next

            return_Value.Add(Initialize_Channel(T11_AVG, "T11_AVG"))
            return_Value.Add(Initialize_Channel(T11_MAX, "T11_MAX"))
            return_Value.Add(Initialize_Channel(T11_MIN, "T11_MIN"))
            return_Value.Add(Initialize_Channel(T11_COUNT, "T11_COUNT"))

            For rake = 0 To OPC_T11_DELETE.GetUpperBound(0)
                For probe = 0 To OPC_T11_DELETE.GetUpperBound(1)
                    return_Value.Add(Initialize_Channel(OPC_T11_DELETE(rake, probe), "OPC_T11_" + (rake + 1).ToString() + "_" + (probe + 1).ToString() + "_DELETE"))
                Next
            Next

            ' **************
            ' Initialize EEC
            ' **************
            return_Value.Add(Initialize_Channel(EEC_VIB_CONFIG, "EEC_VIB_CONFIG"))
            return_Value.Add(Initialize_Channel(EEC_P2T2_HEATER, "EEC_P2T2_HEATER"))
            return_Value.Add(Initialize_Channel(EEC_CONTROL, "EEC_CONTROL"))

            return_Value.Add(Initialize_Channel(EEC_CONFIG_ID1, "EEC_CONFIG_ID1"))
            return_Value.Add(Initialize_Channel(EEC_CONFIG_ID2, "EEC_CONFIG_ID2"))
            return_Value.Add(Initialize_Channel(EEC_CONFIG_ID3, "EEC_CONFIG_ID3"))
            return_Value.Add(Initialize_Channel(EEC_CONFIG_ID4, "EEC_CONFIG_ID4"))
            return_Value.Add(Initialize_Channel(EEC_CONFIG_ID5, "EEC_CONFIG_ID5"))

            Select Case engine

                Case engine.TFE7313C3B, engine.TFE7313C3B1, engine.TFE7313A2B, engine.TFE7313A2B1, engine.TFE7313DR1H
                    return_Value.Add(Initialize_Channel(EEC_RSTR_PERF_FUEL_ENRCH, "EEC_RSTR_PERF_FUEL_ENRCH"))

                Case engine.TFE73131F
                    return_Value.Add(Initialize_Channel(EEC_RSTR_PERF_FUEL_ENRCH, "EEC_RSTR_PERF_FUEL_ENRCH"))

                Case engine.TFE7312C3B, engine.TFE73123B
                    return_Value.Add(Initialize_Channel(EEC_MM_SELECT, "EEC_MM_SELECT"))
                    return_Value.Add(Initialize_Channel(EEC_COCKPIT_START_SW, "EEC_COCKPIT_START_SW"))

                Case engine.TFE7314R2S
                    return_Value.Add(Initialize_Channel(EEC_GND_IDLE_OVERRIDE, "EEC_GND_IDLE_OVERRIDE"))
                    return_Value.Add(Initialize_Channel(EEC_MM_SELECT, "EEC_MM_SELECT"))

                Case engine.TFE7315AR2C, engine.TFE7315BR2C
                    return_Value.Add(Initialize_Channel(EEC_GND_IDLE_OVERRIDE, "EEC_GND_IDLE_OVERRIDE"))
                    return_Value.Add(Initialize_Channel(EEC_MM_SELECT, "EEC_MM_SELECT"))

                Case engine.TFE7315AR1C, engine.TFE7315BR1C
                    return_Value.Add(Initialize_Channel(EEC_RSTR_PERF_FUEL_ENRCH, "EEC_RSTR_PERF_FUEL_ENRCH"))
                    return_Value.Add(Initialize_Channel(EEC_GND_IDLE_OVERRIDE, "EEC_GND_IDLE_OVERRIDE"))
                    return_Value.Add(Initialize_Channel(EEC_MM_SELECT, "EEC_MM_SELECT"))

                Case engine.TFE73151J
                    return_Value.Add(Initialize_Channel(EEC_RSTR_PERF_FUEL_ENRCH, "EEC_RSTR_PERF_FUEL_ENRCH"))
                    return_Value.Add(Initialize_Channel(EEC_MM_SELECT, "EEC_MM_SELECT"))
                    return_Value.Add(Initialize_Channel(EEC_WOW, "EEC_WOW"))

                Case engine.TFE73122J, engine.TFE73131J, engine.TFE7313DR1G
                    return_Value.Add(Initialize_Channel(EEC_RSTR_PERF_FUEL_ENRCH, "EEC_RSTR_PERF_FUEL_ENRCH"))

                Case engine.TFE73131E, engine.TFE73131G, engine.TFE7313D1G, engine.TFE7313D1K, engine.TFE73131K, engine.TFE7313R1G
                    return_Value.Add(Initialize_Channel(EEC_RSTR_PERF_FUEL_ENRCH, "EEC_RSTR_PERF_FUEL_ENRCH"))

                Case engine.TFE7313DR1D, engine.TFE7313R1D, engine.TFE7313C200G, engine.TFE7313CR200G, engine.TFE7313A200G, engine.TFE7313AR200G
                    return_Value.Add(Initialize_Channel(EEC_RSTR_PERF_FUEL_ENRCH, "EEC_RSTR_PERF_FUEL_ENRCH"))

                Case engine.TFE73131C
                    return_Value.Add(Initialize_Channel(EEC_RSTR_PERF_FUEL_ENRCH, "EEC_RSTR_PERF_FUEL_ENRCH"))

                Case engine.TFE73121C, engine.TFE7312C2B, engine.TFE7312C1C, engine.TFE73122B, engine.TFE7313D1C, engine.TFE73141C
                    return_Value.Add(Initialize_Channel(EEC_RSTR_PERF_FUEL_ENRCH, "EEC_RSTR_PERF_FUEL_ENRCH"))

                Case engine.TFE73131H, engine.TFE7313R1H, engine.TFE7313CR100S, engine.TFE7313C100S, engine.TFE7313B100S, engine.TFE7313D1H
                    return_Value.Add(Initialize_Channel(EEC_RSTR_PERF_FUEL_ENRCH, "EEC_RSTR_PERF_FUEL_ENRCH"))

                Case engine.TFE7313BR100S
                    return_Value.Add(Initialize_Channel(EEC_RSTR_PERF_FUEL_ENRCH, "EEC_RSTR_PERF_FUEL_ENRCH"))

                Case engine.TFE7315R1H, engine.TFE7315BR1H
                    return_Value.Add(Initialize_Channel(EEC_RSTR_PERF_FUEL_ENRCH, "EEC_RSTR_PERF_FUEL_ENRCH"))
                    return_Value.Add(Initialize_Channel(EEC_GND_IDLE_OVERRIDE, "EEC_GND_IDLE_OVERRIDE"))
                    return_Value.Add(Initialize_Channel(EEC_MM_SELECT, "EEC_MM_SELECT"))
                    return_Value.Add(Initialize_Channel(EEC_FIRE_TEST1, "EEC_FIRE_TEST1"))
                    return_Value.Add(Initialize_Channel(EEC_FIRE_TEST2, "EEC_FIRE_TEST2"))

                Case engine.TFE7313CR3B, engine.TFE7313CR3B1, engine.TFE7313CR3B2, engine.TFE7313AR2B, engine.TFE7313AR2B1, engine.TFE7313AR2B2, engine.TFE7313AR3B, engine.TFE7313AR3B1, engine.TFE7313AR3B2
                    return_Value.Add(Initialize_Channel(EEC_RSTR_PERF_FUEL_ENRCH, "EEC_RSTR_PERF_FUEL_ENRCH"))

            End Select

        End Sub

        Private Sub InitializeTFEBigEngineChannels(ByRef return_Value As ArrayList, ByVal selectedEngine As String)

            If String.IsNullOrWhiteSpace(selectedEngine) Then Return
            Dim engine = Engines.GetEngineFromDisplayName(selectedEngine)
            Dim engineCategory = Engines.GetEngineCategory(engine)
            If engineCategory <> Category.Big Then Return

            Dim i As Integer
            Dim rake As Integer
            Dim probe As Integer

            return_Value.Add(Initialize_Channel(EEC_IGNITION_RELAY, "EEC_IGNITION_RELAY"))

            return_Value.Add(Initialize_Channel(Tt1dot2_AVG, "TT1DOT2_AVG"))
            return_Value.Add(Initialize_Channel(Tt1dot2_MAX, "TT1DOT2_MAX"))
            return_Value.Add(Initialize_Channel(Tt1dot2_MIN, "TT1DOT2_MIN"))
            return_Value.Add(Initialize_Channel(Tt1dot2_COUNT, "TT1DOT2_COUNT"))

            For i = 0 To OPC_Tt1dot2_DELETE.GetUpperBound(0)
                return_Value.Add(Initialize_Channel(OPC_Tt1dot2_DELETE(i), "OPC_TT1DOT2_" + (i + 1).ToString() + "_DELETE"))
            Next

            return_Value.Add(Initialize_Channel(T45, "T45_DISPLAY"))
            return_Value.Add(Initialize_Channel(Pt30, "P3_DISPLAY"))
            return_Value.Add(Initialize_Channel(Tt30, "T3_DISPLAY"))
            return_Value.Add(Initialize_Channel(Ps245, "PS245"))
            return_Value.Add(Initialize_Channel(Tt245, "TT245"))

            return_Value.Add(Initialize_Channel(Pt1dot2_1, "PT1DOT2_1"))
            return_Value.Add(Initialize_Channel(Pt1dot2_2, "PT1DOT2_2"))
            return_Value.Add(Initialize_Channel(Pt1dot2_3, "PT1DOT2_3"))
            return_Value.Add(Initialize_Channel(Pt1dot2_4, "PT1DOT2_4"))
            return_Value.Add(Initialize_Channel(Pt1dot2_5, "PT1DOT2_5"))
            return_Value.Add(Initialize_Channel(Pt1dot2_6, "PT1DOT2_6"))
            return_Value.Add(Initialize_Channel(Pt1dot2_7, "PT1DOT2_7"))
            return_Value.Add(Initialize_Channel(Pt1dot2_8, "PT1DOT2_8"))
            return_Value.Add(Initialize_Channel(Pt1dot2_AVG, "PT1DOT2_AVG"))
            return_Value.Add(Initialize_Channel(Pt1dot2_MAX, "PT1DOT2_MAX"))
            return_Value.Add(Initialize_Channel(Pt1dot2_MIN, "PT1DOT2_MIN"))
            return_Value.Add(Initialize_Channel(Pt1dot2_COUNT, "PT1DOT2_COUNT"))

            For i = 0 To OPC_Pt1dot2_DELETE.GetUpperBound(0)
                return_Value.Add(Initialize_Channel(OPC_Pt1dot2_DELETE(i), "OPC_PT1DOT2_" + (i + 1).ToString() + "_DELETE"))
            Next

            return_Value.Add(Initialize_Channel(Ps1dot2_7, "PS1DOT2_7"))
            return_Value.Add(Initialize_Channel(Ps1dot2_8, "PS1DOT2_8"))

            return_Value.Add(Initialize_Channel(Pt60_1_1, "PT60_1_1"))
            return_Value.Add(Initialize_Channel(Pt60_1_2, "PT60_1_2"))
            return_Value.Add(Initialize_Channel(Pt60_1_3, "PT60_1_3"))
            return_Value.Add(Initialize_Channel(Pt60_1_4, "PT60_1_4"))
            return_Value.Add(Initialize_Channel(Pt60_1_5, "PT60_1_5"))
            return_Value.Add(Initialize_Channel(Pt60_2_1, "PT60_2_1"))
            return_Value.Add(Initialize_Channel(Pt60_2_2, "PT60_2_2"))
            return_Value.Add(Initialize_Channel(Pt60_2_3, "PT60_2_3"))
            return_Value.Add(Initialize_Channel(Pt60_2_4, "PT60_2_4"))
            return_Value.Add(Initialize_Channel(Pt60_2_5, "PT60_2_5"))
            return_Value.Add(Initialize_Channel(Pt60_3_1, "PT60_3_1"))
            return_Value.Add(Initialize_Channel(Pt60_3_2, "PT60_3_2"))
            return_Value.Add(Initialize_Channel(Pt60_3_3, "PT60_3_3"))
            return_Value.Add(Initialize_Channel(Pt60_3_4, "PT60_3_4"))
            return_Value.Add(Initialize_Channel(Pt60_3_5, "PT60_3_5"))
            return_Value.Add(Initialize_Channel(Pt60_4_1, "PT60_4_1"))
            return_Value.Add(Initialize_Channel(Pt60_4_2, "PT60_4_2"))
            return_Value.Add(Initialize_Channel(Pt60_4_3, "PT60_4_3"))
            return_Value.Add(Initialize_Channel(Pt60_4_4, "PT60_4_4"))
            return_Value.Add(Initialize_Channel(Pt60_4_5, "PT60_4_5"))
            return_Value.Add(Initialize_Channel(Pt60_5_1, "PT60_5_1"))
            return_Value.Add(Initialize_Channel(Pt60_5_2, "PT60_5_2"))
            return_Value.Add(Initialize_Channel(Pt60_5_3, "PT60_5_3"))
            return_Value.Add(Initialize_Channel(Pt60_5_4, "PT60_5_4"))
            return_Value.Add(Initialize_Channel(Pt60_5_5, "PT60_5_5"))
            return_Value.Add(Initialize_Channel(Pt60_6_1, "PT60_6_1"))
            return_Value.Add(Initialize_Channel(Pt60_6_2, "PT60_6_2"))
            return_Value.Add(Initialize_Channel(Pt60_6_3, "PT60_6_3"))
            return_Value.Add(Initialize_Channel(Pt60_6_4, "PT60_6_4"))
            return_Value.Add(Initialize_Channel(Pt60_6_5, "PT60_6_5"))
            return_Value.Add(Initialize_Channel(Pt60_AVG, "PT60_AVG"))
            return_Value.Add(Initialize_Channel(Pt60_MAX, "PT60_MAX"))
            return_Value.Add(Initialize_Channel(Pt60_MIN, "PT60_MIN"))
            return_Value.Add(Initialize_Channel(Pt60_COUNT, "PT60_COUNT"))

            For rake = 0 To OPC_Pt60_DELETE.GetUpperBound(0)
                For probe = 0 To OPC_Pt60_DELETE.GetUpperBound(1)
                    return_Value.Add(Initialize_Channel(OPC_Pt60_DELETE(rake, probe), "OPC_PT60_" + (rake + 1).ToString() + "_" + (probe + 1).ToString() + "_DELETE"))
                Next
            Next

            return_Value.Add(Initialize_Channel(Tt60_AVG, "TT60_AVG"))
            return_Value.Add(Initialize_Channel(Tt60_MAX, "TT60_MAX"))
            return_Value.Add(Initialize_Channel(Tt60_MIN, "TT60_MIN"))
            return_Value.Add(Initialize_Channel(Tt60_COUNT, "TT60_COUNT"))

            For rake = 0 To OPC_Tt60_DELETE.GetUpperBound(0)
                For probe = 0 To OPC_Tt60_DELETE.GetUpperBound(1)
                    return_Value.Add(Initialize_Channel(OPC_Tt60_DELETE(rake, probe), "OPC_TT60_" + (rake + 1).ToString() + "_" + (probe + 1).ToString() + "_DELETE"))
                Next
            Next

            return_Value.Add(Initialize_Channel(P155_1_1, "P155_1_1"))
            return_Value.Add(Initialize_Channel(P155_1_2, "P155_1_2"))
            return_Value.Add(Initialize_Channel(P155_1_3, "P155_1_3"))
            return_Value.Add(Initialize_Channel(P155_1_4, "P155_1_4"))
            return_Value.Add(Initialize_Channel(P155_1_5, "P155_1_5"))
            return_Value.Add(Initialize_Channel(P155_1_6, "P155_1_6"))
            return_Value.Add(Initialize_Channel(P155_2_1, "P155_2_1"))
            return_Value.Add(Initialize_Channel(P155_2_2, "P155_2_2"))
            return_Value.Add(Initialize_Channel(P155_2_3, "P155_2_3"))
            return_Value.Add(Initialize_Channel(P155_2_4, "P155_2_4"))
            return_Value.Add(Initialize_Channel(P155_2_5, "P155_2_5"))
            return_Value.Add(Initialize_Channel(P155_2_6, "P155_2_6"))
            return_Value.Add(Initialize_Channel(P155_3_1, "P155_3_1"))
            return_Value.Add(Initialize_Channel(P155_3_2, "P155_3_2"))
            return_Value.Add(Initialize_Channel(P155_3_3, "P155_3_3"))
            return_Value.Add(Initialize_Channel(P155_3_4, "P155_3_4"))
            return_Value.Add(Initialize_Channel(P155_3_5, "P155_3_5"))
            return_Value.Add(Initialize_Channel(P155_3_6, "P155_3_6"))
            return_Value.Add(Initialize_Channel(P155_4_1, "P155_4_1"))
            return_Value.Add(Initialize_Channel(P155_4_2, "P155_4_2"))
            return_Value.Add(Initialize_Channel(P155_4_3, "P155_4_3"))
            return_Value.Add(Initialize_Channel(P155_4_4, "P155_4_4"))
            return_Value.Add(Initialize_Channel(P155_4_5, "P155_4_5"))
            return_Value.Add(Initialize_Channel(P155_4_6, "P155_4_6"))
            return_Value.Add(Initialize_Channel(P155_AVG, "P155_AVG"))
            return_Value.Add(Initialize_Channel(P155_MAX, "P155_MAX"))
            return_Value.Add(Initialize_Channel(P155_MIN, "P155_MIN"))
            return_Value.Add(Initialize_Channel(P155_COUNT, "P155_COUNT"))

            For rake = 0 To OPC_P155_DELETE.GetUpperBound(0)
                For probe = 0 To OPC_P155_DELETE.GetUpperBound(1)
                    return_Value.Add(Initialize_Channel(OPC_P155_DELETE(rake, probe), "OPC_P155_" + (rake + 1).ToString() + "_" + (probe + 1).ToString() + "_DELETE"))
                Next
            Next

            return_Value.Add(Initialize_Channel(T155_AVG, "T155_AVG"))
            return_Value.Add(Initialize_Channel(T155_MAX, "T155_MAX"))
            return_Value.Add(Initialize_Channel(T155_MIN, "T155_MIN"))
            return_Value.Add(Initialize_Channel(T155_COUNT, "T155_COUNT"))

            For rake = 0 To OPC_T155_DELETE.GetUpperBound(0)
                For probe = 0 To OPC_T155_DELETE.GetUpperBound(1)
                    return_Value.Add(Initialize_Channel(OPC_T155_DELETE(rake, probe), "OPC_T155_" + (rake + 1).ToString() + "_" + (probe + 1).ToString() + "_DELETE"))
                Next
            Next

            ' ****************
            ' Initialize FADEC
            ' ****************

            return_Value.Add(Initialize_Channel(EEC_FADEC, "EEC_FADEC"))
            return_Value.Add(Initialize_Channel(EEC_VIB_CONFIG, "EEC_VIB_CONFIG"))
            return_Value.Add(Initialize_Channel(EEC_MM_SELECT, "EEC_MM_SELECT"))
            return_Value.Add(Initialize_Channel(EEC_ENGINE_AI_PT2, "EEC_ENGINE_AI_PT2"))
            return_Value.Add(Initialize_Channel(EEC_TR_DEPLOYED, "EEC_TR_DEPLOYED"))
            return_Value.Add(Initialize_Channel(EEC_WOW, "EEC_WOW"))

            Select Case engine

                Case engine.TFE73140R200G
                    return_Value.Add(Initialize_Channel(EEC_DERATED_40, "EEC_DERATED_40"))

                Case engine.TFE73140AR200G
                    return_Value.Add(Initialize_Channel(EEC_PILOT_EVENT_RECORD, "EEC_PILOT_EVENT_RECORD"))

                Case engine.TFE731601C
                    return_Value.Add(Initialize_Channel(EEC_WING_ANTI_ICE, "EEC_WING_ANTI_ICE"))
                    return_Value.Add(Initialize_Channel(EEC_CONFIG_ID1, "EEC_CONFIG_ID1"))
                    return_Value.Add(Initialize_Channel(EEC_CONFIG_ID2, "EEC_CONFIG_ID2"))

                Case engine.TFE731401C
                    return_Value.Add(Initialize_Channel(EEC_WING_ANTI_ICE, "EEC_WING_ANTI_ICE"))
                    return_Value.Add(Initialize_Channel(EEC_CONFIG_ID1, "EEC_CONFIG_ID1"))
                    return_Value.Add(Initialize_Channel(EEC_CONFIG_ID2, "EEC_CONFIG_ID2"))
                    return_Value.Add(Initialize_Channel(EEC_MM_HOLD, "EEC_MM_HOLD"))
                    return_Value.Add(Initialize_Channel(EEC_FAULT_CLEAR, "EEC_FAULT_CLEAR"))

                Case engine.TFE73120R1B, engine.TFE73120AR1B, engine.TFE73120BR1B, engine.TFE73140BR1B
                    return_Value.Add(Initialize_Channel(EEC_ECTM_EVENT, "EEC_ECTM_EVENT"))
                    return_Value.Add(Initialize_Channel(EEC_WING_ANTI_ICE, "EEC_WING_ANTI_ICE"))
                    return_Value.Add(Initialize_Channel(EEC_MACH_NUMBER_HOLD, "EEC_MACH_NUMBER_HOLD"))
                    return_Value.Add(Initialize_Channel(EEC_FLAPS, "EEC_FLAPS"))

            End Select

        End Sub

