                    Return Engine.TFE73140AR200G
                Case "TFE731-40BR-1B"
                    Return Engine.TFE73140BR1B
                Case "TFE731-40-1C"
                    Return Engine.TFE731401C
                Case "TFE731-50R-1H"
                    Return Engine.TFE73150R1H
                Case "TFE731-60-1C"
                    Return Engine.TFE731601C
                Case "Engine Not Connected"
                Case "Not Connected"
                Case ""
                Case "0"
                    Return Engine.EngineNotConnected
                Case Else
                    Throw New NotImplementedException("Engine " + engineName + " is not handled in the GetEngineFromDisplayName method.")
            End Select
            Return Engine.EngineNotConnected
        End Function

        Public Function GetEngineFamilyDisplayName(ByVal engineName As String) As String
            Dim engine = GetEngineFromDisplayName(engineName)
            Dim group = GetEngineGroup(engine)

            Select Case group
                Case EngineGroup.None
                    Return "None"
                Case EngineGroup.Two
                    Return "TFE731-2"
                Case EngineGroup.TwoC
                    Return "TFE731-2"
                Case EngineGroup.Three
                    Return "TFE731-3"
                Case EngineGroup.ThreeA
                    Return "TFE731-3"
                Case EngineGroup.ThreeB
                    Return "TFE731-3"
                Case EngineGroup.ThreeC
                    Return "TFE731-3"
                Case EngineGroup.ThreeD
                    Return "TFE731-3"
                Case EngineGroup.Four
                    Return "TFE731-4"
                Case EngineGroup.Five
                    Return "TFE731-5"
                Case EngineGroup.FiveA
                    Return "TFE731-5"
                Case EngineGroup.FiveB
                    Return "TFE731-5"
                Case EngineGroup.Twenty
                    Return "TFE731-20"
                Case EngineGroup.Forty
                    Return "TFE731-40"
                Case EngineGroup.Fifty
                    Return "TFE731-50"
                Case EngineGroup.Sixty
                    Return "TFE731-60"
                Case EngineGroup.PW305
                    Return "PW305"
                Case EngineGroup.PW306
                    Return "PW306"
                Case EngineGroup.PW307
                    Return "PW307"
                Case EngineGroup.PW308
                    Return "PW308"
            End Select

            Return ""

        End Function

