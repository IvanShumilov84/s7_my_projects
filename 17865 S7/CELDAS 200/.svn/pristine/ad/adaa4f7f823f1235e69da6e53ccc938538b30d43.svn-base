        Private Sub AddOpcBooleanChannelToCollection(ByRef channelCollection As ChannelCollection, name As String, path As String, description As String)

            If channelCollection.ContainsKey(name) Then Return

            Dim opcChannel = New KineticaRT.Servers.OpcClient.BooleanItem

            opcChannel.FalseText = "False"
            opcChannel.TrueText = "True"
            opcChannel.Description = description
            'opcChannel.ToolTip = ""
            opcChannel.Group = "Group_Fast"
            opcChannel.Name = name
            opcChannel.ItemID = path.ToLower()
            channelCollection.Add(opcChannel)

        End Sub

