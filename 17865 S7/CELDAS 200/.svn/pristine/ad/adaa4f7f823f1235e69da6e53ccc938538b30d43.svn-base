            'For i = 0 To OPC_Ps1dot2_DELETE.GetUpperBound(0)
            '    If Not (OPC_Ps1dot2_DELETE(i) Is Nothing) Then
            '        RemoveHandler OPC_Ps1dot2_DELETE(i).ValueChanged, AddressOf OnPs1dot2_DELETE
            '    End If
            'Next

            If engineCategory = Category.Small Then

                For i = 0 To OPC_T1_DELETE.GetUpperBound(0)
                    If Not (OPC_T1_DELETE(i) Is Nothing) Then
                        RemoveHandler OPC_T1_DELETE(i).ValueChanged, AddressOf OnT1_DELETE
                    End If
                Next

                For rake = 0 To OPC_T8_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_T8_DELETE.GetUpperBound(1)
                        If Not (OPC_T8_DELETE(rake, probe) Is Nothing) Then
                            RemoveHandler OPC_T8_DELETE(rake, probe).ValueChanged, AddressOf OnT8_DELETE
                        End If
                    Next
                Next

                For rake = 0 To OPC_T11_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_T11_DELETE.GetUpperBound(1)
                        If Not (OPC_T11_DELETE(rake, probe) Is Nothing) Then
                            RemoveHandler OPC_T11_DELETE(rake, probe).ValueChanged, AddressOf OnT11_DELETE
                        End If
                    Next
                Next

                For i = 0 To OPC_P1dot2_DELETE.GetUpperBound(0)
                    If Not (OPC_P1dot2_DELETE(i) Is Nothing) Then
                        RemoveHandler OPC_P1dot2_DELETE(i).ValueChanged, AddressOf OnP1dot2_DELETE
                    End If
                Next

                For rake = 0 To OPC_P8_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_P8_DELETE.GetUpperBound(1)
                        If Not (OPC_P8_DELETE(rake, probe) Is Nothing) Then
                            RemoveHandler OPC_P8_DELETE(rake, probe).ValueChanged, AddressOf OnP8_DELETE
                        End If
                    Next
                Next

                For rake = 0 To OPC_P11_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_P11_DELETE.GetUpperBound(1)
                        If Not (OPC_P11_DELETE(rake, probe) Is Nothing) Then
                            RemoveHandler OPC_P11_DELETE(rake, probe).ValueChanged, AddressOf OnP11_DELETE
                        End If
                    Next
                Next

            Else

                For i = 0 To OPC_Tt1dot2_DELETE.GetUpperBound(0)
                    If Not (OPC_Tt1dot2_DELETE(i) Is Nothing) Then
                        RemoveHandler OPC_Tt1dot2_DELETE(i).ValueChanged, AddressOf OnTt1dot2_DELETE
                    End If
                Next

                For rake = 0 To OPC_Tt60_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_Tt60_DELETE.GetUpperBound(1)
                        If Not (OPC_Tt60_DELETE(rake, probe) Is Nothing) Then
                            RemoveHandler OPC_Tt60_DELETE(rake, probe).ValueChanged, AddressOf OnTt60_DELETE
                        End If
                    Next
                Next

                For rake = 0 To OPC_T155_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_T155_DELETE.GetUpperBound(1)
                        If Not (OPC_T155_DELETE(rake, probe) Is Nothing) Then
                            RemoveHandler OPC_T155_DELETE(rake, probe).ValueChanged, AddressOf OnT155_DELETE
                        End If
                    Next
                Next

                For i = 0 To OPC_Pt1dot2_DELETE.GetUpperBound(0)
                    If Not (OPC_Pt1dot2_DELETE(i) Is Nothing) Then
                        RemoveHandler OPC_Pt1dot2_DELETE(i).ValueChanged, AddressOf OnPt1dot2_DELETE
                    End If
                Next

                For rake = 0 To OPC_Pt60_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_Pt60_DELETE.GetUpperBound(1)
                        If Not (OPC_Pt60_DELETE(rake, probe) Is Nothing) Then
                            RemoveHandler OPC_Pt60_DELETE(rake, probe).ValueChanged, AddressOf OnPt60_DELETE
                        End If
                    Next
                Next

                For rake = 0 To OPC_P155_DELETE.GetUpperBound(0)
                    For probe = 0 To OPC_P155_DELETE.GetUpperBound(1)
                        If Not (OPC_P155_DELETE(rake, probe) Is Nothing) Then
                            RemoveHandler OPC_P155_DELETE(rake, probe).ValueChanged, AddressOf OnP155_DELETE
                        End If
                    Next
                Next

            End If


            Throw New NotImplementedException("Uncomment all this if you need to use TFE731")
            'Uncomment all this if you need to use TFE731
            '-------------------------------------------

            'If Not (ShowAccelTimeWindow Is Nothing) Then
            '    RemoveHandler ShowAccelTimeWindow.ValueChanged, AddressOf OnShowAccelTimeWindow
            'End If
            '
            'If Not (STOP_TIMER_CND_BUTTON Is Nothing) Then
            '    RemoveHandler STOP_TIMER_CND_BUTTON.ValueChanged, AddressOf OnStopTimerCondition
            'End If
            '
            'If Not (ARM_TIMER_BUTTON Is Nothing) Then
            '    RemoveHandler ARM_TIMER_BUTTON.ValueChanged, AddressOf OnArmTimer
            'End If
            '
            'If Not (CLOSE_ACCEL_CHECK_BUTTON Is Nothing) Then
            '    RemoveHandler CLOSE_ACCEL_CHECK_BUTTON.ValueChanged, AddressOf OnCloseAccelTimeWindow
            'End If

        End Sub

        Private Sub InitializeTFEChannels(selectedEngine As String, ByRef Return_Value As ArrayList)

            Dim engineCategory = Engines.GetEngineCategory(Engines.GetEngineFromDisplayName(selectedEngine))
            If engineCategory <> Category.Small AndAlso engineCategory <> Category.Big Then Return

            'AddTFEEnginesOpcDeleteChannels(engineCategory)

            Dim i As Integer

            Return_Value.Add(Initialize_Channel(T45_AVG, "T45_AVG"))
            Return_Value.Add(Initialize_Channel(T45_MAX, "T45_MAX"))
            Return_Value.Add(Initialize_Channel(N2_ONEHUNDREDPERCENT, "N2_ONEHUNDREDPERCENT"))
            Return_Value.Add(Initialize_Channel(TIME_TO_LIGHT_START, "TIME_TO_LIGHT_START"))
            Return_Value.Add(Initialize_Channel(IDLE_TIME, "IDLE_TIME"))
            Return_Value.Add(Initialize_Channel(LIGHT_TIME, "LIGHT_TIME"))
