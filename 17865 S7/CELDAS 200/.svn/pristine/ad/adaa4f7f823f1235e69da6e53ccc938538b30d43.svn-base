        Public Function GetEngineFromDisplayName(ByVal engineName As String) As Engine
            Select Case engineName
                Case "DAS CALIBRATION"
                    Return Engine.DASCALIBRATION
                Case "SYSTEM CHECK"
                    Return Engine.SYSTEMCHECK
                Case "PW305A ANC"
                    Return Engine.PW305AANC
                Case "PW305A SMITH"
                    Return Engine.PW305ASMITH
                Case "PW305B SMITH"
                    Return Engine.PW305BSMITH
                Case "PW306A ANC"
                    Return Engine.PW306AANC
                Case "PW306C"
                    Return Engine.PW306C
                Case "PW307A"
                    Return Engine.PW307A
                Case "PW308A ANC"
                    Return Engine.PW308AANC
                Case "PW308C ANC"
                    Return Engine.PW308CANC
                Case "PW308C+"
                    Return Engine.PW308CPLUS
                Case "TFE731-2-1C"
                    Return Engine.TFE73121C
                Case "TFE731-2-2B"
