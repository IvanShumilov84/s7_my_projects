        Private Sub InitializeTFEEnginesOffsetsChannels(engineCategory As Category, ByRef return_Value As ArrayList)

            InitializeTFECommonOffsetsChannels(engineCategory, return_Value)
            InitializeTFESmallEnginesOffsetsChannels(engineCategory, return_Value)
            InitializeTFEBigEnginesOffsetsChannels(engineCategory, return_Value)

        End Sub

        Private Sub InitializeTFECommonOffsetsChannels(engineCategory As Category, return_Value As ArrayList)

            If engineCategory <> Category.Small AndAlso engineCategory <> Category.Big Then Return

            return_Value.Add(Initialize_Channel(OPC_THRUST_OFFSET, "OPC_THRUST_OFFSET"))
            return_Value.Add(Initialize_Channel(OPC_POSCF2_OFFSET, "OPC_POSCF2_OFFSET"))
