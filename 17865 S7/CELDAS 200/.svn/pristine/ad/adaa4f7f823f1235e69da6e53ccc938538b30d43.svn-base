    'This is a copy from 18942 Common.vs : https://svn.cel-aerospace.ca/svn/repos/Project/08/08618 Vector/trunk/Prj08618_HMI_Critical/Common.vb
    Public Class TFE731_Helper

        Private CELProject As CEL.HMI.CELDAS = CEL.HMI.CELDAS.Instance()

        Private _Sequence

        Public Sub New()

        End Sub
        Private Sub New(ByRef sequence As KineticaRT.Sequence.Sequence)
            '_DatabaseInfo = New DatabaseInfo()
            _Sequence = sequence
        End Sub
        Public Shared ReadOnly Property CELTechnologie() As String
            Get
                Return "CELDAS™ 200"
            End Get
        End Property
        Public Shared ReadOnly Property ProjectName() As String
            Get
                Return "Vector UK"
            End Get
        End Property
        Public Shared ReadOnly Property ProjectNumber() As String
            Get
                Return "08618"
            End Get
        End Property

        '****************************
        '* GenericTDelete           *
        '****************************
        Public Shared Sub GenericTDelete(ByRef tDelete As KineticaRT.Channels.BooleanChannel(), ByRef tCount As NumericThresholdLink, ByRef tAverage As NumericThresholdExpression, ByRef tMax As NumericThresholdExpression, ByRef tMin As NumericThresholdExpression, tName As String)

            Dim count As Integer = 0
            Dim i As Integer
            Dim avgText As String = ""
            Dim maxText As String = ""
            Dim minText As String = ""

            Try
                tCount.Value = KineticaRT.Values.Values.Zero

                For i = 0 To tDelete.GetUpperBound(0)
                    If (tDelete(i).Value.ToString.ToUpper = "FALSE") Then
                        count = count + 1

                        If count = 1 Then
                            avgText = "(" + tName + "_" + (i + 1).ToString()
                        Else
                            avgText = avgText + " + " + tName + "_" + (i + 1).ToString()
                        End If
                    End If
                Next

                Dim numberOfCorrectProbe = count
                count = 0

                For i = 0 To tDelete.GetUpperBound(0)
                    If (tDelete(i).Value.ToString.ToUpper = "FALSE") Then
                        count = count + 1

                        If count = 1 Then
                            If numberOfCorrectProbe > 6 Then
                                maxText = "Max( Max(" + tName + "_" + (i + 1).ToString()
                                minText = "Min( Min(" + tName + "_" + (i + 1).ToString()
                            Else
                                maxText = "Max(" + tName + "_" + (i + 1).ToString()
                                minText = "Min(" + tName + "_" + (i + 1).ToString()
                            End If
                        ElseIf count = 7 OrElse count = 13 OrElse count = 19 OrElse count = 25 OrElse count = 31 Then
                            maxText = maxText + "), Max(" + tName + "_" + (i + 1).ToString()
                            minText = minText + "), Min(" + tName + "_" + (i + 1).ToString()
                        Else
                            maxText = maxText + ", " + tName + "_" + (i + 1).ToString()
                            minText = minText + ", " + tName + "_" + (i + 1).ToString()
                        End If
                    End If
                Next

                If count = 0 Then
                    avgText = "0"
                    maxText = "0"
                    minText = "0"
                ElseIf numberOfCorrectProbe > 6 Then
                    avgText = avgText + ")/" + count.ToString()
                    maxText = maxText + "))"
                    minText = minText + "))"
                Else
                    avgText = avgText + ")/" + count.ToString()
                    maxText = maxText + ")"
                    minText = minText + ")"
                End If

                tAverage.Text = avgText
                tCount.Value = New KineticaRT.Values.Integer(count)
                tMax.Text = maxText
                tMin.Text = minText

            Catch ex As Exception
                MessageBox.Show("OnTDelete [" + tName + "]: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            Finally
            End Try

        End Sub

        Public Shared Sub GenericTDeleteMulti(ByRef tDelete As KineticaRT.Channels.BooleanChannel(,), ByRef tCount As NumericThresholdLink, ByRef tAverage As NumericThresholdExpression, ByRef tMax As NumericThresholdExpression, ByRef tMin As NumericThresholdExpression, tName As String)

            Dim count As Integer = 0
            Dim rake As Integer
            Dim probe As Integer
            Dim avgText As String = ""
            Dim maxText As String = ""
            Dim minText As String = ""

            Try
                tCount.Value = KineticaRT.Values.Values.Zero

                For rake = 0 To tDelete.GetUpperBound(0)
                    For probe = 0 To tDelete.GetUpperBound(1)
                        If (tDelete(rake, probe).Value.ToString.ToUpper = "FALSE") Then
                            count = count + 1

                            If count = 1 Then
                                avgText = "(" + tName + "_" + (rake + 1).ToString() + "_" + (probe + 1).ToString()
                            Else
                                avgText = avgText + " + " + tName + "_" + (rake + 1).ToString() + "_" + (probe + 1).ToString()
                            End If
                        End If
                    Next
                Next

                Dim numberOfCorrectProbe = count
                count = 0

                For rake = 0 To tDelete.GetUpperBound(0)
                    For probe = 0 To tDelete.GetUpperBound(1)
                        If (tDelete(rake, probe).Value.ToString.ToUpper = "FALSE") Then
                            count = count + 1

                            If count = 1 Then
                                If numberOfCorrectProbe > 6 Then
                                    maxText = "Max( Max(" + tName + "_" + (rake + 1).ToString() + "_" + (probe + 1).ToString()
                                    minText = "Min( Min(" + tName + "_" + (rake + 1).ToString() + "_" + (probe + 1).ToString()
                                Else
                                    maxText = "Max(" + tName + "_" + (rake + 1).ToString() + "_" + (probe + 1).ToString()
                                    minText = "Min(" + tName + "_" + (rake + 1).ToString() + "_" + (probe + 1).ToString()
                                End If
                            ElseIf count = 7 OrElse count = 13 OrElse count = 19 OrElse count = 25 OrElse count = 31 Then
                                maxText = maxText + "), Max(" + tName + "_" + (rake + 1).ToString() + "_" + (probe + 1).ToString()
                                minText = minText + "), Min(" + tName + "_" + (rake + 1).ToString() + "_" + (probe + 1).ToString()
                            Else
                                maxText = maxText + ", " + tName + "_" + (rake + 1).ToString() + "_" + (probe + 1).ToString()
                                minText = minText + ", " + tName + "_" + (rake + 1).ToString() + "_" + (probe + 1).ToString()
                            End If
                        End If
                    Next
                Next

                If count = 0 Then
                    avgText = "0"
                    maxText = "0"
                    minText = "0"
                ElseIf numberOfCorrectProbe > 6 Then
                    avgText = avgText + ")/" + count.ToString()
                    maxText = maxText + "))"
                    minText = minText + "))"
                Else
                    avgText = avgText + ")/" + count.ToString()
                    maxText = maxText + ")"
                    minText = minText + ")"
                End If

                tAverage.Text = avgText
                tCount.Value = New KineticaRT.Values.Integer(count)
                tMax.Text = maxText
                tMin.Text = minText

            Catch ex As Exception
                MessageBox.Show("OnTDelete [" + tName + "]: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            Finally
            End Try

        End Sub


        Public Shared Sub UpdateDeletableChannels(sequence As CEL.KineticaRT.Sequence.Sequence, projectInformationElement As ProjectInformationElement, ByVal engineModel As String)

            Dim engine = Engines.GetEngineFromDisplayName(engineModel)
            Dim engineCategory = Engines.GetEngineCategory(engine)
            If engineCategory <> Category.Small AndAlso engineCategory <> Category.Big Then
                Return
            End If

            ' A partir du engine, determine la famille auquel appartient ce moteur
            Dim engineFamily As String = String.Empty

            engineFamily = GetEngineFamilyDisplayName(engineModel)

            If String.IsNullOrEmpty(engineFamily) Then Return

            Dim numberOfInletProbe As Integer = 0
            Dim realNumberOfInletProbe As Integer = 0
            Dim numberOfExhaustProbe As Integer = 0
            Dim realNumberOfExhaustProbe As Integer = 0
            Dim numberOfDischargePressureProbe As Integer = 0
            Dim realNumberOfDischargePressureProbe As Integer = 0



            Dim totalNumberOProbesPerRake As Integer = 0
            Dim numberOfExhaustRakesToUse As Integer = 0
            Dim totalNumberOfExhaustRakes As Integer = 0


