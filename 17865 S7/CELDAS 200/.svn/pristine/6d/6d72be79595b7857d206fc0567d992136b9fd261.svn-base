        Protected Overrides Function CreateCustomHeaderLogFile(ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Select Case CELProject.Project.Number
                '* FOR Ethiopia project, customer required a dedicated space to sign the log report. 

                Case 14075
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Operator Signature:"
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                    RowIndex += 1
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Inspector Signature:"
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                    RowIndex += 2

            End Select

            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Date Time:"
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

            RowIndex += 1
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Cond#:"
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

            RowIndex += 1
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Comment:"
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            ExcelWorksheet.Rows(RowIndex).RowHeight = 65.25
            ExcelWorksheet.Rows(RowIndex).VerticalAlignment = Excel.XlVAlign.xlVAlignTop
            ExcelWorksheet.Rows(RowIndex).WrapText = True

            Return True
        End Function

        Protected Overrides Function UpdateCustomHeaderLogFile(ByVal AppendOption As Boolean, ByVal IsPerfEntry As Boolean, ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Dim RowSignatureIndex As Integer

            Select Case CELProject.Project.Number
                '* FOR Ethiopia project, customer required a dedicated space to sign the log report. It is an offset requiring 3 spaces. 

                Case 14075
                    RowSignatureIndex = 3

                Case Else
                    RowSignatureIndex = 0

            End Select

            Dim Log_Condition As Integer

            If AppendOption = False Then
                Log_Condition = 1
            Else
                'Log_Condition = (ExcelWorksheet.Cells(RowIndex + 1, 1).End(Excel.XlDirection.xlToRight).Column - 1)
                'TODO: Ici changement du au nouveau Microsoft.Office.Interop.Excel	                        'Log_Condition = (ExcelWorksheet.Cells(RowIndex + 1, 1).End(XlDirection.xlToRight).Column - 1)  'cette ligne en office 2010 retourne toujours 16384 -1 donc 16383 et le reste du code plante
                Log_Condition = ExcelWorksheet.Cells(RowIndex + 1 + RowSignatureIndex, ExcelWorksheet.Columns.Count).End(Excel.XlDirection.xlToLeft).Column - 1
                Log_Condition = Log_Condition + 1

            End If

            If ((Log_Condition > 1) And ((Log_Condition Mod 5) = 1)) Then

                'Repeat The Test Spec For this new sets of condition

                With ExcelWorksheet
                    .Range(.Cells(2 + RowSignatureIndex, 2), .Cells(RowIndex - 2 + RowSignatureIndex, 6)).Copy(.Cells(2, Log_Condition + 1))
                End With
            End If

            ColumnIndex = 1 + Log_Condition

            ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).Value = Format(Now, "yyyy/MM/dd HH:mm:ss")
            ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += 1
            ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).Value = Log_Condition.ToString()
            ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += 1
            If IsPerfEntry = False Then
                Dim CommentText As String = ""
                Dim InputObject As New InputCommentForm
                InputObject.ShowDialog("Log Report", "Comment:", "", CommentText)

                ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).Value = CommentText
            Else
                '						ExcelWorkSheet.Cells(RowIndex, ColumnIndex).Value				= "STEP: " & TEST_STEP_NB.Value.ToString() & " " & Now.ToString()
                ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).Value = "STEP: " & TestStep_List.SelectedItem & " " & Now.ToString()
            End If

            ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += (2 + RowSignatureIndex)
            ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).Value = "Values"
            ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).Font.Bold = True
            ExcelWorksheet.Cells(RowIndex + RowSignatureIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignCenter
        End Function

        Private Function CheckLRU() As String
            If CELProject.IsTrue(FADEC_MAINT_TEST_BTN.Value) Then
                Dim result As Double
                If Double.TryParse(A429IN_Q_CHA.Value.ToString(), result) Then
                    If LRU_DICTIONARY.ContainsKey(result) Then
                        LRUFaultDescriptionCHA.Value = New KineticaRT.Values.Text(LRU_DICTIONARY(result))
                    End If
                End If
                If Double.TryParse(A429IN_NH_CHB.Value.ToString(), result) Then
                    If LRU_DICTIONARY.ContainsKey(result) Then
                        LRUFaultDescriptionCHB.Value = New KineticaRT.Values.Text(LRU_DICTIONARY(result))
                    End If
                End If
                Return ""
            Else
                Return ""
            End If
        End Function

        Protected Overrides Sub Init_Engine_Channels_Value()
            FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())
            LRUFaultDescriptionCHA.Value = New KineticaRT.Values.Text("")
            LRUFaultDescriptionCHB.Value = New KineticaRT.Values.Text("")
            DYNO_SPEED_DEMAND.Value = New KineticaRT.Values.Double(1020)
            Thread.Sleep(250)
            DYNO_SPEED_MODE_BTN.Value = Values.True
            CELDAS.NotifyIcon.ShowBalloonTip(3000, CELProject.TechnologyName, "Dynamometer set to 1020 RPM in SPEED mode. Please confirm on controller.", ToolTipIcon.Info)
        End Sub
        Protected Overrides Sub Init_Engine_Controls()
            MyBase.InitializeObject(TransientControl, "PW150_Slave_Screen.PW150_DRP_PLOT.transientControl")
            Me.TransientControl.SetEngineModel(CELProject.EngineModel)
        End Sub
        Private Sub Initialize_LRU_Dictionary()

            esProviderFactory.Factory = New EntitySpaces.LoaderMT.esDataProviderFactory()
            Dim ARINC429LRUCollection As ARINC429LRUCodesTemplateCollection = New ARINC429LRUCodesTemplateCollection()
            ARINC429LRUCollection.es.Connection.Name = CELProject.DefaultConnectionName
            ARINC429LRUCollection.Query.es.QuerySource = "DACN1_ARINC429_PW100LRUCODES"
            ARINC429LRUCollection.Query.Where(ARINC429LRUCollection.Query.EngineModel = CELProject.EngineModel)
            ARINC429LRUCollection.Query.OrderBy(ARINC429LRUCollection.Query.LRUCode.Ascending)
            ARINC429LRUCollection.Query.Load()

            For Each lruInfo As ARINC429LRUCodesTemplate In ARINC429LRUCollection

                LRU_DICTIONARY.Add(lruInfo.LRUCode, lruInfo.Description)

            Next

        End Sub

        Protected Overrides Sub OnEngineWorkingThread()

            StartTimerCtrl.Timer()
            AccelTimerCtrl.Timer()
            CrankTimerCtrl.Timer()
            StarterTimerCtrl.Timer()
            OperatingTimerCtrl.Timer()
            AccelCheckTimerCtrl.Timer()
            CheckLRU()

            If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then
                StatisticsCtrl.CalculateStatistics()
            End If

            'Persistent Values Save Check
            PersistentValuesCtrl.SavePersistentValues(False)

        End Sub

        Private Sub OnACCEL_CHECK_OPEN_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value) Implements IAccelCheckScreen.OnACCEL_CHECK_OPEN_WINDOW_BTN
            Try
                If CELProject.IsTrue(newVal) Then
                    CELProject.ActivateForm("PW150_AccelCheck_Screen", "PW150_Master_Screen", True, False)

                    'Acceleration Timer limit is a function of altitude and ambient temperature
                    UpdateAccelerationTimerHiLimit()

                    'Reset Button
                    ACCEL_CHECK_OPEN_WINDOW_BTN.Value = Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("OnACCEL_CHECK_OPEN_WINDOW_BTN: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnACCEL_CHECK_CLOSE_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value) Implements IAccelCheckScreen.OnACCEL_CHECK_CLOSE_WINDOW_BTN
            Try
                If CELProject.IsTrue(newVal) Then
                    CELProject.ActivateForm("PW150_AccelCheck_Screen", "PW150_Master_Screen", False, False)
                    'Reset Button
                    ACCEL_CHECK_CLOSE_WINDOW_BTN.Value = Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("OnACCEL_CHECK_CLOSE_WINDOW_BTN: " & Ex.ToString())
            Finally
            End Try
        End Sub

        Private Sub UpdateAccelerationTimerHiLimit()
            Try
                Dim Altitude As Single?
                Dim Temperature As Single?
                Dim A, B, C, D As Single?
                Dim AccelerationTimerHiLimit As Single

                Altitude = CalculateFacilityAltitude()
                Temperature = GetAmbientTemperatureFromUart()
                GetAccelerationLimitConstants(Altitude, Temperature, A, B, C, D)
                AccelerationTimerHiLimit = CalculateAccelertionTimerHiLimit(A, B, C, D, Altitude, Temperature)
                ACCELERATION_TIME_HI_LIMIT_SEC.Value = New KineticaRT.Values.Double(AccelerationTimerHiLimit)
            Catch Ex As Exception
                MessageBox.Show("UpdateAccelerationTimerHiLimit: " & Ex.ToString())
            End Try
        End Sub

        Private Function CalculateFacilityAltitude() As Single?
            Dim Altitude_ft As Single?
            If P_P1T_PSIA.Value.ToDouble() > 8 And P_P1T_PSIA.Value.ToDouble < 16 Then
                'Arbitrary range for a valid barometric or static inlet pressure reading
                Altitude_ft = 145.45 * (1 - (P_P1T_PSIA.Value.ToDouble() / 1.008 / 14.696) ^ 0.19) * 1000
            Else
                Altitude_ft = Nothing
                TraceMessage("Invalid Pressure Reading for P_P1T_PSIA")
            End If
            Return Altitude_ft
        End Function
        Private Function GetAmbientTemperatureFromUart() As Single?
            Dim Temperature_F As Single?
            If CELProject.IsTrue(FADEC_CHNA_SELECT_BTN.Value) Then
                Temperature_F = IAT15_DEGF.Value.ToDouble()
            ElseIf CELProject.IsTrue(FADEC_CHNB_SELECT_BTN.Value) Then
                Temperature_F = IBT15_DEGF.Value.ToDouble()
            Else
                'Fadec not set to any channel
                TraceMessage("FADEC Channel not selected")
                Temperature_F = Nothing
            End If
            Return Temperature_F
        End Function
        Private Sub GetAccelerationLimitConstants(ByVal Altitude_ft As Single?, ByVal AmbientTemperature_F As Single?, _
                                             ByRef A As Single?, _
                                             ByRef B As Single?, _
                                             ByRef C As Single?, _
                                             ByRef D As Single?)

            Dim _A As Single() = Nothing
            Dim _B As Single() = Nothing
            Dim _C As Single() = Nothing
            Dim _D As Single() = Nothing

            Select Case Altitude_ft
                'Valid altitude is 0 to 15000ft according to pratt.
                'they have suggested to do a linear interpolation if actual altitude exceeds this limit.
                Case Is < 5000
                    _A = {1.98, 1.66, 1.66, 3.1, 3.1, 0.6}
                    _B = {8, 0, 0, -24, -24, 1}
                    _C = {1.25, 0, 0, 0, 0, -1.25}
                    _D = {5.5, 5, 5, 5, 5, 6.25}
                Case 5000 To 10000
                    _A = {1.78, 1.66, 1.532, 0, 0, 0}
                    _B = {3, 0, -25.539, 0, 0, 0}
                    _C = {1.5, 0, 1.277, -1.2, -1.2, -1.2}
                    _D = {5.595, 5, 5.064, 6.55, 6.55, 6.55}
                Case Is > 10000
                    _A = {-1.16, 0.508, 0.628, 0, 0, 0}
                    _B = {-76, -34.286, -10.46, 0, 0, 0}
                    _C = {9.4, 3.429, -0.231, -1.2, -1.2, -1.2}
                    _D = {8.54, 6.152, 5.968, 6.55, 6.55, 6.55}
                Case Else
                    'Out of range
                    A = Nothing : B = Nothing : C = Nothing : D = Nothing
                    TraceMessage("Altitude not valid")
                    Exit Sub
            End Select

            Select Case AmbientTemperature_F
                'Valid temperature is -40 to 120 F according to pratt.
                'they have suggested to do a linear interpolation if actual temperature exceeds this limit.
                Case Is < -40
                    A = _A(0) : B = _B(0) : C = _C(0) : D = _D(0)
                Case -40 To -5
                    A = _A(1) : B = _B(1) : C = _C(1) : D = _D(1)
                Case -5 To 60
                    A = _A(2) : B = _B(2) : C = _C(2) : D = _D(2)
                Case 60 To 70
                    A = _A(3) : B = _B(3) : C = _C(3) : D = _D(3)
                Case 70 To 100
                    A = _A(4) : B = _B(4) : C = _C(4) : D = _D(4)
                Case Is > 100
                    A = _A(5) : B = _B(5) : C = _C(5) : D = _D(5)
                Case Else
                    'Out of Range
                    A = Nothing : B = Nothing : C = Nothing : D = Nothing
                    TraceMessage("Temperature not valid")
                    Exit Sub
            End Select
        End Sub
        Private Function CalculateAccelertionTimerHiLimit(ByVal A As Single?, _
                                                     ByVal B As Single?, _
                                                     ByVal C As Single?, _
                                                     ByVal D As Single?, _
                                                     ByVal Altitude_ft As Single?, _
                                                     ByVal AmbientTemperature_F As Single?) As Single
            Dim Result As Single

            If Altitude_ft.HasValue And AmbientTemperature_F.HasValue And A.HasValue And B.HasValue And C.HasValue And D.HasValue Then
                Result = A * (10 ^ (-4)) * Altitude_ft + B * (10 ^ (-7)) * AmbientTemperature_F * Altitude_ft + C * (10 ^ (-2)) * AmbientTemperature_F + D
            Else
                Result = 0.0
            End If

            Return Result
        End Function

