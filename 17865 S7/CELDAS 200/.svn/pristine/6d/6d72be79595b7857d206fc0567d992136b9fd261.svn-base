            End If
            If Not (DYNO_SET_INLET_PCT Is Nothing) Then
                RemoveHandler DYNO_SET_INLET_PCT.ValueChanged, AddressOf OnDYNO_INLET_VALIDATE
            End If
            If Not (DYNO_VALVE_STATUS_IND Is Nothing) Then
                RemoveHandler DYNO_VALVE_STATUS_IND.ValueChanged, AddressOf OnDYNO_VALIDATE_MODE
            End If
            If Not (DYNO_REMOTE_CONTROL_IND Is Nothing) Then
                RemoveHandler DYNO_REMOTE_CONTROL_IND.ValueChanged, AddressOf OnDYNO_VALIDATE_MODE
            End If
            If Not (FADEC_OPEN_WINDOW_BTN Is Nothing) Then
                RemoveHandler FADEC_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnFADEC_OPEN_WINDOW_BTN
            End If
            If Not (FADEC_CLOSE_WINDOW_BTN Is Nothing) Then
