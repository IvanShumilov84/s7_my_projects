            End If
            If Not (FACILITY_CLOSE_WINDOW_BTN Is Nothing) Then
                RemoveHandler FACILITY_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnFCS_CLOSE_WINDOW_BTN
