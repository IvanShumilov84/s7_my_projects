        Protected Overrides Sub Init_Engine_Controllers()

            Dim PersistentValuesChannels() As String = {"OPERATING_TIME_SEC", "FUEL_USED_INITIAL_LITERS", "FUEL_USED_TOTAL_LITERS", _
                                                              "FUEL_COST_$_PER_LITER", "LABOR_COST_$_PER_HOUR", "FACILITY_COST_$_PER_HOUR", _
                                                              "PERF_CONDITION_NUMBER"}

            Dim PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputs.EngineSerialNumber & "\" & UserInputs.WorkOrder & "\Log\PersistentValues.xml"

            PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

            FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())

            FlowmeterCtrl = New FlowmeterController(Me)

            DeletableT1ChCtrl = New DeletableChannelController(Me, NumberOfT1Probe, 5, NumberOfT1Probe, "T_T1_", "_DEGF", "_DELETE_BTN", "T_T1_AVG_DEGF", "T_T1_MIN_DEGF", "T_T1_MAX_DEGF", "T_T1_SPREAD_DEGF")
            DeletableT25ChCtrl = New DeletableChannelController(Me, NumberOfT25Probe, 3, NumberOfT25Probe, "T_T25_", "_DEGF", "_DELETE_BTN", "T_T25_AVG_DEGF", "T_T25_MIN_DEGF", "T_T25_MAX_DEGF", "T_T25_SPREAD_DEGF")
            DeletableT3ChCtrl = New DeletableChannelController(Me, NumberOfT3Probe, 3, NumberOfT3Probe, "T_T3_", "_DEGF", "_DELETE_BTN", "T_T3_AVG_DEGF", "T_T3_MIN_DEGF", "T_T3_MAX_DEGF", "T_T3_SPREAD_DEGF")
            DeletableT7ChCtrl = New DeletableChannelController(Me, NumberOfT7Probe, 24, NumberOfT7Probe, "T_T7_", "_DEGF", "_DELETE_BTN", "T_T7_AVG_DEGF", "T_T7_MIN_DEGF", "T_T7_MAX_DEGF", "T_T7_SPREAD_DEGF")

            IgnitionMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "IGNITION_CURRENT_AMP", "IGNITION_CURRENT_AMP_MAX", "CRANK_START_DEMAND_OPC")
            IgnitionMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "IGNITION_VOLTAGE_VDC", "IGNITION_VOLTAGE_VDC_MAX", "CRANK_START_DEMAND_OPC")
            StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_CURRENT_AMP", "STARTER_CURRENT_AMP_MAX", "CRANK_START_DEMAND_OPC")
            StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_VOLTAGE_VDC", "STARTER_VOLTAGE_VDC_MAX", "CRANK_START_DEMAND_OPC")
            ITTMaxTemperatureRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "ITT_DEGF", "ITT_DEGF_MAX", "CRANK_START_DEMAND_OPC")

            NLMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "NL_RPM", "NL_RPM_PEAK", "NL_RPM_PEAK_RESET")
            NHMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "NH_RPM", "NH_RPM_PEAK", "NH_RPM_PEAK_RESET")
            NPTMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "NPT_RPM", "NPT_RPM_PEAK", "NPT_RPM_PEAK_RESET")
            VibRGBPlane1MaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_RGB_PLANE1_MS2", "VIB_RGB_PLANE1_MS2_PEAK", "VIB_RGB_PLANE1_MS2_PEAK_RESET")
            VibGGPlane4MaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_GG_PLANE4_CMS", "VIB_GG_PLANE4_CMS_PEAK", "VIB_GG_PLANE4_CMS_PEAK_RESET")
            VibGGPlane6MaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_GG_PLANE6_CMS", "VIB_GG_PLANE6_CMS_PEAK", "VIB_GG_PLANE6_CMS_PEAK_RESET")
            VibGGPlane8MaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_GG_PLANE8_CMS", "VIB_GG_PLANE8_CMS_PEAK", "VIB_GG_PLANE8_CMS_PEAK_RESET")
            VibGGPlane9MaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_GG_PLANE9_CMS", "VIB_GG_PLANE9_CMS_PEAK", "VIB_GG_PLANE9_CMS_PEAK_RESET")
            ITTMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "ITT_DEGF", "ITT_DEGF_PEAK", "ITT_DEGF_PEAK_RESET")

            StartTimerCtrl = New TimerController(Me, "STARTING_TIME_START_CONDITION_LATCH", "STARTING_TIME_STOP_CONDITION_LATCH", "STARTING_TIME_CONDITION_RESET", "STARTING_TIME_SEC", Nothing, 0, "NONE")
            AccelTimerCtrl = New TimerController(Me, "ACCELERATING_TIME_START_CONDITION_LATCH", "ACCELERATING_TIME_STOP_CONDITION_LATCH", "ACCELERATING_TIME_CONDITION_RESET", "ACCELERATING_TIME_SEC", Nothing, 0, "NONE")
            CrankTimerCtrl = New TimerController(Me, "CRANK_TIME_START_CONDITION_LATCH", "CRANK_TIME_STOP_CONDITION_LATCH", "CRANK_TIME_CONDITION_RESET", "CRANKING_TIME_SEC", Nothing, 45, "CRANK_TIME_MAX_VALUE_REACHED")
            StarterTimerCtrl = New TimerController(Me, "STARTER_OVERCURRENT_START_CONDITION", "STARTER_OVERCURRENT_STOP_CONDITION", "STARTER_OVERCURRENT_CONDITION_RESET", "STARTER_OVERCURRENT_TIME_SEC", Nothing, 10, "STARTER_OVERCURRENT_MAX_VALUE_REACHED")
            OperatingTimerCtrl = New TimerController(Me, "OPERATING_TIME_START_CONDITION", "OPERATING_TIME_STOP_CONDITION", "OPERATING_TIME_CONDITION_RESET", "OPERATING_TIME_SEC", "OPERATING_TIME", 0, "NONE", True)

            AccelCheckTimerCtrl = New TimerController(Me, "ACCEL_CHECK_TIMER_START_CONDITION_LATCH", "ACCEL_CHECK_TIMER_STOP_CONDITION_LATCH", "ACCEL_CHECK_TIMER_RESET_CONDITION", "ACCELERATION_TIME_SEC", Nothing, 0, "NONE")

            If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then
                StatisticsCtrl = New StatisticsController(Me, "FUEL_COST_$_PER_LITER", "LABOR_COST_$_PER_HOUR", "FACILITY_COST_$_PER_HOUR", "OPERATING_TIME_HOURS", "HOURS", "FUEL_USED_TOTAL_LITERS", "LITER", "FUEL_COST_$", "LABOR_COST_$", "FACILITY_COST_$", "TOTAL_COST_$")
            End If

        End Sub
        Protected Overrides Sub Dispose_Engine_Controllers()

            If Not (DeletableT1ChCtrl Is Nothing) Then
                DeletableT1ChCtrl.Dispose()
            End If

            If Not (DeletableT25ChCtrl Is Nothing) Then
                DeletableT25ChCtrl.Dispose()
            End If

            If Not (DeletableT3ChCtrl Is Nothing) Then
                DeletableT3ChCtrl.Dispose()
            End If

            If Not (DeletableT7ChCtrl Is Nothing) Then
                DeletableT7ChCtrl.Dispose()
            End If

            If Not (IgnitionMaxCurrentRecordCtrl Is Nothing) Then
                IgnitionMaxCurrentRecordCtrl.Dispose()
            End If

            If Not (IgnitionMaxVoltageRecordCtrl Is Nothing) Then
                IgnitionMaxVoltageRecordCtrl.Dispose()
            End If

            If Not (StarterMaxCurrentRecordCtrl Is Nothing) Then
                StarterMaxCurrentRecordCtrl.Dispose()
            End If

            If Not (StarterMaxVoltageRecordCtrl Is Nothing) Then
                StarterMaxVoltageRecordCtrl.Dispose()
            End If

            If Not (ITTMaxTemperatureRecordCtrl Is Nothing) Then
                ITTMaxTemperatureRecordCtrl.Dispose()
            End If

            If Not (NLMaxRecordCtrl Is Nothing) Then
                NLMaxRecordCtrl.Dispose()
            End If

            If Not (NHMaxRecordCtrl Is Nothing) Then
                NHMaxRecordCtrl.Dispose()
            End If

            If Not (NPTMaxRecordCtrl Is Nothing) Then
                NPTMaxRecordCtrl.Dispose()
            End If

            If Not (VibRGBPlane1MaxRecordCtrl Is Nothing) Then
                VibRGBPlane1MaxRecordCtrl.Dispose()
            End If

            If Not (VibGGPlane4MaxRecordCtrl Is Nothing) Then
                VibGGPlane4MaxRecordCtrl.Dispose()
            End If

            If Not (VibGGPlane6MaxRecordCtrl Is Nothing) Then
                VibGGPlane6MaxRecordCtrl.Dispose()
            End If

            If Not (VibGGPlane8MaxRecordCtrl Is Nothing) Then
                VibGGPlane8MaxRecordCtrl.Dispose()
            End If

            If Not (VibGGPlane9MaxRecordCtrl Is Nothing) Then
                VibGGPlane9MaxRecordCtrl.Dispose()
            End If

            If Not (ITTMaxRecordCtrl Is Nothing) Then
                ITTMaxRecordCtrl.Dispose()
            End If

            If Not (StartTimerCtrl Is Nothing) Then
                StartTimerCtrl.Dispose()
            End If

            If Not (AccelTimerCtrl Is Nothing) Then
                AccelTimerCtrl.Dispose()
            End If

            If Not (AccelCheckTimerCtrl Is Nothing) Then
                AccelCheckTimerCtrl.Dispose()
            End If

            If Not (CrankTimerCtrl Is Nothing) Then
                CrankTimerCtrl.Dispose()
            End If

            If Not (StarterTimerCtrl Is Nothing) Then
                StarterTimerCtrl.Dispose()
            End If

            If Not (OperatingTimerCtrl Is Nothing) Then
                OperatingTimerCtrl.Dispose()
            End If

            If Not (StatisticsCtrl Is Nothing) Then
                StatisticsCtrl.Dispose()
            End If

            If Not (PersistentValuesCtrl Is Nothing) Then
                PersistentValuesCtrl.Dispose()
            End If

            'Clear the LRU directory
            If Not (LRU_DICTIONARY Is Nothing) Then
                LRU_DICTIONARY.Clear()
            End If

            If Not (TransientControl Is Nothing) Then
                TransientControl.ClearPresets()
            End If

            FlowmeterCtrl.Dispose()

        End Sub

        Protected Overrides Sub OnTestSessionClosing(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionClosing(newStatus)
                'For All Engine

            Catch ex As Exception
                MessageBox.Show("OnTestSessionClosing: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Function Init_Engine_Channels() As Boolean
            Dim Return_Value As New ArrayList()

            Return_Value.Clear()

            Try

                Return_Value.Add(MyBase.InitializeChannel(A429IN_Q_CHA, "A429IN_Q_CHA"))
                Return_Value.Add(MyBase.InitializeChannel(A429IN_NH_CHB, "A429IN_NH_CHB"))
                Return_Value.Add(MyBase.InitializeChannel(ACCEL_CHECK_CLOSE_WINDOW_BTN, "ACCEL_CHECK_CLOSE_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(ACCEL_CHECK_OPEN_WINDOW_BTN, "ACCEL_CHECK_OPEN_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(ARCHIVE_RECORD_BTN, "ARCHIVE_RECORD_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(CLOSE_TEST_BTN_OPC, "CLOSE_TEST_BTN_OPC"))
                Return_Value.Add(MyBase.InitializeChannel(CRANK_BTN, "CRANK_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(CRANK_START_DEMAND_OPC, "CRANK_START_DEMAND_OPC"))
                Return_Value.Add(MyBase.InitializeChannel(CRANK_BTN_PRESSED, "CRANK_BTN_PRESSED"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_POS_DEMAND, "DYNO_POS_DEMAND"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_REMOTE_CONTROL_IND, "DYNO_REMOTE_CONTROL_IND"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_SPEED_DEMAND, "DYNO_SPEED_DEMAND"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_SPEED_MODE_BTN, "DYNO_SPEED_MODE_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_SET_INLET_PCT, "DYNO_SET_INLET_PCT"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_TORQUE_DEMAND, "DYNO_TORQUE_DEMAND"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_VALVE_STATUS_IND, "DYNO_VALVE_STATUS_IND"))
                Return_Value.Add(MyBase.InitializeChannel(ENGINE_AT_REST, "ENGINE_AT_REST"))
                Return_Value.Add(MyBase.InitializeChannel(FADEC_CLOSE_WINDOW_BTN, "FADEC_CLOSE_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(FADEC_MAINT_TEST_BTN, "FADEC_MAINT_TEST_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(FADEC_OPEN_WINDOW_BTN, "FADEC_OPEN_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(FACILITY_CLOSE_WINDOW_BTN, "FACILITY_CLOSE_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(FACILITY_OPEN_WINDOW_BTN, "FACILITY_OPEN_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(FUEL_USED_INITIAL_LITERS, "FUEL_USED_INITIAL_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(FUEL_USED_TOTAL_LITERS, "FUEL_USED_TOTAL_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(FM_INITIAL_VOLUME_LITERS, "FM_INITIAL_VOLUME_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(FM_TOTAL_VOLUME_LITERS, "FM_TOTAL_VOLUME_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(ITT_DEGF, "ITT_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(ITT_CURRENT_DEGF, "ITT_CURRENT_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(LRUFaultDescriptionCHA, "LRUFaultDescriptionCHA"))
                Return_Value.Add(MyBase.InitializeChannel(LRUFaultDescriptionCHB, "LRUFaultDescriptionCHB"))
                Return_Value.Add(MyBase.InitializeChannel(NEW_TEST_BTN, "NEW_TEST_BTN"))

                Select Case CELProject.Project.Number
 
                    Case 14075
                        Return_Value.Add(MyBase.InitializeChannel(STARTER_RECTIFIER_BTN, "STARTER_RECTIFIER_BTN"))

                    Case 11894
                        'nothing to do

                    Case Else
                        Debug.Assert(False, "PW150.Sequence.Init_Engine_Channels: Code Missign for this project")

                End Select

                'Acceleration Timer Hi Limit
                Return_Value.Add(MyBase.InitializeChannel(P_P1T_PSIA, "P_P1T_PSIA"))
                Return_Value.Add(MyBase.InitializeChannel(IAT15_DEGF, "IAT15_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(IBT15_DEGF, "IBT15_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(FADEC_CHNA_SELECT_BTN, "FADEC_CHNA_SELECT_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(FADEC_CHNB_SELECT_BTN, "FADEC_CHNB_SELECT_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(ACCELERATION_TIME_HI_LIMIT_SEC, "ACCELERATION_TIME_HI_LIMIT_SEC"))

            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.Message)
                Return_Value.Add(False)
            Finally

            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function

