        Protected Overrides Function CreateCustomHeaderLogFile(ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            CreateCustomHeaderLogFile = False

            Try
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Date Time:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Cond#:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Test Step:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                ExcelWorksheet.Rows(RowIndex).WrapText = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).VerticalAlignment = Excel.XlVAlign.xlVAlignTop

                'RowIndex += 1
                'ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Is The First Run:"
                'ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                'ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                'RowIndex += 1
                'ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Pass/Fail:"
                'ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                'ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                'RowIndex += 1
                'ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Failure NB:"
                'ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                'ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                'RowIndex += 1
                'ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Clinic NB:"
                'ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                'ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Comment:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                ExcelWorksheet.Rows(RowIndex).RowHeight = 65.25
                ExcelWorksheet.Rows(RowIndex).VerticalAlignment = Excel.XlVAlign.xlVAlignTop
                ExcelWorksheet.Rows(RowIndex).WrapText = True

                CreateCustomHeaderLogFile = True

            Catch ex As Exception
                MessageBox.Show("CreateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        Protected Overrides Function UpdateCustomHeaderLogFile(ByVal AppendOption As Boolean, ByVal IsPerfEntry As Boolean, ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            UpdateCustomHeaderLogFile = False

            Try
                Dim Log_Condition As Integer

                If AppendOption = False Then
                    Log_Condition = 1
                Else
                    Log_Condition = ExcelWorksheet.Cells(RowIndex + 1, ExcelWorksheet.Columns.Count).End(Excel.XlDirection.xlToLeft).Column - 1
                    Log_Condition = Log_Condition + 1
                End If

                If ((Log_Condition > 1) And ((Log_Condition Mod 5) = 1)) Then

                    'Repeat The Test Spec For this new sets of condition

                    With ExcelWorksheet
                        .Range(.Cells(2, 2), .Cells(RowIndex - 2, 6)).Copy(.Cells(2, Log_Condition + 1))
                    End With
                End If

                ColumnIndex = 1 + Log_Condition
                'DateTime
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Format(Now, "yyyy/MM/dd HH:mm:ss")
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                'ConditionNB
                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Log_Condition.ToString()
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                'TestStep
                If IsPerfEntry = True Then
                    RowIndex += 1
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Test_Step_Description
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).VerticalAlignment = Excel.XlVAlign.xlVAlignTop
                Else
                    RowIndex += 1
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "N/A"
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).VerticalAlignment = Excel.XlVAlign.xlVAlignTop
                End If


                RowIndex += 1
                If IsPerfEntry = False Then
                    Dim CommentText As String = ""
                    Dim InputObject As New InputCommentForm
                    InputObject.ShowDialog("Log Report", "Comment:", "", CommentText)

                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = CommentText
                Else
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Performance Point"
                End If


                'Value Title
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 2
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Values"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignCenter

                UpdateCustomHeaderLogFile = True

            Catch ex As Exception
                MessageBox.Show("UpdateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        Private Function CreatePerformanceFileRevima12917(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim currentSheet As String
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreatePerformanceFileRevima12917 = True

            Try

                ' The following gets the Worksheets collection
                excelSheets = excelWorkbook.Worksheets
                'Unlock Sheets
                'TODO Unlock special a faire pour REVIMA
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    currentSheet = "SUMMARY"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    Dim row As Integer = 5
                    Dim column As Integer = 3
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.EngineSerialNumber
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.WorkOrder
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.EcbSerialNumber
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.ExhaustDuctSerialNumber
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.BellmouthSerialNumber
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.BleedDuctSerialNumber
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.StarterSerialNumber
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.OilType

                    row = 5
                    column = 9
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.EngineVibrationPickupSerialNumber
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.GearboxVibrationPickupSerialNumber
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.TimeSinceNewOrOverhaul
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.CycleSinceNewOrOverhaul
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.ReasonForShop
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.TestType
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.RepairType
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = Format(Now, "MM/dd/yyyy")

                    currentSheet = "DETAILS"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    'APU Tested according to
                    excelWorksheet.Cells(44, 7).NumberFormat = "@"
                    excelWorksheet.Cells(44, 7).Value = APU_TESTED_ACCORDING_TO.Value.ToString()


                End If


                Select Case TestStepNumber

                    Case eTestStepAPS2000.STEP2 '2 NoLoad

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Detail Section
                        excelWorksheet.Cells(42, 10).Value = START_TIME_OPC_SEC.Value.ToString()
                        excelWorksheet.Cells(44, 10).Value = T_EGT_PEAK_START_DEGF.Value.ToString(T_EGT_PEAK_START_DEGF.Format, Nothing) 'Log_Perf_PeakStartEGT.Value.ToString()

                        excelWorksheet.Cells(18, 6).Value = "N/A"
                        excelWorksheet.Cells(20, 6).Value = "N/A"
                        excelWorksheet.Cells(22, 6).Value = "N/A"
                        excelWorksheet.Cells(24, 6).Value = "N/A" 'LOG_PERF_T_EGT_COR_DEGF.Value.ToString(LOG_PERF_T_EGT_COR_DEGF.Format, Nothing)
                        excelWorksheet.Cells(26, 6).Value = "N/A"
                        excelWorksheet.Cells(28, 6).Value = LOG_PERF_T_EGT_P_SPREAD_DEGF.Value.ToString(LOG_PERF_T_EGT_P_SPREAD_DEGF.Format, Nothing)
                        excelWorksheet.Cells(30, 6).Value = "N/A"
                        excelWorksheet.Cells(31, 6).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)
                        excelWorksheet.Cells(33, 6).Value = LOG_PERF_VIB_GEARBOX_G_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_G_PEAK.Format, Nothing)
                        excelWorksheet.Cells(35, 6).Value = LOG_PERF_VIB_POWER_SECTION_G_PEAK.Value.ToString(LOG_PERF_VIB_POWER_SECTION_G_PEAK.Format, Nothing)
                        excelWorksheet.Cells(49, 10).Value = LOG_PERF_NG_RPM.Value.ToString(LOG_PERF_NG_RPM.Format, Nothing)

                        currentSheet = "DETAILS"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        excelWorksheet.Cells(15, 7).Value = LOG_PERF_P_BARO_INHGA.Value.ToString(LOG_PERF_P_BARO_INHGA.Format, Nothing)
                        excelWorksheet.Cells(16, 7).Value = LOG_PERF_T_CELL_DEGF.Value.ToString(LOG_PERF_T_CELL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(17, 7).Value = LOG_PERF_T_INLET_AVG_DEGF.Value.ToString(LOG_PERF_T_INLET_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(18, 7).Value = LOG_PERF_P_INLET_LOSS_INH2OG.Value.ToString(LOG_PERF_P_INLET_LOSS_INH2OG.Format, Nothing)
