                        excelWorksheet.Cells(27, 10).Value = LOG_PERF_P_ORIFICE_PSIA.Value.ToString(LOG_PERF_P_ORIFICE_PSIA.Format, Nothing)
                        excelWorksheet.Cells(28, 10).Value = LOG_PERF_T_ORIFICE_DEGF.Value.ToString(LOG_PERF_T_ORIFICE_DEGF.Format, Nothing)
                        excelWorksheet.Cells(29, 10).Value = LOG_PERF_P_ORIFICE_DELTA_INH2OD.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_INH2OD.Format, Nothing)
                        excelWorksheet.Cells(30, 10).Value = LOG_PERF_WB_PPM.Value.ToString(LOG_PERF_WB_PPM.Format, Nothing)
                        excelWorksheet.Cells(31, 10).Value = LOG_PERF_P_BLEED_PSIA.Value.ToString(LOG_PERF_P_BLEED_PSIA.Format, Nothing)
                        excelWorksheet.Cells(32, 10).Value = LOG_PERF_T_BLEED_DEGF.Value.ToString(LOG_PERF_T_BLEED_DEGF.Format, Nothing)
                        excelWorksheet.Cells(33, 10).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)
                        excelWorksheet.Cells(34, 10).Value = LOG_PERF_P_EXHAUST_LOSS_INH2OG.Value.ToString(LOG_PERF_P_EXHAUST_LOSS_INH2OG.Format, Nothing)

                        excelWorksheet.Cells(35, 10).Value = LOG_PERF_HR_MTR_1.Value.ToString(LOG_PERF_HR_MTR_1.Format, Nothing)
                        excelWorksheet.Cells(36, 10).Value = LOG_PERF_EVENT_1.Value.ToString(LOG_PERF_EVENT_1.Format, Nothing)
                        excelWorksheet.Cells(37, 10).Value = LOG_PERF_HR_MTR_2.Value.ToString(LOG_PERF_HR_MTR_2.Format, Nothing)
                        excelWorksheet.Cells(38, 10).Value = LOG_PERF_EVENT_2.Value.ToString(LOG_PERF_EVENT_2.Format, Nothing)


                    Case eTestStepAPS2000.CAPTURE_FINAL_DATA

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Detail
                        Dim OperatingTime As Double = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToDouble()
                        Dim NbStart As Double = NUMBER_OF_STARTS.Value.ToDouble()

                        excelWorksheet.Cells(43, 10).Value = RUNDOWN_TIME_OPC_SEC.Value.ToString()

                        excelWorksheet.Cells(45, 10).Value = NbStart.ToString(NUMBER_OF_STARTS.Format) 'NUMBER_OF_STARTS.Value.ToString()
                        excelWorksheet.Cells(46, 10).Value = OperatingTime.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format) 'OPERATING_TIME_TEXT.Value.ToString()
                        excelWorksheet.Cells(47, 10).Value = LOG_PERF_FUEL_USED_TOTAL_LITERS.Value.ToString(LOG_PERF_FUEL_USED_TOTAL_LITERS.Format, Nothing)
                        excelWorksheet.Cells(48, 10).Value = NUMBER_APU_FAULT_SEEN_DURING_TEST.Value.ToString()


                End Select
                TestProgress_RecordPerfStep(TestStepNumber)

                currentSheet = "ACCEPTANCE"
                excelWorksheet = excelSheets.Item(currentSheet)

                'Test Result
                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value) Then
                    excelWorksheet.OLEObjects("chkTestResultAccepted").object.value = True
                Else
                    excelWorksheet.OLEObjects("chkTestResultAccepted").object.value = False
                End If

                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value) Then
                    excelWorksheet.OLEObjects("chkTestResultRejected").object.value = True
                Else
                    excelWorksheet.OLEObjects("chkTestResultRejected").object.value = False
                End If

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreatePerformanceFileRevima12917 = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)
            End Try

        End Function

        Protected Overrides Sub Init_Engine_Channels_Value()

            If CELProject.Project.Number = 12917 Then

                APU_TESTED_ACCORDING_TO.Value = New KineticaRT.Values.Text(Custom_Parameters("APUTestedAccordingTo").ToString())

            End If

            If Not (CELProject.PERF_TEST_STEP_NB Is Nothing) Then
                CELProject.PERF_TEST_STEP_NB.Value = New KineticaRT.Values.Double(eTestStepAPS2000.STEP2)
            End If

            If Not (WB_CALC Is Nothing) Then
                WB_CALC.Value = New KineticaRT.Values.Double(0.0)
            End If

        End Sub

        Protected Overrides Sub Init_Engine_Controls()

            SetTestStepList(0)

        End Sub

        'Use Delegate for Cross Thread Operation
        Private Delegate Sub SetTestStepListDelegate(ByVal value As Integer)
        Protected Overrides Sub SetTestStepList(ByVal value As Integer)

            If (Me.cmbTestStepList.InvokeRequired) Then
                Me.cmbTestStepList.BeginInvoke(New SetTestStepListDelegate(AddressOf Me.SetTestStepList), value)
            Else
                cmbTestStepList.SelectedIndex = value
            End If
        End Sub

        Private Sub ResetOutputsOnCLose()


            If Not (BLEED_BTN Is Nothing) Then
                BLEED_BTN.Value = Values.False 'Turn OFF the Bleed demand
            End If

        End Sub


        Protected Overrides Sub OnEngineWorkingThread()

            'The Fuel mass flow meter gives us directly the value
            WF_CAL.Value = WF_RAW_PPH.Value

            Compute(False) 'Compute all Performance parameters
            'LoadBankCtrl.Rampdown()
            'CheckLoadBankPhase()

            'Make sure FM_INITIAL_VOLUME_LITERS is different than 0
            ValidateFMInitialValue()

            'Persistent Values Save Check
            APS2000PersistentValuesCtrl.SavePersistentValues(False)


            If SendStopCmdToFadec Then
                SendStopToFadec()
            End If

        End Sub

        Protected Overrides Sub Compute(ByVal CalulateForLogAndPerformanceReports As Boolean)

            Try
                If CalulateForLogAndPerformanceReports Then

                    LOG_PERF_WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(LOG_PERF_T_ORIFICE_DEGF.Value.ToDouble(), _
                                                                                                 LOG_PERF_P_ORIFICE_PSIA.Value.ToDouble(), _
                                                                                                 LOG_PERF_P_ORIFICE_DELTA_INH2OD.Value.ToDouble))

                    FlowmeterCtrl.ComputeFlow(True)

                    'IMPORTANT: Toutes les variables flottantes telles que WB_CALC, DELPB, LB_DEMAND dont la source et la destination sont vides doivent
                    'manuellement être updaté pour être inscrite dans le LOG ou le PERF report.
                Else

                    WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(T_ORIFICE_DEGF.Value.ToDouble(), _
                                                                                      P_ORIFICE_PSIA.Value.ToDouble(), _
                                                                                     P_ORIFICE_DELTA_INH2OD.Value.ToDouble))

                End If

            Catch ex As Exception
                MessageBox.Show("Compute_APS2000" + ex.ToString(), "Error")
            End Try

        End Sub

        Private Sub ValidateFMInitialValue()

            Try

                'Read the mass flow meter value, the value cannot be 0
                If FM_INITIAL_VOLUME_LITERS.Value.ToDouble() = 0.0 Then
                    FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())
                End If

            Catch Ex As Exception
                MessageBox.Show("ValidateFMInitialValue: " & Ex.ToString())
            End Try

        End Sub
        Private Function Compute_BleedAirFlow(ByVal TOrifice_DEGF As Double, _
                                                ByVal POrifice_PSIA As Double, _
                                                ByVal POrificeDelta_INH2OD As Double) As Double
            Try


                If CELProject.IsTrue(BLEED_BTN.Value) Then
                    Dim BleedAirFLow As Double = CELProject.GetBleedAirFlow( _
                            EngineConfiguration.DuctDiameter, _
                            EngineConfiguration.DuctDiameterUnit, _
                            EngineConfiguration.OrificeDiameter, _
                            EngineConfiguration.OrificeDiameterUnit, _
                            TOrifice_DEGF, _
                            CELDAS.eTemperature.Fahrenheit, _
                            POrifice_PSIA, _
                            CELDAS.ePressure.PSI, _
                            POrificeDelta_INH2OD, _
                            CELDAS.ePressure.InchesH2O, _
                            EngineConfiguration.OrificeThinkness, _
                            EngineConfiguration.OrificeThinknessUnit, _
                            EngineConfiguration.TapArrangement, _
                            CELDAS.eFlowMass.LbByMin)

                    Return BleedAirFLow

                Else
                    Return 0.0
                End If

            Catch Ex As Exception

                MessageBox.Show("APS2000_Sequence.Compute_BleedAirFlow: " & Ex.ToString)
                Return Double.NaN

            End Try
        End Function

        Protected Overrides Sub OnCLOSE_TEST_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    MyBase.StopWorkingThread()

                    RemoveHandlers()

                    'Persistent Values Force Save
                    APS2000PersistentValuesCtrl.SavePersistentValues(True)

                    ResetOutputsOnCLose() 'Reset Switches

                    Init_Engine_Channels_Value() 'Reinit variables before we quit

                    Dispose_Engine_Controllers()


                    CELProject.CLOSE_TEST_BTN.Value = Values.False

                End If

            Catch ex As Exception
                MessageBox.Show("OnClose_Test: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub
        Protected Overrides Sub OnPERF_CLOSE_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            If CELProject.IsTrue(newVal) Then

                CELProject.ActivateForm("APS2000_Performance_Screen", "APS2000_Screen", False, False)
                CELProject.PERF_CLOSE_WINDOW_BTN.Value = Values.False

            End If
        End Sub
        Protected Overrides Sub OnPERF_OPEN_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            If CELProject.IsTrue(newVal) Then

                CELProject.ActivateForm("APS2000_Performance_Screen", "APS2000_Screen", True, False)
                CELProject.PERF_OPEN_WINDOW_BTN.Value = Values.False

            End If
        End Sub


        Protected Overrides Sub OnLOG_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    'Update the Log/Perf channel set
                    CELProject.LogPerfSynch.UpdateValues()

                    'Synchronize data for Log and Performance
                    Compute(True)

                    CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, False, "APS2000", True)
                    CELProject.LOG_TAKE_POINT_BTN.Value = Values.False
                End If

            Catch Ex As Exception
                MessageBox.Show("OnLOG_TAKE_POINT_BTN: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnLOUVERS_CLOSED(ByVal sender As IChannel, ByVal newVal As Value)
            If (CELProject.IsFalse(newVal)) Then

                Try

                    SendStopCmdToFadec = True

                Catch ex As System.Exception
                    MessageBox.Show("OnLOUVERS_CLOSED: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                End Try

            End If
        End Sub
        Private SendStopCmdToFadec As Boolean = False
        Private Sub SendStopToFadec()

            SendStopCmdToFadec = False

            RUN_STOP_BTN.Value = Values.False 'STOP
            Thread.Sleep(200)
            RUN_STOP_BTN.Value = Values.True 'RUN
            Thread.Sleep(200)
            RUN_STOP_BTN.Value = Values.False 'STOP

        End Sub

