            If CELProject.IsTrue(newVal) Then

                'ON NE RESET PLUS LES VALEURS PERSISTENTES SUR UN NEW TEST

            End If
        End Sub

        Protected Overrides Sub OnPERF_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            Dim SearchPath As String
            Dim excelWorkbook As Excel.Workbook = Nothing

            Try
                If CELProject.IsTrue(newVal) Then

                    'Update the Log/Perf channel set
                    CELProject.LogPerfSynch.UpdateValues()

                    'Synchronize data for Log and Performance
                    Compute(True)

                    SearchPath = CELProject.EngineSession.PerfFolder

                    Dim NewFileCreated As Boolean

                    Select Case CELProject.Project.Number
                        Case 10718
                            'Not Supported in this project
                            Debug.Assert(False)

                            'Dim StandardCELTemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile ' Case ePerfReportAPS2000.AirbusAcceptance is the default

                            ''Do Not Delete this line
                            ''CELProject.ProcessPerformanceReport(SearchPath, StandardCELTemplateReportFullFileName, AddressOf CreateStandardCELPerformanceFile)

                            ''Select Case PerformaceReportSelected 'Hamilton Sundstrand Report, Airbus Test Data Sheet, Airbus Repair Test Datasheet
                            ''    Case ePerfReportAPS2000.AirbusAcceptance
                            ''        workbookPath += " PerformanceAirbusAcceptance.xlsx"
                            ''    Case ePerfReportAPS2000.AirbusRepairAcceptance
                            ''        workbookPath += " PerformanceAirbusRepairAcceptance.xlsx"
                            ''End Select
                            'Select Case PerformaceReportSelected 'Hamilton Sundstrand Report, Airbus Test Data Sheet, Airbus Repair Test Datasheet
                            '    Case ePerfReportAPS2000.AirbusAcceptance
                            '        'Default Name ==> Nothing todo StandardCELTemplateReportFullFileName = " PerformanceAirbusAcceptance.xlsx"
                            '    Case ePerfReportAPS2000.AirbusRepairAcceptance
                            '        StandardCELTemplateReportFullFileName = StandardCELTemplateReportFullFileName.Replace("PerformanceAirbusAcceptance", " PerformanceAirbusRepairAcceptance")
                            'End Select

                            ''NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, StandardCELTemplateReportFullFileName, AddressOf CreatePerformanceFileHSPologne10718)
                        Case 10726
                            'Not Supported in this project
                            Debug.Assert(False)

                        Case 12917
                            Dim Revima12917TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                            NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, Revima12917TemplateReportFullFileName, AddressOf CreatePerformanceFileRevima12917)

                        Case 11813
                            'Not Supported in this project
                            Debug.Assert(False)
                    End Select


                    CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, True, "APS2000", NewFileCreated)

                    PERF_POINT_TAKEN.Value = Values.True
                    System.Threading.Thread.Sleep(1000)
                    PERF_POINT_TAKEN.Value = Values.False

                    'CELProject.PERF_TAKE_POINT_BTN.Value = Values.False 'Cette ligne crée un bug avec le pupout du bouton lorsqu'il est en AutoReturn
                End If

            Catch ex As Exception
                MessageBox.Show("OnPERF_TAKE_POINT_BTN: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally

            End Try
        End Sub

