                Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_ORIFICE_PSIA, "LOG_PERF_P_ORIFICE_PSIA"))
                Return_Value.Add(MyBase.InitializeChannel(P_ORIFICE_DELTA_INH2OD, "P_ORIFICE_DELTA_INH2OD"))
                Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_ORIFICE_DELTA_INH2OD, "LOG_PERF_P_ORIFICE_DELTA_INH2OD"))

                Return_Value.Add(MyBase.InitializeChannel(READY_TO_LOAD_IND, "READY_TO_LOAD_IND"))
                Return_Value.Add(MyBase.InitializeChannel(RUN_STOP_BTN, "RUN_STOP_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(T_ORIFICE_DEGF, "T_ORIFICE_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_ORIFICE_DEGF, "LOG_PERF_T_ORIFICE_DEGF"))

                Return_Value.Add(MyBase.InitializeChannel(WB_CALC, "WB_CALC"))

                Return_Value.Add(MyBase.InitializeChannel(WF_CAL, "WF_CAL"))
                Return_Value.Add(MyBase.InitializeChannel(WF_RAW_PPH, "WF_RAW_PPH"))

                Return_Value.Add(MyBase.InitializeChannel(OPERATING_TIME_CURRENT_SEC, "OPERATING_TIME_CURRENT_SEC"))

                'End Select
            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.ToString())
                Return_Value.Add(False)
            Finally

            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function

        Private Sub TestProgress_Initialize()
            Dim dataInfo As CEL.TestProgress.TestProgressMgr.TestProgress_DataInfo

            dataInfo.EngineStartEventChannelName = "START_BTN"
            dataInfo.EngineStartEventChannelValue = True
            dataInfo.EngineStartEventDescription = "Mise en route"
            dataInfo.EngineStartEventRecordTime = True
            dataInfo.EngineStopEventChannelName = "STOP_CMD_LOGIC"
            dataInfo.EngineStopEventChannelValue = True
            dataInfo.EngineStopEventDescription = "Arrêt moteur - Temps d'arrêt (s): "
            dataInfo.EngineStopEventRecordTime = True
            dataInfo.TestProgressFrameName = CELProject.EngineModel.Replace("-", "_") + "_Screen.fraTestProgressHorizontal"
            dataInfo.TestProgressSheetFileName = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
            dataInfo.UUTModel = CELProject.EngineModel
            dataInfo.UUTSerialNumber = Me.UserInputs.EngineSerialNumber
            dataInfo.UUTWorkOrder = Me.UserInputs.WorkOrder
            Me.TestProgressMgr = New CEL.TestProgress.TestProgressMgr(dataInfo)
        End Sub

        Private Sub TestProgress_RecordPerfStep(testStep As eTestStepAPS2000)
            If Me.TestProgressMgr IsNot Nothing Then
                Dim sheetEntry As CEL.TestProgress.TestProgressSheetEntry = Nothing

                Dim checkItemPBCOR As String = "Corrected Bleed Pressure - Min: " + _
                    Me.LOG_PERF_P_BLEED_COR_PSIA_LIMITS.Value.ToString(LOG_PERF_P_BLEED_COR_PSIA_LIMITS.Format, Nothing) + " Read: " + _
                    Me.LOG_PERF_P_BLEED_COR_PSIA.Value.ToString(LOG_PERF_P_BLEED_COR_PSIA.Format, Nothing) + " psia"
                Dim checkItemWBCOR As String = "Corrected Bleed Airflow - Min: " + _
                    Me.LOG_PERF_WB_COR_PPM_LIMITS.Value.ToString(LOG_PERF_WB_COR_PPM_LIMITS.Format, Nothing) + " Read: " + _
                    Me.LOG_PERF_WB_COR_PPM.Value.ToString(LOG_PERF_WB_COR_PPM.Format, Nothing) + " PPM"
                Dim checkItemTB As String = "Bleed Temperature - Max: " + _
                    Me.LOG_PERF_T_BLEED_DEGF_LIMITS.Value.ToString(LOG_PERF_T_BLEED_DEGF_LIMITS.Format, Nothing) + " Read: " + _
                    Me.LOG_PERF_T_BLEED_DEGF.Value.ToString(LOG_PERF_T_BLEED_DEGF.Format, Nothing) + " °F"
                Dim checkItemEGTCOR As String = "Corrected Exhaust Gas Temperature - Max: " + _
                    Me.LOG_PERF_T_EGT_COR_DEGF_LIMITS.Value.ToString(LOG_PERF_T_EGT_COR_DEGF_LIMITS.Format, Nothing) + " Read: " + _
                    Me.LOG_PERF_T_EGT_COR_DEGF.Value.ToString(LOG_PERF_T_EGT_COR_DEGF.Format, Nothing) + " °F"
                Dim checkitemEGTSetP As String = "EGT Set Point - Read: " + _
                    Me.LOG_PERF_T_EGT_SET_POINT_DEGF.Value.ToString(LOG_PERF_T_EGT_SET_POINT_DEGF.Format, Nothing) + " °F"
                Dim checkItemEGTSpread As String = "EGT Spread - Max: 250 Read: " + _
                    Me.LOG_PERF_T_EGT_P_SPREAD_DEGF.Value.ToString(LOG_PERF_T_EGT_P_SPREAD_DEGF.Format, Nothing) + " °F"
                Dim checkItemSHPCOR As String = "Corrected Shaft Horse Power - Read: " + _
                    Me.LOG_PERF_GEN_COR_SHP.Value.ToString(LOG_PERF_GEN_COR_SHP.Format, Nothing) + " HP"
                Dim checkItemWF As String = "Fuel Consumption - Read: " + _
                    Me.LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing) + " pph"
                Dim checkItemVIBGBA As String = "Unit Vibration Gearbox - Max: 10 Read: " + _
                    Me.LOG_PERF_VIB_GEARBOX_G_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_G_PEAK.Format, Nothing) + " g"
                Dim checkItemVIBTHA As String = "Unit Vibration Turbine - Max: 10 Read: " + _
                    Me.LOG_PERF_VIB_POWER_SECTION_G_PEAK.Value.ToString(LOG_PERF_VIB_POWER_SECTION_G_PEAK.Format, Nothing) + " g"

                Select Case testStep
                    Case eTestStepAPS2000.STEP2
                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "RTL", {checkItemEGTSpread, checkItemWF, _
                                                                                                       checkItemVIBGBA, checkItemVIBTHA})
                    Case eTestStepAPS2000.STEP3
                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Shaft Load Only 61.5±2 SHP", _
                                                                                 {checkItemEGTCOR, checkItemEGTSpread, checkItemSHPCOR, _
                                                                                  checkItemWF, checkItemVIBGBA, checkItemVIBTHA})
                    Case eTestStepAPS2000.STEP5
                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Bleed Flow Only", _
                                                                                 {checkItemPBCOR, checkItemWBCOR, checkItemTB, _
                                                                                  checkitemEGTSetP, checkItemEGTSpread, _
                                                                                  checkItemWF, checkItemVIBGBA, checkItemVIBTHA})
                    Case eTestStepAPS2000.STEP7
                        sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(String.Empty, "Bleed Flow and 60±2 SHP", _
                                                                                 {checkitemEGTSetP, checkItemEGTSpread, checkItemSHPCOR, _
                                                                                  checkItemWF, checkItemVIBGBA, checkItemVIBTHA})
                End Select

                If sheetEntry IsNot Nothing Then
                    Me.TestProgressMgr.AddTestProgressEntry(sheetEntry)
                End If
            End If
        End Sub

        Private Sub TestProgress_Save()
            If Not Me.TestProgressMgr Is Nothing Then
                TestProgress_UpdateProgressSheetHeader(Me.TestProgressMgr.TestProgressSheet)
                Dim fileName As String = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
                Dim settings As Xml.XmlWriterSettings = New Xml.XmlWriterSettings()
                settings.Indent = True

                Using writer As Xml.XmlWriter = Xml.XmlWriter.Create(fileName, settings)
                    Dim xslPath As String = "type=""text/xsl"" href=""" + Application.StartupPath + "/TestProgressSheet.xsl"""
                    writer.WriteProcessingInstruction("xml-stylesheet", xslPath)
                    Dim ser As New Xml.Serialization.XmlSerializer(GetType(CEL.TestProgress.TestProgressSheet))
                    ser.Serialize(writer, Me.TestProgressMgr.TestProgressSheet)
                End Using
            End If
        End Sub

        Private Sub TestProgress_UpdateProgressSheetHeader(progressSheet As CEL.TestProgress.TestProgressSheet)
            progressSheet.Header("No capteur de vibration moteur") = Me.UserInputs.EngineVibrationPickupSerialNumber
            progressSheet.Header("No capteur de vibration accessoire") = Me.UserInputs.GearboxVibrationPickupSerialNumber
            progressSheet.Header("No Capt. frein") = Me.UserInputs.LoadCellSerialNumber
            progressSheet.Header("Type d'huile") = Me.UserInputs.OilType
            progressSheet.Header("Quantité totale Jet A1") = Me.FUEL_USED_TOTAL_LITERS.Value.ToString()
            Dim runningTime As System.TimeSpan = System.TimeSpan.FromSeconds(Me.OPERATING_TIME_CURRENT_SEC.Value.ToDouble())
            progressSheet.Header("Temps de fonctionnement") = Math.Floor(runningTime.TotalHours).ToString() + _
                " h " + runningTime.Minutes.ToString("00")
        End Sub

