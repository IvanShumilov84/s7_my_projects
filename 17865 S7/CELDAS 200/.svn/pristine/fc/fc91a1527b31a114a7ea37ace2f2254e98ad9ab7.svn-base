        Protected Overrides Sub OnTestStep_List_SelectedIndexChanged(ByVal sender As System.Object, ByVal e As System.EventArgs)
            Try
                CELProject.PERF_TEST_STEP_NB.Value = New KineticaRT.Values.Integer(cmbTestStepList.SelectedIndex)


                Select Case cmbTestStepList.SelectedIndex
                    Case 0 : CELProject.PERF_TEST_STEP_NB.Value = New KineticaRT.Values.Integer(2)
                    Case 1 : CELProject.PERF_TEST_STEP_NB.Value = New KineticaRT.Values.Integer(3)
                    Case 2 : CELProject.PERF_TEST_STEP_NB.Value = New KineticaRT.Values.Integer(5)
                    Case 3 : CELProject.PERF_TEST_STEP_NB.Value = New KineticaRT.Values.Integer(7)
                    Case 4 : CELProject.PERF_TEST_STEP_NB.Value = New KineticaRT.Values.Integer(8)

                End Select

                Test_Step_Description = cmbTestStepList.SelectedItem

            Catch ex As Exception
                MessageBox.Show("OnTestStep_List_SelectedIndexChanged: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            Finally
            End Try
        End Sub


        Protected Overrides Sub OnTestSessionClosing(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                MyBase.OnTestSessionClosing(newStatus)

                Select Case CELProject.EngineModel
                    Case "APS2000"

                        If Not (FlowmeterCtrl Is Nothing) Then
                            FlowmeterCtrl.Dispose()
                        End If

                        If TestProgressMgr IsNot Nothing Then
                            TestProgress_Save()
                            TestProgressMgr.Dispose()
                            TestProgressMgr = Nothing
                        End If
                End Select

            Catch ex As Exception
                MessageBox.Show("OnTestSessionClosing: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionInitialized(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionInitialized(newStatus)

                If CELProject.EngineModel = "APS2000" Then

                    UserInputs.MapUserInputsParameters(CELProject)

                    CELProject.EngineSession.WorkingFolder = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + UserInputs.EngineSerialNumber + "\" + UserInputs.WorkOrder

                    CELProject.CreateLogFile(AddressOf CreateCustomHeaderLogFile, "APS2000")

                End If
            Catch ex As Exception
                MessageBox.Show("OnTestSessionInitialized: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)

            Catch ex As Exception

                MessageBox.Show("APS2000_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            End Try
        End Sub

        Protected Overrides Sub OnTestSessionRunning(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            'Dim i As Integer
            Try
                MyBase.OnTestSessionRunning(newStatus)

                If CELProject.EngineModel = "APS2000" Then

                    Init_Engine_Channels()
                    CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.Init_Engine_Controls)) 'Must be after Init_Engine Channels

                    CELProject.LoadSave_Custom_Parameters(Custom_Parameters, False) 'Load some parameters value from database


                    Init_Engine_Controllers()

                    AddHandlers()

                    Init_Engine_Channels_Value()

                    MyBase.StartWorkingThread()

                    TestProgress_Initialize()

                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionRunning: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub
        Protected Overrides Sub Init_Engine_Controllers()

            NumberOfTInletProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/APS2000/T_INLET_NUMBER_PROBE", 0)
            NumberOfTEgtProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/APS2000/T_EGT_NUMBER_PROBE", 0)
            NumberOfTBleedProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/APS2000/T_BLEED_NUMBER_PROBE", 0)

            Debug.Assert(NumberOfTInletProbe <> 0 And NumberOfTEgtProbe <> 0 And NumberOfTBleedProbe <> 0)


            Dim PersistentValuesChannels() As String = {"NUMBER_OF_STARTS", _
                                                         "OPERATING_TIME_CURRENT_SEC", _
                                                         "FUEL_USED_INITIAL_LITERS", "FUEL_USED_TOTAL_LITERS"}


            Dim PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputs.EngineSerialNumber & "\" & UserInputs.WorkOrder & "\Log\PersistentValues.xml"
            APS2000PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)


            'OPERATING_TIME_INITIAL_HOURS.Value = New KineticaRT.Values.Double(OPERATING_TIME_TOTAL_HOURS.Value.ToDouble())
            Dim FuelUsedTotal As Double = FUEL_USED_TOTAL_LITERS.Value.ToDouble()
            FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())
            FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FuelUsedTotal)

            'UpdateTBleedChannels()
            'not used for only one probe of TBLEED DeletableTBleedChCtrl = New DeletableChannelController(Me, NumberOfTBleedProbe, NumberOfTBleedProbe, "T_BLEED_SOURCE", "_DEGF", Nothing, Nothing, Nothing, Nothing, Nothing)
            DeletableTInletChCtrl = New DeletableChannelController(Me, NumberOfTInletProbe, 3, 2, "T_INLET", "_DEGF", "_DELETE_BTN", "T_INLET_AVG_DEGF", "T_INLET_MIN_DEGF", "T_INLET_MAX_DEGF", "T_INLET_SPREAD_DEGF")
            DeletableTEgtChCtrl = New DeletableChannelController(Me, NumberOfTEgtProbe, 6, NumberOfTEgtProbe, "T_EGT", "_DEGF", "_DELETE_BTN", "T_EGT_AVG_DEGF", "T_EGT_MIN_DEGF", "T_EGT_MAX_DEGF", "T_EGT_SPREAD_DEGF")

            FlowmeterCtrl = New FlowmeterController(Me)

            StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_CURRENT_AMP", "STARTER_CURRENT_MAX_AMP", "START_BTN")
            StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_VOLTAGE_VDC", "STARTER_VOLTAGE_MAX_VDC", "START_BTN")
            StarterMaxIgnitionVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "IGNITION_VOLTAGE_VDC", "IGNITION_VOLTAGE_VDC_MAX", "START_BTN")


            'Configuring Load Bank Control
            Dim myLBData As LoadBankController.LB_DataInfo

            myLBData.FanEnableBtnChannelName = "LB1_FAN_ENABLE_BTN"
            myLBData.FanEnableChannelName = "LB1_FAN_ENABLE_CMD"
            myLBData.EnableChannelName = "LB_LOAD_BTN"

            myLBData.DemandChannelName = "LB1_DEMAND"
            myLBData.UpDemandChannelName = "LB1_UP_DEMAND_BTN"
            myLBData.DownDemandChannelName = "LB1_DOWN_DEMAND_BTN"
            myLBData.DemandChannelIncrementName = "LB1_DEMAND_INCREMENT"
            myLBData.FrameName = "APS2000_Screen.fraControlSystem.fraLoadBankControl" 'TODO utiler le search control
            myLBData.DisplayName = "dspLB_DEMAND"
            myLBData.InitialDemandChannelName = Nothing


            myLBData.ThreadSpeedMsec = 250 'msec
            myLBData.Maximum = 110
            myLBData.DelestageKwpersec = 10 'instant delestage
            myLBData.FanCoolDownSeconds = 300
            myLBData.Memorize = False
            myLBData.Increment = 1
            myLBData.BtnLatchSeconds = 0
            myLBData.FanEnableChannelPulseName = Nothing
            myLBData.FanStopChannelPulseName = Nothing
            myLBData.PulseEnableInitialType = False
            myLBData.PulseStopInitialType = False

            If CELProject.Project.Number = "12917" Then 'Value Specific to the Revima project

                myLBData.FieldFlashingTimeMsec = 1000
                myLBData.FieldFlashingSignalName = "FIELD_FLASHING"
                myLBData.FieldFlashingTriggerSignalName = "LB_GCU_BTN"

            Else
                myLBData.FieldFlashingTimeMsec = 0  'no field flashing
                myLBData.FieldFlashingSignalName = Nothing
                myLBData.FieldFlashingTriggerSignalName = Nothing

            End If

            LoadBankCtrl = New LoadBankController(myLBData)

            'Configuring Load Bank Stage Values
            LoadBankCtrl.AddStage(1, "LB1_1")
            LoadBankCtrl.AddStage(2, "LB1_2")
            LoadBankCtrl.AddStage(2, "LB1_3")
            LoadBankCtrl.AddStage(5, "LB1_4")
            LoadBankCtrl.AddStage(5, "LB1_5")
            LoadBankCtrl.AddStage(10, "LB1_6")
            LoadBankCtrl.AddStage(25, "LB1_7")
            LoadBankCtrl.AddStage(50, "LB1_8")
            LoadBankCtrl.AddStage(100, "LB1_9")
            LoadBankCtrl.AddStage(100, "LB1_10")
            LoadBankCtrl.AddStage(100, "LB1_11")
            LoadBankCtrl.AddCurrentPhases("LB_CURRENT_A_AMP", "LB_CURRENT_B_AMP", "LB_CURRENT_C_AMP", 20)
            LoadBankCtrl.AddVoltagePhases("LB_VOLTAGE_AB_VAC", "LB_VOLTAGE_BC_VAC", "LB_VOLTAGE_CA_VAC", 20)
            LoadBankCtrl.StartWorkerThread(250)
        End Sub
        Protected Overrides Sub Dispose_Engine_Controllers()

            If Not (DeletableTBleedChCtrl Is Nothing) Then
                DeletableTBleedChCtrl.Dispose()
            End If

            If Not (DeletableTEgtChCtrl Is Nothing) Then
                DeletableTEgtChCtrl.Dispose()
            End If

            If Not (DeletableTInletChCtrl Is Nothing) Then
                DeletableTInletChCtrl.Dispose()
            End If

            'Disposing of Collection
            If Not (LoadBankCtrl Is Nothing) Then
                LoadBankCtrl.Dispose()
            End If


            If Not (APS2000PersistentValuesCtrl Is Nothing) Then
                APS2000PersistentValuesCtrl.Dispose()
            End If

            StarterMaxCurrentRecordCtrl.Dispose()
            StarterMaxCurrentRecordCtrl.Dispose()
            StarterMaxIgnitionVoltageRecordCtrl.Dispose()

            If Not (FlowmeterCtrl Is Nothing) Then
                FlowmeterCtrl.Dispose()
            End If
        End Sub
        Protected Overrides Sub AddHandlers()

            'Close_test Must Be first
            AddHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnCLOSE_TEST_BTN

            AddHandler CELProject.PERF_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnPERF_OPEN_WINDOW_BTN
            AddHandler CELProject.PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
            AddHandler CELProject.PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN
            AddHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            AddHandler CELProject.NEW_TEST_BTN.ValueChanged, AddressOf OnNEW_TEST_BTN

            AddHandler E_STOP_TRIP_OPC.ValueChanged, AddressOf OnTrip
            AddHandler LOUVERS_IND.ValueChanged, AddressOf OnLOUVERS_CLOSED

            AddHandler READY_TO_LOAD_IND.ValueChanged, AddressOf OnReadyToLoad
            AddHandler cmbTestStepList.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged

        End Sub
        Protected Overrides Sub RemoveHandlers()


            If Not (CELProject.CLOSE_TEST_BTN Is Nothing) Then
                RemoveHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnCLOSE_TEST_BTN
            End If

            If Not (CELProject.PERF_CLOSE_WINDOW_BTN Is Nothing) Then
                RemoveHandler CELProject.PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
            End If

            If Not (CELProject.LOG_TAKE_POINT_BTN Is Nothing) Then
                RemoveHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            End If
            If Not (LOUVERS_IND Is Nothing) Then
                RemoveHandler LOUVERS_IND.ValueChanged, AddressOf OnLOUVERS_CLOSED
            End If

            If Not (CELProject.NEW_TEST_BTN Is Nothing) Then
                RemoveHandler CELProject.NEW_TEST_BTN.ValueChanged, AddressOf OnNEW_TEST_BTN
            End If

            If Not (E_STOP_TRIP_OPC Is Nothing) Then
                RemoveHandler E_STOP_TRIP_OPC.ValueChanged, AddressOf OnTrip
            End If

            If Not (CELProject.PERF_OPEN_WINDOW_BTN Is Nothing) Then
                RemoveHandler CELProject.PERF_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnPERF_OPEN_WINDOW_BTN
            End If

            If Not (CELProject.PERF_TAKE_POINT_BTN Is Nothing) Then
                RemoveHandler CELProject.PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN
            End If

            If Not (READY_TO_LOAD_IND Is Nothing) Then
                RemoveHandler READY_TO_LOAD_IND.ValueChanged, AddressOf OnReadyToLoad
            End If

            If Not (cmbTestStepList Is Nothing) Then
                RemoveHandler cmbTestStepList.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged
            End If

        End Sub
