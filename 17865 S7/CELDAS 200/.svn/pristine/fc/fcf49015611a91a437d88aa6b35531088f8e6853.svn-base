                            excelWorksheet.Cells(22, 7).Value = LOG_PERF_T_OIL_DEGC.Value.ToString(LOG_PERF_T_OIL_DEGC.Format, Nothing)
                        End If

                        excelWorksheet.Cells(23, 7).Value = LOG_PERF_T_FUEL_DEGC.Value.ToString(LOG_PERF_T_FUEL_DEGC.Format, Nothing)
