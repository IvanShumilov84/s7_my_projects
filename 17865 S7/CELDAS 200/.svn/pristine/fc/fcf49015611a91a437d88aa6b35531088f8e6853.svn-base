                        excelWorksheet.Cells(25, 7).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(26, 7).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(27, 7).Value = LOG_PERF_NG_RPM.Value.ToString(LOG_PERF_NG_RPM.Format, Nothing)
                        excelWorksheet.Cells(28, 7).Value = LOG_PERF_ARINC_IGV_POS.Value.ToString(LOG_PERF_ARINC_IGV_POS.Format, Nothing)
                        excelWorksheet.Cells(29, 7).Value = LOG_PERF_T_EGT_P_AVG_DEGC.Value.ToString(LOG_PERF_T_EGT_P_AVG_DEGC.Format, Nothing)
                        excelWorksheet.Cells(30, 7).Value = LOG_PERF_T_EGT_AVG_DEGC.Value.ToString(LOG_PERF_T_EGT_AVG_DEGC.Format, Nothing)
                        excelWorksheet.Cells(31, 7).Value = LOG_PERF_BLEED_VALVE_POSITION.Value.ToString(LOG_PERF_BLEED_VALVE_POSITION.Format, Nothing)
                        excelWorksheet.Cells(32, 7).Value = LOG_PERF_P_ORIFICE_KPAA.Value.ToString(LOG_PERF_P_ORIFICE_KPAA.Format, Nothing)
                        excelWorksheet.Cells(33, 7).Value = LOG_PERF_T_ORIFICE_DEGC.Value.ToString(LOG_PERF_T_ORIFICE_DEGC.Format, Nothing)
                        excelWorksheet.Cells(34, 7).Value = LOG_PERF_P_ORIFICE_DELTA_KPAD.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_KPAD.Format, Nothing)
                        excelWorksheet.Cells(35, 7).Value = LOG_PERF_WB_KGPS.Value.ToString(LOG_PERF_WB_KGPS.Format, Nothing)
                        excelWorksheet.Cells(36, 7).Value = LOG_PERF_P_BVC_KPAA.Value.ToString(LOG_PERF_P_BVC_KPAA.Format, Nothing)
                        excelWorksheet.Cells(37, 7).Value = LOG_PERF_T_BVC_AVG_DEGC.Value.ToString(LOG_PERF_T_BVC_AVG_DEGC.Format, Nothing)
                        excelWorksheet.Cells(38, 7).Value = LOG_PERF_WF_KGH.Value.ToString(LOG_PERF_WF_KGH.Format, Nothing)
                        excelWorksheet.Cells(39, 7).Value = GENERATOR_POWER_KW_MEAN.Value.ToString(GENERATOR_POWER_KW_MEAN.Format, Nothing)
                        excelWorksheet.Cells(40, 7).Value = LOG_PERF_WB_NORM_KGPS.Value.ToString(LOG_PERF_WB_NORM_KGPS.Format, Nothing)

                        excelWorksheet.Cells(41, 7).Value = LOG_PERF_HR_MTR_1.Value.ToString(LOG_PERF_HR_MTR_1.Format, Nothing)
                        excelWorksheet.Cells(42, 7).Value = LOG_PERF_EVENT_1.Value.ToString(LOG_PERF_EVENT_1.Format, Nothing)
                        excelWorksheet.Cells(43, 7).Value = LOG_PERF_HR_MTR_2.Value.ToString(LOG_PERF_HR_MTR_2.Format, Nothing)
                        excelWorksheet.Cells(44, 7).Value = LOG_PERF_EVENT_2.Value.ToString(LOG_PERF_EVENT_2.Format, Nothing)


                    Case eTestStepAPS32X0.MES

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Detail

                        'Performed Test Details section
                        If CELProject.IsTrue(MINIMUM_SURGE_MARGIN_TEST_PASSED.Value) Then
                            excelWorksheet.Cells(31, 10).Value = "PASSED"
                        Else
                            excelWorksheet.Cells(31, 10).Value = "FAILED"
                        End If

                    Case eTestStepAPS32X0.FINAL_DATA

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        Dim OperatingTime As Double = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToDouble()
                        Dim NbStart As Double = NUMBER_OF_STARTS.Value.ToDouble()

                        excelWorksheet.Cells(32, 10).Value = ET_CRANK.Value.ToString()
                        excelWorksheet.Cells(33, 10).Value = START_TIME_OPC_SEC.Value.ToString()
                        excelWorksheet.Cells(34, 10).Value = RUNDOWN_TIME_OPC_SEC.Value.ToString()
                        excelWorksheet.Cells(35, 10).Value = T_ETC_PEAK_START_DEGC.Value.ToString()
                        excelWorksheet.Cells(36, 10).Value = P_OIL_AT_60KW_SHAFT_LOAD_KPAG.Value.ToString()
                        excelWorksheet.Cells(37, 10).Value = T_OIL_AT_60KW_SHAFT_LOAD_DEGC.Value.ToString()
                        excelWorksheet.Cells(38, 10).Value = NbStart.ToString(NUMBER_OF_STARTS.Format) 'NUMBER_OF_STARTS.Value.ToString()
                        excelWorksheet.Cells(39, 10).Value = OperatingTime.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format) 'OPERATING_TIME_TEXT.Value.ToString()
                        excelWorksheet.Cells(40, 10).Value = LOG_PERF_FUEL_USED_TOTAL_LITERS.Value.ToString(LOG_PERF_FUEL_USED_TOTAL_LITERS.Format, Nothing)
                        excelWorksheet.Cells(41, 10).Value = NUMBER_APU_FAULT_SEEN_DURING_TEST.Value.ToString()


                End Select

                currentSheet = "ACCEPTANCE"
                excelWorksheet = excelSheets.Item(currentSheet)

                'Test Result
                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value) Then
                    excelWorksheet.OLEObjects("chkTestResultAccepted").object.value = True
                Else
                    excelWorksheet.OLEObjects("chkTestResultAccepted").object.value = False
                End If

                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value) Then
                    excelWorksheet.OLEObjects("chkTestResultRejected").object.value = True
                Else
                    excelWorksheet.OLEObjects("chkTestResultRejected").object.value = False
                End If

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreatePerformanceFileRevima12917 = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)
            End Try

        End Function

        Private Function CreatePerformanceFileChine11813(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim currentSheet As String
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreatePerformanceFileChine11813 = True

            Try

                ' The following gets the Worksheets collection
                excelSheets = excelWorkbook.Worksheets
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    currentSheet = "SUMMARY"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    Dim row As Integer = 5
                    Dim column As Integer = 3

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsChine.EngineSerialNumber
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsChine.WorkOrder
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsChine.EcbSerialNumber
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
