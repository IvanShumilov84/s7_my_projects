                Return_Value.Add(MyBase.InitializeChannel(PB_COR_HS_KPAA, "PB_COR_HS_KPAA"))
                Return_Value.Add(MyBase.InitializeChannel(RTL, "APU_AVAILABLE_IND"))
                Return_Value.Add(MyBase.InitializeChannel(SHP_COR_NORM_KW_MEAN, "SHP_COR_NORM_KW_MEAN"))
