                        excelWorksheet.Cells(27, 6).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)

                        excelWorksheet.Cells(44, 10).Value = LOG_PERF_NG_RPM.Value.ToString(LOG_PERF_NG_RPM.Format, Nothing)


                        Chine11813WritePointInPerfDetails(excelSheets.Item("DETAILS"), 9, False, False, False)

                    Case eTestStepAPS32X0.SHAFT_LOAD

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        excelWorksheet.Cells(23, 8).Value = LOG_PERF_EGT_COR_DEGC.Value.ToString(LOG_PERF_EGT_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(24, 8).Value = LOG_PERF_WF_COR_KGPH.Value.ToString(LOG_PERF_WF_COR_KGPH.Format, Nothing)
