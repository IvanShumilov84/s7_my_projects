                        excelWorksheet.Cells(20, 11).Value = LOG_PERF_PB_COR_KPAA.Value.ToString(LOG_PERF_PB_COR_KPAA.Format, Nothing)
                        excelWorksheet.Cells(21, 11).Value = LOG_PERF_WB_COR_KGPS.Value.ToString(LOG_PERF_WB_COR_KGPS.Format, Nothing)
                        excelWorksheet.Cells(22, 11).Value = LOG_PERF_TB_COR_DEGC.Value.ToString(LOG_PERF_TB_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(23, 11).Value = LOG_PERF_EGT_COR_DEGC.Value.ToString(LOG_PERF_EGT_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(24, 11).Value = LOG_PERF_WF_COR_KGPH.Value.ToString(LOG_PERF_WF_COR_KGPH.Format, Nothing)
                        excelWorksheet.Cells(25, 11).Value = LOG_PERF_SHP_COR_KW.Value.ToString(LOG_PERF_SHP_COR_KW.Format, Nothing)
                        excelWorksheet.Cells(26, 11).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(27, 11).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)

                        Chine11813WritePointInPerfDetails(excelSheets.Item("DETAILS"), 7, True, True, True)

                    Case eTestStepAPS32X0.MES

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Detail

                        'Performed Test Details section
                        If CELProject.IsTrue(MINIMUM_SURGE_MARGIN_TEST_PASSED.Value) Then
                            excelWorksheet.Cells(33, 10).Value = "PASSED"
                        Else
                            excelWorksheet.Cells(33, 10).Value = "FAILED"
                        End If

                    Case eTestStepAPS32X0.FINAL_DATA

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        Dim OperatingTime As Double = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToDouble()
                        Dim NbStart As Double = NUMBER_OF_STARTS.Value.ToDouble()

                        excelWorksheet.Cells(34, 10).Value = ET_CRANK.Value.ToString()
                        excelWorksheet.Cells(35, 10).Value = START_TIME_OPC_SEC.Value.ToString()
                        excelWorksheet.Cells(36, 10).Value = ET_TIME_RUNDOWN_MANUAL_ENTRY.Value.ToString()
                        excelWorksheet.Cells(37, 10).Value = T_ETC_PEAK_START_DEGC.Value.ToString()
                        excelWorksheet.Cells(38, 10).Value = P_OIL_AT_60KW_SHAFT_LOAD_KPAG.Value.ToString()
                        excelWorksheet.Cells(39, 10).Value = T_OIL_AT_60KW_SHAFT_LOAD_DEGC.Value.ToString()
                        excelWorksheet.Cells(40, 10).Value = NbStart.ToString(NUMBER_OF_STARTS.Format) 'NUMBER_OF_STARTS.Value.ToString()
                        excelWorksheet.Cells(41, 10).Value = OperatingTime.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format) 'OPERATING_TIME_TEXT.Value.ToString()
                        excelWorksheet.Cells(42, 10).Value = LOG_PERF_FUEL_USED_TOTAL_LITERS.Value.ToString(LOG_PERF_FUEL_USED_TOTAL_LITERS.Format, Nothing)
                        excelWorksheet.Cells(43, 10).Value = NUMBER_APU_FAULT_SEEN_DURING_TEST.Value.ToString()

                End Select

                currentSheet = "ACCEPTANCE"
                excelWorksheet = excelSheets.Item(currentSheet)

                'Test Result
                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                End If

                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                End If

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreatePerformanceFileChine11813 = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)
            End Try

        End Function

        Private Sub Chine11813WritePointInPerfDetails(ByVal excelWorksheet As Excel.Worksheet, ByVal Column As Integer, ByVal DisplayBleed As Boolean, ByVal DisplayPower As Boolean, ByVal DisplayCorrAirFlow As Boolean)

            excelWorksheet.Cells(19, Column).Value = LOG_PERF_P_BARO_KPAA.Value.ToString(LOG_PERF_P_BARO_KPAA.Format, Nothing)
            excelWorksheet.Cells(20, Column).Value = LOG_PERF_T_INLET_AVG_DEGC.Value.ToString(LOG_PERF_T_INLET_AVG_DEGC.Format, Nothing)
            excelWorksheet.Cells(21, Column).Value = LOG_PERF_ARINC_LCIT.Value.ToString(LOG_PERF_ARINC_LCIT.Format, Nothing)
            excelWorksheet.Cells(22, Column).Value = LOG_PERF_P_INLET_KPAA.Value.ToString(LOG_PERF_P_INLET_KPAA.Format, Nothing)

            If CELProject.IsTrue(LO_SHUTDOWN_BYPASS_BTN.Value) Then
                excelWorksheet.Cells(23, Column).Value = "NaN"
                excelWorksheet.Cells(24, Column).Value = "NaN"
            Else
                excelWorksheet.Cells(23, Column).Value = LOG_PERF_P_OIL_KPAG.Value.ToString(LOG_PERF_P_OIL_KPAG.Format, Nothing)
                excelWorksheet.Cells(24, Column).Value = LOG_PERF_T_OIL_DEGC.Value.ToString(LOG_PERF_T_OIL_DEGC.Format, Nothing)
            End If

            excelWorksheet.Cells(25, Column).Value = LOG_PERF_T_FUEL_DEGC.Value.ToString(LOG_PERF_T_FUEL_DEGC.Format, Nothing)
            excelWorksheet.Cells(26, Column).Value = LOG_PERF_P_FUEL_KPAG.Value.ToString(LOG_PERF_P_FUEL_KPAG.Format, Nothing)
            excelWorksheet.Cells(27, Column).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
            excelWorksheet.Cells(28, Column).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)
            excelWorksheet.Cells(29, Column).Value = LOG_PERF_VIB_COOLING_FAN_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_COOLING_FAN_MMPS_PEAK.Format, Nothing)
            excelWorksheet.Cells(30, Column).Value = LOG_PERF_NG_RPM.Value.ToString(LOG_PERF_NG_RPM.Format, Nothing)
            excelWorksheet.Cells(31, Column).Value = LOG_PERF_ARINC_IGV_POS.Value.ToString(LOG_PERF_ARINC_IGV_POS.Format, Nothing)
            excelWorksheet.Cells(32, Column).Value = LOG_PERF_T_EGT_P_AVG_DEGC.Value.ToString(LOG_PERF_T_EGT_P_AVG_DEGC.Format, Nothing)
            excelWorksheet.Cells(33, Column).Value = LOG_PERF_T_EGT_AVG_DEGC.Value.ToString(LOG_PERF_T_EGT_AVG_DEGC.Format, Nothing)
            excelWorksheet.Cells(34, Column).Value = LOG_PERF_BLEED_VALVE_POSITION.Value.ToString(LOG_PERF_BLEED_VALVE_POSITION.Format, Nothing) 'From ARINC
            excelWorksheet.Cells(35, Column).Value = LOG_PERF_P_ORIFICE_KPAA.Value.ToString(LOG_PERF_P_ORIFICE_KPAA.Format, Nothing)
            excelWorksheet.Cells(36, Column).Value = LOG_PERF_T_ORIFICE_DEGC.Value.ToString(LOG_PERF_T_ORIFICE_DEGC.Format, Nothing)

            If DisplayBleed Then
                excelWorksheet.Cells(37, Column).Value = LOG_PERF_P_ORIFICE_DELTA_KPAD.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_KPAD.Format, Nothing)
                excelWorksheet.Cells(38, Column).Value = LOG_PERF_WB_KGPS.Value.ToString(LOG_PERF_WB_KGPS.Format, Nothing)
                excelWorksheet.Cells(39, Column).Value = LOG_PERF_P_BVC_KPAA.Value.ToString(LOG_PERF_P_BVC_KPAA.Format, Nothing)
                excelWorksheet.Cells(40, Column).Value = LOG_PERF_T_BVC_AVG_DEGC.Value.ToString(LOG_PERF_T_BVC_AVG_DEGC.Format, Nothing)
            End If

            excelWorksheet.Cells(41, Column).Value = LOG_PERF_WF_KGH.Value.ToString(LOG_PERF_WF_KGH.Format, Nothing)

            If DisplayPower Then
                excelWorksheet.Cells(42, Column).Value = GENERATOR_POWER_KW_MEAN.Value.ToString(GENERATOR_POWER_KW_MEAN.Format, Nothing)
            End If

            If DisplayCorrAirFlow Then
                excelWorksheet.Cells(43, Column).Value = LOG_PERF_WB_NORM_KGPS.Value.ToString(LOG_PERF_WB_NORM_KGPS.Format, Nothing)
            End If

        End Sub

        Private Function CreatePerformanceFileEpcor12958(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim currentSheet As String
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreatePerformanceFileEpcor12958 = True

            Try

                ' The following gets the Worksheets collection
                excelSheets = excelWorkbook.Worksheets
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    currentSheet = "SUMMARY"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    Dim row As Integer = 5
                    Dim column As Integer = 3

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsEpcor.CustomerName
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsEpcor.WorkOrder
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsEpcor.EnginePartNumber
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsEpcor.EngineSerialNumber
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = Format(Now, "MM/dd/yyyy")

                    row = 5
                    column = 8

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsEpcor.SampleSG
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsEpcor.SampleTFuel
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsEpcor.FuelType
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsEpcor.OilType

                    currentSheet = "ACCEPTANCE"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    'APU Tested according to
                    excelWorksheet.Cells(46, 7).NumberFormat = "@"
                    excelWorksheet.Cells(46, 7).Value = APU_TESTED_ACCORDING_TO.Value.ToString()

                End If

                Select Case TestStepNumber

                    Case eTestStepAPS32X0.NO_LOAD

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)
                        Dim i As Integer = 0

                        excelWorksheet.Cells(18, 6).Value = LOG_PERF_EGT_COR_DEGC.Value.ToString(LOG_PERF_EGT_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(19, 6).Value = LOG_PERF_WF_COR_KGPH.Value.ToString(LOG_PERF_WF_COR_KGPH.Format, Nothing)
                        excelWorksheet.Cells(21, 6).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(22, 6).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)

                        'Not in EPCOR performance report
                        'excelWorksheet.Cells(44, 10).Value = LOG_PERF_NG_RPM.Value.ToString(LOG_PERF_NG_RPM.Format, Nothing)

                        Epcor12958WritePointInPerfDetails(excelSheets.Item("DETAILS"), 9, False, False, False)

                    Case eTestStepAPS32X0.SHAFT_LOAD

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        excelWorksheet.Cells(18, 8).Value = LOG_PERF_EGT_COR_DEGC.Value.ToString(LOG_PERF_EGT_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(19, 8).Value = LOG_PERF_WF_COR_KGPH.Value.ToString(LOG_PERF_WF_COR_KGPH.Format, Nothing)
                        excelWorksheet.Cells(20, 8).Value = LOG_PERF_SHP_COR_KW.Value.ToString(LOG_PERF_SHP_COR_KW.Format, Nothing)
                        excelWorksheet.Cells(21, 8).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(22, 8).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)

                        Epcor12958WritePointInPerfDetails(excelSheets.Item("DETAILS"), 8, False, True, False)

                    Case eTestStepAPS32X0.ECS

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        excelWorksheet.Cells(15, 10).Value = LOG_PERF_PB_COR_KPAA.Value.ToString(LOG_PERF_PB_COR_KPAA.Format, Nothing)
                        excelWorksheet.Cells(16, 10).Value = LOG_PERF_WB_COR_KGPS.Value.ToString(LOG_PERF_WB_COR_KGPS.Format, Nothing)
                        excelWorksheet.Cells(17, 10).Value = LOG_PERF_TB_COR_DEGC.Value.ToString(LOG_PERF_TB_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(18, 10).Value = LOG_PERF_EGT_COR_DEGC.Value.ToString(LOG_PERF_EGT_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(19, 10).Value = LOG_PERF_WF_COR_KGPH.Value.ToString(LOG_PERF_WF_COR_KGPH.Format, Nothing)
                        excelWorksheet.Cells(20, 10).Value = LOG_PERF_SHP_COR_KW.Value.ToString(LOG_PERF_SHP_COR_KW.Format, Nothing)
                        excelWorksheet.Cells(21, 10).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(22, 10).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)

                        Epcor12958WritePointInPerfDetails(excelSheets.Item("DETAILS"), 7, True, True, True)

                    Case eTestStepAPS32X0.MES

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Detail

                        'Performed Test Details section
                        If CELProject.IsTrue(MINIMUM_SURGE_MARGIN_TEST_PASSED.Value) Then
                            excelWorksheet.Cells(28, 9).Value = "PASSED"
                        Else
                            excelWorksheet.Cells(28, 9).Value = "FAILED"
                        End If

                    Case eTestStepAPS32X0.FINAL_DATA

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        Dim OperatingTime As Double = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToDouble()
                        Dim NbStart As Double = NUMBER_OF_STARTS.Value.ToDouble()

                        excelWorksheet.Cells(29, 9).Value = ET_CRANK.Value.ToString()
                        excelWorksheet.Cells(30, 9).Value = START_TIME_OPC_SEC.Value.ToString()
                        excelWorksheet.Cells(31, 9).Value = ET_TIME_RUNDOWN_MANUAL_ENTRY.Value.ToString()
                        excelWorksheet.Cells(32, 9).Value = T_ETC_PEAK_START_DEGC.Value.ToString()
                        excelWorksheet.Cells(33, 9).Value = P_OIL_AT_60KW_SHAFT_LOAD_KPAG.Value.ToString()
                        excelWorksheet.Cells(34, 9).Value = T_OIL_AT_60KW_SHAFT_LOAD_DEGC.Value.ToString()
                        excelWorksheet.Cells(35, 9).Value = NbStart.ToString(NUMBER_OF_STARTS.Format) 'NUMBER_OF_STARTS.Value.ToString()
                        excelWorksheet.Cells(36, 9).Value = OperatingTime.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format) 'OPERATING_TIME_TEXT.Value.ToString()
                        'excelWorksheet.Cells(36, 9).Value = LOG_PERF_FUEL_USED_TOTAL_LITERS.Value.ToString(LOG_PERF_FUEL_USED_TOTAL_LITERS.Format, Nothing)
                        excelWorksheet.Cells(37, 9).Value = NUMBER_APU_FAULT_SEEN_DURING_TEST.Value.ToString()

                End Select

                'TestProgress_RecordPerfStep(TestStepNumber)

                currentSheet = "ACCEPTANCE"
                excelWorksheet = excelSheets.Item(currentSheet)

                'Test Result
                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                End If

                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                End If

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreatePerformanceFileEpcor12958 = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)
            End Try

        End Function

        Private Sub Epcor12958WritePointInPerfDetails(ByVal excelWorksheet As Excel.Worksheet, ByVal Column As Integer, ByVal DisplayBleed As Boolean, ByVal DisplayPower As Boolean, ByVal DisplayCorrAirFlow As Boolean)

            excelWorksheet.Cells(13, Column).Value = LOG_PERF_P_BARO_KPAA.Value.ToString(LOG_PERF_P_BARO_KPAA.Format, Nothing)
            excelWorksheet.Cells(14, Column).Value = LOG_PERF_T_INLET_AVG_DEGC.Value.ToString(LOG_PERF_T_INLET_AVG_DEGC.Format, Nothing)
            excelWorksheet.Cells(15, Column).Value = LOG_PERF_ARINC_LCIT.Value.ToString(LOG_PERF_ARINC_LCIT.Format, Nothing)
            excelWorksheet.Cells(16, Column).Value = LOG_PERF_P_INLET_KPAA.Value.ToString(LOG_PERF_P_INLET_KPAA.Format, Nothing)

            If CELProject.IsTrue(LO_SHUTDOWN_BYPASS_BTN.Value) Then
                excelWorksheet.Cells(17, Column).Value = "NaN"
                excelWorksheet.Cells(18, Column).Value = "NaN"
            Else
                excelWorksheet.Cells(17, Column).Value = LOG_PERF_P_OIL_KPAG.Value.ToString(LOG_PERF_P_OIL_KPAG.Format, Nothing)
                excelWorksheet.Cells(18, Column).Value = LOG_PERF_T_OIL_DEGC.Value.ToString(LOG_PERF_T_OIL_DEGC.Format, Nothing)
            End If

            excelWorksheet.Cells(19, Column).Value = LOG_PERF_T_FUEL_DEGC.Value.ToString(LOG_PERF_T_FUEL_DEGC.Format, Nothing)
            excelWorksheet.Cells(20, Column).Value = LOG_PERF_P_FUEL_KPAG.Value.ToString(LOG_PERF_P_FUEL_KPAG.Format, Nothing)
            excelWorksheet.Cells(21, Column).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
            excelWorksheet.Cells(22, Column).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)
            excelWorksheet.Cells(23, Column).Value = LOG_PERF_NG_RPM.Value.ToString(LOG_PERF_NG_RPM.Format, Nothing)
            excelWorksheet.Cells(24, Column).Value = LOG_PERF_ARINC_IGV_POS.Value.ToString(LOG_PERF_ARINC_IGV_POS.Format, Nothing)
            excelWorksheet.Cells(25, Column).Value = LOG_PERF_T_EGT_P_AVG_DEGC.Value.ToString(LOG_PERF_T_EGT_P_AVG_DEGC.Format, Nothing)
            excelWorksheet.Cells(26, Column).Value = LOG_PERF_T_EGT_AVG_DEGC.Value.ToString(LOG_PERF_T_EGT_AVG_DEGC.Format, Nothing)
            excelWorksheet.Cells(27, Column).Value = LOG_PERF_BLEED_VALVE_POSITION.Value.ToString(LOG_PERF_BLEED_VALVE_POSITION.Format, Nothing) 'From ARINC
            excelWorksheet.Cells(28, Column).Value = LOG_PERF_P_ORIFICE_KPAA.Value.ToString(LOG_PERF_P_ORIFICE_KPAA.Format, Nothing)
            excelWorksheet.Cells(29, Column).Value = LOG_PERF_T_ORIFICE_DEGC.Value.ToString(LOG_PERF_T_ORIFICE_DEGC.Format, Nothing)

            If DisplayBleed Then
                excelWorksheet.Cells(30, Column).Value = LOG_PERF_P_ORIFICE_DELTA_KPAD.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_KPAD.Format, Nothing)
                excelWorksheet.Cells(31, Column).Value = LOG_PERF_WB_KGPS.Value.ToString(LOG_PERF_WB_KGPS.Format, Nothing)
                excelWorksheet.Cells(32, Column).Value = LOG_PERF_P_BVC_KPAA.Value.ToString(LOG_PERF_P_BVC_KPAA.Format, Nothing)
                excelWorksheet.Cells(33, Column).Value = LOG_PERF_T_BVC_AVG_DEGC.Value.ToString(LOG_PERF_T_BVC_AVG_DEGC.Format, Nothing)
            End If

            excelWorksheet.Cells(34, Column).Value = LOG_PERF_WF_KGH.Value.ToString(LOG_PERF_WF_KGH.Format, Nothing)

            If DisplayPower Then
                excelWorksheet.Cells(35, Column).Value = GENERATOR_POWER_KW_MEAN.Value.ToString(GENERATOR_POWER_KW_MEAN.Format, Nothing)
            End If

            If DisplayCorrAirFlow Then
                excelWorksheet.Cells(36, Column).Value = LOG_PERF_WB_NORM_KGPS.Value.ToString(LOG_PERF_WB_NORM_KGPS.Format, Nothing)
            End If

        End Sub

        Private Function CreatePerformanceFileSouthAfricaAirways13031(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim currentSheet As String
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreatePerformanceFileSouthAfricaAirways13031 = True

            Try

                ' The following gets the Worksheets collection
                excelSheets = excelWorkbook.Worksheets
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    currentSheet = "SUMMARY"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    Dim row As Integer = 5
                    Dim column As Integer = 3

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.CustomerName
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.WorkOrder
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.EngineSerialNumber
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.EnginePartNumber
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.TestType
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.RepairType


                    row = 5
                    column = 9

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = Format(Now, "dd MMMM yyyy")
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.OilType
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.FuelType
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.LowHeatingValue
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.SampleSG
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputsSouthAfricanAirways.SampleTFuel

                    currentSheet = "ACCEPTANCE"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    'APU Tested according to
                    excelWorksheet.Cells(42, 8).NumberFormat = "@"
                    excelWorksheet.Cells(42, 8).Value = APU_TESTED_ACCORDING_TO.Value.ToString()

                End If

                Select Case TestStepNumber

                    Case eTestStepAPS32X0.NO_LOAD

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)
                        Dim i As Integer = 0

                        excelWorksheet.Cells(19, 6).Value = LOG_PERF_EGT_COR_DEGC.Value.ToString(LOG_PERF_EGT_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(20, 6).Value = LOG_PERF_WF_COR_KGPH.Value.ToString(LOG_PERF_WF_COR_KGPH.Format, Nothing)
                        excelWorksheet.Cells(22, 6).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(23, 6).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)

                        excelWorksheet.Cells(40, 10).Value = LOG_PERF_NG_RPM.Value.ToString(LOG_PERF_NG_RPM.Format, Nothing)

                        SouthAfrican13031WritePointInPerfDetails(excelSheets.Item("DETAILS"), 9, False, False, False)

                    Case eTestStepAPS32X0.SHAFT_LOAD

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        excelWorksheet.Cells(19, 8).Value = LOG_PERF_EGT_COR_DEGC.Value.ToString(LOG_PERF_EGT_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(20, 8).Value = LOG_PERF_WF_COR_KGPH.Value.ToString(LOG_PERF_WF_COR_KGPH.Format, Nothing)
                        excelWorksheet.Cells(21, 8).Value = LOG_PERF_SHP_COR_KW.Value.ToString(LOG_PERF_SHP_COR_KW.Format, Nothing)
                        excelWorksheet.Cells(22, 8).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(23, 8).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)

                        SouthAfrican13031WritePointInPerfDetails(excelSheets.Item("DETAILS"), 8, False, True, False)

                    Case eTestStepAPS32X0.ECS

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        excelWorksheet.Cells(16, 11).Value = LOG_PERF_PB_COR_KPAA.Value.ToString(LOG_PERF_PB_COR_KPAA.Format, Nothing)
                        excelWorksheet.Cells(17, 11).Value = LOG_PERF_WB_COR_KGPS.Value.ToString(LOG_PERF_WB_COR_KGPS.Format, Nothing)
                        excelWorksheet.Cells(18, 11).Value = LOG_PERF_TB_COR_DEGC.Value.ToString(LOG_PERF_TB_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(19, 11).Value = LOG_PERF_EGT_COR_DEGC.Value.ToString(LOG_PERF_EGT_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(20, 11).Value = LOG_PERF_WF_COR_KGPH.Value.ToString(LOG_PERF_WF_COR_KGPH.Format, Nothing)
                        excelWorksheet.Cells(21, 11).Value = LOG_PERF_SHP_COR_KW.Value.ToString(LOG_PERF_SHP_COR_KW.Format, Nothing)
                        excelWorksheet.Cells(22, 11).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(23, 11).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)

                        SouthAfrican13031WritePointInPerfDetails(excelSheets.Item("DETAILS"), 7, True, True, True)

                    Case eTestStepAPS32X0.MES

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Detail

                        'Performed Test Details section
                        If CELProject.IsTrue(MINIMUM_SURGE_MARGIN_TEST_PASSED.Value) Then
                            excelWorksheet.Cells(29, 10).Value = "PASSED"
                        Else
                            excelWorksheet.Cells(29, 10).Value = "FAILED"
                        End If

                    Case eTestStepAPS32X0.FINAL_DATA

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        Dim OperatingTime As Double = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToDouble()
                        Dim NbStart As Double = NUMBER_OF_STARTS.Value.ToDouble()

                        excelWorksheet.Cells(30, 10).Value = ET_CRANK.Value.ToString()
                        excelWorksheet.Cells(31, 10).Value = START_TIME_OPC_SEC.Value.ToString()
                        excelWorksheet.Cells(32, 10).Value = ET_TIME_RUNDOWN_MANUAL_ENTRY.Value.ToString()
                        excelWorksheet.Cells(33, 10).Value = T_ETC_PEAK_START_DEGC.Value.ToString()
                        excelWorksheet.Cells(34, 10).Value = P_OIL_AT_60KW_SHAFT_LOAD_KPAG.Value.ToString()
                        excelWorksheet.Cells(35, 10).Value = T_OIL_AT_60KW_SHAFT_LOAD_DEGC.Value.ToString()
                        excelWorksheet.Cells(36, 10).Value = NbStart.ToString(NUMBER_OF_STARTS.Format) 'NUMBER_OF_STARTS.Value.ToString()
                        excelWorksheet.Cells(37, 10).Value = OperatingTime.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format) 'OPERATING_TIME_TEXT.Value.ToString()
                        excelWorksheet.Cells(38, 10).Value = LOG_PERF_FUEL_USED_TOTAL_LITERS.Value.ToString(LOG_PERF_FUEL_USED_TOTAL_LITERS.Format, Nothing)
                        excelWorksheet.Cells(39, 10).Value = NUMBER_APU_FAULT_SEEN_DURING_TEST.Value.ToString()

                End Select

                'TestProgress_RecordPerfStep(TestStepNumber)

                currentSheet = "ACCEPTANCE"
                excelWorksheet = excelSheets.Item(currentSheet)

                'Test Result
                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                End If

                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                End If

                excelWorksheet.Cells(48, 3).Value = UserInputsSouthAfricanAirways.OperatorName
                excelWorksheet.Cells(49, 3).Value = UserInputsSouthAfricanAirways.InspectorName

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreatePerformanceFileSouthAfricaAirways13031 = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)
            End Try

        End Function

        Private Sub SouthAfrican13031WritePointInPerfDetails(ByVal excelWorksheet As Excel.Worksheet, ByVal Column As Integer, ByVal DisplayBleed As Boolean, ByVal DisplayPower As Boolean, ByVal DisplayCorrAirFlow As Boolean)

            excelWorksheet.Cells(15, Column).Value = LOG_PERF_P_BARO_KPAA.Value.ToString(LOG_PERF_P_BARO_KPAA.Format, Nothing)
            excelWorksheet.Cells(16, Column).Value = LOG_PERF_T_INLET_AVG_DEGC.Value.ToString(LOG_PERF_T_INLET_AVG_DEGC.Format, Nothing)
            excelWorksheet.Cells(17, Column).Value = LOG_PERF_ARINC_LCIT.Value.ToString(LOG_PERF_ARINC_LCIT.Format, Nothing)
            excelWorksheet.Cells(18, Column).Value = LOG_PERF_P_INLET_KPAA.Value.ToString(LOG_PERF_P_INLET_KPAA.Format, Nothing)

            If CELProject.IsTrue(LO_SHUTDOWN_BYPASS_BTN.Value) Then
                excelWorksheet.Cells(19, Column).Value = "NaN"
                excelWorksheet.Cells(20, Column).Value = "NaN"
            Else
                excelWorksheet.Cells(19, Column).Value = LOG_PERF_P_OIL_KPAG.Value.ToString(LOG_PERF_P_OIL_KPAG.Format, Nothing)
                excelWorksheet.Cells(20, Column).Value = LOG_PERF_T_OIL_DEGC.Value.ToString(LOG_PERF_T_OIL_DEGC.Format, Nothing)
            End If

            excelWorksheet.Cells(21, Column).Value = LOG_PERF_T_FUEL_DEGC.Value.ToString(LOG_PERF_T_FUEL_DEGC.Format, Nothing)
            excelWorksheet.Cells(22, Column).Value = LOG_PERF_P_FUEL_KPAG.Value.ToString(LOG_PERF_P_FUEL_KPAG.Format, Nothing)
            excelWorksheet.Cells(23, Column).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
            excelWorksheet.Cells(24, Column).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)
            excelWorksheet.Cells(25, Column).Value = LOG_PERF_NG_RPM.Value.ToString(LOG_PERF_NG_RPM.Format, Nothing)
            excelWorksheet.Cells(26, Column).Value = LOG_PERF_ARINC_IGV_POS.Value.ToString(LOG_PERF_ARINC_IGV_POS.Format, Nothing)
            excelWorksheet.Cells(27, Column).Value = LOG_PERF_T_EGT_P_AVG_DEGC.Value.ToString(LOG_PERF_T_EGT_P_AVG_DEGC.Format, Nothing)
            excelWorksheet.Cells(28, Column).Value = LOG_PERF_T_EGT_AVG_DEGC.Value.ToString(LOG_PERF_T_EGT_AVG_DEGC.Format, Nothing)
            excelWorksheet.Cells(29, Column).Value = LOG_PERF_BLEED_VALVE_POSITION.Value.ToString(LOG_PERF_BLEED_VALVE_POSITION.Format, Nothing) 'From ARINC
            excelWorksheet.Cells(30, Column).Value = LOG_PERF_P_ORIFICE_KPAA.Value.ToString(LOG_PERF_P_ORIFICE_KPAA.Format, Nothing)
            excelWorksheet.Cells(31, Column).Value = LOG_PERF_T_ORIFICE_DEGC.Value.ToString(LOG_PERF_T_ORIFICE_DEGC.Format, Nothing)

            If DisplayBleed Then
                excelWorksheet.Cells(32, Column).Value = LOG_PERF_P_ORIFICE_DELTA_KPAD.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_KPAD.Format, Nothing)
                excelWorksheet.Cells(33, Column).Value = LOG_PERF_WB_KGPS.Value.ToString(LOG_PERF_WB_KGPS.Format, Nothing)
                excelWorksheet.Cells(34, Column).Value = LOG_PERF_P_BVC_KPAA.Value.ToString(LOG_PERF_P_BVC_KPAA.Format, Nothing)
                excelWorksheet.Cells(35, Column).Value = LOG_PERF_T_BVC_AVG_DEGC.Value.ToString(LOG_PERF_T_BVC_AVG_DEGC.Format, Nothing)
            End If

            excelWorksheet.Cells(36, Column).Value = LOG_PERF_WF_KGH.Value.ToString(LOG_PERF_WF_KGH.Format, Nothing)

            If DisplayPower Then
                excelWorksheet.Cells(37, Column).Value = GENERATOR_POWER_KW_MEAN.Value.ToString(GENERATOR_POWER_KW_MEAN.Format, Nothing)
            End If

            If DisplayCorrAirFlow Then
                excelWorksheet.Cells(38, Column).Value = LOG_PERF_WB_NORM_KGPS.Value.ToString(LOG_PERF_WB_NORM_KGPS.Format, Nothing)
            End If

        End Sub

        Private Function CreatePerformanceTHY13015(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean

            'Declaration
            Dim currentSheet As String
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet
            Dim SelectString As String = String.Empty
            Dim Cmd As OleDbCommand
            Dim Reader As OleDbDataReader
            Dim TestCellName As String = "Unknown"



            CreatePerformanceTHY13015 = True

            Try

                ' The following gets the Worksheets collection
                excelSheets = excelWorkbook.Worksheets
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    currentSheet = "SUMMARY"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    Dim row As Integer = 5
                    Dim column As Integer = 3


                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputTHY.EngineSerialNumber
                    row += 1

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputTHY.WorkOrder
                    row += 1

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputTHY.EnginePartNumber
                    row += 1

                    row = 5
                    column = 9

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputTHY.OilType
                    row += 1

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputTHY.FuelType
                    row += 1

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = Format(Now, "dd MMMM yyyy")

                    ' Retrieve the test cell number from the test session
                    SelectString = "SELECT * FROM TestCellIdentification"

                    Try
                        Cmd = New OleDbCommand(SelectString, CELProject.Database.Connection)
                        Reader = Cmd.ExecuteReader()
                        Reader.Read()
                        TestCellName = Reader.Item("TestCelNumber").ToString()
                        Reader.Close()

                    Catch ex As Exception
                        If Not Reader.IsClosed Then
                            Reader.Close()
                        End If
                    End Try

                    ' Add the test cell identification in the right footer
                    currentSheet = "SUMMARY"
                    excelWorksheet = excelSheets.Item(currentSheet)
                    excelWorksheet.PageSetup.RightFooter = excelWorksheet.PageSetup.RightFooter + TestCellName

                    currentSheet = "DETAILS"
                    excelWorksheet = excelSheets.Item(currentSheet)
                    excelWorksheet.PageSetup.RightFooter = excelWorksheet.PageSetup.RightFooter + TestCellName

                    currentSheet = "ACCEPTANCE"
                    excelWorksheet = excelSheets.Item(currentSheet)
                    excelWorksheet.PageSetup.RightFooter = excelWorksheet.PageSetup.RightFooter + TestCellName

                    currentSheet = "ACCEPTANCE"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    'APU Tested according to
                    excelWorksheet.Cells(43, 8).NumberFormat = "@"
                    excelWorksheet.Cells(43, 8).Value = Custom_Parameters("APUTestedAccordingTo").ToString()

                End If

                Select Case TestStepNumber

                    Case eTestStepAPS32X0.NO_LOAD

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)
                        Dim i As Integer = 0

                        excelWorksheet.Cells(20, 6).Value = LOG_PERF_EGT_COR_DEGC.Value.ToString(LOG_PERF_EGT_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(21, 6).Value = LOG_PERF_WF_COR_KGPH.Value.ToString(LOG_PERF_WF_COR_KGPH.Format, Nothing)
                        excelWorksheet.Cells(23, 6).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(24, 6).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)

                        excelWorksheet.Cells(41, 10).Value = LOG_PERF_NG_RPM.Value.ToString(LOG_PERF_NG_RPM.Format, Nothing)

                        THY13015WritePointInPerfDetails(excelSheets.Item("DETAILS"), 9, False, False, False)

                    Case eTestStepAPS32X0.SHAFT_LOAD

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        excelWorksheet.Cells(20, 8).Value = LOG_PERF_EGT_COR_DEGC.Value.ToString(LOG_PERF_EGT_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(21, 8).Value = LOG_PERF_WF_COR_KGPH.Value.ToString(LOG_PERF_WF_COR_KGPH.Format, Nothing)
                        excelWorksheet.Cells(22, 8).Value = LOG_PERF_SHP_COR_KW.Value.ToString(LOG_PERF_SHP_COR_KW.Format, Nothing)
                        excelWorksheet.Cells(23, 8).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(24, 8).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)

                        THY13015WritePointInPerfDetails(excelSheets.Item("DETAILS"), 8, False, True, False)

                    Case eTestStepAPS32X0.ECS

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        excelWorksheet.Cells(17, 11).Value = LOG_PERF_PB_COR_KPAA.Value.ToString(LOG_PERF_PB_COR_KPAA.Format, Nothing)
                        excelWorksheet.Cells(18, 11).Value = LOG_PERF_WB_COR_KGPS.Value.ToString(LOG_PERF_WB_COR_KGPS.Format, Nothing)
                        excelWorksheet.Cells(19, 11).Value = LOG_PERF_TB_COR_DEGC.Value.ToString(LOG_PERF_TB_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(20, 11).Value = LOG_PERF_EGT_COR_DEGC.Value.ToString(LOG_PERF_EGT_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(21, 11).Value = LOG_PERF_WF_COR_KGPH.Value.ToString(LOG_PERF_WF_COR_KGPH.Format, Nothing)
                        excelWorksheet.Cells(22, 11).Value = LOG_PERF_SHP_COR_KW.Value.ToString(LOG_PERF_SHP_COR_KW.Format, Nothing)
                        excelWorksheet.Cells(23, 11).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(24, 11).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)

                        THY13015WritePointInPerfDetails(excelSheets.Item("DETAILS"), 7, True, True, True)

                    Case eTestStepAPS32X0.MES

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Detail

                        'Performed Test Details section
                        If CELProject.IsTrue(MINIMUM_SURGE_MARGIN_TEST_PASSED.Value) Then
                            excelWorksheet.Cells(30, 10).Value = "PASSED"
                        Else
                            excelWorksheet.Cells(30, 10).Value = "FAILED"
                        End If

                    Case eTestStepAPS32X0.FINAL_DATA

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        Dim OperatingTime As Double = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToDouble()
                        Dim NbStart As Double = NUMBER_OF_STARTS.Value.ToDouble()

                        excelWorksheet.Cells(31, 10).Value = ET_CRANK.Value.ToString()
                        excelWorksheet.Cells(32, 10).Value = START_TIME_OPC_SEC.Value.ToString()
                        excelWorksheet.Cells(33, 10).Value = ET_TIME_RUNDOWN_MANUAL_ENTRY.Value.ToString()
                        excelWorksheet.Cells(34, 10).Value = T_ETC_PEAK_START_DEGC.Value.ToString()
                        excelWorksheet.Cells(35, 10).Value = P_OIL_AT_60KW_SHAFT_LOAD_KPAG.Value.ToString()
                        excelWorksheet.Cells(36, 10).Value = T_OIL_AT_60KW_SHAFT_LOAD_DEGC.Value.ToString()
                        excelWorksheet.Cells(37, 10).Value = NbStart.ToString(NUMBER_OF_STARTS.Format) 'NUMBER_OF_STARTS.Value.ToString()
                        excelWorksheet.Cells(38, 10).Value = OperatingTime.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format) 'OPERATING_TIME_TEXT.Value.ToString()
                        excelWorksheet.Cells(39, 10).Value = LOG_PERF_FUEL_USED_TOTAL_LITERS.Value.ToString(LOG_PERF_FUEL_USED_TOTAL_LITERS.Format, Nothing)
                        excelWorksheet.Cells(40, 10).Value = NUMBER_APU_FAULT_SEEN_DURING_TEST.Value.ToString()

                End Select

                'TestProgress_RecordPerfStep(TestStepNumber)

                currentSheet = "ACCEPTANCE"
                excelWorksheet = excelSheets.Item(currentSheet)

                'Test Result
                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                End If

                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                End If

                excelWorksheet.Cells(49, 3).Value = UserInputTHY.OperatorName
                excelWorksheet.Cells(50, 3).Value = UserInputTHY.InspectorName

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreatePerformanceTHY13015 = False

            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)
            End Try

        End Function

        Private Sub CEA11847WritePointInPerfDetails(ByVal excelWorksheet As Excel.Worksheet, ByVal Column As Integer, ByVal DisplayBleed As Boolean, ByVal DisplayPower As Boolean, ByVal DisplayCorrAirFlow As Boolean)

            excelWorksheet.Cells(16, Column).Value = LOG_PERF_P_BARO_KPAA.Value.ToString(LOG_PERF_P_BARO_KPAA.Format, Nothing)
            excelWorksheet.Cells(17, Column).Value = LOG_PERF_T_INLET_AVG_DEGC.Value.ToString(LOG_PERF_T_INLET_AVG_DEGC.Format, Nothing)
            excelWorksheet.Cells(18, Column).Value = LOG_PERF_ARINC_LCIT.Value.ToString(LOG_PERF_ARINC_LCIT.Format, Nothing)
            excelWorksheet.Cells(19, Column).Value = LOG_PERF_P_INLET_KPAA.Value.ToString(LOG_PERF_P_INLET_KPAA.Format, Nothing)

            If CELProject.IsTrue(LO_SHUTDOWN_BYPASS_BTN.Value) Then
                excelWorksheet.Cells(20, Column).Value = "NaN"
                excelWorksheet.Cells(21, Column).Value = "NaN"
            Else
                excelWorksheet.Cells(20, Column).Value = LOG_PERF_P_OIL_KPAG.Value.ToString(LOG_PERF_P_OIL_KPAG.Format, Nothing)
                excelWorksheet.Cells(21, Column).Value = LOG_PERF_T_OIL_DEGC.Value.ToString(LOG_PERF_T_OIL_DEGC.Format, Nothing)
            End If

            excelWorksheet.Cells(22, Column).Value = LOG_PERF_T_FUEL_DEGC.Value.ToString(LOG_PERF_T_FUEL_DEGC.Format, Nothing)
            excelWorksheet.Cells(23, Column).Value = LOG_PERF_P_FUEL_KPAG.Value.ToString(LOG_PERF_P_FUEL_KPAG.Format, Nothing)
            excelWorksheet.Cells(24, Column).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
            excelWorksheet.Cells(25, Column).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)
            excelWorksheet.Cells(26, Column).Value = LOG_PERF_NG_RPM.Value.ToString(LOG_PERF_NG_RPM.Format, Nothing)
            excelWorksheet.Cells(27, Column).Value = LOG_PERF_ARINC_IGV_POS.Value.ToString(LOG_PERF_ARINC_IGV_POS.Format, Nothing)
            excelWorksheet.Cells(28, Column).Value = LOG_PERF_T_EGT_P_AVG_DEGC.Value.ToString(LOG_PERF_T_EGT_P_AVG_DEGC.Format, Nothing)
            excelWorksheet.Cells(29, Column).Value = LOG_PERF_T_EGT_AVG_DEGC.Value.ToString(LOG_PERF_T_EGT_AVG_DEGC.Format, Nothing)
            excelWorksheet.Cells(30, Column).Value = LOG_PERF_BLEED_VALVE_POSITION.Value.ToString(LOG_PERF_BLEED_VALVE_POSITION.Format, Nothing) 'From ARINC
            excelWorksheet.Cells(31, Column).Value = LOG_PERF_P_ORIFICE_KPAA.Value.ToString(LOG_PERF_P_ORIFICE_KPAA.Format, Nothing)
            excelWorksheet.Cells(32, Column).Value = LOG_PERF_T_ORIFICE_DEGC.Value.ToString(LOG_PERF_T_ORIFICE_DEGC.Format, Nothing)

            If DisplayBleed Then
                excelWorksheet.Cells(33, Column).Value = LOG_PERF_P_ORIFICE_DELTA_KPAD.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_KPAD.Format, Nothing)
                excelWorksheet.Cells(34, Column).Value = LOG_PERF_WB_KGPS.Value.ToString(LOG_PERF_WB_KGPS.Format, Nothing)
                excelWorksheet.Cells(35, Column).Value = LOG_PERF_P_BVC_KPAA.Value.ToString(LOG_PERF_P_BVC_KPAA.Format, Nothing)
                excelWorksheet.Cells(36, Column).Value = LOG_PERF_T_BVC_AVG_DEGC.Value.ToString(LOG_PERF_T_BVC_AVG_DEGC.Format, Nothing)
            End If

            excelWorksheet.Cells(37, Column).Value = LOG_PERF_WF_KGH.Value.ToString(LOG_PERF_WF_KGH.Format, Nothing)

            If DisplayPower Then
                excelWorksheet.Cells(38, Column).Value = GENERATOR_POWER_KW_MEAN.Value.ToString(GENERATOR_POWER_KW_MEAN.Format, Nothing)
            End If

            If DisplayCorrAirFlow Then
                excelWorksheet.Cells(39, Column).Value = LOG_PERF_WB_NORM_KGPS.Value.ToString(LOG_PERF_WB_NORM_KGPS.Format, Nothing)
            End If

        End Sub

        Private Function CreatePerformanceCEA11847(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean

            'Declaration
            Dim currentSheet As String
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet
            Dim SelectString As String = String.Empty
            Dim Cmd As OleDbCommand
            Dim Reader As OleDbDataReader
            Dim TestCellName As String = "Unknown"



            CreatePerformanceCEA11847 = True

            Try

                ' The following gets the Worksheets collection
                excelSheets = excelWorkbook.Worksheets
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    currentSheet = "SUMMARY"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    Dim row As Integer = 5
                    Dim column As Integer = 3


                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputCEAL.EngineSerialNumber
                    row += 1

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputCEAL.WorkOrder
                    row += 1

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputCEAL.EnginePartNumber
                    row += 1

                    row = 5
                    column = 9

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputCEAL.OilType
                    row += 1

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputCEAL.FuelType
                    row += 1

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = Format(Now, "dd MMMM yyyy")

                    ' Retrieve the test cell number from the test session
                    SelectString = "SELECT * FROM TestCellIdentification"

                    Try
                        Cmd = New OleDbCommand(SelectString, CELProject.Database.Connection)
                        Reader = Cmd.ExecuteReader()
                        Reader.Read()
                        TestCellName = Reader.Item("TestCelNumber").ToString()
                        Reader.Close()

                    Catch ex As Exception
                        If Not Reader.IsClosed Then
                            Reader.Close()
                        End If
                    End Try

                    ' Add the test cell identification in the right footer
                    currentSheet = "SUMMARY"
                    excelWorksheet = excelSheets.Item(currentSheet)
                    excelWorksheet.PageSetup.RightFooter = excelWorksheet.PageSetup.RightFooter + " " + TestCellName

                    currentSheet = "DETAILS"
                    excelWorksheet = excelSheets.Item(currentSheet)
                    excelWorksheet.PageSetup.RightFooter = excelWorksheet.PageSetup.RightFooter + " " + TestCellName

                    currentSheet = "ACCEPTANCE"
                    excelWorksheet = excelSheets.Item(currentSheet)
                    excelWorksheet.PageSetup.RightFooter = excelWorksheet.PageSetup.RightFooter + " " + TestCellName

                    currentSheet = "ACCEPTANCE"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    'APU Tested according to
                    excelWorksheet.Cells(43, 8).NumberFormat = "@"
                    excelWorksheet.Cells(43, 8).Value = Custom_Parameters("APUTestedAccordingTo").ToString()

                End If

                Select Case TestStepNumber

                    Case eTestStepAPS32X0.NO_LOAD

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)
                        Dim i As Integer = 0

                        excelWorksheet.Cells(20, 6).Value = LOG_PERF_EGT_COR_DEGC.Value.ToString(LOG_PERF_EGT_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(21, 6).Value = LOG_PERF_WF_COR_KGPH.Value.ToString(LOG_PERF_WF_COR_KGPH.Format, Nothing)
                        excelWorksheet.Cells(23, 6).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(24, 6).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)

                        excelWorksheet.Cells(41, 10).Value = LOG_PERF_NG_RPM.Value.ToString(LOG_PERF_NG_RPM.Format, Nothing)

                        THY13015WritePointInPerfDetails(excelSheets.Item("DETAILS"), 9, False, False, False)

                    Case eTestStepAPS32X0.SHAFT_LOAD

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        excelWorksheet.Cells(20, 8).Value = LOG_PERF_EGT_COR_DEGC.Value.ToString(LOG_PERF_EGT_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(21, 8).Value = LOG_PERF_WF_COR_KGPH.Value.ToString(LOG_PERF_WF_COR_KGPH.Format, Nothing)
                        excelWorksheet.Cells(22, 8).Value = LOG_PERF_SHP_COR_KW.Value.ToString(LOG_PERF_SHP_COR_KW.Format, Nothing)
                        excelWorksheet.Cells(23, 8).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(24, 8).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)

                        THY13015WritePointInPerfDetails(excelSheets.Item("DETAILS"), 8, False, True, False)

                    Case eTestStepAPS32X0.ECS

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        excelWorksheet.Cells(17, 11).Value = LOG_PERF_PB_COR_KPAA.Value.ToString(LOG_PERF_PB_COR_KPAA.Format, Nothing)
                        excelWorksheet.Cells(18, 11).Value = LOG_PERF_WB_COR_KGPS.Value.ToString(LOG_PERF_WB_COR_KGPS.Format, Nothing)
                        excelWorksheet.Cells(19, 11).Value = LOG_PERF_TB_COR_DEGC.Value.ToString(LOG_PERF_TB_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(20, 11).Value = LOG_PERF_EGT_COR_DEGC.Value.ToString(LOG_PERF_EGT_COR_DEGC.Format, Nothing)
                        excelWorksheet.Cells(21, 11).Value = LOG_PERF_WF_COR_KGPH.Value.ToString(LOG_PERF_WF_COR_KGPH.Format, Nothing)
                        excelWorksheet.Cells(22, 11).Value = LOG_PERF_SHP_COR_KW.Value.ToString(LOG_PERF_SHP_COR_KW.Format, Nothing)
                        excelWorksheet.Cells(23, 11).Value = LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_GEARBOX_MMPS_PEAK.Format, Nothing)
                        excelWorksheet.Cells(24, 11).Value = LOG_PERF_VIB_TURBINE_MMPS_PEAK.Value.ToString(LOG_PERF_VIB_TURBINE_MMPS_PEAK.Format, Nothing)

                        THY13015WritePointInPerfDetails(excelSheets.Item("DETAILS"), 7, True, True, True)

                    Case eTestStepAPS32X0.MES

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Detail

                        'Performed Test Details section
                        If CELProject.IsTrue(MINIMUM_SURGE_MARGIN_TEST_PASSED.Value) Then
                            excelWorksheet.Cells(30, 10).Value = "PASSED"
                        Else
                            excelWorksheet.Cells(30, 10).Value = "FAILED"
                        End If

                    Case eTestStepAPS32X0.FINAL_DATA

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        Dim OperatingTime As Double = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToDouble()
                        Dim NbStart As Double = NUMBER_OF_STARTS.Value.ToDouble()

                        excelWorksheet.Cells(31, 10).Value = ET_CRANK.Value.ToString()
                        excelWorksheet.Cells(32, 10).Value = START_TIME_OPC_SEC.Value.ToString()
                        excelWorksheet.Cells(33, 10).Value = ET_TIME_RUNDOWN_MANUAL_ENTRY.Value.ToString()
                        excelWorksheet.Cells(34, 10).Value = T_ETC_PEAK_START_DEGC.Value.ToString()
                        excelWorksheet.Cells(35, 10).Value = P_OIL_AT_60KW_SHAFT_LOAD_KPAG.Value.ToString()
                        excelWorksheet.Cells(36, 10).Value = T_OIL_AT_60KW_SHAFT_LOAD_DEGC.Value.ToString()
                        excelWorksheet.Cells(37, 10).Value = NbStart.ToString(NUMBER_OF_STARTS.Format) 'NUMBER_OF_STARTS.Value.ToString()
                        excelWorksheet.Cells(38, 10).Value = OperatingTime.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format) 'OPERATING_TIME_TEXT.Value.ToString()
                        excelWorksheet.Cells(39, 10).Value = LOG_PERF_FUEL_USED_TOTAL_LITERS.Value.ToString(LOG_PERF_FUEL_USED_TOTAL_LITERS.Format, Nothing)
                        excelWorksheet.Cells(40, 10).Value = NUMBER_APU_FAULT_SEEN_DURING_TEST.Value.ToString()

                End Select

                'TestProgress_RecordPerfStep(TestStepNumber)

                currentSheet = "ACCEPTANCE"
                excelWorksheet = excelSheets.Item(currentSheet)

                'Test Result
                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                End If

                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                End If

                excelWorksheet.Cells(49, 3).Value = UserInputCEAL.OperatorName
                excelWorksheet.Cells(50, 3).Value = UserInputCEAL.InspectorName

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile: " + ex.Message)
                MessageBox.Show(ex.ToString)
                CreatePerformanceCEA11847 = False

            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)
            End Try

        End Function

        Private Sub THY13015WritePointInPerfDetails(ByVal excelWorksheet As Excel.Worksheet, ByVal Column As Integer, ByVal DisplayBleed As Boolean, ByVal DisplayPower As Boolean, ByVal DisplayCorrAirFlow As Boolean)

            excelWorksheet.Cells(16, Column).Value = LOG_PERF_P_BARO_KPAA.Value.ToString(LOG_PERF_P_BARO_KPAA.Format, Nothing)
