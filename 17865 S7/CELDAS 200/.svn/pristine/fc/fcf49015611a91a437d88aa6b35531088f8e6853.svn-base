        Protected Overrides Sub OnTestSessionRunning(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            'Dim i As Integer
            Try
                MyBase.OnTestSessionRunning(newStatus)

                If CELProject.EngineFamily <> "APS32X0" Then
                    Return
                End If

                Init_Engine_Channels()
                CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.Init_Engine_Controls)) 'Must be after Init_Engine Channels
                Init_Engine_Channels_Value()

                CELProject.LoadSave_Custom_Parameters(Custom_Parameters, False) 'Load some parameters value from database

                CELProject.Perf_Nb_Sheet_To_Print = 3

                Init_Engine_Controllers()


                CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.Init_Engine_Controls)) 'Must be after Init_Engine Channels

                AddHandlers()

                MyBase.StartWorkingThread()


                'Test Progress Initialization
                'TestProgress_Initialize()


            Catch ex As Exception
                MessageBox.Show("OnTestSessionRunning: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub AddHandlers()

            'Add Handlers
            AddHandler ARINC_APU_SN.ValueChanged, AddressOf OnArincAPU_SN

            AddHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnCLOSE_TEST_BTN

            AddHandler CAPTURE_PRESSURE_AT_60KW.ValueChanged, AddressOf OnCapture

            AddHandler CELProject.PERF_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnPERF_OPEN_WINDOW_BTN
            AddHandler CELProject.PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
            AddHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            AddHandler PERF_NEW_TEST_OPC.ValueChanged, AddressOf OnNEW_TEST_BTN
            AddHandler CELProject.PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN


            AddHandler RTL.ValueChanged, AddressOf OnReadyToLoad
            AddHandler SMART_TERMINAL_BTN.ValueChanged, AddressOf OnSMART_TERMINAL_BTN
            AddHandler cmbTestStepList.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged

        End Sub

        Protected Overrides Sub RemoveHandlers()


            If Not (ARINC_APU_SN Is Nothing) Then
                RemoveHandler ARINC_APU_SN.ValueChanged, AddressOf OnArincAPU_SN
            End If


            If Not (CELProject.CLOSE_TEST_BTN Is Nothing) Then
                RemoveHandler CELProject.CLOSE_TEST_BTN.ValueChanged, AddressOf OnCLOSE_TEST_BTN
            End If

            If Not (PERF_NEW_TEST_OPC Is Nothing) Then
                RemoveHandler PERF_NEW_TEST_OPC.ValueChanged, AddressOf OnNEW_TEST_BTN
            End If

            If Not (CELProject.PERF_CLOSE_WINDOW_BTN Is Nothing) Then
                RemoveHandler CELProject.PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
            End If

            If Not (CAPTURE_PRESSURE_AT_60KW Is Nothing) Then
                RemoveHandler CAPTURE_PRESSURE_AT_60KW.ValueChanged, AddressOf OnCapture
            End If

            If Not (CELProject.LOG_TAKE_POINT_BTN Is Nothing) Then
                RemoveHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            End If

            If Not (CELProject.PERF_OPEN_WINDOW_BTN Is Nothing) Then
                RemoveHandler CELProject.PERF_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnPERF_OPEN_WINDOW_BTN
            End If

            If Not (CELProject.PERF_TAKE_POINT_BTN Is Nothing) Then
                RemoveHandler CELProject.PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN
            End If
            If Not (SMART_TERMINAL_BTN Is Nothing) Then
                RemoveHandler SMART_TERMINAL_BTN.ValueChanged, AddressOf OnSMART_TERMINAL_BTN
            End If

            If Not (RTL Is Nothing) Then
                RemoveHandler RTL.ValueChanged, AddressOf OnReadyToLoad
            End If

            If Not (cmbTestStepList Is Nothing) Then
                RemoveHandler cmbTestStepList.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged
            End If

        End Sub

        Protected Overrides Sub Init_Engine_Controllers()

            NumberOfTInletProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/" + CELProject.EngineFamily + "/T_INLET_NUMBER_PROBE", 0)
            RealNumberOfTInletProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/" + CELProject.EngineFamily + "/T_INLET_REAL_NUMBER_PROBE", 0)
            NumberOfTEgtProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/" + CELProject.EngineFamily + "/T_EGT_NUMBER_PROBE", 0)
            RealNumberOfTEgtProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/" + CELProject.EngineFamily + "/T_EGT_REAL_NUMBER_PROBE", 0)
            NumberOfTBleedProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/" + CELProject.EngineFamily + "/T_BLEED_NUMBER_PROBE", 0)
            RealNumberOfTBleedProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/" + CELProject.EngineFamily + "/T_BLEED_REAL_NUMBER_PROBE", 0)

            Debug.Assert(NumberOfTInletProbe <> 0 And NumberOfTEgtProbe <> 0 And NumberOfTBleedProbe <> 0)

            Dim PersistentValuesChannels() As String

            If CELProject.EngineModel = "APS3250" Then
                PersistentValuesChannels = {"NUMBER_OF_STARTS",
                                           "OPERATING_TIME_CURRENT_SEC",
                                           "FUEL_USED_INITIAL_LITERS",
                                           "FUEL_USED_TOTAL_LITERS",
                                           "PERF_TEST_RESULT_ACCEPTED",
                                           "PERF_TEST_RESULT_REJECTED",
                                           "NG_MAX_PERSISTENT_RPM",
                                           "VIB_GEARBOX_MAX_IPS_PEAK_PERSISTENT",
                                           "VIB_TURBINE_MAX_IPS_PEAK_PERSISTENT",
                                           "VIB_COOLING_FAN_MAX_IPS_PEAK_PERSISTENT",
                                           "P_OIL_MAX_PERSISTENT_KPAG",
                                           "MINIMUM_SURGE_MARGIN_TEST_PASSED",
                                           "NUMBER_APU_FAULT_SEEN_DURING_TEST",
                                           "LOG_PERF_EVENT_1",
                                           "LOG_PERF_EVENT_2",
                                           "LOG_PERF_HR_MTR_1",
                                           "LOG_PERF_HR_MTR_2",
                                           "P_OIL_AT_60KW_SHAFT_LOAD_KPAG",
                                           "T_OIL_AT_60KW_SHAFT_LOAD_DEGC",
                                           "ET_TIME_RUNDOWN_MANUAL_ENTRY"}
            Else
                'APS3200 (doesn't have a cooling fan vibration sensor)
                PersistentValuesChannels = {"NUMBER_OF_STARTS",
                                           "OPERATING_TIME_CURRENT_SEC",
                                           "FUEL_USED_INITIAL_LITERS",
                                           "FUEL_USED_TOTAL_LITERS",
                                           "PERF_TEST_RESULT_ACCEPTED",
                                           "PERF_TEST_RESULT_REJECTED",
                                           "NG_MAX_PERSISTENT_RPM",
                                           "VIB_GEARBOX_MAX_IPS_PEAK_PERSISTENT",
                                           "VIB_TURBINE_MAX_IPS_PEAK_PERSISTENT",
                                           "P_OIL_MAX_PERSISTENT_KPAG",
                                           "MINIMUM_SURGE_MARGIN_TEST_PASSED",
                                           "NUMBER_APU_FAULT_SEEN_DURING_TEST",
                                           "LOG_PERF_EVENT_1",
                                           "LOG_PERF_EVENT_2",
                                           "LOG_PERF_HR_MTR_1",
                                           "LOG_PERF_HR_MTR_2",
                                           "P_OIL_AT_60KW_SHAFT_LOAD_KPAG",
                                           "T_OIL_AT_60KW_SHAFT_LOAD_DEGC",
                                           "ET_TIME_RUNDOWN_MANUAL_ENTRY"}
            End If

            Dim PersistentValuesFileName As String = Nothing

            Select Case CELProject.Project.Number

                Case 12917
                    PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputsRevima.EngineSerialNumber & "\" & UserInputsRevima.WorkOrder & "\Log\PersistentValues.xml"
                    APS32X0PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

                    Dim FuelUsedTotal As Double = FUEL_USED_TOTAL_LITERS.Value.ToDouble()
                    FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())
                    FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FuelUsedTotal)

                Case 11813
                    PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputsChine.EngineSerialNumber & "\" & UserInputsChine.WorkOrder & "\Log\PersistentValues.xml"
                    APS32X0PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

                    If Double.IsNaN(FUEL_USED_TOTAL_LITERS.Value.ToDouble()) Then
                        FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                    Else
                        FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())
                    End If

                Case 12958
                    PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputsEpcor.EngineSerialNumber & "\" & UserInputsEpcor.WorkOrder & "\Log\PersistentValues.xml"
                    APS32X0PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

                    If Double.IsNaN(FUEL_USED_TOTAL_LITERS.Value.ToDouble()) Then
                        FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                    Else
                        FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())
                    End If

                Case 13031
                    PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputsSouthAfricanAirways.EngineSerialNumber & "\" & UserInputsSouthAfricanAirways.WorkOrder & "\Log\PersistentValues.xml"
                    APS32X0PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

                    If Double.IsNaN(FUEL_USED_TOTAL_LITERS.Value.ToDouble()) Then
                        FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                    Else
                        FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())
                    End If

                Case 13015
                    PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputTHY.EngineSerialNumber & "\" & UserInputTHY.WorkOrder & "\Log\PersistentValues.xml"
                    APS32X0PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

                    If Double.IsNaN(FUEL_USED_TOTAL_LITERS.Value.ToDouble()) Then
                        FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                    Else
                        FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())
                    End If

                Case 14094
                    PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputSichuan.EngineSerialNumber & "\" & UserInputSichuan.WorkOrder & "\Log\PersistentValues.xml"
                    APS32X0PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

                    If Double.IsNaN(FUEL_USED_TOTAL_LITERS.Value.ToDouble()) Then
                        FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                    Else
                        FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())
                    End If

                Case 11847
                    PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputSichuan.EngineSerialNumber & "\" & UserInputSichuan.WorkOrder & "\Log\PersistentValues.xml"
                    APS32X0PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

                    If Double.IsNaN(FUEL_USED_TOTAL_LITERS.Value.ToDouble()) Then
                        FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                    Else
                        FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())
                    End If

                Case Else
                    Debug.Assert(False, "OnTestSessionRunning: Code Missing for this project")

            End Select

            If RealNumberOfTBleedProbe > 1 Then
                DeletableTBleedChCtrl = New DeletableChannelController(Me, RealNumberOfTBleedProbe, NumberOfTBleedProbe, NumberOfTBleedProbe, "T_BVC", "_DEGC", "_DELETE_BTN", "T_BVC_AVG_DEGC", "T_BVC_MIN_DEGC", "T_BVC_MAX_DEGC", "T_BVC_SPREAD_DEGC")
            End If
            DeletableTInletChCtrl = New DeletableChannelController(Me, RealNumberOfTInletProbe, NumberOfTInletProbe, NumberOfTInletProbe, "T_INLET", "_DEGC", "_DELETE_BTN", "T_INLET_AVG_DEGC", "T_INLET_MIN_DEGC", "T_INLET_MAX_DEGC", "T_INLET_SPREAD_DEGC")
            DeletableTEgtChCtrl = New DeletableChannelController(Me, RealNumberOfTEgtProbe, NumberOfTEgtProbe, NumberOfTEgtProbe, "T_EGT", "_DEGC", "_DELETE_BTN", "T_EGT_AVG_DEGC", "T_EGT_MIN_DEGC", "T_EGT_MAX_DEGC", "T_EGT_SPREAD_DEGC")

            FlowmeterCtrl = New FlowmeterController(Me)

            StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_RECTIFIER_CURRENT_AMP", "STARTER_RECTIFIER_CURRENT_AMP_MAX", "START_BTN")
            StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_RECTIFIER_VOLTAGE_VDC", "STARTER_RECTIFIER_VOLTAGE_VDC_MAX", "START_BTN")

            FuelRegulatorCtrl = New UpDownDemandController("FUEL_PRESSURE_DEMAND", "FUEL_PRESSURE_DEMAND_INCREMENT", "FUEL_PRESSURE_UP_DEMAND_BTN", "FUEL_PRESSURE_DOWN_DEMAND_BTN", Nothing)
            FuelRegulatorCtrl.Maximum = 100
            FuelRegulatorCtrl.Increment = 1
            FuelRegulatorCtrl.Minimum = 0
            FuelRegulatorCtrl.ResetValue = 0

            'Configuring Load Bank Control
            Dim myLBData As LoadBankController.LB_DataInfo = Nothing

            myLBData.FanEnableBtnChannelName = "LB1_FAN_ENABLE_BTN"
            myLBData.FanEnableChannelName = "LB1_FAN_ENABLE_CMD"
            myLBData.EnableChannelName = "LB_LOAD_BTN"
            myLBData.InitialDemandChannelName = "LB1_INITIAL_DEMAND"
            myLBData.DemandChannelName = "LB1_DEMAND"
            myLBData.UpDemandChannelName = "LB1_UP_DEMAND_BTN"
            myLBData.DownDemandChannelName = "LB1_DOWN_DEMAND_BTN"
            myLBData.DemandChannelIncrementName = "LB1_DEMAND_INCREMENT"
            myLBData.FrameName = "APS32X0_Screen.fraControlSystem.fraLoadBankControl" 'TODO utiler le search control
            myLBData.DisplayName = "dspLB_DEMAND"

            myLBData.ThreadSpeedMsec = 250 'msec
            myLBData.Maximum = 100
            myLBData.DelestageKwpersec = 10 'instant delestage
            myLBData.FanCoolDownSeconds = 300
            myLBData.Memorize = False
            myLBData.Increment = 1
            myLBData.BtnLatchSeconds = 0
            myLBData.FanEnableChannelPulseName = Nothing
            myLBData.FanStopChannelPulseName = Nothing
            myLBData.PulseEnableInitialType = False
            myLBData.PulseStopInitialType = False

            Select Case CELProject.Project.Number

                Case 12917
                    myLBData.FieldFlashingTimeMsec = 1000
                    myLBData.FieldFlashingSignalName = "FIELD_FLASHING"
                    myLBData.FieldFlashingTriggerSignalName = "LB_GCU_BTN"

                Case 11813
                    myLBData.FieldFlashingTimeMsec = 0  'no field flashing
                    myLBData.FieldFlashingSignalName = Nothing
                    myLBData.FieldFlashingTriggerSignalName = Nothing

                Case 12958
                    myLBData.FieldFlashingTimeMsec = 0  'no field flashing
                    myLBData.FieldFlashingSignalName = Nothing
                    myLBData.FieldFlashingTriggerSignalName = Nothing

                Case 13031
                    myLBData.FieldFlashingTimeMsec = 0  'no field flashing
                    myLBData.FieldFlashingSignalName = Nothing
                    myLBData.FieldFlashingTriggerSignalName = Nothing

                Case 13015
                    myLBData.FieldFlashingTimeMsec = 0  'no field flashing
                    myLBData.FieldFlashingSignalName = Nothing
                    myLBData.FieldFlashingTriggerSignalName = Nothing

                Case 14094
                    myLBData.FieldFlashingTimeMsec = 0  'no field flashing
                    myLBData.FieldFlashingSignalName = Nothing
                    myLBData.FieldFlashingTriggerSignalName = Nothing

                Case 11847
                    myLBData.FieldFlashingTimeMsec = 0  'no field flashing
                    myLBData.FieldFlashingSignalName = Nothing
                    myLBData.FieldFlashingTriggerSignalName = Nothing

                Case Else
                    myLBData.FieldFlashingTimeMsec = 0  'no field flashing
                    myLBData.FieldFlashingSignalName = Nothing
                    myLBData.FieldFlashingTriggerSignalName = Nothing
                    Debug.Assert(False, "OnTestSessionRunning: Code Missing for this project in")

            End Select

            LoadBankCtrl = New LoadBankController(myLBData)

            'Configuring Load Bank Stage Values
            Select CELProject.Project.Number

                Case 13015

                    'Configuring Load Bank Stage Values, maximum allowed is 100 kW, define only required stage
                    LoadBankCtrl.AddStage(1, "LB1_1")
                    LoadBankCtrl.AddStage(1, "LB1_2")
                    LoadBankCtrl.AddStage(2, "LB1_3")
                    LoadBankCtrl.AddStage(4, "LB1_4")
                    LoadBankCtrl.AddStage(8, "LB1_5")
                    LoadBankCtrl.AddStage(14, "LB1_6")
                    LoadBankCtrl.AddStage(23, "LB1_7")
                    LoadBankCtrl.AddStage(47, "LB1_8")
                    LoadBankCtrl.AddStage(47, "LB1_9")

                Case 14094
                    LoadBankCtrl.AddStage(1, "LB1_1")
                    LoadBankCtrl.AddStage(1, "LB1_2")
                    LoadBankCtrl.AddStage(2, "LB1_3")
                    LoadBankCtrl.AddStage(4, "LB1_4")
                    LoadBankCtrl.AddStage(8, "LB1_5")
                    LoadBankCtrl.AddStage(16, "LB1_6")
                    LoadBankCtrl.AddStage(32, "LB1_7")
                    LoadBankCtrl.AddStage(32, "LB1_8")
                    LoadBankCtrl.AddStage(64, "LB1_9")

                Case 11847
                    LoadBankCtrl.AddStage(5, "LB1_1")
                    LoadBankCtrl.AddStage(10, "LB1_2")
                    LoadBankCtrl.AddStage(10, "LB1_3")
                    LoadBankCtrl.AddStage(25, "LB1_4")
                    LoadBankCtrl.AddStage(50, "LB1_5")
                    LoadBankCtrl.AddStage(100, "LB1_6")

                Case Else
                    Debug.Assert(False, "OnTestSessionRunning: Load bank not configured for this project")

            End Select

            LoadBankCtrl.AddCurrentPhases("LB_CURRENT_A_AMP", "LB_CURRENT_B_AMP", "LB_CURRENT_C_AMP", 20, 300)
            LoadBankCtrl.AddVoltagePhases("LB_VOLTAGE_AB_VAC", "LB_VOLTAGE_BC_VAC", "LB_VOLTAGE_CA_VAC", 20, 150)
            LoadBankCtrl.StartWorkerThread(250)

            'Configuring ECS Control
            ECSCtrl = New ECSController(Me, 0, 100, 100, "ECS_BTN", "ECS_DEMAND", "ECS_UP_DEMAND_BTN", "ECS_DOWN_DEMAND_BTN", dspECS)
            ECSCtrl.Memorize = False
            ECSCtrl.Enable = False
            ECSCtrl.UseIGVPositionAsFirstValue = False
        End Sub

        Protected Overrides Sub Dispose_Engine_Controllers()


            If Not (DeletableTBleedChCtrl Is Nothing) Then
                DeletableTBleedChCtrl.Dispose()
            End If

            If Not (DeletableTEgtChCtrl Is Nothing) Then
                DeletableTEgtChCtrl.Dispose()
            End If

            If Not (DeletableTInletChCtrl Is Nothing) Then
                DeletableTInletChCtrl.Dispose()
            End If

            'Disposing of Collection
            If Not (LoadBankCtrl Is Nothing) Then
                LoadBankCtrl.Dispose()
            End If

            If Not (ECSCtrl Is Nothing) Then
                ECSCtrl.Dispose()
            End If

            If Not (APS32X0PersistentValuesCtrl Is Nothing) Then
                APS32X0PersistentValuesCtrl.Dispose()
            End If

            If Not (StarterMaxCurrentRecordCtrl Is Nothing) Then
                StarterMaxCurrentRecordCtrl.Dispose()
            End If

            If Not (StarterMaxVoltageRecordCtrl Is Nothing) Then
                StarterMaxVoltageRecordCtrl.Dispose()
            End If

            If Not (FlowmeterCtrl Is Nothing) Then
                FlowmeterCtrl.Dispose()
            End If
            If Not (FuelRegulatorCtrl Is Nothing) Then
                FuelRegulatorCtrl.Dispose()
            End If

        End Sub

        Protected Overrides Sub SetTestStepList(value As Integer)
        End Sub

