        Private Sub OnArincAPU_SN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                    Return
                End If

                Dim Value As Integer

                'First validate the information, it seems that we received invalid message, so we just discard them
                Try
                    Value = newVal.ToDouble()
                Catch e As Exception
                    'newVal is empty!! just ignore the message
                    Exit Sub
                End Try

                'Calculate the SN
                Dim unite As Integer = (Value And &HF)       'bit 1  to 4
                Dim dizaine As Integer = (Value And &HF0) >> 4  'bit 5  to 8
                Dim centaine As Integer = (Value And &HF00) >> 8  'bit 9  to 12
                Dim millier As Integer = (Value And &HF000) >> 12 'bit 13 to 16
                Dim dix_millier As Integer = (Value And &H70000) >> 16 'bit 17 to 19  one less bit

                Dim total As Double = unite + dizaine * 10 + centaine * 100 + millier * 1000 + dix_millier * 10000

                APU_SN.Value = New KineticaRT.Values.Double(total)


            Catch ex As Exception
                MessageBox.Show("APS32X0_Sequence.OnArincAPU_SN: ", ex.ToString)
            End Try

        End Sub

        Private Sub OnCapture(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                Return
            End If

            If CELProject.IsFalse(newVal) Then
                Return
            End If

            If sender.Name <> "CAPTURE_PRESSURE_AT_60KW" Then
                Return
            End If

            P_OIL_AT_60KW_SHAFT_LOAD_KPAG.Value = P_OIL_KPAG_MEAN.Value
            T_OIL_AT_60KW_SHAFT_LOAD_DEGC.Value = T_OIL_DEGC_MEAN.Value

        End Sub

        Protected Overrides Sub OnPERF_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            Dim SearchPath As String
            Dim excelWorkbook As Excel.Workbook = Nothing

            Try
                If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                    Return
                End If

                If CELProject.IsFalse(newVal) Then
                    Return
                End If


                'Update the Log/Perf channel set
                CELProject.LogPerfSynch.UpdateValues()

                'Synchronize data for Log and Performance
                Compute(True)

                SearchPath = CELProject.EngineSession.PerfFolder

                Dim NewFileCreated As Boolean

                Select Case CELProject.Project.Number

                    Case 12917
                        Dim Revima12917TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                        NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, Revima12917TemplateReportFullFileName, AddressOf CreatePerformanceFileRevima12917)

                    Case 11813
                        Dim Chine11813TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                        NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, Chine11813TemplateReportFullFileName, AddressOf CreatePerformanceFileChine11813)

                    Case 12958
                        Dim Epcor12958TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                        NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, Epcor12958TemplateReportFullFileName, AddressOf CreatePerformanceFileEpcor12958)

                    Case 13031
                        Dim SouthAfrica13031TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                        NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, SouthAfrica13031TemplateReportFullFileName, AddressOf CreatePerformanceFileSouthAfricaAirways13031)

                    Case 13015
                        Dim THY13015TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                        NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, THY13015TemplateReportFullFileName, AddressOf CreatePerformanceTHY13015)

                    Case 14094
                        Dim Sichuan14094TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                        NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, Sichuan14094TemplateReportFullFileName, AddressOf CreatePerformanceTHY13015)

                    Case 11847
                        Dim CEAL11847TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                        NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, CEAL11847TemplateReportFullFileName, AddressOf CreatePerformanceCEA11847)

                    Case Else
                        Debug.Assert(False, "OnPerf_TAKE_POINT_BTN, Code Missing for this project")

                End Select

                CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, True, CELProject.EngineModel, NewFileCreated)

                CELProject.PERF_TAKE_POINT_BTN.Value = Values.False


            Catch ex As Exception
                MessageBox.Show("OnPERF_TAKE_POINT_BTN: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally

            End Try
        End Sub

        Private Sub OnReadyToLoad(sender As IChannel, newVal As Value)

            If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                Return
            End If

            If CELProject.IsFalse(newVal) Then
                Return
            End If

            If WF_KGH_MEAN.Value > 5.0 Then
                NUMBER_OF_STARTS.Value = New KineticaRT.Values.Double(NUMBER_OF_STARTS.Value.ToDouble + 1)
            End If

        End Sub

        Private Sub OnSMART_TERMINAL_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            If (CELProject.IsFalse(newVal)) Then
                Return
            End If

            Try
                If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                    Return
                End If

                Dim ECB_Version As String = Nothing

                Select Case CELProject.Project.Number

                    Case 12917
                        ECB_Version = UserInputsRevima.ECBVersion

                    Case 11813
                        ECB_Version = UserInputsChine.ECBVersion

                    Case 12958
                        ECB_Version = "V6.XX"

                    Case 13031
                        ECB_Version = "V6.XX"

                    Case 13015
                        ECB_Version = "V6.XX"

                    Case 14094
                        ECB_Version = "V6.XX"

                    Case 11847
                        ECB_Version = "V6.XX"

                    Case Else
                        Debug.Assert(False, "OnSMART_TERMINAL_BTN: Code Missing for this project in")

                End Select

                Select Case ECB_Version
                    Case "V5.XX"
                        If File.Exists(EngineConfiguration.SmartTerminalUtilityExeFile1) Then
                            System.Diagnostics.Process.Start(EngineConfiguration.SmartTerminalUtilityExeFile1)
                        Else
                            Debug.Assert(False, "The file " + EngineConfiguration.SmartTerminalUtilityExeFile1 + " does not exist")
                        End If

                    Case "V6.XX"
                        If File.Exists(EngineConfiguration.SmartTerminalUtilityExeFile2) Then
                            System.Diagnostics.Process.Start(EngineConfiguration.SmartTerminalUtilityExeFile2)
                        Else
                            Debug.Assert(False, "The file " + EngineConfiguration.SmartTerminalUtilityExeFile2 + " does not exist")
                        End If
                    Case Else
                        Debug.Assert(False, "Wrong ECB Version for" + CELProject.EngineModel)
                End Select

                SMART_TERMINAL_BTN.Value = Values.False

            Catch ex As System.Exception
                MessageBox.Show("Smart Terminal Button: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try

        End Sub

