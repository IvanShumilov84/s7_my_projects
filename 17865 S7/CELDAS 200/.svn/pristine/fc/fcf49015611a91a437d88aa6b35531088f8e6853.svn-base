                Return_Value.Add(MyBase.InitializeChannel(T_EGT_P_AVG_DEGC_MEAN, "T_EGT_P_AVG_DEGC_MEAN"))
                Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_FUEL_DEGC, "LOG_PERF_T_FUEL_DEGC"))
                Return_Value.Add(MyBase.InitializeChannel(T_INLET_AVG_DEGC, "T_INLET_AVG_DEGC"))
                Return_Value.Add(MyBase.InitializeChannel(T_OIL_DEGC_MEAN, "T_OIL_DEGC_MEAN"))
                Return_Value.Add(MyBase.InitializeChannel(T_ORIFICE_DEGC, "T_ORIFICE_DEGC"))
                Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_ORIFICE_DEGC, "LOG_PERF_T_ORIFICE_DEGC"))
                Return_Value.Add(MyBase.InitializeChannel(TB_COR_HS_DEGC, "TB_COR_HS_DEGC"))
                Return_Value.Add(MyBase.InitializeChannel(WB_CALC, "WB_CALC"))
                Return_Value.Add(MyBase.InitializeChannel(WB_COR_HS_KGPS, "WB_COR_HS_KGPS"))
                Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WB_NORM_KGPS, "LOG_PERF_WB_NORM_KGPS"))
                Return_Value.Add(MyBase.InitializeChannel(WF_KGH_MEAN, "WF_KGH_MEAN"))
                Return_Value.Add(MyBase.InitializeChannel(WF_COR_HS_KGPH, "WF_COR_HS_KGPH"))
                Return_Value.Add(MyBase.InitializeChannel(WF_TOT1, "WF_TOT1"))
                Return_Value.Add(MyBase.InitializeChannel(WF_TOT2, "WF_TOT2"))
                If EngineConfiguration.UseMeasuredBleedFlowValue Then
                    Return_Value.Add(MyBase.InitializeChannel(WB_MEASURED, "WB_MEASURED"))
                    Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WB_MEASURED, "LOG_PERF_WB_MEASURED"))
                End If

                'End Select
            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.ToString())
                Return_Value.Add(False)
            Finally

            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function

