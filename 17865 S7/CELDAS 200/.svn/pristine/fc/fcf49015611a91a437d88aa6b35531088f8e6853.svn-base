            excelWorksheet.Cells(29, Column).Value = LOG_PERF_T_EGT_AVG_DEGC.Value.ToString(LOG_PERF_T_EGT_AVG_DEGC.Format, Nothing)
            excelWorksheet.Cells(30, Column).Value = LOG_PERF_BLEED_VALVE_POSITION.Value.ToString(LOG_PERF_BLEED_VALVE_POSITION.Format, Nothing) 'From ARINC
            excelWorksheet.Cells(31, Column).Value = LOG_PERF_P_ORIFICE_KPAA.Value.ToString(LOG_PERF_P_ORIFICE_KPAA.Format, Nothing)
            excelWorksheet.Cells(32, Column).Value = LOG_PERF_T_ORIFICE_DEGC.Value.ToString(LOG_PERF_T_ORIFICE_DEGC.Format, Nothing)

            If DisplayBleed Then
                excelWorksheet.Cells(33, Column).Value = LOG_PERF_P_ORIFICE_DELTA_KPAD.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_KPAD.Format, Nothing)
                excelWorksheet.Cells(34, Column).Value = LOG_PERF_WB_KGPS.Value.ToString(LOG_PERF_WB_KGPS.Format, Nothing)
                excelWorksheet.Cells(35, Column).Value = LOG_PERF_P_BVC_KPAA.Value.ToString(LOG_PERF_P_BVC_KPAA.Format, Nothing)
                excelWorksheet.Cells(36, Column).Value = LOG_PERF_T_BVC_AVG_DEGC.Value.ToString(LOG_PERF_T_BVC_AVG_DEGC.Format, Nothing)
            End If

            excelWorksheet.Cells(37, Column).Value = LOG_PERF_WF_KGH.Value.ToString(LOG_PERF_WF_KGH.Format, Nothing)

            If DisplayPower Then
                excelWorksheet.Cells(38, Column).Value = GENERATOR_POWER_KW_MEAN.Value.ToString(GENERATOR_POWER_KW_MEAN.Format, Nothing)
            End If

            If DisplayCorrAirFlow Then
                excelWorksheet.Cells(39, Column).Value = LOG_PERF_WB_NORM_KGPS.Value.ToString(LOG_PERF_WB_NORM_KGPS.Format, Nothing)
            End If

        End Sub

        Private Sub EmulateAPS32X0InletFlapOpeningClosing()

            Static FlapPosition As Integer = 0
            Try

                If CELProject.IsTrue(INLET_FLAP_OPEN_REQUEST_IND.Value) Then
                    If (FlapPosition < 3000) Then
                        FlapPosition = FlapPosition + 100
                    Else
                        FlapPosition = 3000
                    End If

                ElseIf CELProject.IsTrue(INLET_FLAP_CLOSE_REQUEST_IND.Value) Then
                    If (FlapPosition > 0) Then
                        FlapPosition = FlapPosition - 100
                    Else
                        FlapPosition = 0
                    End If
                End If

                If FlapPosition = 0 Then ' (* 0 is close position*)
                    If CELProject.IsFalse(INLET_FLAP_CLOSE_CMD.Value) Then
                        INLET_FLAP_CLOSE_CMD.Value = Values.True
                    End If
                Else
                    If CELProject.IsTrue(INLET_FLAP_CLOSE_CMD.Value) Then
                        INLET_FLAP_CLOSE_CMD.Value = Values.False
                    End If
                End If

                If FlapPosition = 3000 Then '(* 3000 is open position*)
                    If CELProject.IsFalse(INLET_FLAP_OPEN_CMD.Value) Then
                        INLET_FLAP_OPEN_CMD.Value = Values.True
                    End If
                Else
                    If CELProject.IsTrue(INLET_FLAP_OPEN_CMD.Value) Then
                        INLET_FLAP_OPEN_CMD.Value = Values.False
                    End If
                End If

                If (FlapPosition <> 0) And (FlapPosition <> 3000) Then
                    If CELProject.IsFalse(INLET_FLAP_MOVE_CMD.Value) Then
                        INLET_FLAP_MOVE_CMD.Value = Values.True
                    End If
                Else
                    If CELProject.IsTrue(INLET_FLAP_MOVE_CMD.Value) Then
                        INLET_FLAP_MOVE_CMD.Value = Values.False
                    End If

                End If

            Catch ex As Exception

            End Try

        End Sub

        Protected Overrides Sub Init_Engine_Channels_Value()

            LOAD_AIR_VALVE_DEMAND.Value = New KineticaRT.Values.Double(25.0)

            'Read the mass flow meter value
            FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())

            CELProject.PERF_TEST_STEP_NB.Value = Values.Zero

            DRESS_KIT.Value = New KineticaRT.Values.Text(EngineConfiguration.Dresskit.ToString)

        End Sub

        Protected Overrides Sub Init_Engine_Controls()

            Try
                cmbTestStepList.SelectedIndex = 0

            Catch ex As Exception
                MessageBox.Show("Init_Engine_Controls: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try

        End Sub

        Protected Overrides Sub OnEngineWorkingThread()
            
            If CELProject.IsTrue(CELProject.ARCHIVE_PLAY.Value) Then
                Return
            End If

            Compute(False) 'Compute all Performance parameters

            EmulateAPS32X0InletFlapOpeningClosing()

            'Make sure FM_INITIAL_VOLUME_LITERS is different than 0
            ValidateFMInitialValue()

            'Persistent Values Save Check
            APS32X0PersistentValuesCtrl.SavePersistentValues(False)


        End Sub

        Protected Overrides Sub Compute(ByVal CalulateForLogAndPerformanceReports As Boolean)

            Try
                If CalulateForLogAndPerformanceReports Then

                    If EngineConfiguration.UseMeasuredBleedFlowValue Then
                        LOG_PERF_WB_CALC.Value = LOG_PERF_WB_MEASURED.Value
                    Else
                        LOG_PERF_WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(LOG_PERF_T_ORIFICE_DEGC.Value.ToDouble(),
                                                                                                     LOG_PERF_P_ORIFICE_KPAA.Value.ToDouble(),
                                                                                                     LOG_PERF_P_ORIFICE_DELTA_KPAD.Value.ToDouble))
                    End If

                    Compute_APS32X0_Perf(LOG_PERF_T_INLET_AVG_DEGC,
                                         LOG_PERF_P_BARO_KPAA,
                                         LOG_PERF_P_INLET_KPAA,
                                         LOG_PERF_P_BVC_KPAA,
                                         LOG_PERF_WB_CALC,
                                         LOG_PERF_T_BVC_AVG_DEGC,
                                         LOG_PERF_WF_KGH,
                                         LOG_PERF_T_EGT_P_AVG_DEGC,
                                         LOG_PERF_SHP_COR_NORM_KW)

                    FlowmeterCtrl.ComputeFlow(True)

                    'IMPORTANT: Toutes les variables flottantes telles que WB_CALC, DELPB, LB_DEMAND dont la source et la destination sont vides doivent
                    'manuellement être updaté pour être inscrite dans le LOG ou le PERF report.
                Else

                    If EngineConfiguration.UseMeasuredBleedFlowValue Then
                        WB_CALC.Value = WB_MEASURED.Value
                    Else
                        WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(T_ORIFICE_DEGC.Value.ToDouble(),
                                                                                      P_ORIFICE_KPAA.Value.ToDouble(),
                                                                                      P_ORIFICE_DELTA_KPAD.Value.ToDouble))
                    End If

                    Compute_APS32X0_Perf(T_INLET_AVG_DEGC, _
                                         P_BARO_KPAA, _
                                         P_INLET_KPAA_MEAN, _
                                         P_BVC_KPAA_MEAN, _
                                         WB_CALC, _
                                         T_BVC_AVG_DEGC_MEAN, _
                                         WF_KGH_MEAN, _
                                         T_EGT_P_AVG_DEGC_MEAN, _
                                         SHP_COR_NORM_KW_MEAN)


                End If

            Catch ex As Exception
                MessageBox.Show("Compute_APS32X0" + ex.ToString(), "Error")
            End Try

        End Sub

        Private Function Compute_BleedAirFlow(ByVal TOrifice_DEGC As Double, _
                                                ByVal POrifice_KPAA As Double, _
                                                ByVal POrificeDelta_KPAD As Double) As Double
            Try

                If CELProject.IsFalse(BLEED_BTN.Value) Then
                    Return 0.0
                End If

                Dim BleedAirFLow As Double = CELProject.GetBleedAirFlow( _
                        EngineConfiguration.DuctDiameter, _
                        EngineConfiguration.DuctDiameterUnit, _
                        EngineConfiguration.OrificeDiameter, _
                        EngineConfiguration.OrificeDiameterUnit, _
                        TOrifice_DEGC, _
                        CELDAS.eTemperature.Celsius, _
                        POrifice_KPAA, _
                        CELDAS.ePressure.Kilopascal, _
                        POrificeDelta_KPAD, _
                        CELDAS.ePressure.Kilopascal, _
                        EngineConfiguration.OrificeThinkness, _
                        EngineConfiguration.OrificeThinknessUnit, _
                        EngineConfiguration.TapArrangement, _
                        CELDAS.eFlowMass.KgBySec)

                Return BleedAirFLow

            Catch Ex As Exception

                MessageBox.Show("APS32X0_Sequence.Compute_BleedAirFlow: " & Ex.ToString)
                Return Double.NaN

            End Try
        End Function

        Private Sub ValidateFMInitialValue()

            Try

                Select Case CELProject.Project.Number

                    Case 12917
                        'Read the mass flow meter value, the value cannot be 0
                        If FM_INITIAL_VOLUME_LITERS.Value.ToDouble() = 0.0 Then
                            FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())
                        End If

                    Case 11813
                        FM_INITIAL_VOLUME_LITERS.Value = Values.Zero

                    Case 12958
                        FM_INITIAL_VOLUME_LITERS.Value = Values.Zero

                    Case 13015
                        FM_INITIAL_VOLUME_LITERS.Value = Values.Zero

                    Case 13031
                        FM_INITIAL_VOLUME_LITERS.Value = Values.Zero

                    Case 14094
                        FM_INITIAL_VOLUME_LITERS.Value = Values.Zero

                    Case 11847
                        FM_INITIAL_VOLUME_LITERS.Value = Values.Zero

                    Case Else
                        Debug.Assert(False, "ValidateFMInitialValue: Code Missing for this project")

                End Select

            Catch Ex As Exception
                MessageBox.Show("ValidateFMInitialValue: " & Ex.ToString())
            End Try

        End Sub

