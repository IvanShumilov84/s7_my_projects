        Private Function Initialize() As Boolean
            Try

                ' Put every thing to zero
                PERF_CONDITION_NUMBER.Value = Values.One
                PERF_REMARK_TEXT.Value = New KineticaRT.Values.Text("")
                PERF_MGT_TRIM_DEGF.Value = Values.Zero
                PERF_TM_BIAS.Value = Values.Zero
                PERF_TM_GAIN.Value = Values.Zero
                PERF_TM_BIAS_BACKUP.Value = Values.Zero
                PERF_TM_GAIN_BACKUP.Value = Values.Zero
                PERF_MGT_SLOPE.Value = Values.Zero
                PERF_MGT_INTERCEPT.Value = Values.Zero
                PERF_TORQUE_QEEC_LBSFT_BACKUP.Value = Values.Zero
                PERF_MGT_TRIM_DEGF_RECOMMEND.Value = Values.Zero

                PERF_TM_BIAS_RECOMMEND.Value = Values.Zero
                PERF_TM_GAIN_RECOMMEND.Value = Values.Zero
                PERF_TM_BIAS_BACKUP_RECOMMEND.Value = Values.Zero
                PERF_TM_GAIN_BACKUP_RECOMMEND.Value = Values.Zero
                PERF_MGT_SLOPE_RECOMMEND.Value = Values.Zero
                PERF_MGT_INTERCEPT_RECOMMEND.Value = Values.Zero

                'DEFAULT SETTINGS 
                PERF_DCU_METHOD_CHKBOX.Value = Values.True

                Return True

            Catch Ex As Exception
                MessageBox.Show("PWC83018_Sequence : Initialize()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return False
            End Try
        End Function


        Private Function Initialize_Perf() As Boolean
            Dim iError As Integer
            Dim iCondition As Integer = 0
            Try

                ' Torque trim recommendation are not finded by the dll (reset)
                Recommendation_Condition = False

                pwc83018.ResetM()
                pwc83018.ResetCommon()
                pwc83018.ResetTorque()
                pwc83018.GetCondition(iCondition)

                pwc83018.SetConfigurationPath(sConfigurationPath)
                pwc83018.SetDataPath(sDataPath)

                pwc83018.GetUnitData()
                SetUnitValues()
                pwc83018.SaveUnitData()

                pwc83018.SetEngine(UserInputHS.EngineSerialNumber)

                'Build is always set to 1 in test case
                pwc83018.SetBuild(1)

                Dim ServiceBulletins As String = UserInputHS.ServiceBulletins
                Dim ServiceBulletinsSplitted As String() = {}

                If ServiceBulletins <> String.Empty Then
                    ServiceBulletinsSplitted = ServiceBulletins.Split(New Char() {"-"})
                End If


                If ServiceBulletinsSplitted.Length = 0 Then

                    pwc83018.LoadModel(iError, CELProject.EngineModel)

                ElseIf ServiceBulletinsSplitted.Length = 1 Then

                    pwc83018.LoadModel(iError, CELProject.EngineModel, ServiceBulletinsSplitted(0))

                ElseIf ServiceBulletinsSplitted.Length = 2 Then

                    pwc83018.LoadModel(iError, CELProject.EngineModel, ServiceBulletinsSplitted(0), ServiceBulletinsSplitted(1))

                Else
                    Debug.Assert(False, "PWC83018 Load Model : One or two Service Bulletins are supported : User Inputs Error")
                    iError = 1
                End If


                If iError <> 0 Then
                    MessageBox.Show("PWC83018_Sequence : Initialize_Perf() Couldn't 'LoadModel' from PWC83018", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Return False
                Else

                    pwc83018.SetSummary(True)
                    Return True
                End If

            Catch Ex As Exception
                MessageBox.Show("PWC83018_Sequence : Initialize_Perf() : Cannot communicate with P&WC DLL Processing Server" & vbCrLf & vbCrLf & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        Private Sub ProcessCondition()
            Dim Cond_nb As Integer
            Dim FileName As String
            Dim iError As Integer
            Dim iCondition As Integer
            Try
                Cond_nb = CInt(PERF_CONDITION_NUMBER.Value.ToDouble())
                pwc83018.SetCondition(Cond_nb)
                SubmitPerfValues()
                pwc83018.Process(iError, 1, 1)

                If (iError = 0) Then
                    FileName = GetOutputFilename()

                    PerfFileName = "C:\CELDAS DATA\" + CELProject.EngineModel + "\" + UserInputHS.EngineSerialNumber + "\" + UserInputHS.WorkOrder + "\Perf\" + "Performance " + Format(Now, "yyyy-MM-dd HH'h'mm'm'ss's'") + ".txt"


                    ' JSR : On cherche la string "TORQUE TRIM STATUS BASED ON CONDITIONS" dans le fichier output de la DLL
                    '       pour savoir si le process a reussi a converger vers des valeurs. Si c'est le cas, on met la 
                    '       variable "Recommendation_Condition" a True pour aller chercher les resultats. 
                    ' Note : text.IndexOf() retourne l'index (l'emplacement) de la string dans le fichier output. Donc, 
                    '        s'il retourne plus grand que 0, c'est qu'il l'a trouvé dans le fichier

                    Dim text As String = File.ReadAllText(FileName)
                    If text.IndexOf("TORQUE TRIM STATUS BASED ON CONDITIONS") >= 0 Then
                        Recommendation_Condition = True
                    End If

                    If (System.IO.File.Exists(PerfFileName)) Then
                        System.IO.File.Delete(PerfFileName)
                    End If

                    System.IO.File.Copy(FileName, PerfFileName)
                    ShowOutputFile(FileName)

                    pwc83018.NextCond(iError)
                    pwc83018.GetCondition(iCondition)
                    'PERF_CONDITION_NUMBER.Value = New KineticaRT.Values.Double(PERF_CONDITION_NUMBER.Value.ToDouble + 1)
                    PERF_CONDITION_NUMBER.Value = New KineticaRT.Values.Double(iCondition)
                Else
                    CELDAS.NotifyIcon.ShowBalloonTip(3000, CELProject.TechnologyName, "PWC83018 : Error processing condition", ToolTipIcon.Error)
                    ShowOutputFile("TEMP.OUT")
                End If
            Catch ex As Exception
                MessageBox.Show("PWC83018_Sequence : ProcessCondition() : Cannot communicate with P&WC DLL Processing Server" & vbCrLf & vbCrLf & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub SetUnitValues()
            Dim i As Integer

            For i = UnitValues.GetLowerBound(0) To UnitValues.GetUpperBound(0)
                If Not pwc83018.PutUnitValue(UnitValues(i, 0), UnitValues(i, 1), "") Then
                    MessageBox.Show("SetUnitValues: Unknown label Or unit '" + _
                        UnitValues(i, 0) + "' (" + UnitValues(i, 1) + ")")
                End If
            Next
        End Sub

        Private Sub ShowOutputFile(fileName As String)
            Dim DetailsForm As CEL.Forms.DisplayFile = Nothing

            Try
                DetailsForm = New CEL.Forms.DisplayFile(fileName)

                DetailsForm.MinimizeBox = False
                DetailsForm.MaximizeBox = False
                DetailsForm.Text = fileName
                DetailsForm.ShowDialog()
            Catch e As Exception
                MsgBox(e.ToString(), MsgBoxStyle.OkOnly Or MsgBoxStyle.Critical, _
                    fileName)
            Finally
                If (Not (DetailsForm Is Nothing)) Then
                    DetailsForm.Dispose()
                End If
            End Try
        End Sub

        Private Sub SubmitPerfValues()
            pwc83018.SetEngine(UserInputHS.EngineSerialNumber)

            pwc83018.GetData()

            pwc83018.PutValue("DATE", Format(Now, "yyyy/MM/dd"), "")
            pwc83018.PutValue("TIME", Format(Now, "hh:mm"), "")
            pwc83018.PutValue("CELL", "H&S", "")
            pwc83018.PutValue("REMARK", PERF_REMARK_TEXT.Value.ToString(), "")
            pwc83018.PutValue("WORK", UserInputHS.WorkOrder, "")
            If UserInputHS.TestType = "Overhaul" Then
                pwc83018.PutValue("TEST_TYPE", "OVERHAUL", "")
            ElseIf UserInputHS.TestType = "Repair" Then
                pwc83018.PutValue("TEST_TYPE", "REPAIR", "")
            ElseIf UserInputHS.TestType = "As Received" Then
                pwc83018.PutValue("TEST_TYPE", "ASRECEIVED", "")
            End If
            If PERF_DCU_METHOD_CHKBOX.Value = Values.True Then
                pwc83018.PutValue("TM_METHOD", "DCU", "")
            ElseIf PERF_TRIM_BOX_METHOD_CHKBOX.Value = Values.True Then
                pwc83018.PutValue("TM_METHOD", "TBOX", "")
            End If

            pwc83018.PutValue("TM_GAIN", PERF_TM_GAIN.Value.ToString, "")
            pwc83018.PutValue("TM2_GAIN", PERF_TM_GAIN_BACKUP.Value.ToString, "")
            pwc83018.PutValue("TM_BIAS", PERF_TM_BIAS.Value.ToString, "")
            pwc83018.PutValue("TM2_BIAS", PERF_TM_BIAS_BACKUP.Value.ToString, "")
            pwc83018.PutValue("TSO", UserInputHS.TSO, "")
            pwc83018.PutValue("TBO", UserInputHS.TBO, "")
            pwc83018.PutValue("A4", UserInputHS.A4CT, "")
            pwc83018.PutValue("BARO", LOG_PERF_P_BARO_PSIA.Value.ToString, "")
            pwc83018.PutValue("DYNO_TQ", LOG_PERF_DYNO_TORQUE_LBSFT.Value.ToString, "")
