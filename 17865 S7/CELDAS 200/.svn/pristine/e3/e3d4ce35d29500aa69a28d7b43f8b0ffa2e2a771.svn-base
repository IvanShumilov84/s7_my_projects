        Public Function UpdateCustomHeaderLogFile(ByVal AppendOption As Boolean, ByVal IsPerfEntry As Boolean, ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean
            Dim Log_Condition As Integer

            If AppendOption = False Then
                Log_Condition = 1
            Else
                'Log_Condition = (ExcelWorksheet.Cells(RowIndex + 1, 1).End(Excel.XlDirection.xlToRight).Column - 1)
                'TODO: Ici changement du au nouveau Microsoft.Office.Interop.Excel	                        'Log_Condition = (ExcelWorksheet.Cells(RowIndex + 1, 1).End(XlDirection.xlToRight).Column - 1)  'cette ligne en office 2010 retourne toujours 16384 -1 donc 16383 et le reste du code plante
                Log_Condition = ExcelWorksheet.Cells(RowIndex + 1, ExcelWorksheet.Columns.Count).End(Excel.XlDirection.xlToLeft).Column - 1
                Log_Condition = Log_Condition + 1

            End If

            If ((Log_Condition > 1) And ((Log_Condition Mod 5) = 1)) Then

                'Repeat The Test Spec For this new sets of condition

                With ExcelWorksheet
                    .Range(.Cells(2, 2), .Cells(RowIndex - 2, 6)).Copy(.Cells(2, Log_Condition + 1))
                End With
            End If

            ColumnIndex = 1 + Log_Condition

            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Format(Now, "yyyy/MM/dd HH:mm:ss")
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += 1
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Log_Condition.ToString()
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += 1
            If IsPerfEntry = False Then
                Dim CommentText As String = ""
                Dim InputObject As New InputCommentForm
                InputObject.ShowDialog("Log Report", "Comment:", "", CommentText)

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = CommentText
            Else
                '						ExcelWorkSheet.Cells(RowIndex, ColumnIndex).Value				= "STEP: " & TEST_STEP_NB.Value.ToString() & " " & Now.ToString()
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "STEP: " & TestStep_List.SelectedItem & " " & Now.ToString()
            End If

            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
            RowIndex += 2
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Values"
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignCenter
        End Function

        Private Sub OnBTN_PERFORMANCE_RUN(sender As IChannel, newVal As Value)
            Try
                If (newVal Is Values.True) Then

                    'Update the Log/Perf channel set
                    CELProject.LogPerfSynch.UpdateValues()

                    CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, False, CELProject.EngineModel, True)

                    ProcessCondition()

                    Dim iCondition As Integer
                    pwc83018.GetCondition(iCondition)

                    ' Get DLL data only if we got 4 conditions or more (otherwise data are not good)
                    If Recommendation_Condition = True Then

                        ' JSR : Faire attention car la function pwc83018.GetResult() retourne 0 s'il n'a
                        '       pas de recommendation ou dans le cas ou les inputs sont valid. 
                        '       Dans le cas d'un 0, il faut remettre la valeur d'entree pour eviter toute 
                        '       confusion et ce, pour cahque parametre.

                        ' Get value from DLL memory and show it in the HMI
                        Dim reportValue As Double

                        pwc83018.GetResult("MGTBIAS", reportValue) ' MGT Measured Gas Temperature Bias Recommendation
                        If reportValue = 0 Then
                            PERF_MGT_TRIM_DEGF_RECOMMEND.Value = New KineticaRT.Values.Double(PERF_MGT_TRIM_DEGF.Value.ToDouble)
                        Else
                            PERF_MGT_TRIM_DEGF_RECOMMEND.Value = New KineticaRT.Values.Double(reportValue)
                        End If

                        pwc83018.GetResult("TBIAS", reportValue) ' T/M Bias Recommendation
                        If reportValue = 0 Then
                            PERF_TM_BIAS_RECOMMEND.Value = New KineticaRT.Values.Double(PERF_TM_BIAS.Value.ToDouble)
                        Else
                            PERF_TM_BIAS_RECOMMEND.Value = New KineticaRT.Values.Double(reportValue)
                        End If

                        pwc83018.GetResult("TGAIN", reportValue) ' T/M Gain Recommendation
                        If reportValue = 0 Then
                            PERF_TM_GAIN_RECOMMEND.Value = New KineticaRT.Values.Double(PERF_TM_GAIN.Value.ToDouble)
                        Else
                            PERF_TM_GAIN_RECOMMEND.Value = New KineticaRT.Values.Double(reportValue)
                        End If

                        pwc83018.GetResult("T2BIAS", reportValue) ' Backup T/M Bias Recommendation
                        If reportValue = 0 Then
                            PERF_TM_BIAS_BACKUP_RECOMMEND.Value = New KineticaRT.Values.Double(PERF_TM_BIAS_BACKUP.Value.ToDouble)
                        Else
                            PERF_TM_BIAS_BACKUP_RECOMMEND.Value = New KineticaRT.Values.Double(reportValue)
                        End If

                        pwc83018.GetResult("T2GAIN", reportValue) ' Backup T/M Gain Recommendation
                        If reportValue = 0 Then
                            PERF_TM_GAIN_BACKUP_RECOMMEND.Value = New KineticaRT.Values.Double(PERF_TM_GAIN_BACKUP.Value.ToDouble)
                        Else
                            PERF_TM_GAIN_BACKUP_RECOMMEND.Value = New KineticaRT.Values.Double(reportValue)
                        End If

                        pwc83018.GetResult("MGTSLOPE", reportValue) ' MGT Measured Gas Temperature Slope Recommendation 
                        If reportValue = 0 Then
                            PERF_MGT_SLOPE_RECOMMEND.Value = New KineticaRT.Values.Double(PERF_MGT_SLOPE.Value.ToDouble)
                        Else
                            PERF_MGT_SLOPE_RECOMMEND.Value = New KineticaRT.Values.Double(reportValue)
                        End If

                        pwc83018.GetResult("MGTINTCPT", reportValue) ' MGT Measured Gas Temperature Intercept Recommendation
                        If reportValue = 0 Then
                            PERF_MGT_INTERCEPT_RECOMMEND.Value = New KineticaRT.Values.Double(PERF_MGT_INTERCEPT.Value.ToDouble)
                        Else
                            PERF_MGT_INTERCEPT_RECOMMEND.Value = New KineticaRT.Values.Double(reportValue)
                        End If

                    End If

                    PERF_PERFORMANCE_RUN_BTN.Value = Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("PWC83018_Sequence : OnBTN_PERFORMANCE_RUN()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub OnTORQUE_TRIM_METHOD(sender As IChannel, newVal As Value)
            Try
                If (sender Is PERF_DCU_METHOD_CHKBOX) Then
                    If CELProject.IsTrue(newVal) Then
                        PERF_TRIM_BOX_METHOD_CHKBOX.Value = Values.False
                    End If
                End If

                If (sender Is PERF_TRIM_BOX_METHOD_CHKBOX) Then
                    If CELProject.IsTrue(newVal) Then
                        PERF_DCU_METHOD_CHKBOX.Value = Values.False
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("PWC83018_Sequence : OnTORQUE_TRIM_METHOD()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Private Sub OnRESET_BTN(sender As IChannel, newVal As Value)
            Try
                If (newVal Is Values.True) Then

                    Initialize_Perf()
                    Initialize()

                    RESET_BTN.Value = Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("PWC83018_Sequence : OnRESET_BTN()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionInitialized(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                MyBase.OnTestSessionInitialized(newStatus)

                If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then

                    Select Case CELProject.EngineFamily

                        Case "PW200"

                            'Client Initialization
                            Dim endpointAddress As New EndpointAddress(Configuration.CreateServerUriString())
                            Dim binding As System.ServiceModel.Channels.Binding = Configuration.CreateBinding()
                            Dim factory As New ChannelFactory(Of IPwc83018)(binding, endpointAddress)
                            pwc83018 = factory.CreateChannel()

                            UserInputHS.MapUserInputHS14085Parameters(CELProject)

                            Init_Engine_Channels()
                            CopyConfigurationFiles()
                            If Initialize_Perf() = False Then
                                Perf_Status_Close = True
                                CELProject.Test_Mgr_Cmd.Value = New KineticaRT.Values.Text(CELDAS.eTest_Mgr_Cmd.Close)
                            Else
                                Perf_Status_Close = False
                            End If

                            'CreateLogFile() Ajouter Creation du Log generique
                            Initialize()

                    End Select
                End If
            Catch Ex As Exception
                MessageBox.Show("PWC83018_Sequence : OnTestSessionInitialized()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionOpened(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionOpened(newStatus)

            Catch ex As Exception

                MessageBox.Show("PWC83018_Sequence.OnTestSessionOpened: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)

            End Try
        End Sub

        Protected Overrides Sub OnTestSessionRunning(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                MyBase.OnTestSessionRunning(newStatus)
                If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then

                    Select Case CELProject.EngineFamily

                        Case "PW200"

                            If Perf_Status_Close Then
                                CELProject.Test_Mgr_Cmd.Value = New KineticaRT.Values.Text(CELDAS.eTest_Mgr_Cmd.Close)
                            End If
                            CreateHandler()

                    End Select
                End If
            Catch Ex As Exception
                MessageBox.Show("PWC83018_Sequence : OnTestSessionRunning()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionClosing(newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionClosing(newStatus)
                If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then
                    Select Case CELProject.EngineFamily

                        Case "PW200"

                            DeleteHandler()

                    End Select
                End If
            Catch Ex As Exception
                MessageBox.Show("PWC83018_Sequence : OnTestSessionClosing()" & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

