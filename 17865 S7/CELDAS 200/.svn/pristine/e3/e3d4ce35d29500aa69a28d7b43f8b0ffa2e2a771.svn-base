Namespace StudioDemonstration
    Public Class PWC83018_Sequence
        Inherits CEL.KineticaRT.Sequence.Sequence

        Private CELProject As CELDAS = CELDAS.Instance()

        Private Const sPWCConfigurationPath As String = "C:\Program Files\Pratt & Whitney Canada\PWC83018\configuration\"
        Private Const sDataPath As String = "C:\Program Files\Pratt & Whitney Canada\PWC83018\data\"
        Private Const sConfigurationPath As String = ".\PWC\PWC83018_configuration\"

        Private Sub CopyConfigurationFiles()

            Dim filesToCopy As FileInfo
            Dim filesToDelete As FileInfo
            Dim prattConfigDir As New DirectoryInfo(sPWCConfigurationPath) 'TODO sur un pc en x64 le programme de Pratt pwc83018 s'installe dans Program FIles (x86) et non dans Program Files
            Dim celdasConfigDir As New DirectoryInfo(sConfigurationPath)

            If celdasConfigDir.Exists Then

                Try
                    'Modify permissions to modify contents of configuration directory
                    celdasConfigDir.Attributes = FileAttributes.Normal

                    'Modify permissions of each file in order to delete the configuration files
                    For Each filesToDelete In celdasConfigDir.GetFiles()
                        filesToDelete.Attributes = FileAttributes.Normal
                        filesToDelete.Delete()
                    Next

                Catch Ex As Exception
                    MessageBox.Show("PWC83018_Sequence: CopyConfigurationFiles()" & vbCr & _
                                    "Failed to delete files from datareduction directory." & vbCr & _
                                    Ex.ToString(), _
                                    "Error", _
                                    MessageBoxButtons.OK, _
                                    MessageBoxIcon.Error)
                    Exit Sub
                End Try

            Else

                Try
                    celdasConfigDir.Create() 'If directory doen't already exist, Create It.
                Catch Ex As Exception
                    MessageBox.Show("PWC83018_Sequence: CopyConfigurationFiles()" & vbCr & _
                                    "Failed to create directory for datareduction program." & vbCr & _
                                    Ex.Message(), _
                                    "Error", _
                                    MessageBoxButtons.OK, _
                                    MessageBoxIcon.Error)
                End Try

            End If

            For Each filesToCopy In prattConfigDir.GetFiles()
                File.Copy(filesToCopy.FullName, sConfigurationPath + filesToCopy.Name)
            Next

        End Sub
        Protected Overrides Sub OnEngineWorkingThread()
            'DoNothing
        End Sub
        Private Function CreateHandler() As Boolean
            Try
                If CELProject.EngineFamily = "PW200" Then
                    AddHandler PERF_DCU_METHOD_CHKBOX.ValueChanged, AddressOf OnTORQUE_TRIM_METHOD
                    AddHandler PERF_TRIM_BOX_METHOD_CHKBOX.ValueChanged, AddressOf OnTORQUE_TRIM_METHOD
                    AddHandler PERF_PERFORMANCE_RUN_BTN.ValueChanged, AddressOf OnBTN_PERFORMANCE_RUN
                    AddHandler RESET_BTN.ValueChanged, AddressOf OnRESET_BTN

                End If

                Return True
            Catch ex As Exception
                MessageBox.Show("PWC83018_Sequence : CreateHandler()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return False
            End Try
        End Function

        Private Function DeleteHandler() As Boolean
            Try
                If CELProject.EngineFamily = "PW200" Then
                    If Not PERF_DCU_METHOD_CHKBOX Is Nothing Then
                        RemoveHandler PERF_DCU_METHOD_CHKBOX.ValueChanged, AddressOf OnTORQUE_TRIM_METHOD
                    End If
                    If Not PERF_TRIM_BOX_METHOD_CHKBOX Is Nothing Then
                        RemoveHandler PERF_TRIM_BOX_METHOD_CHKBOX.ValueChanged, AddressOf OnTORQUE_TRIM_METHOD
                    End If
                    If Not PERF_PERFORMANCE_RUN_BTN Is Nothing Then
                        RemoveHandler PERF_PERFORMANCE_RUN_BTN.ValueChanged, AddressOf OnBTN_PERFORMANCE_RUN
                    End If
                    If Not RESET_BTN Is Nothing Then
                        RemoveHandler RESET_BTN.ValueChanged, AddressOf OnRESET_BTN
                    End If

                End If

                Return True
            Catch ex As Exception
                MessageBox.Show("PWC83018_Sequence : DeleteHandler()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return False
            End Try
        End Function

        Private Function GetOutputFilename() As String
            Dim conditionNo As Integer
            Dim engineBuildNo As Integer
            Dim engineSN As String = ""
            Dim fileName As String

            pwc83018.GetEngine(engineSN)
            pwc83018.GetBuild(engineBuildNo)
            pwc83018.GetCondition(conditionNo)

            fileName = sDataPath + "OUT_" + engineSN + "_" + Format(engineBuildNo, "0000") + _
                "_" + Format(conditionNo, "0000") + ".DAT"

            Return fileName
        End Function

