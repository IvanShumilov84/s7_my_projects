 	Public class Performance_Sequence
        Inherits CEL.KineticaRT.Sequence.Sequence 

        Private CELProject As CELDAS = CELDAS.Instance()

        '********************************************************************
		'* Private Variable Declaration *************************************
		'********************************************************************	

        Private Const drpDataPath As String = "C:\drp\incoming\"

        '********************************************************************
        '* Private Methods **************************************************
        '********************************************************************

        Protected Overrides Sub OnEngineWorkingThread()
            'DoNothing
        End Sub

        '*******************
		'* CreateHandler() *
		'*******************
        Private Function CreateHandler() As Boolean
            Try
                If CELProject.EngineFamily = "T700" Then
                    AddHandler PERF_PERFORMANCE_RUN_BTN.ValueChanged, AddressOf OnBTN_PERFORMANCE_RUN
                    AddHandler PERF_PERFORMANCE_SAVE_BTN.ValueChanged, AddressOf OnBTN_PERFORMANCE_SAVE
                    AddHandler PERF_PERFORMANCE_VIEW_BTN.ValueChanged, AddressOf OnBTN_PERFORMANCE_VIEW
                    AddHandler PwrSetting_List.SelectedIndexChanged, AddressOf OnPwrSetting_List_SelectedIndexChanged
                End If

                Return True
            Catch ex As Exception
                clsTopMostMessageBox.Show("Performance_Sequence : CreateHandler()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return False
            End Try
        End function


        '*******************
		'* DeleteHandler() *
		'*******************
        Private Function DeleteHandler() As Boolean
            Try
                If Not PERF_PERFORMANCE_RUN_BTN Is Nothing Then
                    RemoveHandler PERF_PERFORMANCE_RUN_BTN.ValueChanged, AddressOf OnBTN_PERFORMANCE_RUN
                End If
                If Not PERF_PERFORMANCE_SAVE_BTN Is Nothing Then
                    RemoveHandler PERF_PERFORMANCE_SAVE_BTN.ValueChanged, AddressOf OnBTN_PERFORMANCE_SAVE
                End If
                If Not PERF_PERFORMANCE_VIEW_BTN Is Nothing Then
                    RemoveHandler PERF_PERFORMANCE_VIEW_BTN.ValueChanged, AddressOf OnBTN_PERFORMANCE_VIEW
                End If
				If Not (PwrSetting_List Is Nothing ) Then
					RemoveHandler PwrSetting_List.SelectedIndexChanged,	AddressOf OnPwrSetting_List_SelectedIndexChanged
				End If

                Return True
            Catch ex As Exception
                clsTopMostMessageBox.Show("Performance_Sequence : DeleteHandler()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return False
            End Try
        End Function

        '**************************
        '* Init_Channels()        *
        '**************************
		Private Function Init_Channels() As Boolean
			Try                
			    Dim i				As Integer
			    Dim Return_Value 	As New ArrayList()

			    Return_Value.Clear()

			    'Initialise Channels
                'Return_Value.Add(MyBase.InitializeChannel(OpenPerfWindow, "OpenPerfWindow"))
                'Return_Value.Add(MyBase.InitializeChannel(PWR_STEP_CODE, "PWR_STEP_CODE"))

                If Return_Value.Contains(False) Then
                    Return False
                Else
                    Return True
                End If

            Catch ex As Exception
                clsTopMostMessageBox.Show("Performance_Sequence : Init_Channels()" & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return False
            End Try
        End Function

        '**************************
        '* Init_Engine_Channels() *
        '**************************
        Private Function Init_Engine_Channels() As Boolean
            Dim i As Integer
            Dim Return_Value As New ArrayList()

            Return_Value.Clear()

            Try


                Select Case CELProject.EngineFamily
                    'Not For "DAS CALIBRATION"
                    Case "T700"
                        'Initialise Engine Channels				
                        Return_Value.Add(MyBase.InitializeChannel(CONDITION_NUMBER, "CONDITION_NUMBER"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_DEC_TORQUE_LBSFT, "LOG_PERF_DEC_TORQUE_LBSFT"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_FHVI, "LOG_PERF_FHVI"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_LDS_CALIB_DEG, "LOG_PERF_LDS_CALIB_DEG"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_NG_RPM, "LOG_PERF_NG_RPM"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_NP_RPM, "LOG_PERF_NP_RPM"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_EXHAUST_1_PSIA, "LOG_PERF_P_EXHAUST_1_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_EXHAUST_1_PSIA, "LOG_PERF_P_EXHAUST_2_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_S_INLET_1_PSIA, "LOG_PERF_P_S_INLET_1_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_S_INLET_2_PSIA, "LOG_PERF_P_S_INLET_2_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_S_INLET_3_PSIA, "LOG_PERF_P_S_INLET_3_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_S_INLET_4_PSIA, "LOG_PERF_P_S_INLET_4_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_S_INLET_5_PSIA, "LOG_PERF_P_S_INLET_5_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_S_INLET_6_PSIA, "LOG_PERF_P_S_INLET_6_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_S_INLET_7_PSIA, "LOG_PERF_P_S_INLET_7_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_S_INLET_8_PSIA, "LOG_PERF_P_S_INLET_8_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_T_INLET_1_PSIA, "LOG_PERF_P_T_INLET_1_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_T_INLET_2_PSIA, "LOG_PERF_P_T_INLET_2_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_T_INLET_3_PSIA, "LOG_PERF_P_T_INLET_3_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_T_INLET_4_PSIA, "LOG_PERF_P_T_INLET_4_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_UPSTREAM_PSIA, "LOG_PERF_P_UPSTREAM_AVG_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_THROAT_PSIA, "LOG_PERF_P_THROAT_AVG_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_PAS_CALIB_DEG, "LOG_PERF_PAS_CALIB_DEG"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_PS3_PSIA, "LOG_PERF_P_PS3_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_P3X_PSIA, "LOG_PERF_P_P3X_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_CELL_FRONT_PSIA, "LOG_PERF_P_CELL_FRONT_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_P_CELL_REAR_PSIA, "LOG_PERF_P_CELL_REAR_PSIA"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_DISCHARGE_1_DEGR, "LOG_PERF_T_DISCHARGE_1_DEGR"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_DISCHARGE_2_DEGR, "LOG_PERF_T_DISCHARGE_2_DEGR"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_FUEL_AVG_DEGF, "LOG_PERF_T_FUEL_AVG_DEGF"))
                        For i = 0 To LOG_PERF_T_INLET_DEGR.GetUpperBound(0) - 1
                            Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_INLET_DEGR(i), "LOG_PERF_T_INLET_" + (i + 1).ToString() + "_DEGR"))
                        Next
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_T45H_DEGR, "LOG_PERF_T_T45H_DEGR"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_UPSTREAM_AVG_DEGR, "LOG_PERF_T_UPSTREAM_AVG_DEGR"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_TORQUE_METER_TORQUE_LBSFT, "LOG_PERF_TORQUE_METER_TORQUE_LBSFT"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_VG_CALIB_DEG, "LOG_PERF_VG_CALIB_DEG"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WF1_PPH, "LOG_PERF_WF1_PPH"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WF2_PPH, "LOG_PERF_WF2_PPH"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_PERFORMANCE_RUN_BTN, "PERF_PERFORMANCE_RUN_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_PERFORMANCE_SAVE_BTN, "PERF_PERFORMANCE_SAVE_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(PERF_PERFORMANCE_VIEW_BTN, "PERF_PERFORMANCE_VIEW_BTN"))
                        Return_Value.Add(MyBase.InitializeChannel(PWR_STEP_CODE, "PWR_STEP_CODE"))

                        Return_Value.Add(MyBase.InitializeObject(Entry_Frame, CELProject.EngineFamily + "_Slave_Screen.T700_DRP_PLOT.Manual_Entry_Frame"))
                        'Manual_Entry_Frame = Entry_Frame.FindObject("Manual_Entry_Frame")
                        'T700_DRP_PLOT
                        PwrSetting_List = Entry_Frame.FindObject("PwrSetting_List")
                        If PwrSetting_List Is Nothing Then
                            MessageBox.Show("Initialize_Object - PwrSetting_List Is Nothing")
                            Return_Value.Add(False)
                        Else
                            Return_Value.Add(True)
                        End If
                End Select

            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.Message)
                Return_Value.Add(False)
            Finally

            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function

		'********************************
		'* Initialize_Engine_Controls() *
		'********************************
		Private Sub Initialize_Engine_Controls()

			Try
                Select Case CELProject.EngineModel

                    Case "T700-401C"
                        PwrSetting_List.Items.Clear()
                        PwrSetting_List.Items.Add("GROUND IDLE")
                        PwrSetting_List.Items.Add("60% MAXIMUM CONTINUOUS")
                        PwrSetting_List.Items.Add("75% MAXIMUM CONTINUOUS")
                        PwrSetting_List.Items.Add("MAXIMUM CONTINUOUS")
                        PwrSetting_List.Items.Add("INTERMEDIATE RATED POWER")
                        PwrSetting_List.Items.Add("CONTINGENCY")
                        PwrSetting_List.SelectedIndex = 0

                    Case "T700-701C"
                        PwrSetting_List.Items.Clear()
                        PwrSetting_List.Items.Add("GROUND IDLE")
                        PwrSetting_List.Items.Add("50% MAXIMUM CONTINUOUS")
                        PwrSetting_List.Items.Add("75% MAXIMUM CONTINUOUS")
                        PwrSetting_List.Items.Add("MAXIMUM CONTINUOUS")
                        PwrSetting_List.Items.Add("INTERMEDIATE RATED POWER")
                        PwrSetting_List.Items.Add("MAXIMUM")
                        PwrSetting_List.Items.Add("CONTINGENCY")
                        PwrSetting_List.SelectedIndex = 0
                End Select

			Catch ex As Exception
				MessageBox.Show("Initialize_Engine_Controls: " & ex.Message, "Error",MessageBoxButtons.OK,MessageBoxIcon.Error)
			End Try
		End Sub


