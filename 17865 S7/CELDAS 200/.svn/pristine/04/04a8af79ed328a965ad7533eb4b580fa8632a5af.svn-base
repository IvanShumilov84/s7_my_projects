            AddHandler START_BTN.ValueChanged, AddressOf OnSTART_BTN
            AddHandler cmbTestStepList.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged


            'ICI BAS LES HANDER DU 98

            AddHandler CAPTURE_AIR_PRESSURE_OUTPUT_BTN.ValueChanged, AddressOf OnCaptureBtn
            AddHandler CAPTURE_ETC_SETPOINT_BTN.ValueChanged, AddressOf OnCaptureBtn
            AddHandler CAPTURE_ETC_SETPOINT_RECHECK_BTN.ValueChanged, AddressOf OnCaptureBtn
            AddHandler CAPTURE_MAX_EGT_OVERLOAD_BTN.ValueChanged, AddressOf OnCaptureBtn
            AddHandler CAPTURE_MIN_SPEED_OVERLOAD_BTN.ValueChanged, AddressOf OnCaptureBtn
            AddHandler CAPTURE_NG_FULL_LOAD_BTN.ValueChanged, AddressOf OnCaptureBtn

