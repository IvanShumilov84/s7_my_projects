        Private Function Compute_BleedAirFlow(ByVal TOrifice_DEGF As Double, _
                                                ByVal POrifice_INHGA As Double, _
                                                ByVal POrificeDelta_INH2OG As Double) As Double Implements IBleedAirFlowCalculation.Compute_BleedAirFlow
            Try
                If CELProject.IsTrue(BLEED_AIR_VALVE_BTN.Value) Then

                    Dim BleedAirFLow As Double = CELProject.GetBleedAirFlow(CELProject.EngineConfiguration.DuctDiameter, CELProject.EngineConfiguration.DuctDiameterUnit, _
                                                                            CELProject.EngineConfiguration.OrificeDiameter, CELProject.EngineConfiguration.OrificeDiameterUnit, _
                                                                            TOrifice_DEGF, CELDAS.eTemperature.Fahrenheit, _
                                                                            POrifice_INHGA, CELDAS.ePressure.InchesOfMercury, _
                                                                            POrificeDelta_INH2OG, CELDAS.ePressure.InchesH2O, _
                                                                            CELProject.EngineConfiguration.OrificeThinkness, _
                                                                            CELProject.EngineConfiguration.OrificeThinknessUnit, _
                                                                            CELProject.EngineConfiguration.TapArrangement, _
                                                                            CELDAS.eFlowMass.LbByMin) 'Output in lb/min 

                    Return BleedAirFLow

                Else
                    Return 0.0
                End If


            Catch Ex As Exception
                'Log error
                MessageBox.Show("Error in Engine_Sequence.Compute_BleedAirFlow: " & Ex.ToString)
                Return 0.0
            End Try
        End Function

        Protected Overrides Sub Compute(ByVal CalcForLogAndPerfReports As Boolean)

            Try
                If CalcForLogAndPerfReports Then

                    LOG_PERF_WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(LOG_PERF_T_ORIFICE_DEGF.Value.ToDouble, _
                                                                                                 LOG_PERF_P_ORIFICE_INHGA.Value.ToDouble, _
                                                                                                 LOG_PERF_P_ORIFICE_DELTA_INH2OD.Value.ToDouble))

                    Compute_GTCP85_98_Perf(LOG_PERF_T_INLET_DEGF_AVG, _
                                            LOG_PERF_DELTA, _
                                            LOG_PERF_P_BARO_INHGA, _
                                            LOG_PERF_P_BLEED_INHGG, _
                                            LOG_PERF_WB_CALC, _
                                            LOG_PERF_T_BLEED_DEGF, _
                                            LOG_PERF_PBChng, _
                                            LOG_PERF_TBChng, _
                                            LOG_PERF_WBChng, _
                                            LOG_PERF_PBStd, _
                                            LOG_PERF_TBStd, _
                                            LOG_PERF_WBStd)

                    FlowmeterCtrl.ComputeFlow(True)

                    'IMPORTANT: Toutes les variables flottantes telles que WB_CALC, DELPB, LB_DEMAND dont la source et la destination sont vides doivent
                    'manuellement être updaté pour être inscrite dans le LOG ou le PERF report.
                Else

                    WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(T_ORIFICE_DEGF.Value.ToDouble, _
                                                                                      P_ORIFICE_INHGA.Value.ToDouble, _
                                                                                      P_ORIFICE_DELTA_INH2OD.Value.ToDouble))
                    Compute_GTCP85_98_Perf(T_INLET_DEGF_AVG, _
                                            DELTA, _
                                            P_BARO_INHGA, _
                                            P_BLEED_INHGG, _
                                            WB_CALC, _
                                            T_BLEED_DEGF, _
                                            PBChng, _
                                            TBChng, _
                                            WBChng, _
                                            PBStd, _
                                            TBStd, _
                                            WBStd)
                End If

            Catch ex As Exception
                MessageBox.Show("Compute_GTCP85_98" + ex.ToString(), "Error")
            End Try

        End Sub
        Private Sub Compute_GTCP85_98_Perf(ByRef tinlet_degf_avg As IChannel, _
                                           ByRef pdelta As IChannel, _
                                           ByRef pbaro_inhga As IChannel, _
                                           ByRef pbleed_inhgg As IChannel, _
                                           ByRef wbcalc As IChannel, _
                                           ByRef tbleed_degf As IChannel, _
                                           ByRef pb_chng As IChannel, _
                                           ByRef tb_chng As IChannel, _
                                           ByRef wb_chng As IChannel, _
                                           ByRef pb_std As IChannel, _
                                           ByRef tb_std As IChannel, _
                                           ByRef wb_std As IChannel)

            Dim PB As Double = 0
            Dim PBChngTable As Double = Double.NaN

            Dim TB As Double = 0
            Dim TBChngTable As Double = Double.NaN

            Dim WB As Double = 0
            Dim WBChngTable As Double = Double.NaN

            Dim Tcl As Double = tinlet_degf_avg.Value.ToDouble

            Try

                If CELProject.PERF_TEST_STEP_NB.Value.ToDouble = eTestStepGTCP85_98.NO_LOAD Or _
                    CELProject.PERF_TEST_STEP_NB.Value.ToDouble = eTestStepGTCP85_98.BLEED_LOAD_ONLY Then  'RTL or ECS ONLY
                    'ShaftLoad = 2 'No LOAD
                    WBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_98_RTL_ECS, ePerfCorrFactorIndex.WB_Chng)
                    PBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_98_RTL_ECS, ePerfCorrFactorIndex.PB_Chng)
                    TBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_98_RTL_ECS, ePerfCorrFactorIndex.TB_Chng)
                ElseIf CELProject.PERF_TEST_STEP_NB.Value.ToDouble = eTestStepGTCP85_98.COMBINATION_LOAD Then ' Default to ECS and 60+3-0 SHP
                    'ShaftLoad = 1 'ShaftLOAD
                    'Note: le tableau des valeurs en shaft load sont loade en memoire dans Init_Arrays selon le repair type Overhaul ou Repair
                    'donc pas besoin de faire ici un "if Overhaul then else Repair ..."
                    WBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_98_ECS_AND_SHP, ePerfCorrFactorIndex.WB_Chng)
                    PBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_98_ECS_AND_SHP, ePerfCorrFactorIndex.PB_Chng)
                    TBChngTable = CELProject.Interpolation_1D(Tcl, GTCP85_98_ECS_AND_SHP, ePerfCorrFactorIndex.TB_Chng)
                End If

                ' Verify that DELTA is NOT zero to prevent divide by zero error
                If pdelta.Value.ToDouble = 0.0 Then
                    WB = Double.NaN
                    PB = Double.NaN
                Else
                    ' P_BLEED Value is in.HgG, the PBStd value is expected in in.HGA.  We must add BARO value
                    PB = (pbaro_inhga.Value.ToDouble + pbleed_inhgg.Value.ToDouble) / pdelta.Value.ToDouble + PBChngTable
                    WB = (wbcalc.Value.ToDouble / pdelta.Value.ToDouble) + WBChngTable
                End If

                TB = tbleed_degf.Value.ToDouble + TBChngTable


                'Update KineticaRT Channels
                pb_chng.Value = New KineticaRT.Values.Double(PBChngTable)
                tb_chng.Value = New KineticaRT.Values.Double(TBChngTable)
                wb_chng.Value = New KineticaRT.Values.Double(WBChngTable)

                pb_std.Value = New KineticaRT.Values.Double(PB)
                tb_std.Value = New KineticaRT.Values.Double(TB)
                wb_std.Value = New KineticaRT.Values.Double(WB)
            Catch Ex As Exception
                MessageBox.Show("Compute_GTCP85_98_Perf: " & Ex.ToString)
            Finally
            End Try
        End Sub
        Private Sub Compute_Time()
            'TODO COmpute time a remplacer par le controleur
            Try
                If NG_PCT.Value.ToDouble > 95.0 Then

                    If LastStart Then
                        OperatingTime = OperatingTime.Add(Now.Subtract(OperatingTime_Start))
                    End If

                    LastStart = True
                    OperatingTime_Start = Now
                Else
                    LastStart = False
                End If

                OPERATING_TIME_MINUTE.Value = New KineticaRT.Values.Double((OperatingTime.Hours * 60) + OperatingTime.Minutes + (OperatingTime.Seconds / 60))

            Catch Ex As Exception
                MessageBox.Show("Compute_Time: " & Ex.ToString())
            End Try

        End Sub

        Protected Overrides Sub OnCLOSE_TEST_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    MyBase.StopWorkingThread()

                    If TestProgressMgr IsNot Nothing Then
                        TestProgress_Save()
                        TestProgressMgr.Dispose()
                        TestProgressMgr = Nothing
                    End If

                    'Persistent Values Force Save
                    GTCP85_98_PersistentValuesCtrl.SavePersistentValues(True)

                    RemoveHandlers()

                    Dispose_Engine_Controllers()

                    GTCP85_98_PersistentValuesCtrl.Dispose()


                End If

                CELProject.CLOSE_TEST_BTN.Value = Values.False

            Catch Ex As Exception
                MessageBox.Show("OnCLOSE_TEST_BTN: " & Ex.ToString())
            End Try
        End Sub
        Protected Overrides Sub OnLOG_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    'Update the Log/Perf channel set
                    CELProject.LogPerfSynch.UpdateValues()

                    'Synchronize data for Log and Performance
                    Compute(True)

                    CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, False, "GTCP85-98", True)
                    CELProject.LOG_TAKE_POINT_BTN.Value = Values.False
                End If

            Catch Ex As Exception
