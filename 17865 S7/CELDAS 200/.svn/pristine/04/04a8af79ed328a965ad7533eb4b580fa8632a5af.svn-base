        'Les constantes sont lu a partir du fichier celdas_XXXXX.cfg
        Private NumberOfTInletProbe As Integer = 0
        Private RealNumberOfTInletProbe As Integer = 0
        Private NumberOfTEgtProbe As Integer = 0
        Private RealNumberOfTEgtProbe As Integer = 0


#Region " Enum "

        Public Enum eRepairType
            Heavy = 0
            LightMedium = 1
        End Enum
        Public Enum eShaftLoad
            Sixty60SHP = 1
            ZeroSHP = 2
        End Enum


        Private Enum eTestStepGTCP85_98
            ACCELERATION_CRACK_PRESSURE = 0
            MANUAL_START_CHECK = 1 'step 1.E.2
            NO_LOAD = 2
            COMBINATION_LOAD = 3
            BLEED_LOAD_ONLY = 4
            ACCELERATION_CRACK_PRESSURE_RECHECK = 5
            CAPTURE_FINAL_DATA = 6
        End Enum

        Private Enum ePerfCorrFactorIndex
            TCL = 0
            WB_Chng = 1
            PB_Chng = 2
            TB_Chng = 3
            Last_Index = 3 'has to be equal to the last one
        End Enum

#End Region

        Private Function Create13031PerformanceFile(ByVal AppendOption As Boolean, _
                                                    ByVal TestStepNumber As Integer, _
                                                    ByVal ProtectPassword As String, _
                                                    ByVal UnProtectPassword As String, _
                                                    ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim currentSheet As String
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            Create13031PerformanceFile = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            Try
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    'SUMMARY Header
                    currentSheet = "SUMMARY"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    Dim row As Integer = 2
                    Dim column As Integer = 5

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = CELProject.EngineModel + " APU TEST DATA SHEET"

                    row = 5
                    column = 3

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.CustomerName
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.WorkOrder
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.EnginePartNumberAndServiceBulletin
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.EngineSerialNumber
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.RepairTypeDescription
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.TestType

                    row = 5
                    column = 9

                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = Format(Now, "MM/dd/yyyy")
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.LHV
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.SampleFuelSG
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.SampleFuelTemperature
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.FuelType
                    row += 1
                    excelWorksheet.Cells(row, column).NumberFormat = "@"
                    excelWorksheet.Cells(row, column).Value = UserInputs.OilType

                    currentSheet = "ACCEPTANCE"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    'APU Tested according to
                    excelWorksheet.Cells(48, 4).NumberFormat = "@"
                    excelWorksheet.Cells(48, 4).Value = Custom_Parameters("APUTestedAccordingTo").ToString()


                End If

                currentSheet = "SUMMARY"
                excelWorksheet = excelSheets.Item(currentSheet)

                Select Case TestStepNumber
                    Case eTestStepGTCP85_98.ACCELERATION_CRACK_PRESSURE

                        excelWorksheet.Cells(40, 7).Value = Log_Perf_AccelLimitValveCrack.Value.ToString(Log_Perf_AccelLimitValveCrack.Format, Nothing)

                        'Case eTestStepGTCP85_98.RTL:
                    Case eTestStepGTCP85_98.NO_LOAD

                        'Test Performance Detail
                        excelWorksheet.Cells(54, 7).Value = PERF_SPEED_SWITCH_ACTUATION_35_PCT_OPC.Value.ToString(PERF_SPEED_SWITCH_ACTUATION_35_PCT_OPC.Format, Nothing)
                        excelWorksheet.Cells(55, 7).Value = PERF_SPEED_SWITCH_ACTUATION_95_PCT_OPC.Value.ToString(PERF_SPEED_SWITCH_ACTUATION_95_PCT_OPC.Format, Nothing)


                        excelWorksheet.Cells(17, 6).Value = "N/A" 'PBStd_MEAN.Value.ToString(				PBStd_MEAN.Format				,Nothing)
                        excelWorksheet.Cells(19, 6).Value = "N/A" 'WBStd_MEAN.Value.ToString(				WBStd_MEAN.Format				,Nothing)
                        excelWorksheet.Cells(21, 6).Value = "N/A" 'TBStd_MEAN.Value.ToString(				TBStd_MEAN.Format				,Nothing)
                        excelWorksheet.Cells(22, 6).Value = LOG_PERF_T_EGT_DEGF_AVG.Value.ToString(LOG_PERF_T_EGT_DEGF_AVG.Format, Nothing)
                        excelWorksheet.Cells(24, 6).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)
                        excelWorksheet.Cells(26, 6).Value = "N/A" 'GEN_COR_MEAN.Value.ToString(				GEN_COR_MEAN.Format				,Nothing)
                        excelWorksheet.Cells(28, 6).Value = LOG_PERF_VIB_GEARBOX_MILS.Value.ToString(LOG_PERF_VIB_GEARBOX_MILS.Format, Nothing)
                        excelWorksheet.Cells(30, 6).Value = LOG_PERF_VIB_TURBINE_MILS.Value.ToString(LOG_PERF_VIB_TURBINE_MILS.Format, Nothing)

                        'Case eTestStepGTCP85_98.ECS_ONLY:
                    Case eTestStepGTCP85_98.BLEED_LOAD_ONLY


                        excelWorksheet.Cells(17, 8).Value = LOG_PERF_PBStd.Value.ToString(LOG_PERF_PBStd.Format, Nothing)
                        excelWorksheet.Cells(17, 7).Value = LOG_PERF_PBStd_LOW_LIMIT.Value.ToString(LOG_PERF_PBStd_LOW_LIMIT.Format, Nothing)

                        excelWorksheet.Cells(19, 8).Value = LOG_PERF_WBStd.Value.ToString(LOG_PERF_WBStd.Format, Nothing)
                        excelWorksheet.Cells(19, 7).Value = LOG_PERF_WBStd_LOW_LIMIT.Value.ToString(LOG_PERF_WBStd_LOW_LIMIT.Format, Nothing)

                        excelWorksheet.Cells(21, 8).Value = LOG_PERF_TBStd.Value.ToString(LOG_PERF_TBStd.Format, Nothing)
                        excelWorksheet.Cells(21, 7).Value = LOG_PERF_TBStd_LOW_LIMIT.Value.ToString(LOG_PERF_TBStd_LOW_LIMIT.Format, Nothing) + " " + _
                            LOG_PERF_TBStd_HI_LIMIT.Value.ToString(LOG_PERF_TBStd_HI_LIMIT.Format, Nothing)

                        excelWorksheet.Cells(22, 8).Value = LOG_PERF_T_EGT_DEGF_AVG.Value.ToString(LOG_PERF_T_EGT_DEGF_AVG.Format, Nothing)
                        excelWorksheet.Cells(22, 7).Value = LOG_PERF_T_EGT_DEGF_TURBINE_DISCHARGE_TEMP_MAX_LIMIT.Value.ToString(LOG_PERF_T_EGT_DEGF_TURBINE_DISCHARGE_TEMP_MAX_LIMIT.Format, Nothing)

                        excelWorksheet.Cells(24, 8).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)
                        excelWorksheet.Cells(26, 8).Value = "N/A" 'GEN_COR_MEAN.Value.ToString(				GEN_COR_MEAN.Format				,Nothing)								
                        excelWorksheet.Cells(28, 8).Value = LOG_PERF_VIB_GEARBOX_MILS.Value.ToString(LOG_PERF_VIB_GEARBOX_MILS.Format, Nothing)
                        excelWorksheet.Cells(30, 8).Value = LOG_PERF_VIB_TURBINE_MILS.Value.ToString(LOG_PERF_VIB_TURBINE_MILS.Format, Nothing)

                        'Case eTestStepGTCP85_98.ECS_60SHP:
                    Case eTestStepGTCP85_98.COMBINATION_LOAD

                        'Performance Limits at 60HP depends on type of repair Heavy / Light Medium
                        If UserInputs.RepairTypeID = Gtcp8598.eRepairType.OverhauledEngine Then

                            excelWorksheet.Cells(26, 9).Value = "60-63"      'SHPCOR 'TODO

                        Else 'light/med

                            excelWorksheet.Cells(26, 9).Value = "60-63"      'SHPCOR 'TODO

                        End If

                        excelWorksheet.Cells(17, 10).Value = LOG_PERF_PBStd.Value.ToString(LOG_PERF_PBStd.Format, Nothing)
                        excelWorksheet.Cells(17, 9).Value = LOG_PERF_PBStd_LOW_LIMIT.Value.ToString(LOG_PERF_PBStd_LOW_LIMIT.Format, Nothing)

                        excelWorksheet.Cells(19, 10).Value = LOG_PERF_WBStd.Value.ToString(LOG_PERF_WBStd.Format, Nothing)
                        excelWorksheet.Cells(19, 9).Value = LOG_PERF_WBStd_LOW_LIMIT.Value.ToString(LOG_PERF_WBStd_LOW_LIMIT.Format, Nothing)

                        excelWorksheet.Cells(21, 10).Value = LOG_PERF_TBStd.Value.ToString(LOG_PERF_TBStd.Format, Nothing)
                        excelWorksheet.Cells(21, 9).Value = LOG_PERF_TBStd_LOW_LIMIT.Value.ToString(LOG_PERF_TBStd_LOW_LIMIT.Format, Nothing) + " " + _
                            LOG_PERF_TBStd_HI_LIMIT.Value.ToString(LOG_PERF_TBStd_HI_LIMIT.Format, Nothing)

                        excelWorksheet.Cells(22, 10).Value = LOG_PERF_T_EGT_DEGF_AVG.Value.ToString(LOG_PERF_T_EGT_DEGF_AVG.Format, Nothing)
                        excelWorksheet.Cells(22, 9).Value = LOG_PERF_T_EGT_DEGF_TURBINE_DISCHARGE_TEMP_MAX_LIMIT.Value.ToString(LOG_PERF_T_EGT_DEGF_TURBINE_DISCHARGE_TEMP_MAX_LIMIT.Format, Nothing)

                        excelWorksheet.Cells(24, 10).Value = LOG_PERF_WF_PPH.Value.ToString(LOG_PERF_WF_PPH.Format, Nothing)
                        excelWorksheet.Cells(26, 10).Value = LOG_PERF_GENERATOR_CORRECTED_SHP.Value.ToString(LOG_PERF_GENERATOR_CORRECTED_SHP.Format, Nothing)
                        excelWorksheet.Cells(26, 9).Value = LOG_PERF_GENERATOR_SHP_MIN_LIMIT.Value.ToString(LOG_PERF_GENERATOR_SHP_MIN_LIMIT.Format, Nothing) + "-" + LOG_PERF_GENERATOR_SHP_MAX_LIMIT.Value.ToString(LOG_PERF_GENERATOR_SHP_MAX_LIMIT.Format, Nothing)

                        excelWorksheet.Cells(28, 10).Value = LOG_PERF_VIB_GEARBOX_MILS.Value.ToString(LOG_PERF_VIB_GEARBOX_MILS.Format, Nothing)
                        excelWorksheet.Cells(30, 10).Value = LOG_PERF_VIB_TURBINE_MILS.Value.ToString(LOG_PERF_VIB_TURBINE_MILS.Format, Nothing)


                        excelWorksheet.Cells(37, 7).Value = LOG_PERF_P_BARO_INHGA.Value.ToString(LOG_PERF_P_BARO_INHGA.Format, Nothing)
                        excelWorksheet.Cells(38, 7).Value = LOG_PERF_T_CELL_DEGF.Value.ToString(LOG_PERF_T_CELL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(39, 7).Value = LOG_PERF_T_INLET_DEGF_AVG.Value.ToString(LOG_PERF_T_INLET_DEGF_AVG.Format, Nothing)

                    Case eTestStepGTCP85_98.CAPTURE_FINAL_DATA

                        '37 Bare made in step combination load
                        '39 Tinlet made in step combination load
                        '40 in crack pressure check step
                        excelWorksheet.Cells(41, 7).Value = Log_Perf_GearboxVibration.Value.ToString(Log_Perf_GearboxVibration.Format, Nothing)
                        excelWorksheet.Cells(43, 7).Value = Log_Perf_TurbineVibration.Value.ToString(Log_Perf_TurbineVibration.Format, Nothing)
                        excelWorksheet.Cells(45, 7).Value = Log_Perf_ShaftSpeed.Value.ToString(Log_Perf_ShaftSpeed.Format, Nothing)
                        excelWorksheet.Cells(45, 9).Value = LOG_PERF_NG_100_RPM_CST.Value.ToString(LOG_PERF_NG_100_RPM_CST.Format, Nothing) + "±100"

                        excelWorksheet.Cells(46, 7).Value = Log_Perf_FuelPumpInletPress.Value.ToString(Log_Perf_FuelPumpInletPress.Format, Nothing)
                        excelWorksheet.Cells(46, 9).Value = LOG_PERF_P_FUEL_PUMP_INLET_PSIG_LIMIT_LOW.Value.ToString(LOG_PERF_P_FUEL_PUMP_INLET_PSIG_LIMIT_LOW.Format, Nothing) + " to " + _
                            LOG_PERF_P_FUEL_PUMP_INLET_PSIG_LIMIT_HI.Value.ToString(LOG_PERF_P_FUEL_PUMP_INLET_PSIG_LIMIT_HI.Format, Nothing)

                        excelWorksheet.Cells(47, 7).Value = Log_Perf_FuelPumpDischPress.Value.ToString(Log_Perf_FuelPumpDischPress.Format, Nothing)
                        excelWorksheet.Cells(48, 7).Value = Log_Perf_OilPumpDischPress.Value.ToString(Log_Perf_OilPumpDischPress.Format, Nothing)
                        excelWorksheet.Cells(49, 7).Value = Log_Perf_Oil_Pump_Disch_Fluc.Value.ToString(Log_Perf_Oil_Pump_Disch_Fluc.Format, Nothing)
                        excelWorksheet.Cells(50, 7).Value = Log_Perf_OilPumpDischTemp.Value.ToString(Log_Perf_OilPumpDischTemp.Format, Nothing)

                        excelWorksheet.Cells(52, 7).Value = Log_Perf_TurbineBearingCavPress.Value.ToString(Log_Perf_TurbineBearingCavPress.Format, Nothing)
                        excelWorksheet.Cells(52, 9).Value = LOG_PERF_P_TURBINE_BEARING_CAVITY_INHGG_HIGH_LIMIT.Value.ToString(LOG_PERF_P_TURBINE_BEARING_CAVITY_INHGG_HIGH_LIMIT.Format, Nothing)
                        excelWorksheet.Cells(52, 10).Value = LOG_PERF_P_TURBINE_BEARING_CAVITY_INHGG_LOW_LIMIT.Value.ToString(LOG_PERF_P_TURBINE_BEARING_CAVITY_INHGG_LOW_LIMIT.Format, Nothing)

                        excelWorksheet.Cells(53, 7).Value = Log_Perf_GearboxCavNegPress.Value.ToString(Log_Perf_GearboxCavNegPress.Format, Nothing)
                        excelWorksheet.Cells(53, 9).Value = LOG_PERF_P_ACCESSORY_GEARCASE_INHGG_HIGH_LIMIT.Value.ToString(LOG_PERF_P_ACCESSORY_GEARCASE_INHGG_HIGH_LIMIT.Format, Nothing)
                        excelWorksheet.Cells(53, 10).Value = LOG_PERF_P_ACCESSORY_GEARCASE_INHGG_LOW_LIMIT.Value.ToString(LOG_PERF_P_ACCESSORY_GEARCASE_INHGG_LOW_LIMIT.Format, Nothing)
                        '54 In step no load
                        '55 In step no load
                        excelWorksheet.Cells(56, 7).Value = Log_Perf_FullLoadGovSpeedDroop.Value.ToString(Log_Perf_FullLoadGovSpeedDroop.Format, Nothing)
                        excelWorksheet.Cells(56, 9).Value = Log_Perf_FullLoadGovSpeedDroop_LOW_LIMIT.Value.ToString(Log_Perf_FullLoadGovSpeedDroop_LOW_LIMIT.Format, Nothing)
                        excelWorksheet.Cells(56, 10).Value = Log_Perf_FullLoadGovSpeedDroop_HI_LIMIT.Value.ToString(Log_Perf_FullLoadGovSpeedDroop_HI_LIMIT.Format, Nothing)
                        excelWorksheet.Cells(57, 7).Value = Log_Perf_AirPressRegOutPress.Value.ToString(Log_Perf_AirPressRegOutPress.Format, Nothing)
                        excelWorksheet.Cells(57, 9).Value = Log_Perf_AirPressRegOutPress_MIN_LIMIT.Value.ToString(Log_Perf_AirPressRegOutPress_MIN_LIMIT.Format, Nothing)
                        excelWorksheet.Cells(57, 10).Value = Log_Perf_AirPressRegOutPress_MAX_LIMIT.Value.ToString(Log_Perf_AirPressRegOutPress_MAX_LIMIT.Format, Nothing)

                End Select

                currentSheet = "DETAILS"
                excelWorksheet = excelSheets.Item(currentSheet)

                Select Case TestStepNumber
                    'Case eTestStepGTCP85_98.RTL:
                    Case eTestStepGTCP85_98.NO_LOAD

                        'Do Nothing

                        'Case eTestStepGTCP85_98.ECS_ONLY:
                    Case eTestStepGTCP85_98.BLEED_LOAD_ONLY

                        excelWorksheet.Cells(15, 7).Value = LOG_PERF_WB_PPM.Value.ToString(LOG_PERF_WB_PPM.Format, Nothing)
                        excelWorksheet.Cells(16, 7).Value = LOG_PERF_P_BLEED_INHGA.Value.ToString(LOG_PERF_P_BLEED_INHGA.Format, Nothing)
                        excelWorksheet.Cells(17, 7).Value = LOG_PERF_T_BLEED_DEGF.Value.ToString(LOG_PERF_T_BLEED_DEGF.Format, Nothing)

                        'Case eTestStepGTCP85_98.ECS_60SHP:
                    Case eTestStepGTCP85_98.COMBINATION_LOAD

                        excelWorksheet.Cells(18, 7).Value = LOG_PERF_WB_PPM.Value.ToString(LOG_PERF_WB_PPM.Format, Nothing)
                        excelWorksheet.Cells(19, 7).Value = LOG_PERF_P_BLEED_INHGA.Value.ToString(LOG_PERF_P_BLEED_INHGA.Format, Nothing)
                        excelWorksheet.Cells(20, 7).Value = LOG_PERF_T_BLEED_DEGF.Value.ToString(LOG_PERF_T_BLEED_DEGF.Format, Nothing)
                        excelWorksheet.Cells(21, 7).Value = LOG_PERF_P_ORIFICE_INHGG.Value.ToString(LOG_PERF_P_ORIFICE_INHGG.Format, Nothing)
                        excelWorksheet.Cells(22, 7).Value = LOG_PERF_T_ORIFICE_DEGF.Value.ToString(LOG_PERF_T_ORIFICE_DEGF.Format, Nothing)
                        excelWorksheet.Cells(23, 7).Value = LOG_PERF_P_ORIFICE_DELTA_INH2OD.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_INH2OD.Format, Nothing)
                        'line 20 made directly in the excel file
                        excelWorksheet.Cells(25, 7).Value = LOG_PERF_T_EGT_DEGF_EXHAUST_TOTAL.Value.ToString(LOG_PERF_T_EGT_DEGF_EXHAUST_TOTAL.Format, Nothing) 'ft corrigé?
                        excelWorksheet.Cells(26, 7).Value = LOG_PERF_T_EGT_DEGF_AVG.Value.ToString(LOG_PERF_T_EGT_DEGF_AVG.Format, Nothing) 'ft corrigé?

                    Case eTestStepGTCP85_98.ACCELERATION_CRACK_PRESSURE_RECHECK

                        excelWorksheet.Cells(38, 7).Value = Log_Perf_AccelLimitValveCrackCheck.Value.ToString(Log_Perf_AccelLimitValveCrackCheck.Format, Nothing)

                    Case eTestStepGTCP85_98.CAPTURE_FINAL_DATA

                        excelWorksheet.Cells(28, 7).Value = Log_Perf_ETC_SP_Check.Value.ToString(Log_Perf_ETC_SP_Check.Format, Nothing) 'Load Control Thermostat for -98DHF
                        excelWorksheet.Cells(28, 8).Value = Log_Perf_ETC_SP_Check_MAX_LIMIT.Value.ToString(Log_Perf_ETC_SP_Check_MAX_LIMIT.Format, Nothing) 'Load Control Thermostat for -98DHF
                        excelWorksheet.Cells(30, 7).Value = Log_Perf_ETC_SP_ReCheck.Value.ToString(Log_Perf_ETC_SP_ReCheck.Format, Nothing) 'Load Control Thermostat for -98DHF
                        excelWorksheet.Cells(32, 7).Value = Log_Perf_LoadCtrl_Valve_Rate.Value.ToString(Log_Perf_LoadCtrl_Valve_Rate.Format, Nothing)
                        excelWorksheet.Cells(33, 7).Value = Log_Perf_BleedAirOsc.Value.ToString(Log_Perf_BleedAirOsc.Format, Nothing)
                        excelWorksheet.Cells(34, 7).Value = Log_Perf_MinSpeedDuringOL.Value.ToString(Log_Perf_MinSpeedDuringOL.Format, Nothing)
                        excelWorksheet.Cells(36, 7).Value = Log_Perf_MaxEGTDuringOL.Value.ToString(Log_Perf_MaxEGTDuringOL.Format, Nothing)
                        '34 in step ACCELERATION_CRACK_PRESSURE_RECHECK
                        excelWorksheet.Cells(39, 7).Value = NUMBER_OF_STARTS.Value.ToString(NUMBER_OF_STARTS.Format, Nothing)
                        excelWorksheet.Cells(40, 7).Value = LOG_PERF_OPERATING_TIME_MINUTE.Value.ToString(LOG_PERF_OPERATING_TIME_MINUTE.Format, Nothing) 'TODO Log_Perf_OperatingTime.Value.ToString()


                End Select

                TestProgress_RecordPerfStep()

                currentSheet = "ACCEPTANCE"
                excelWorksheet = excelSheets.Item(currentSheet)

                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_REJECTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                End If

                If CELProject.IsTrue(CELProject.PERF_TEST_RESULT_ACCEPTED.Value) Then
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                Else
                    excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                End If

                excelWorksheet.Cells(54, 3).Value = Me.UserInputs.OperatorName
                excelWorksheet.Cells(55, 3).Value = Me.UserInputs.QCInspectorName

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile: " + ex.Message)
                MessageBox.Show(ex.ToString)
                Create13031PerformanceFile = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)
            End Try
        End Function

        Private Function Init_Arrays()

            Try

                'Query Database
                Dim engineCorrectionFactors As Gtcp8598Collection = New Gtcp8598Collection
                engineCorrectionFactors.es.Connection.Name = CELProject.DefaultConnectionName
                Select Case CELProject.EngineModel
                    Case "GTCP85-98"
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.EngineModel = CELProject.EngineModel)
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.RepairTypeEnum = UserInputs.RepairTypeID)
                    Case "GTCP85-98CK"
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.EngineModel = CELProject.EngineModel)
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.RepairTypeEnum = UserInputs.RepairTypeID)
                    Case "GTCP85-98D"
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.EngineModel = CELProject.EngineModel)
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.RepairTypeEnum = Gtcp8598.eRepairType.NotApplicable)
                    Case "GTCP85-98DC-B"
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.EngineModel = CELProject.EngineModel)
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.RepairTypeEnum = UserInputs.RepairTypeID)
                    Case "GTCP85-98DHF", "GTCP85-98DHF-A"
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.EngineModel = "GTCP85-98DHF-A")
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.RepairTypeEnum = Gtcp8598.eRepairType.NotApplicable)

                    Case Else
                        Debug.Assert(False, "Engine model not supported")

                End Select

                engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.ShaftLoad = 0) 'No Load (0 SHP)
                engineCorrectionFactors.Query.OrderBy(engineCorrectionFactors.Query.Tcl.Ascending)
                engineCorrectionFactors.Query.Load()

                Debug.Assert(engineCorrectionFactors.Count > 0, "GTCP85-98.Init_Arrays: engineCorrectionFactors returned 0 record for 0 SHP")

                Dim i As Integer = 0
                ReDim GTCP85_98_RTL_ECS(engineCorrectionFactors.Count - 1, 3)
                For Each correctionFactor As Gtcp8598 In engineCorrectionFactors
                    GTCP85_98_RTL_ECS(i, 0) = correctionFactor.Tcl
                    GTCP85_98_RTL_ECS(i, 1) = correctionFactor.WBChng
                    GTCP85_98_RTL_ECS(i, 2) = correctionFactor.PBChng
                    GTCP85_98_RTL_ECS(i, 3) = correctionFactor.TBChng
                    i += 1
                Next

                engineCorrectionFactors.Dispose()

                engineCorrectionFactors = New Gtcp8598Collection

                Select Case CELProject.EngineModel
                    Case "GTCP85-98"
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.EngineModel = CELProject.EngineModel)
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.RepairTypeEnum = Gtcp8598.eRepairType.NotApplicable) 'For combined there is no difference for Overhauled or Repaired engine
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.ShaftLoad = 50) '50 SHP

                    Case "GTCP85-98CK"
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.EngineModel = CELProject.EngineModel)
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.RepairTypeEnum = Gtcp8598.eRepairType.NotApplicable) 'For combined there is no difference for Overhauled or Repaired engine
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.ShaftLoad = 50) '50 SHP

                    Case "GTCP85-98D"
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.EngineModel = CELProject.EngineModel)
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.RepairTypeEnum = Gtcp8598.eRepairType.NotApplicable) 'For combined there is no difference for Overhauled or Repaired engine
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.ShaftLoad = 60) '60 SHP

                    Case "GTCP85-98DC-B"
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.EngineModel = CELProject.EngineModel)
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.RepairTypeEnum = UserInputs.RepairTypeID)
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.ShaftLoad = 60) '60 SHP

                    Case "GTCP85-98DHF", "GTCP85-98DHF-A"
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.EngineModel = "GTCP85-98DHF-A")
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.RepairTypeEnum = Gtcp8598.eRepairType.NotApplicable) 'For combined there is no difference for Overhauled or Repaired engine
                        engineCorrectionFactors.Query.Where(engineCorrectionFactors.Query.ShaftLoad = 60) '60 SHP

                    Case Else
                        Debug.Assert(False, "Engine model not supported")

                End Select

                engineCorrectionFactors.Query.OrderBy(engineCorrectionFactors.Query.Tcl.Ascending)
                engineCorrectionFactors.Query.Load()

                Debug.Assert(engineCorrectionFactors.Count > 0, "GTCP85-98.Init_Arrays: engineCorrectionFactors returned 0 record for 0 SHP")

                i = 0
                ReDim GTCP85_98_ECS_AND_SHP(engineCorrectionFactors.Count - 1, 3)
                For Each correctionFactor As Gtcp8598 In engineCorrectionFactors
                    GTCP85_98_ECS_AND_SHP(i, 0) = correctionFactor.Tcl
                    GTCP85_98_ECS_AND_SHP(i, 1) = correctionFactor.WBChng
                    GTCP85_98_ECS_AND_SHP(i, 2) = correctionFactor.PBChng
                    GTCP85_98_ECS_AND_SHP(i, 3) = correctionFactor.TBChng
                    i += 1
                Next

                engineCorrectionFactors.Dispose()

                Return True
            Catch Ex As Exception
                MessageBox.Show("InitArrays_GTCP85_98DHF: " & Ex.ToString())
                Return False
            Finally
            End Try

        End Function


#Region " Handlers "
