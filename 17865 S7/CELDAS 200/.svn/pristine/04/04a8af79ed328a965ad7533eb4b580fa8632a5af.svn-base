                Return_Value.Add(MyBase.InitializeChannel(T_INLET_DEGF_AVG, "T_INLET_DEGF_AVG"))
                Return_Value.Add(MyBase.InitializeChannel(T_CELL_DEGF, "T_CELL_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(T_ORIFICE_DEGF, "T_ORIFICE_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(TBChng, "TBChng"))
                Return_Value.Add(MyBase.InitializeChannel(TBStd, "TBStd"))
                Return_Value.Add(MyBase.InitializeChannel(START_BTN, "START_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_GEARBOX_MAX_MILS_PERSISTENT, "VIB_GEARBOX_MAX_MILS_PERSISTENT"))
                Return_Value.Add(MyBase.InitializeChannel(VIB_TURBINE_MAX_MILS_PERSISTENT, "VIB_TURBINE_MAX_MILS_PERSISTENT"))
                Return_Value.Add(MyBase.InitializeChannel(WB_CALC, "WB_CALC"))
                Return_Value.Add(MyBase.InitializeChannel(WBChng, "WBChng"))
                Return_Value.Add(MyBase.InitializeChannel(WBStd, "WBStd"))
                Return_Value.Add(MyBase.InitializeChannel(WF_TOT1, "WF_TOT1"))

                MyBase.InitializeObject(cmbTestStepList, "GTCP85_98_Screen.fraControl.TestStep_List")


                If cmbTestStepList Is Nothing Then 'initialize in CofigHMIforEngine
                    MessageBox.Show("MyBase.InitializeObject - TestStep_List Is Nothing")
                    Return_Value.Add(False)
                Else
                    Return_Value.Add(True)
                End If

                'Ici bas le 98
                Return_Value.Add(MyBase.InitializeChannel(CAPTURE_AIR_PRESSURE_OUTPUT_BTN, "CAPTURE_AIR_PRESSURE_OUTPUT_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(CAPTURE_ETC_SETPOINT_BTN, "CAPTURE_ETC_SETPOINT_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(CAPTURE_ETC_SETPOINT_RECHECK_BTN, "CAPTURE_ETC_SETPOINT_RECHECK_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(CAPTURE_MAX_EGT_OVERLOAD_BTN, "CAPTURE_MAX_EGT_OVERLOAD_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(CAPTURE_MIN_SPEED_OVERLOAD_BTN, "CAPTURE_MIN_SPEED_OVERLOAD_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(CAPTURE_NG_FULL_LOAD_BTN, "CAPTURE_NG_FULL_LOAD_BTN"))


                'Return_Value.Add(MyBase.InitializeChannel(DELTA, "DELTA"))
                Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_T_EGT_DEGF_EXHAUST_TOTAL, "LOG_PERF_T_EGT_DEGF_EXHAUST_TOTAL"))
                Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_GENERATOR_CORRECTED_SHP, "LOG_PERF_GENERATOR_CORRECTED_SHP"))
                Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_GENERATOR_SHP_MIN_LIMIT, "LOG_PERF_GENERATOR_SHP_MIN_LIMIT"))
                Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_GENERATOR_SHP_MAX_LIMIT, "LOG_PERF_GENERATOR_SHP_MAX_LIMIT"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_Oil_Pump_Disch_Fluc, "Log_Perf_Oil_Pump_Disch_Fluc"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_FullLoadGovSpeedDroop, "Log_Perf_FullLoadGovSpeedDroop"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_FullLoadGovSpeedDroop_LOW_LIMIT, "Log_Perf_FullLoadGovSpeedDroop_LOW_LIMIT"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_FullLoadGovSpeedDroop_HI_LIMIT, "Log_Perf_FullLoadGovSpeedDroop_HI_LIMIT"))

                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_MaxEGTDuringOL, "Log_Perf_MaxEGTDuringOL")) 'ft
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_ETC_SP_Check, "Log_Perf_ETC_SP_Check"))   ' Load Control Thermostat for -98DHF
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_ETC_SP_Check_MAX_LIMIT, "Log_Perf_ETC_SP_Check_MAX_LIMIT"))   ' Load Control Thermostat for -98DHF
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_ETC_SP_ReCheck, "Log_Perf_ETC_SP_ReCheck")) ' Load Control Thermostat for -98DHF
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_LoadCtrl_Valve_Rate, "Log_Perf_LoadCtrl_Valve_Rate"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_BleedAirOsc, "Log_Perf_BleedAirOsc"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_MinSpeedDuringOL, "Log_Perf_MinSpeedDuringOL"))
                Return_Value.Add(MyBase.InitializeChannel(NUMBER_OF_STARTS, "NUMBER_OF_STARTS"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_AccelLimitValveCrack, "Log_Perf_AccelLimitValveCrack"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_AirPressRegOutPress, "Log_Perf_AirPressRegOutPress"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_AirPressRegOutPress_MIN_LIMIT, "Log_Perf_AirPressRegOutPress_MIN_LIMIT"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_AirPressRegOutPress_MAX_LIMIT, "Log_Perf_AirPressRegOutPress_MAX_LIMIT"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_FuelPumpDischPress, "Log_Perf_FuelPumpDischPress"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_FuelPumpInletPress, "Log_Perf_FuelPumpInletPress"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_GearboxCavNegPress, "Log_Perf_GearboxCavNegPress"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_GearboxVibration, "Log_Perf_GearboxVibration"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_OilPumpDischPress, "Log_Perf_OilPumpDischPress"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_OilPumpDischTemp, "Log_Perf_OilPumpDischTemp"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_TurbineBearingCavPress, "Log_Perf_TurbineBearingCavPress"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_TurbineVibration, "Log_Perf_TurbineVibration"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_ShaftSpeed, "Log_Perf_ShaftSpeed"))
                Return_Value.Add(MyBase.InitializeChannel(Log_Perf_AccelLimitValveCrackCheck, "Log_Perf_AccelLimitValveCrackCheck"))

            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.ToString())
                Return_Value.Add(False)
            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function
        Protected Overrides Sub Init_Engine_Channels_Value()

            Try

                CELProject.PERF_TEST_STEP_NB.Value = Values.Zero

                OperatingTime = New System.TimeSpan(0, 0, 0, 0, 0) 'init operating time to 0 at open test only

                CELProject.PERF_TEST_STEP_NB.Value = Values.Zero

                cmbTestStepList.SelectedIndex = 0

                Log_Perf_Oil_Pump_Disch_Fluc.Value = Values.Zero
                Log_Perf_FullLoadGovSpeedDroop.Value = Values.Zero
                Log_Perf_ETC_SP_Check.Value = Values.Zero
                Log_Perf_ETC_SP_ReCheck.Value = Values.Zero
                Log_Perf_LoadCtrl_Valve_Rate.Value = Values.Zero
                Log_Perf_BleedAirOsc.Value = Values.Zero
                Log_Perf_MinSpeedDuringOL.Value = Values.Zero
                Log_Perf_MaxEGTDuringOL.Value = Values.Zero
                Log_Perf_AccelLimitValveCrack.Value = Values.Zero
                Log_Perf_AirPressRegOutPress.Value = Values.Zero

                Log_Perf_FuelPumpDischPress.Value = Values.Zero
                Log_Perf_FuelPumpInletPress.Value = Values.Zero
                Log_Perf_GearboxCavNegPress.Value = Values.Zero
                Log_Perf_GearboxVibration.Value = Values.Zero
                Log_Perf_OilPumpDischPress.Value = Values.Zero
                Log_Perf_OilPumpDischTemp.Value = Values.Zero
                Log_Perf_TurbineBearingCavPress.Value = Values.Zero
                Log_Perf_TurbineVibration.Value = Values.Zero
                Log_Perf_ShaftSpeed.Value = Values.Zero
                Log_Perf_AccelLimitValveCrackCheck.Value = Values.Zero

                NUMBER_OF_STARTS.Value = Values.Zero

                'TODO dans les HMI_Numeric, ce channel est utilise en numeric et devrait etre en text
                REPAIR_TYPE.ValueObject = UserInputs.RepairTypeDescription
                REPAIR_TYPE_ID.ValueObject = UserInputs.RepairTypeID 'TODO le type est pas bon, ca devrait être une string?!????

                ENGINE_PN_AND_SB.ValueObject = UserInputs.EnginePartNumberAndServiceBulletin

                'It seems that we have a little problem of initialization at HMI. This is helping to see the NaN when starting the system!!
                PBStd.Value = Values.Zero
                TBStd.Value = Values.Zero
                WBStd.Value = Values.Zero
                PBChng.Value = Values.Zero
                TBChng.Value = Values.Zero
                WBChng.Value = Values.Zero

            Catch Ex As Exception
                MessageBox.Show("Init_Engine_Channels_Value: " & Ex.ToString())
            Finally
            End Try
        End Sub
