        Protected Overrides Sub Init_Engine_Controls()
        End Sub
        Protected Overrides Sub Init_Engine_Controllers()

            Dim PersistentValuesChannels() As String = {"NUMBER_OF_STARTS",
                                                     "OPERATING_TIME_CURRENT_SEC",
                                                     "FUEL_USED_INITIAL_LITERS",
                                                     "FUEL_USED_TOTAL_LITERS",
                                                     "PERF_TEST_RESULT_ACCEPTED",
                                                     "PERF_TEST_RESULT_REJECTED",
                                                     "VIB_GEARBOX_MAX_MILS_PERSISTENT",
                                                     "VIB_TURBINE_MAX_MILS_PERSISTENT"}

            'Dim PersistentValuesChannels() As String = {"NUMBER_OF_STARTS",
            '                                       "OPERATING_TIME_CURRENT_SEC",
            '                                       "FUEL_USED_INITIAL_LITERS",
            '                                       "FUEL_USED_TOTAL_LITERS",
            '                                       "PERF_TEST_RESULT_ACCEPTED",
            '                                       "PERF_TEST_RESULT_REJECTED",
            '                                       "NG_MAX_PERSISTENT_RPM",
            '                                       "VIB_GEARBOX_MILS_PERSISTENT",
            '                                       "VIB_TURBINE_MILS_PERSISTENT",
            '                                       "P_OIL_MAX_PERSISTENT_KPAG",
            '                                       "MINIMUM_SURGE_MARGIN_TEST_PASSED",
            '                                       "NUMBER_APU_FAULT_SEEN_DURING_TEST",
            '                                       "LOG_PERF_EVENT_1",
            '                                       "LOG_PERF_EVENT_2",
            '                                       "LOG_PERF_HR_MTR_1",
            '                                       "LOG_PERF_HR_MTR_2",
            '                                       "P_OIL_AT_60KW_SHAFT_LOAD_KPAG",
            '                                       "T_OIL_AT_60KW_SHAFT_LOAD_DEGC",
            '                                       "ET_TIME_RUNDOWN_MANUAL_ENTRY"}

            Dim PersistentValuesFileName As String = Nothing

            Select Case CELProject.Project.Number

                Case 13031
                    PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputs.EngineSerialNumber & "\" & UserInputs.WorkOrder & "\Log\PersistentValues.xml"
                    GTCP85_98_PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

                    If Double.IsNaN(FUEL_USED_TOTAL_LITERS.Value.ToDouble()) Then
                        FUEL_USED_INITIAL_LITERS.Value = Values.Zero
                    Else
                        FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())
                    End If

                Case Else
                    Debug.Assert(False, "OnTestSessionRunning: Code Missing for this project")

            End Select



            ' Les config sont lu a partir du fichier celdas_XXXXX.cfg
            NumberOfTInletProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/" + CELProject.EngineFamily + "/T_INLET_NUMBER_PROBE", 0)
            RealNumberOfTInletProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/" + CELProject.EngineFamily + "/T_INLET_REAL_NUMBER_PROBE", 0)
            NumberOfTEgtProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/" + CELProject.EngineFamily + "/T_EGT_NUMBER_PROBE", 0)
            RealNumberOfTEgtProbe = CELProject.Project.ReadOneIntegerConfigItem("//ConfigurationSettings/" + CELProject.EngineFamily + "/T_EGT_REAL_NUMBER_PROBE", 0)

            'Generic delete channel function handling
            DeletableTEgtChCtrl = New DeletableChannelController(Me, RealNumberOfTEgtProbe, NumberOfTEgtProbe, NumberOfTEgtProbe, "T_EGT", "_DEGF", "_DELETE_BTN", "T_EGT_DEGF_AVG", "T_EGT_DEGF_MIN", "T_EGT_DEGF_MAX", "T_EGT_DEGFD_SPREAD")
            DeletableTInletChCtrl = New DeletableChannelController(Me, RealNumberOfTInletProbe, NumberOfTInletProbe, NumberOfTInletProbe, "T_INLET", "_DEGF", "_DELETE_BTN", "T_INLET_DEGF_AVG", Nothing, Nothing, "T_INLET_DEGFD_SPREAD")


            FlowmeterCtrl = New FlowmeterController(Me)

            StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_CURRENT_AMP", "STARTER_CURRENT_AMP_MAX", "START_BTN")
            StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_VOLTAGE_VDC", "STARTER_VOLTAGE_VDC_MAX", "START_BTN")

            'ft Loadair control deja fait dans common sequence

            FuelRegulatorCtrl = New UpDownDemandController("FUEL_PRESSURE_DEMAND", "FUEL_PRESSURE_DEMAND_INCREMENT", "FUEL_PRESSURE_UP_DEMAND_BTN", "FUEL_PRESSURE_DOWN_DEMAND_BTN", Nothing)
            FuelRegulatorCtrl.Maximum = 100
            FuelRegulatorCtrl.Increment = 1
            FuelRegulatorCtrl.Minimum = 0
            FuelRegulatorCtrl.ResetValue = 0

            'Configuring Load Bank Control
            Dim myLBData As LoadBankController.LB_DataInfo

            myLBData.FanEnableChannelName = "LB1_FAN_ENABLE_CMD"
            myLBData.FanEnableBtnChannelName = "LB1_FAN_ENABLE_BTN"
            myLBData.EnableChannelName = "LB_LOAD_BTN"
            myLBData.DemandChannelName = "LB1_DEMAND"
            myLBData.UpDemandChannelName = "LB1_UP_DEMAND_BTN"
            myLBData.DownDemandChannelName = "LB1_DOWN_DEMAND_BTN"
            myLBData.DemandChannelIncrementName = "LB1_DEMAND_INCREMENT"
            myLBData.FrameName = "GTCP85_98_Screen.fraControlSystem.fraLoadBankControl"
            myLBData.DisplayName = "dspLB_DEMAND"
            myLBData.ThreadSpeedMsec = 250 'msec
            myLBData.Maximum = 50 'MaxLoad SHP/Delta =60 pour le 98DHF
            myLBData.DelestageKwpersec = 100000 'instant delestage
            myLBData.FanCoolDownSeconds = 300
            myLBData.Memorize = False
            myLBData.Increment = 1
            myLBData.FieldFlashingTimeMsec = 0  'no field flashing 
            myLBData.FieldFlashingSignalName = Nothing
            myLBData.FieldFlashingTriggerSignalName = Nothing
            myLBData.InitialDemandChannelName = "LB1_INITIAL_DEMAND"
            myLBData.BtnLatchSeconds = 0
            myLBData.FanEnableChannelPulseName = Nothing
            myLBData.FanStopChannelPulseName = Nothing
            myLBData.PulseEnableInitialType = False
            myLBData.PulseStopInitialType = False

            LoadBankCtrl = New LoadBankController(myLBData)

            'Configuring Load Bank Stage Values
            LoadBankCtrl.AddStage(1, "LB1_1")
            LoadBankCtrl.AddStage(2, "LB1_2")
            LoadBankCtrl.AddStage(2, "LB1_3")
            LoadBankCtrl.AddStage(5, "LB1_4")
            LoadBankCtrl.AddStage(5, "LB1_5")
            LoadBankCtrl.AddStage(10, "LB1_6")
            LoadBankCtrl.AddStage(10, "LB1_7")
            LoadBankCtrl.AddStage(25, "LB1_8")
            LoadBankCtrl.AddStage(50, "LB1_9")
            LoadBankCtrl.AddStage(50, "LB1_10")
            LoadBankCtrl.AddCurrentPhases("LB1_CURRENT_IA", "LB1_CURRENT_IB", "LB1_CURRENT_IC", 20)
            LoadBankCtrl.AddVoltagePhases("LB1_VOLTAGE_VAB", "LB1_VOLTAGE_VBC", "LB1_VOLTAGE_VCA", 20)
            LoadBankCtrl.StartWorkerThread(250)

        End Sub
        Protected Overrides Sub Dispose_Engine_Controllers()

            If Not (FlowmeterCtrl Is Nothing) Then
                FlowmeterCtrl.Dispose()
            End If
            If Not (FuelRegulatorCtrl Is Nothing) Then
                FuelRegulatorCtrl.Dispose()
            End If

            If Not (DeletableTEgtChCtrl Is Nothing) Then
                DeletableTEgtChCtrl.Dispose()
            End If
            If Not (DeletableTInletChCtrl Is Nothing) Then
                DeletableTInletChCtrl.Dispose()
            End If

            'LoadAirCtrl.Dispose()'fait dans common sequence
            If Not (LoadBankCtrl Is Nothing) Then
                LoadBankCtrl.Dispose()
            End If
            If Not (StarterMaxCurrentRecordCtrl Is Nothing) Then
                StarterMaxCurrentRecordCtrl.Dispose()
            End If
            If Not (StarterMaxVoltageRecordCtrl Is Nothing) Then
                StarterMaxVoltageRecordCtrl.Dispose()
            End If

        End Sub
        Protected Overrides Sub OnTestSessionClosing(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)

            Try
                MyBase.OnTestSessionClosing(newStatus)

                If CELProject.EngineFamily = "GTCP85-98" Then

                    RemoveHandlers()

                    Dispose_Engine_Controllers()

                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionClosing: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub


