            End Try
        End Sub

        Protected Overrides Sub OnDYNO_DEMAND_VALIDATE(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If sender.Name = "DYNO_POS_DEMAND" Then
                    If DYNO_POS_DEMAND.Value.ToDouble() > 100 Then
                        DYNO_POS_DEMAND.Value = New KineticaRT.Values.Double(100)
                    ElseIf DYNO_POS_DEMAND.Value.ToDouble() < 0 Then
                        DYNO_POS_DEMAND.Value = KineticaRT_ZERO
                    End If
                ElseIf sender.Name = "DYNO_SPEED_DEMAND" Then
                    If DYNO_SPEED_DEMAND.Value > DYNO_SPEED_100_PCT_RPM.Value Then
                        DYNO_SPEED_DEMAND.Value = DYNO_SPEED_100_PCT_RPM.Value
                    ElseIf DYNO_SPEED_DEMAND.Value.ToDouble() < 0 Then
                        DYNO_SPEED_DEMAND.Value = KineticaRT_ZERO
                    End If
                ElseIf sender.Name = "DYNO_TORQUE_DEMAND" Then
                    If DYNO_TORQUE_DEMAND.Value.ToDouble() > TORQUE_METER_TORQUE_HI_LIMIT_LBSFT.Value Then
                        DYNO_TORQUE_DEMAND.Value = TORQUE_METER_TORQUE_HI_LIMIT_LBSFT.Value
                    ElseIf DYNO_TORQUE_DEMAND.Value.ToDouble() < 0 Then
                        DYNO_TORQUE_DEMAND.Value = KineticaRT_ZERO
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show("PW150_Sequence: OnDYNO_DEMAND_VALIDATE: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnDYNO_INLET_VALIDATE(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If DYNO_SET_INLET_PCT.Value.ToDouble() > 100 Then
                    DYNO_SET_INLET_PCT.Value = New KineticaRT.Values.Double(100)
                ElseIf DYNO_SET_INLET_PCT.Value.ToDouble() < 0 Then
                    DYNO_SET_INLET_PCT.Value = KineticaRT_ZERO
                End If
            Catch ex As Exception
                MessageBox.Show("PW200_Sequence: OnDYNO_INLET_VALIDATE: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Private Sub OnDYNO_VALIDATE_MODE(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    If DYNO_REMOTE_CONTROL_IND.Value.ToDouble() = 1.0 And DYNO_VALVE_STATUS_IND.Value = KineticaRT.Values.Values.True And ENGINE_AT_REST.Value = KineticaRT.Values.Values.True Then
                        DYNO_SPEED_DEMAND.Value = DYNO_SPEED_100_PCT_RPM.Value
                        Thread.Sleep(250)
                        DYNO_SPEED_MODE_BTN.Value = KineticaRT.Values.Values.True
                        CELDAS.NotifyIcon.ShowBalloonTip(3000, CELProject.TechnologyName, "Dynamometer set to " & DYNO_SPEED_100_PCT_RPM.Value.ToString & "RPM in SPEED mode. Please confirm on controller.", ToolTipIcon.Info)
                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("PT6C_Sequence: OnDYNO_VALIDATE_MODE: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Private Sub OnCRANK_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    ARCHIVE_RECORD.Value = KineticaRT.Values.Values.True
                    T_MGT_CURRENT_DEGF.Value = T_MGT_DEGF.Value
                    CRANK_BTN_PRESSED.Value = KineticaRT.Values.Values.True
                Else
                    CRANK_BTN_PRESSED.Value = KineticaRT.Values.Values.False
                End If
            Catch ex As Exception
                MessageBox.Show("PW200_Sequence: OnSTOP_TIMER_CND_BUTTON: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnLOG_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            If CELProject.IsTrue(newVal) Then

                'Update the Log/Perf channel set
                CELProject.LogPerfSynch.UpdateValues()

                CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, False, CELProject.EngineModel, True)
                CELProject.LOG_TAKE_POINT_BTN.Value = KineticaRT.Values.Values.False
            End If
        End Sub

        Protected Overrides Sub OnNEW_TEST_BTN(sender As IChannel, newVal As Value)
            Try
                If (CELProject.IsTrue(newVal)) Then

                    If DialogResult.Yes = MessageBox.Show("Do you want to reset the fuel used?", "CELDAS200", MessageBoxButtons.YesNo, MessageBoxIcon.Question) Then

                        FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(0)
                        FM_INITIAL_VOLUME_LITERS.Value = New KineticaRT.Values.Double(FM_TOTAL_VOLUME_LITERS.Value.ToDouble())

                    End If

                End If
            Catch ex As Exception
                MessageBox.Show("PW200_Sequence: OnNewTest: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionInitialized(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionInitialized(newStatus)

                If CELProject.EngineFamily = "PW200" Then

                    UserInputs.MapUserInputsParameters(CELProject)

                    CELProject.EngineSession.WorkingFolder = "C:\CELDAS DATA\" + CELProject.EngineModel() + "\" + UserInputs.EngineSerialNumber + "\" + UserInputs.WorkOrder
                    CELProject.CreateLogFile(AddressOf CreateCustomHeaderLogFile, CELProject.EngineModel(), CELProject.EngineModel())

                End If

            Catch ex As Exception
                MessageBox.Show("OnTestSessionInitialized: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        '**************************
        '* OnTestSessionRunning() *
        '**************************
        Protected Overrides Sub OnTestSessionRunning(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionRunning(newStatus)

                If CELProject.EngineFamily = "PW200" Then

                    Init_Engine_Controls()
                    Init_Engine_Channels()
                    Init_Engine_Channels_Value()
                    Init_Engine_Controllers()
                    AddHandlers()

                    MyBase.StartWorkingThread()


                End If
            Catch ex As Exception
                MessageBox.Show("OnTestSessionRunning: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub AddHandlers()

            AddHandler CLOSE_TEST_BTN_OPC.ValueChanged, AddressOf OnCLOSE_TEST_BTN
            AddHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            AddHandler CELProject.DIAGNOSTIC_ENGINE_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnDIAGNOSTIC_CLOSE_WINDOW_BTN
            AddHandler CELProject.DIAGNOSTIC_ENGINE_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnDIAGNOSTIC_OPEN_WINDOW_BTN
            AddHandler CRANK_START_DEMAND_OPC.ValueChanged, AddressOf OnCRANK_BTN
            AddHandler DYNO_SET_INLET_PCT.ValueChanged, AddressOf OnDYNO_INLET_VALIDATE
            AddHandler DYNO_VALVE_STATUS_IND.ValueChanged, AddressOf OnDYNO_VALIDATE_MODE
            AddHandler DYNO_REMOTE_CONTROL_IND.ValueChanged, AddressOf OnDYNO_VALIDATE_MODE
            AddHandler EEC_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnEEC_CLOSE_WINDOW_BTN
            AddHandler EEC_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnEEC_OPEN_WINDOW_BTN
            AddHandler EEC_POWER_BTN.ValueChanged, AddressOf OnEEC_POWER_BTN
            AddHandler FACILITY_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnFCS_CLOSE_WINDOW_BTN
            AddHandler FACILITY_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnFCS_OPEN_WINDOW_BTN
            AddHandler DYNO_POS_DEMAND.ValueChanged, AddressOf OnDYNO_DEMAND_VALIDATE
            AddHandler DYNO_SPEED_DEMAND.ValueChanged, AddressOf OnDYNO_DEMAND_VALIDATE
            AddHandler DYNO_TORQUE_DEMAND.ValueChanged, AddressOf OnDYNO_DEMAND_VALIDATE
            AddHandler NEW_TEST_BTN.ValueChanged, AddressOf OnNEW_TEST_BTN
            AddHandler UPS_ON_BATTERY_MAX_TIME_REACHED.ValueChanged, AddressOf OnUPS_ON_BATTERY_MAX_TIME_REACHED

            If Not (EEC_START_IGNITION_IND Is Nothing) Then
                AddHandler EEC_START_IGNITION_IND.ValueChanged, AddressOf OnEEC_START_IGNITION_IND
            End If
            If Not (EEC_START_IND Is Nothing) Then
                AddHandler EEC_START_IND.ValueChanged, AddressOf OnEEC_START_IND
            End If
            If Not (EEC_IGNITION_IND Is Nothing) Then
                AddHandler EEC_IGNITION_IND.ValueChanged, AddressOf OnEEC_IGNITION_IND
            End If

        End Sub

        Protected Overrides Sub RemoveHandlers()

            'Remove Handlers before Add Handlers, to remove duplicate handlers
            If Not (CLOSE_TEST_BTN_OPC Is Nothing) Then
                RemoveHandler CLOSE_TEST_BTN_OPC.ValueChanged, AddressOf OnCLOSE_TEST_BTN
            End If
            If Not (CELProject.LOG_TAKE_POINT_BTN Is Nothing) Then
                RemoveHandler CELProject.LOG_TAKE_POINT_BTN.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
            End If
            If Not (CELProject.DIAGNOSTIC_ENGINE_CLOSE_WINDOW_BTN Is Nothing) Then
                RemoveHandler CELProject.DIAGNOSTIC_ENGINE_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnDIAGNOSTIC_CLOSE_WINDOW_BTN
            End If
            If Not (CELProject.DIAGNOSTIC_ENGINE_OPEN_WINDOW_BTN Is Nothing) Then
                RemoveHandler CELProject.DIAGNOSTIC_ENGINE_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnDIAGNOSTIC_OPEN_WINDOW_BTN
            End If
            If Not (CRANK_START_DEMAND_OPC Is Nothing) Then
                RemoveHandler CRANK_START_DEMAND_OPC.ValueChanged, AddressOf OnCRANK_BTN
            End If
            If Not (DYNO_SET_INLET_PCT Is Nothing) Then
                RemoveHandler DYNO_SET_INLET_PCT.ValueChanged, AddressOf OnDYNO_INLET_VALIDATE
            End If
            If Not (DYNO_VALVE_STATUS_IND Is Nothing) Then
                RemoveHandler DYNO_VALVE_STATUS_IND.ValueChanged, AddressOf OnDYNO_VALIDATE_MODE
            End If
            If Not (DYNO_REMOTE_CONTROL_IND Is Nothing) Then
                RemoveHandler DYNO_REMOTE_CONTROL_IND.ValueChanged, AddressOf OnDYNO_VALIDATE_MODE
            End If
            If Not (EEC_OPEN_WINDOW_BTN Is Nothing) Then
                RemoveHandler EEC_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnEEC_OPEN_WINDOW_BTN
            End If
            If Not (EEC_POWER_BTN Is Nothing) Then
                RemoveHandler EEC_POWER_BTN.ValueChanged, AddressOf OnEEC_POWER_BTN
            End If
            If Not (EEC_CLOSE_WINDOW_BTN Is Nothing) Then
                RemoveHandler EEC_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnEEC_CLOSE_WINDOW_BTN
            End If
            If Not (FACILITY_CLOSE_WINDOW_BTN Is Nothing) Then
                RemoveHandler FACILITY_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnFCS_CLOSE_WINDOW_BTN
            End If
            If Not (FACILITY_OPEN_WINDOW_BTN Is Nothing) Then
                RemoveHandler FACILITY_OPEN_WINDOW_BTN.ValueChanged, AddressOf OnFCS_OPEN_WINDOW_BTN
            End If
            If Not (DYNO_POS_DEMAND Is Nothing) Then
                RemoveHandler DYNO_POS_DEMAND.ValueChanged, AddressOf OnDYNO_DEMAND_VALIDATE
            End If
            If Not (DYNO_SPEED_DEMAND Is Nothing) Then
                RemoveHandler DYNO_SPEED_DEMAND.ValueChanged, AddressOf OnDYNO_DEMAND_VALIDATE
            End If
            If Not (DYNO_TORQUE_DEMAND Is Nothing) Then
                RemoveHandler DYNO_TORQUE_DEMAND.ValueChanged, AddressOf OnDYNO_DEMAND_VALIDATE
            End If
            If Not (NEW_TEST_BTN Is Nothing) Then
                RemoveHandler NEW_TEST_BTN.ValueChanged, AddressOf OnNEW_TEST_BTN
            End If
            If Not (UPS_ON_BATTERY_MAX_TIME_REACHED Is Nothing) Then
                RemoveHandler UPS_ON_BATTERY_MAX_TIME_REACHED.ValueChanged, AddressOf OnUPS_ON_BATTERY_MAX_TIME_REACHED
            End If
            If Not (EEC_START_IGNITION_IND Is Nothing) Then
                RemoveHandler EEC_START_IGNITION_IND.ValueChanged, AddressOf OnEEC_START_IGNITION_IND
            End If
            If Not (EEC_START_IND Is Nothing) Then
                RemoveHandler EEC_START_IND.ValueChanged, AddressOf OnEEC_START_IND
            End If
            If Not (EEC_IGNITION_IND Is Nothing) Then
                RemoveHandler EEC_IGNITION_IND.ValueChanged, AddressOf OnEEC_IGNITION_IND
            End If

        End Sub

        Protected Overrides Sub Init_Engine_Controllers()

            Dim PersistentValuesChannels() As String = {"OPERATING_TIME_SEC", "FUEL_USED_INITIAL_LITERS", "FUEL_USED_TOTAL_LITERS", _
                                            "FUEL_COST_$_PER_LITER", "LABOR_COST_$_PER_HOUR", "FACILITY_COST_$_PER_HOUR", _
                                            "PERF_CONDITION_NUMBER"}

            Dim PersistentValuesFileName = "C:\CELDAS DATA\" & CELProject.EngineModel & "\" & UserInputs.EngineSerialNumber & "\" & UserInputs.WorkOrder & "\Log\PersistentValues.xml"

            PersistentValuesCtrl = New PersistentValuesController(Me, PersistentValuesChannels, 1, PersistentValuesFileName)

            FUEL_USED_INITIAL_LITERS.Value = New KineticaRT.Values.Double(FUEL_USED_TOTAL_LITERS.Value.ToDouble())


            ' Default value if not overridden by the project
            Dim RealNumberOfTEgtProbe As Integer = MaxNumberOfTEgtProbe
            Dim RealNumberOfTInletProbe As Integer = MaxNumberOfTInletProbe

            Select Case CELProject.Project.Number

                Case 14085

                    Dim ConfigPrefix As String = "//ConfigurationSettings/" & CELProject.EngineFamily & "/"
                    RealNumberOfTInletProbe = CELProject.Project.ReadOneIntegerConfigItem(ConfigPrefix & "T_INLET_NUMBER_PROBE", 0)
                    RealNumberOfTEgtProbe = CELProject.Project.ReadOneIntegerConfigItem(ConfigPrefix & "T_EGT_NUMBER_PROBE", 0)

                    Debug.Assert(RealNumberOfTInletProbe <> 0 And RealNumberOfTEgtProbe <> 0)

                Case Else
                    Debug.Assert(False, "OnTestSessionRunning: Code Missign for this project")

            End Select

            DeletableTInletChCtrl = New DeletableChannelController(Me, RealNumberOfTInletProbe, MaxNumberOfTInletProbe, MaxNumberOfTInletProbe, "T_T1_", "_DEGF", "_DELETE_BTN", "T_T1_AVG_DEGF", "T_T1_MIN_DEGF", "T_T1_MAX_DEGF", "T_T1_SPREAD_DEGF")
            DeletableTEgtChCtrl = New DeletableChannelController(Me, RealNumberOfTEgtProbe, MaxNumberOfTEgtProbe, MaxNumberOfTEgtProbe, "T_T7_", "_DEGF", "_DELETE_BTN", "T_T7_AVG_DEGF", "T_T7_MIN_DEGF", "T_T7_MAX_DEGF", "T_T7_SPREAD_DEGF")

            IgnitionMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "IGNITION1_CURRENT_AMP", "IGNITION1_CURRENT_AMP_MAX", "CRANK_START_DEMAND_OPC")
            IgnitionMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "IGNITION1_VOLTAGE_VDC", "IGNITION1_VOLTAGE_VDC_MAX", "CRANK_START_DEMAND_OPC")
            StarterMaxCurrentRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_CURRENT_AMP", "STARTER_CURRENT_AMP_MAX", "CRANK_START_DEMAND_OPC")
            StarterMaxVoltageRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "STARTER_VOLTAGE_VDC", "STARTER_VOLTAGE_VDC_MAX", "CRANK_START_DEMAND_OPC")

            TimeToIdleTimerCtrl = New TimerController(Me, "TTI_TIME_START_CONDITION_LATCH", "TTI_TIME_STOP_CONDITION_LATCH", "TTI_TIME_CONDITION_RESET", "TTI_TIME_SEC", Nothing, 0, "NONE")
            TimeToLightTimerCtrl = New TimerController(Me, "TTL_TIME_START_CONDITION_LATCH", "TTL_TIME_STOP_CONDITION_LATCH", "TTL_TIME_CONDITION_RESET", "TTL_TIME_SEC", Nothing, 0, "NONE")
            StartTimerCtrl = New TimerController(Me, "STARTING_TIME_START_CONDITION_LATCH", "STARTING_TIME_STOP_CONDITION_LATCH", "STARTING_TIME_CONDITION_RESET", "STARTING_TIME_SEC", Nothing, 0, "NONE")
            RundownTimerCtrl = New TimerController(Me, "RDT_TIME_START_CONDITION_LATCH", "RDT_TIME_STOP_CONDITION_LATCH", "RDT_TIME_CONDITION_RESET", "RDT_TIME_SEC", Nothing, 0, "NONE")
            CrankTimerCtrl = New TimerController(Me, "CRANK_TIME_START_CONDITION_LATCH", "CRANK_TIME_STOP_CONDITION_LATCH", "CRANK_TIME_CONDITION_RESET", "CRANK_TIME_SEC", Nothing, 60, "CRANK_TIME_MAX_VALUE_REACHED")
            StarterTimerCtrl = New TimerController(Me, "STARTER_OVERCURRENT_START_CONDITION", "STARTER_OVERCURRENT_STOP_CONDITION", "STARTER_OVERCURRENT_CONDITION_RESET", "STARTER_OVERCURRENT_TIME_SEC", Nothing, 10, "STARTER_OVERCURRENT_MAX_VALUE_REACHED")
            OperatingTimerCtrl = New TimerController(Me, "OPERATING_TIME_START_CONDITION", "OPERATING_TIME_STOP_CONDITION", "OPERATING_TIME_CONDITION_RESET", "OPERATING_TIME_SEC", Nothing, 0, "NONE", True)

            If CELProject.HierarchyType = CELDAS.eHierarchyType.Master Then
                ExhaustFanCtrl = New ExhaustFanController(Me)
                ExhaustFanCtrl.StartWorkerThread(250)
                ExhaustFanCtrl.ExhaustFanProtectionControlTime = 40
                VibRGBMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_RGB_MS2", "VIB_RGB_MS2_PEAK_OPC", "VIB_RGB_MS2_PEAK_RESET")
                VibTMMMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "VIB_TMM_CMS", "VIB_TMM_CMS_PEAK_OPC", "VIB_TMM_CMS_PEAK_RESET")
                NGMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "NG_RPM", "NG_RPM_PEAK_OPC", "NG_RPM_PEAK_RESET")
                NPTMaxRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "NPT_RPM", "NPT_RPM_PEAK_OPC", "NPT_RPM_PEAK_RESET")
                MGTMaxTemperatureRecordCtrl = New MinMaxRecordController(Me, MinMaxRecordController.eRecordType.Maximum, "T_MGT_DEGF", "T_MGT_DEGF_PEAK_OPC", "T_MGT_DEGF_PEAK_RESET")
            End If

            If CELProject.HierarchyType = CELDAS.eHierarchyType.Slave Then
                StatisticsCtrl = New StatisticsController(Me, "FUEL_COST_$_PER_LITER", "LABOR_COST_$_PER_HOUR", "FACILITY_COST_$_PER_HOUR", "OPERATING_TIME_HOURS", "HOURS", "FUEL_USED_TOTAL_LITERS", "LITER", "FUEL_COST_$", "LABOR_COST_$", "FACILITY_COST_$", "TOTAL_COST_$")
            End If

            ' Oil Back Pressure Regulator use UpDownDemandController
            OilBackPressureRegulatorCtrl = New UpDownDemandController(CELProject.EngineModel & "_OIL_BACK_PRESSURE_REGULATOR_DEMAND", "OIL_BACK_PRESSURE_REGULATOR_DEMAND_INCREMENT", "OIL_BACK_PRESSURE_UP_DEMAND_BTN", "OIL_BACK_PRESSURE_DOWN_DEMAND_BTN", Nothing)
            OilBackPressureRegulatorCtrl.Maximum = 100
            OilBackPressureRegulatorCtrl.Increment = 1
            OilBackPressureRegulatorCtrl.Minimum = 0

            OilBackPressureRegulatorCtrl.ResetValue = 0

        End Sub


        Protected Overrides Sub Dispose_Engine_Controllers()

            'Persistent Values Force Save
            If Not (PersistentValuesCtrl Is Nothing) Then
                PersistentValuesCtrl.SavePersistentValues(True)
            End If

            If Not (DeletableTInletChCtrl Is Nothing) Then
                DeletableTInletChCtrl.Dispose()
            End If

            If Not (DeletableTEgtChCtrl Is Nothing) Then
                DeletableTEgtChCtrl.Dispose()
            End If

            If Not (IgnitionMaxCurrentRecordCtrl Is Nothing) Then
                IgnitionMaxCurrentRecordCtrl.Dispose()
            End If

            If Not (IgnitionMaxVoltageRecordCtrl Is Nothing) Then
                IgnitionMaxVoltageRecordCtrl.Dispose()
            End If

            If Not (StarterMaxCurrentRecordCtrl Is Nothing) Then
                StarterMaxCurrentRecordCtrl.Dispose()
            End If

            If Not (StarterMaxVoltageRecordCtrl Is Nothing) Then
                StarterMaxVoltageRecordCtrl.Dispose()
            End If

            If Not (MGTMaxTemperatureRecordCtrl Is Nothing) Then
                MGTMaxTemperatureRecordCtrl.Dispose()
            End If

            If Not (VibRGBMaxRecordCtrl Is Nothing) Then
                VibRGBMaxRecordCtrl.Dispose()
            End If

            If Not (VibTMMMaxRecordCtrl Is Nothing) Then
                VibTMMMaxRecordCtrl.Dispose()
            End If

            If Not (NGMaxRecordCtrl Is Nothing) Then
                NGMaxRecordCtrl.Dispose()
            End If

            If Not (NPTMaxRecordCtrl Is Nothing) Then
                NPTMaxRecordCtrl.Dispose()
            End If

            If Not (TimeToIdleTimerCtrl Is Nothing) Then
                TimeToIdleTimerCtrl.Dispose()
            End If

            If Not (TimeToLightTimerCtrl Is Nothing) Then
                TimeToLightTimerCtrl.Dispose()
            End If

            If Not (StartTimerCtrl Is Nothing) Then
                StartTimerCtrl.Dispose()
            End If

            If Not (RundownTimerCtrl Is Nothing) Then
                RundownTimerCtrl.Dispose()
            End If

            If Not (CrankTimerCtrl Is Nothing) Then
                CrankTimerCtrl.Dispose()
            End If

            If Not (StarterTimerCtrl Is Nothing) Then
                StarterTimerCtrl.Dispose()
            End If

            If Not (OperatingTimerCtrl Is Nothing) Then
                OperatingTimerCtrl.Dispose()
            End If

            If Not (StatisticsCtrl Is Nothing) Then
                StatisticsCtrl.Dispose()
            End If

            If Not (PersistentValuesCtrl Is Nothing) Then
                PersistentValuesCtrl.Dispose()
            End If

            If Not (ExhaustFanCtrl Is Nothing) Then
                ExhaustFanCtrl.Dispose()
            End If

        End Sub
        '********************
        '* OnCloseTest()    *
        '********************
        Protected Overrides Sub OnCLOSE_TEST_BTN(sender As IChannel, newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then

                    If CELProject.EngineFamily = "PW200" Then

                        CELProject.EngineWindowCollection.Item(0).EngineWindow.BeginInvoke(New MethodInvoker(AddressOf Me.OnCLOSE_TEST_BTN_DISPOSE))

                    End If
                End If

            Catch ex As Exception
                MessageBox.Show("OnClose_Test: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Private Sub OnCLOSE_TEST_BTN_DISPOSE()
            Try

                MyBase.StopWorkingThread()
                RemoveHandlers()
                Dispose_Engine_Controllers()

            Catch ex As Exception
                MessageBox.Show("OnClose_Test_Dispose: " & ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionClosing(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionClosing(newStatus)
                'For All Engine

            Catch ex As Exception
                MessageBox.Show("OnTestSessionClosing: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Sub OnTestSessionIdling(ByVal newStatus As CEL.KineticaRT.Sequence.eTestMgrStatus)
            Try
                MyBase.OnTestSessionIdling(newStatus)

            Catch ex As Exception
                MessageBox.Show("OnTestSessionIdling: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Protected Overrides Function Init_Engine_Channels() As Boolean
            Dim Return_Value As New ArrayList()

            Return_Value.Clear()

            Try
                Return_Value.Add(MyBase.InitializeChannel(OIL_BACK_PRESSURE_REGULATOR_BTN, "OIL_BACK_PRESSURE_REGULATOR_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(OIL_BACK_PRESSURE_REGULATOR_CLOSE_BTN, "OIL_BACK_PRESSURE_REGULATOR_CLOSE_BTN"))

                Return_Value.Add(MyBase.InitializeChannel(ARCHIVE_RECORD, "ARCHIVE_RECORD"))
                Return_Value.Add(MyBase.InitializeChannel(CLOSE_TEST_BTN_OPC, "CLOSE_TEST_BTN_OPC"))
                Return_Value.Add(MyBase.InitializeChannel(CRANK_START_DEMAND_OPC, "CRANK_START_DEMAND_OPC"))
                Return_Value.Add(MyBase.InitializeChannel(CRANK_BTN_PRESSED, "CRANK_BTN_PRESSED"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_POS_DEMAND, "DYNO_POS_DEMAND"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_REMOTE_CONTROL_IND, "DYNO_REMOTE_CONTROL_IND"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_SPEED_100_PCT_RPM, "DYNO_SPEED_100_PCT_RPM"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_SPEED_DEMAND, "DYNO_SPEED_DEMAND"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_SPEED_MODE_BTN, "DYNO_SPEED_MODE_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_SET_INLET_PCT, "DYNO_SET_INLET_PCT"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_TORQUE_DEMAND, "DYNO_TORQUE_DEMAND"))
                Return_Value.Add(MyBase.InitializeChannel(DYNO_VALVE_STATUS_IND, "DYNO_VALVE_STATUS_IND"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_CLOSE_WINDOW_BTN, "EEC_CLOSE_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_OPEN_WINDOW_BTN, "EEC_OPEN_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_COMM_MODE_BTN, "EEC_COMM_MODE_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_POWER_BTN, "EEC_POWER_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(ENGINE_AT_REST, "ENGINE_AT_REST"))
                Return_Value.Add(MyBase.InitializeChannel(FACILITY_CLOSE_WINDOW_BTN, "FACILITY_CLOSE_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(FACILITY_OPEN_WINDOW_BTN, "FACILITY_OPEN_WINDOW_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(FUEL_USED_INITIAL_LITERS, "FUEL_USED_INITIAL_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(FUEL_USED_TOTAL_LITERS, "FUEL_USED_TOTAL_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(FM_INITIAL_VOLUME_LITERS, "FM_INITIAL_VOLUME_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(FM_TOTAL_VOLUME_LITERS, "FM_TOTAL_VOLUME_LITERS"))
                Return_Value.Add(MyBase.InitializeChannel(NEW_TEST_BTN, "NEW_TEST_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(T_MGT_CURRENT_DEGF, "T_MGT_CURRENT_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(T_MGT_DEGF, "T_MGT_DEGF"))
                Return_Value.Add(MyBase.InitializeChannel(TORQUE_METER_TORQUE_HI_LIMIT_LBSFT, "TORQUE_METER_TORQUE_HI_LIMIT_LBSFT"))
                Return_Value.Add(MyBase.InitializeChannel(UPS_ON_BATTERY_MAX_TIME_REACHED, "UPS_ON_BATTERY_MAX_TIME_REACHED"))
                Return_Value.Add(MyBase.InitializeChannel(CRANK_BTN, "CRANK_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(IGNITION1_BTN, "IGNITION1_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(IGNITION_AUTO_MANUAL_BTN, "IGNITION_AUTO_MANUAL_BTN"))
                Return_Value.Add(MyBase.InitializeChannel(EEC_MANUAL_MODE_IND, "EEC_MANUAL_MODE_IND"))
                Return_Value.Add(MyBase.InitializeChannel(READY_TO_START_IND, "READY_TO_START_IND"))

                If CELProject.EngineModel.Equals("PW206A") Then
                    'Automode handling for UPS_ON_BATTERY_MAX_VALUE_REACHED
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_FLY_BTN, "EEC_AUTO_MODE_SELECT_FLY_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_IDLE_BTN, "EEC_AUTO_MODE_SELECT_IDLE_BTN"))
                    'Starter and ignition handling for when EEC is in automatic mode
                    Return_Value.Add(MyBase.InitializeChannel(EEC_START_IND, "EEC_START_ON_IND"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_IGNITION_IND, "EEC_IGN_ON_IND"))

                ElseIf CELProject.EngineModel.Equals("PW206B") Then
                    'Automode handling for UPS_ON_BATTERY_MAX_VALUE_REACHED
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_FLY_BTN, "EEC_AUTO_MODE_SELECT_FLY_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_IDLE_BTN, "EEC_AUTO_MODE_SELECT_IDLE_BTN"))
                    'Starter and ignition handling for when EEC is in automatic mode
                    Return_Value.Add(MyBase.InitializeChannel(EEC_START_IGNITION_IND, "EEC_START_IGN_ON_IND"))

                ElseIf CELProject.EngineModel.Equals("PW206B2") Then
                    'Automode handling for UPS_ON_BATTERY_MAX_VALUE_REACHED
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_FLY_BTN, "EEC_AUTO_MODE_SELECT_FLY_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_IDLE_BTN, "EEC_AUTO_MODE_SELECT_IDLE_BTN"))
                    'Starter and ignition handling for when EEC is in automatic mode
                    Return_Value.Add(MyBase.InitializeChannel(EEC_START_IGNITION_IND, "EEC_START_IGN_ON_IND"))

                ElseIf CELProject.EngineModel.Equals("PW206AB3") Then
                    'Automode handling for UPS_ON_BATTERY_MAX_VALUE_REACHED
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_FLY_BTN, "EEC_AUTO_MODE_SELECT_FLY_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_IDLE_BTN, "EEC_AUTO_MODE_SELECT_IDLE_BTN"))
                    'Starter and ignition handling for when EEC is in automatic mode
                    Return_Value.Add(MyBase.InitializeChannel(EEC_START_IGNITION_IND, "EEC_START_IGN_ON_IND"))

                ElseIf CELProject.EngineModel.Equals("PW206C") Then
                    'Automode handling for UPS_ON_BATTERY_MAX_VALUE_REACHED
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_FLY_BTN, "EEC_AUTO_MODE_SELECT_FLY_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_IDLE_BTN, "EEC_AUTO_MODE_SELECT_IDLE_BTN"))
                    'Starter and ignition handling for when EEC is in automatic mode
                    Return_Value.Add(MyBase.InitializeChannel(EEC_START_IGNITION_IND, "EEC_START_ON_IGN_ON_IND"))

                ElseIf CELProject.EngineModel.Equals("PW207C") Then
                    'Automode handling for UPS_ON_BATTERY_MAX_VALUE_REACHED
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_FLY_BTN, "EEC_AUTO_MODE_SELECT_FLY_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_IDLE_BTN, "EEC_AUTO_MODE_SELECT_IDLE_BTN"))
                    'Starter and ignition handling for when EEC is in automatic mode
                    Return_Value.Add(MyBase.InitializeChannel(EEC_START_IGNITION_IND, "EEC_START_ON_IGN_ON_IND"))

                ElseIf CELProject.EngineModel.Equals("PW207D") Then
                    'The PWC207D Engine models do not have an Automode option.

                    'ElseIf CELProject.EngineModel.Equals("PW207D1") Then
                    'The PWC207D Engine models do not have an Automode option.
                    'Starter and ignition handling for when EEC is in automatic mode
                    'Return_Value.Add(MyBase.InitializeChannel(EEC_START_IND, "EEC_RUN_OFF_BTN"))

                    'ElseIf CELProject.EngineModel.Equals("PW207D2") Then
                    'The PWC207D Engine models do not have an Automode option.
                    'Starter and ignition handling for when EEC is in automatic mode
                    'Return_Value.Add(MyBase.InitializeChannel(EEC_START_IND, "EEC_RUN_OFF_BTN"))

                ElseIf CELProject.EngineModel.Equals("PW206E") Then
                    'Automode handling for UPS_ON_BATTERY_MAX_VALUE_REACHED
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_FLY_BTN, "EEC_AUTO_MODE_SELECT_FLY_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_IDLE_BTN, "EEC_AUTO_MODE_SELECT_IDLE_BTN"))
                    'Starter and ignition handling for when EEC is in automatic mode
                    Return_Value.Add(MyBase.InitializeChannel(EEC_START_IND, "EEC_START_ON_IND"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_IGNITION_IND, "EEC_IGN_ON_IND"))

                ElseIf CELProject.EngineModel.Equals("PW207E") Then
                    'Automode handling for UPS_ON_BATTERY_MAX_VALUE_REACHED
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_FLY_BTN, "EEC_AUTO_MODE_SELECT_FLY_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_IDLE_BTN, "EEC_AUTO_MODE_SELECT_IDLE_BTN"))
                    'Starter and ignition handling for when EEC is in automatic mode
                    Return_Value.Add(MyBase.InitializeChannel(EEC_START_IND, "EEC_START_ON_IND"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_IGNITION_IND, "EEC_IGN_ON_IND"))

                ElseIf CELProject.EngineModel.Equals("PW207K") Then
                    'Automode handling for UPS_ON_BATTERY_MAX_VALUE_REACHED
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_FLY_BTN, "EEC_AUTO_MODE_SELECT_FLY_BTN"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_AUTO_MODE_SELECT_IDLE_BTN, "EEC_AUTO_MODE_SELECT_IDLE_BTN"))
                    'Starter and ignition handling for when EEC is in automatic mode
                    Return_Value.Add(MyBase.InitializeChannel(EEC_START_IND, "EEC_STARTER_IND"))
                    Return_Value.Add(MyBase.InitializeChannel(EEC_IGNITION_IND, "EEC_IGNITION_IND"))

                End If

            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.Message)
                Return_Value.Add(False)
            Finally

            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function

