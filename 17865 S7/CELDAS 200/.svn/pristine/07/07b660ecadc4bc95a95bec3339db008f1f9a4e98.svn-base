        Private Sub OnUPS_ON_BATTERY_MAX_TIME_REACHED(ByVal sender As IChannel, ByVal newVal As Value)
            Try

                If (EEC_AUTO_MODE_SELECT_FLY_BTN Is Nothing) And EEC_AUTO_MODE_SELECT_IDLE_BTN Is Nothing Then
                    'Do nothing because 
                    Exit Sub
                End If

                If CELProject.IsTrue(newVal) And CELProject.IsTrue(EEC_AUTO_MODE_SELECT_FLY_BTN.Value) Then
                    EEC_AUTO_MODE_SELECT_IDLE_BTN.Value = KineticaRT_TRUE
                End If
            Catch Ex As Exception
                MessageBox.Show("OnUPS_ON_BATTERY_MAX_TIME_REACHED : " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnDIAGNOSTIC_CLOSE_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    CELProject.ActivateForm("Diagnostic_Screen_Engine", "PW200_Master_Screen", False, False)
                    'Reset Button
                    CELProject.DIAGNOSTIC_ENGINE_CLOSE_WINDOW_BTN.Value = KineticaRT.Values.Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("OnDIAGNOSTIC_CLOSE_WINDOW_BTN: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnDIAGNOSTIC_OPEN_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    CELProject.ActivateForm("Diagnostic_Screen_Engine", "PW200_Master_Screen", True, False)
                    'Reset Button
                    CELProject.DIAGNOSTIC_ENGINE_OPEN_WINDOW_BTN.Value = KineticaRT.Values.Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("OnDIAGNOSTIC_OPEN_WINDOW_BTN: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnEEC_OPEN_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    If CELProject.EngineModel.Equals("PW206A") Or CELProject.EngineModel.Equals("PW206E") Or CELProject.EngineModel.Equals("PW207E") Then
                        CELProject.ActivateForm("PW206A_E_PW207E_EEC_Screen", "PW200_Master_Screen", True, False)
                    ElseIf CELProject.EngineModel.Equals("PW206B") Or CELProject.EngineModel.Equals("PW206B2") Or CELProject.EngineModel.Equals("PW206B3") Then
                        CELProject.ActivateForm("PW206B_B2_B3_EEC_Screen", "PW200_Master_Screen", True, False)
                    ElseIf CELProject.EngineModel() = "PW207D" Or CELProject.EngineModel() = "PW207D1" Or CELProject.EngineModel() = "PW207D2" Then
                        CELProject.ActivateForm("PW207D_D1_D2_EEC_Screen", "PW200_Master_Screen", True, False)
                    ElseIf (CELProject.EngineModel() = "PW206C" Or CELProject.EngineModel() = "PW207C") Then
                        CELProject.ActivateForm("PW206C_207C_EEC_Screen", "PW200_Master_Screen", True, False)
                    ElseIf (CELProject.EngineModel() = "PW207K") Then
                        CELProject.ActivateForm("PW207K_EEC_Screen", "PW200_Master_Screen", True, False)
                    End If
                    'Reset Button
                    EEC_OPEN_WINDOW_BTN.Value = KineticaRT.Values.Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("OnEEC_OPEN_WINDOW_BTN: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnEEC_CLOSE_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    If CELProject.EngineModel.Equals("PW206A") Or CELProject.EngineModel.Equals("PW206E") Or CELProject.EngineModel.Equals("PW207E") Then
                        CELProject.ActivateForm("PW206A_E_PW207E_EEC_Screen", "PW200_Master_Screen", False, False)
                    ElseIf CELProject.EngineModel.Equals("PW206B") Or CELProject.EngineModel.Equals("PW206B2") Or CELProject.EngineModel.Equals("PW206B3") Then
                        CELProject.ActivateForm("PW206B_B2_B3_EEC_Screen", "PW200_Master_Screen", False, False)
                    ElseIf CELProject.EngineModel() = "PW207D" Or CELProject.EngineModel() = "PW207D1" Or CELProject.EngineModel() = "PW207D2" Then
                        CELProject.ActivateForm("PW207D_D1_D2_EEC_Screen", "PW200_Master_Screen", False, False)
                    ElseIf (CELProject.EngineModel() = "PW206C" Or CELProject.EngineModel() = "PW207C") Then
                        CELProject.ActivateForm("PW206C_207C_EEC_Screen", "PW200_Master_Screen", False, False)
                    ElseIf (CELProject.EngineModel() = "PW207K") Then
                        CELProject.ActivateForm("PW207K_EEC_Screen", "PW200_Master_Screen", False, False)
                    End If
                    'Reset Button
                    EEC_CLOSE_WINDOW_BTN.Value = KineticaRT.Values.Values.False
                End If
            Catch Ex As Exception
                MessageBox.Show("OnEEC_CLOSE_WINDOW_BTN: " & Ex.ToString())
            End Try
        End Sub

        Private Sub OnEEC_START_IGNITION_IND(ByVal sender As IChannel, ByVal newVal As Value)
            If CELProject.IsTrue(newVal) Then
                'When start/ignition signal from EEC is received...
                If READY_TO_START_IND.Value = KineticaRT_TRUE And EEC_MANUAL_MODE_IND.Value = KineticaRT_FALSE Then
                    'Press crank button if engine is ready to start.
                    CRANK_BTN.Value = KineticaRT_TRUE
                    If IGNITION_AUTO_MANUAL_BTN.Value = KineticaRT_FALSE Then
                        'Also press the ignition button if in automatic mode.
                        IGNITION1_BTN.Value = KineticaRT_TRUE
                    End If
                End If

            ElseIf CELProject.IsFalse(newVal) Then
                'When EEC is in automatic mode, unpress the crank button when start/ignition signal from eec is lost
                If EEC_MANUAL_MODE_IND.Value = KineticaRT_FALSE Then
                    CRANK_BTN.Value = KineticaRT_FALSE
                    If IGNITION_AUTO_MANUAL_BTN.Value = KineticaRT_FALSE Then
                        'Also unpress the ignition button if in automatic mode
                        IGNITION1_BTN.Value = KineticaRT_FALSE
                    End If
                End If

            End If

        End Sub

        Private Sub OnEEC_START_IND(ByVal sender As IChannel, ByVal newVal As Value)
            If CELProject.IsTrue(newVal) Then
                'When start signal from EEC becomes true...
                If READY_TO_START_IND.Value = KineticaRT_TRUE And EEC_MANUAL_MODE_IND.Value = KineticaRT_FALSE Then
                    'Press crank button if Engine is ready to start
                    CRANK_BTN.Value = KineticaRT_TRUE
                End If
            ElseIf CELProject.IsFalse(newVal) Then
                If EEC_MANUAL_MODE_IND.Value = KineticaRT_FALSE Then
                    'Reset crank button when strat signal from EEC becomes False
                    CRANK_BTN.Value = KineticaRT_FALSE
                End If
            End If
        End Sub

        Private Sub OnEEC_IGNITION_IND(ByVal sender As IChannel, ByVal newVal As Value)
            If CELProject.IsTrue(newVal) Then
                'When ignition signal from EEC becomes true...
                If READY_TO_START_IND.Value = KineticaRT_TRUE And IGNITION_AUTO_MANUAL_BTN.Value = KineticaRT_FALSE And EEC_MANUAL_MODE_IND.Value = KineticaRT_FALSE Then
                    'Press ignition button if in automatic mode and engine is ready to start
                    IGNITION1_BTN.Value = KineticaRT_TRUE
                End If
            ElseIf CELProject.IsFalse(newVal) Then
                'When ignition signal from EEC becomes false...
                If IGNITION_AUTO_MANUAL_BTN.Value = KineticaRT_FALSE And EEC_MANUAL_MODE_IND.Value = KineticaRT_FALSE Then
                    'Reset ignition button if in automatic mode
                    IGNITION1_BTN.Value = KineticaRT_FALSE
                End If
            End If

        End Sub

        Private Sub OnEEC_POWER_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            If CELProject.IsTrue(newVal) Then
                EEC_COMM_MODE_BTN.Value = KineticaRT_TRUE
            ElseIf CELProject.IsFalse(newVal) Then
                'Reset ignition button if in automatic mode
                EEC_COMM_MODE_BTN.Value = KineticaRT_FALSE
            End If
        End Sub

