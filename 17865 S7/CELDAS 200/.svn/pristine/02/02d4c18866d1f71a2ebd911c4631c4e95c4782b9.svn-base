        Protected Sub New(medraFilePath As String, usingMixerNozzle As Boolean, asSample As Boolean)
            Me._MedraFilePath = medraFilePath
            Me._UsingMixerNozzle = usingMixerNozzle
            Me._AsSample = asSample
        End Sub

        Public Sub InitializeRepport(isSampleMode As Boolean)

            Dim content = ""

            content += GenerateHeader(System.DateTime.Now, isSampleMode)
            content += Environment.NewLine
            content += GenerateConstantsLines()
            content += Environment.NewLine
            content += GenerateMasterNumberRecord()
            content += Environment.NewLine
            content += GenerateUnitSection()
            content += Environment.NewLine
            content += GenerateParametersNames()

            Try
                Dim writer = New IO.StreamWriter(_MedraFilePath, False)

                writer.Write(content)

                writer.Close()
            Catch ex As Exception
                MessageBox.Show("Could not save the repport: " + ex.Message)
            End Try

        End Sub

        Private Function GenerateHeader(ByVal timeOfTest As System.DateTime, isSampleMode As Boolean) As String
            Dim content = New StringBuilder

            Dim numberOfMeasuredParameters = DirectCast(_MappedProperties, ArrayList).Count - CountDeletedParameters()

            ' ===== Header Record Line 1 =====
            '1-10       Number of measured parameters
            If isSampleMode Then
                content.Append(PadStringWithSpacesOrTrim("5", 10))
            Else
                content.Append(PadStringWithSpacesOrTrim(numberOfMeasuredParameters.ToString(), 10))
            End If
            '11-21      Time of test (HH:MM:SS.xx)
            content.Append(PadStringWithSpacesOrTrim(timeOfTest.ToString("HH:mm:ss.ff"), 11))

            content.Append(Environment.NewLine)

            ' ===== Header Record Line 2 =====
            '1          Empty space
            '2-7        Engine Name
            '8         Dash character '-'
            content.Append(" TFE731-")
            '9-12       Engine Major Model Number
            Dim engineTable = EngineName.Split("-")
            content.Append(PadStringWithSpacesOrTrim(engineTable(1), 4))
            '13         Dash character '-'
            content.Append("-")
            '14-20      Engine Sub() Model Number
            Dim engineType = Engines.GetEngineFromDisplayName(EngineName)
            If IsEngineSupportedByMedra(engineType) Then
                content.Append(PadStringWithSpacesOrTrim(engineTable(2), 7))
            Else
                content.Append("       ")
            End If
            '21-26      Engine Serial Number
            content.Append(PadStringWithSpacesOrTrim(EngineSerialNumber, 6))
            '27         Not used (space)
            content.Append(" ")
            '28-37      Test Date(MM / DD / YYYY)
            content.Append(PadStringWithSpacesOrTrim(timeOfTest.ToString("MM/dd/yyyy", CultureInfo.InvariantCulture), 10))
            '38         Not used (space)
            '39         Aircraft Flag(Aircraft = 'A', Cell = 'C')
            '40         Not used (space)
            content.Append(" C ")
            '41-43      Build
            content.Append(PadStringWithSpacesOrTrim(BUILD, 3))
            '44         Not used (space)
            content.Append(" ")
            '45-48      Run
            content.Append(PadStringWithSpacesOrTrim(RUN.ToString(), 4))
            '49         Not used (space)
            content.Append(" ")
            '50-56      Aircraft Nozzle Code 50 - 56
            content.Append(PadStringWithSpacesOrTrim(NozzleCode.ToString(), 7))
            '57         Not used (space)
            content.Append(" ")
            '58-70      Work Order Number 58 - 70
            content.Append(PadStringWithSpacesOrTrim(WorkOderNumber, 13))

            content.Append(Environment.NewLine)

            ' ===== Header Record Line 3 ===== OPTIONAL
            '1          Empty space
            content.Append(" ")
            '2-21       Aircraft Model
            content.Append(PadStringWithSpacesOrTrim(AircraftModel, 20))
            '22-31      Aircraft Serial Number
            content.Append(PadStringWithSpacesOrTrim(AircraftSerial, 10))
            '32-60      Customer
            content.Append(PadStringWithSpacesOrTrim(Customer, 29))
            '61-70      Recorded By
            content.Append(PadStringWithSpacesOrTrim(RecordedBy, 10))
            '71-80      Entered By
            content.Append(PadStringWithSpacesOrTrim(EnteredBy, 10))

            content.Append(Environment.NewLine)

            ' ===== Header Record Line 4 ===== OPTIONAL
            '1          Empty space
            content.Append(" ")
            '2-80       Comment
            content.Append(PadStringWithSpacesOrTrim(Comment, 79))

            Return content.ToString()
        End Function

        Private Function GenerateConstantsLines() As String

            Dim content = New StringBuilder

            ' ===== Engine Constants Line 1 =====
            '1-14       Specific Gravity as 60° F
            content.Append(ConvertDoubleToEFourteenFormat(SpecificGravityAs60F))
            '15 - 28    Dry Bulb Temperature
            content.Append(ConvertDoubleToEFourteenFormat(DryBulbTemperature))
            '29 - 42    Wet Bulb Temperature
            content.Append(ConvertDoubleToEFourteenFormat(0)) 'Not used as we provide DryBulbTemperature+RelativeHumidity, received logger files provide zero for this value as they use Dry+RelHum, we will provide zero too
            '43 - 56    Lower Heating Value 
            content.Append(ConvertIntegerToEFourteenFormat(FuelLHV))
            '57 - 70    A4 Area (HPT nozzle area)
            content.Append(ConvertDoubleToEFourteenFormat(HighPressureTurbineNozzleArea))
            '71 - 84    A5 Area (LPT nozzle area)
            content.Append(ConvertDoubleToEFourteenFormat(LowPressureTurbineNozzleArea))
            '85 - 98    A7 Area
            content.Append(ConvertDoubleToEFourteenFormat(0)) 'Not used
            '99 - 112   A11 Area
            content.Append(ConvertDoubleToEFourteenFormat(0)) 'Not used

            content.Append(Environment.NewLine)

            ' ===== Engine Constants Line 2 =====
            '1 - 14     A1 Area
            content.Append(ConvertDoubleToEFourteenFormat(0)) 'Not used
            '15 - 28    N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))
            '29 - 42    N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))
            '43 - 56    SG Setting Factor
            content.Append(ConvertDoubleToEFourteenFormat(SGSettingFactor)) 'In the "EEC/DEEC SG Setting" field, enter the number of "clicks" set on the Engine Control by the test technician.
            '57 - 70    Flat Rating Temp (Deg F)
            content.Append(ConvertDoubleToEFourteenFormat(FlatRatingTemp)) 'If you entered an unknown engine sub-model or nozzle type, then you must enter the flat rating temperature.
            '71 - 84    Flat Rating N1 (RPM)
            content.Append(ConvertDoubleToEFourteenFormat(FlatRatingN1))   'If you entered an unknown engine sub-model or nozzle type, then you must enter the flat rating N1.
            '85 - 98    Thrust Correction Factor
            content.Append(ConvertDoubleToEFourteenFormat(ThrustCorrectionFactor)) 'To compensate, use an approved ASE thrust correction factor.
            '99 - 112   Aircraft Or Cell(Aircraft = 1.0)
            content.Append(ConvertDoubleToEFourteenFormat(0)) 'TestCell = 0 from provided loggers files

            content.Append(Environment.NewLine)

            ' ===== Engine Constants Line 3 =====
            '1 - 14     Engine Location
            content.Append(ConvertDoubleToEFourteenFormat(EngineLocation)) 'OPTIONAL, we'll feed it as the received loggers files had the information
            '15 - 28    Time Since New
            content.Append(ConvertIntegerToEFourteenFormat(TimeSinceNew)) 'number of hours the engine has run since it was new
            '29 - 42    Cycles Since New
            content.Append(ConvertIntegerToEFourteenFormat(CyclesSinceNew)) 'number of cycles (starts) this engine has performed since it was new
            '43 - 56    N1 Compensator Dash Number
            content.Append(ConvertIntegerToEFourteenFormat(N1CompensatorDashNumber)) 'TODO TFE voir avec client si la valeur est de 1-7 (0-300 RPM) ou de 1-10 (0-450 RPM)
            '57 - 70    Manual/ Digital Data Logger (Manual = 1.0)
            content.Append(ConvertDoubleToEFourteenFormat(0)) 'Digital = 0 from received logger files
            '71 - 84    Performance Calibration Reason Code
            content.Append(ConvertDoubleToEFourteenFormat(ReasonForTest))
            '85 - 98    Relative Humidity
            content.Append(ConvertDoubleToEFourteenFormat(RelativeHumidity))
            '99 - 112   N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))

            content.Append(Environment.NewLine)

            ' ===== Engine Constants Line 4 =====
            '1 - 14     N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))
            '15 - 28    N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))
            '29 - 42    N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))
            '43 - 56    N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))
            '57 - 70    N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))
            '71 - 84    N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))
            '85 - 98    N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))
            '99 - 112   N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))

            content.Append(Environment.NewLine)

            ' ===== Engine Constants Line 5 =====
            '1 - 14     N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))
            '15 - 28    N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))
            '29 - 42    N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))
            '43 - 56    N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))
            '57 - 70    N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))
            '71 - 84    N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))
            '85 - 98    N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))
            '99 - 112   N/A
            content.Append(ConvertDoubleToEFourteenFormat(0))

            Return content.ToString()
        End Function

        Protected Function GenerateMasterNumberRecord() As String

            Dim LENGTH = 14
            Dim CONTENT_PER_LINE_MINUS_ONE = 7

            Dim content = New StringBuilder
            Dim counter As Integer = 0
            For Each mappedProperty As Mapped In _MappedProperties
                If mappedProperty.IsDeleted(Me) Then Continue For
                content.Append(PadStringWithSpacesOrTrim(mappedProperty.MasterRecordNumber, LENGTH))
                counter += 1

                If counter > CONTENT_PER_LINE_MINUS_ONE Then
                    counter = 0
                    content.Append(Environment.NewLine)
                End If
            Next

            While counter <= CONTENT_PER_LINE_MINUS_ONE
                content.Append(PadStringWithSpacesOrTrim("", LENGTH))
                counter += 1
            End While

            Return content.ToString().TrimEnd(Environment.NewLine) 'triming au cas où le nombre de parametres soit divisible par 8

        End Function

        Protected Function GenerateParametersNames() As String

            Dim LENGTH = 10
            Dim CONTENT_PER_LINE_MINUS_ONE = 7

            Dim content = New StringBuilder
            Dim counter As Integer = 0
            For Each mappedProperty As Mapped In _MappedProperties
                If mappedProperty.IsDeleted(Me) Then Continue For
                content.Append(PadStringWithSpacesOrTrim(mappedProperty.PropertyDisplayName, LENGTH))
                counter += 1

                If counter > CONTENT_PER_LINE_MINUS_ONE Then
                    counter = 0
                    content.Append(Environment.NewLine)
                End If
            Next

            While counter <= CONTENT_PER_LINE_MINUS_ONE
                content.Append(PadStringWithSpacesOrTrim("", LENGTH))
                counter += 1
            End While

            Return content.ToString().TrimEnd(Environment.NewLine) 'triming au cas où le nombre de parametres soit divisible par 8

        End Function

        Protected Function GenerateUnitSection() As String

            Dim LENGTH = 9
            Dim CONTENT_PER_LINE_MINUS_ONE = 7

            Dim content = New StringBuilder
            Dim counter As Integer = 0
            For Each mappedProperty As Mapped In _MappedProperties
                If mappedProperty.IsDeleted(Me) Then Continue For
                content.Append(PadStringWithSpacesOrTrim(mappedProperty.UnitName, LENGTH))
                content.Append(mappedProperty.UnitTypeId)
                counter += 1

                If counter > CONTENT_PER_LINE_MINUS_ONE Then
                    counter = 0
                    content.Append(Environment.NewLine)
                End If
            Next

            While counter <= CONTENT_PER_LINE_MINUS_ONE
                content.Append(PadStringWithSpacesOrTrim("", LENGTH + 1))
                counter += 1
            End While

            Return content.ToString().TrimEnd(Environment.NewLine) 'triming au cas où le nombre de parametres soit divisible par 8

        End Function

        Protected Shared Function PadStringWithSpacesOrTrim(stringToPad As String, length As Integer) As String
            If stringToPad.Length > length Then Return stringToPad.Substring(0, length)

            'Any unused or blank positions in a data item are filled with spaces And are RIGHT JUSTIFIED. src: SW-MEDRA-6XX-001.pdf
            While stringToPad.Length < length
                'stringToPad = " " + stringToPad <- This break the unit section and it won't load, following line solve the issue and seems to works vv
                stringToPad += " "
            End While

            Return stringToPad

        End Function

        Protected Function ConvertIntegerToEFourteenFormat(value As Integer) As String

            Return value.ToString(MEDRA_VALUE_FORMAT, CultureInfo.InvariantCulture)

        End Function

        Protected Function ConvertDoubleToEFourteenFormat(value As Double) As String

            Return value.ToString(MEDRA_VALUE_FORMAT, CultureInfo.InvariantCulture)

        End Function

        Protected Function ConvertToEFourteenFormat(value As Object) As String
            Dim valueAsString = value.ToString()

            Dim doubleValue As Double
            Dim integerValue As Integer
            If Integer.TryParse(valueAsString, integerValue) Then
                Return integerValue.ToString(MEDRA_VALUE_FORMAT, CultureInfo.InvariantCulture)
            ElseIf Double.TryParse(valueAsString, doubleValue) Then
                Return doubleValue.ToString(MEDRA_VALUE_FORMAT, CultureInfo.InvariantCulture)
            Else
                Console.WriteLine(valueAsString + " is not supported in E14 format")
                Return PadStringWithSpacesOrTrim(valueAsString, 14)
            End If
        End Function

        Public Sub AddRunToRepport()

            Dim content = New StringBuilder

            content.Append(Environment.NewLine)

            Dim numberOfMeasuredParameters = DirectCast(_MappedProperties, ArrayList).Count - CountDeletedParameters()

            ' ===== Scan Data Header =====
            '1-14       Number of measured parameters
            If IsSampleMode() Then
                content.Append(PadStringWithSpacesOrTrim("5", 14))
            Else
                content.Append(PadStringWithSpacesOrTrim(numberOfMeasuredParameters.ToString(), 14))
            End If
            '15-28      ID flag - Must be '-1'
            content.Append(PadStringWithSpacesOrTrim("-1", 14))
            '29-39      Scan time (HH:MM:SS.xx)
            content.Append(PadStringWithSpacesOrTrim(System.DateTime.Now.ToString("HH:mm:ss.ff"), 11))

            content.Append(Environment.NewLine)

            content.Append(GenerateDataValuesContent())

            Try
                Dim writer = New IO.StreamWriter(_MedraFilePath, True)

                writer.Write(content.ToString())

                writer.Close()
            Catch ex As Exception

            End Try

        End Sub

        Private Function IsSampleMode() As Boolean
            Return DirectCast(_MappedProperties, ArrayList).Count < 15
        End Function

        Protected Function GenerateDataValuesContent() As String

            Dim LENGTH = 14
            Dim CONTENT_PER_LINE_MINUS_ONE = 7

            Dim content = New StringBuilder

            Dim counter As Integer = 0
            For Each mappedProperty As Mapped In _MappedProperties
                If mappedProperty.IsDeleted(Me) Then Continue For

                If Double.IsNaN(mappedProperty.GetPropertyValue(Me)) Then
                    content.Append(ConvertToEFourteenFormat(0.0))
                Else
                    content.Append(ConvertToEFourteenFormat(mappedProperty.GetPropertyValue(Me)))
                End If

                counter += 1

                If counter > CONTENT_PER_LINE_MINUS_ONE Then
                    counter = 0
                    content.Append(Environment.NewLine)
                End If
            Next

            While counter <= CONTENT_PER_LINE_MINUS_ONE
                content.Append(PadStringWithSpacesOrTrim("", LENGTH))
                counter += 1
            End While

            Return content.ToString().TrimEnd(Environment.NewLine) 'triming au cas où le nombre de parametres soit divisible par 8

        End Function

        Public Shared Function IsEngineSupportedByMedra(selectedEngine As Engine) As Boolean
            If selectedEngine = Engine.TFE7313A2B1 Then Return False
            If selectedEngine = Engine.TFE7313AR2B1 Then Return False
            If selectedEngine = Engine.TFE7313AR2B2 Then Return False
            If selectedEngine = Engine.TFE7313AR3B1 Then Return False
            If selectedEngine = Engine.TFE7313AR3B2 Then Return False
            If selectedEngine = Engine.TFE7313C3B Then Return False
            If selectedEngine = Engine.TFE7313C3B1 Then Return False
            If selectedEngine = Engine.TFE7313CR3B Then Return False
            If selectedEngine = Engine.TFE7313CR3B1 Then Return False
            If selectedEngine = Engine.TFE7313CR3B2 Then Return False
            If selectedEngine = Engine.TFE73140BR1B Then Return False ' Supported by .89 but not .51

            Return True
        End Function

