        Public Overrides Function CountDeletedParameters() As Integer
            Dim cpt = 0

            For Each item As BooleanItem In Tt1dot2_DELETE
                If item.Value.ToString.ToUpper = "TRUE" Then cpt = cpt + 1
            Next
            For Each item As BooleanItem In Tt60_DELETE 'Tt55_DELETE and Tt60_DELETE are the same reference but for reflexion purpose we have both so we only substract one of them
                If item.Value.ToString.ToUpper = "TRUE" Then cpt = cpt + 1
            Next
            For Each item As BooleanItem In T155_DELETE
                If item.Value.ToString.ToUpper = "TRUE" Then cpt = cpt + 1
            Next

            For Each item As BooleanItem In Ps1dot2_DELETE
                If item.Value.ToString.ToUpper = "TRUE" Then cpt = cpt + 1
            Next
            For Each item As BooleanItem In Pt1dot2_DELETE
                If item.Value.ToString.ToUpper = "TRUE" Then cpt = cpt + 1
            Next
            For Each item As BooleanItem In Pt60_DELETE 'Pt55_DELETE and Pt60_DELETE are the same reference but for reflexion purpose we have both so we only substract one of them
                If item.Value.ToString.ToUpper = "TRUE" Then cpt = cpt + 1
            Next
            For Each item As BooleanItem In P155_DELETE
                If item.Value.ToString.ToUpper = "TRUE" Then cpt = cpt + 1
            Next
            Return cpt
        End Function

    End Class

End Namespace
