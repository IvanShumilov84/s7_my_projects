            'If dspLowPressureTurbineNozzleArea IsNot Nothing Then dspLowPressureTurbineNozzleArea.Enabled = enable

            HIGHPRESSURETURBINENOZZLEAREA_VALUE.Value = New KineticaRT.Values.Integer(0)
            LOWPRESSURETURBINENOZZLEAREA_VALUE.Value = New KineticaRT.Values.Integer(0)
        End Sub

        Private Function GetRecursive(startPoint As Control, targetName As String, targetType As Type) As Object
            If startPoint.Name = targetName AndAlso startPoint.GetType() Is targetType Then Return startPoint

            For Each child As Control In startPoint.Controls
                Dim result = GetRecursive(child, targetName, targetType)
                If result IsNot Nothing Then Return result
            Next

            Return Nothing
        End Function



        Private Sub OnEngineLocationValueChanged(sender As KineticaRT.Channels.IChannel, newVal As KineticaRT.Values.Value)
            If ENGINELOCATION_VALUE Is Nothing Then Return
            Dim engineLocation As Integer
            Dim doubleEngineLocation As Double

            If Integer.TryParse(ENGINELOCATION_VALUE.Value.ToString(), engineLocation) Then
                If engineLocation > 4 Then
                    ENGINELOCATION_VALUE.Value = New KineticaRT.Values.Integer(4)
                ElseIf engineLocation < 0 Then
                    ENGINELOCATION_VALUE.Value = New KineticaRT.Values.Integer(0)
                End If
            ElseIf Double.TryParse(ENGINELOCATION_VALUE.Value.ToString(), doubleEngineLocation) Then
                ENGINELOCATION_VALUE.Value = New KineticaRT.Values.Integer(Integer.Parse(Math.Round(doubleEngineLocation, 0).ToString()))
            End If

        End Sub










        '**********************
        '* OnInitReport() *
        '**********************
        Private Sub OnInitReport(sender As KineticaRT.Channels.IChannel, newVal As KineticaRT.Values.Value)
            If newVal Is KineticaRT.Values.Values.True Then

                Dim outIsSampleMode As Boolean = False
                Boolean.TryParse(SAMPLE_MODE.Value.ToString(), outIsSampleMode)


                Dim medraPath As String = "C:\" + Test_Mgr_UUT_Model.Value.ToString() + "\" + Test_Mgr_UUT_Answer(0).ToString() + "\" + Test_Mgr_UUT_Answer(1).ToString() + "\MEDRA\"
                If Directory.Exists(medraPath) = False Then
                    Directory.CreateDirectory(medraPath)
                End If

                Dim fileCount = Directory.GetFiles(medraPath, "LOGGER.*").Length + 1

                Dim medraFilePath As String = medraPath + "LOGGER." + fileCount.ToString()

                Dim succeed = CreateMEDRA(medraFilePath, outIsSampleMode)
                If succeed Then
                    Try
                        InitializeMEDRA(outIsSampleMode)
                    Catch ex As Exception
                        MessageBox.Show("Could not create MEDRA file, an exception in the parameters occured.")
                    End Try
                Else
                    MessageBox.Show("Could not create MEDRA file")
                End If

                InitReport.Value = KineticaRT.Values.Values.False
            End If
        End Sub

        '**********************
        '* OnSaveCurrentRun() *
        '**********************
        Private Sub OnSaveCurrentRun(sender As KineticaRT.Channels.IChannel, newVal As KineticaRT.Values.Value)
            If newVal Is KineticaRT.Values.Values.True Then

                Try
                    FillRunToMEDRA()
                Catch ex As Exception
                    MessageBox.Show("Could not save the current run to MEDRA file.")
                End Try

                SaveCurrentRun.Value = KineticaRT.Values.Values.False
            End If
        End Sub

        Private Function CreateMEDRA(medraFilePath As String, isSampleMode As Boolean) As Boolean

            Dim outIsUsingMixerNozzle As Boolean
            If Not Boolean.TryParse(ISUSINGMIXERNOZZLE.Value.ToString(), outIsUsingMixerNozzle) Then Return False

            Dim engineName = Test_Mgr_UUT_Model.Value.ToString()
            Dim engine = Engines.GetEngineFromDisplayName(engineName)
            Dim engineCategory = Engines.GetEngineCategory(engine)

            If engineCategory = Category.Small Then
                InitializedMedraFileGenerator = New SmallEngineMedraFileGenerator(medraFilePath, outIsUsingMixerNozzle, isSampleMode)
            ElseIf engineCategory = Category.Big Then
                InitializedMedraFileGenerator = New BigEngineMedraFileGenerator(medraFilePath, outIsUsingMixerNozzle, isSampleMode)
            Else
                Return False
            End If

            Dim smallMedraFileGenerator = TryCast(InitializedMedraFileGenerator, SmallEngineMedraFileGenerator)
            If smallMedraFileGenerator IsNot Nothing Then

                smallMedraFileGenerator.Ps1dot2_DELETE = Me.OPC_Ps1dot2_DELETE

                smallMedraFileGenerator.T1_DELETE = Me.OPC_T1_DELETE
                smallMedraFileGenerator.T8_DELETE = Me.OPC_T8_DELETE
                smallMedraFileGenerator.T7_DELETE = Me.OPC_T8_DELETE
                smallMedraFileGenerator.T11_DELETE = Me.OPC_T11_DELETE

                smallMedraFileGenerator.P1dot2_DELETE = Me.OPC_P1dot2_DELETE
                smallMedraFileGenerator.P8_DELETE = Me.OPC_P8_DELETE
                smallMedraFileGenerator.P7_DELETE = Me.OPC_P8_DELETE
                smallMedraFileGenerator.P11_DELETE = Me.OPC_P11_DELETE
            End If


            Dim bigMedraFileGenerator = TryCast(InitializedMedraFileGenerator, BigEngineMedraFileGenerator)
            If bigMedraFileGenerator IsNot Nothing Then

                bigMedraFileGenerator.Ps1dot2_DELETE = Me.OPC_Ps1dot2_DELETE

                bigMedraFileGenerator.Tt1dot2_DELETE = Me.OPC_Tt1dot2_DELETE
                bigMedraFileGenerator.Tt60_DELETE = Me.OPC_Tt60_DELETE
                bigMedraFileGenerator.Tt55_DELETE = Me.OPC_Tt60_DELETE
                bigMedraFileGenerator.T155_DELETE = Me.OPC_T155_DELETE

                bigMedraFileGenerator.Pt1dot2_DELETE = Me.OPC_Pt1dot2_DELETE
                bigMedraFileGenerator.Pt60_DELETE = Me.OPC_Pt60_DELETE
                bigMedraFileGenerator.Pt55_DELETE = Me.OPC_Pt60_DELETE
                bigMedraFileGenerator.P155_DELETE = Me.OPC_P155_DELETE
            End If

            Return True
        End Function

        Private Sub InitializeMEDRA(isSampleMode As Boolean)

            InitializedMedraFileGenerator.AircraftModel = AircraftModel_List.Text
            InitializedMedraFileGenerator.AircraftSerial = "" 'Always empty in the example files, + the operator still can add it in the MEDRA interface
            InitializedMedraFileGenerator.Comment = REMARK_TEXT.Value.ToString()
            InitializedMedraFileGenerator.Customer = Test_Mgr_UUT_Answer(5).Value.ToString()
            InitializedMedraFileGenerator.EngineName = Test_Mgr_UUT_Model.Value.ToString()
            InitializedMedraFileGenerator.EngineSerialNumber = Test_Mgr_UUT_Answer(0).Value.ToString() 'Only accept number but could start by 0
            InitializedMedraFileGenerator.EnteredBy = Test_Mgr_UUT_Choice(1).Value.ToString() 'Operator
            InitializedMedraFileGenerator.NozzleCode = Integer.Parse(NOZZLECODE_VALUE.Value.ToString()) '0 or 1 or 2 or 3 depending on engine and plane
            InitializedMedraFileGenerator.RecordedBy = Test_Mgr_UUT_Choice(2).Value.ToString() 'Inspector
            InitializedMedraFileGenerator.WorkOderNumber = Test_Mgr_UUT_Answer(1).Value.ToString()

            'Constants
            InitializedMedraFileGenerator.FuelLHV = Double.Parse(Test_Mgr_UUT_Answer(2).Value.ToString())
            InitializedMedraFileGenerator.SpecificGravityAs60F = SG_60F.Value.ToDouble()
            InitializedMedraFileGenerator.DryBulbTemperature = T_DRY_BULB.Value.ToDouble()
            InitializedMedraFileGenerator.RelativeHumidity = RELATIVE_HUMIDITY.Value.ToDouble()
            InitializedMedraFileGenerator.HighPressureTurbineNozzleArea = HIGHPRESSURETURBINENOZZLEAREA_VALUE.Value.ToDouble()
            InitializedMedraFileGenerator.LowPressureTurbineNozzleArea = LOWPRESSURETURBINENOZZLEAREA_VALUE.Value.ToDouble()
            InitializedMedraFileGenerator.SGSettingFactor = SGSETTINGFACTOR_VALUE.Value.ToDouble() '0-11
            InitializedMedraFileGenerator.FlatRatingTemp = 0.0 'Used when unknow nozzle or unknown engine sub model, oterwise zero
            InitializedMedraFileGenerator.FlatRatingN1 = 0.0 'Used when unknown nozzle or unknown engine sub model, oterwise zero
            InitializedMedraFileGenerator.ThrustCorrectionFactor = THRUSTCORRECTIONFACTOR_VALUE.Value.ToDouble()
            InitializedMedraFileGenerator.EngineLocation = Integer.Parse(ENGINELOCATION_VALUE.Value.ToString()) '0 if unknown, 1 is far left from driver perspective,2 left, 3 right, 4 far right
            InitializedMedraFileGenerator.TimeSinceNew = Double.Parse(Test_Mgr_UUT_Answer(4).Value.ToString())
            InitializedMedraFileGenerator.CyclesSinceNew = Double.Parse(Test_Mgr_UUT_Answer(3).Value.ToString())

            Dim screenReference As KineticaRT.Studio.Window
            Throw New NotImplementedException("Uncomment all this if you need to use MEDRA")
            'Uncomment all this if you need to use MEDRA
            '-------------------------------------------
            'Dim mainScreenName As String = EngineScreensService.GetMainScreen(Test_Mgr_UUT_Model.ToString())
            'Initialize_Object(screenReference, mainScreenName)
            ReasonForTest_List = GetRecursive(screenReference.Controls.Item(0).Controls.Item(0).Controls.Item(1), "cboReasonForTest", GetType(ComboBox))
            InitializedMedraFileGenerator.ReasonForTest = Integer.Parse(ReasonForTest_List.SelectedIndex.ToString()) + 1

            InitializedMedraFileGenerator.InitializeRepport(isSampleMode)

        End Sub

        Private Sub FillRunToMEDRA()

            If InitializedMedraFileGenerator Is Nothing Then Return

            Dim engineName = Test_Mgr_UUT_Model.Value.ToString()
            Dim engine = Engines.GetEngineFromDisplayName(engineName)
            Dim engineCategory = Engines.GetEngineCategory(engine)
            If engineCategory <> Category.Small AndAlso engineCategory <> Category.Big Then Return

            InitializedMedraFileGenerator.PBAR = PBAR_MEAN.Value.ToDouble()
            InitializedMedraFileGenerator.N1 = N1_RPM_MEAN.Value.ToDouble()
            InitializedMedraFileGenerator.N2 = N2_RPM_MEAN.Value.ToDouble()
            InitializedMedraFileGenerator.Fn = THRUST_MEAN.Value.ToDouble()
            InitializedMedraFileGenerator.WF = WF_MEAN.Value.ToDouble()
            InitializedMedraFileGenerator.TFuel = T_FUEL_MEAN.Value.ToDouble()
            InitializedMedraFileGenerator.Ps1dot2_1 = Ps1dot2_1_MEAN.Value.ToDouble()
            InitializedMedraFileGenerator.Ps1dot2_2 = Ps1dot2_2_MEAN.Value.ToDouble()
            InitializedMedraFileGenerator.Ps1dot2_3 = Ps1dot2_3_MEAN.Value.ToDouble()
            InitializedMedraFileGenerator.Ps1dot2_4 = Ps1dot2_4_MEAN.Value.ToDouble()
            InitializedMedraFileGenerator.Ps1dot2_5 = Ps1dot2_5_MEAN.Value.ToDouble()
            InitializedMedraFileGenerator.Ps1dot2_6 = Ps1dot2_6_MEAN.Value.ToDouble()

            FillSmallEngineRunToMedra()
            FillBigEngineRunToMedra()

            InitializedMedraFileGenerator.AddRunToRepport()
        End Sub

