            _MappedProperties.Add(New Mapped("T11_3_6", 66, "Deg F", 1))
            _MappedProperties.Add(New Mapped("T11_4_1", 67, "Deg F", 1))
            _MappedProperties.Add(New Mapped("T11_4_2", 68, "Deg F", 1))
            _MappedProperties.Add(New Mapped("T11_4_3", 69, "Deg F", 1))
            _MappedProperties.Add(New Mapped("T11_4_4", 70, "Deg F", 1))
            _MappedProperties.Add(New Mapped("T11_4_5", 71, "Deg F", 1))
            _MappedProperties.Add(New Mapped("T11_4_6", 72, "Deg F", 1))

        End Sub

        Public Overrides Function CountDeletedParameters() As Integer
            Dim cpt = 0

            For Each item As BooleanItem In T1_DELETE
                If item.Value.ToString.ToUpper = "TRUE" Then cpt = cpt + 1
            Next
            For Each item As BooleanItem In T8_DELETE 'T7_DELETE and T8_DELETE are the same reference but for reflexion purpose we have both so we only substract one of them
                If item.Value.ToString.ToUpper = "TRUE" Then cpt = cpt + 1
            Next
            For Each item As BooleanItem In T11_DELETE
                If item.Value.ToString.ToUpper = "TRUE" Then cpt = cpt + 1
            Next

            For Each item As BooleanItem In Ps1dot2_DELETE
                If item.Value.ToString.ToUpper = "TRUE" Then cpt = cpt + 1
            Next
            For Each item As BooleanItem In P1dot2_DELETE
                If item.Value.ToString.ToUpper = "TRUE" Then cpt = cpt + 1
            Next
            For Each item As BooleanItem In P8_DELETE 'P7_DELETE and P8_DELETE are the same reference but for reflexion purpose we have both so we only substract one of them
                If item.Value.ToString.ToUpper = "TRUE" Then cpt = cpt + 1
            Next
            For Each item As BooleanItem In P11_DELETE
                If item.Value.ToString.ToUpper = "TRUE" Then cpt = cpt + 1
            Next

            Return cpt
        End Function

    End Class

