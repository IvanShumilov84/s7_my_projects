        '####################################################################
        '############################# HANDLERS #############################
        '####################################################################

        Private Sub OnTFERemarkTextValueChanged(sender As KineticaRT.Channels.IChannel, newVal As KineticaRT.Values.Value)
            Try

                Me.Comment = REMARK_TEXT.Value.ToString()

            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: Performance_Sequence: OnRemark_Text_ValueChanged()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.Message)
            End Try
        End Sub

        Private Sub OnSGSettingFactorValueChanged(sender As KineticaRT.Channels.IChannel, newVal As KineticaRT.Values.Value)
            If SGSETTINGFACTOR_VALUE Is Nothing Then Return
            Dim doubleSettingFactor As Double

            If Double.TryParse(SGSETTINGFACTOR_VALUE.Value.ToString(), doubleSettingFactor) Then
                If doubleSettingFactor > 11.0 Then
                    SGSETTINGFACTOR_VALUE.Value = New KineticaRT.Values.Double(11.0)
                ElseIf doubleSettingFactor < 0.0 Then
                    SGSETTINGFACTOR_VALUE.Value = New KineticaRT.Values.Double(0.0)
                Else
                    SGSETTINGFACTOR_VALUE.Value = New KineticaRT.Values.Double(Double.Parse((Math.Round(doubleSettingFactor * 2, 0) / 2).ToString()))
                End If
            End If
        End Sub

        Private Sub OnNozzleCodeValueChanged(sender As KineticaRT.Channels.IChannel, newVal As KineticaRT.Values.Value)
            If NOZZLECODE_VALUE Is Nothing Then Return
            Dim nozzleCode As Integer
            Dim doubleNozzleCode As Double

            If Integer.TryParse(NOZZLECODE_VALUE.Value.ToString(), nozzleCode) Then
                If nozzleCode = 0 Then
                    NozzleControlsEnabled(True)
                Else
                    NozzleControlsEnabled(False)
                End If
            ElseIf Double.TryParse(NOZZLECODE_VALUE.Value.ToString(), doubleNozzleCode) Then
                NOZZLECODE_VALUE.Value = New KineticaRT.Values.Integer(Integer.Parse(Math.Round(doubleNozzleCode, 0).ToString()))
            Else
                NozzleControlsEnabled(True)
            End If
        End Sub

