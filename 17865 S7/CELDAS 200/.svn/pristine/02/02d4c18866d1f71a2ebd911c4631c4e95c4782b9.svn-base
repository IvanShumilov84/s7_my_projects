    'THIS IS AN IMPORT OF CELDASHELPER FROM PROJET 18942 @ https://svn.cel-aerospace.ca/svn/repos/Project/08/08618 Vector/trunk/Prj08618_HMI_Performance/CELDASHELPER.vb
    ''' <summary>
    ''' This class represent every property that we must include in each run of the MEDRA log
    ''' </summary>
    Public Class Mapped

        Public Sub New(propertyName As String, masterRecordNumber As Integer, unitName As String, unitTypeId As Integer, Optional propertyDisplayName As String = "")
            Me.PropertyName = propertyName
            Me.MasterRecordNumber = masterRecordNumber
            Me.UnitName = unitName
            Me.UnitTypeId = unitTypeId

            If propertyDisplayName = "" Then
                propertyDisplayName = propertyName
            End If

            Me.PropertyDisplayName = propertyDisplayName
        End Sub

        Public Function GetPropertyValue(owner As Object) As Object
            Try
                Dim linkedProperty = owner.GetType().GetProperty(PropertyName, BindingFlags.Public Or BindingFlags.Instance)

                Return linkedProperty.GetValue(owner, Nothing)
            Catch ex As Exception
                MessageBox.Show("Couldn't load [" + PropertyName + "] from {" + owner.GetType().ToString() + "} class")
                Return 0
            End Try
        End Function

        Public ReadOnly PropertyName As String
        Public ReadOnly PropertyDisplayName As String
        Public ReadOnly UnitName As String
        Public ReadOnly UnitTypeId As Integer
        Public ReadOnly MasterRecordNumber As Integer

        Public Function IsDeleted(owner As Object) As Boolean

            Dim propertyNameSplitted = PropertyName.Split("_")
            If propertyNameSplitted.Length <> 2 And propertyNameSplitted.Length <> 3 Then Return False

            Dim deletedProperty = owner.GetType().GetProperty(propertyNameSplitted(0) + "_DELETE", BindingFlags.Public Or BindingFlags.Instance)
            If deletedProperty Is Nothing Then Return False

            Dim firstId = Integer.Parse(propertyNameSplitted(1)) - 1

            Try
                If propertyNameSplitted.Length = 2 Then
                    Dim propertyFound = TryCast(deletedProperty.GetValue(owner, Nothing), BooleanItem())
                    If propertyFound Is Nothing Then Return False

                    Return propertyFound(firstId).Value.ToString.ToUpper = "TRUE"
                ElseIf propertyNameSplitted.Length = 3 Then
                    Dim propertyFound = TryCast(deletedProperty.GetValue(owner, Nothing), BooleanItem(,))
                    If propertyFound Is Nothing Then Return False

                    Dim secondId = Integer.Parse(propertyNameSplitted(2)) - 1

                    Return propertyFound(firstId, secondId).Value.ToString.ToUpper = "TRUE"
                End If

            Catch ex As Exception
                MessageBox.Show("Couldn't load [" + PropertyName + "] from {" + owner.GetType().ToString() + "} class")
            End Try

            Return False
        End Function

    End Class

