        Private Sub InitializeTFEChannels(ByRef return_Value As ArrayList)

            Dim selectedEngine = Test_Mgr_UUT_Model.Value.ToString()
            Dim engine = Engines.GetEngineFromDisplayName(selectedEngine)
            Dim engineCategory = Engines.GetEngineCategory(engine)
            If engineCategory <> Category.Small AndAlso engineCategory <> Category.Big Then Return

            Dim screenReference As KineticaRT.Studio.Window

            Dim i As Integer

            'Inputs
            return_Value.Add(Initialize_Channel(REMARK_TEXT, "Remark"))
            return_Value.Add(Initialize_Channel(SGSETTINGFACTOR_VALUE, "SGSETTINGFACTOR_VALUE"))
            return_Value.Add(Initialize_Channel(THRUSTCORRECTIONFACTOR_VALUE, "THRUSTCORRECTIONFACTOR_VALUE"))
            return_Value.Add(Initialize_Channel(T_DRY_BULB, "T_DRY_BULB"))
            return_Value.Add(Initialize_Channel(RELATIVE_HUMIDITY, "RELATIVE_HUMIDITY"))
            return_Value.Add(Initialize_Channel(NOZZLECODE_VALUE, "NOZZLECODE_VALUE"))
            return_Value.Add(Initialize_Channel(ENGINELOCATION_VALUE, "ENGINELOCATION_VALUE"))
            return_Value.Add(Initialize_Channel(HIGHPRESSURETURBINENOZZLEAREA_VALUE, "HIGHPRESSURETURBINENOZZLEAREA_VALUE"))
            return_Value.Add(Initialize_Channel(LOWPRESSURETURBINENOZZLEAREA_VALUE, "LOWPRESSURETURBINENOZZLEAREA_VALUE"))
            return_Value.Add(Initialize_Channel(LOADREPORTNUMBER_VALUE, "LOADREPORTNUMBER_VALUE"))
            return_Value.Add(Initialize_Channel(INITIALIZEREPORTNUMBER_VALUE, "INITIALIZEREPORTNUMBER_VALUE"))
            return_Value.Add(Initialize_Channel(ISUSINGMIXERNOZZLE, "ISUSINGMIXERNOZZLE"))
            return_Value.Add(Initialize_Channel(SAMPLE_MODE, "SAMPLE_MODE"))

            Throw New NotImplementedException("Uncomment all this if you need to use MEDRA")
            'Uncomment all this if you need to use MEDRA
            '-------------------------------------------
            'Dim mainScreenName As String = EngineScreensService.GetMainScreen(Test_Mgr_UUT_Model.ToString())
            'return_Value.Add(Initialize_Object(screenReference, mainScreenName))

            AircraftModel_List = GetRecursive(screenReference.Controls.Item(0).Controls.Item(0).Controls.Item(1), "cboAircraftModelList", GetType(ComboBox))
            AircraftModel_List.SelectedIndex = -1
            AircraftModel_List.Text = ""
            'TODO MEDRA FILL WITH ENGINES the AircraftModel_List
            AircraftModel_List.Items.Clear()
            AircraftModel_List.Items.Add("Falcon 10/100")
            AircraftModel_List.Items.Add("Lear 35/36")
            AircraftModel_List.Items.Add("CASA, C101XE/EB")
            AircraftModel_List.Items.Add("ROC, IA-63")
            AircraftModel_List.Items.Add("Lear M31")
            AircraftModel_List.SelectedIndex = 0

            'Outputs

            return_Value.Add(Initialize_Channel(N1_RPM_MEAN, "N1_RPM_MEAN"))
            return_Value.Add(Initialize_Channel(N2_RPM_MEAN, "N2_RPM_MEAN"))
            return_Value.Add(Initialize_Channel(THRUST_MEAN, "THRUST_MEAN"))
            '
            return_Value.Add(Initialize_Channel(PBAR_MEAN, "PBAR_MEAN"))
            return_Value.Add(Initialize_Channel(WF_MEAN, "WF_MEAN"))
            return_Value.Add(Initialize_Channel(SG_60F, "SG_60F"))
            return_Value.Add(Initialize_Channel(T_FUEL_MEAN, "T_FUEL_MEAN"))


            REMARK_TEXT.Value = KineticaRT.Values.Values.EmptyString
            SGSETTINGFACTOR_VALUE.Value = KineticaRT.Values.Values.Zero
            NOZZLECODE_VALUE.Value = KineticaRT.Values.Values.Zero
            ENGINELOCATION_VALUE.Value = KineticaRT.Values.Values.Zero
            HIGHPRESSURETURBINENOZZLEAREA_VALUE.Value = KineticaRT.Values.Values.Zero
            LOWPRESSURETURBINENOZZLEAREA_VALUE.Value = KineticaRT.Values.Values.Zero
            LOADREPORTNUMBER_VALUE.Value = KineticaRT.Values.Values.Zero
            INITIALIZEREPORTNUMBER_VALUE.Value = KineticaRT.Values.Values.Zero
            ISUSINGMIXERNOZZLE.Value = KineticaRT.Values.Values.False
            SAMPLE_MODE.Value = KineticaRT.Values.Values.False

            If engine = engine.TFE731601C Then
                THRUSTCORRECTIONFACTOR_VALUE.Value = New KineticaRT.Values.Double(1.01)
            Else
                THRUSTCORRECTIONFACTOR_VALUE.Value = New KineticaRT.Values.Double(1.014)
            End If

            If engineCategory = Category.Small Then
                OPC_Ps1dot2_DELETE = New KineticaRT.Servers.OpcClient.BooleanItem(5) {}
            Else
                OPC_Ps1dot2_DELETE = New KineticaRT.Servers.OpcClient.BooleanItem(7) {}
            End If

            return_Value.Add(Initialize_Channel(Ps1dot2_1_MEAN, "PS1DOT2_1_MEAN"))
            return_Value.Add(Initialize_Channel(Ps1dot2_2_MEAN, "PS1DOT2_2_MEAN"))
            return_Value.Add(Initialize_Channel(Ps1dot2_3_MEAN, "PS1DOT2_3_MEAN"))
            return_Value.Add(Initialize_Channel(Ps1dot2_4_MEAN, "PS1DOT2_4_MEAN"))
            return_Value.Add(Initialize_Channel(Ps1dot2_5_MEAN, "PS1DOT2_5_MEAN"))
            return_Value.Add(Initialize_Channel(Ps1dot2_6_MEAN, "PS1DOT2_6_MEAN"))
            For i = 0 To OPC_Ps1dot2_DELETE.GetUpperBound(0)
                return_Value.Add(Initialize_Channel(OPC_Ps1dot2_DELETE(i), "OPC_PS1DOT2_" + (i + 1).ToString() + "_DELETE"))
            Next

            InitializeTFESmallEngineChannels(return_Value, engineCategory)
            InitializeTFEBigEngineChannels(return_Value, engineCategory)

        End Sub

