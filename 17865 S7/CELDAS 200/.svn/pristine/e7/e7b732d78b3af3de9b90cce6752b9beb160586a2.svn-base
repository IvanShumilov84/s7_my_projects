        Private Sub OnSetMot(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsTrue(newVal) Then
                    CELProject.ActivateForm("SetMot_PT6T_Screen", "PT6T_Master_Screen", True, False)
                Else
                    CELProject.ActivateForm("SetMot_PT6T_Screen", "PT6T_Master_Screen", False, False)
                End If
            Catch ex As Exception
                MessageBox.Show("PT6T_Sequence: OnSetMot: " & ex.ToString, "Error", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
            End Try
        End Sub

        Private Sub OnACCEL_CHECK_OPEN_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value) Implements IAccelCheckScreen.OnACCEL_CHECK_OPEN_WINDOW_BTN

            If CELProject.IsTrue(newVal) Then
                CELProject.ActivateForm("PT6T_AccelCheck_Screen", CELProject.DefaultParentWindow, True, False)

                If sender.Name.ToUpper() = "ACCEL_CHECK_OPEN_WINDOW_P_BTN" Then
                    SHP_HP.Value = SHP_P_HP.Value
                    ACCEL_CHECK_P_SIDE.Value = Values.True
                End If

                If sender.Name.ToUpper() = "ACCEL_CHECK_OPEN_WINDOW_S_BTN" Then
                    SHP_HP.Value = SHP_S_HP.Value
                    ACCEL_CHECK_S_SIDE.Value = Values.True
                End If

                'Reset Button
                ACCEL_CHECK_OPEN_WINDOW_S_BTN.Value = Values.False
            End If
        End Sub

        Private Sub OnACCEL_CHECK_CLOSE_WINDOW_BTN(ByVal sender As IChannel, ByVal newVal As Value) Implements IAccelCheckScreen.OnACCEL_CHECK_CLOSE_WINDOW_BTN

            If CELProject.IsTrue(newVal) Then
                CELProject.ActivateForm("PT6T_AccelCheck_Screen", CELProject.DefaultParentWindow, False, False)
                'Reset Button
                ACCEL_CHECK_CLOSE_WINDOW_BTN.Value = Values.False

                ACCEL_CHECK_S_SIDE.Value = Values.False
                ACCEL_CHECK_P_SIDE.Value = Values.False
            End If
        End Sub

        Private Sub OnTORQUE_TRIM_PANEL_OPEN_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsTrue(newVal) Then
                CELProject.ActivateForm("PT6A_68_Torque_Trim_Screen", CELProject.DefaultParentWindow, True, False)
                'Reset Button
                TORQUE_TRIM_PANEL_OPEN_BTN.Value = Values.False
            End If
        End Sub

        Private Sub OnTORQUE_TRIM_PANEL_CLOSE_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            If CELProject.IsTrue(newVal) Then
                CELProject.ActivateForm("PT6A_68_Torque_Trim_Screen", CELProject.DefaultParentWindow, False, False)
                'Reset Button
                TORQUE_TRIM_PANEL_CLOSE_BTN.Value = Values.False
            End If
        End Sub

        Private Sub OnPERF_CLEAR_TORQUE_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            If CELProject.IsTrue(newVal) Then
                Dim confirmation As Integer = MessageBox.Show("Are you sure you want to clear the currently recorded values?",
                                                              "PT6T Torque Trim",
                                                              MessageBoxButtons.YesNo)
                If confirmation = DialogResult.Yes Then
                    For i As Integer = 0 To (MaxNumberOfTorqueTrimPoints - 1)
                        PERF_Q_ENG(i).Value = New KineticaRT.Values.Double(0.0)
                        PERF_TQCOMPEN(i).Value = New KineticaRT.Values.Double(0.0)
                    Next
                Else
                    sender.Value = Values.False
                    Exit Sub
                End If
                sender.Value = Values.False
            End If
        End Sub

