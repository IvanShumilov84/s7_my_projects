        Private TORQUE_TRIM_PANEL_OPEN_BTN As IBooleanChannel
        Private TORQUE_TRIM_PANEL_CLOSE_BTN As IBooleanChannel
        Private ARCHIVE_RECORD_BTN As IBooleanChannel
        Private ARCHIVE_STOP_BTN As IBooleanChannel

        Private ENGINE_AT_REST_S As IBooleanChannel
        Private ENGINE_AT_REST_P As IBooleanChannel
        Private ENGINE_AT_REST As IBooleanChannel

        Private CRANK_BTN_PRESSED As IBooleanChannel
        Private CRANK_P_BTN_PRESSED As IBooleanChannel

        Private CRANK_S_BTN As IBooleanChannel
        Private CRANK_P_BTN As IBooleanChannel

        Private CRANK_START_DEMAND_OPC As IBooleanChannel
        Private CRANK_START_DEMAND_PORT_OPC As IBooleanChannel

