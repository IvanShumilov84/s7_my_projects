                'preset.YAxisSourceChannels.Add("NG_CORR_RPM_SCALE")

                'Y2 Axi(e)s is/are on the right
                If EngineModel = "PT6A-6" OrElse EngineModel = "PT6A-6A" OrElse EngineModel = "PT6A-6B" Then
                    'preset.Y2AxisSourceChannels.Add("T_T4_CORR_DEGF")
                Else
                    'preset.Y2AxisSourceChannels.Add("T_T5_CORR_DEGF_SCALE")
                End If

                'TransientControl.Presets.Add(preset)

                If EngineModel = "PT6A-67F" Then
                    'Graph B - T5A, T5D, SHP
                    'preset = New CEL.KineticaRT.Controls.ZedGraphControl.GraphPresetItem()

                    'XY type graph i.e. Parameter on X Axis vs another parameter(s) on Y Axis
                    'preset.Name = "T5A/Theta, T5D/Theta  vs Corrected SHP"
                    'preset.XAxisSourceChannel = "SHP_CORR_HP_SCALE"

                    'Y Axi(e)s is/are of the left
