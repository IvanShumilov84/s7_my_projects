                        '    Return_Value.Add(MyBase.InitializeChannel(PERF_EMSE_CIVV, "PERF_EMSE_CIVV"))

                    Case Else
                End Select

                If Return_Value.Contains(False) Then
                    Init_Engine_Channels = False
                Else
                    Init_Engine_Channels = True
                End If

            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: Engine_Sequence: Init_Engine_Channels()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.ToString())
            End Try
        End Function


        '********************************
        '* Init_Engine_Channels_Value() *
        '********************************
        Private Sub Init_Engine_Channels_Value()
            Try
                'Dim i As Integer

                'If Test_Mgr_UUT_Model.Value.ToString() <> "DAS CALIBRATION" Then
                '    If Not (PLAY_BUTTON Is Nothing) Then
                '        PLAY_BUTTON.Value = KineticaRT.Values.Values.False
                '    End If
                'End If

                Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()
                    Case "ATAR 09C"
                        PHASES_NB.Value = New KineticaRT.Values.Text("")
                        POINTS_NB.Value = New KineticaRT.Values.Text("")
                        OPERATIONS_NB.Value = New KineticaRT.Values.Text("")
                        ViewPerfReport.Value = KineticaRT.Values.Values.False
                        PrintPerfReport.Value = KineticaRT.Values.Values.False
                        ViewLogBook.Value = KineticaRT.Values.Values.False
                        PrintLogBook.Value = KineticaRT.Values.Values.False
                        MAXAB_DONE.Value = KineticaRT.Values.Values.False
                        MSPC_DONE.Value = KineticaRT.Values.Values.False
                        K.Value = New KineticaRT.Values.Double(1.0)

                        'Case "F100 PW200"
                        '    'PERF_OPEN_WINDOW_BTN.Value = KineticaRT.Values.Values.False
                        '    PERF_CLOSE_WINDOW_BTN.Value = KineticaRT.Values.Values.False
                        '    PERF_TAKE_POINT_BTN.Value = KineticaRT.Values.Values.False
                        '    TestStep_List.SelectedIndex = 0 'Begin at Step A.3
                        '    TEST_STEP_NB.Value = New KineticaRT.Values.Integer(0) 'Begin at Step A.3
                        '    PHASES_NB.Value = New KineticaRT.Values.Text("A")
                        '    POINTS_NB.Value = New KineticaRT.Values.Text("3")
                        '    OPERATIONS_NB.Value = New KineticaRT.Values.Text("")
                End Select

                Me.Comment = ""

            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: Engine_Sequence: Init_Engine_Channels_Value()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.ToString())
            End Try
        End Sub
        '********************************
        '* Initialize_Engine_Controls() *
        '********************************
        Private Sub Initialize_Engine_Controls()

            Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()

                Case "ATAR_09C"
                    AtarPhase_List.SelectedIndex = -1
            End Select
        End Sub

