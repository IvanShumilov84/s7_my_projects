        '********************************************************************
        '* Public Methods ***************************************************
        '********************************************************************

        '***********
        '* Connect *
        '***********
        Public Overloads Overrides Sub Connect()
            Try
                If Me.Connected = False Then
                    MyBase.Connect()

                    'PROJECT_NUMBER = System.Configuration.ConfigurationSettings.AppSettings("ProjectNo")

                    'Select Case PROJECT_NUMBER
                    '    Case "04217"
                    '        WINDOW_NAME = Split("Welcome_Screen;ATAR 09C_Screen", ";")

                    '    Case "04218"
                    '        WINDOW_NAME = Split("Welcome_Screen;ATAR 09C_Screen;F100 PW200_Screen;F100_Performance_Screen;F100_Performance_Screen_A15;F100_Performance_Screen_B2;F100_Performance_Screen_B6;F100_Performance_Screen_B8", ";")
                    'End Select


                    'Verify the connection to the channels
                    If Init_Channels() = False Then
                        MessageBox.Show("ENGINE SEQUENCE: Connect() - missing channels")
                        Return
                    End If

                    PROJECT_NB.Value = New KineticaRT.Values.Text(CELProject.Project.Number)

                    AddHandler CELProject.Test_Mgr_Status.ValueChanged, AddressOf OnTest_Mgr_Status

                    Me.Connected = True
                End If

            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: Engine_Sequence: Connect()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.ToString())
            End Try
        End Sub

        '**************
        '* Disconnect *
        '**************
        Public Overloads Overrides Sub Disconnect()
            Try
                If Me.Connected Then
                    RemoveHandler CELProject.Test_Mgr_Status.ValueChanged, AddressOf OnTest_Mgr_Status

                    MyBase.Disconnect()
                    Me.Connected = False
                End If
            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: Engine_Sequence: Disconnect()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.ToString())
            End Try
        End Sub

