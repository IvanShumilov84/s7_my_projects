        '***************
        '* DoLogging() *
        '***************
        Private Sub DoLogging(ByVal isPerfEntry As Boolean)
            'Variable Declaration
            Dim AppendOption As Boolean
            Dim CurrentSheet As String
            Dim Dirs As String()
            Dim xl As New Excel.Application()
            Dim ExcelSheets As Excel.Sheets
            Dim ExcelWorkbook As Excel.Workbook = Nothing
            Dim ExcelWorksheet As Excel.Worksheet
            'Dim Exist As Boolean
            Dim Filename As String
            Dim NewFilename As String
            Dim Result As DialogResult
            Dim SearchPath As String
            Dim WorkbookPath As String

            Try

                xl.DisplayAlerts = False
                xl.Visible = False

                SearchPath = "C:\" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(1).Value.ToString() + "\Log\"
                Dirs = Directory.GetFiles(SearchPath, "Log Report*")

                Array.Sort(Dirs)

                If Dirs.GetUpperBound(0) = -1 Then
                    Result = DialogResult.No
                Else
                    Result = MessageBox.Show("Add Log Report to Last File?", "Log Report", MessageBoxButtons.YesNo)
                End If

                If (Result = DialogResult.Yes) Then
                    Filename = Dirs(Dirs.GetUpperBound(0))

                    'The following code opens an existing workbook
                    WorkbookPath = System.IO.Path.GetFullPath(Filename)

                    Try
                        ExcelWorkbook = xl.Workbooks.Open(WorkbookPath, 0, False, 5, "", "", False, _
                                  Excel.XlPlatform.xlWindows, "", True, False, 0, True, False, False)
                    Catch exception As System.Exception
                        System.Diagnostics.Trace.WriteLine("Opening Excel: " + exception.Message)
                        MessageBox.Show(exception.Message)
                    End Try

                    If (Not ExcelWorkbook Is Nothing) Then
                        'The following gets the Worksheets collection
                        ExcelSheets = ExcelWorkbook.Worksheets

                        CurrentSheet = "Sheet1"
                        ExcelWorksheet = ExcelSheets.Item(CurrentSheet)

                        AppendOption = True
                        ExcelWorkbook.Worksheets(1).UnProtect(CELProject.Project.PerformanceReportsCellProtection.ToString)
                        UpdateLogFile(AppendOption, ExcelWorksheet, isPerfEntry)
                        If Not isPerfEntry Then
                            PrintReport(ExcelWorksheet)
                        End If
                        ExcelWorkbook.Worksheets(1).Protect(CELProject.Project.PerformanceReportsCellProtection.ToString)

                        ExcelWorkbook.Save()
                        ExcelWorkbook.Close()

                        MessageBox.Show("ATAR 09C Log report was updated successfully" & vbCrLf & vbCrLf & "You can find it at:" & vbCrLf & WorkbookPath, "Report Generation Status", MessageBoxButtons.OK)
                    End If
                Else
                    If (Not (isPerfEntry)) Then
                        Result = MessageBox.Show("Create a new full log report?", "Log Report", MessageBoxButtons.YesNo)
                    Else
                        Result = DialogResult.Yes
                    End If

                    If (isPerfEntry Or (Result = DialogResult.Yes)) Then
                        Filename = "C:\My Projects\KineticaRT\Prj" + CELProject.Project.Number + "_HMI_Performance\PrjExt\Log_Report.xlsx"

                        'The following code opens an existing workbook
                        WorkbookPath = System.IO.Path.GetFullPath(Filename)

                        Try
                            ExcelWorkbook = xl.Workbooks.Open(WorkbookPath, 0, False, 5, "", "", False, _
                            Excel.XlPlatform.xlWindows, "", True, False, 0, True, False, False)
                        Catch exception As System.Exception
                            System.Diagnostics.Trace.WriteLine("Opening Excel: " + exception.Message)
                            MessageBox.Show(exception.Message)
                        End Try

                        If (Not ExcelWorkbook Is Nothing) Then
                            'The following gets the Worksheets collection
                            ExcelSheets = ExcelWorkbook.Worksheets

                            CurrentSheet = "Sheet1"
                            ExcelWorksheet = ExcelSheets.Item(CurrentSheet)

                            AppendOption = False
                            ExcelWorkbook.Worksheets(1).Unprotect(CELProject.Project.PerformanceReportsCellProtection.ToString)
                            UpdateLogFile(AppendOption, ExcelWorksheet, isPerfEntry)

                            If Not isPerfEntry Then
                                PrintReport(ExcelWorksheet)
                            End If

                            ExcelWorkbook.Worksheets(1).Protect(CELProject.Project.PerformanceReportsCellProtection.ToString)

                            NewFilename = "Log Report " + Format(Now, "yyyy-MM-dd HH'h'mm'm'ss's'")
                            Filename = Log_FolderName + NewFilename + ".xlsx"

                            ExcelWorkbook.SaveAs(Filename)
                            ExcelWorkbook.Close()

                            MessageBox.Show("ATAR 09C Log report was created successfully" & vbCrLf & vbCrLf & "You can find it at:" & vbCrLf & Filename, "Report Generation Status", MessageBoxButtons.OK)
                        End If
                    End If
                End If

            Catch exception As System.Exception
                System.Diagnostics.Trace.WriteLine("Opening Excel: " + exception.Message)
                MessageBox.Show(exception.Message)
            Finally
                CloseExcelApplication(xl)
            End Try
        End Sub

        '***************
        '* DoPerfEntry() *
        '***************
        Private Sub DoPerfEntry(ByVal TestStepNb As Integer)
            Try
                'Variable Declaration
                Dim AppendOption As Boolean
                'Dim CurrentSheet As String
                Dim xl As New Excel.Application()
                'Dim ExcelSheets As Excel.Sheets
                Dim ExcelWorkbook As Excel.Workbook = Nothing
                'Dim ExcelWorksheet As Excel.Worksheet
                Dim Exist As Boolean
                Dim Filename As String
                Dim NewFilename As String
                Dim SearchPath As String
                Dim WorkbookPath As String
                Dim Dirs As String()
                Dim Result As DialogResult


                'The following code opens an existing workbook
                'Get the latest Perf report
                SearchPath = "C:\" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(1).Value.ToString() + "\Perf\"
                Dirs = Directory.GetFiles(SearchPath, "*.xlsx")
                Array.Sort(Dirs)

                If Dirs.GetUpperBound(0) = -1 Then
                    Result = DialogResult.No
                    '				Else
                    '					Result = MessageBox.Show ("Append Report to Last File?","Performance Report",MessageBoxButtons.YesNoCancel,MessageBoxIcon.Question)
                End If

                If Dirs.Length > 0 Then
                    Filename = Dirs(Dirs.GetUpperBound(0))
                    AppendOption = True
                Else
                    WorkbookPath = System.IO.Path.GetFullPath("C:\My Projects\KineticaRT\Prj" + CELProject.Project.Number + "_HMI_Performance\PrjExt\" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + " Performance.xlsx")
                    NewFilename = "" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + " Performance " + Format(Now, "yyyy-MM-dd HH'h'mm'm'ss's'") + ".xlsx"
                    Filename = "C:\" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(1).Value.ToString() + "\Perf\" + NewFilename
                    File.Copy(WorkbookPath, Filename)
                    AppendOption = False
                End If

                'Check if the file exist, if not create one 
                Exist = File.Exists(Filename)

                If Exist = False And Result <> DialogResult.Cancel Then
                    'If the user want to append, force the creation of a new file
                    Result = DialogResult.No
                End If


                WorkbookPath = System.IO.Path.GetFullPath(Filename)

                Try
                    ExcelWorkbook = xl.Workbooks.Open(WorkbookPath, 0, False, 5, "", "", False, _
                    Excel.XlPlatform.xlWindows, "", True, False, 0, True, False, False)
                Catch exception As System.Exception
                    System.Diagnostics.Trace.WriteLine("Opening Excel: " + exception.Message)
                    MessageBox.Show(exception.Message)
                End Try

                If (Not ExcelWorkbook Is Nothing) Then

                    CreatePerformanceFile(AppendOption, TestStepNb, ExcelWorkbook)

                    ExcelWorkbook.Save()
                    ExcelWorkbook.Close()
                    CloseExcelApplication(xl)

                    If AppendOption Then
                        MessageBox.Show("ATAR 09C Performance report was updated successfully" & vbCrLf & vbCrLf & "You can find it at:" & vbCrLf & Filename, "Report Generation Status", MessageBoxButtons.OK)
                    Else
                        MessageBox.Show("ATAR 09C Performance report was created successfully" & vbCrLf & vbCrLf & "You can find it at:" & vbCrLf & Filename, "Report Generation Status", MessageBoxButtons.OK)
                    End If
                Else
                    MessageBox.Show("ATAR 09C Performance NOT CREATED")
                End If

            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: Engine_Sequence: DoPerfEntry()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.ToString())
            End Try
        End Sub

