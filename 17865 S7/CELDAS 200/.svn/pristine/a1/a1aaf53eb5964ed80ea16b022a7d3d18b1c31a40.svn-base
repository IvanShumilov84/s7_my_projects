        '***********************
        '* OnTest_Mgr_Status() *
        '***********************
        Private Sub OnTest_Mgr_Status(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                'Dim i As Integer

                SyncLock Me
                    Select Case newVal.ToString()
                        Case CELDAS.eTest_Mgr_Status.Initialized
                            Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()
                                Case "ATAR 09C"
                                    'Change the Culture Info  BUG with Thread Excel Application
#If EXCEL_CULTUREINFO_ISSUE Then
                                    System.Threading.Thread.CurrentThread.CurrentCulture = New System.Globalization.CultureInfo("en-US")
#End If
                                    CreateLogFile()

                                    'Set The Connection (Global scope)
                                    If Not DatabaseHelper.OpenConnection(CELProject.Database.OleDbConnectionString, cnMain, True) Then
                                        'Close Test if unable to open connection to database
                                        CELProject.Test_Mgr_Cmd.Value = New KineticaRT.Values.Text(CELDAS.eTest_Mgr_Cmd.Close)
                                    End If
                            End Select


                        Case CELDAS.eTest_Mgr_Status.Running


                            Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()
                                Case "ATAR 09C"
                                    Init_Engine_Channels()

                                    Init_Engine_Channels_Value()

                                    If CELProject.Test_Mgr_UUT_Model.Value.ToString() <> "DAS CALIBRATION" Then
                                        'AddHandler ARCHIVE_RECORD.ValueChanged, AddressOf OnArchive
                                        'AddHandler ARCHIVE_STOP_BTN.ValueChanged, AddressOf OnArchive
                                        'AddHandler PLAY_BUTTON.ValueChanged, AddressOf OnArchive
                                        AddHandler Log_Button.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
                                        AddHandler PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN
                                        AddHandler PrintPerfReport.ValueChanged, AddressOf OnViewReport
                                        AddHandler ViewPerfReport.ValueChanged, AddressOf OnViewReport
                                        AddHandler PrintLogBook.ValueChanged, AddressOf OnViewReport
                                        AddHandler ViewLogBook.ValueChanged, AddressOf OnViewReport
                                    End If

                                    C_Average = New RollingAverage(Alpha, Me.C, Me.C_PERF)
                                    CPC_Average = New RollingAverage(Alpha, Me.CPC, Me.CPC_PERF)
                                    F_Read_Average = New RollingAverage(Alpha, Me.F_READ, Me.F_READ_PERF)
                                    VOP_Average = New RollingAverage(Alpha, Me.VOP, Me.VOP_PERF)

                                    Me.PerformanceWorkerThread = New System.Threading.Thread(AddressOf Me.PerformanceWorkerThreadSub)
                                    Me.PerformanceWorkerThread.Priority = ThreadPriority.Normal
                                    Me.PerformanceWorkerThread.Name = "PerformanceWorkerThread"
                                    Me.PerformanceWorkerThread.Start()

                                    AddHandler AtarPhase_List.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged

                                Case "F100 PW200"
                                    AddHandler TestStep_List.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged
                                    'AddHandler OpenPerfReport,								AddressOf OnOpenPerfReport
                                    AddHandler PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN

                            End Select

                        Case CELDAS.eTest_Mgr_Status.Closing, CELDAS.eTest_Mgr_Status.Closed
                            If CELProject.Test_Mgr_UUT_Model.Value.ToString() <> "DAS CALIBRATION" Then
                                'If Not ARCHIVE_RECORD Is Nothing Then
                                '    RemoveHandler ARCHIVE_RECORD.ValueChanged, AddressOf OnArchive
                                'End If
                                'If Not ARCHIVE_STOP_BTN Is Nothing Then
                                '    RemoveHandler ARCHIVE_STOP_BTN.ValueChanged, AddressOf OnArchive
                                'End If
                                'If Not PLAY_BUTTON Is Nothing Then
                                '    RemoveHandler PLAY_BUTTON.ValueChanged, AddressOf OnArchive
                                'End If
                                If Not Log_Button Is Nothing Then
                                    RemoveHandler Log_Button.ValueChanged, AddressOf OnLOG_TAKE_POINT_BTN
                                End If
                                If Not PrintPerfReport Is Nothing Then
                                    RemoveHandler PrintPerfReport.ValueChanged, AddressOf OnViewReport
                                End If
                                If Not ViewPerfReport Is Nothing Then
                                    RemoveHandler ViewPerfReport.ValueChanged, AddressOf OnViewReport
                                End If
                                If Not PrintLogBook Is Nothing Then
                                    RemoveHandler PrintLogBook.ValueChanged, AddressOf OnViewReport
                                End If
                                If Not ViewLogBook Is Nothing Then
                                    RemoveHandler ViewLogBook.ValueChanged, AddressOf OnViewReport
                                End If
                                If Not PERF_TAKE_POINT_BTN Is Nothing Then
                                    RemoveHandler PERF_TAKE_POINT_BTN.ValueChanged, AddressOf OnPERF_TAKE_POINT_BTN
                                End If
                            End If

                            Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()
                                Case "ATAR 09C"
                                    If Not AtarPhase_List Is Nothing Then
                                        RemoveHandler AtarPhase_List.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged
                                    End If

                                    If Not (Me.PerformanceWorkerThread Is Nothing) Then
                                        'Kill the Performance Worker Thread if still alive
                                        If Me.PerformanceWorkerThread.IsAlive Then
                                            Me.PerformanceWorkerThread.Abort()
                                            Me.PerformanceWorkerThread.Join()
                                            Me.PerformanceWorkerThread = Nothing
                                        End If
                                    End If

                                    'Case "F100 PW200"
                                    '    If Not TestStep_List Is Nothing Then
                                    '        RemoveHandler TestStep_List.SelectedIndexChanged, AddressOf OnTestStep_List_SelectedIndexChanged
                                    '    End If
                                    '    'If Not OpenPerfReport Is Nothing Then
                                    '    '	RemoveHandler OpenPerfReport,				AddressOf OnOpenPerfReport
                                    '    'End If
                                    '    If Not PERF_CLOSE_WINDOW_BTN Is Nothing Then
                                    '        RemoveHandler PERF_CLOSE_WINDOW_BTN.ValueChanged, AddressOf OnPERF_CLOSE_WINDOW_BTN
                                    '    End If
                            End Select

                            DatabaseHelper.CloseConnection(cnMain)

                            'Restore default Culture Info
                            System.Threading.Thread.CurrentThread.CurrentCulture = OldCultureInfo
                    End Select
                End SyncLock

            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: Engine_Sequence: OnTest_Mgr_Status()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.ToString())
            End Try
        End Sub

