                                excelWorksheet = excelSheets.Item(currentSheet)

                                excelWorksheet.Cells(14, 4).Value = Format(System.Convert.ToDouble(FINA.ToString()), "0.0")
                                excelWorksheet.Cells(14, 6).Value = Format(System.Convert.ToDouble(N.ToString()), "0.0")
                                excelWorksheet.Cells(14, 9).Value = Format(System.Convert.ToDouble(T4_AVG.ToString()), "0.0")
                                excelWorksheet.Cells(14, 11).Value = Format(System.Convert.ToDouble(CSINA.ToString()), "0.000")

                                '								'Select log file value for C - 40 / ?P
                                '								If Test_Mgr_UUT_Option(0).ToString() = "True" Then
