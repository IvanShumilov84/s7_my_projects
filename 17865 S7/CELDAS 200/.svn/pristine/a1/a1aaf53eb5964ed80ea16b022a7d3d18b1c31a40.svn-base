                                excelWorksheet.Cells(18, 11).Value = Format(System.Convert.ToDouble(CSINA.ToString()), "0.000")


                        End Select
                    Catch ex As Exception
                        System.Diagnostics.Trace.WriteLine("CreatePerformanceFile: " + Ex.ToString())
                        MessageBox.Show(ex.ToString)
                        CreatePerformanceFile = False
                    Finally
                        'Lock Sheets
                        excelWorkbook.Worksheets(1).Protect(CELProject.Project.PerformanceReportsCellProtection.ToString)
