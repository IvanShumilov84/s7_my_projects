        Class RollingAverage

            Private _alpha As Double
            Private _beta As Double
            Private _value As Double = 0.0
            Private _source As KineticaRT.Channels.IChannel
            Private _destination As KineticaRT.Channels.IChannel

            Public Sub New(ByVal alpha As Double, ByVal sourceChannel As KineticaRT.Channels.IChannel, ByVal destinationChannel As KineticaRT.Channels.IChannel)

                Me._alpha = alpha
                Me._beta = 1.0 - Me._alpha
                Me._source = sourceChannel
                Me._destination = destinationChannel

                Me._destination.Value = New KineticaRT.Values.Double(Me._value)
            End Sub

            Public Sub Update()

                Dim newVal As Double = Me._source.Value.ToDouble()

                Me._value = (Me._alpha * newVal) + (Me._beta * Me._value)

                Me._destination.Value = New KineticaRT.Values.Double(Me._value)
            End Sub
        End Class
    End Class


End Namespace
