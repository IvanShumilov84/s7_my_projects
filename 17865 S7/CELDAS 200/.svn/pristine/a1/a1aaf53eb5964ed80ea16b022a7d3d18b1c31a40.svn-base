        '*********************
        '* OnLOG_TAKE_POINT_BTN()    *
        '*********************
        Private Sub OnLOG_TAKE_POINT_BTN(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                If (CELProject.IsTrue(newVal)) Then
                    DoLogging(False)

                    Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()

                        Case "ATAR 09C"
                            Select Case PHASES_NB.Value.ToString()
                                Case "14"
                                    If POINTS_NB.Value.ToString() = "2" Then
                                        MSPC_DONE.Value = KineticaRT.Values.Values.True
                                        DoPerfEntry(eTestPhasesATAR_09C.Phase14_2_Max_point_without_AB)
                                    End If
                                Case "21"
                                    Select Case OPERATIONS_NB.Value.ToString()
                                        Case "2"
                                            DoPerfEntry(eTestPhasesATAR_09C.Phase21_Check_of_gun_and_missile_solenoid_v_op2)
                                        Case "3"
                                            DoPerfEntry(eTestPhasesATAR_09C.Phase21_Check_of_gun_and_missile_solenoid_v_op3)
                                        Case "5"
                                            DoPerfEntry(eTestPhasesATAR_09C.Phase21_Check_of_gun_and_missile_solenoid_v_op5)
                                    End Select
                                Case "28"
                                    If POINTS_NB.Value.ToString() = "3" Then
                                        DoPerfEntry(eTestPhasesATAR_09C.Phase28_3_Idle_point)
                                    End If
                                Case "31"
                                    Select Case OPERATIONS_NB.Value.ToString()
                                        Case "1"
                                            DoPerfEntry(eTestPhasesATAR_09C.Phase31_Check_AB_Igni_normal_mode_op1)
                                        Case "4"
                                            DoPerfEntry(eTestPhasesATAR_09C.Phase31_Check_AB_Igni_normal_mode_op4)
                                    End Select
                                Case "32"
                                    If POINTS_NB.Value.ToString() = "4" And OPERATIONS_NB.Value.ToString() = "2" Then
                                        MAXAB_DONE.Value = KineticaRT.Values.Values.True
                                        DoPerfEntry(eTestPhasesATAR_09C.Phase32_4_Max_AB_point)
                                    End If
                                Case "33"
                                    If POINTS_NB.Value.ToString() = "5" And OPERATIONS_NB.Value.ToString() = "1" Then
                                        DoPerfEntry(eTestPhasesATAR_09C.Phase33_5_AB_idle_point_op1)
                                    End If
                                Case "34"
                                    If OPERATIONS_NB.Value.ToString() = "2" Then
                                        DoPerfEntry(eTestPhasesATAR_09C.Phase34_Check_AB_operation_overspeed_mode_op2)
                                    End If
                                Case "35"
                                    If OPERATIONS_NB.Value.ToString() = "2" Then
                                        DoPerfEntry(eTestPhasesATAR_09C.Phase35_Check_70_max_whithout_AB_F_INA_cruise)
                                    End If
                            End Select

                        Case "F100 PW200"

                            Select Case PHASES_NB.Value.ToString()
                                Case "A"
                                    Select Case POINTS_NB.Value.ToString()
                                        Case "3" : CELProject.ActivateForm("F100_Performance_Screen", CELProject.Test_Mgr_UUT_Model.Value.ToString() + "_Screen", True, False)
                                        Case "15" : CELProject.ActivateForm("F100_Performance_Screen_A15", CELProject.Test_Mgr_UUT_Model.Value.ToString() + "_Screen", True, False)
                                    End Select
                                Case "B"
                                    Select Case POINTS_NB.Value.ToString()
                                        Case "2" : CELProject.ActivateForm("F100_Performance_Screen_B2", CELProject.Test_Mgr_UUT_Model.Value.ToString() + "_Screen", True, False)
                                        Case "6" : CELProject.ActivateForm("F100_Performance_Screen_B6", CELProject.Test_Mgr_UUT_Model.Value.ToString() + "_Screen", True, False)
                                        Case "8" : CELProject.ActivateForm("F100_Performance_Screen_B8", CELProject.Test_Mgr_UUT_Model.Value.ToString() + "_Screen", True, False)
                                    End Select
                                Case "C", "D" : OnPERF_TAKE_POINT_BTN(sender, newVal)
                                Case "E" : OnPERF_TAKE_POINT_BTN(sender, newVal)
                                Case "F" : OnPERF_TAKE_POINT_BTN(sender, newVal)
                            End Select
                    End Select
                    Log_Button.Value = KineticaRT.Values.Values.False
                End If

            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: Engine_Sequence: OnLOG_TAKE_POINT_BTN()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.ToString())
            End Try
        End Sub

        '**************************
        '* OnPERF_TAKE_POINT_BTN()  *
        '**************************
        Private Sub OnPERF_TAKE_POINT_BTN(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            'Variable Declaration
            Dim Result As DialogResult
            Dim Filename As String
            Dim SearchPath As String
            Dim NewFilename As String
            Dim Dirs As String()
            Dim Exist As Boolean
            Dim workbookPath As String
            Dim excelWorkbook As Excel.Workbook = Nothing
            'Dim excelSheets As Excel.Sheets
            'Dim currentSheet As String
            'Dim excelWorksheet As Excel.Worksheet
            Dim AppendOption As Boolean
            Dim xl As New Excel.Application()
            Dim iHandle As IntPtr
            Dim sVer As String = ""

            If (CELProject.IsTrue(newVal)) Then
                Try

                    xl.DisplayAlerts = False
                    xl.Visible = False

                    If Val(sVer) >= 10 Then iHandle = New IntPtr(CType(xl.Parent.Hwnd, Integer))

                    System.Threading.Thread.Sleep(1000)

                    SearchPath = "C:\" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(1).Value.ToString() + "\Perf\"
                    Dirs = Directory.GetFiles(SearchPath, "*.xlsx")
                    Array.Sort(Dirs)

                    If Dirs.GetUpperBound(0) = -1 Then
                        Result = DialogResult.No
                    Else
                        Result = MessageBox.Show("Append Report to Last File?", "Performance Report", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Question)
                    End If

                    If Dirs.Length > 0 Then
                        Filename = Dirs(Dirs.GetUpperBound(0))
                    Else
                        Filename = ""
                    End If

                    'Check if the file exist, if not create one 
                    Exist = File.Exists(Filename)

                    If Exist = False And Result <> DialogResult.Cancel Then
                        'If the user want to append, force the creation of a new file
                        Result = DialogResult.No
                    End If

                    If Result <> DialogResult.Cancel Then
                        'Create a regular data snapshot each time we create a performance report
                        'DoLogging(True)
                        If (Result = DialogResult.Yes) Then

                            '****************Open and Append to the the log Report the Last Performance Report Object****************'


                            ' The following code opens an existing workbook
                            workbookPath = System.IO.Path.GetFullPath(Filename)

                            Try
                                excelWorkbook = xl.Workbooks.Open(workbookPath, 0, False, 5, "", "", False, Excel.XlPlatform.xlWindows, "", True, False, 0, True, False, False)
                            Catch exception As System.Exception
                                System.Diagnostics.Trace.WriteLine("Opening Excel: " + exception.Message)
                                MessageBox.Show(exception.Message)
                            End Try

                            If (Not excelWorkbook Is Nothing) Then

                                '****************Open the Last Full Log Report Object****************'
                                AppendOption = True

                                If CreatePerformanceFile(AppendOption, CELProject.PERF_TEST_STEP_NB.Value.ToDouble, excelWorkbook) = False Then
                                    MessageBox.Show("Performance Report has generated an error.  The report will not be saved!", "Warning", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                                    Exit Sub
                                End If

                                'Call PrintReport(excelWorkbook)

                                'Save the report
                                excelWorkbook.Save()
                                excelWorkbook.Close()

                            End If
                        Else
                            'Result = MessageBox.Show("Create a new performance report?", "Performance Report", MessageBoxButtons.YesNo,MessageBoxIcon.Question)
                            Result = DialogResult.Yes
                            If (Result = DialogResult.Yes) Then

                                ' The following code opens an existing workbook
                                workbookPath = System.IO.Path.GetFullPath("C:\My Projects\KineticaRT\Prj" & CELProject.Project.Number & "_HMI_Performance\PrjExt\" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + " Performance.xlsx")
                                Try
                                    excelWorkbook = xl.Workbooks.Open(workbookPath, 0, False, 5, "", "", False, Excel.XlPlatform.xlWindows, "", True, False, 0, True, False, False)
                                Catch exception As System.Exception
                                    System.Diagnostics.Trace.WriteLine("Opening Excel: " + exception.Message)
                                    MessageBox.Show(exception.Message)
                                End Try

                                AppendOption = False 'Create New One

                                If CreatePerformanceFile(AppendOption, CELProject.PERF_TEST_STEP_NB.Value.ToDouble, excelWorkbook) = False Then
                                    MessageBox.Show("Performance Report has generated an error.  The report will not be saved!", "Warning", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                                    Exit Sub
                                End If

                                'PrintReport(excelWorkbook)   

                                'Create the new File
                                NewFilename = CELProject.Test_Mgr_UUT_Model.Value.ToString() + " Performance" + Format(Now, " yyyy-MM-dd HH'h'mm'm'ss's'")
                                Filename = "C:\" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(1).Value.ToString() + "\Perf\" + NewFilename + ".xlsx"
                                excelWorkbook.SaveAs(Filename)
                                excelWorkbook.Close()

                            Else
                                MessageBox.Show("The Performance Report has not been saved on disk!", "Warning", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                                PERF_TAKE_POINT_BTN.Value = KineticaRT.Values.Values.False
                                Exit Sub 'Quit the program without modification.             
                            End If
                        End If
                        PERF_TAKE_POINT_BTN.Value = KineticaRT.Values.Values.False
                    End If

                Catch ex As Exception
                    MessageBox.Show("OnPERF_TAKE_POINT_BTN: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Finally
                    'xl.Quit 'Does not work properly...
                    'ft2012 CloseExcelApplication(xl)
                    'ft2012 PERF_CLOSE_WINDOW_BTN.Value = KineticaRT.Values.Values.True
                End Try
            End If
        End Sub
        '*******************
        '* OnViewLogBook() *
        '*******************
        Private Sub OnViewLogBook(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                Dim Dirs As String()
                Dim xl As New Excel.Application()
                'Dim ExcelSheets As Excel.Sheets
                Dim ExcelWorkbook As Excel.Workbook
                'Dim ExcelWorksheet As Excel.Worksheet
                'Dim Exist As Boolean
                Dim Filename As String
                'Dim NewFilename As String
                Dim Result As DialogResult
                Dim SearchPath As String
                Dim WorkbookPath As String

                SearchPath = "C:\" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(1).Value.ToString() + "\Log\"
                Dirs = Directory.GetFiles(SearchPath, "Log Report*")

                Array.Sort(Dirs)

                If Dirs.GetUpperBound(0) = -1 Then
                    Result = MessageBox.Show("No File found", "Log Report", MessageBoxButtons.OK)
                Else
                    Filename = FormSelectFile(Dirs)
                    'MessageBox.Show(Filename)
                    System.Threading.Thread.Sleep(1000)

                    '****************Open the New Performance Report Object****************'

                    xl.DisplayAlerts = False
                    xl.Visible = False

                    ' The following code opens an existing workbook    "C:\My Projects\KineticaRT\Prj" + PROJECT_NUMBER + "_HMI_Performance\PrjExt\ATAR 09C Performance.xls"
                    WorkbookPath = System.IO.Path.GetFullPath(Filename)
                    Try
                        ExcelWorkbook = xl.Workbooks.Open(WorkbookPath, 0, True, 5, "", "", False, Excel.XlPlatform.xlWindows, "", False, False, 0, True, False, False)
                    Catch exception As System.Exception
                        System.Diagnostics.Trace.WriteLine("Opening Excel: " + exception.Message)
                        System.Windows.Forms.MessageBox.Show(exception.Message)
                    End Try

                    xl.Visible = True  ' Makes Excel visible to the user.	

                    'PrintReport(excelWorkbook)   

                    'NewFilename = "" + Test_Mgr_UUT_Model.Value.ToString() + " Performance " + Format(Now, "yyyy MM dd HH,mm,ss") + ".xls"
                    'Filename = "C:\" + Test_Mgr_UUT_Model.Value.ToString() + "\" + Test_Mgr_UUT_Answer(0).ToString() + "\" + Test_Mgr_UUT_Answer(1).ToString() + "\Perf\" + NewFilename + ".xls"

                    'ExcelWorkbook.saveas (Filename)
                    'ExcelWorkbook.Close


                End If
                ViewLogBook.Value = KineticaRT.Values.Values.False


            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: Engine_Sequence: OnViewLogBook()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.ToString())
            End Try
        End Sub

        '*******************
        '* OnViewReport() *
        '*******************
        Private Sub OnViewReport(ByVal sender As KineticaRT.Channels.IChannel, ByVal newVal As KineticaRT.Values.Value)
            Try
                Dim Dirs As String()
                'Dim ExcelSheets As Excel.Sheets
                Dim ExcelWorkbook As Excel.Workbook = Nothing
                'Dim ExcelWorksheet As Excel.Worksheet
                'Dim Exist As Boolean
                Dim Filename As String
                'Dim NewFilename As String
                Dim Result As DialogResult
                Dim SearchPath As String
                Dim WorkbookPath As String
                Dim xl As New Excel.Application()

                Select Case "True"
                    Case ViewLogBook.ToString(), PrintLogBook.ToString()
                        SearchPath = "C:\" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(1).Value.ToString() + "\Log\"
                        Dirs = Directory.GetFiles(SearchPath, "Log Report*")

                    Case ViewPerfReport.ToString(), PrintPerfReport.ToString()
                        SearchPath = "C:\" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(0).Value.ToString() + "\" + CELProject.Test_Mgr_UUT_Answer(1).Value.ToString() + "\Perf\"
                        Dirs = Directory.GetFiles(SearchPath, "*.xlsx")

                    Case Else : Exit Sub
                End Select

                If Dirs.GetUpperBound(0) = -1 Then
                    Result = MessageBox.Show("No File found", "Performance Report", MessageBoxButtons.OK)
                Else
                    Array.Sort(Dirs)

                    Select Case "True"
                        Case PrintLogBook.ToString(), PrintPerfReport.ToString()
                            Filename = FormSelectFile(Dirs, "Print")
                        Case ViewLogBook.ToString(), ViewPerfReport.ToString()
                            Filename = FormSelectFile(Dirs)
                        Case Else : Exit Sub
                    End Select

                    If Filename <> "" Then
                        If File.Exists(Filename) Then

                            System.Threading.Thread.Sleep(1000)

                            'Don't prompt user to save
                            xl.DisplayAlerts = False
                            xl.Visible = False

                            ' The following code opens an existing workbook    
                            WorkbookPath = System.IO.Path.GetFullPath(Filename)
                            Try
                                ExcelWorkbook = xl.Workbooks.Open(WorkbookPath, 0, True, 5, "", "", False, Excel.XlPlatform.xlWindows, "", False, False, 0, True, False, False)
                            Catch exception As System.Exception
                                System.Diagnostics.Trace.WriteLine("Opening Excel: " + exception.Message)
                                System.Windows.Forms.MessageBox.Show(exception.Message)
                            End Try

                            Select Case "True"
                                Case ViewPerfReport.ToString(), ViewLogBook.ToString()
                                    xl.Visible = True  ' Makes Excel visible to the user.	
                                Case PrintPerfReport.ToString(), PrintLogBook.ToString()
                                    If PrintPerfReport.ToString() = "True" And CELProject.Test_Mgr_UUT_Model.Value.ToString() = "F100 PW200" Then
                                        PrintReport(ExcelWorkbook, 3)
                                    Else
                                        PrintReport(ExcelWorkbook, 1)
                                    End If

                                    CloseExcelApplication(xl)
                            End Select
                        End If
                    End If
                End If

                ViewPerfReport.Value = KineticaRT.Values.Values.False
                PrintPerfReport.Value = KineticaRT.Values.Values.False
                ViewLogBook.Value = KineticaRT.Values.Values.False
                PrintLogBook.Value = KineticaRT.Values.Values.False

            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: Engine_Sequence: OnViewReport()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.ToString())
            End Try
        End Sub

