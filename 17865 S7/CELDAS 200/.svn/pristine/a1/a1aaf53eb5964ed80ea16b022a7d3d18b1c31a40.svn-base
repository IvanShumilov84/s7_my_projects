        '*****************************
        '* CloseExcelApplication() 	 *
        '*****************************
        Private Sub CloseExcelApplication(ByRef xl As Excel.Application)
            Try
                xl.Quit()
                xl = Nothing
                GC.Collect()
                GC.WaitForPendingFinalizers()
                GC.Collect()
                GC.WaitForPendingFinalizers()

            Catch ex As Exception
                'Do nothing
            End Try
        End Sub

