#Region "NewCreateLogFile"
        Private Sub CreateLogFile()
            Dim Categorie_Name As String
            Dim Cmd As OleDbCommand
            Dim ColumnIndex As Integer
            Dim CurrentSheet As String
            Dim ExcelSheets As Excel.Sheets
            Dim ExcelWorkbook As Excel.Workbook
            Dim ExcelWorksheet As Excel.Worksheet
            Dim Filename As String
            Dim Reader As OleDbDataReader
            Dim RowIndex As Integer
            Dim SelectString As String
            Dim TestSession_Connection As OleDbConnection = Nothing
            Dim Var1 As CEL.KineticaRT.Servers.Logger.TextChannel

            Try

                ExcelWorkbook = CELDAS.ExcelApplication.Workbooks.Add

                'The following gets the Worksheets collection
                ExcelSheets = ExcelWorkbook.Worksheets

                CurrentSheet = "Sheet1"
                ExcelWorksheet = ExcelSheets.Item(CurrentSheet)

                If DatabaseHelper.OpenConnection(CELProject.Database.OleDbConnectionString, TestSession_Connection) Then

                    SelectString = "SELECT * FROM Log_Report WHERE [Engine_Model] = " + Chr(39) + CELProject.Test_Mgr_UUT_Model.Value.ToString() + Chr(39) + " AND NOT([Position] = 0) ORDER BY [Position]"
                    Cmd = New OleDbCommand(SelectString, TestSession_Connection)
                    Reader = Cmd.ExecuteReader()

                    ColumnIndex = 2
                    RowIndex = 2

                    While (Reader.Read())
                        Var1 = GetChannel(Reader.Item("Header").ToString())
                        If Var1 Is Nothing Then
                            MessageBox.Show("ERROR: Log Variable creation is Nothing")
                        End If

                        ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Var1.Description + ":"
                        ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                        ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                        ColumnIndex += 2
                        If ColumnIndex Mod 8 = 0 Then
                            RowIndex += 1
                            ColumnIndex = 2
                        End If
                    End While
                    Reader.Close()

                    ColumnIndex = 1
                    RowIndex += 3
                    'Register Starting RowIndex for datda logging

                    RowIndex_Start_Log = RowIndex

                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Date Time:"
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                    RowIndex += 1
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Cond#:"
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                    Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()

                        Case "ATAR 09C"
                            RowIndex += 1
                            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "PHASES:"
                            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                            RowIndex += 1
                            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "POINTS:"
                            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                            RowIndex += 1
                            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "OPERATIONS:"
                            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                            ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                    End Select

                    RowIndex += 1
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Comment:"
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                    ExcelWorksheet.Rows(RowIndex).RowHeight = 65.25
                    ExcelWorksheet.Rows(RowIndex).VerticalAlignment = Excel.XlVAlign.xlVAlignTop
                    ExcelWorksheet.Rows(RowIndex).WrapText = True


                    'TODO: Amélioration possible de faire une contruction dynamique du SlectString selon les module actif dans la base de données ou par config xml
                    SelectString = " (SELECT HMI_Numeric_Channels.Engine_Model,HMI_Numeric_Channels.Description,HMI_Numeric_Channels.Units, HMI_Numeric_Channels.Log_Report_Categorie, HMI_Numeric_Channels.Log_Report_Order_In_Categorie, HMI_Numeric_Channels.Mean_Enabled, Log_Report_Categories.Order"
                    SelectString += " FROM HMI_Numeric_Channels INNER JOIN Log_Report_Categories ON (HMI_Numeric_Channels.Log_Report_Categorie = Log_Report_Categories.Categories) AND (HMI_Numeric_Channels.Engine_Model = Log_Report_Categories.Engine_Model)"
                    SelectString += " WHERE (((HMI_Numeric_Channels.Engine_Model)='" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + "') AND ((HMI_Numeric_Channels.Log_Report_Categorie)<>''))) "
                    SelectString += " UNION ALL "
                    SelectString += " (SELECT HMI_Boolean_Channels.Engine_Model,HMI_Boolean_Channels.Description,'' As Units, HMI_Boolean_Channels.Log_Report_Categorie, HMI_Boolean_Channels.Log_Report_Order_In_Categorie, '0' As Mean_Enabled, Log_Report_Categories.Order"
                    SelectString += " FROM HMI_Boolean_Channels INNER JOIN Log_Report_Categories ON (HMI_Boolean_Channels.Log_Report_Categorie = Log_Report_Categories.Categories) AND (HMI_Boolean_Channels.Engine_Model = Log_Report_Categories.Engine_Model)"
                    SelectString += " WHERE (((HMI_Boolean_Channels.Engine_Model)='" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + "') AND ((HMI_Boolean_Channels.Log_Report_Categorie)<>''))) "
                    SelectString += " UNION ALL "
                    SelectString += " (SELECT DACN1_ARINC429_LABEL.Model As Engine_Model,DACN1_ARINC429_LABEL.Description,DACN1_ARINC429_LABEL.Units, DACN1_ARINC429_LABEL.Log_Report_Categorie, DACN1_ARINC429_LABEL.Log_Report_Order_In_Categorie, '0' As Mean_Enabled, Log_Report_Categories.Order"
                    SelectString += " FROM DACN1_ARINC429_LABEL INNER JOIN Log_Report_Categories ON (DACN1_ARINC429_LABEL.Log_Report_Categorie = Log_Report_Categories.Categories) AND (DACN1_ARINC429_LABEL.Model = Log_Report_Categories.Engine_Model)"
                    SelectString += " WHERE (((DACN1_ARINC429_LABEL.Model)='" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + "') AND ((DACN1_ARINC429_LABEL.Log_Report_Categorie)<>''))) "
                    SelectString += " UNION ALL "
                    SelectString += " (SELECT DACN1_OmniBusBox_IOMGR_Uart.Model As Engine_Model,DACN1_OmniBusBox_IOMGR_Uart.Parameter As Description,DACN1_OmniBusBox_IOMGR_Uart.Units, DACN1_OmniBusBox_IOMGR_Uart.Log_Report_Categorie, DACN1_OmniBusBox_IOMGR_Uart.Log_Report_Order_In_Categorie, '0' As Mean_Enabled, Log_Report_Categories.Order"
                    SelectString += " FROM DACN1_OmniBusBox_IOMGR_Uart INNER JOIN Log_Report_Categories ON (DACN1_OmniBusBox_IOMGR_Uart.Log_Report_Categorie = Log_Report_Categories.Categories) AND (DACN1_OmniBusBox_IOMGR_Uart.Model = Log_Report_Categories.Engine_Model)"
                    SelectString += " WHERE (((DACN1_OmniBusBox_IOMGR_Uart.Model)='" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + "') AND ((DACN1_OmniBusBox_IOMGR_Uart.Log_Report_Categorie)<>''))) "
                    SelectString += " ORDER BY Log_Report_Categories.Order, Engine_Model, Log_Report_Categorie, Log_Report_Order_In_Categorie "


                    Cmd = New OleDbCommand(SelectString, TestSession_Connection)
                    Reader = Cmd.ExecuteReader()

                    Categorie_Name = ""
                    ColumnIndex = 1
                    RowIndex += 3

                    While (Reader.Read())
                        If Reader.Item("Log_Report_Categorie").ToString() <> Categorie_Name Then
                            Categorie_Name = Reader.Item("Log_Report_Categorie").ToString()

                            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Categorie_Name
                            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Interior.Pattern = Excel.XlPattern.xlPatternGray16

                            RowIndex += 1
                        End If

                        ExcelWorksheet.Cells(RowIndex, ColumnIndex).Borders(Excel.XlBordersIndex.xlEdgeBottom).Weight = Excel.XlBorderWeight.xlHairline
                        ExcelWorksheet.Cells(RowIndex, ColumnIndex).Borders(Excel.XlBordersIndex.xlEdgeRight).Weight = Excel.XlBorderWeight.xlHairline

                        If Reader.Item("Units").ToString.Length > 0 Then
                            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Reader.Item("Description").ToString() + " (" + Reader.Item("Units").ToString() + ")"
                        Else
                            ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Reader.Item("Description").ToString()
                        End If

                        'Override log file value for C - 40 / ?P
                        If CELProject.Test_Mgr_UUT_Option(0).Value.ToString() = "True" Then
                            If Microsoft.VisualBasic.Left(Reader.Item("Description").ToString(), 6) = "C - 40" Then  '/ "+ChrW(&H0394)+"P" Then
                                'ExcelWorkSheet.Cells(RowIndex, ColumnIndex).Interior.Pattern = XlPattern.xlPatternDown	
                                RowIndex -= 1
                            End If
                        Else
                            If Microsoft.VisualBasic.Left(Reader.Item("Description").ToString(), 6) = "C - 60" Then  '/ "+ChrW(&H0394)+"P" Then
                                'ExcelWorkSheet.Cells(RowIndex, ColumnIndex).Interior.Pattern = XlPattern.xlPatternDown	
                                RowIndex -= 1
                            End If
                        End If
                        RowIndex += 1
                    End While
                    Reader.Close()

                    'Add some Style to the report
                    ExcelWorksheet.Cells.ColumnWidth = 14.71
                    ExcelWorksheet.Columns(1).ColumnWidth = 24.86

                    ExcelWorksheet.PageSetup.Orientation = Excel.XlPageOrientation.xlLandscape
                    ExcelWorksheet.PageSetup.Zoom = 85
                    ExcelWorksheet.PageSetup.PrintTitleColumns = "$A:$A"
                    ExcelWorksheet.PageSetup.CenterHeader = "&""Arial,Bold""&20&U" & CELProject.Test_Mgr_UUT_Model.Value.ToString() & Chr(10) & "Log File"
                    'TODO: Path a revoir
                    If (File.Exists("C:\My Projects\KineticaRT\Prj" + CELProject.Project.Number + "_HMI_Performance\Images\yourlogo.bmp")) Then
                        ExcelWorksheet.PageSetup.LeftHeaderPicture.Filename = "C:\My Projects\KineticaRT\Prj" + CELProject.Project.Number + "_HMI_Performance\Images\yourlogo.bmp"
                    End If
                    ExcelWorksheet.PageSetup.LeftHeader = "&G"
                    ExcelWorksheet.PageSetup.LeftFooter = "&8Test Cell manufactured by CEL Aerospace LTD, Canada (1) 450-442-9994" + Chr(10) + _
                     "www.cel-aerospace.ca"
                    ExcelWorksheet.PageSetup.CenterFooter = "&P of &N"
                    ExcelWorksheet.PageSetup.RightFooter = "CELDAS™ 200 Version " + CELProject.Project.Number
                    ExcelWorksheet.PageSetup.TopMargin = CELDAS.ExcelApplication.InchesToPoints(1.25)

                    If (Not Directory.Exists("C:\My Projects\KineticaRT\Prj" + CELProject.Project.Number + "_HMI_Performance\PrjExt\")) Then
                        Directory.CreateDirectory("C:\My Projects\KineticaRT\Prj" + CELProject.Project.Number + "_HMI_Performance\PrjExt\")
                    End If

                    Filename = "C:\My Projects\KineticaRT\Prj" + CELProject.Project.Number + "_HMI_Performance\PrjExt\Log_Report.xlsx"
                    If (File.Exists(Filename)) Then
                        File.Delete(Filename)
                    End If

                    ExcelWorkbook.SaveAs(Filename)
                    ExcelWorkbook.Close()

                    DatabaseHelper.CloseConnection(TestSession_Connection)
                End If
            Catch ex As Exception
                MessageBox.Show("CreateLogFile: " & Ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally
            End Try
        End Sub
#End Region


        '******************************
        '* CreatePerformanceFile	  * 
        '******************************
        Private Function CreatePerformanceFile(ByVal AppendOption As Boolean, ByVal TestStepNb As Integer, ByVal excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim currentSheet As String
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreatePerformanceFile = True

            ' The following gets the Worksheets collection
            excelSheets = excelWorkbook.Worksheets

            Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()

                Case "ATAR 09C"

                    Try
                        'Unlock Sheets
                        excelWorkbook.Worksheets(1).Unprotect(CELProject.Project.PerformanceReportsCellProtection.ToString)
                        excelWorkbook.Worksheets(2).Unprotect(CELProject.Project.PerformanceReportsCellProtection.ToString)
                        excelWorkbook.Worksheets(3).Unprotect(CELProject.Project.PerformanceReportsCellProtection.ToString)

                        'Overwrite data each time
                        currentSheet = "Sheet1"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Performed Test Details section

                        If AppendOption = False Then

                            currentSheet = "Sheet1"
                            excelWorksheet = excelSheets.Item(currentSheet)
                            'Date
                            excelWorksheet.Cells(6, 9).Value = Format(Now, "MM/dd/yyyy")
                            'Serial Number
                            excelWorksheet.Cells(5, 3).Value = CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
                            'Work Order
                            excelWorksheet.Cells(5, 9).Value = CELProject.Test_Mgr_UUT_Answer(1).Value.ToString()

                            If CELProject.Test_Mgr_UUT_Option(1).Value.ToString() = "True" Then
                                excelWorksheet.Cells(14, 10).Value = "" + ChrW(&H2264) + " 1.069"
                                excelWorksheet.Cells(16, 10).Value = "" + ChrW(&H2264) + " 2.200"
                                excelWorksheet.Cells(18, 10).Value = "" + ChrW(&H2264) + " 1.020"
                            Else
                                excelWorksheet.Cells(14, 10).Value = "" + ChrW(&H2264) + " 1.064"
                                excelWorksheet.Cells(16, 10).Value = "" + ChrW(&H2264) + " 2.185"
                                excelWorksheet.Cells(18, 10).Value = "" + ChrW(&H2264) + " 1.004"
                            End If

                            'Operator
                            excelWorksheet.Cells(30, 3).Value = CELProject.Test_Mgr_UUT_Choice(1).Value.ToString()
                            'Inspector
                            excelWorksheet.Cells(31, 3).Value = CELProject.Test_Mgr_UUT_Choice(2).Value.ToString()

                            If CELProject.Test_Mgr_UUT_Option(1).Value.ToString() = "True" Then
                                excelWorksheet.Cells(6, 3).Value = "With Snubber Blade"
                            Else
                                excelWorksheet.Cells(6, 3).Value = "Without Snubber Blade"
                            End If
                        End If

                        Select Case TestStepNb
                            Case eTestPhasesATAR_09C.Phase14_2_Max_point_without_AB '6
