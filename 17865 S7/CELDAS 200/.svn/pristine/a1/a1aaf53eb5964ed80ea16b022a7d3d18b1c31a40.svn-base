                                excelWorksheet.Cells(20, 9).Value = Format(System.Convert.ToDouble(T4_AVG.ToString()), "0.0")
                                excelWorksheet.Cells(20, 11).Value = Format(System.Convert.ToDouble(CSINA.ToString()), "0.000")

                            Case eTestPhasesATAR_09C.Phase35_Check_70_max_whithout_AB_F_INA_cruise '28
