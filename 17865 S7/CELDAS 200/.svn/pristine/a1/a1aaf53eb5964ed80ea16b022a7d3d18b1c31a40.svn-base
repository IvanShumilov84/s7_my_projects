        '******************
        '* PrintReport	  *
        '******************
        Private Sub PrintReport(ByVal xlWorkbook As Excel.Workbook, Optional ByVal NbSheet As Integer = -1)
            Try
                If NbSheet = -1 Then
                    'xlWorkbook.PrintOut		
                Else
                    Dim i As Integer
                    For i = 1 To NbSheet
                        xlWorkbook.Worksheets(i).PrintOut()
                    Next
                End If

            Catch exception As System.Exception
                System.Diagnostics.Trace.WriteLine("Print Workbook: " + exception.Message)
                MessageBox.Show(exception.Message)
            End Try
        End Sub


        Private Sub PrintReport(ByVal excelWorksheet As Excel.Worksheet)
            'excelWorksheet.PrintOut				
        End Sub

#Region "Old UpdateLogFile"
        '*******************
        '* UpdateLogFile() *
        '*******************
        Private Sub UpdateLogFile(ByVal AppendOption As Boolean, ByVal ExcelWorksheet As Excel.Worksheet, ByVal isPerfEntry As Boolean)
            Try
                Dim Categorie_Name As String
                Dim Cmd As OleDbCommand
                Dim CollectionName As String
                Dim ColumnIndex As Integer
                'Dim ConnectionString As String
                Dim EngineModel As String = CELProject.Test_Mgr_UUT_Model.Value.ToString()
                Dim MaxPosition As Integer
                Dim Reader As OleDbDataReader
                Dim RowIndex As Integer
                Dim SelectString As String
                Dim TestSession_Connection As OleDbConnection
                Dim Var1 As KineticaRT.Logic.Channels.TextLink
                Dim Var2 As KineticaRT.Channels.Channel
                Dim KOk As Boolean = False

                TestSession_Connection = New OleDbConnection(CELProject.Database.OleDbConnectionString)

                'Open the connection.
                Try
                    TestSession_Connection.Open()
                Catch exception As System.Exception
                    System.Diagnostics.Trace.WriteLine(exception.Message)
                    Exit Sub
                End Try

                If AppendOption = False Then
                    SelectString = "SELECT * FROM Log_Report WHERE [Engine_Model] = " + Chr(39) + CELProject.Test_Mgr_UUT_Model.Value.ToString() + Chr(39) + " AND NOT([Position] = 0) ORDER BY [Position]"
                    Cmd = New OleDbCommand(SelectString, TestSession_Connection)
                    Reader = Cmd.ExecuteReader()

                    ColumnIndex = 2
                    RowIndex = 2

                    While (Reader.Read())
                        Var1 = GetChannel(Reader.Item("Header").ToString())
                        If Var1 Is Nothing Then
                            MessageBox.Show("ERROR: Log Variable creation is Nothing")
                        End If

                        If (Reader.Item("Header").ToString().IndexOf("Option") > 1) Then
                            If Var1.Value.ToString().ToUpper() = "TRUE" Then
                                ExcelWorksheet.Cells(RowIndex, ColumnIndex + 1).Value = "Yes"
                            Else
                                ExcelWorksheet.Cells(RowIndex, ColumnIndex + 1).Value = "No"
                            End If
                        Else
                            ExcelWorksheet.Cells(RowIndex, ColumnIndex + 1).Value = Var1.Value.ToString()
                        End If
                        ExcelWorksheet.Cells(RowIndex, ColumnIndex + 1).Font.Bold = False
                        ExcelWorksheet.Cells(RowIndex, ColumnIndex + 1).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                        ColumnIndex += 2
                        If ColumnIndex Mod 8 = 0 Then
                            RowIndex += 1
                            ColumnIndex = 2
                        End If
                    End While
                    Reader.Close()
                End If

                Select Case CELProject.Test_Mgr_UUT_Model.Value.ToString()

                    Case "ATAR 09C"
                        Select Case PHASES_NB.Value.ToString()
                            Case "14"
                                If POINTS_NB.Value.ToString() = "2" Then
                                    MSPC_FINA.Value = New KineticaRT.Values.Double(FINA.Value.ToDouble())
                                End If
                            Case "32"
                                If POINTS_NB.Value.ToString() = "4" And OPERATIONS_NB.Value.ToString() = "2" Then
                                    MAXAB_FINA.Value = New KineticaRT.Values.Double(FINA.Value.ToDouble())
                                End If
                        End Select
                End Select

                SelectString = "SELECT Max([Position]) AS [Maximum] FROM [Log_Report]"
                Cmd = New OleDbCommand(SelectString, TestSession_Connection)
                Reader = Cmd.ExecuteReader()

                While (Reader.Read())
                    MaxPosition = CInt(Math.Round(CDbl(Reader.Item("Maximum").ToString()) / 3))
                End While
                Reader.Close()

                'RowIndex 	= MaxPosition + 2 + 2

                RowIndex = RowIndex_Start_Log
                If AppendOption = False Then
                    Log_Condition = 1
                Else
                    Log_Condition = (ExcelWorksheet.Cells(RowIndex + 1, 1).End(Excel.XlDirection.xlToRight).Column - 1)
                    Log_Condition = Log_Condition + 1
                End If

                If ((Log_Condition > 1) And ((Log_Condition Mod 7) = 1)) Then
                    '
                    'Repeat The Test Spec For this new sets of condition
                    '
                    With ExcelWorksheet
                        .Range(.Cells(2, 2), .Cells(RowIndex - 2, 7)).Copy(.Cells(2, Log_Condition + 1))
                    End With
                End If

                ColumnIndex = 1 + Log_Condition

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Format(Now, "yyyy/MM/dd HH:mm:ss")
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Log_Condition.ToString()
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = PHASES_NB.Value.ToString()
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = POINTS_NB.Value.ToString()
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = OPERATIONS_NB.Value.ToString()
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = InputBox("Comment: ", "Log Report", Me.Comment)
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 2
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Values"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                K.Value = New KineticaRT.Values.Double(InputBox("Value of factor K: ", "Correction Factor", K.Value.ToString()))

                While (Not KOk)
                    If (K.Value.ToString() = "NaN") Then
                        K.Value = New KineticaRT.Values.Double(InputBox("Error! Numeric value expected. Value of factor K: ", "Correction Factor", "1.000"))
                    Else
                        KOk = True
                    End If
                End While

                '			SelectString	= "SELECT Name, Description, Format, Units, Log_Report_Categorie, Log_Report_Order_In_Categorie, [Order] "
                '			SelectString	+= "FROM (SELECT Name, Description, Format, Units, Log_Report_Categorie, Log_Report_Order_In_Categorie, [Order] "
                '			SelectString	+= "FROM HMI_Alias_Name_Numeric, Log_Report_Categories "
                '			SelectString	+= "WHERE HMI_Alias_Name_Numeric.Log_Report_Categorie = Log_Report_Categories.Categories "
                '			SelectString	+= "And HMI_Alias_Name_Numeric.Engine_Model = '" + Test_Mgr_UUT_Model.Value.ToString() + "' "
                '			SelectString	+= "And HMI_Alias_Name_Numeric.Log_Report_Categorie <> '' "
                '			SelectString	+= "UNION "
                '			SelectString	+= "SELECT Name, Description, Format, Units, Log_Report_Categorie, Log_Report_Order_In_Categorie, [Order] "
                '			SelectString	+= "FROM HMI_Calculated_Value_Numeric, Log_Report_Categories "
                '			SelectString	+= "WHERE HMI_Calculated_Value_Numeric.Log_Report_Categorie = Log_Report_Categories.Categories "
                '			SelectString	+= "And HMI_Calculated_Value_Numeric.Engine_Model = '" + Test_Mgr_UUT_Model.Value.ToString() + "' "
                '			SelectString	+= "And HMI_Calculated_Value_Numeric.Log_Report_Categorie <> '' "
                '			SelectString	+= "ORDER BY Log_Report_Categories.Order) "
                '			SelectString	+= "GROUP BY Log_Report_Categorie, Log_Report_Order_In_Categorie, Name, Description, Format, Units, [Order] "
                '			SelectString	+= "ORDER BY [Order];"
                SelectString = " (SELECT HMI_Alias_Name_Boolean.Engine_Model,HMI_Alias_Name_Boolean.Name,HMI_Alias_Name_Boolean.Description,'' As Format, '' As Units, HMI_Alias_Name_Boolean.Log_Report_Categorie, HMI_Alias_Name_Boolean.Log_Report_Order_In_Categorie, Log_Report_Categories.Order"
                SelectString += " FROM HMI_Alias_Name_Boolean INNER JOIN Log_Report_Categories ON (HMI_Alias_Name_Boolean.Log_Report_Categorie = Log_Report_Categories.Categories) AND (HMI_Alias_Name_Boolean.Engine_Model = Log_Report_Categories.Engine_Model)"
                SelectString += " WHERE (((HMI_Alias_Name_Boolean.Engine_Model)='" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + "') AND ((HMI_Alias_Name_Boolean.Log_Report_Categorie)<>''))) "
                SelectString += " UNION  ALL "
                SelectString += " (SELECT HMI_Alias_Name_Numeric.Engine_Model,HMI_Alias_Name_Numeric.Name,HMI_Alias_Name_Numeric.Description,HMI_Alias_Name_Numeric.Format,HMI_Alias_Name_Numeric.Units, HMI_Alias_Name_Numeric.Log_Report_Categorie, HMI_Alias_Name_Numeric.Log_Report_Order_In_Categorie, Log_Report_Categories.Order"
                SelectString += " FROM HMI_Alias_Name_Numeric INNER JOIN Log_Report_Categories ON (HMI_Alias_Name_Numeric.Log_Report_Categorie = Log_Report_Categories.Categories) AND (HMI_Alias_Name_Numeric.Engine_Model = Log_Report_Categories.Engine_Model)"
                SelectString += " WHERE (((HMI_Alias_Name_Numeric.Engine_Model)='" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + "') AND ((HMI_Alias_Name_Numeric.Log_Report_Categorie)<>''))) "
                SelectString += " UNION ALL "
                SelectString += " (SELECT HMI_Calculated_Value_Numeric.Engine_Model,HMI_Calculated_Value_Numeric.Name,HMI_Calculated_Value_Numeric.Description,HMI_Calculated_Value_Numeric.Format,HMI_Calculated_Value_Numeric.Units, HMI_Calculated_Value_Numeric.Log_Report_Categorie, HMI_Calculated_Value_Numeric.Log_Report_Order_In_Categorie, Log_Report_Categories.Order"
                SelectString += " FROM HMI_Calculated_Value_Numeric INNER JOIN Log_Report_Categories ON (HMI_Calculated_Value_Numeric.Log_Report_Categorie = Log_Report_Categories.Categories) AND (HMI_Calculated_Value_Numeric.Engine_Model = Log_Report_Categories.Engine_Model)"
                SelectString += " WHERE (((HMI_Calculated_Value_Numeric.Engine_Model)='" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + "') AND ((HMI_Calculated_Value_Numeric.Log_Report_Categorie)<>''))) "
                SelectString += " UNION ALL "
                SelectString += " (SELECT HMI_Calculated_Value_Boolean.Engine_Model,HMI_Calculated_Value_Boolean.Name,HMI_Calculated_Value_Boolean.Description,'' As Format, '' As Units, HMI_Calculated_Value_Boolean.Log_Report_Categorie, HMI_Calculated_Value_Boolean.Log_Report_Order_In_Categorie, Log_Report_Categories.Order"
                SelectString += " FROM HMI_Calculated_Value_Boolean INNER JOIN Log_Report_Categories ON (HMI_Calculated_Value_Boolean.Log_Report_Categorie = Log_Report_Categories.Categories) AND (HMI_Calculated_Value_Boolean.Engine_Model = Log_Report_Categories.Engine_Model)"
                SelectString += " WHERE (((HMI_Calculated_Value_Boolean.Engine_Model)='" + CELProject.Test_Mgr_UUT_Model.Value.ToString() + "') AND ((HMI_Calculated_Value_Boolean.Log_Report_Categorie)<>''))) "
                SelectString += " ORDER BY Log_Report_Categories.Order, Engine_Model, Log_Report_Categorie, Log_Report_Order_In_Categorie "


                Cmd = New OleDbCommand(SelectString, TestSession_Connection)
                Reader = Cmd.ExecuteReader()

                Categorie_Name = ""
                RowIndex += 1

                CollectionName = EngineModel.Replace(" ", "_")

                While (Reader.Read())
                    If Reader.Item("Log_Report_Categorie").ToString() <> Categorie_Name Then
                        ExcelWorksheet.Cells(RowIndex, ColumnIndex).Interior.Pattern = Excel.XlPattern.xlPatternGray16
                        Categorie_Name = Reader.Item("Log_Report_Categorie").ToString()
                        RowIndex += 1
                    End If

                    Var2 = GetChannel(CollectionName + "." + Reader.Item("Name").ToString())
                    If Var2 Is Nothing Then
                        MessageBox.Show("ERROR: Log Variable creation is Nothing")
                    End If

                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).NumberFormat = "@"
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Var2.ToString(Reader.Item("Format").ToString(), Nothing)

                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Borders(Excel.XlBordersIndex.xlEdgeBottom).Weight = Excel.XlBorderWeight.xlHairline
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Borders(Excel.XlBordersIndex.xlEdgeRight).Weight = Excel.XlBorderWeight.xlHairline

                    'Override log file value for C - 40 / ?P
                    If CELProject.Test_Mgr_UUT_Option(1).Value.ToString() = "True" Then
                        If Microsoft.VisualBasic.Left(Reader.Item("Description").ToString(), 6) = "C - 40" Then      ' / "+ChrW(&H0394)+"P " Then
                            'ExcelWorkSheet.Cells(RowIndex, ColumnIndex).Value = "--"	
                            RowIndex -= 1
                        End If
                    Else
                        If Microsoft.VisualBasic.Left(Reader.Item("Description").ToString(), 6) = "C - 60" Then      ' / "+ChrW(&H0394)+"P" Then
                            'ExcelWorkSheet.Cells(RowIndex, ColumnIndex).Value = "--"	
                            RowIndex -= 1
                        End If
                    End If

                    RowIndex += 1
                End While
                Reader.Close()


                TestSession_Connection.Close()

                'CloseConnection(TestSession_Connection)

                'UpdateLogFile = True

            Catch Ex As Exception
                MessageBox.Show("UNEXPECTED ERROR: Engine_Sequence: ActivateForm()" & vbCrLf & vbCrLf & "Error message: " & vbCrLf & Ex.ToString())
            End Try
        End Sub
#End Region
