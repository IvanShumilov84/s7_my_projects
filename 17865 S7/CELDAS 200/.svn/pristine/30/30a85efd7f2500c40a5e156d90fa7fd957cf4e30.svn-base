    Public Class APS2X00_Sequence
        Inherits ApuSequence
        Implements IBleedAirFlowCalculation

        'Les constantes isont lu a partir du fichier celdas.cfg
        Private NumberOfTInletProbe As Integer = 0  '4 Probes
        Private NumberOfTEgtProbe As Integer = 0 ' 6
        Private NumberOfTBleedProbe As Integer = 0 '1

        Private Const MaxNumberOfTEgtProbe As Integer = 15
        Private Const MaxNumberOfTInletProbe As Integer = 6

        Private Const NumberMaxDeleteTEgtProbeAllowed As Integer = 2


#Region " Enum "

        'Faire attention, comme on a multiple projet qui n'utilise pas tous les etats, il faut ajouter des steps et ensuite refaire le mapping specifique a ce projet dans la function SetTestStepList

        Public Const NUMBER_OF_STEP As Integer = 17

        Private Enum eTestStepAPS2X00
            POINT_M1 = 0
            POINT_F = 1
            RD_TIME = 2
            POINT_1A = 3
            POINT_1D = 4
            POINT_1E = 5
            POINT_1G = 6
            POINT_1H = 7
            POINT_2B = 8
            POINT_2C = 9
            POINT_2D = 10
            POINT_2E = 11
            POINT_2F = 12
            START_QUALITY_CHECK = 13
            LEAK_CHECK = 14
            POINT_M2 = 15
            FINAL_DATA = 16
        End Enum
        Private PerformanceReportSelected As ePerfReportAPS2X00
        Private Enum ePerfReportAPS2X00
            Production = 0
            Repair = 1
        End Enum
#End Region

        Protected Overrides Sub Compute(ByVal CalulateForLogAndPerformanceReports As Boolean)

            Try
                If CalulateForLogAndPerformanceReports Then

                    LOG_PERF_WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(LOG_PERF_T_ORIFICE_DEGF.Value.ToDouble(), _
                                                                                               LOG_PERF_P_ORIFICE_PSIA.Value.ToDouble(), _
                                                                                              LOG_PERF_P_ORIFICE_DELTA_PSID.Value.ToDouble))

                    'Set the value if in Test steps 2C, 2D or 2E
                    Select Case CELProject.PERF_TEST_STEP_NB.Value.ToDouble
                        Case eTestStepAPS2X00.POINT_2C
                            LOG_PERF_EGT_2C.Value = EGT_2C.Value
                            LOG_PERF_KW_2C.Value = KW_2C.Value
                            LOG_PERF_PB_2C.Value = PB_2C.Value
                            LOG_PERF_TB_2C.Value = TB_2C.Value
                            LOG_PERF_WB_2C.Value = WB_2C.Value
                            LOG_PERF_WF_2C.Value = WF_2C.Value
                        Case eTestStepAPS2X00.POINT_2D
                            LOG_PERF_EGT_2D.Value = EGT_2D.Value
                            LOG_PERF_KW_2D.Value = KW_2D.Value
                            LOG_PERF_PB_2D.Value = PB_2D.Value
                            LOG_PERF_TB_2D.Value = TB_2D.Value
                            LOG_PERF_WB_2D.Value = WB_2D.Value
                            LOG_PERF_WF_2D.Value = WF_2D.Value
                        Case eTestStepAPS2X00.POINT_2E
                            LOG_PERF_EGT_2E.Value = EGT_2E.Value
                            LOG_PERF_KW_2E.Value = KW_2E.Value
                            LOG_PERF_PB_2E.Value = PB_2E.Value
                            LOG_PERF_TB_2E.Value = TB_2E.Value
                            LOG_PERF_WB_2E.Value = WB_2E.Value
                            LOG_PERF_WF_2E.Value = WF_2E.Value
                    End Select

                    FlowmeterCtrl.ComputeFlow(True)

                    'IMPORTANT: Toutes les variables flottantes telles que WB_CALC_PPM dont la source et la destination sont vides doivent
                    'manuellement être updaté pour être inscrite dans le LOG ou le PERF report.
                Else

                    WB_CALC.Value = New KineticaRT.Values.Double(Compute_BleedAirFlow(T_ORIFICE_DEGF.Value.ToDouble(), _
                                                                                      P_ORIFICE_PSIA.Value.ToDouble(), _
                                                                                      P_ORIFICE_DELTA_PSID.Value.ToDouble))
                End If

            Catch ex As Exception
                MessageBox.Show("Compute_APS2X00" + ex.ToString(), "Error")
            End Try

        End Sub

        Protected Overrides Function CreateCustomHeaderLogFile(ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Try
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Date Time:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Cond#:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight

                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Comment:"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                ExcelWorksheet.Rows(RowIndex).RowHeight = 65.25
                ExcelWorksheet.Rows(RowIndex).VerticalAlignment = Excel.XlVAlign.xlVAlignTop
                ExcelWorksheet.Rows(RowIndex).WrapText = True

                Return True

            Catch ex As Exception
                MessageBox.Show("CreateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        Protected Overrides Function UpdateCustomHeaderLogFile(ByVal AppendOption As Boolean, ByVal IsPerfEntry As Boolean, ByRef ExcelWorksheet As Excel.Worksheet, ByRef RowIndex As Integer, ByRef ColumnIndex As Integer) As Boolean

            Try
                Dim Log_Condition As Integer

                If AppendOption = False Then
                    Log_Condition = 1
                Else
                    Log_Condition = ExcelWorksheet.Cells(RowIndex + 1, ExcelWorksheet.Columns.Count).End(Excel.XlDirection.xlToLeft).Column - 1
                    Log_Condition = Log_Condition + 1

                End If

                If ((Log_Condition > 1) And ((Log_Condition Mod 5) = 1)) Then

                    'Repeat The Test Spec For this new sets of condition

                    With ExcelWorksheet
                        .Range(.Cells(2, 2), .Cells(RowIndex - 2, 6)).Copy(.Cells(2, Log_Condition + 1))
                    End With
                End If

                ColumnIndex = 1 + Log_Condition

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Format(Now, "yyyy/MM/dd HH:mm:ss")
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = Log_Condition.ToString()
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 1
                If IsPerfEntry = False Then
                    Dim CommentText As String = ""
                    Dim InputObject As New InputCommentForm
                    InputObject.ShowDialog("Log Report", "Comment:", "", CommentText)

                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = CommentText
                Else
                    ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "STEP: " & TestStepMap(cmbTestStepList.SelectedIndex).TestStepText
                End If

                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignRight
                RowIndex += 2
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Value = "Values"
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).Font.Bold = True
                ExcelWorksheet.Cells(RowIndex, ColumnIndex).HorizontalAlignment = Excel.XlHAlign.xlHAlignCenter

            Catch ex As Exception
                MessageBox.Show("UpdateCustomHeaderLogFile: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Function

        Private Function CreatePerformanceFile11813(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim currentSheet As String
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreatePerformanceFile11813 = True

            Try

                ' The following gets the Worksheets collection
                excelSheets = excelWorkbook.Worksheets
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    currentSheet = "SUMMARY"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    'Report Title
                    If PerformanceReportSelected = ePerfReportAPS2X00.Production Then
                        excelWorksheet.Cells(1, 5).Value = CELProject.EngineModel + " PRODUCTION TEST DATA SHEET"
                    ElseIf PerformanceReportSelected = ePerfReportAPS2X00.Repair Then
                        excelWorksheet.Cells(1, 5).Value = CELProject.EngineModel + " REPAIR TEST DATA SHEET"
                    End If

                    'Engine S/N
                    excelWorksheet.Cells(5, 3).NumberFormat = "@"
                    excelWorksheet.Cells(5, 3).Value = UserInputs11813.EngineSerialNumber
                    'Work Order
                    excelWorksheet.Cells(6, 3).NumberFormat = "@"
                    excelWorksheet.Cells(6, 3).Value = UserInputs11813.WorkOrder
                    'ECB S/N
                    excelWorksheet.Cells(7, 3).NumberFormat = "@"
                    excelWorksheet.Cells(7, 3).Value = UserInputs11813.ECBSerialNumber
                    'Exhaust Duct S/N
                    excelWorksheet.Cells(8, 3).NumberFormat = "@"
                    excelWorksheet.Cells(8, 3).Value = UserInputs11813.ExhaustDuctSerialNumber
                    'Bellmouth S/N
                    excelWorksheet.Cells(9, 3).NumberFormat = "@"
                    excelWorksheet.Cells(9, 3).Value = UserInputs11813.BellmouthSerialNumber
                    'Bleed Duct S/N
                    excelWorksheet.Cells(10, 3).NumberFormat = "@"
                    excelWorksheet.Cells(10, 3).Value = UserInputs11813.BleedDuctSerialNumber
                    'Starter S/N
                    excelWorksheet.Cells(11, 3).NumberFormat = "@"
                    excelWorksheet.Cells(11, 3).Value = UserInputs11813.StarterSerialNumber
                    'Sample T Fuel
                    excelWorksheet.Cells(12, 3).NumberFormat = "@"
                    excelWorksheet.Cells(12, 3).Value = UserInputs11813.SampleTFuel
                    'Sample SG
                    excelWorksheet.Cells(13, 3).NumberFormat = "@"
                    excelWorksheet.Cells(13, 3).Value = UserInputs11813.SampleFuelSg
                    'Oil Type
                    excelWorksheet.Cells(14, 3).NumberFormat = "@"
                    excelWorksheet.Cells(14, 3).Value = UserInputs11813.OilType

                    'Powerhead Vib Pickup S/N
                    excelWorksheet.Cells(5, 9).NumberFormat = "@"
                    excelWorksheet.Cells(5, 9).Value = UserInputs11813.EngineVibrationPickupSerialNumber
                    'Gearbox Vib Pickup S/N
                    excelWorksheet.Cells(6, 9).NumberFormat = "@"
                    excelWorksheet.Cells(6, 9).Value = UserInputs11813.GearboxVibrationPickupSerialNumber
                    'TSN
                    excelWorksheet.Cells(7, 9).NumberFormat = "@"
                    excelWorksheet.Cells(7, 9).Value = UserInputs11813.TSN
                    'CSN
                    excelWorksheet.Cells(8, 9).NumberFormat = "@"
                    excelWorksheet.Cells(8, 9).Value = UserInputs11813.CSN
                    'TSO
                    excelWorksheet.Cells(9, 9).NumberFormat = "@"
                    excelWorksheet.Cells(9, 9).Value = UserInputs11813.TSO
                    'Reason
                    excelWorksheet.Cells(10, 9).NumberFormat = "@"
                    excelWorksheet.Cells(10, 9).Value = UserInputs11813.Reason
                    'Test Type
                    excelWorksheet.Cells(11, 9).NumberFormat = "@"
                    excelWorksheet.Cells(11, 9).Value = UserInputs11813.TestType
                    'Date
                    excelWorksheet.Cells(12, 9).NumberFormat = "@"
                    excelWorksheet.Cells(12, 9).Value = Format(Now, "d MMMM yyyy")

                    currentSheet = "ACCEPTANCE"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    'Document Number
                    excelWorksheet.Cells(46, 3).NumberFormat = "@"

                    Select Case EngineConfiguration.PerformanceReportType
                        Case "Production"
                            excelWorksheet.Cells(46, 3).Value = Custom_Parameters("APUTestedAccordingTo_HS_Production").ToString()
                        Case "Repair"
                            excelWorksheet.Cells(46, 3).Value = Custom_Parameters("APUTestedAccordingTo_HS_Repair").ToString()
                    End Select

                    currentSheet = "SUMMARY"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    'Set the Performance Run 2C-2D-2E Limits
                    If (PerformanceReportSelected = ePerfReportAPS2X00.Repair) Then
                        excelWorksheet.Cells(20, 7).Value = LOG_PERF_PB_MIN_R.Value.ToString(LOG_PERF_PB_MIN_R.Format, Nothing) + " MINIMUM"
                        excelWorksheet.Cells(22, 7).Value = LOG_PERF_TB_MAX_R.Value.ToString(LOG_PERF_TB_MAX_R.Format, Nothing) + " MAXIMUM"
                        excelWorksheet.Cells(23, 7).Value = LOG_PERF_EGT_MAX_R.Value.ToString(LOG_PERF_EGT_MAX_R.Format, Nothing) + " MAXIMUM"
                        excelWorksheet.Cells(24, 7).Value = LOG_PERF_WF_MAX_R.Value.ToString(LOG_PERF_WF_MAX_R.Format, Nothing) + " MAXIMUM"

                        excelWorksheet.Cells(23, 9).Value = LOG_PERF_EGT_MAX_R_2F.Value.ToString(LOG_PERF_EGT_MAX_R_2F.Format, Nothing) + " MAXIMUM"

                    ElseIf (PerformanceReportSelected = ePerfReportAPS2X00.Production) Then
                        excelWorksheet.Cells(20, 7).Value = LOG_PERF_PB_MIN.Value.ToString(LOG_PERF_PB_MIN.Format, Nothing) + " MINIMUM"
                        excelWorksheet.Cells(22, 7).Value = LOG_PERF_TB_MAX.Value.ToString(LOG_PERF_TB_MAX.Format, Nothing) + " MAXIMUM"
                        excelWorksheet.Cells(23, 7).Value = LOG_PERF_EGT_MAX.Value.ToString(LOG_PERF_EGT_MAX.Format, Nothing) + " MAXIMUM"
                        excelWorksheet.Cells(24, 7).Value = LOG_PERF_WF_MAX.Value.ToString(LOG_PERF_WF_MAX.Format, Nothing) + " MAXIMUM"

                        excelWorksheet.Cells(23, 9).Value = LOG_PERF_EGT_MAX_2F.Value.ToString(LOG_PERF_EGT_MAX_2F.Format, Nothing) + " MAXIMUM"
                    End If

                    'Change the Test Steps in case of a Repair
                    If (PerformanceReportSelected = ePerfReportAPS2X00.Repair) Then

                        'Performance Summary
                        excelWorksheet.Cells(17, 5).Value = "STEP 1.J.(4).(c)"
                        excelWorksheet.Cells(17, 7).Value = "STEP 1.J.(4).(e-g-i)"
                        excelWorksheet.Cells(17, 9).Value = "STEP 1.J.(4).(k)"

                        'Performed Test Details
                        excelWorksheet.Cells(30, 6).Value = "STEP 1.I.(12)"
                        excelWorksheet.Cells(31, 6).Value = "STEP N/A"
                        excelWorksheet.Cells(32, 6).Value = "STEP N/A"
                        excelWorksheet.Cells(33, 6).Value = "STEP 1.J.(1).(c)"
                        excelWorksheet.Cells(34, 6).Value = "STEP 1.J.(2).(f)"

                        'Row for No Load / Oil Pressure Check and Operability Test are Hidden
                        excelWorksheet.Rows(33).EntireRow.Hidden = True
                        excelWorksheet.Rows(34).EntireRow.Hidden = True

                        currentSheet = "DETAILS"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        excelWorksheet.Cells(16, 7).Value = "1.I"
                        excelWorksheet.Cells(16, 8).Value = "1.I.(1.1)"
                        excelWorksheet.Cells(16, 9).Value = "1.J.(1).(a)"

                        excelWorksheet.Cells(16, 10).Value = "1.J.(1).(c)"
                        excelWorksheet.Cells(16, 11).Value = "1.J.(1).(e)"

                        excelWorksheet.Cells(16, 12).Value = "N/A"
                        excelWorksheet.Cells(16, 12).Interior.ColorIndex = 15

                        excelWorksheet.Cells(16, 13).Value = "N/A"
                        excelWorksheet.Cells(16, 13).Interior.ColorIndex = 15

                        excelWorksheet.Cells(16, 14).Value = "1.J.(4).(c)"
                        excelWorksheet.Cells(16, 15).Value = "1.J.(4).(e)"
                        excelWorksheet.Cells(16, 16).Value = "1.J.(4).(g)"
                        excelWorksheet.Cells(16, 17).Value = "1.J.(4).(i)"
                        excelWorksheet.Cells(16, 18).Value = "1.J.(4).(k)"
                        excelWorksheet.Cells(16, 19).Value = "1.K"
                        excelWorksheet.Cells(16, 20).Value = "1.K.(8)"

                        TestReport.NoValue = True
                        ChineWriteCommonDataForSheet2(excelSheets, 12) ' not a valid POINT_1G in repair
                        ChineWriteCommonDataForSheet2(excelSheets, 13) ' not a valid POINT_1H in repair

                        'First, in the repair report, we need to hide the columns related for test 1G and 1H
                        excelWorksheet.Columns("L").EntireColumn.Hidden = True
                        excelWorksheet.Columns("M").EntireColumn.Hidden = True
                        'Secondly, in the repair report, row for the P_OIL_MIN and P_OIL_MAX are also hidden
                        excelWorksheet.Rows(37).EntireRow.Hidden = True
                        excelWorksheet.Rows(38).EntireRow.Hidden = True

                    End If

                    currentSheet = "ACCEPTANCE"
                    excelWorksheet = excelSheets.Item(currentSheet)

                End If

                Select Case TestStepNumber
                    Case eTestStepAPS2X00.POINT_M1

                        TestReport.NoValue = False
                        TestReport.NoValueParam = True
                        TestReport.NoCorrectionSpeed = True
                        TestReport.NoEGTSetPoint = True
                        TestReport.NoOILVib = True
                        TestReport.NoPoilMinMax = True
                        TestReport.NoCorrectionBleed = True
                        TestReport.NoEvent1 = False
                        TestReport.NoEvent2 = True
                        TestReport.NoOilFromArinc = True

                    Case eTestStepAPS2X00.POINT_M2

                        TestReport.NoValue = False
                        TestReport.NoValueParam = True
                        TestReport.NoCorrectionSpeed = True
                        TestReport.NoEGTSetPoint = True
                        TestReport.NoOILVib = True
                        TestReport.NoPoilMinMax = True
                        TestReport.NoCorrectionBleed = True
                        TestReport.NoEvent1 = True
                        TestReport.NoEvent2 = False
                        TestReport.NoOilFromArinc = True

                    Case eTestStepAPS2X00.POINT_F, eTestStepAPS2X00.POINT_1A, eTestStepAPS2X00.POINT_1D, eTestStepAPS2X00.POINT_1E

                        TestReport.NoValue = False
                        TestReport.NoValueParam = False
                        TestReport.NoCorrectionSpeed = True
                        TestReport.NoEGTSetPoint = True
                        TestReport.NoOILVib = False
                        TestReport.NoPoilMinMax = True
                        TestReport.NoCorrectionBleed = True
                        TestReport.NoEvent1 = True
                        TestReport.NoEvent2 = True
                        TestReport.NoOilFromArinc = True

                    Case eTestStepAPS2X00.POINT_1G

                        TestReport.NoValue = (PerformanceReportSelected = ePerfReportAPS2X00.Repair)
                        TestReport.NoValueParam = False
                        TestReport.NoCorrectionSpeed = True
                        TestReport.NoEGTSetPoint = True
                        TestReport.NoOILVib = False
                        TestReport.NoPoilMinMax = False
                        TestReport.NoCorrectionBleed = True
                        TestReport.NoEvent1 = True
                        TestReport.NoEvent2 = True
                        TestReport.NoOilFromArinc = True

                    Case eTestStepAPS2X00.POINT_1H

                        TestReport.NoValue = (PerformanceReportSelected = ePerfReportAPS2X00.Repair)
                        TestReport.NoValueParam = False
                        TestReport.NoCorrectionSpeed = True
                        TestReport.NoEGTSetPoint = True
                        TestReport.NoOILVib = False
                        TestReport.NoPoilMinMax = True
                        TestReport.NoCorrectionBleed = True
                        TestReport.NoEvent1 = True
                        TestReport.NoEvent2 = True
                        TestReport.NoOilFromArinc = True

                    Case eTestStepAPS2X00.POINT_2B

                        TestReport.NoValue = False
                        TestReport.NoValueParam = False
                        TestReport.NoCorrectionSpeed = False
                        TestReport.NoEGTSetPoint = False
                        TestReport.NoOILVib = False
                        TestReport.NoPoilMinMax = True
                        TestReport.NoCorrectionBleed = True
                        TestReport.NoEvent1 = True
                        TestReport.NoEvent2 = True
                        TestReport.NoOilFromArinc = True

                    Case eTestStepAPS2X00.POINT_2C, eTestStepAPS2X00.POINT_2D, eTestStepAPS2X00.POINT_2E

                        TestReport.NoValue = False
                        TestReport.NoValueParam = False
                        TestReport.NoCorrectionSpeed = False
                        TestReport.NoEGTSetPoint = True
                        TestReport.NoOILVib = False
                        TestReport.NoPoilMinMax = True
                        TestReport.NoCorrectionBleed = False
                        TestReport.NoEvent1 = True
                        TestReport.NoEvent2 = True
                        TestReport.NoOilFromArinc = True

                    Case eTestStepAPS2X00.POINT_2F

                        TestReport.NoValue = False
                        TestReport.NoValueParam = False
                        TestReport.NoCorrectionSpeed = False
                        TestReport.NoEGTSetPoint = True
                        TestReport.NoOILVib = False
                        TestReport.NoPoilMinMax = True
                        TestReport.NoCorrectionBleed = True
                        TestReport.NoEvent1 = True
                        TestReport.NoEvent2 = True
                        TestReport.NoOilFromArinc = True

                    Case eTestStepAPS2X00.LEAK_CHECK

                        TestReport.NoValue = False
                        TestReport.NoValueParam = False
                        TestReport.NoCorrectionSpeed = True
                        TestReport.NoEGTSetPoint = True
                        TestReport.NoOILVib = True
                        TestReport.NoPoilMinMax = True
                        TestReport.NoCorrectionBleed = True
                        TestReport.NoEvent1 = True
                        TestReport.NoEvent2 = True
                        TestReport.NoOilFromArinc = False

                End Select


                Select Case TestStepNumber

                    Case eTestStepAPS2X00.POINT_M1

                        ChineWriteCommonDataForSheet2(excelSheets, 7)

                    Case eTestStepAPS2X00.POINT_F

                        ChineWriteCommonDataForSheet2(excelSheets, 8)

                    Case eTestStepAPS2X00.POINT_1A

                        ChineWriteCommonDataForSheet2(excelSheets, 9)

                    Case eTestStepAPS2X00.RD_TIME

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Detail

                        'Performed Test Details section
                        excelWorksheet.Cells(30, 9).Value = LOG_PERF_RUNDOWN_TIME_SEC.Value.ToString(LOG_PERF_RUNDOWN_TIME_SEC.Format, Nothing)

                    Case eTestStepAPS2X00.POINT_1D

                        ChineWriteCommonDataForSheet2(excelSheets, 10)

                    Case eTestStepAPS2X00.POINT_1E

                        ChineWriteCommonDataForSheet2(excelSheets, 11)

                    Case eTestStepAPS2X00.POINT_1G

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Performed Test Details section
                        If CELProject.IsTrue(LOG_PERF_OILTEST.Value) Then
                            excelWorksheet.Cells(33, 9).Value = "PASSED"
                        Else
                            excelWorksheet.Cells(33, 9).Value = "FAILED"
                        End If

                        ChineWriteCommonDataForSheet2(excelSheets, 12)

                    Case eTestStepAPS2X00.POINT_1H

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Performed Test Details section
                        If CELProject.IsTrue(LOG_PERF_OPSTEST.Value) Then
                            excelWorksheet.Cells(34, 9).Value = "PASSED"
                        Else
                            excelWorksheet.Cells(34, 9).Value = "FAILED"
                        End If

                        ChineWriteCommonDataForSheet2(excelSheets, 13)

                    Case eTestStepAPS2X00.POINT_2B

                        'If speed is incorrect, no point taken, but a warning message
                        If (CELProject.IsTrue(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_COLD.Value) Or CELProject.IsFalse(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_HOT.Value)) Then
                            MessageBox.Show("Error: Incorrect speed for this inlet temperature." & vbCrLf & "       Performance Point will not be taken.", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            Exit Select
                        End If

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Bleed Flow limit
                        If CELProject.EngineModel = "APS2300" Then
                            If (PerformanceReportSelected = ePerfReportAPS2X00.Repair) Then
                                excelWorksheet.Cells(21, 5).Value = "144.1 MINIMUM"
                            ElseIf (PerformanceReportSelected = ePerfReportAPS2X00.Production) Then
                                excelWorksheet.Cells(21, 5).Value = "151.7 MINIMUM"
                            End If
                        ElseIf CELProject.EngineModel = "APS2600A" Then
                            excelWorksheet.Cells(21, 5).Value = "151.7 MINIMUM"
                        End If

                        excelWorksheet.Cells(21, 6).Value = LOG_PERF_WB_COR_2B.Value.ToString(LOG_PERF_WB_COR_2B.Format, Nothing)

                        ChineWriteCommonDataForSheet2(excelSheets, 14)

                    Case eTestStepAPS2X00.POINT_2C

                        'If speed is incorrect, no point taken, but a warning message
                        If (CELProject.IsTrue(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_COLD.Value) Or CELProject.IsFalse(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_HOT.Value)) Then
                            MessageBox.Show("Error: Incorrect speed for this inlet temperature." & vbCrLf & "       Performance Point will not be taken.", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            Exit Select
                        End If

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        If Not (Double.IsNaN(PB_2C.Value.ToDouble) Or Double.IsNaN(PB_2D.Value.ToDouble) Or Double.IsNaN(PB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(20, 8).Value = LOG_PERF_PB_CORR.Value.ToString(LOG_PERF_PB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WB_2C.Value.ToDouble) Or Double.IsNaN(WB_2D.Value.ToDouble) Or Double.IsNaN(WB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(21, 8).Value = LOG_PERF_WB_FLW_FN.Value.ToString(LOG_PERF_WB_FLW_FN.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(TB_2C.Value.ToDouble) Or Double.IsNaN(TB_2D.Value.ToDouble) Or Double.IsNaN(TB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(23, 8).Value = LOG_PERF_TB_CORR.Value.ToString(LOG_PERF_TB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(EGT_2C.Value.ToDouble) Or Double.IsNaN(EGT_2D.Value.ToDouble) Or Double.IsNaN(EGT_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(23, 8).Value = LOG_PERF_EGT_CORR.Value.ToString(LOG_PERF_EGT_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WF_2C.Value.ToDouble) Or Double.IsNaN(WF_2D.Value.ToDouble) Or Double.IsNaN(WF_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(24, 8).Value = LOG_PERF_WF_CORR.Value.ToString(LOG_PERF_WF_CORR.Format, Nothing)
                        End If

                        ChineWriteCommonDataForSheet2(excelSheets, 15)

                    Case eTestStepAPS2X00.POINT_2D

                        'If speed is incorrect, no point taken, but a warning message
                        If (CELProject.IsTrue(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_COLD.Value) Or CELProject.IsFalse(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_HOT.Value)) Then
                            MessageBox.Show("Error: Incorrect speed for this inlet temperature." & vbCrLf & "       Performance Point will not be taken.", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            Exit Select
                        End If

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        If Not (Double.IsNaN(PB_2C.Value.ToDouble) Or Double.IsNaN(PB_2D.Value.ToDouble) Or Double.IsNaN(PB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(20, 8).Value = LOG_PERF_PB_CORR.Value.ToString(LOG_PERF_PB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WB_2C.Value.ToDouble) Or Double.IsNaN(WB_2D.Value.ToDouble) Or Double.IsNaN(WB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(21, 8).Value = LOG_PERF_WB_FLW_FN.Value.ToString(LOG_PERF_WB_FLW_FN.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(TB_2C.Value.ToDouble) Or Double.IsNaN(TB_2D.Value.ToDouble) Or Double.IsNaN(TB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(22, 8).Value = LOG_PERF_TB_CORR.Value.ToString(LOG_PERF_TB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(EGT_2C.Value.ToDouble) Or Double.IsNaN(EGT_2D.Value.ToDouble) Or Double.IsNaN(EGT_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(23, 8).Value = LOG_PERF_EGT_CORR.Value.ToString(LOG_PERF_EGT_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WF_2C.Value.ToDouble) Or Double.IsNaN(WF_2D.Value.ToDouble) Or Double.IsNaN(WF_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(24, 8).Value = LOG_PERF_WF_CORR.Value.ToString(LOG_PERF_WF_CORR.Format, Nothing)
                        End If

                        ChineWriteCommonDataForSheet2(excelSheets, 16)

                    Case eTestStepAPS2X00.POINT_2E

                        'If speed is incorrect, no point taken, but a warning message
                        If (CELProject.IsTrue(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_COLD.Value) Or CELProject.IsFalse(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_HOT.Value)) Then
                            MessageBox.Show("Error: Incorrect speed for this inlet temperature." & vbCrLf & "       Performance Point will not be taken.", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            Exit Select
                        End If

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        If Not (Double.IsNaN(PB_2C.Value.ToDouble) Or Double.IsNaN(PB_2D.Value.ToDouble) Or Double.IsNaN(PB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(20, 8).Value = LOG_PERF_PB_CORR.Value.ToString(LOG_PERF_PB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WB_2C.Value.ToDouble) Or Double.IsNaN(WB_2D.Value.ToDouble) Or Double.IsNaN(WB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(21, 8).Value = LOG_PERF_WB_FLW_FN.Value.ToString(LOG_PERF_WB_FLW_FN.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(TB_2C.Value.ToDouble) Or Double.IsNaN(TB_2D.Value.ToDouble) Or Double.IsNaN(TB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(22, 8).Value = LOG_PERF_TB_CORR.Value.ToString(LOG_PERF_TB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(EGT_2C.Value.ToDouble) Or Double.IsNaN(EGT_2D.Value.ToDouble) Or Double.IsNaN(EGT_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(23, 8).Value = LOG_PERF_EGT_CORR.Value.ToString(LOG_PERF_EGT_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WF_2C.Value.ToDouble) Or Double.IsNaN(WF_2D.Value.ToDouble) Or Double.IsNaN(WF_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(24, 8).Value = LOG_PERF_WF_CORR.Value.ToString(LOG_PERF_WF_CORR.Format, Nothing)
                        End If

                        ChineWriteCommonDataForSheet2(excelSheets, 17)

                    Case eTestStepAPS2X00.POINT_2F

                        'If speed is incorrect, no point taken, but a warning message
                        If (CELProject.IsTrue(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_COLD.Value) Or CELProject.IsFalse(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_HOT.Value)) Then
                            MessageBox.Show("Error: Incorrect speed for this inlet temperature." & vbCrLf & "       Performance Point will not be taken.", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            Exit Select
                        End If

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        excelWorksheet.Cells(23, 10).Value = LOG_PERF_EGT_CORR_2F.Value.ToString(LOG_PERF_EGT_CORR_2F.Format, Nothing)

                        ChineWriteCommonDataForSheet2(excelSheets, 18)

                    Case eTestStepAPS2X00.START_QUALITY_CHECK

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Detail

                        'Performed Test Details section
                        excelWorksheet.Cells(31, 9).Value = LOG_PERF_CRANKING_TIME_SEC.Value.ToString(LOG_PERF_CRANKING_TIME_SEC.Format, Nothing)
                        excelWorksheet.Cells(32, 9).Value = LOG_PERF_STARTING_TIME_SEC.Value.ToString(LOG_PERF_STARTING_TIME_SEC.Format, Nothing)

                    Case eTestStepAPS2X00.LEAK_CHECK

                        ChineWriteCommonDataForSheet2(excelSheets, 19)

                    Case eTestStepAPS2X00.POINT_M2

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Detail

                        'Performed Test Details section
                        excelWorksheet.Cells(35, 9).Value = LOG_PERF_NUMBER_OF_STARTS.Value.ToString(LOG_PERF_NUMBER_OF_STARTS.Format, Nothing)

                        excelWorksheet.Cells(36, 9).Value = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format, Nothing)

                        excelWorksheet.Cells(37, 9).Value = LOG_PERF_NBAPUFAULTS.Value.ToString()

                        ChineWriteCommonDataForSheet2(excelSheets, 20)

                    Case eTestStepAPS2X00.FINAL_DATA

                        currentSheet = "ACCEPTANCE"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Result
                        If CELProject.IsTrue(PERF_TEST_RESULT_ACCEPTED.Value) Then
                            excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                        Else
                            excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                        End If

                        If CELProject.IsTrue(PERF_TEST_RESULT_REJECTED.Value) Then
                            excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                        Else
                            excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                        End If

                End Select

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile11813: " + ex.ToString())
                MessageBox.Show(ex.ToString)
                CreatePerformanceFile11813 = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)
            End Try

        End Function

        Private Sub ChineWriteCommonDataForSheet2(ByVal excelSheets As Excel.Sheets, ByVal Column As Integer)

            Try
                Dim excelWorksheet As Excel.Worksheet
                Dim i As Integer

                excelWorksheet = excelSheets.Item("DETAILS")

                If TestReport.NoValue Then

                    For i = 18 To 57
                        excelWorksheet.Cells(i, Column).Value = "N/A"
                        excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                    Next

                Else

                    If TestReport.NoValueParam Then  'Data coming from sensor = N/A
                        For i = 18 To 20
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(18, Column).Value = LOG_PERF_OPERATING_TIME_CURRENT_MINUTES.Value.ToString(LOG_PERF_OPERATING_TIME_CURRENT_MINUTES.Format, Nothing)
                        excelWorksheet.Cells(19, Column).Value = LOG_PERF_P_BARO_PSIA.Value.ToString(LOG_PERF_P_BARO_PSIA.Format, Nothing)
                        excelWorksheet.Cells(20, Column).Value = LOG_PERF_NG_DIAL_PCT.Value.ToString(LOG_PERF_NG_DIAL_PCT.Format, Nothing)
                    End If

                    If TestReport.NoCorrectionSpeed Then
                        excelWorksheet.Cells(21, Column).Value = "N/A"
                        excelWorksheet.Cells(21, Column).Interior.ColorIndex = 15
                    Else
                        excelWorksheet.Cells(21, Column).Value = LOG_PERF_N_CORR.Value.ToString(LOG_PERF_N_CORR.Format, Nothing)
                    End If

                    If TestReport.NoValueParam Then  'Data coming from sensor = N/A
                        For i = 22 To 32
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(22, Column).Value = LOG_PERF_NG_RPM.Value.ToString(LOG_PERF_NG_RPM.Format, Nothing)
                        excelWorksheet.Cells(23, Column).Value = LOG_PERF_WF_AVG_PPH.Value.ToString(LOG_PERF_WF_AVG_PPH.Format, Nothing)
                        excelWorksheet.Cells(24, Column).Value = LOG_PERF_P_FUEL_PSIG.Value.ToString(LOG_PERF_P_FUEL_PSIG.Format, Nothing)
                        excelWorksheet.Cells(25, Column).Value = LOG_PERF_T_CELL_DEGF.Value.ToString(LOG_PERF_T_CELL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(26, Column).Value = LOG_PERF_T_INLET_AVG_DEGF.Value.ToString(LOG_PERF_T_INLET_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(27, Column).Value = LOG_PERF_P_INLET_PSIG.Value.ToString(LOG_PERF_P_INLET_PSIG.Format, Nothing)
                        excelWorksheet.Cells(28, Column).Value = LOG_PERF_P_EXHAUST_PSIG.Value.ToString(LOG_PERF_P_EXHAUST_PSIG.Format, Nothing)
                        excelWorksheet.Cells(29, Column).Value = LOG_PERF_T_EGT_ETC1_DEGF.Value.ToString(LOG_PERF_T_EGT_ETC1_DEGF.Format, Nothing)
                        excelWorksheet.Cells(30, Column).Value = LOG_PERF_T_EGT_ETC2_DEGF.Value.ToString(LOG_PERF_T_EGT_ETC2_DEGF.Format, Nothing)
                        excelWorksheet.Cells(31, Column).Value = LOG_PERF_T_EGT_ETC_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_ETC_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(32, Column).Value = LOG_PERF_T_EGT_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_AVG_DEGF.Format, Nothing)
                    End If

                    If TestReport.NoEGTSetPoint Then
                        excelWorksheet.Cells(33, Column).Value = "N/A"
                        excelWorksheet.Cells(33, Column).Interior.ColorIndex = 15
                    Else
                        excelWorksheet.Cells(33, Column).Value = LOG_PERF_TEX_AVG_SP.Value.ToString(LOG_PERF_TEX_AVG_SP.Format, Nothing)
                    End If

                    If TestReport.NoOILVib Then
                        For i = 34 To 36
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(34, Column).Value = LOG_PERF_P_CD_PSIG.Value.ToString(LOG_PERF_P_CD_PSIG.Format, Nothing)

                        If (CELProject.IsTrue(OIL_SHUTDOWN_BYPASS_BTN.Value)) Then
                            excelWorksheet.Cells(35, Column).Value = "NaN"
                            excelWorksheet.Cells(36, Column).Value = "NaN"
                        Else
                            excelWorksheet.Cells(35, Column).Value = LOG_PERF_T_OIL_DEGF.Value.ToString(LOG_PERF_T_OIL_DEGF.Format, Nothing)
                            excelWorksheet.Cells(36, Column).Value = LOG_PERF_P_OIL_PSIG.Value.ToString(LOG_PERF_P_OIL_PSIG.Format, Nothing)
                        End If
                    End If

                    If TestReport.NoPoilMinMax Then
                        For i = 37 To 38
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(37, Column).Value = LOG_PERF_P_OIL_LO_LIMIT_PSIG.Value.ToString(LOG_PERF_P_OIL_LO_LIMIT_PSIG.Format, Nothing)
                        excelWorksheet.Cells(38, Column).Value = LOG_PERF_P_OIL_HI_LIMIT_PSIG.Value.ToString(LOG_PERF_P_OIL_HI_LIMIT_PSIG.Format, Nothing)
                    End If

                    If TestReport.NoOILVib Then  'Data coming from sensor = N/A
                        For i = 39 To 40
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(39, Column).Value = LOG_PERF_VIB_POWERHEAD_G.Value.ToString(LOG_PERF_VIB_POWERHEAD_G.Format, Nothing)
                        excelWorksheet.Cells(40, Column).Value = LOG_PERF_VIB_GEARBOX_G.Value.ToString(LOG_PERF_VIB_GEARBOX_G.Format, Nothing)
                    End If

                    Dim CurrentAvg As Double = (LOG_PERF_LB1_CURRENT_IA.Value.ToDouble + LOG_PERF_LB1_CURRENT_IB.Value.ToDouble + LOG_PERF_LB1_CURRENT_IC.Value.ToDouble) / 3.0
                    Dim VoltAvg As Double = (LOG_PERF_LB1_VOLTAGE_VAB.Value.ToDouble + LOG_PERF_LB1_VOLTAGE_VBC.Value.ToDouble + LOG_PERF_LB1_VOLTAGE_VCA.Value.ToDouble) / 3.0


                    If TestReport.NoValueParam Then  'Data coming from sensor = N/A
                        For i = 41 To 49
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(41, Column).Value = VoltAvg.ToString(LOG_PERF_LB1_VOLTAGE_VAB.Format, Nothing)
                        excelWorksheet.Cells(42, Column).Value = CurrentAvg.ToString(LOG_PERF_LB1_CURRENT_IA.Format, Nothing)
                        excelWorksheet.Cells(43, Column).Value = LOG_PERF_LB1_POWER_TOT.Value.ToString(LOG_PERF_LB1_POWER_TOT.Format, Nothing)
                        excelWorksheet.Cells(44, Column).Value = LOG_PERF_T_BLEED_DEGF.Value.ToString(LOG_PERF_T_BLEED_DEGF.Format, Nothing)
                        excelWorksheet.Cells(45, Column).Value = LOG_PERF_P_BLEED_PSIG.Value.ToString(LOG_PERF_P_BLEED_PSIG.Format, Nothing)
                        excelWorksheet.Cells(46, Column).Value = LOG_PERF_P_ORIFICE_PSIA.Value.ToString(LOG_PERF_P_ORIFICE_PSIA.Format, Nothing)
                        excelWorksheet.Cells(47, Column).Value = LOG_PERF_P_ORIFICE_DELTA_H2OD.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_H2OD.Format, Nothing)
                        excelWorksheet.Cells(48, Column).Value = LOG_PERF_T_ORIFICE_DEGF.Value.ToString(LOG_PERF_T_ORIFICE_DEGF.Format, Nothing)
                        excelWorksheet.Cells(49, Column).Value = LOG_PERF_WB_PPM.Value.ToString(LOG_PERF_WB_PPM.Format, Nothing)
                    End If

                    If TestReport.NoCorrectionBleed Then
                        excelWorksheet.Cells(50, Column).Value = "N/A"
                        excelWorksheet.Cells(50, Column).Interior.ColorIndex = 15
                    Else
                        excelWorksheet.Cells(50, Column).Value = LOG_PERF_WB_FLW_FN.Value.ToString(LOG_PERF_WB_FLW_FN.Format, Nothing)
                    End If

                    If TestReport.NoOilFromArinc Then
                        For i = 51 To 53
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(51, Column).Value = LOG_PERF_INPUT_TO_APUOIL.Value.ToString()
                        excelWorksheet.Cells(52, Column).Value = LOG_PERF_INPUT_PO_APUFIL.Value.ToString()
                        excelWorksheet.Cells(53, Column).Value = LOG_PERF_INPUT_PO_APUSYS.Value.ToString()
                    End If

                    If TestReport.NoEvent1 Then
                        For i = 54 To 55
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(54, Column).Value = LOG_PERF_EVENT_1.Value.ToString(LOG_PERF_EVENT_1.Format, Nothing)
                        excelWorksheet.Cells(55, Column).Value = LOG_PERF_HR_MTR_1.Value.ToString(LOG_PERF_HR_MTR_1.Format, Nothing)
                    End If

                    If TestReport.NoEvent2 Then
                        For i = 56 To 57
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(56, Column).Value = LOG_PERF_EVENT_2.Value.ToString(LOG_PERF_EVENT_2.Format, Nothing)
                        excelWorksheet.Cells(57, Column).Value = LOG_PERF_HR_MTR_2.Value.ToString(LOG_PERF_HR_MTR_2.Format, Nothing)
                    End If

                End If

            Catch Ex As Exception
                MessageBox.Show("ChineWriteCommonDataForSheet2: " & Ex.ToString())
            End Try
        End Sub

        Private Function CreatePerformanceFile12958(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim currentSheet As String
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreatePerformanceFile12958 = True

            Try

                ' The following gets the Worksheets collection
                excelSheets = excelWorkbook.Worksheets
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    currentSheet = "SUMMARY"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    'Report Title
                    If PerformanceReportSelected = ePerfReportAPS2X00.Production Then
                        excelWorksheet.Cells(1, 5).Value = CELProject.EngineModel + " PRODUCTION TEST DATA SHEET"
                    ElseIf PerformanceReportSelected = ePerfReportAPS2X00.Repair Then
                        excelWorksheet.Cells(1, 5).Value = CELProject.EngineModel + " REPAIR TEST DATA SHEET"
                    End If

                    'Customer
                    excelWorksheet.Cells(5, 3).NumberFormat = "@"
                    excelWorksheet.Cells(5, 3).Value = UserInputs12958.CustomerName

                    'Work Order
                    excelWorksheet.Cells(6, 3).NumberFormat = "@"
                    excelWorksheet.Cells(6, 3).Value = UserInputs12958.WorkOrder

                    'Engine P/N
                    excelWorksheet.Cells(7, 3).NumberFormat = "@"
                    excelWorksheet.Cells(7, 3).Value = UserInputs12958.PartNumber

                    'Engine S/N
                    excelWorksheet.Cells(8, 3).NumberFormat = "@"
                    excelWorksheet.Cells(8, 3).Value = UserInputs12958.SerialNumber

                    'Repair Type
                    excelWorksheet.Cells(9, 3).NumberFormat = "@"
                    excelWorksheet.Cells(9, 3).Value = UserInputs12958.ChoiceRepairType

                    'Test Type
                    excelWorksheet.Cells(10, 3).NumberFormat = "@"
                    excelWorksheet.Cells(10, 3).Value = UserInputs12958.ChoiceTestType

                    'TSO
                    excelWorksheet.Cells(11, 3).NumberFormat = "@"
                    excelWorksheet.Cells(11, 3).Value = UserInputs12958.TSO

                    'Date
                    excelWorksheet.Cells(5, 9).NumberFormat = "@"
                    excelWorksheet.Cells(5, 9).Value = Format(Now, "d MMMM yyyy")

                    'LHV
                    excelWorksheet.Cells(6, 9).NumberFormat = "@"
                    excelWorksheet.Cells(6, 9).Value = UserInputs12958.LHV

                    'Sample SG
                    excelWorksheet.Cells(7, 9).NumberFormat = "@"
                    excelWorksheet.Cells(7, 9).Value = UserInputs12958.SampleFuelSg

                    'Sample T Fuel
                    excelWorksheet.Cells(8, 9).NumberFormat = "@"
                    excelWorksheet.Cells(8, 9).Value = UserInputs12958.SampleTFuel

                    'Fuel Type
                    excelWorksheet.Cells(9, 9).NumberFormat = "@"
                    excelWorksheet.Cells(9, 9).Value = UserInputs12958.FuelType

                    'Oil Type
                    excelWorksheet.Cells(10, 9).NumberFormat = "@"
                    excelWorksheet.Cells(10, 9).Value = UserInputs12958.OilType

                    currentSheet = "ACCEPTANCE"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    'Document Number
                    excelWorksheet.Cells(46, 3).NumberFormat = "@"

                    Select Case EngineConfiguration.PerformanceReportType
                        Case "Production"
                            excelWorksheet.Cells(46, 3).Value = Custom_Parameters("APUTestedAccordingTo_HS_Production").ToString()
                        Case "Repair"
                            excelWorksheet.Cells(46, 3).Value = Custom_Parameters("APUTestedAccordingTo_HS_Repair").ToString()
                    End Select

                    currentSheet = "SUMMARY"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    'Set the Performance Run 2C-2D-2E Limits
                    If (PerformanceReportSelected = ePerfReportAPS2X00.Repair) Then
                        excelWorksheet.Cells(20, 7).Value = LOG_PERF_PB_MIN_R.Value.ToString(LOG_PERF_PB_MIN_R.Format, Nothing) + " MINIMUM"
                        excelWorksheet.Cells(22, 7).Value = LOG_PERF_TB_MAX_R.Value.ToString(LOG_PERF_TB_MAX_R.Format, Nothing) + " MAXIMUM"
                        excelWorksheet.Cells(23, 7).Value = LOG_PERF_EGT_MAX_R.Value.ToString(LOG_PERF_EGT_MAX_R.Format, Nothing) + " MAXIMUM"
                        excelWorksheet.Cells(24, 7).Value = LOG_PERF_WF_MAX_R.Value.ToString(LOG_PERF_WF_MAX_R.Format, Nothing) + " MAXIMUM"

                        excelWorksheet.Cells(23, 9).Value = LOG_PERF_EGT_MAX_R_2F.Value.ToString(LOG_PERF_EGT_MAX_R_2F.Format, Nothing) + " MAXIMUM"

                    ElseIf (PerformanceReportSelected = ePerfReportAPS2X00.Production) Then
                        excelWorksheet.Cells(20, 7).Value = LOG_PERF_PB_MIN.Value.ToString(LOG_PERF_PB_MIN.Format, Nothing) + " MINIMUM"
                        excelWorksheet.Cells(22, 7).Value = LOG_PERF_TB_MAX.Value.ToString(LOG_PERF_TB_MAX.Format, Nothing) + " MAXIMUM"
                        excelWorksheet.Cells(23, 7).Value = LOG_PERF_EGT_MAX.Value.ToString(LOG_PERF_EGT_MAX.Format, Nothing) + " MAXIMUM"
                        excelWorksheet.Cells(24, 7).Value = LOG_PERF_WF_MAX.Value.ToString(LOG_PERF_WF_MAX.Format, Nothing) + " MAXIMUM"

                        excelWorksheet.Cells(23, 9).Value = LOG_PERF_EGT_MAX_2F.Value.ToString(LOG_PERF_EGT_MAX_2F.Format, Nothing) + " MAXIMUM"
                    End If

                    'Change the Test Steps in case of a Repair
                    If (PerformanceReportSelected = ePerfReportAPS2X00.Repair) Then

                        currentSheet = "DETAILS"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'in the repair report, row for the P_OIL_MIN and P_OIL_MAX are also hidden
                        excelWorksheet.Rows(37).EntireRow.Hidden = True
                        excelWorksheet.Rows(38).EntireRow.Hidden = True

                    End If

                    currentSheet = "ACCEPTANCE"
                    excelWorksheet = excelSheets.Item(currentSheet)

                End If

                Select Case TestStepNumber
                    Case eTestStepAPS2X00.POINT_1A, eTestStepAPS2X00.POINT_1D, eTestStepAPS2X00.POINT_1E

                        TestReport.NoValue = False
                        TestReport.NoValueParam = False
                        TestReport.NoCorrectionSpeed = True
                        TestReport.NoEGTSetPoint = True
                        TestReport.NoOILVib = False
                        TestReport.NoPoilMinMax = True
                        TestReport.NoCorrectionBleed = True
                        TestReport.NoEvent1 = True
                        TestReport.NoEvent2 = True
                        TestReport.NoOilFromArinc = True

                    Case eTestStepAPS2X00.POINT_2B

                        TestReport.NoValue = False
                        TestReport.NoValueParam = False
                        TestReport.NoCorrectionSpeed = False
                        TestReport.NoEGTSetPoint = False
                        TestReport.NoOILVib = False
                        TestReport.NoPoilMinMax = True
                        TestReport.NoCorrectionBleed = True
                        TestReport.NoEvent1 = True
                        TestReport.NoEvent2 = True
                        TestReport.NoOilFromArinc = True

                    Case eTestStepAPS2X00.POINT_2C, eTestStepAPS2X00.POINT_2D, eTestStepAPS2X00.POINT_2E

                        TestReport.NoValue = False
                        TestReport.NoValueParam = False
                        TestReport.NoCorrectionSpeed = False
                        TestReport.NoEGTSetPoint = True
                        TestReport.NoOILVib = False
                        TestReport.NoPoilMinMax = True
                        TestReport.NoCorrectionBleed = False
                        TestReport.NoEvent1 = True
                        TestReport.NoEvent2 = True
                        TestReport.NoOilFromArinc = True

                    Case eTestStepAPS2X00.POINT_2F

                        TestReport.NoValue = False
                        TestReport.NoValueParam = False
                        TestReport.NoCorrectionSpeed = False
                        TestReport.NoEGTSetPoint = True
                        TestReport.NoOILVib = False
                        TestReport.NoPoilMinMax = True
                        TestReport.NoCorrectionBleed = True
                        TestReport.NoEvent1 = True
                        TestReport.NoEvent2 = True
                        TestReport.NoOilFromArinc = True

                End Select


                Select Case TestStepNumber

                    Case eTestStepAPS2X00.RD_TIME

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Detail

                        'Performed Test Details section
                        excelWorksheet.Cells(30, 9).Value = LOG_PERF_RUNDOWN_TIME_SEC.Value.ToString(LOG_PERF_RUNDOWN_TIME_SEC.Format, Nothing)

                    Case eTestStepAPS2X00.POINT_1A

                        EpcorWriteCommonDataForSheet2(excelSheets, 7)


                    Case eTestStepAPS2X00.POINT_1D

                        EpcorWriteCommonDataForSheet2(excelSheets, 8)

                    Case eTestStepAPS2X00.POINT_1E

                        EpcorWriteCommonDataForSheet2(excelSheets, 9)

                    Case eTestStepAPS2X00.POINT_1G

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Performed Test Details section
                        If CELProject.IsTrue(LOG_PERF_OILTEST.Value) Then
                            excelWorksheet.Cells(31, 9).Value = "PASSED"
                        Else
                            excelWorksheet.Cells(31, 9).Value = "FAILED"
                        End If

                    Case eTestStepAPS2X00.POINT_1H

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Performed Test Details section
                        If CELProject.IsTrue(LOG_PERF_OPSTEST.Value) Then
                            excelWorksheet.Cells(32, 9).Value = "PASSED"
                        Else
                            excelWorksheet.Cells(32, 9).Value = "FAILED"
                        End If

                    Case eTestStepAPS2X00.POINT_2B

                        'If speed is incorrect, no point taken, but a warning message
                        If (CELProject.IsTrue(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_COLD.Value) Or CELProject.IsFalse(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_HOT.Value)) Then
                            MessageBox.Show("Error: Incorrect speed for this inlet temperature." & vbCrLf & "       Performance Point will not be taken.", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            Exit Select
                        End If

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Bleed Flow limit
                        If CELProject.EngineModel = "APS2300" Then
                            If (PerformanceReportSelected = ePerfReportAPS2X00.Repair) Then
                                excelWorksheet.Cells(21, 5).Value = "144.1 MINIMUM"
                            ElseIf (PerformanceReportSelected = ePerfReportAPS2X00.Production) Then
                                excelWorksheet.Cells(21, 5).Value = "151.7 MINIMUM"
                            End If
                        ElseIf CELProject.EngineModel = "APS2600A" Then
                            excelWorksheet.Cells(21, 5).Value = "151.7 MINIMUM"
                        End If

                        excelWorksheet.Cells(21, 6).Value = LOG_PERF_WB_COR_2B.Value.ToString(LOG_PERF_WB_COR_2B.Format, Nothing)

                        EpcorWriteCommonDataForSheet2(excelSheets, 10)

                    Case eTestStepAPS2X00.POINT_2C

                        'If speed is incorrect, no point taken, but a warning message
                        If (CELProject.IsTrue(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_COLD.Value) Or CELProject.IsFalse(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_HOT.Value)) Then
                            MessageBox.Show("Error: Incorrect speed for this inlet temperature." & vbCrLf & "       Performance Point will not be taken.", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            Exit Select
                        End If

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        If Not (Double.IsNaN(PB_2C.Value.ToDouble) Or Double.IsNaN(PB_2D.Value.ToDouble) Or Double.IsNaN(PB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(20, 8).Value = LOG_PERF_PB_CORR.Value.ToString(LOG_PERF_PB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WB_2C.Value.ToDouble) Or Double.IsNaN(WB_2D.Value.ToDouble) Or Double.IsNaN(WB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(21, 8).Value = LOG_PERF_WB_FLW_FN.Value.ToString(LOG_PERF_WB_FLW_FN.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(TB_2C.Value.ToDouble) Or Double.IsNaN(TB_2D.Value.ToDouble) Or Double.IsNaN(TB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(23, 8).Value = LOG_PERF_TB_CORR.Value.ToString(LOG_PERF_TB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(EGT_2C.Value.ToDouble) Or Double.IsNaN(EGT_2D.Value.ToDouble) Or Double.IsNaN(EGT_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(23, 8).Value = LOG_PERF_EGT_CORR.Value.ToString(LOG_PERF_EGT_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WF_2C.Value.ToDouble) Or Double.IsNaN(WF_2D.Value.ToDouble) Or Double.IsNaN(WF_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(24, 8).Value = LOG_PERF_WF_CORR.Value.ToString(LOG_PERF_WF_CORR.Format, Nothing)
                        End If

                        EpcorWriteCommonDataForSheet2(excelSheets, 11)

                    Case eTestStepAPS2X00.POINT_2D

                        'If speed is incorrect, no point taken, but a warning message
                        If (CELProject.IsTrue(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_COLD.Value) Or CELProject.IsFalse(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_HOT.Value)) Then
                            MessageBox.Show("Error: Incorrect speed for this inlet temperature." & vbCrLf & "       Performance Point will not be taken.", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            Exit Select
                        End If

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        If Not (Double.IsNaN(PB_2C.Value.ToDouble) Or Double.IsNaN(PB_2D.Value.ToDouble) Or Double.IsNaN(PB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(20, 8).Value = LOG_PERF_PB_CORR.Value.ToString(LOG_PERF_PB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WB_2C.Value.ToDouble) Or Double.IsNaN(WB_2D.Value.ToDouble) Or Double.IsNaN(WB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(21, 8).Value = LOG_PERF_WB_FLW_FN.Value.ToString(LOG_PERF_WB_FLW_FN.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(TB_2C.Value.ToDouble) Or Double.IsNaN(TB_2D.Value.ToDouble) Or Double.IsNaN(TB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(22, 8).Value = LOG_PERF_TB_CORR.Value.ToString(LOG_PERF_TB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(EGT_2C.Value.ToDouble) Or Double.IsNaN(EGT_2D.Value.ToDouble) Or Double.IsNaN(EGT_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(23, 8).Value = LOG_PERF_EGT_CORR.Value.ToString(LOG_PERF_EGT_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WF_2C.Value.ToDouble) Or Double.IsNaN(WF_2D.Value.ToDouble) Or Double.IsNaN(WF_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(24, 8).Value = LOG_PERF_WF_CORR.Value.ToString(LOG_PERF_WF_CORR.Format, Nothing)
                        End If

                        EpcorWriteCommonDataForSheet2(excelSheets, 12)

                    Case eTestStepAPS2X00.POINT_2E

                        'If speed is incorrect, no point taken, but a warning message
                        If (CELProject.IsTrue(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_COLD.Value) Or CELProject.IsFalse(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_HOT.Value)) Then
                            MessageBox.Show("Error: Incorrect speed for this inlet temperature." & vbCrLf & "       Performance Point will not be taken.", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            Exit Select
                        End If

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        If Not (Double.IsNaN(PB_2C.Value.ToDouble) Or Double.IsNaN(PB_2D.Value.ToDouble) Or Double.IsNaN(PB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(20, 8).Value = LOG_PERF_PB_CORR.Value.ToString(LOG_PERF_PB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WB_2C.Value.ToDouble) Or Double.IsNaN(WB_2D.Value.ToDouble) Or Double.IsNaN(WB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(21, 8).Value = LOG_PERF_WB_FLW_FN.Value.ToString(LOG_PERF_WB_FLW_FN.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(TB_2C.Value.ToDouble) Or Double.IsNaN(TB_2D.Value.ToDouble) Or Double.IsNaN(TB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(22, 8).Value = LOG_PERF_TB_CORR.Value.ToString(LOG_PERF_TB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(EGT_2C.Value.ToDouble) Or Double.IsNaN(EGT_2D.Value.ToDouble) Or Double.IsNaN(EGT_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(23, 8).Value = LOG_PERF_EGT_CORR.Value.ToString(LOG_PERF_EGT_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WF_2C.Value.ToDouble) Or Double.IsNaN(WF_2D.Value.ToDouble) Or Double.IsNaN(WF_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(24, 8).Value = LOG_PERF_WF_CORR.Value.ToString(LOG_PERF_WF_CORR.Format, Nothing)
                        End If

                        EpcorWriteCommonDataForSheet2(excelSheets, 13)

                    Case eTestStepAPS2X00.POINT_2F

                        'If speed is incorrect, no point taken, but a warning message
                        If (CELProject.IsTrue(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_COLD.Value) Or CELProject.IsFalse(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_HOT.Value)) Then
                            MessageBox.Show("Error: Incorrect speed for this inlet temperature." & vbCrLf & "       Performance Point will not be taken.", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            Exit Select
                        End If

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        excelWorksheet.Cells(23, 10).Value = LOG_PERF_EGT_CORR_2F.Value.ToString(LOG_PERF_EGT_CORR_2F.Format, Nothing)

                        EpcorWriteCommonDataForSheet2(excelSheets, 14)

                    Case eTestStepAPS2X00.FINAL_DATA

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Detail

                        'Performed Test Details section
                        excelWorksheet.Cells(33, 9).Value = LOG_PERF_NUMBER_OF_STARTS.Value.ToString(LOG_PERF_NUMBER_OF_STARTS.Format, Nothing)
                        excelWorksheet.Cells(34, 9).Value = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format, Nothing)
                        excelWorksheet.Cells(35, 9).Value = LOG_PERF_NBAPUFAULTS.Value.ToString()

                        currentSheet = "ACCEPTANCE"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Result
                        If CELProject.IsTrue(PERF_TEST_RESULT_ACCEPTED.Value) Then
                            excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                        Else
                            excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                        End If

                        If CELProject.IsTrue(PERF_TEST_RESULT_REJECTED.Value) Then
                            excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                        Else
                            excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                        End If

                        excelWorksheet.Cells(58, 3).Value = UserInputs12958.ChoiceOperator
                        excelWorksheet.Cells(59, 3).Value = UserInputs12958.ChoiceInspector

                End Select

                TestProgress_RecordPerfStep(TestStepNumber)

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile12958: " + ex.ToString())
                MessageBox.Show(ex.ToString)
                CreatePerformanceFile12958 = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)
            End Try

        End Function

        Private Sub EpcorWriteCommonDataForSheet2(ByVal excelSheets As Excel.Sheets, ByVal Column As Integer)

            Try
                Dim excelWorksheet As Excel.Worksheet
                Dim i As Integer

                excelWorksheet = excelSheets.Item("DETAILS")

                If TestReport.NoValue Then

                    For i = 18 To 57
                        excelWorksheet.Cells(i, Column).Value = "N/A"
                        excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                    Next

                Else

                    If TestReport.NoValueParam Then  'Data coming from sensor = N/A
                        For i = 18 To 20
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(18, Column).Value = LOG_PERF_OPERATING_TIME_CURRENT_MINUTES.Value.ToString(LOG_PERF_OPERATING_TIME_CURRENT_MINUTES.Format, Nothing)
                        excelWorksheet.Cells(19, Column).Value = LOG_PERF_P_BARO_PSIA.Value.ToString(LOG_PERF_P_BARO_PSIA.Format, Nothing)
                        excelWorksheet.Cells(20, Column).Value = LOG_PERF_NG_DIAL_PCT.Value.ToString(LOG_PERF_NG_DIAL_PCT.Format, Nothing)
                    End If

                    If TestReport.NoCorrectionSpeed Then
                        excelWorksheet.Cells(21, Column).Value = "N/A"
                        excelWorksheet.Cells(21, Column).Interior.ColorIndex = 15
                    Else
                        excelWorksheet.Cells(21, Column).Value = LOG_PERF_N_CORR.Value.ToString(LOG_PERF_N_CORR.Format, Nothing)
                    End If

                    If TestReport.NoValueParam Then  'Data coming from sensor = N/A
                        For i = 22 To 32
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(22, Column).Value = LOG_PERF_NG_RPM.Value.ToString(LOG_PERF_NG_RPM.Format, Nothing)
                        excelWorksheet.Cells(23, Column).Value = LOG_PERF_WF_AVG_PPH.Value.ToString(LOG_PERF_WF_AVG_PPH.Format, Nothing)
                        excelWorksheet.Cells(24, Column).Value = LOG_PERF_P_FUEL_PSIG.Value.ToString(LOG_PERF_P_FUEL_PSIG.Format, Nothing)
                        excelWorksheet.Cells(25, Column).Value = LOG_PERF_T_CELL_DEGF.Value.ToString(LOG_PERF_T_CELL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(26, Column).Value = LOG_PERF_T_INLET_AVG_DEGF.Value.ToString(LOG_PERF_T_INLET_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(27, Column).Value = LOG_PERF_P_INLET_PSIG.Value.ToString(LOG_PERF_P_INLET_PSIG.Format, Nothing)
                        excelWorksheet.Cells(28, Column).Value = LOG_PERF_P_EXHAUST_PSIG.Value.ToString(LOG_PERF_P_EXHAUST_PSIG.Format, Nothing)
                        excelWorksheet.Cells(29, Column).Value = LOG_PERF_T_EGT_ETC1_DEGF.Value.ToString(LOG_PERF_T_EGT_ETC1_DEGF.Format, Nothing)
                        excelWorksheet.Cells(30, Column).Value = LOG_PERF_T_EGT_ETC2_DEGF.Value.ToString(LOG_PERF_T_EGT_ETC2_DEGF.Format, Nothing)
                        excelWorksheet.Cells(31, Column).Value = LOG_PERF_T_EGT_ETC_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_ETC_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(32, Column).Value = LOG_PERF_T_EGT_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_AVG_DEGF.Format, Nothing)
                    End If

                    If TestReport.NoEGTSetPoint Then
                        excelWorksheet.Cells(33, Column).Value = "N/A"
                        excelWorksheet.Cells(33, Column).Interior.ColorIndex = 15
                    Else
                        excelWorksheet.Cells(33, Column).Value = LOG_PERF_TEX_AVG_SP.Value.ToString(LOG_PERF_TEX_AVG_SP.Format, Nothing)
                    End If

                    If TestReport.NoOILVib Then
                        For i = 34 To 36
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(34, Column).Value = LOG_PERF_P_CD_PSIG.Value.ToString(LOG_PERF_P_CD_PSIG.Format, Nothing)

                        If (CELProject.IsTrue(OIL_SHUTDOWN_BYPASS_BTN.Value)) Then
                            excelWorksheet.Cells(35, Column).Value = "NaN"
                            excelWorksheet.Cells(36, Column).Value = "NaN"
                        Else
                            excelWorksheet.Cells(35, Column).Value = LOG_PERF_T_OIL_DEGF.Value.ToString(LOG_PERF_T_OIL_DEGF.Format, Nothing)
                            excelWorksheet.Cells(36, Column).Value = LOG_PERF_P_OIL_PSIG.Value.ToString(LOG_PERF_P_OIL_PSIG.Format, Nothing)
                        End If
                    End If

                    If TestReport.NoPoilMinMax Then
                        For i = 37 To 38
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(37, Column).Value = LOG_PERF_P_OIL_LO_LIMIT_PSIG.Value.ToString(LOG_PERF_P_OIL_LO_LIMIT_PSIG.Format, Nothing)
                        excelWorksheet.Cells(38, Column).Value = LOG_PERF_P_OIL_HI_LIMIT_PSIG.Value.ToString(LOG_PERF_P_OIL_HI_LIMIT_PSIG.Format, Nothing)
                    End If

                    If TestReport.NoOILVib Then  'Data coming from sensor = N/A
                        For i = 39 To 40
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(39, Column).Value = LOG_PERF_VIB_POWERHEAD_G.Value.ToString(LOG_PERF_VIB_POWERHEAD_G.Format, Nothing)
                        excelWorksheet.Cells(40, Column).Value = LOG_PERF_VIB_GEARBOX_G.Value.ToString(LOG_PERF_VIB_GEARBOX_G.Format, Nothing)
                    End If

                    Dim CurrentAvg As Double = (LOG_PERF_LB1_CURRENT_IA.Value.ToDouble + LOG_PERF_LB1_CURRENT_IB.Value.ToDouble + LOG_PERF_LB1_CURRENT_IC.Value.ToDouble) / 3.0
                    Dim VoltAvg As Double = (LOG_PERF_LB1_VOLTAGE_VAB.Value.ToDouble + LOG_PERF_LB1_VOLTAGE_VBC.Value.ToDouble + LOG_PERF_LB1_VOLTAGE_VCA.Value.ToDouble) / 3.0


                    If TestReport.NoValueParam Then  'Data coming from sensor = N/A
                        For i = 41 To 49
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(41, Column).Value = VoltAvg.ToString(LOG_PERF_LB1_VOLTAGE_VAB.Format, Nothing)
                        excelWorksheet.Cells(42, Column).Value = CurrentAvg.ToString(LOG_PERF_LB1_CURRENT_IA.Format, Nothing)
                        excelWorksheet.Cells(43, Column).Value = LOG_PERF_LB1_POWER_TOT.Value.ToString(LOG_PERF_LB1_POWER_TOT.Format, Nothing)
                        excelWorksheet.Cells(44, Column).Value = LOG_PERF_T_BLEED_DEGF.Value.ToString(LOG_PERF_T_BLEED_DEGF.Format, Nothing)
                        excelWorksheet.Cells(45, Column).Value = LOG_PERF_P_BLEED_PSIG.Value.ToString(LOG_PERF_P_BLEED_PSIG.Format, Nothing)
                        excelWorksheet.Cells(46, Column).Value = LOG_PERF_P_ORIFICE_PSIA.Value.ToString(LOG_PERF_P_ORIFICE_PSIA.Format, Nothing)
                        excelWorksheet.Cells(47, Column).Value = LOG_PERF_P_ORIFICE_DELTA_H2OD.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_H2OD.Format, Nothing)
                        excelWorksheet.Cells(48, Column).Value = LOG_PERF_T_ORIFICE_DEGF.Value.ToString(LOG_PERF_T_ORIFICE_DEGF.Format, Nothing)
                        excelWorksheet.Cells(49, Column).Value = LOG_PERF_WB_PPM.Value.ToString(LOG_PERF_WB_PPM.Format, Nothing)
                    End If

                    If TestReport.NoCorrectionBleed Then
                        excelWorksheet.Cells(50, Column).Value = "N/A"
                        excelWorksheet.Cells(50, Column).Interior.ColorIndex = 15
                    Else
                        excelWorksheet.Cells(50, Column).Value = LOG_PERF_WB_FLW_FN.Value.ToString(LOG_PERF_WB_FLW_FN.Format, Nothing)
                    End If

                    If TestReport.NoOilFromArinc Then
                        For i = 51 To 53
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(51, Column).Value = LOG_PERF_INPUT_TO_APUOIL.Value.ToString()
                        excelWorksheet.Cells(52, Column).Value = LOG_PERF_INPUT_PO_APUFIL.Value.ToString()
                        excelWorksheet.Cells(53, Column).Value = LOG_PERF_INPUT_PO_APUSYS.Value.ToString()
                    End If

                    If TestReport.NoEvent1 Then
                        For i = 54 To 55
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(54, Column).Value = LOG_PERF_EVENT_1.Value.ToString(LOG_PERF_EVENT_1.Format, Nothing)
                        excelWorksheet.Cells(55, Column).Value = LOG_PERF_HR_MTR_1.Value.ToString(LOG_PERF_HR_MTR_1.Format, Nothing)
                    End If

                    If TestReport.NoEvent2 Then
                        For i = 56 To 57
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(56, Column).Value = LOG_PERF_EVENT_2.Value.ToString(LOG_PERF_EVENT_2.Format, Nothing)
                        excelWorksheet.Cells(57, Column).Value = LOG_PERF_HR_MTR_2.Value.ToString(LOG_PERF_HR_MTR_2.Format, Nothing)
                    End If

                End If

            Catch Ex As Exception
                MessageBox.Show("EpcorWriteCommonDataForSheet2: " & Ex.ToString())
            End Try
        End Sub

        Private Function CreatePerformanceFile15127(ByVal AppendOption As Boolean, ByVal TestStepNumber As Integer, ByVal ProtectPassword As String, ByVal UnProtectPassword As String, ByRef excelWorkbook As Excel.Workbook) As Boolean
            'Declaration
            Dim currentSheet As String
            Dim excelSheets As Excel.Sheets
            Dim excelWorksheet As Excel.Worksheet

            CreatePerformanceFile15127 = True

            Try

                ' The following gets the Worksheets collection
                excelSheets = excelWorkbook.Worksheets
                'Unlock Sheets
                excelWorkbook.Worksheets(1).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(2).Unprotect(UnProtectPassword)
                excelWorkbook.Worksheets(3).Unprotect(UnProtectPassword)

                If AppendOption = False Then

                    currentSheet = "SUMMARY"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    'Report Title
                    If PerformanceReportSelected = ePerfReportAPS2X00.Production Then
                        excelWorksheet.Cells(1, 5).Value = CELProject.EngineModel + " PRODUCTION TEST DATA SHEET"
                    ElseIf PerformanceReportSelected = ePerfReportAPS2X00.Repair Then
                        excelWorksheet.Cells(1, 5).Value = CELProject.EngineModel + " REPAIR TEST DATA SHEET"
                    End If

                    'Customer
                    excelWorksheet.Cells(5, 3).NumberFormat = "@"
                    excelWorksheet.Cells(5, 3).Value = UserInputs15127.CustomerName

                    'Work Order
                    excelWorksheet.Cells(6, 3).NumberFormat = "@"
                    excelWorksheet.Cells(6, 3).Value = UserInputs15127.WorkOrder

                    'Engine P/N
                    excelWorksheet.Cells(7, 3).NumberFormat = "@"
                    excelWorksheet.Cells(7, 3).Value = UserInputs15127.PartNumber

                    'Engine S/N
                    excelWorksheet.Cells(8, 3).NumberFormat = "@"
                    excelWorksheet.Cells(8, 3).Value = UserInputs15127.SerialNumber

                    'Repair Type
                    excelWorksheet.Cells(9, 3).NumberFormat = "@"
                    excelWorksheet.Cells(9, 3).Value = UserInputs15127.ChoiceRepairType

                    'Test Type
                    excelWorksheet.Cells(10, 3).NumberFormat = "@"
                    excelWorksheet.Cells(10, 3).Value = UserInputs15127.ChoiceTestType

                    'TSO
                    excelWorksheet.Cells(11, 3).NumberFormat = "@"
                    excelWorksheet.Cells(11, 3).Value = UserInputs15127.TSO

                    'Date
                    excelWorksheet.Cells(5, 9).NumberFormat = "@"
                    excelWorksheet.Cells(5, 9).Value = Format(Now, "d MMMM yyyy")

                    'LHV
                    excelWorksheet.Cells(6, 9).NumberFormat = "@"
                    excelWorksheet.Cells(6, 9).Value = UserInputs15127.LHV

                    'Sample SG
                    excelWorksheet.Cells(7, 9).NumberFormat = "@"
                    excelWorksheet.Cells(7, 9).Value = UserInputs15127.SampleFuelSg

                    'Sample T Fuel
                    excelWorksheet.Cells(8, 9).NumberFormat = "@"
                    excelWorksheet.Cells(8, 9).Value = UserInputs15127.SampleTFuel

                    'Fuel Type
                    excelWorksheet.Cells(9, 9).NumberFormat = "@"
                    excelWorksheet.Cells(9, 9).Value = UserInputs15127.FuelType

                    'Oil Type
                    excelWorksheet.Cells(10, 9).NumberFormat = "@"
                    excelWorksheet.Cells(10, 9).Value = UserInputs15127.OilType

                    currentSheet = "ACCEPTANCE"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    'Document Number
                    excelWorksheet.Cells(46, 3).NumberFormat = "@"

                    Select Case EngineConfiguration.PerformanceReportType
                        Case "Production"
                            excelWorksheet.Cells(46, 3).Value = Custom_Parameters("APUTestedAccordingTo_HS_Production").ToString()
                        Case "Repair"
                            excelWorksheet.Cells(46, 3).Value = Custom_Parameters("APUTestedAccordingTo_HS_Repair").ToString()
                    End Select

                    currentSheet = "SUMMARY"
                    excelWorksheet = excelSheets.Item(currentSheet)

                    'Set the Performance Run 2C-2D-2E Limits
                    If (PerformanceReportSelected = ePerfReportAPS2X00.Repair) Then
                        excelWorksheet.Cells(20, 7).Value = LOG_PERF_PB_MIN_R.Value.ToString(LOG_PERF_PB_MIN_R.Format, Nothing) + " MINIMUM"
                        excelWorksheet.Cells(22, 7).Value = LOG_PERF_TB_MAX_R.Value.ToString(LOG_PERF_TB_MAX_R.Format, Nothing) + " MAXIMUM"
                        excelWorksheet.Cells(23, 7).Value = LOG_PERF_EGT_MAX_R.Value.ToString(LOG_PERF_EGT_MAX_R.Format, Nothing) + " MAXIMUM"
                        excelWorksheet.Cells(24, 7).Value = LOG_PERF_WF_MAX_R.Value.ToString(LOG_PERF_WF_MAX_R.Format, Nothing) + " MAXIMUM"

                        excelWorksheet.Cells(23, 9).Value = LOG_PERF_EGT_MAX_R_2F.Value.ToString(LOG_PERF_EGT_MAX_R_2F.Format, Nothing) + " MAXIMUM"

                    ElseIf (PerformanceReportSelected = ePerfReportAPS2X00.Production) Then
                        excelWorksheet.Cells(20, 7).Value = LOG_PERF_PB_MIN.Value.ToString(LOG_PERF_PB_MIN.Format, Nothing) + " MINIMUM"
                        excelWorksheet.Cells(22, 7).Value = LOG_PERF_TB_MAX.Value.ToString(LOG_PERF_TB_MAX.Format, Nothing) + " MAXIMUM"
                        excelWorksheet.Cells(23, 7).Value = LOG_PERF_EGT_MAX.Value.ToString(LOG_PERF_EGT_MAX.Format, Nothing) + " MAXIMUM"
                        excelWorksheet.Cells(24, 7).Value = LOG_PERF_WF_MAX.Value.ToString(LOG_PERF_WF_MAX.Format, Nothing) + " MAXIMUM"

                        excelWorksheet.Cells(23, 9).Value = LOG_PERF_EGT_MAX_2F.Value.ToString(LOG_PERF_EGT_MAX_2F.Format, Nothing) + " MAXIMUM"
                    End If

                    'Change the Test Steps in case of a Repair
                    If (PerformanceReportSelected = ePerfReportAPS2X00.Repair) Then

                        currentSheet = "DETAILS"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'in the repair report, row for the P_OIL_MIN and P_OIL_MAX are also hidden
                        excelWorksheet.Rows(37).EntireRow.Hidden = True
                        excelWorksheet.Rows(38).EntireRow.Hidden = True

                    End If

                    currentSheet = "ACCEPTANCE"
                    excelWorksheet = excelSheets.Item(currentSheet)

                End If

                Select Case TestStepNumber
                    Case eTestStepAPS2X00.POINT_1A, eTestStepAPS2X00.POINT_1D, eTestStepAPS2X00.POINT_1E

                        TestReport.NoValue = False
                        TestReport.NoValueParam = False
                        TestReport.NoCorrectionSpeed = True
                        TestReport.NoEGTSetPoint = True
                        TestReport.NoOILVib = False
                        TestReport.NoPoilMinMax = True
                        TestReport.NoCorrectionBleed = True
                        TestReport.NoEvent1 = True
                        TestReport.NoEvent2 = True
                        TestReport.NoOilFromArinc = True

                    Case eTestStepAPS2X00.POINT_2B

                        TestReport.NoValue = False
                        TestReport.NoValueParam = False
                        TestReport.NoCorrectionSpeed = False
                        TestReport.NoEGTSetPoint = False
                        TestReport.NoOILVib = False
                        TestReport.NoPoilMinMax = True
                        TestReport.NoCorrectionBleed = True
                        TestReport.NoEvent1 = True
                        TestReport.NoEvent2 = True
                        TestReport.NoOilFromArinc = True

                    Case eTestStepAPS2X00.POINT_2C, eTestStepAPS2X00.POINT_2D, eTestStepAPS2X00.POINT_2E

                        TestReport.NoValue = False
                        TestReport.NoValueParam = False
                        TestReport.NoCorrectionSpeed = False
                        TestReport.NoEGTSetPoint = True
                        TestReport.NoOILVib = False
                        TestReport.NoPoilMinMax = True
                        TestReport.NoCorrectionBleed = False
                        TestReport.NoEvent1 = True
                        TestReport.NoEvent2 = True
                        TestReport.NoOilFromArinc = True

                    Case eTestStepAPS2X00.POINT_2F

                        TestReport.NoValue = False
                        TestReport.NoValueParam = False
                        TestReport.NoCorrectionSpeed = False
                        TestReport.NoEGTSetPoint = True
                        TestReport.NoOILVib = False
                        TestReport.NoPoilMinMax = True
                        TestReport.NoCorrectionBleed = True
                        TestReport.NoEvent1 = True
                        TestReport.NoEvent2 = True
                        TestReport.NoOilFromArinc = True

                End Select


                Select Case TestStepNumber

                    Case eTestStepAPS2X00.RD_TIME

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Detail

                        'Performed Test Details section
                        excelWorksheet.Cells(30, 9).Value = LOG_PERF_RUNDOWN_TIME_SEC.Value.ToString(LOG_PERF_RUNDOWN_TIME_SEC.Format, Nothing)

                    Case eTestStepAPS2X00.POINT_1A

                        HNAWriteCommonDataForSheet2(excelSheets, 7)


                    Case eTestStepAPS2X00.POINT_1D

                        HNAWriteCommonDataForSheet2(excelSheets, 8)

                    Case eTestStepAPS2X00.POINT_1E

                        HNAWriteCommonDataForSheet2(excelSheets, 9)

                    Case eTestStepAPS2X00.POINT_1G

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Performed Test Details section
                        If CELProject.IsTrue(LOG_PERF_OILTEST.Value) Then
                            excelWorksheet.Cells(31, 9).Value = "PASSED"
                        Else
                            excelWorksheet.Cells(31, 9).Value = "FAILED"
                        End If

                    Case eTestStepAPS2X00.POINT_1H

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Performed Test Details section
                        If CELProject.IsTrue(LOG_PERF_OPSTEST.Value) Then
                            excelWorksheet.Cells(32, 9).Value = "PASSED"
                        Else
                            excelWorksheet.Cells(32, 9).Value = "FAILED"
                        End If

                    Case eTestStepAPS2X00.POINT_2B

                        'If speed is incorrect, no point taken, but a warning message
                        If (CELProject.IsTrue(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_COLD.Value) Or CELProject.IsFalse(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_HOT.Value)) Then
                            MessageBox.Show("Error: Incorrect speed for this inlet temperature." & vbCrLf & "       Performance Point will not be taken.", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            Exit Select
                        End If

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Bleed Flow limit
                        If CELProject.EngineModel = "APS2300" Then
                            If (PerformanceReportSelected = ePerfReportAPS2X00.Repair) Then
                                excelWorksheet.Cells(21, 5).Value = "144.1 MINIMUM"
                            ElseIf (PerformanceReportSelected = ePerfReportAPS2X00.Production) Then
                                excelWorksheet.Cells(21, 5).Value = "151.7 MINIMUM"
                            End If
                        ElseIf CELProject.EngineModel = "APS2600A" Then
                            excelWorksheet.Cells(21, 5).Value = "151.7 MINIMUM"
                        End If

                        excelWorksheet.Cells(21, 6).Value = LOG_PERF_WB_COR_2B.Value.ToString(LOG_PERF_WB_COR_2B.Format, Nothing)

                        HNAWriteCommonDataForSheet2(excelSheets, 10)

                    Case eTestStepAPS2X00.POINT_2C

                        'If speed is incorrect, no point taken, but a warning message
                        If (CELProject.IsTrue(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_COLD.Value) Or CELProject.IsFalse(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_HOT.Value)) Then
                            MessageBox.Show("Error: Incorrect speed for this inlet temperature." & vbCrLf & "       Performance Point will not be taken.", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            Exit Select
                        End If

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        If Not (Double.IsNaN(PB_2C.Value.ToDouble) Or Double.IsNaN(PB_2D.Value.ToDouble) Or Double.IsNaN(PB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(20, 8).Value = LOG_PERF_PB_CORR.Value.ToString(LOG_PERF_PB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WB_2C.Value.ToDouble) Or Double.IsNaN(WB_2D.Value.ToDouble) Or Double.IsNaN(WB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(21, 8).Value = LOG_PERF_WB_FLW_FN.Value.ToString(LOG_PERF_WB_FLW_FN.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(TB_2C.Value.ToDouble) Or Double.IsNaN(TB_2D.Value.ToDouble) Or Double.IsNaN(TB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(23, 8).Value = LOG_PERF_TB_CORR.Value.ToString(LOG_PERF_TB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(EGT_2C.Value.ToDouble) Or Double.IsNaN(EGT_2D.Value.ToDouble) Or Double.IsNaN(EGT_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(23, 8).Value = LOG_PERF_EGT_CORR.Value.ToString(LOG_PERF_EGT_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WF_2C.Value.ToDouble) Or Double.IsNaN(WF_2D.Value.ToDouble) Or Double.IsNaN(WF_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(24, 8).Value = LOG_PERF_WF_CORR.Value.ToString(LOG_PERF_WF_CORR.Format, Nothing)
                        End If

                        HNAWriteCommonDataForSheet2(excelSheets, 11)

                    Case eTestStepAPS2X00.POINT_2D

                        'If speed is incorrect, no point taken, but a warning message
                        If (CELProject.IsTrue(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_COLD.Value) Or CELProject.IsFalse(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_HOT.Value)) Then
                            MessageBox.Show("Error: Incorrect speed for this inlet temperature." & vbCrLf & "       Performance Point will not be taken.", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            Exit Select
                        End If

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        If Not (Double.IsNaN(PB_2C.Value.ToDouble) Or Double.IsNaN(PB_2D.Value.ToDouble) Or Double.IsNaN(PB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(20, 8).Value = LOG_PERF_PB_CORR.Value.ToString(LOG_PERF_PB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WB_2C.Value.ToDouble) Or Double.IsNaN(WB_2D.Value.ToDouble) Or Double.IsNaN(WB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(21, 8).Value = LOG_PERF_WB_FLW_FN.Value.ToString(LOG_PERF_WB_FLW_FN.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(TB_2C.Value.ToDouble) Or Double.IsNaN(TB_2D.Value.ToDouble) Or Double.IsNaN(TB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(22, 8).Value = LOG_PERF_TB_CORR.Value.ToString(LOG_PERF_TB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(EGT_2C.Value.ToDouble) Or Double.IsNaN(EGT_2D.Value.ToDouble) Or Double.IsNaN(EGT_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(23, 8).Value = LOG_PERF_EGT_CORR.Value.ToString(LOG_PERF_EGT_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WF_2C.Value.ToDouble) Or Double.IsNaN(WF_2D.Value.ToDouble) Or Double.IsNaN(WF_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(24, 8).Value = LOG_PERF_WF_CORR.Value.ToString(LOG_PERF_WF_CORR.Format, Nothing)
                        End If

                        HNAWriteCommonDataForSheet2(excelSheets, 12)

                    Case eTestStepAPS2X00.POINT_2E

                        'If speed is incorrect, no point taken, but a warning message
                        If (CELProject.IsTrue(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_COLD.Value) Or CELProject.IsFalse(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_HOT.Value)) Then
                            MessageBox.Show("Error: Incorrect speed for this inlet temperature." & vbCrLf & "       Performance Point will not be taken.", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            Exit Select
                        End If

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        If Not (Double.IsNaN(PB_2C.Value.ToDouble) Or Double.IsNaN(PB_2D.Value.ToDouble) Or Double.IsNaN(PB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(20, 8).Value = LOG_PERF_PB_CORR.Value.ToString(LOG_PERF_PB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WB_2C.Value.ToDouble) Or Double.IsNaN(WB_2D.Value.ToDouble) Or Double.IsNaN(WB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(21, 8).Value = LOG_PERF_WB_FLW_FN.Value.ToString(LOG_PERF_WB_FLW_FN.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(TB_2C.Value.ToDouble) Or Double.IsNaN(TB_2D.Value.ToDouble) Or Double.IsNaN(TB_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(22, 8).Value = LOG_PERF_TB_CORR.Value.ToString(LOG_PERF_TB_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(EGT_2C.Value.ToDouble) Or Double.IsNaN(EGT_2D.Value.ToDouble) Or Double.IsNaN(EGT_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(23, 8).Value = LOG_PERF_EGT_CORR.Value.ToString(LOG_PERF_EGT_CORR.Format, Nothing)
                        End If
                        If Not (Double.IsNaN(WF_2C.Value.ToDouble) Or Double.IsNaN(WF_2D.Value.ToDouble) Or Double.IsNaN(WF_2E.Value.ToDouble)) Then
                            excelWorksheet.Cells(24, 8).Value = LOG_PERF_WF_CORR.Value.ToString(LOG_PERF_WF_CORR.Format, Nothing)
                        End If

                        HNAWriteCommonDataForSheet2(excelSheets, 13)

                    Case eTestStepAPS2X00.POINT_2F

                        'If speed is incorrect, no point taken, but a warning message
                        If (CELProject.IsTrue(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_COLD.Value) Or CELProject.IsFalse(COLD_TESTING.Value) And CELProject.IsFalse(SPEED_OK_HOT.Value)) Then
                            MessageBox.Show("Error: Incorrect speed for this inlet temperature." & vbCrLf & "       Performance Point will not be taken.", "CELDAS™ 200", MessageBoxButtons.OK, MessageBoxIcon.Exclamation)
                            Exit Select
                        End If

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        excelWorksheet.Cells(23, 10).Value = LOG_PERF_EGT_CORR_2F.Value.ToString(LOG_PERF_EGT_CORR_2F.Format, Nothing)

                        HNAWriteCommonDataForSheet2(excelSheets, 14)

                    Case eTestStepAPS2X00.FINAL_DATA

                        currentSheet = "SUMMARY"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Detail

                        'Performed Test Details section
                        excelWorksheet.Cells(33, 9).Value = LOG_PERF_NUMBER_OF_STARTS.Value.ToString(LOG_PERF_NUMBER_OF_STARTS.Format, Nothing)
                        excelWorksheet.Cells(34, 9).Value = LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Value.ToString(LOG_PERF_OPERATING_TIME_CURRENT_HOURS.Format, Nothing)
                        excelWorksheet.Cells(35, 9).Value = LOG_PERF_NBAPUFAULTS.Value.ToString()

                        currentSheet = "ACCEPTANCE"
                        excelWorksheet = excelSheets.Item(currentSheet)

                        'Test Result
                        If CELProject.IsTrue(PERF_TEST_RESULT_ACCEPTED.Value) Then
                            excelWorksheet.OLEObjects("TestResultAccepted").object.value = True
                        Else
                            excelWorksheet.OLEObjects("TestResultAccepted").object.value = False
                        End If

                        If CELProject.IsTrue(PERF_TEST_RESULT_REJECTED.Value) Then
                            excelWorksheet.OLEObjects("TestResultRejected").object.value = True
                        Else
                            excelWorksheet.OLEObjects("TestResultRejected").object.value = False
                        End If

                        excelWorksheet.Cells(58, 3).Value = UserInputs15127.ChoiceOperator
                        excelWorksheet.Cells(59, 3).Value = UserInputs15127.ChoiceInspector

                End Select

            Catch ex As Exception
                System.Diagnostics.Trace.WriteLine("CreatePerformanceFile15127: " + ex.ToString())
                MessageBox.Show(ex.ToString)
                CreatePerformanceFile15127 = False
            Finally
                'Lock Sheets
                excelWorkbook.Worksheets(1).Protect(ProtectPassword)
                excelWorkbook.Worksheets(2).Protect(ProtectPassword)
                excelWorkbook.Worksheets(3).Protect(ProtectPassword)
            End Try

        End Function

        Private Sub HNAWriteCommonDataForSheet2(ByVal excelSheets As Excel.Sheets, ByVal Column As Integer)

            Try
                Dim excelWorksheet As Excel.Worksheet
                Dim i As Integer

                excelWorksheet = excelSheets.Item("DETAILS")

                If TestReport.NoValue Then

                    For i = 18 To 57
                        excelWorksheet.Cells(i, Column).Value = "N/A"
                        excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                    Next

                Else

                    If TestReport.NoValueParam Then  'Data coming from sensor = N/A
                        For i = 18 To 20
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(18, Column).Value = LOG_PERF_OPERATING_TIME_CURRENT_MINUTES.Value.ToString(LOG_PERF_OPERATING_TIME_CURRENT_MINUTES.Format, Nothing)
                        excelWorksheet.Cells(19, Column).Value = LOG_PERF_P_BARO_PSIA.Value.ToString(LOG_PERF_P_BARO_PSIA.Format, Nothing)
                        excelWorksheet.Cells(20, Column).Value = LOG_PERF_NG_DIAL_PCT.Value.ToString(LOG_PERF_NG_DIAL_PCT.Format, Nothing)
                    End If

                    If TestReport.NoCorrectionSpeed Then
                        excelWorksheet.Cells(21, Column).Value = "N/A"
                        excelWorksheet.Cells(21, Column).Interior.ColorIndex = 15
                    Else
                        excelWorksheet.Cells(21, Column).Value = LOG_PERF_N_CORR.Value.ToString(LOG_PERF_N_CORR.Format, Nothing)
                    End If

                    If TestReport.NoValueParam Then  'Data coming from sensor = N/A
                        For i = 22 To 32
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(22, Column).Value = LOG_PERF_NG_RPM.Value.ToString(LOG_PERF_NG_RPM.Format, Nothing)
                        excelWorksheet.Cells(23, Column).Value = LOG_PERF_WF_AVG_PPH.Value.ToString(LOG_PERF_WF_AVG_PPH.Format, Nothing)
                        excelWorksheet.Cells(24, Column).Value = LOG_PERF_P_FUEL_PSIG.Value.ToString(LOG_PERF_P_FUEL_PSIG.Format, Nothing)
                        excelWorksheet.Cells(25, Column).Value = LOG_PERF_T_CELL_DEGF.Value.ToString(LOG_PERF_T_CELL_DEGF.Format, Nothing)
                        excelWorksheet.Cells(26, Column).Value = LOG_PERF_T_INLET_AVG_DEGF.Value.ToString(LOG_PERF_T_INLET_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(27, Column).Value = LOG_PERF_P_INLET_PSIG.Value.ToString(LOG_PERF_P_INLET_PSIG.Format, Nothing)
                        excelWorksheet.Cells(28, Column).Value = LOG_PERF_P_EXHAUST_PSIG.Value.ToString(LOG_PERF_P_EXHAUST_PSIG.Format, Nothing)
                        excelWorksheet.Cells(29, Column).Value = LOG_PERF_T_EGT_ETC1_DEGF.Value.ToString(LOG_PERF_T_EGT_ETC1_DEGF.Format, Nothing)
                        excelWorksheet.Cells(30, Column).Value = LOG_PERF_T_EGT_ETC2_DEGF.Value.ToString(LOG_PERF_T_EGT_ETC2_DEGF.Format, Nothing)
                        excelWorksheet.Cells(31, Column).Value = LOG_PERF_T_EGT_ETC_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_ETC_AVG_DEGF.Format, Nothing)
                        excelWorksheet.Cells(32, Column).Value = LOG_PERF_T_EGT_AVG_DEGF.Value.ToString(LOG_PERF_T_EGT_AVG_DEGF.Format, Nothing)
                    End If

                    If TestReport.NoEGTSetPoint Then
                        excelWorksheet.Cells(33, Column).Value = "N/A"
                        excelWorksheet.Cells(33, Column).Interior.ColorIndex = 15
                    Else
                        excelWorksheet.Cells(33, Column).Value = LOG_PERF_TEX_AVG_SP.Value.ToString(LOG_PERF_TEX_AVG_SP.Format, Nothing)
                    End If

                    If TestReport.NoOILVib Then
                        For i = 34 To 36
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(34, Column).Value = LOG_PERF_P_CD_PSIG.Value.ToString(LOG_PERF_P_CD_PSIG.Format, Nothing)

                        If (CELProject.IsTrue(OIL_SHUTDOWN_BYPASS_BTN.Value)) Then
                            excelWorksheet.Cells(35, Column).Value = "NaN"
                            excelWorksheet.Cells(36, Column).Value = "NaN"
                        Else
                            excelWorksheet.Cells(35, Column).Value = LOG_PERF_T_OIL_DEGF.Value.ToString(LOG_PERF_T_OIL_DEGF.Format, Nothing)
                            excelWorksheet.Cells(36, Column).Value = LOG_PERF_P_OIL_PSIG.Value.ToString(LOG_PERF_P_OIL_PSIG.Format, Nothing)
                        End If
                    End If

                    If TestReport.NoPoilMinMax Then
                        For i = 37 To 38
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(37, Column).Value = LOG_PERF_P_OIL_LO_LIMIT_PSIG.Value.ToString(LOG_PERF_P_OIL_LO_LIMIT_PSIG.Format, Nothing)
                        excelWorksheet.Cells(38, Column).Value = LOG_PERF_P_OIL_HI_LIMIT_PSIG.Value.ToString(LOG_PERF_P_OIL_HI_LIMIT_PSIG.Format, Nothing)
                    End If

                    If TestReport.NoOILVib Then  'Data coming from sensor = N/A
                        For i = 39 To 40
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(39, Column).Value = LOG_PERF_VIB_POWERHEAD_G.Value.ToString(LOG_PERF_VIB_POWERHEAD_G.Format, Nothing)
                        excelWorksheet.Cells(40, Column).Value = LOG_PERF_VIB_GEARBOX_G.Value.ToString(LOG_PERF_VIB_GEARBOX_G.Format, Nothing)
                    End If

                    Dim CurrentAvg As Double = (LOG_PERF_LB1_CURRENT_IA.Value.ToDouble + LOG_PERF_LB1_CURRENT_IB.Value.ToDouble + LOG_PERF_LB1_CURRENT_IC.Value.ToDouble) / 3.0
                    Dim VoltAvg As Double = (LOG_PERF_LB1_VOLTAGE_VAB.Value.ToDouble + LOG_PERF_LB1_VOLTAGE_VBC.Value.ToDouble + LOG_PERF_LB1_VOLTAGE_VCA.Value.ToDouble) / 3.0


                    If TestReport.NoValueParam Then  'Data coming from sensor = N/A
                        For i = 41 To 49
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(41, Column).Value = VoltAvg.ToString(LOG_PERF_LB1_VOLTAGE_VAB.Format, Nothing)
                        excelWorksheet.Cells(42, Column).Value = CurrentAvg.ToString(LOG_PERF_LB1_CURRENT_IA.Format, Nothing)
                        excelWorksheet.Cells(43, Column).Value = LOG_PERF_LB1_POWER_TOT.Value.ToString(LOG_PERF_LB1_POWER_TOT.Format, Nothing)
                        excelWorksheet.Cells(44, Column).Value = LOG_PERF_T_BLEED_DEGF.Value.ToString(LOG_PERF_T_BLEED_DEGF.Format, Nothing)
                        excelWorksheet.Cells(45, Column).Value = LOG_PERF_P_BLEED_PSIG.Value.ToString(LOG_PERF_P_BLEED_PSIG.Format, Nothing)
                        excelWorksheet.Cells(46, Column).Value = LOG_PERF_P_ORIFICE_PSIA.Value.ToString(LOG_PERF_P_ORIFICE_PSIA.Format, Nothing)
                        excelWorksheet.Cells(47, Column).Value = LOG_PERF_P_ORIFICE_DELTA_H2OD.Value.ToString(LOG_PERF_P_ORIFICE_DELTA_H2OD.Format, Nothing)
                        excelWorksheet.Cells(48, Column).Value = LOG_PERF_T_ORIFICE_DEGF.Value.ToString(LOG_PERF_T_ORIFICE_DEGF.Format, Nothing)
                        excelWorksheet.Cells(49, Column).Value = LOG_PERF_WB_PPM.Value.ToString(LOG_PERF_WB_PPM.Format, Nothing)
                    End If

                    If TestReport.NoCorrectionBleed Then
                        excelWorksheet.Cells(50, Column).Value = "N/A"
                        excelWorksheet.Cells(50, Column).Interior.ColorIndex = 15
                    Else
                        excelWorksheet.Cells(50, Column).Value = LOG_PERF_WB_FLW_FN.Value.ToString(LOG_PERF_WB_FLW_FN.Format, Nothing)
                    End If

                    If TestReport.NoOilFromArinc Then
                        For i = 51 To 53
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(51, Column).Value = LOG_PERF_INPUT_TO_APUOIL.Value.ToString()
                        excelWorksheet.Cells(52, Column).Value = LOG_PERF_INPUT_PO_APUFIL.Value.ToString()
                        excelWorksheet.Cells(53, Column).Value = LOG_PERF_INPUT_PO_APUSYS.Value.ToString()
                    End If

                    If TestReport.NoEvent1 Then
                        For i = 54 To 55
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(54, Column).Value = LOG_PERF_EVENT_1.Value.ToString(LOG_PERF_EVENT_1.Format, Nothing)
                        excelWorksheet.Cells(55, Column).Value = LOG_PERF_HR_MTR_1.Value.ToString(LOG_PERF_HR_MTR_1.Format, Nothing)
                    End If

                    If TestReport.NoEvent2 Then
                        For i = 56 To 57
                            excelWorksheet.Cells(i, Column).Value = "N/A"
                            excelWorksheet.Cells(i, Column).Interior.ColorIndex = 15
                        Next
                    Else
                        excelWorksheet.Cells(56, Column).Value = LOG_PERF_EVENT_2.Value.ToString(LOG_PERF_EVENT_2.Format, Nothing)
                        excelWorksheet.Cells(57, Column).Value = LOG_PERF_HR_MTR_2.Value.ToString(LOG_PERF_HR_MTR_2.Format, Nothing)
                    End If

                End If

            Catch Ex As Exception
                MessageBox.Show("EpcorWriteCommonDataForSheet2: " & Ex.ToString())
            End Try
        End Sub

        Protected Overrides Sub Init_Engine_Controls()

            If CELProject.Project.Number = 11813 Then

                SetTestStepListChine(0)
            ElseIf CELProject.Project.Number = 12958 Then
                SetTestStepListEpcor(0)
            ElseIf CELProject.Project.Number = 15127 Then
                SetTestStepListHNA(0)
            Else
                Debug.Assert(False, "Init_Engine_Controls, Code Missing for this project")

            End If

        End Sub

