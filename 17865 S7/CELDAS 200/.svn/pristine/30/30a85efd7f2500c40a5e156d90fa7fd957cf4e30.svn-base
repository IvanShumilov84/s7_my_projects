        Private Sub ConfigHMIforEngine()

            'This is to configure the Performance Window in case we do

            Try
                Dim ManualEntryFrame As KineticaRT.Controls.Frame = Nothing

                Dim PassedLabel As System.Windows.Forms.Label = Nothing
                Dim NoLoadOilCheckLabel As System.Windows.Forms.Label = Nothing
                Dim OperabilityTestLabel As System.Windows.Forms.Label = Nothing
                Dim LogPerfOilTest As KineticaRT.Controls.Button = Nothing
                Dim LogPerfOpsTest As KineticaRT.Controls.Button = Nothing

                MyBase.InitializeObject(ManualEntryFrame, "APS2X00_Performance_Screen.fraManualEntry")
                MyBase.InitializeObject(PassedLabel, "APS2X00_Performance_Screen.fraManualEntry.lblPassed")
                MyBase.InitializeObject(NoLoadOilCheckLabel, "APS2X00_Performance_Screen.fraManualEntry.lblNoLoadOilCheck")
                MyBase.InitializeObject(OperabilityTestLabel, "APS2X00_Performance_Screen.fraManualEntry.lblOperabilityTest")
                MyBase.InitializeObject(LogPerfOilTest, "APS2X00_Performance_Screen.fraManualEntry.chkLOG_PERF_OILTEST")
                MyBase.InitializeObject(LogPerfOpsTest, "APS2X00_Performance_Screen.fraManualEntry.chkLOG_PERF_OPSTEST")

                If CELProject.Project.Number = 11813 Then
                    If (PerformanceReportSelected = ePerfReportAPS2X00.Repair) Then
                        PassedLabel.Visible = False
                        NoLoadOilCheckLabel.Visible = False
                        OperabilityTestLabel.Visible = False
                        LogPerfOilTest.Visible = False
                        LogPerfOpsTest.Visible = False
                    ElseIf (PerformanceReportSelected = ePerfReportAPS2X00.Production) Then
                        PassedLabel.Visible = True
                        NoLoadOilCheckLabel.Visible = True
                        OperabilityTestLabel.Visible = True
                        LogPerfOilTest.Visible = True
                        LogPerfOpsTest.Visible = True
                    End If

                ElseIf CELProject.Project.Number = 12958 Then
                    PassedLabel.Visible = True
                    NoLoadOilCheckLabel.Visible = True
                    OperabilityTestLabel.Visible = True
                    LogPerfOilTest.Visible = True
                    LogPerfOpsTest.Visible = True
                ElseIf CELProject.Project.Number = 15127 Then
                    PassedLabel.Visible = True
                    NoLoadOilCheckLabel.Visible = True
                    OperabilityTestLabel.Visible = True
                    LogPerfOilTest.Visible = True
                    LogPerfOpsTest.Visible = True
                End If

            Catch ex As Exception
                MessageBox.Show("ConfigHMIforEngine: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            End Try
        End Sub

        Protected Overrides Sub Init_Engine_Channels_Value()

            If Not (LOAD_AIR_VALVE_DEMAND Is Nothing) Then
                LOAD_AIR_VALVE_DEMAND.Value = New KineticaRT.Values.Double(8.0)
            End If

            Select Case CELProject.EngineFamily
                'Not For "DAS CALIBRATION"
                Case "APS2X00"

                    If Not (CELProject.PERF_TEST_STEP_NB Is Nothing) Then
                        CELProject.PERF_TEST_STEP_NB.Value = Values.Zero
                    End If

                    'Point C
