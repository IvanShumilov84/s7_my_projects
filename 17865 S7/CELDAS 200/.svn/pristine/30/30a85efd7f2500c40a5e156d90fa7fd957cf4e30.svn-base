        Private Sub OnArincStatusChange(ByVal sender As IChannel, ByVal newVal As Value)

            Dim LowAscii As Integer
            Dim HighAscii As Integer
            Dim LowString As String
            Dim HighString As String
            Dim Value As Integer
            Dim SeqCount As Integer

            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                'First validate the information, it seems that we received invalid message, so we just discard them
                Try
                    Value = newVal.ToDouble()
                Catch e As Exception
                    'newVal is empty!! just ignore the message
                    Exit Sub
                End Try

                'Validate the message, it seems that we receive twice the same information, so just discard when this this the same one
                If (ArincLastMsgReceived = Value) Then
                    Exit Sub
                Else
                    ArincLastMsgReceived = Value
                End If

                'Extract the low and High ascii value
                SeqCount = (Value And &H6) >> 1  'bit 2 and 3 only
                LowAscii = (Value And &H7F8) >> 3  'bit 4 to 11
                HighAscii = (Value And &H7F800) >> 11 'bit 12 to 19

                LowString = Chr(LowAscii).ToString()
                HighString = Chr(HighAscii).ToString()


                'Detect the beginning of transmission of a sequence
                If (SeqCount = 0 And LowAscii = 0 And HighAscii = 0) Then
                    Me.ArincBeginDetected = True
                    Me.ArincNextSeqExpected = 1
                    Me.ArincHourID = False
                    Me.ArincStartID = False
                    Me.ArincNbByteRead = 0
                    Me.ArincHoursNbByteToRead = 0
                    Me.ArincStartNbByteToRead = 0
                    Exit Sub
                End If

                'sequence to read not initiated yet
                If (Me.ArincBeginDetected = False) Then
                    Exit Sub
                End If

                'we missed a message, reset the sequence    
                If (Me.ArincNextSeqExpected <> SeqCount) Then
                    Me.ArincBeginDetected = False
                    Me.ArincNextSeqExpected = 0
                    Me.ArincHourID = False
                    Me.ArincStartID = False
                    Me.ArincNbByteRead = 0
                    Me.ArincHoursNbByteToRead = 0
                    Me.ArincStartNbByteToRead = 0
                    Exit Sub
                End If

                'Detect the identification of APU Starts ID or APU Hours ID 
                If (SeqCount = 1 And Me.ArincHourID = False And Me.ArincStartID = False) Then

                    'Detect the identification of APU Starts ID    
                    If (LowString.CompareTo("6") = 0 And HighString.CompareTo("0") = 0) Then
                        Me.ArincStartID = True
                        Me.ArincNextSeqExpected = 2
                        Me.ArincNbByteRead = 0
                        Me.ArincHoursNbByteToRead = 0
                        Me.ArincStartNbByteToRead = 0
                        Exit Sub
                    End If

                    'Detect the identification of APU Hours ID    
                    If (LowString.CompareTo("7") = 0 And HighString.CompareTo("0") = 0) Then
                        Me.ArincHourID = True
                        Me.ArincNextSeqExpected = 2
                        Me.ArincNbByteRead = 0
                        Me.ArincHoursNbByteToRead = 0
                        Me.ArincStartNbByteToRead = 0
                        Exit Sub
                    End If
                End If

                'Detect the number of char to be transmit for of APU Starts or APU Hours   
                If (SeqCount = 2 And HighString.CompareTo("0") = 0 And Me.ArincStartNbByteToRead = 0 And Me.ArincHoursNbByteToRead = 0) Then

                    'Detect the number of char to be transmit for of APU Starts ID    
                    If (Me.ArincStartID = True) Then
                        Me.ArincStartNbByteToRead = CInt(LowString)
                        Me.ArincNextSeqExpected = 3
                        Me.ArincString = ""
                        Exit Sub
                    End If

                    'Detect the number of char to be transmit for of APU Hours ID    
                    If (Me.ArincHourID = True) Then
                        Me.ArincHoursNbByteToRead = CInt(LowString)
                        Me.ArincNextSeqExpected = 3
                        Me.ArincString = ""
                        Exit Sub
                    End If
                End If


                'Read the data for APU Start
                If (Me.ArincStartID = True And Me.ArincNbByteRead < Me.ArincStartNbByteToRead) Then

                    If (HighAscii <> 0) Then
                        Me.ArincString += HighString
                        Me.ArincNbByteRead += 1
                    End If

                    If (LowAscii <> 0) Then
                        Me.ArincString += LowString
                        Me.ArincNbByteRead += 1
                    End If

                    'transfer the value to the tag
                    If (Me.ArincNbByteRead >= Me.ArincStartNbByteToRead) Then
                        APU_STARTS.Value = New KineticaRT.Values.Double(CDbl(Me.ArincString.ToString()))
                        Me.ArincBeginDetected = False
                    Else
                        Me.ArincNextSeqExpected += 1
                    End If
                End If

                'Read the data for APU Hours
                If (Me.ArincHourID = True And Me.ArincNbByteRead < Me.ArincHoursNbByteToRead) Then

                    If (HighAscii <> 0) Then
                        If (HighString.CompareTo(".") = 0) Then
                            Me.ArincString += "."
                            Me.ArincNbByteRead += 1
                        Else
                            Me.ArincString += HighString
                            Me.ArincNbByteRead += 1
                        End If
                    End If

                    If (LowAscii <> 0) Then
                        If (LowString.CompareTo(".") = 0) Then
                            Me.ArincString += "."
                            Me.ArincNbByteRead += 1
                        Else
                            Me.ArincString += LowString
                            Me.ArincNbByteRead += 1
                        End If
                    End If

                    'transfer the value to the tag
                    If (Me.ArincNbByteRead >= Me.ArincHoursNbByteToRead) Then
                        APU_HOURS.Value = New KineticaRT.Values.Double(CDbl(Me.ArincString.ToString()))
                        Me.ArincBeginDetected = False
                    Else
                        Me.ArincNextSeqExpected += 1
                    End If
                End If

                If (Me.ArincNextSeqExpected >= 4) Then
                    Me.ArincNextSeqExpected = 0
                End If

            End If

        End Sub

        Protected Overrides Sub OnLOG_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)
            Try
                If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                    If CELProject.IsTrue(newVal) Then

                        'Update the Log/Perf channel set
                        CELProject.LogPerfSynch.UpdateValues()

                        'Synchronize data for Log and Performance
                        Compute(True)

                        CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, False, CELProject.EngineModel, True)
                        CELProject.LOG_TAKE_POINT_BTN.Value = Values.False
                    End If

                End If

            Catch Ex As Exception
                MessageBox.Show("OnLOG_TAKE_POINT_BTN: " & Ex.ToString())
            End Try
        End Sub

        Protected Overrides Sub OnPERF_TAKE_POINT_BTN(ByVal sender As IChannel, ByVal newVal As Value)

            Dim SearchPath As String
            Dim excelWorkbook As Excel.Workbook = Nothing

            Try

                If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                    If CELProject.IsTrue(newVal) Then

                        'Set the value if in Test steps 2C, 2D or 2E
                        Select Case CELProject.PERF_TEST_STEP_NB.Value.ToDouble
                            Case eTestStepAPS2X00.POINT_2C
                                EGT_2C.Value = EGT_NRM_2C.Value
                                KW_2C.Value = KW_NRM_2C.Value
                                PB_2C.Value = PB_NRM_2C.Value
                                TB_2C.Value = TB_NRM_2C.Value
                                WB_2C.Value = WB_NRM_2C.Value
                                WF_2C.Value = WF_NRM_2C.Value
                            Case eTestStepAPS2X00.POINT_2D
                                EGT_2D.Value = EGT_NRM_2D.Value
                                KW_2D.Value = KW_NRM_2D.Value
                                PB_2D.Value = PB_NRM_2D.Value
                                TB_2D.Value = TB_NRM_2D.Value
                                WB_2D.Value = WB_NRM_2D.Value
                                WF_2D.Value = WF_NRM_2D.Value
                            Case eTestStepAPS2X00.POINT_2E
                                EGT_2E.Value = EGT_NRM_2E.Value
                                KW_2E.Value = KW_NRM_2E.Value
                                PB_2E.Value = PB_NRM_2E.Value
                                TB_2E.Value = TB_NRM_2E.Value
                                WB_2E.Value = WB_NRM_2E.Value
                                WF_2E.Value = WF_NRM_2E.Value
                        End Select

                        'Update the Log/Perf channel set
                        CELProject.LogPerfSynch.UpdateValues()

                        'Synchronize data for Log and Performance
                        Compute(True)

                        SearchPath = CELProject.EngineSession.PerfFolder

                        Dim NewFileCreated As Boolean

                        Select Case CELProject.Project.Number

                            Case 11813
                                Dim Chine11813TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                                NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, Chine11813TemplateReportFullFileName, AddressOf CreatePerformanceFile11813)

                            Case 12958
                                Dim Epcor12958TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                                NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, Epcor12958TemplateReportFullFileName, AddressOf CreatePerformanceFile12958)

                            Case 15127
                                Dim HNA15127TemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                                NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, HNA15127TemplateReportFullFileName, AddressOf CreatePerformanceFile15127)

                            Case Else
                                Debug.Assert(False, "OnPerf_TAKE_POINT_BTN, Code Missign for this project")
                                Dim StandardCELTemplateReportFullFileName As String = EngineConfiguration.PerformanceReportTemplateFile
                                'NewFileCreated = CELProject.ProcessPerformanceReport(SearchPath, StandardCELTemplateReportFullFileName, AddressOf CreateStandardCELPerformanceFile) 

                        End Select

                        CELProject.DoLogging(AddressOf UpdateCustomHeaderLogFile, True, CELProject.EngineModel, NewFileCreated)

                        CELProject.PERF_TAKE_POINT_BTN.Value = Values.False

                    End If

                End If

            Catch ex As Exception
                MessageBox.Show("OnPERF_TAKE_POINT_BTN: " & ex.ToString(), "Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Finally

            End Try

        End Sub

