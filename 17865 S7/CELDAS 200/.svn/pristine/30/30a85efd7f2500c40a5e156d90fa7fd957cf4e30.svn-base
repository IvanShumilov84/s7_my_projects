                        PB_2C.Value = Values.NaN
                    End If
                    If Not (TB_2C Is Nothing) Then
                        TB_2C.Value = Values.NaN
                    End If
                    If Not (WB_2C Is Nothing) Then
                        WB_2C.Value = Values.NaN
                    End If
                    If Not (WF_2C Is Nothing) Then
                        WF_2C.Value = Values.NaN
                    End If

                    'Point D
                    If Not (EGT_2D Is Nothing) Then
                        EGT_2D.Value = Values.NaN
                    End If
                    If Not (KW_2D Is Nothing) Then
                        KW_2D.Value = Values.NaN
                    End If
                    If Not (PB_2D Is Nothing) Then
                        PB_2D.Value = Values.NaN
                    End If
                    If Not (TB_2D Is Nothing) Then
                        TB_2D.Value = Values.NaN
                    End If
                    If Not (WB_2D Is Nothing) Then
                        WB_2D.Value = Values.NaN
                    End If
                    If Not (WF_2D Is Nothing) Then
                        WF_2D.Value = Values.NaN
                    End If

                    'Point E
                    If Not (EGT_2E Is Nothing) Then
                        EGT_2E.Value = Values.NaN
                    End If
                    If Not (KW_2E Is Nothing) Then
                        KW_2E.Value = Values.NaN
                    End If
                    If Not (PB_2E Is Nothing) Then
                        PB_2E.Value = Values.NaN
                    End If
                    If Not (TB_2E Is Nothing) Then
                        TB_2E.Value = Values.NaN
                    End If
                    If Not (WB_2E Is Nothing) Then
                        WB_2E.Value = Values.NaN
                    End If
                    If Not (WF_2E Is Nothing) Then
                        WF_2E.Value = Values.NaN
                    End If

            End Select
        End Sub


        Private Sub UpdateArincDateTime(ByRef prevDateTime As System.DateTime)
            Dim curDateTime As System.DateTime = System.DateTime.Now

            If (prevDateTime.Second <> curDateTime.Second) Then
                Me.A429OUT_TIME_CHA_SDI1_12_17.Value = New KineticaRT.Values.Integer(curDateTime.Second)
                Me.A429OUT_TIME_CHA_SDI1_18_23.Value = New KineticaRT.Values.Integer(curDateTime.Minute)
                Me.A429OUT_TIME_CHA_SDI1_24_28.Value = New KineticaRT.Values.Integer(curDateTime.Hour)

                Me.A429OUT_DATE_CHA_SDI1_11_14.Value = New KineticaRT.Values.Integer((curDateTime.Year Mod 100) Mod 10) 'Last Digit of year,  if year 1234, 4
                Me.A429OUT_DATE_CHA_SDI1_15_18.Value = New KineticaRT.Values.Integer((curDateTime.Year Mod 100) \ 10)   'Digit ten of year,   if year 1234, 3
                Me.A429OUT_DATE_CHA_SDI1_19_22.Value = New KineticaRT.Values.Integer((curDateTime.Month Mod 10))        'Digit unit of month, if month 12,  2
                Me.A429OUT_DATE_CHA_SDI1_23.Value = New KineticaRT.Values.Integer((curDateTime.Month \ 10))          'Digit ten of month,  if month 12,  1
                Me.A429OUT_DATE_CHA_SDI1_24_27.Value = New KineticaRT.Values.Integer((curDateTime.Day Mod 10))          'Digit unit of month, if day 31,  1
                Me.A429OUT_DATE_CHA_SDI1_28_29.Value = New KineticaRT.Values.Integer((curDateTime.Day \ 10))            'Digit ten of month,  if day 12,  3
            End If

            prevDateTime = curDateTime
        End Sub

        Dim prevDateTime As System.DateTime = System.DateTime.MinValue

        Protected Overrides Sub OnEngineWorkingThread()

            If CELProject.IsFalse(CELProject.ARCHIVE_PLAY.Value) Then

                Compute(False)

                UpdateArincDateTime(prevDateTime)

                RundownTimerCtrl.Timer()
                StartTimerCtrl.Timer()
                CrankTimerCtrl.Timer()

                'Persistent Values Save Check
                PersistentValuesCtrl.SavePersistentValues(False)

            End If

        End Sub

        Private Function Compute_BleedAirFlow(ByVal TOrifice_DEGF As Double, _
                                              ByVal POrifice_PSIA As Double, _
                                              ByVal POrificeDelta_PSID As Double) As Double Implements IBleedAirFlowCalculation.Compute_BleedAirFlow
            Try

                If CELProject.IsTrue(BLEED_BTN.Value) Then

                    Dim BleedAirFLow As Double = CELProject.GetBleedAirFlow( _
                                                                            EngineConfiguration.DuctDiameter, _
                                                                            EngineConfiguration.DuctDiameterUnit, _
                                                                            EngineConfiguration.OrificeDiameter, _
                                                                            EngineConfiguration.OrificeDiameterUnit, _
                                                                            TOrifice_DEGF, _
                                                                            CELDAS.eTemperature.Fahrenheit, _
                                                                            POrifice_PSIA, _
                                                                            CELDAS.ePressure.PSI, _
                                                                            POrificeDelta_PSID, _
                                                                            CELDAS.ePressure.PSI, _
                                                                            EngineConfiguration.OrificeThinkness, _
                                                                            EngineConfiguration.OrificeThinknessUnit, _
                                                                            EngineConfiguration.TapArrangement, _
                                                                            CELDAS.eFlowMass.LbByMin)

                    Return BleedAirFLow

                Else
                    Return 0.0
                End If

            Catch Ex As Exception
                'Log error
                MessageBox.Show("Error in Engine_Sequence.Compute_BleedAirFlow: " & Ex.ToString)
            End Try

        End Function

