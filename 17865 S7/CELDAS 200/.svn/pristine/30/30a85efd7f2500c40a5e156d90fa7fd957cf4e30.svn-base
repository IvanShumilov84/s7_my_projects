                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WF_AVG_PPH, "LOG_PERF_WF_AVG_PPH"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WF_CORR, "LOG_PERF_WF_CORR"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WF_MAX, "LOG_PERF_WF_MAX"))
                        Return_Value.Add(MyBase.InitializeChannel(LOG_PERF_WF_MAX_R, "LOG_PERF_WF_MAX_R"))

                        'ARINC

                        Return_Value.Add(MyBase.InitializeChannel(A429OUT_DATE_CHA_SDI1_11_14, "A429OUT_DATE_CHA_SDI1_11_14"))
                        Return_Value.Add(MyBase.InitializeChannel(A429OUT_DATE_CHA_SDI1_15_18, "A429OUT_DATE_CHA_SDI1_15_18"))
                        Return_Value.Add(MyBase.InitializeChannel(A429OUT_DATE_CHA_SDI1_19_22, "A429OUT_DATE_CHA_SDI1_19_22"))
                        Return_Value.Add(MyBase.InitializeChannel(A429OUT_DATE_CHA_SDI1_23, "A429OUT_DATE_CHA_SDI1_23"))
                        Return_Value.Add(MyBase.InitializeChannel(A429OUT_DATE_CHA_SDI1_24_27, "A429OUT_DATE_CHA_SDI1_24_27"))
                        Return_Value.Add(MyBase.InitializeChannel(A429OUT_DATE_CHA_SDI1_28_29, "A429OUT_DATE_CHA_SDI1_28_29"))
                        Return_Value.Add(MyBase.InitializeChannel(A429OUT_TIME_CHA_SDI1_12_17, "A429OUT_TIME_CHA_SDI1_12_17"))
                        Return_Value.Add(MyBase.InitializeChannel(A429OUT_TIME_CHA_SDI1_18_23, "A429OUT_TIME_CHA_SDI1_18_23"))
                        Return_Value.Add(MyBase.InitializeChannel(A429OUT_TIME_CHA_SDI1_24_28, "A429OUT_TIME_CHA_SDI1_24_28"))

                End Select

                'Specific Per Engine (APS2300/APS2600A)

                If CELProject.EngineModel = "APS2300" Then

                    'APU HOURS and APU STARTS decompositions are specific to APS2300
                    Return_Value.Add(MyBase.InitializeChannel(A429IN_APU_SYSTEM_ID_CHA, "A429IN_APU_SYSTEM_ID_CHA"))

                End If

            Catch ex As Exception
                MessageBox.Show("Init_Engine_Channels: " & ex.ToString())
                Return_Value.Add(False)
            Finally

            End Try

            If Return_Value.Contains(False) Then
                Init_Engine_Channels = False
            Else
                Init_Engine_Channels = True
            End If
        End Function

        Private Sub TestProgress_Initialize()
            Dim dataInfo As CEL.TestProgress.TestProgressMgr.TestProgress_DataInfo = Nothing

            dataInfo.EngineStartEventChannelName = "START_BTN"
            dataInfo.EngineStartEventChannelValue = True
            dataInfo.EngineStartEventDescription = "Engine Start"
            dataInfo.EngineStartEventRecordTime = True
            dataInfo.EngineStopEventChannelName = "STOP_CMD"
            dataInfo.EngineStopEventChannelValue = True
            dataInfo.EngineStopEventDescription = "Engine Stop - Rundown Time (s): "
            dataInfo.EngineStopEventRecordTime = True
            dataInfo.TestProgressFrameName = CELProject.EngineFamily.Replace("-", "_") + "_Screen.fraTestProgressHorizontal"
            dataInfo.TestProgressSheetFileName = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
            dataInfo.UUTModel = CELProject.EngineModel

            Select Case CELProject.Project.Number
                Case 12958
                    dataInfo.UUTSerialNumber = Me.UserInputs12958.SerialNumber
                    dataInfo.UUTWorkOrder = Me.UserInputs12958.WorkOrder
                Case Else
                    Debug.Assert(False, "TestProgress_Initialize(): Specific engine data not configured for this project")
            End Select

            Me.TestProgressMgr = New CEL.TestProgress.TestProgressMgr(dataInfo)
        End Sub

        Private Sub TestProgress_RecordPerfStep_Generic()
            Dim sheetEntry As CEL.TestProgress.TestProgressSheetEntry = Nothing

            Dim TextString As String = TestStepMap(cmbTestStepList.SelectedIndex).TestStepText & " performance point taken"

            sheetEntry = New CEL.TestProgress.TestProgressSheetEntry(Now.ToString(), TextString)

            If sheetEntry IsNot Nothing Then
                Me.TestProgressMgr.AddTestProgressEntry(sheetEntry)
            End If

        End Sub

        Private Sub TestProgress_RecordPerfStep(testStep As eTestStepAPS2X00)

            If Me.TestProgressMgr IsNot Nothing Then

                Select Case CELProject.Project.Number
                    Case 12958
                        TestProgress_RecordPerfStep_Generic()
                    Case Else
                        Debug.Assert(False, "TestProgress_RecordPerfStep(): Specific engine data not configured for this project")
                End Select

            End If
        End Sub

        Private Sub TestProgress_Save()
            If Not Me.TestProgressMgr Is Nothing Then
                TestProgress_UpdateProgressSheetHeader(Me.TestProgressMgr.TestProgressSheet)
                Dim fileName As String = CELProject.EngineSession.LogFolder + "/TestProgress.xml"
                Dim settings As Xml.XmlWriterSettings = New Xml.XmlWriterSettings()
                settings.Indent = True

                Using writer As Xml.XmlWriter = Xml.XmlWriter.Create(fileName, settings)
                    Dim xslPath As String = "type=""text/xsl"" href=""" + Application.StartupPath + "/TestProgressSheet.xsl"""
                    writer.WriteProcessingInstruction("xml-stylesheet", xslPath)
                    Dim ser As New Xml.Serialization.XmlSerializer(GetType(CEL.TestProgress.TestProgressSheet))
                    ser.Serialize(writer, Me.TestProgressMgr.TestProgressSheet)
                End Using
            End If
        End Sub

        Private Sub TestProgress_UpdateProgressSheetHeader(progressSheet As CEL.TestProgress.TestProgressSheet)

            Select Case CELProject.Project.Number
                Case 12958
                    ' do nothing
                Case 15127
                    ' do nothing
                Case Else
                    Debug.Assert(False, "TestProgress_UpdateProgressSheetHeader(): Specific engine data not configured for this project")
            End Select

        End Sub

