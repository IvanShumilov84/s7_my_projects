        Private UserInputs As UserInputBase

        ' La Classe de base UserInputBase est abstraite. Les paramètres récurrents sont déclarés ici, mais les
        '  paramètres spéficiques sont repportés dans la classe dérivée, selon le projet ou le
        '  modèle de moteur.  
        Public MustInherit Class UserInputBase

            Public EngineSerialNumber As String = ""
            Public EngineSerialNumberPort As String = ""
            Public EngineSerialNumberSTBD As String = ""
            Public WorkOrder As String = ""
            Public PartNumber As String = ""
            Public LHV As String = ""
            Public OilType As String = ""
            Public FuelType As String = ""
            Public CustomerName As String = ""
            Public ManualRevDate As String = ""
            Public VaneArea1 As String = ""
            Public VaneArea2 As String = ""
            Public TSO As String = ""
            Public TBO As String = ""
            Public TSG As String = ""
            Public TFuel As String = ""
            Public SG As String = ""
            Public ServiceBulletin1 As String = ""
            Public ServiceBulletin2 As String = ""

            Public TestType As String = ""
            Public BedType As String = ""
            Public BuildSpec As String = ""
            Public ExhaustStub As String = ""
            Public OperatorName As String = ""
            Public InspectorName As String = ""
            Public ObserverName As String = ""
            Public SupervisorName As String = ""

            ' Allow friend access to the empty constructor.
            Friend Sub New()

            End Sub

            ' La routine doit être définie dans la classe enfant
            Public MustOverride Sub MapUserInputsParameters(ByRef CELProject As CELDAS)

        End Class


        Public Class UserInput14085 : Inherits UserInputBase

            Public Overrides Sub MapUserInputsParameters(ByRef CELProject As CELDAS)

                EngineSerialNumber = CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
                WorkOrder = CELProject.Test_Mgr_UUT_Answer(1).Value.ToString()
                PartNumber = CELProject.Test_Mgr_UUT_Answer(2).Value.ToString()
                LHV = CELProject.Test_Mgr_UUT_Answer(3).Value.ToString()
                SG = CELProject.Test_Mgr_UUT_Answer(4).Value.ToString()
                TFuel = CELProject.Test_Mgr_UUT_Answer(5).Value.ToString()
                OilType = CELProject.Test_Mgr_UUT_Answer(6).Value.ToString()
                FuelType = CELProject.Test_Mgr_UUT_Answer(7).Value.ToString()
                CustomerName = CELProject.Test_Mgr_UUT_Answer(8).Value.ToString()
                TSO = CELProject.Test_Mgr_UUT_Answer(9).Value.ToString()
                TBO = CELProject.Test_Mgr_UUT_Answer(10).Value.ToString()
                VaneArea1 = CELProject.Test_Mgr_UUT_Answer(11).Value.ToString()
                VaneArea2 = CELProject.Test_Mgr_UUT_Answer(12).Value.ToString()

                TestType = CELProject.Test_Mgr_UUT_Choice(0).Value.ToString()
                BuildSpec = CELProject.Test_Mgr_UUT_Choice(1).Value.ToString()
                ExhaustStub = CELProject.Test_Mgr_UUT_Choice(2).Value.ToString()
                OperatorName = CELProject.Test_Mgr_UUT_Choice(4).Value.ToString()
                ObserverName = CELProject.Test_Mgr_UUT_Choice(5).Value.ToString()
                SupervisorName = CELProject.Test_Mgr_UUT_Choice(6).Value.ToString()

            End Sub

        End Class


        Public Class UserInput14086 : Inherits UserInputBase


            ' Récupère les informations du userInputs 
            Public Overrides Sub MapUserInputsParameters(ByRef CELProject As CELDAS)

                EngineSerialNumber = CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
                WorkOrder = CELProject.Test_Mgr_UUT_Answer(1).Value.ToString()
                PartNumber = CELProject.Test_Mgr_UUT_Answer(2).Value.ToString()
                LHV = CELProject.Test_Mgr_UUT_Answer(3).Value.ToString()
                OilType = CELProject.Test_Mgr_UUT_Answer(4).Value.ToString()
                FuelType = CELProject.Test_Mgr_UUT_Answer(5).Value.ToString()
                CustomerName = CELProject.Test_Mgr_UUT_Answer(6).Value.ToString()
                TSO = CELProject.Test_Mgr_UUT_Answer(7).Value.ToString()
                TBO = CELProject.Test_Mgr_UUT_Answer(8).Value.ToString()

                VaneArea1 = CELProject.Test_Mgr_UUT_Answer(9).Value.ToString()
                VaneArea2 = CELProject.Test_Mgr_UUT_Answer(10).Value.ToString()

                BuildSpec = CELProject.Test_Mgr_UUT_PwBuildSpecification.Value.ToString()

                TestType = CELProject.Test_Mgr_UUT_Choice(0).Value.ToString()
                BedType = CELProject.Test_Mgr_UUT_Choice(1).Value.ToString()

                OperatorName = CELProject.Test_Mgr_UUT_Choice(4).Value.ToString()
                InspectorName = CELProject.Test_Mgr_UUT_Choice(5).Value.ToString()

                ServiceBulletin1 = CELProject.Test_Mgr_UUT_PwServiceBulletin(0).Value.ToString()
                ServiceBulletin2 = CELProject.Test_Mgr_UUT_PwServiceBulletin(1).Value.ToString()


            End Sub

        End Class

        Public Class UserInput17631 : Inherits UserInputBase


            ' Récupère les informations du userInputs 
            Public Overrides Sub MapUserInputsParameters(ByRef CELProject As CELDAS)

                If CELProject.EngineFamily = "PT6A" Then
                    EngineSerialNumber = CELProject.Test_Mgr_UUT_Answer(0).Value.ToString()
                Else
                    Dim EngineSerialNumbers() As String = CELProject.Test_Mgr_UUT_Answer(0).Value.ToString.Split("-")
                    EngineSerialNumberPort = EngineSerialNumbers(0)
                    EngineSerialNumberSTBD = EngineSerialNumbers(1)
                End If

                WorkOrder = CELProject.Test_Mgr_UUT_Answer(1).Value.ToString()
                PartNumber = CELProject.Test_Mgr_UUT_Answer(2).Value.ToString()
                LHV = CELProject.Test_Mgr_UUT_Answer(3).Value.ToString()
                SG = CELProject.Test_Mgr_UUT_Answer(4).Value.ToString()
                TFuel = CELProject.Test_Mgr_UUT_Answer(5).Value.ToString()
                OilType = CELProject.Test_Mgr_UUT_Answer(6).Value.ToString()
                FuelType = CELProject.Test_Mgr_UUT_Answer(7).Value.ToString()
                CustomerName = CELProject.Test_Mgr_UUT_Answer(8).Value.ToString()
                TSO = CELProject.Test_Mgr_UUT_Answer(9).Value.ToString()
                TBO = CELProject.Test_Mgr_UUT_Answer(10).Value.ToString()
                VaneArea1 = CELProject.Test_Mgr_UUT_Answer(11).Value.ToString()
                VaneArea2 = CELProject.Test_Mgr_UUT_Answer(12).Value.ToString()

                BuildSpec = CELProject.Test_Mgr_UUT_PwBuildSpecification.Value.ToString()

                TestType = CELProject.Test_Mgr_UUT_Choice(0).Value.ToString()
                BedType = CELProject.Test_Mgr_UUT_Choice(1).Value.ToString()

                OperatorName = CELProject.Test_Mgr_UUT_Choice(4).Value.ToString()
                InspectorName = CELProject.Test_Mgr_UUT_Choice(5).Value.ToString()

                ServiceBulletin1 = CELProject.Test_Mgr_UUT_PwServiceBulletin(0).Value.ToString()
                ServiceBulletin2 = CELProject.Test_Mgr_UUT_PwServiceBulletin(1).Value.ToString()


            End Sub

        End Class

