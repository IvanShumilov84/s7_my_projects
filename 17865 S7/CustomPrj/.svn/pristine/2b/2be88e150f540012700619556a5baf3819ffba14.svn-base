 		<add key="EGT_T4_11"	value="1315.0"/>									<!-- Constant value -->
    
		<!--  EGT shutdown limit for Steady State
			  Ref. 49-20-00 Rev 7, page 1337 Figure 1306
   
			  Note we use only the upper curve 2200(1204) Overtemp APU after 1 sec

				TInlet (DegF)		EGT (DegF)
				-65.7				1294
				0			        1310
				20			        1315
				50			        1327
				90			        1350
				130			        1375		-->
    
		<add key="EGT_NUMBER_STEADY_POINT"	value="6"/>								<!-- Constant value Note: Workbench variable declaration has to be increase if the value increase-->

		<add key="EGT_TIN1_STEADY"			value="-65.7"/>							<!-- Constant value -->
		<add key="EGT_TIN2_STEADY"			value="0.0"/>							<!-- Constant value -->
 		<add key="EGT_TIN3_STEADY"			value="20.0"/>							<!-- Constant value -->
 		<add key="EGT_TIN4_STEADY"			value="50.0"/>							<!-- Constant value -->
 		<add key="EGT_TIN5_STEADY"			value="90.0"/>							<!-- Constant value -->
		<add key="EGT_TIN6_STEADY"			value="130.0"/>							<!-- Constant value -->
  
		<add key="EGT_LIMIT1_STEADY"		value="1294.0"/>						<!-- Constant value -->
 		<add key="EGT_LIMIT2_STEADY"		value="1310.0"/>						<!-- Constant value -->
 		<add key="EGT_LIMIT3_STEADY"		value="1315.0"/>						<!-- Constant value -->
 		<add key="EGT_LIMIT4_STEADY"		value="1327.0"/>						<!-- Constant value -->
 		<add key="EGT_LIMIT5_STEADY"		value="1350.0"/>						<!-- Constant value -->
		
		<add key="EGT_LIMIT6_STEADY"		value="1375.0"/>						<!-- Constant value -->

		<add key="OMNIBUSBOX_CHANNEL_9"		value="CELBTI_CHCFG429_LOWSPEED"/>		<!-- CELBTI_CHCFG429_HIGHSPEED or CELBTI_CHCFG429_LOWSPEED -->
		<add key="OMNIBUSBOX_CHANNEL_10"	value="CELBTI_CHCFG429_LOWSPEED"/>
		<add key="OMNIBUSBOX_CHANNEL_11"	value="CELBTI_CHCFG429_LOWSPEED"/>
		<add key="OMNIBUSBOX_CHANNEL_12"	value="CELBTI_CHCFG429_LOWSPEED"/>

