<!--
Example celdas200 XML configuration files.

The file is free form, as long as it is a valid xml file.

Keys are specified with the <add/> element. All the other element are
used to define sections and subsections. There is no limit to the depth
of the tree other than the API is limited to a key of 255 characters
(IsaGRAF MAX string size).


The entry below can be retrieved using the following key with the API:

"ConfigurationSettings.TSCP700.ETC_NUMBER_PROBE".
-->


<ConfigurationSettings>

  <RESSOURCE>

		<DACN1_SERIAL_IOMGR>
			<!--Serial Ports. Note that /dev/ser3 to /dev/ser5 are reserved for Modbus.-->

			<add key="SERIAL_PORT_NUMBER" 		value = "5"/>							<!-- Number of Serial Ports to be opened -->

			<add key="SERIAL_PORT_1_INDEX" 		value = "6"/>
			<add key="SERIAL_PORT_1_NAME" 		value = "/dev/ser6"/>
			<add key="SERIAL_PORT_1_BAUD_RATE" 	value = "38400"/>
			<add key="SERIAL_PORT_1_DATA_BITS" 	value = "8"/>
			<add key="SERIAL_PORT_1_PARITY" 	value = "none"/>
			<add key="SERIAL_PORT_1_STOP_BITS" 	value = "1"/>

			<add key="SERIAL_PORT_2_INDEX" 		value = "7"/>
			<add key="SERIAL_PORT_2_NAME" 		value = "/dev/ser7"/>
			<add key="SERIAL_PORT_2_BAUD_RATE" 	value = "38400"/>
			<add key="SERIAL_PORT_2_DATA_BITS" 	value = "8"/>
			<add key="SERIAL_PORT_2_PARITY" 	value = "none"/>
			<add key="SERIAL_PORT_2_STOP_BITS" 	value = "1"/>

			<add key="SERIAL_PORT_3_INDEX" 		value = "8"/>
			<add key="SERIAL_PORT_3_NAME" 		value = "/dev/ser8"/>
			<add key="SERIAL_PORT_3_BAUD_RATE" 	value = "38400"/>
			<add key="SERIAL_PORT_3_DATA_BITS" 	value = "8"/>
			<add key="SERIAL_PORT_3_PARITY" 	value = "none"/>
			<add key="SERIAL_PORT_3_STOP_BITS" 	value = "1"/>

			<add key="SERIAL_PORT_4_INDEX" 		value = "9"/>
			<add key="SERIAL_PORT_4_NAME" 		value = "/dev/ser9"/>
			<add key="SERIAL_PORT_4_BAUD_RATE" 	value = "38400"/>
			<add key="SERIAL_PORT_4_DATA_BITS" 	value = "8"/>
			<add key="SERIAL_PORT_4_PARITY" 	value = "none"/>
			<add key="SERIAL_PORT_4_STOP_BITS" 	value = "1"/>

			<add key="SERIAL_PORT_5_INDEX" 		value = "10"/>
			<add key="SERIAL_PORT_5_NAME" 		value = "/dev/ser10"/>
			<add key="SERIAL_PORT_5_BAUD_RATE" 	value = "57600"/>
			<add key="SERIAL_PORT_5_DATA_BITS" 	value = "8"/>
			<add key="SERIAL_PORT_5_PARITY" 	value = "none"/>
			<add key="SERIAL_PORT_5_STOP_BITS" 	value = "1"/>

		</DACN1_SERIAL_IOMGR>

		<DACN1_SERIAL_ARINC_IOMGR>            
			<add key="SERIAL_PORT_NUMBER" 		value = "1"/>					<!-- Number of Serial Ports to be opened -->
			<add key="SERIAL_PORT_1_INDEX" 		value = "1"/>
			<add key="SERIAL_PORT_1_NAME" 		value = "/dev/ser1"/>           <!-- Build-in serial 232 on board, not on Bluestorm expension card -->
			<add key="SERIAL_PORT_1_BAUD_RATE" 	value = "38400"/>
			<add key="SERIAL_PORT_1_DATA_BITS" 	value = "8"/>
			<add key="SERIAL_PORT_1_PARITY" 	value = "none"/>
			<add key="SERIAL_PORT_1_STOP_BITS"	value = "1"/>
		</DACN1_SERIAL_ARINC_IOMGR>


		<add key="SERIAL_ARINC_DISABLED" 			value = "false"/>
		<add key="OMNIBUSBOX_DISABLED" 				value = "true"/>
		<add key="POWERDNA_DISABLED" 				value = "false"/>
		<add key="UUT_CONTROLLER_DISABLED" 			value = "false"/>
		<add key="USER_INTERFACE_DISABLED" 			value = "false"/>
		<add key="NIDAQ_DISABLED" 					value = "false"/>
		<add key="SERIAL_DISABLED" 					value = "false"/>

		<add key="UUT_CRUNCHER_DISABLED" 			value = "true"/>
		<add key="SCANNIVALVE_TEMPERATURE_DISABLED" value = "true"/>
		<add key="SCANNIVALVE_PRESSURE_DISABLED" 	value = "true"/>
		<add key="SM1720_DISABLED" 					value = "true"/>
		<add key="GALIL_CONTROLLER_DISABLED" 		value = "true"/>
		<add key="TEXCEL_V100_DISABLED" 			value = "true"/>
		<add key="TEXCEL_VX100_DISABLED" 			value = "true"/>
		<add key="LOAD_BANK_CONTROLLER_DISABLED"	value = "true"/>
		<add key="FACILITY_CONTROLLER_DISABLED" 	value = "true"/>
		<add key="AFDX_DISABLED" 					value = "true"/>

		<DACN1_AFDX_IOMGR>
			<add key="AFDX_VIRTUAL_LINK_CSV"		value = "/usr/v2000/app/DACN1_AFDX_VIRTUAL_LINK_CSV.csv"/>
			<add key="AFDX_PORT_CSV" 				value = "/usr/v2000/app/DACN1_AFDX_PORT_CSV.csv"/>
			<add key="AFDX_SIGNAL_CSV" 				value = "/usr/v2000/app/DACN1_AFDX_SIGNAL_CSV.csv"/>
			<add key="IP_ADDRESS" 					value = "192.168.2.226"/>
		</DACN1_AFDX_IOMGR>
	
  </RESSOURCE>


  
  <OVERSPEED_BOARD>
  
